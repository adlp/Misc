FROM ubuntu:22.04

# mode build (classique) : postfix installé au build, squelette capturé dans
# /opt/tgz pour restauration si les volumes /etc/postfix et/ou
# /var/spool/postfix sont neufs au démarrage. Le même run.sh sait aussi
# s'auto-installer au runtime si démarré sans avoir été buildé (mode
# buildless, cf. README section dédiée) — voir run.sh pour la logique.

RUN mkdir /opt/tgz

RUN apt-get update \
    && apt-get install -y --no-install-recommends postfix \
    && rm -rf /var/lib/apt/lists/*

RUN echo 'maillog_file = /dev/stdout' >>/etc/postfix/main.cf

RUN tar czf /opt/tgz/etc+postfix.tgz /etc/postfix
RUN tar czf /opt/tgz/var+spool+postfix.tgz /var/spool/postfix

RUN rm -rf /etc/postfix /var/spool/postfix
RUN mkdir /etc/postfix /var/spool/postfix

COPY run.sh /run.sh
RUN chmod +x /run.sh

CMD [ "/run.sh" ]
