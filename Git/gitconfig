[user]
    name = unconfigured
    email = unconfigured

# Charge ~/.local/gitconfig s'il existe (safe.directory et autres reglages locaux a la machine).
# git ignore silencieusement un include vers un fichier absent : rien a faire si le fichier n'existe pas.
[include]
    path = ~/.local/gitconfig
# https://stackoverflow.com/questions/4220416/can-i-specify-multiple-users-for-myself-in-gitconfig
# Pas de detection automatique de repo pro/perso (git ne sait pas conditionner sur un fichier du
# worktree, seulement sur gitdir/onbranch/remote url) : utiliser l'alias `setid` ci-dessous une
# fois par repo pour fixer l'identite (name/email) dans le .git/config local de ce repo.

[core]
   pager = less -SR -x4
   sshCommand = "/usr/bin/ssh -o visualHostkey=no"
   filemode = true
[diff]
	tool = vimdiff
[alias]
    ls = "!bash -c '\
        f() { \
            local prefix=\"${GIT_PREFIX:-}\"; \
            cd \"${prefix:-.}\" || exit 1; \
            git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo \"Pas un depot git.\" >&2; exit 1; }; \
            declare -A st; \
            while IFS= read -r l; do \
                c=\"${l:0:2}\"; fn=\"${l:3}\"; fn=\"${fn%\\\"}\"; fn=\"${fn#\\\"}\"; \
                fn=\"${fn#$prefix}\"; \
                st[\"$fn\"]=\"$c\"; \
            done < <(git status --porcelain --ignored -- .); \
            code_to_tag() { \
                case \"$1\" in \
                    \"\") echo committed ;; \
                    \"??\") echo untracked ;; \
                    \"!!\") echo ignored ;; \
                    \" M\"|\"MM\") echo modified ;; \
                    \"M \"|\"A \"|\"AM\") echo staged ;; \
                    \" D\"|\"D \") echo deleted ;; \
                    \"R \"|\" R\") echo renamed ;; \
                    *) echo \"$1\" ;; \
                esac; \
            }; \
            rank() { \
                case \"$1\" in \
                    modified|staged) echo 5 ;; \
                    deleted) echo 4 ;; \
                    renamed) echo 3 ;; \
                    untracked) echo 2 ;; \
                    ignored) echo 1 ;; \
                    committed) echo 0 ;; \
                    *) echo 0 ;; \
                esac; \
            }; \
            dir_tag() { \
                local d=\"$1/\"; local best=\"committed\"; local best_rank=0; \
                local has_tracked=\"\"; \
                has_tracked=$(git ls-files -- \"$1\" | head -n1); \
                for key in \"${!st[@]}\"; do \
                    if [[ \"$key\" == \"$d\"* ]]; then \
                        local t; t=$(code_to_tag \"${st[$key]}\"); \
                        if [[ -n \"$has_tracked\" && \"$t\" == \"ignored\" ]]; then continue; fi; \
                        local r; r=$(rank \"$t\"); \
                        if (( r > best_rank )); then best_rank=$r; best=$t; fi; \
                    fi; \
                done; \
                echo \"$best\"; \
            }; \
            ls -lrtA | while IFS= read -r line; do \
                if [[ \"$line\" == total\\ * ]]; then echo \"$line\"; continue; fi; \
                file=\"${line##* }\"; \
                if [[ \"$file\" == \".git\" ]]; then continue; fi; \
                if [[ -d \"$file\" ]]; then \
                    tag=$(dir_tag \"$file\"); \
                    code=\"${st[$file]:-}\"; \
                    if [[ -n \"$code\" ]]; then \
                        own=$(code_to_tag \"$code\"); \
                        if (( $(rank \"$own\") > $(rank \"$tag\") )); then tag=\"$own\"; fi; \
                    fi; \
                else \
                    code=\"${st[$file]:-}\"; \
                    tag=$(code_to_tag \"$code\"); \
                fi; \
                case \"$tag\" in \
                    \"committed\") tata=\"✳️ \" ;; \
                    \"untracked\") tata=\"☠️ \" ;; \
                    \"ignored\")   tata=\"💤\" ;; \
                    \"modified\")  tata=\"✏️i\" ;; \
                    \"staged\")    tata=\"🚸\" ;; \
                    \"deleted\")   tata=\"🧨\" ;; \
                    \"renamed\")   tata=\"📩\" ;; \
                    *)             tata=\"⁉️ \" ;; \
                    esac; \
                printf \"%s [%s]\\n\" \"$line\" \"$tata$tag\"; \
            done; \
        }; f' -"
    allst= "!find -type d -name .git | while read gits ; do gith=$(dirname $gits); echo ======== $gith; cd $gith; git st;cd -; done"
    allget= "!find -type d -name .git | while read gits ; do gith=$(dirname $gits); echo ======== $gith; cd $gith; git g;cd -; done"
    addco= "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; test $# -eq 0 && set -- .; git diff -- \"$@\"; echo -n \"Make an comment for $* (or do CTR-C to stop): \"; read comm; git add -- \"$@\"; git commit -m \"$comm\"; }; f"
    addcom= "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; test $# -eq 0 && set -- .; git diff -- \"$@\"; git status -sb -- \"$@\" | grep -E '^ [DM]'; echo 'Make a comment or do CTR-C to stop'; read comm; git add -u -- \"$@\"; git commit -m \"$comm\"; }; f"
#    logs = log --pretty="format:%H;%ci;%cn;%s" --name-status
    logs = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci,%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --name-only
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    g = pull
    p = "!test $(git st | wc -l ) -gt 1 && ( echo Merci de commiter;git st); git push"
    root = rev-parse --show-toplevel
	st = "!cd $(git root); git status -sb"
	co = checkout
	ci = commit -m 
	commit = commit --signoff
	br = branch
	sb = branch -a
	mt = mergetool
	d = difftool
	dst = diff --staged
	sub = submodule
	c1 = clone --depth=1
	se = !git rev-list --all | xargs git grep -F
	alias = "!f() { git config --get-regexp '^alias\\.' | sed 's/^alias\\.//' | while read -r name rest; do case $name in ls) desc='statut compact du repertoire courant, icone par fichier/dossier' ;; allst) desc='git st sur tous les sous-depots trouves sous le repertoire courant' ;; allget) desc='git g (pull) sur tous les sous-depots trouves sous le repertoire courant' ;; addco) desc='diff + commit dun chemin (defaut: repertoire courant), demande le message' ;; addcom) desc='diff + commit des fichiers modifies/supprimes du perimetre courant, demande le message' ;; logs) desc='log graphique detaille avec fichiers touches' ;; lg) desc='log graphique compact' ;; g) desc='pull' ;; p) desc='push, avec rappel si du travail nest pas commite' ;; root) desc='chemin racine du depot' ;; st) desc='status compact depuis la racine du depot' ;; co) desc='checkout' ;; ci) desc='commit -m' ;; commit) desc='commit --signoff' ;; br) desc='branch' ;; sb) desc='liste toutes les branches' ;; mt) desc='mergetool' ;; d) desc='difftool' ;; dst) desc='diff --staged' ;; sub) desc='submodule' ;; c1) desc='clone --depth=1' ;; se) desc='grep sur tout lhistorique du depot' ;; alias) desc='liste les alias (cette commande)' ;; goto) desc='reset --hard + clean -fd + checkout BRANCHE, destructif' ;; list-branch) desc='liste les branches avec leur auteur' ;; todo) desc='grep TODO/FIXME dans le depot' ;; todo-list) desc='compte les TODO/FIXME par fichier' ;; whoami) desc='identite git (name/email) effective du repo courant' ;; setid) desc='fixe interactivement lidentite (name/email) du repo courant' ;; mirror) desc='clone --mirror + push --mirror vers un autre depot, option -n/--dry-run' ;; tar) desc='depose une archive tar (fichier ou stdin) dans un sous-repertoire dun depot, commit+push' ;; figet) desc='recupere un fichier/repertoire dun depot, option -G COMMIT' ;; fiput) desc='depose un fichier (local ou stdin) dans un depot, commit+push' ;; fidiff) desc='diff entre un fichier local et sa version dans un depot, option -G COMMIT' ;; filog) desc='historique des commits touchant un fichier dans un depot' ;; deploy) desc='deploie HEAD (fichiers/repertoires dun profil .deploy.conf) vers des urls ssh' ;; syncdir) desc='rsync HEAD dun chemin dun depot vers un chemin dun autre depot (git2git_sync)' ;; *) desc='' ;; esac; printf '%-14s %s\\n' \"$name\" \"$desc\"; done; }; f"
    goto = "!f() { git reset --hard && git clean -fd && git checkout ${1-master}; }; f"
	list-branch = ! git for-each-ref --format=' %(authorname) %09 %(refname)' --sort=authorname
	todo = ! git grep --extended-regexp -I --line-number --break --heading --color=auto 'TODO|FIXME'
	todo-list = ! git grep --extended-regexp -I --line-number --count 'TODO|FIXME'
	whoami = "!f() { echo \"name:  $(git config user.name)\"; echo \"email: $(git config user.email)\"; }; f"
	setid = "!f() { git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo \"Pas un depot git.\" >&2; exit 1; }; echo -n \"Email pour ce repo: \"; read email; test -z \"$email\" && { echo \"Email vide, abandon.\" >&2; exit 1; }; git config user.email \"$email\"; echo -n \"Nom pour ce repo (vide = garder actuel): \"; read name; test -n \"$name\" && git config user.name \"$name\"; git whoami; }; f"
	mirror = "!f() { dry=0; case \"$1\" in -n|--dry-run) dry=1; shift ;; esac; if [ $# -ne 2 ]; then echo \"Usage: git mirror [-n|--dry-run] <src> <dest>\" >&2; exit 1; fi; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; git clone --mirror --quiet \"$1\" \"$tmp/m.git\" || exit 1; cd \"$tmp/m.git\" || exit 1; if [ \"$dry\" = 1 ]; then git push --mirror --dry-run \"$2\"; else git push --mirror \"$2\"; fi; }; f"
	tar = "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; if [ $# -ne 4 ]; then echo \"Usage: git tar <archive.tar|.tgz|-> <depot> <repertoire> <message>\" >&2; exit 1; fi; repo=$2; subdir=$3; msg=$4; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; if [ \"$1\" = \"-\" ]; then archive=\"$tmp/stdin.archive\"; cat > \"$archive\" || exit 1; else archive=$(realpath \"$1\") || exit 1; test -f \"$archive\" || { echo \"Archive introuvable : $archive\" >&2; exit 1; }; fi; git clone --quiet \"$repo\" \"$tmp/work\" || exit 1; cd \"$tmp/work\" || exit 1; rm -rf -- \"$subdir\"; mkdir -p -- \"$subdir\"; tar xf \"$archive\" -C \"$subdir\" || exit 1; git add -A -- \"$subdir\"; if git diff --cached --quiet -- \"$subdir\"; then echo \"Rien a committer.\"; exit 0; fi; git commit -q -m \"$msg\" || exit 1; git push origin HEAD; }; f"
	figet = "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; commit=; case \"$1\" in -G) commit=$2; shift 2 ;; esac; if [ $# -ne 3 ]; then echo \"Usage: git figet [-G <commit>] <depot> <chemin-dans-le-depot> <destination>\" >&2; exit 1; fi; repo=$1; path=$2; dest=$3; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; if [ -n \"$commit\" ]; then git clone --quiet \"$repo\" \"$tmp/work\" || exit 1; (cd \"$tmp/work\" && git checkout --quiet \"$commit\") || exit 1; else git clone --quiet --depth 1 \"$repo\" \"$tmp/work\" || exit 1; fi; src=\"$tmp/work/$path\"; test -e \"$src\" || { echo \"Introuvable dans le depot (${commit:-HEAD}) : $path\" >&2; exit 1; }; if [ -d \"$src\" ]; then case \"$dest\" in *.tar.gz|*.tgz) mkdir -p \"$(dirname \"$dest\")\" && tar czf \"$dest\" -C \"$src\" . ;; *.tar.bz2|*.tbz2) mkdir -p \"$(dirname \"$dest\")\" && tar cjf \"$dest\" -C \"$src\" . ;; *.tar) mkdir -p \"$(dirname \"$dest\")\" && tar cf \"$dest\" -C \"$src\" . ;; *) mkdir -p \"$dest\" && cp -a \"$src\"/. \"$dest\"/ ;; esac; else d=\"$dest\"; test -d \"$d\" && d=\"$d/$(basename \"$src\")\"; mkdir -p \"$(dirname \"$d\")\" && cp -a \"$src\" \"$d\"; fi; }; f"
	fiput = "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; if [ $# -ne 4 ]; then echo \"Usage: git fiput <depot> <fichier-local|-> <chemin-destination> <message>\" >&2; exit 1; fi; repo=$1; destpath=$3; msg=$4; if [ \"$2\" = \"-\" ]; then stdin=1; else src=$(realpath \"$2\") || exit 1; test -f \"$src\" || { echo \"Fichier local introuvable : $src\" >&2; exit 1; }; fi; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; git clone --quiet \"$repo\" \"$tmp/work\" || exit 1; cd \"$tmp/work\" || exit 1; mkdir -p -- \"$(dirname \"$destpath\")\"; if [ -n \"$stdin\" ]; then cat > \"$destpath\" || exit 1; else cp -- \"$src\" \"$destpath\" || exit 1; fi; git add -- \"$destpath\"; if git diff --cached --quiet -- \"$destpath\"; then echo \"Rien a committer.\"; exit 0; fi; git commit -q -m \"$msg\" || exit 1; git push origin HEAD; }; f"
	fidiff = "!f() { cd \"${GIT_PREFIX:-.}\" || exit 1; commit=; case \"$1\" in -G) commit=$2; shift 2 ;; esac; if [ $# -ne 3 ]; then echo \"Usage: git fidiff [-G <commit>] <depot> <fichier-local> <chemin-dans-le-depot>\" >&2; exit 1; fi; repo=$1; local=$(realpath \"$2\") || exit 1; path=$3; test -f \"$local\" || { echo \"Fichier local introuvable : $local\" >&2; exit 1; }; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; if [ -n \"$commit\" ]; then git clone --quiet \"$repo\" \"$tmp/work\" || exit 1; (cd \"$tmp/work\" && git checkout --quiet \"$commit\") || exit 1; else git clone --quiet --depth 1 \"$repo\" \"$tmp/work\" || exit 1; fi; remote=\"$tmp/work/$path\"; test -e \"$remote\" || { echo \"Introuvable dans le depot (${commit:-HEAD}) : $path\" >&2; exit 1; }; git diff --no-index -- \"$remote\" \"$local\"; }; f"
	filog ="!f() { if [ $# -ne 2 ]; then echo \"Usage: git filog <depot> <chemin-dans-le-depot>\" >&2; exit 1; fi; repo=$1; path=$2; tmp=$(mktemp -d) || exit 1; trap 'rm -rf \"$tmp\"' EXIT; git clone --quiet \"$repo\" \"$tmp/work\" || exit 1; cd \"$tmp/work\" || exit 1; git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci,%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative -- \"$path\"; }; f"
	deploy = "!git-deploy"
	syncdir = "!git2git_sync"
[init]
	defaultBranch = main
