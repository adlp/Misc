#!/bin/bash

#/*
#* git-deploy deploie le contenu commite (HEAD) de "lots" (groupes nommes de
#* fichiers/repertoires) vers des destinations ssh/scp, selon un type de
#* deploiement defini dans un fichier de config .deploy.conf (non tracke) pose
#* a cote du sous-projet concerne. Un lot est defini une fois (section [src])
#* et peut etre reutilise par plusieurs types de deploiement, chacun pouvant
#* l'envoyer vers des destinations differentes.
#* Copyright (C) 2026 Antoine DELAPORTE
#*
#* This program is free software: you can redistribute it and/or modify
#* it under the terms of the GNU General Public License as published by
#* the Free Software Foundation, either version 3 of the License, or
#* (at your option) any later version.
#*
#* This program is distributed in the hope that it will be useful,
#* but WITHOUT ANY WARRANTY; without even the implied warranty of
#* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#* GNU General Public License for more details.
#*
#* You should have received a copy of the GNU General Public License
#* along with this program.  If not, see <http://www.gnu.org/licenses/>.
#*/

set -u
set -o pipefail

usage() {
    cat <<EOF
Usage : git deploy <type-de-deploiement>

Deploie le contenu COMMITE (HEAD, pas la copie de travail) des lots lies a
<type-de-deploiement> vers leurs destinations ssh respectives.

Cherche un fichier .deploy.conf en remontant depuis le repertoire courant
jusqu'a la racine du depot (le premier trouve est utilise). Format a 3
etages (syntaxe git config) :

    [src "lot1"]
        src = fichier1
        src = un_repertoire
        src = fichier2

    [src "lot2"]
        src = autre_repertoire

    [prod]
        lot1 = user@host1:/opt/git-tools/
        lot1 = user@host2:/alpha/
        lot2 = user@host1:/un_autre_nom/

Un lot (sous-section de [src]) est un groupe nomme de sources (fichiers ou
repertoires, chemins relatifs au repertoire contenant .deploy.conf). Un
meme lot peut etre reutilise par plusieurs types de deploiement (une autre
section que [prod], ex [preprod]) ; chaque type peut l'envoyer vers des
destinations differentes, et un lot peut avoir plusieurs destinations (cle
repetee). La destination (syntaxe scp classique [user@]host:chemin) est le
repertoire distant ou atterrissent les membres du lot, chacun sous son
propre nom (comme une copie groupee).

.deploy.conf n'est jamais commite (voir .gitignore racine) : chaque machine
qui deploie doit avoir le sien.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ $# -ne 1 ]; then
    usage >&2
    exit 1
fi

type=$1

cd "${GIT_PREFIX:-.}" || exit 1

root=$(git rev-parse --show-toplevel) || exit 1

dir=$(pwd)
conf=
while true; do
    if [ -f "$dir/.deploy.conf" ]; then
        conf="$dir/.deploy.conf"
        break
    fi
    if [ "$dir" = "$root" ]; then
        break
    fi
    dir=$(dirname "$dir")
done

if [ -z "$conf" ]; then
    echo "Aucun .deploy.conf trouve entre $(pwd) et la racine du depot ($root)." >&2
    exit 1
fi

if [ "$dir" = "$root" ]; then
    prefix="."
    strip=0
else
    prefix=$(realpath --relative-to="$root" "$dir") || exit 1
    strip=$(awk -F/ '{print NF}' <<< "$prefix")
fi

mapfile -t lines < <(git config -f "$conf" --get-regexp "^${type}\..+\$" 2>/dev/null)

if [ ${#lines[@]} -eq 0 ]; then
    echo "Type de deploiement '$type' introuvable (aucune cle) dans $conf" >&2
    exit 1
fi

declare -A dests_by_lot=()
order=()
for line in "${lines[@]}"; do
    key=${line%% *}
    val=${line#* }
    lot=${key#"${type}."}
    if [ -z "${dests_by_lot[$lot]+x}" ]; then
        order+=("$lot")
        dests_by_lot[$lot]=""
    fi
    dests_by_lot[$lot]+="$val"$'\n'
done

echo "Config : $conf"
echo "Type   : $type"
echo

failed=0
for lot in "${order[@]}"; do
    mapfile -t srcs < <(git config -f "$conf" --get-all "src.${lot}.src" 2>/dev/null)
    if [ ${#srcs[@]} -eq 0 ]; then
        echo "Lot '$lot' reference par '$type' mais non defini (section [src \"$lot\"] absente ou vide)" >&2
        failed=1
        continue
    fi

    paths=()
    for s in "${srcs[@]}"; do
        if [ "$prefix" = "." ]; then
            paths+=("$s")
        else
            paths+=("$prefix/$s")
        fi
    done

    echo "== lot $lot : ${srcs[*]} =="
    while IFS= read -r dest; do
        [ -z "$dest" ] && continue
        host=${dest%%:*}
        rpath=${dest#*:}
        if [ "$host" = "$dest" ] || [ -z "$rpath" ]; then
            echo "Destination invalide (attendu [user@]host:chemin) : $dest" >&2
            failed=1
            continue
        fi
        echo "-> $dest"
        if ! (cd "$root" && git archive HEAD -- "${paths[@]}") \
            | ssh "$host" "mkdir -p -- '$rpath' && tar x -C '$rpath' --strip-components=$strip"; then
            echo "Echec du deploiement du lot $lot vers $dest" >&2
            failed=1
        fi
    done <<< "${dests_by_lot[$lot]}"
done

exit $failed
