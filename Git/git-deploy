#!/bin/bash

#/*
#* git-deploy deploie le contenu commite (HEAD) de sources (fichiers/repertoires)
#* vers des destinations ssh/scp, selon un profil defini dans un fichier de
#* config .deploy.conf (non tracke) pose a cote du sous-projet concerne.
#* Chaque source a ses propres destinations (une cible peut differer d'une
#* autre selon le fichier/repertoire deploye).
#* Copyright (C) 2026 Antoine DELAPORTE
#*
#* This program is free software: you can redistribute it and/or modify
#* it under the terms of the GNU General Public License as published by
#* the Free Software Foundation, either version 3 of the License, or
#* (at your option) any later version.
#*
#* This program is distributed in the hope that it will be useful,
#* but WITHOUT ANY WARRANTY; without even the implied warranty of
#* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#* GNU General Public License for more details.
#*
#* You should have received a copy of the GNU General Public License
#* along with this program.  If not, see <http://www.gnu.org/licenses/>.
#*/

set -u

usage() {
    cat <<EOF
Usage : git deploy <type-de-deploiement>

Deploie le contenu COMMITE (HEAD, pas la copie de travail) des sources liees
a <type-de-deploiement> vers leurs destinations ssh respectives. Chaque
source (fichier ou repertoire) a ses propres destinations : une cible peut
differer d'une autre.

Cherche un fichier .deploy.conf en remontant depuis le repertoire courant
jusqu'a la racine du depot (le premier trouve est utilise). Format a 3
etages (syntaxe git config : section = type, sous-section = source, cle =
cible) :

    [preprod "gitconfig"]
        dest = user@host1:/opt/git-tools/gitconfig
        dest = user@host2:/opt/git-tools/gitconfig

    [preprod "un_sous_repertoire"]
        dest = user@host1:/opt/git-tools/un_autre_nom/

Les sous-sections (sources) sont des chemins relatifs au repertoire contenant
.deploy.conf, fichier ou repertoire. "dest" (repetable) suit la syntaxe scp
classique [user@]host:chemin — chemin complet du fichier distant pour une
source fichier, repertoire distant ou atterrit le contenu pour une source
repertoire.

.deploy.conf n'est jamais commite (voir .gitignore racine) : chaque machine
qui deploie doit avoir le sien.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ $# -ne 1 ]; then
    usage >&2
    exit 1
fi

type=$1

cd "${GIT_PREFIX:-.}" || exit 1

root=$(git rev-parse --show-toplevel) || exit 1

dir=$(pwd)
conf=
while true; do
    if [ -f "$dir/.deploy.conf" ]; then
        conf="$dir/.deploy.conf"
        break
    fi
    if [ "$dir" = "$root" ]; then
        break
    fi
    dir=$(dirname "$dir")
done

if [ -z "$conf" ]; then
    echo "Aucun .deploy.conf trouve entre $(pwd) et la racine du depot ($root)." >&2
    exit 1
fi

if [ "$dir" = "$root" ]; then
    prefix="."
else
    prefix=$(realpath --relative-to="$root" "$dir") || exit 1
fi

mapfile -t lines < <(git config -f "$conf" --get-regexp "^${type}\..*\.dest\$" 2>/dev/null)

if [ ${#lines[@]} -eq 0 ]; then
    echo "Type de deploiement '$type' introuvable (aucune entree *.dest) dans $conf" >&2
    exit 1
fi

declare -A dests_by_source=()
order=()
for line in "${lines[@]}"; do
    key=${line%% *}
    val=${line#* }
    source=${key#"${type}."}
    source=${source%.dest}
    if [ -z "${dests_by_source[$source]+x}" ]; then
        order+=("$source")
        dests_by_source[$source]=""
    fi
    dests_by_source[$source]+="$val"$'\n'
done

echo "Config : $conf"
echo "Type   : $type"
echo

failed=0
for source in "${order[@]}"; do
    if [ "$prefix" = "." ]; then
        repo_path=$source
    else
        repo_path="$prefix/$source"
    fi

    kind=$(git -C "$root" cat-file -t "HEAD:$repo_path" 2>/dev/null)
    if [ -z "$kind" ]; then
        echo "Source introuvable dans HEAD : $repo_path" >&2
        failed=1
        continue
    fi

    echo "== $repo_path ($kind) =="
    while IFS= read -r dest; do
        [ -z "$dest" ] && continue
        host=${dest%%:*}
        rpath=${dest#*:}
        if [ "$host" = "$dest" ] || [ -z "$rpath" ]; then
            echo "Destination invalide (attendu [user@]host:chemin) : $dest" >&2
            failed=1
            continue
        fi
        echo "-> $dest"
        if [ "$kind" = "blob" ]; then
            if ! git -C "$root" show "HEAD:$repo_path" \
                | ssh "$host" "mkdir -p -- \"\$(dirname -- '$rpath')\" && cat > '$rpath'"; then
                echo "Echec du deploiement vers $dest" >&2
                failed=1
            fi
        elif [ "$kind" = "tree" ]; then
            strip=$(awk -F/ '{print NF}' <<< "$repo_path")
            if ! git -C "$root" archive HEAD -- "$repo_path" \
                | ssh "$host" "mkdir -p -- '$rpath' && tar x -C '$rpath' --strip-components=$strip"; then
                echo "Echec du deploiement vers $dest" >&2
                failed=1
            fi
        else
            echo "Type d'objet git inattendu ($kind) pour $repo_path" >&2
            failed=1
        fi
    done <<< "${dests_by_source[$source]}"
done

exit $failed
