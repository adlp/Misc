# Exemple de .deploy.conf pour git-deploy / git deploy <type-de-deploiement>.
#
# Copier ce fichier en .deploy.conf (jamais commite, voir .gitignore racine :
# **/.deploy.conf) a cote du sous-projet a deployer, puis l'adapter.
#
# Format a 3 etages :
#   1. Lot ([src "nom"], reutilisable) : groupe nomme de sources (fichiers ou
#      repertoires relatifs au repertoire de ce fichier).
#   2. Type de deploiement : une section comme [prod] ou [preprod] (nom passe
#      a "git deploy").
#   3. Cible : pour chaque lot reference dans le type, une cle <lot> = dest
#      (repetable pour plusieurs destinations), syntaxe scp classique
#      [user@]host:chemin — repertoire distant ou atterrissent les membres
#      du lot, chacun sous son propre nom.
#
# Un meme lot peut etre reutilise par plusieurs types, avec des destinations
# differentes a chaque fois.

[src "outils"]
    src = gitconfig
    src = git-deploy

[prod]
    outils = adlp@prod.adlp.org:/opt/git-tools/

[preprod]
    outils = adlp@preprod1.adlp.org:/opt/git-tools/
    outils = adlp@preprod2.adlp.org:/opt/git-tools/
