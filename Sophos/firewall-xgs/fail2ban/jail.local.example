# Exemple de jail.local combinant les deux actions (sophos-xgs et
# nginx-local) sur DEUX jails à comportements distincts : un scan 404
# classique (bantime court) et la jail `recidive` intégrée à fail2ban
# (bantime bien plus long pour les IP déjà bannies plusieurs fois par
# d'autres jails). Voir README.md, section "Jails avec des
# comportements distincts", pour le détail du mécanisme.
#
# Installation :
#   cp filter.d/php-404.conf /etc/fail2ban/filter.d/
#   cp action.d/sophos-xgs.conf action.d/nginx-local.conf /etc/fail2ban/action.d/
#   cp jail.local.example /etc/fail2ban/jail.local   # puis adapter logpath
#   cp api.conf.example /usr/local/etc/sophos-fw-block.conf
#   cp api-recidive.conf.example /usr/local/etc/sophos-fw-block-recidive.conf
#   cp nginx.conf.example /usr/local/etc/nginx-fw-block.conf
#   # sophos-fw-block.conf / nginx-fw-block.conf (main) : jail = php-404
#   # UNIQUEMENT -- la jail recidive a sa propre config API
#   # (sophos-fw-block-recidive.conf, voir ci-dessous) et n'a pas besoin
#   # d'être listée ici.

[php-404]
enabled  = true
port     = http,https
filter   = php-404
logpath  = /var/log/nginx/access.log
action   = sophos-xgs
           nginx-local
maxretry = 3
findtime = 600
# 1 jour
bantime  = 86400

# Jail standard de fail2ban (voir jail.conf, généralement déjà présente
# mais désactivée) : surveille /var/log/fail2ban.log et re-bannit toute
# IP déjà bannie `maxretry` fois par N'IMPORTE QUELLE jail durant
# `findtime` -- capte donc aussi bien les récidivistes de php-404 que
# de toute autre jail active (sshd, etc.), pas seulement 404.
[recidive]
enabled   = true
filter    = recidive
logpath   = /var/log/fail2ban.log
# groupe/préfixe XGS dédiés (voir api-recidive.conf.example) : ne
# mélange jamais ces IP avec celles de php-404 (règle Deny XGS
# généralement plus stricte/durable pour un récidiviste confirmé).
# nginx-local sans surcharge : repousse vers le même badguys.map que
# php-404 -- le bantime bien plus long suffit à distinguer le
# traitement, inutile de dupliquer aussi la cible nginx ici.
action    = sophos-xgs[config="/usr/local/etc/sophos-fw-block-recidive.conf"]
            nginx-local
# 3 bans en 1 jour déclenchent un ban d'1 semaine
maxretry  = 3
findtime  = 86400
bantime   = 604800
