# 🔐 Récupération du mot de passe LDAP
def get_ldap_password():
    try:
        output = subprocess.check_output(["zmlocalconfig", "-s", "ldap_root_password"], text=True)
        return output.strip().split()[-1]
    except Exception as e:
        raise RuntimeError(f"Erreur lors de la récupération du mot de passe LDAP : {e}")

# 🔗 Connexion LDAP
def connect_ldap(password):
    ldap_url = "ldap://localhost:389"
    bind_dn = "uid=zimbra,cn=admins,cn=zimbra"
    conn = ldap.initialize(ldap_url)
    conn.simple_bind_s(bind_dn, password)
    return conn

# 🔍 Recherche des comptes lockout
def get_locked_accounts(conn, base_dn):
    search_filter = "(&(zimbraAccountStatus=*)(zimbraAccountStatus=lockout))"
    attributes = None  # None = récupérer tous les attributs
    results = conn.search_s(base_dn, ldap.SCOPE_SUBTREE, search_filter, attributes)

    locked = {}
    for dn, entry in results:
        email = entry.get("mail", [b"unknown"])[0].decode()

        # 🔍 Extraction de tous les attributs LDAP
        infos = {}
        for attr, values in entry.items():
            # Certains attributs ont plusieurs valeurs
            if attr == "userPassword":
                continue
            infos[attr] = [v.decode(errors="ignore") for v in values]

        locked[email] = {
            "dn": dn,
            "status": infos.get("zimbraAccountStatus", [""])[0],
            "infos": infos
        }

    return locked

def extract_failed_auth_lines(email, log_path="/opt/zimbra/log/audit.log"):
    """
    Recherche les lignes du fichier de log contenant une erreur d'authentification pour un email donné.

    Args:
        email (str): L'adresse email à rechercher.
        log_path (str): Chemin du fichier de log Zimbra.

    Returns:
        dict: Dictionnaire {num_ligne: contenu_ligne} des lignes correspondantes.
    """
    failed_lines = []

    try:
        with open(log_path, "r", encoding="utf-8", errors="ignore") as logfile:
            #for i, line in enumerate(logfile, start=1):
            for line in logfile:
                if "authentication failed for" in line and email in line:
                    #failed_lines[i] = line.strip()
                    failed_lines.append(line.strip())
    except FileNotFoundError:
        print(f"Fichier introuvable : {log_path}")
    except Exception as e:
        print(f"Erreur lors de la lecture du fichier : {e}")

    return failed_lines

# 🔍 Filtrage des comptes à exclure
def is_excluded(account):
    return any(re.match(regex, account) for regex in EXCLUDE_REGEXES)

