    EXCLUDE_REGEXES = [r.strip() for r in config.get("general", "exclude_regexes").split(",")]
    
    # 📦 Lecture du cache
    if os.path.exists(CACHE_PATH):
        with open(CACHE_PATH, "r") as f:
            cache = json.load(f)
    else:
        cache = {}


    password = get_ldap_password()
    conn = connect_ldap(password)

    locked_accounts = get_locked_accounts(conn, base_dn)
    new_cache={}

    # Open Ticketing System
    zammad=Zammad(url= ZAMMAD_URL,token= ZAMMAD_TOKEN, group=ZAMMAD_GRP,customer_id=ZAMMAD_CUST_ID,organization_id=ZAMMAD_ORGZ_ID)

    for account in locked_accounts.keys():
        if is_excluded(account):
            continue
        if account not in cache:
            ### Compte absent du cache (donc pas de ticket)
            logs        = "\n".join(extract_failed_auth_lines(account))
            infos       = locked_accounts[account]['infos']
            if not args.no_create:
                ticket_id   = zammad.create(f'[ZIMBRA] Locked :{account}',subject="infos",body=yaml.dump(infos,allow_unicode=True))
                zammad.note(ticket_id,"logs",logs)
                new_cache[account] = {"ticket_id": ticket_id, "logs":logs,'infos':infos}
            else:
                ticket_id   = "****"
            if not args.silent:
                print(f'Ticket {ticket_id} tout neuf pour {account}')
                print(f'    visible là : {ZAMMAD_URL}/#ticket/zoom/{ticket_id}')
        else:
            # Toujours bloqué, on garde le ticket, on verifie qu'il n'est pas fermé...
            new_cache[account] = cache[account]
            tick=zammad.ticket(cache[account]['ticket_id'])
            if tick is None or tick['close_at'] is not None:
                logs        = "\n".join(extract_failed_auth_lines(account))
                infos       = locked_accounts[account]['infos']
                ticket_id   = zammad.create(f'[ZIMBRA] Locked :{account}',subject="infos",body=yaml.dump(infos,allow_unicode=True))
                if not args.silent:
                    print(f'Ticket reCréation de ticket {ticket_id} pour {account}')
                zammad.note(ticket_id,"logs",logs)
                new_cache[account] = {"ticket_id": ticket_id, "logs":logs,'infos':infos}
            else:
                if not args.silent and args.always:
                    print(f'Tiket {cache[account]["ticket_id"]} existe et ouvert pour {account}')
                    print(f'    visible là : {ZAMMAD_URL}/#ticket/zoom/{tick["id"]}')

    # 🔁 Détection des comptes débloqués
    for account in cache:
        ticket_id=cache[account]['ticket_id']
        if account not in locked_accounts.keys() and not is_excluded(account) and zammad.ticket(ticket_id) is not None:
            if not args.silent:
                print(f"Cloture du ticket {ticket_id} cf {account}")
                print(f'    visible là : {ZAMMAD_URL}/#ticket/zoom/{ticket_id}')
            zammad.note(ticket_id,"Cloture","Le compte est debloque")
            zammad.close(ticket_id)

    # 💾 Mise à jour du cache
    with open(CACHE_PATH, "w") as f:
        json.dump(new_cache, f, indent=2)
