            r=_rb_run([os.path.realpath(__file__),'-v'],60,env=_rb_cli_env(BORGHELPERC_SELFTEST_AUDIT_WITNESS=tok))
            try:
                with open(log) as f: rows=[l.rstrip('\n').split('\t') for l in f if l.strip()]
            except FileNotFoundError: rows=[]
            # oracle fixe (jamais _AUDIT_EVENTS : un évènement retiré de la liste en retirerait aussi l'attente)
            want={(e,x) for e in ('open','os.mkdir','os.listdir','os.scandir','sqlite3.connect','os.remove','os.rename','os.rmdir',
                                  'shutil.rmtree','os.chmod','os.chown','os.utime','os.truncate','os.link','os.symlink') for x in roots}
            def seen(tag): return {(x[1],rt) for x in rows if len(x)>=3 for rt in roots
                                   if x[2].startswith(os.path.join(rt,f"{_AUDIT_MARK}-{tag}"))}
            miss_p=want-seen('processus-'+tok); miss_c=want-seen('enfant-'+tok)
            bad=[x for x in rows if len(x)<3 or _AUDIT_MARK not in x[2]]
            home_ok=os.path.join(pwd.getpwuid(os.getuid()).pw_dir,'.cache','borghelper') in roots
            if bad: print(f"  accès aux vrais dossiers ({len(bad)}) : {[' '.join(x) for x in bad[:8]]}")
            if miss_p or miss_c: print(f"  témoins manquants : processus {sorted(miss_p)[:6]} enfant {sorted(miss_c)[:6]}")
            if r.returncode!=0: print(f"  -v : code {r.returncode} {(r.stdout+r.stderr)[-200:]!r}")
            if not home_ok: print(f"  ~/.cache/borghelper absent des racines : {roots}")
            return not miss_p and not miss_c and not bad and r.returncode==0 and home_ok
        check("isolation des selftests : aucun accès aux vrais dossiers borg et borgHelper de l'utilisateur (crochet d'audit, "
              "témoins processus et enfant)",_audit_isolation)
    finally:
        for _sg,_old in saved_sigs.items():   # None : gestionnaire posé hors de Python -> défaut
            with contextlib.suppress(ValueError,TypeError): signal.signal(_sg,_old if _old is not None else signal.SIG_DFL)
        for _ps in _rb_live: _rb_killtree(_ps)   # 1.0.160 : aucun groupe d'enfant laissé (interruption comprise)
        if not audit_outer:   # 1.0.161 : crochet inactif hors selftest (il ne se retire pas), environnement rendu
            _AUDIT['log']=None
            for _k,_v in saved_audit_env.items():
                if _v is None: os.environ.pop(_k,None)
                else: os.environ[_k]=_v
        shutil.rmtree(tmp,ignore_errors=True)
        if saved_cleanup_home is None: os.environ.pop('BORGHELPERC_CLEANUP_HOME',None)
        else: os.environ['BORGHELPERC_CLEANUP_HOME']=saved_cleanup_home
        _DB_CFG_READERS.clear(); _DB_CFG_READERS.update(saved_readers)
        _DEK_CACHE.clear(); _DEK_CACHE.update(saved_deks)
        _CODEC_CACHE.clear(); _CODEC_CACHE.update(saved_codecs)
        _PLAIN_WARNED.clear(); _PLAIN_WARNED.update(saved_warned)
        globals()['_MIGRATE_BATCH']=saved_batch
        shutil.disk_usage=saved_disk_usage
        if saved_scrypt is not None: hashlib.scrypt=saved_scrypt
        if not list_only:   # en dernier : un Ctrl-C pendant l'attente laisse l'état global restauré
            try: n_mei=_purge_run_mei(mei_before)
            except Exception: n_mei=0
            if n_mei: print(f"  /tmp/_MEI* : {n_mei} orphelin(s) du run retiré(s)")
    fails=results.count(False)
    if pattern is not None and not results and not skipped[0]:
        print(f"CodecSelfTest : aucun contrôle ne correspond au filtre « {pattern.pattern} »"); return None
    if list_only:
        print(f"{len(results)} contrôle(s)"); return 0
    print(f"CodecSelfTest : {len(results)-fails}/{len(results)} OK"+(f", {fails} FAIL" if fails else "")+(f", {skipped[0]} SKIP" if skipped[0] else "")
          +(f" — run PARTIEL (filtre « {pattern.pattern} », {left_out[0]} contrôle(s) écarté(s)) : le run complet reste "
            "exigé avant commit" if pattern is not None else "")
          +(" — un échec peut venir d'un contrôle écarté dont celui-ci dépend : relancer le run complet"
            if pattern is not None and fails else ""))
    return fails

# ── PerfBench — mesures de performance sur jeu de données synthétique (story 6) ─
# Générateur SQL direct (INSERT/executemany par gros lots), jamais de vrai `borg backup` (bien trop
# lent pour représenter plusieurs Go en temps de test raisonnable). Bases TEMPORAIRES uniquement
# (comme CodecSelfTest) : aucune vraie base ni vrai rc n'est touché, tout est nettoyé en `finally`.

_PB_DEFAULT_DIFF_ROWS=250000  # voir Implementation Notes (TECHNICAL.md) pour la justification de
# cet ordre de grandeur (octets/ligne mesurés x nombre de lignes ~ taille cible)
_PB_KDF_DEFAULT_ROWS=30000  # -K SANS -n explicite : jeu réduit dédié pour KDF/DbEncrypt/DbDecrypt
# ("plus lent, optionnel" — ne doit jamais migrer le jeu par défaut/complet, seulement un -n explicite
# doit gouverner cette taille aussi, voir perf_bench())
_PB_JUDGMENT_S=1.0  # seuil de jugement (Intent/Boundaries de la story) : opération de lecture
# interactive (TreeHist/TreeFind/Search) qui dépasse la seconde sur le jeu de référence
_PB_ARCHIVES=[f"pb-a{i}" for i in range(5)]        # pb-a0..pb-a4 ; pb-a4 = dernière (snapshot courant)
_PB_DATES=[f"2026-0{i+1}-15T00:00:00" for i in range(5)]

def _pb_build_dirs(n_dirs_target,seed):
    """Arborescence synthétique, profondeur variable (jamais tout au même niveau) : part d'une
    vingtaine de répertoires de tête réalistes, puis étend récursivement au hasard jusqu'à atteindre
    n_dirs_target, en bornant la profondeur (7) pour rester réaliste."""
    import random
    rnd=random.Random(seed)
    top=['etc','var','var/log','var/lib','var/cache','home','home/user1','home/user2','home/user3',
         'usr','usr/share','usr/lib','usr/local','opt','srv','data','data/archive','data/archive/2024',
         'data/archive/2025','mnt/backup','mnt/backup/daily','mnt/backup/weekly']
    sub=['sub','cache','tmp','logs','conf.d','modules','plugins','assets','build','node_modules',
         'src','include','bin','lib','share','doc','vendor','dist','releases','snapshots']
    dirs=list(top)
    while len(dirs)<n_dirs_target:
        parent=dirs[rnd.randrange(len(dirs))]
        if parent.count('/')>=7: parent=top[rnd.randrange(len(top))]
        dirs.append(parent+'/'+sub[rnd.randrange(len(sub))]+str(rnd.randrange(1000)))
    return dirs

def _pb_build_paths(n_files,dirs,seed):
    """n_files chemins uniques (garantis, suffixe numérique en cas de collision (répertoire,nom)) —
    même nom de fichier réutilisé dans des répertoires différents (cas réaliste que AD-3 protège),
    profondeur héritée de `dirs`."""
    import random
    rnd=random.Random(seed)
    fname=['app.log','config.json','data.db','index.html','main.py','README.md','style.css',
           'output.txt','error.log','settings.yaml','backup.tar.gz','image.png','script.sh',
           'notes.txt','archive.zip','report.pdf','cache.bin','session.dat','manifest.xml','token.key']
    counts={}; paths=[]
    for _ in range(n_files):
        d=dirs[rnd.randrange(len(dirs))]; f=fname[rnd.randrange(len(fname))]
        c=counts.get((d,f),0); counts[(d,f)]=c+1
        paths.append(f"{d}/{f}" if c==0 else f"{d}/{f}.{c}")
    return paths

def _pb_build_db(db_path,nick,paths,root_removed,diff_target,encrypted,passphrase=None):
    """Construit un diff_index/snapshot_file synthétique par INSERT direct (executemany en gros lots) :
    snapshot complet uniquement sur la dernière archive (pb-a4, comme un jeu de mesure, pas un
    historique complet à indexer), churn (added/modified/removed) réparti sur les 4 paires
    d'archives ; `root_removed` (quelques centaines de chemins à la racine) disparaît à la toute
    dernière paire -> supprimés récupérables directement sous la racine (TreeHist/TreeFind)."""
    import random
    rnd=random.Random(4242)
    for suf in ('','-wal','-shm'):
        if os.path.exists(db_path+suf): os.unlink(db_path+suf)
    dbh=BorgHelperDB(os.path.dirname(db_path),'pb')
    dbh.ensure_diff_db(db_path)
    if encrypted:
        hdr,_dek=_enc_header_build(passphrase,'siv1','light')  # 'light' ici : coût KDF mesuré à part (-K)
        c=_open_db(db_path,nick=None,role='admin'); _enc_header_write(c,hdr); c.close()
    conn=_open_db(db_path,nick=nick,passphrase=passphrase,role='write',timeout=120)
    conn.execute("PRAGMA synchronous=OFF")  # fixture jetable : seule la vitesse de construction compte
    E=(lambda p: conn.codec.path.encode(p)) if conn.codec else (lambda p: p)
    BATCH=10000
    def _run_batched(sql,rows_iter):
        buf=[]
        for r in rows_iter:
            buf.append(r)
            if len(buf)>=BATCH: conn.executemany(sql,buf); buf=[]
        if buf: conn.executemany(sql,buf)
    _run_batched("INSERT INTO snapshot_file(nick,path,size,mtime,type,mode,owner) VALUES(?,?,?,?,?,?,?)",
                 ((nick,E(p),rnd.randrange(1,5_000_000),'2026-05-15T00:00:00','-','-rw-r--r--','1000:1000') for p in paths))
    conn.commit()
    ids={stored:rid for stored,rid in conn.execute("SELECT path,id FROM snapshot_file WHERE nick=?",(nick,))}
    _run_batched("INSERT INTO archive_snapshot(nick,archive,archive_date,file_id) VALUES(?,?,?,?)",
                 ((nick,_PB_ARCHIVES[-1],_PB_DATES[-1],ids[E(p)]) for p in paths))
    conn.execute("INSERT INTO archive_snapshot_indexed(nick,archive,entry_count) VALUES(?,?,?)",(nick,_PB_ARCHIVES[-1],len(paths)))
    for a,d in zip(_PB_ARCHIVES,_PB_DATES):
        conn.execute("INSERT INTO archive_stats(nick,archive,archive_date,nfiles) VALUES(?,?,?,?)",(nick,a,d,len(paths)))
    for ao,an in zip(_PB_ARCHIVES,_PB_ARCHIVES[1:]):
        conn.execute("INSERT INTO diff_indexed_pairs(nick,archive_old,archive_new,entry_count) VALUES(?,?,?,0)",(nick,ao,an))
    conn.commit()
    n_pairs=len(_PB_ARCHIVES)-1
    per_pair=max(1,diff_target//n_pairs)
    def _diff_rows():
        for pi in range(n_pairs):
            ao,an,dn=_PB_ARCHIVES[pi],_PB_ARCHIVES[pi+1],_PB_DATES[pi+1]
            for _ in range(per_pair):
                p=paths[rnd.randrange(len(paths))]; r=rnd.random()
                if r<0.30: ct,sb,sa='added',None,rnd.randrange(1,1_000_000)
                elif r<0.85: ct,sb,sa='modified',rnd.randrange(1,1_000_000),rnd.randrange(1,1_000_000)
                else: ct,sb,sa='removed',rnd.randrange(1,1_000_000),None
                yield (nick,ao,an,dn,ct,E(p),sb,sa)
            if pi==n_pairs-1:
                for p in root_removed: yield (nick,ao,an,dn,'removed',E(p),rnd.randrange(1,100000),None)
    _run_batched("INSERT INTO diff_index(nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES(?,?,?,?,?,?,?,?)",
                 _diff_rows())
    conn.commit(); conn.close()

def perf_bench(size=None,with_kdf=False):
    """Génère un jeu de données synthétique réaliste (SQL direct, PAS de vrai borg) et chronomètre
    chaque commande listée dans l'Intent de la story 6, en mode plain ET chiffré (`time.perf_counter`).
    -K (with_kdf=True) : ajoute le coût KDF (DB_KDF=standard/light/strong) et DbEncrypt/DbDecrypt —
    sur un jeu réduit dédié (`_PB_KDF_DEFAULT_ROWS`) si `-n` n'a pas été donné explicitement (sinon,
    `-n` gouverne aussi ce jeu, même combiné à `-K`). Fichiers temporaires nettoyés en `finally`
    (succès ou échec). Ne corrige jamais rien — seulement question posée à l'utilisateur pour toute
    mesure qui dépasse le seuil de jugement (Boundaries de la story) ; retourne 0 si toutes les
    mesures ont pu s'exécuter, 1 si l'une d'elles a levé une exception (voir `results`)."""
    import tempfile,shutil,time,io,contextlib
    size_explicit=size is not None
    n_diff=size or _PB_DEFAULT_DIFF_ROWS
    n_files=max(1000,n_diff//3)
    n_dirs=max(50,n_files//20)
    n_root_removed=300
    tmp=tempfile.mkdtemp(prefix='borghelper-perfbench-')
    results=[]
    try:
        cache=os.path.join(tmp,'cache'); os.makedirs(cache)
        rc=os.path.join(tmp,'rc')
        with open(rc,'w') as f:
            f.write("[pb_plain]\nBORG_REPO=/r\nBORG_PASSPHRASE=x\nSER_NAME=s\nGLOB_ARCH=s-*\nMOUNTPOINT=/m\n\n")
            f.write("[pb_enc]\nBORG_REPO=/r\nBORG_PASSPHRASE=benchpw\nSER_NAME=s\nGLOB_ARCH=s-*\nMOUNTPOINT=/m\nDB_ENCRYPT=true\n\n")
            f.write("[pb_kdf]\nBORG_REPO=/r\nBORG_PASSPHRASE=kdfpw\nSER_NAME=s\nGLOB_ARCH=s-*\nMOUNTPOINT=/m\n\n")  # -K sans -n : jeu réduit dédié
        os.chmod(rc,0o600)
        bh=BorgHelper(cfgfile=rc,cache_dir=cache)
        print(f"PerfBench : génération — {n_files:,} chemins, {n_dirs:,} répertoires, ~{n_diff:,} lignes diff_index par mode"
              +(" (+ KDF/DbEncrypt/DbDecrypt, -K)" if with_kdf else ""))
        dirs=_pb_build_dirs(n_dirs,seed=1)
        paths=_pb_build_paths(n_files,dirs,seed=2)
        root_removed=[f"root-removed-{i}.dat" for i in range(n_root_removed)]
        dbs={}
        for label,nick,encrypted,pw in (('plain','pb_plain',False,None),('siv1','pb_enc',True,'benchpw')):
            db_path=bh.db.get_diff_db(nick)
            t0=time.perf_counter()
            _pb_build_db(db_path,nick,paths,root_removed,n_diff,encrypted,passphrase=pw)
            dt=time.perf_counter()-t0
            dbs[label]=(nick,db_path)
            print(f"  {label:6s} : construit en {dt:.1f} s — {os.path.getsize(db_path)/1_048_576:.0f} Mio sur disque")
        def _run_silent(fn,*a,**k):
            out=io.StringIO(); err=io.StringIO()
            with contextlib.redirect_stdout(out),contextlib.redirect_stderr(err): fn(*a,**k)
            return out.getvalue()
        deep_dir=dirs[-1]
        sites=[
            ("TreeHist racine",                    lambda nick: bh.treehist(nick,None,archive_from='ALL',as_json=True)),
            ("TreeHist sous-répertoire profond",   lambda nick: bh.treehist(nick,deep_dir,archive_from='ALL',as_json=True)),
            ("TreeFind motif large racine (*.log)",lambda nick: bh.treefind(nick,None,'*.log',as_json=True)),
            ("Search motif large (*.log)",         lambda nick: bh.search(nick,'*.log',archive_from='ALL',as_json=True)),
            ("DuIdx motif large -R (*)",           lambda nick: bh.duidx(nick,'*',archive_from='ALL',raw=True)),
            ("IdxTop",                             lambda nick: bh.idxtop(nick,depth=3,topn=20,as_json=True)),
            ("DiffTop",                            lambda nick: bh.difftop(nick,bkp=f"{_PB_ARCHIVES[-2]},{_PB_ARCHIVES[-1]}",depth=3,topn=10,as_json=True)),
            ("_find_last_archive_with_file (glob)",lambda nick: bh._find_last_archive_with_file(nick,'*.log')),
            ("IdxPurge -D motif large (*.log)",    lambda nick: bh.idxpurge(nick,pattern='*.log',dryrun=True)),
        ]
        print(f"\n{'Commande':42s} {'mode':7s} {'durée':>10s}")
        for label,fn in sites:
            for mode_label,(nick,_db_path) in dbs.items():
                t0=time.perf_counter()
                try: _run_silent(fn,nick)
                except Exception as e:
                    dt=time.perf_counter()-t0
                    results.append((label,mode_label,None,f"ERREUR {type(e).__name__}: {e}"))
                    print(f"{label:42s} {mode_label:7s} {'ERREUR':>10s}  {e}")
                    continue
                dt=time.perf_counter()-t0
                note='SEUIL DÉPASSÉ (>1s)' if dt>_PB_JUDGMENT_S else ''
                results.append((label,mode_label,dt,note))
                print(f"{label:42s} {mode_label:7s} {dt*1000:9.1f} ms  {note}")
        # ── plan d'exécution : LIKE 'préfixe%' (avant AD-8/Story 2) vs intervalle d'index actuel ──
        # remplace le chiffre non reproductible de la Story 2 (170 ms -> ~1 ms, table jetable, retiré de
        # TECHNICAL.md) par une mesure réelle et reproductible sur CE jeu : même sélection de préfixe,
        # LIKE (plan pré-AD-8, comparaison seulement — jamais utilisé en base chiffrée ni en code réel)
        # contre l'intervalle `path>=? AND path<?` de `_psel_under` (idx_diff_nick_path), sur `plain`.
        plike_nick,plike_db=dbs['plain']
        plike_conn=_open_db(plike_db,nick=plike_nick)
        like_prefix=dirs[len(dirs)//2]
        t0=time.perf_counter()
        like_count=plike_conn.execute("SELECT COUNT(*) FROM diff_index WHERE nick=? AND path LIKE ?",
                                       (plike_nick,like_prefix+'/%')).fetchone()[0]
        t_like=time.perf_counter()-t0
        usql,uprm,_=_psel_under(plike_conn,like_prefix)
        t0=time.perf_counter()
        range_count=plike_conn.execute(f"SELECT COUNT(*) FROM diff_index WHERE nick=?"+_wh(usql),[plike_nick]+uprm).fetchone()[0]
        t_range=time.perf_counter()-t0
        plike_conn.close()
        print(f"\nPlan d'exécution diff_index (préfixe {like_prefix!r}, {n_diff:,} lignes, plain) : "
              f"LIKE 'préfixe%' {t_like*1000:.2f} ms ({like_count:,} lignes) vs intervalle d'index "
              f"{t_range*1000:.2f} ms ({range_count:,} lignes)")
        # ── politique du mémo de décodage : mono-passe (froid) vs ré-accès répété (mémoïsé) ──
        nick,db_path=dbs['siv1']
        conn=_open_db(db_path,nick=nick,passphrase='benchpw')
        codec=conn.codec
        sample=[r[0] for r in conn.execute("SELECT path FROM snapshot_file WHERE nick=? LIMIT 20000",(nick,))]
        codec._memo.clear()
        t0=time.perf_counter()
        for s in sample: codec.decode_path(s)
        t_cold=time.perf_counter()-t0
        t0=time.perf_counter()
        for s in sample: codec.decode_path(s)
        t_warm=time.perf_counter()-t0
        conn.close()
        print(f"\nDbCodec.decode_path ({len(sample):,} chemins) : 1re passe (froid) {t_cold*1000:.1f} ms · "
              f"2e passe (mémoïsé, mêmes chemins) {t_warm*1000:.1f} ms"
              +(f" ({t_cold/t_warm:.0f}x)" if t_warm>0 else ""))
        if with_kdf:
            print("\n-- -K : coût KDF (par appel, = coût payé à CHAQUE requête borgHelperWWW sur base chiffrée) --")
            for level in _KDF_LEVELS:
                t0=time.perf_counter(); _enc_header_build('benchpw','siv1',level); dt=time.perf_counter()-t0
                print(f"  DB_KDF={level:8s} : {dt*1000:.1f} ms/appel")
            if size_explicit:
                # -n donné explicitement : gouverne aussi la mesure DbEncrypt/DbDecrypt (réutilise le jeu
                # déjà construit ci-dessus, pas de jeu séparé).
                kdf_nick,_db_path=dbs['plain']; kdf_n_files,kdf_n_diff=n_files,n_diff
            else:
                # -n omis : NE JAMAIS migrer le jeu par défaut/complet (83k-333k lignes) pour "plus lent,
                # optionnel" -- jeu réduit dédié (_PB_KDF_DEFAULT_ROWS), construit et nettoyé comme les
                # autres (même répertoire temporaire, même `finally`).
                kdf_n_diff=_PB_KDF_DEFAULT_ROWS; kdf_n_files=max(1000,kdf_n_diff//3)
                kdf_dirs=_pb_build_dirs(max(50,kdf_n_files//20),seed=3)
                kdf_paths=_pb_build_paths(kdf_n_files,kdf_dirs,seed=4)
                kdf_nick='pb_kdf'
                kdf_db_path=bh.db.get_diff_db(kdf_nick)
                _pb_build_db(kdf_db_path,kdf_nick,kdf_paths,[],kdf_n_diff,False)
            t0=time.perf_counter(); rc_enc=bh.db_encrypt(kdf_nick,confirm=True); dt=time.perf_counter()-t0
            print(f"  DbEncrypt (lots _MIGRATE_BATCH={_MIGRATE_BATCH}) : {dt:.1f} s pour {kdf_n_files+kdf_n_diff:,} lignes (code {rc_enc})"
                  +("" if size_explicit else f" [jeu réduit -K, -n non donné]"))
            t0=time.perf_counter(); rc_dec=bh.db_decrypt(kdf_nick,confirm=True); dt=time.perf_counter()-t0
            print(f"  DbDecrypt : {dt:.1f} s (code {rc_dec})")
        over=[r for r in results if r[2] is not None and r[2]>_PB_JUDGMENT_S]
        if over:
            print(f"\n{len(over)} mesure(s) dépassent le seuil de jugement (>{_PB_JUDGMENT_S:.0f} s) : "
                  "corriger maintenant ou documenter dans le Deferred de la spine — décision à demander "
                  "à l'utilisateur avant tout correctif (Boundaries de la story), jamais d'optimisation préventive ici.")
        errs=[r for r in results if r[2] is None]
        return 1 if errs else 0
    finally:
        shutil.rmtree(tmp,ignore_errors=True)

