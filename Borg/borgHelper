def d2DateNSince(datepourrie):
    from datetime import datetime
    now=datetime.now()
    datelisible=datetime.strptime(datepourrie,"%Y-%m-%dT%H:%M:%S.%f")
    since=(now-datelisible).total_seconds()/60/60
    return {'since':since,'date':datelisible.strftime("%Y/%m/%d %H:%M:%S")}

def _age_readable(since_hours):
    """'il y a XhYY' depuis un nombre d'heures (float, voir d2DateNSince) — utilisé par Status pour
    l'âge du dernier backup connu."""
    total_min=int(round(since_hours*60))
    h,m=divmod(max(total_min,0),60)
    return f"il y a {h}h{m:02d}"

def _bkp_running_readable(started_at):
    """'HH:MM (XhYYmin)' depuis un started_at bkp_status (écrit via sqlite datetime('now'), donc UTC —
    voir borgHelperWWW _expires_matches pour le même constat). Conversion UTC->local par offset naïf
    (pas de zoneinfo dans ce projet), uniquement pour l'affichage de l'heure de début ; l'écoulé est
    calculé en UTC des deux côtés (pas d'offset possible dessus)."""
    from datetime import datetime
    started_utc=datetime.strptime(started_at,"%Y-%m-%d %H:%M:%S")
    now_utc=datetime.utcnow()
    started_local=started_utc+(datetime.now()-now_utc)
    total_min=int((now_utc-started_utc).total_seconds()//60)
    h,m=divmod(max(total_min,0),60)
    return f"{started_local.strftime('%H:%M')} ({h}h{m:02d}min)"

def prettyTabelise(tab):
    from prettytable import PrettyTable
    clefs={}; serrure=0
    for i in tab.keys():
        for j in tab[i].keys():
            if j not in clefs: clefs[j]=serrure; serrure+=1
    t=PrettyTable(clefs.keys())
    for i in tab.keys():
        liste=[tab[i][j] if j in tab[i] else "" for j in clefs]
        t.add_row(liste)
    return t

def htmlTabelise(tabl,border=0,colnames=None,errhost=[]):
    ret="<table border='0'>\n  <tr>\n"
    if colnames is None:
        colnames=[]
        for y in tabl.keys():
            for x in tabl[y].keys(): colnames.append(x)
    for x in colnames:
        if x in errhost: ret+=f"    <th colspan=1 style='background:#FF6161;'>{x}</td><td style='width:20px;background:#FF6161;'></th>\n"
        else: ret+=f"    <th colspan=1 style='background:#00A4E6;'>{x}</td><td style='width:20px;background:#00A4E6;'></th>\n"
    ret+="    </tr>\n"
    blue=0; listy=len(tabl.keys())
    for y in tabl.keys():
        ret+='  <tr>\n'; listy-=1; concol=0; colstyl=""
        if '_msg' in tabl[y]:
            nom_val=tabl[y].get('nom',y)
            ret+=f"    <td colspan=1>{nom_val}</td><td style='width:20px;'></td>\n"
            ret+=f"    <td colspan=100 style='text-align:left;font-style:italic;color:#888;'>{tabl[y]['_msg']}</td>\n"
            ret+='  </tr>\n'; blue=0 if blue else 1; continue
        for x in colnames:
            val=""
            if concol: colstyl='text-align:right;'
            if x in tabl[y]: val=tabl[y][x]
            if listy==0: ret+=f"    <td colspan=1 style='{colstyl}'><em>{val}</em></td><td style='width:20px;'></td>\n"
            elif val in errhost: ret+=f"    <td colspan=1 style='{colstyl}background:#FF6161;'>{val}</td><td style='width:20px;background:#FF6161;'></td>\n"
            elif blue: ret+=f"    <td colspan=1 style='{colstyl}background:#BEEDFF;'>{val}</td><td style='width:20px;background:#BEEDFF;'></td>\n"
            else: ret+=f"    <td colspan=1 style='{colstyl}'>{val}</td><td style='width:20px;'></td>\n"
            concol+=1
        ret+='    </tr>\n'
        blue=0 if blue else 1
    ret+='</table>\n'
    return ret

def filtrer_lignes(tableau,X):
    toutes_cles=list(tableau.keys())
    if X>len(toutes_cles): cles_a_conserver=toutes_cles
