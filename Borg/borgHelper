            c.execute("UPDATE snapshot_file SET path=? WHERE id=?",(tampered,rid)); c.commit(); c.close()
            r=b.db_encrypt('m16',confirm=True)  # reprise : la corruption est dans table1, déjà migrée avant l'interruption
