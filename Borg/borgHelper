        dabesi=d2DateNSince(resume['last'])
        tcmpl={}
        tcmpl[nick]={'nom':nick,'date derniere':dabesi["date"],'depuis':dabesi['since']}
        if not c:
            tcmpl[nick]['duree']=-1; tcmpl[nick]['derniere']=0
        else:
            tcmpl[nick]['duree']=kept[resume['lastname']]['durationM']
            tcmpl[nick]['derniere']=kept[resume['lastname']]['deduplicated_size']
        tcmpl[nick]['moy']=resume['moy_deduplicated_size']
        tcmpl[nick]['taille']=resume['unique_csize']
        tcmpl[nick]['recuperable']=resume['prunable']
        tcmpl[nick]['reste']=avail
        tbkps={'Prunable':{'name':'Prunable','original_size':resume['prunable_os'],'compressed_size':resume['prunable_cs'],'deduplicated_size':resume['prunable']}}
        cpt=0
        for i in kept.keys():
            if kept[i]['prunMe']=='No':
                if (maxp is None) or ((notPrunable-cpt)<=maxp):
                    tbkps[i]=kept[i]
                    tbkps[i]['duration']=kept[i]['durationM']
                    tbkps[i].pop('durationM'); tbkps[i].pop('prunMe')
                cpt+=1
        tbkps['Totaux']={'name':'Totaux','original_size':resume['total_size'],'compressed_size':resume['total_csize'],'deduplicated_size':resume['unique_csize']}
        diff_stats=self.db._diff_stats_for_nick(nick)
        def _fmt_stats(s,nf,total_sz=0):
            na,nr,nm=s['added'],s['removed'],s['modified']
            present=max(0,nf-na-nm); total_prev=present+nr+nm
            present_sz=max(0,total_sz-s['added_sz']-s['modified_sz'])
            pct_n=lambda n: f" ({100*n//total_prev}%)" if total_prev>0 else ""
            pct_sz=lambda sz: f" ({100*sz//total_sz}%)" if total_sz>0 else ""
            return {'+ajouté':f"{na}{pct_n(na)} · {convert_octets_readable(s['added_sz'])}{pct_sz(s['added_sz'])}",
                    '-supprimé':f"{nr}{pct_n(nr)} · {convert_octets_readable(s['removed_sz'])}{pct_sz(s['removed_sz'])}",
                    '=présent':f"{present}{pct_n(present)} · {convert_octets_readable(present_sz)}{pct_sz(present_sz)}"}
        last_arch=resume.get('lastname','')
        s_last=diff_stats.get(last_arch) if last_arch else None
        if s_last:
            nf_last=kept.get(last_arch,{}).get('nfiles',0) or 0
            sz_last=kept.get(last_arch,{}).get('original_size',0) or 0
            for k,v in _fmt_stats(s_last,nf_last,sz_last).items(): tcmpl[nick][k]=v
        else:
            tcmpl[nick]['+ajouté']='—'; tcmpl[nick]['-supprimé']='—'; tcmpl[nick]['=présent']='—'
        for arch in list(tbkps.keys()):
            if 'nfiles' not in tbkps[arch]: continue
            s=diff_stats.get(arch)
            if s:
                nf=tbkps[arch].get('nfiles',0) or 0; sz=tbkps[arch].get('original_size',0) or 0
                for k,v in _fmt_stats(s,nf,sz).items(): tbkps[arch][k]=v
            else:
                tbkps[arch]['+ajouté']='—'; tbkps[arch]['-supprimé']='—'; tbkps[arch]['=présent']='—'
        return tcmpl,tbkps

    def report_offline(self,nicks,htrep=False,debug=0,maxp=None,as_json=False):
        from prettytable import PrettyTable
        summary={}; detail={}
        def _fmt(n,sz): return f"{n} · {convert_octets_readable(sz)}" if n else '—'
        for nick in nicks.split(','):
            db_path=self.db.get_diff_db(nick)
            if not os.path.exists(db_path):
                printer(f"[ERREUR] {nick}: diff.db absent — lancez borgHelper -c Index -n {nick}"); continue
            self.db.ensure_diff_db(db_path)
            diff_stats=self.db._diff_stats_for_nick(nick)
            if not diff_stats:
                printer(f"[ERREUR] {nick}: index vide — lancez borgHelper -c Index -n {nick}"); continue
            try:
                conn=sqlite3.connect(db_path)
                rows=conn.execute("SELECT DISTINCT archive_new, archive_new_date FROM diff_index WHERE nick=? ORDER BY archive_new_date",(nick,)).fetchall()
                conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error ({nick}): {e}"); continue
            archives=rows
            if maxp is not None: archives=archives[-maxp:]
            try:
                conn=sqlite3.connect(db_path)
                astats={r[0]:{'duration':r[1],'original_size':r[2],'compressed_size':r[3],'deduplicated_size':r[4],'nfiles':r[5]}
                        for r in conn.execute("SELECT archive,duration,original_size,compressed_size,deduplicated_size,nfiles FROM archive_stats WHERE nick=?",(nick,)).fetchall()}
                conn.close()
            except sqlite3.Error: astats={}
            detail[nick]={}
            for arch,arch_date in archives:
                s=diff_stats.get(arch,{}); a=astats.get(arch,{})
                detail[nick][arch]={'archive':arch,'date':(arch_date or '')[:19],
                    'taille':convert_octets_readable(a.get('original_size')) if a.get('original_size') else '—',
                    'nfiles':str(a.get('nfiles','—')),
                    '+ajouté':_fmt(s.get('added',0),s.get('added_sz',0)),
                    '-supprimé':_fmt(s.get('removed',0),s.get('removed_sz',0)),
                    '=modifié':_fmt(s.get('modified',0),s.get('modified_sz',0))}
            last_arch,last_date=archives[-1] if archives else (None,None)
            s=diff_stats.get(last_arch,{}) if last_arch else {}
            a=astats.get(last_arch,{}) if last_arch else {}
            summary[nick]={'nick':nick,'dernière archive':last_arch or '—','date':(last_date or '')[:19],
                'taille':convert_octets_readable(a.get('original_size')) if a.get('original_size') else '—',
                'nfiles':str(a.get('nfiles','—')),
                '+ajouté':_fmt(s.get('added',0),s.get('added_sz',0)),
                '-supprimé':_fmt(s.get('removed',0),s.get('removed_sz',0)),
                '=modifié':_fmt(s.get('modified',0),s.get('modified_sz',0))}
        if as_json:
            print(json.dumps({'summary':summary,'detail':detail},ensure_ascii=False,indent=2)); return 0
        if not summary: return 0
        sum_cols=['nick','dernière archive','date','taille','nfiles','+ajouté','-supprimé','=modifié']
        det_cols=['archive','date','taille','nfiles','+ajouté','-supprimé','=modifié']
        if htrep:
            print("<!DOCTYPE html><html><body bgcolor='#ffffff'><br>")
            print(htmlTabelise(summary,colnames=sum_cols))
            for nick,arcs in detail.items():
                if arcs: print('<br>'); print(htmlTabelise(arcs,colnames=det_cols))
            print("</body></html>")
        else:
            t=PrettyTable(sum_cols)
            for nick,s in summary.items(): t.add_row([s[c] for c in sum_cols])
            print(t)
            for nick,arcs in detail.items():
                if not arcs: continue
                td=PrettyTable(det_cols); td.align['archive']='l'
                for a in arcs.values(): td.add_row([a[c] for c in det_cols])
                print(td)
        return 0

    def report(self,nicks,htrep=False,dayback=None,debug=0,maxp=None,as_json=False):
        reshos={}; resbck={}; reshosto={}; errcode=0; errhost=[]
        for i in ['duree','derniere','taille','recuperable']: reshosto[i]=0
        reshosto['nom']='Totaux'
        for nick in nicks.split(','):
            cfg=self.borg.cfgreaded(nick,debug=debug)
            try:
                (tcmpl,tbkps)=self.prep_report(nick,debug=debug,maxp=maxp)
            except Exception as e:
                errcode=2; printer(f"[ERREUR] {nick}: {e}"); err_msg=str(e)[:80]
                if htrep:
                    errhost.append(nick)
                    reshos[nick]={'nom':nick,'duree':'—','depuis':'ERREUR','derniere':'—','taille':'—','recuperable':'—','reste':f"⚠ {err_msg}"}
                else:
                    reshos[nick]={'nom':f"*** ERREUR {nick}",'duree':'—','depuis':'ERREUR','derniere':'—','taille':'—','recuperable':'—','reste':f"⚠ {err_msg}"}
                resbck[nick]={}; continue
            maxage=25
            if "MAX_AGE_BKP" in cfg: maxage=float(cfg["MAX_AGE_BKP"])
            if tcmpl[nick]['depuis']>maxage:
                errcode=1
                if htrep: errhost.append(nick)
                else: tcmpl[nick]['nom']=f"***{nick}"
            for i in ['duree','derniere','taille','recuperable']: reshosto[i]+=tcmpl[nick][i]
            for i in ['derniere','moy','taille','recuperable','reste']:
                if (i in tcmpl[nick].keys()) and not(tcmpl[nick][i] is None): tcmpl[nick][i]=convert_octets_readable(tcmpl[nick][i])
                else: tcmpl[nick][i]=""
            tcmpl[nick]['depuis']=f"{tcmpl[nick]['depuis']:.2f} h"
            tcmpl[nick]['duree']=f"{tcmpl[nick]['duree']:.2f} min"
            for i in tbkps.keys():
                for j in ['original_size','compressed_size','deduplicated_size']:
                    tbkps[i][j]=convert_octets_readable(tbkps[i][j])
                if 'duration' in tbkps[i].keys():
                    tbkps[i]['duration']=f"{tbkps[i]['duration']:.2f} min"
            reshos[nick]=tcmpl[nick]; resbck[nick]=tbkps
        for i in ['derniere','taille','recuperable']: reshosto[i]=convert_octets_readable(reshosto[i])
        reshosto['duree']=f"{reshosto['duree']:.2f} min"
        reshos['Totaux']=reshosto
        for outer_key,inner_dict in resbck.items():
            for inner_key,nested_dict in inner_dict.items():
                if "name" in nested_dict:
                    valeur_name=nested_dict.pop("name")
                    nested_dict={outer_key:valeur_name,**nested_dict}
                    inner_dict[inner_key]=nested_dict
        resshortbck={}
        for nick in resbck.keys():
            disp=0
            if "DISPLAY_BKP" in cfg: disp=int(cfg["DISPLAY_BKP"])
            if maxp is not None: disp=maxp
            resshortbck[nick]=filtrer_lignes(resbck[nick],disp)
        if as_json:
            print(json.dumps({'summary':reshos,'backups':resbck},ensure_ascii=False,indent=2))
        elif htrep:
            print("<!DOCTYPE html>\n<html>\n  <body bgcolor=\"#ffffff\">\n    <br>")
            print(htmlTabelise(reshos,colnames=['nom','duree','depuis','derniere','taille','recuperable','reste','+ajouté','-supprimé','=présent'],errhost=errhost))
            for nick in nicks.split(','):
                print('    <br>')
                print(htmlTabelise(resshortbck[nick],colnames=[nick,'duration','original_size','compressed_size','deduplicated_size','nfiles','+ajouté','-supprimé','=présent'],errhost=errhost))
            print('  </body>\n</html>')
        else:
            print(prettyTabelise(reshos))
            for nick in nicks.split(','):
                print(prettyTabelise(resshortbck[nick]))
        return errcode


# ── CLI entry point ────────────────────────────────────────────────────────────

def _cli_main():
    sentryid=getDataFromEnvOrFile(env="BORGHELPERC_SENTRY_DSN",envpath="BORGHELPERC_SENTRY_FILE",paths="/usr/local/etc/borghelper-sentry")
    if sentryid is not None:
        import sentry_sdk
        sentry_sdk.init(dsn=sentryid,environment="production",release=f"borgHelper@{Version}",traces_sample_rate=1.0)

    try:
        opts,args=getopt.getopt(sys.argv[1:],"c:hH:s:n:k:p:r:m:b:B:f:w:W:dvjlILCFSN:o",["help"])
    except getopt.GetoptError as err:
        print(err); usage(); sys.exit(2)
    if args:
        printer(f"Argument(s) non reconnu(s) : {' '.join(args)}")
        printer("Utiliser -n <nick> pour spécifier le dépôt.")
        usage(); sys.exit(2)

    # 1ère passe : extraire cfgfile, debug, cmd
    cfgfile_arg=None; debug=0; cmd=None
    for opt,arg in opts:
        if opt=='-C': cfgfile_arg=os.path.expanduser(arg)
        elif opt=='-d': debug+=1
        elif opt=='-v': print(f"Version {Version}"); sys.exit(0)
        elif opt in ('-h','--help'): usage(); sys.exit(1)
        elif opt=='-H': usage(arg.lower()); sys.exit(1)
        elif opt=='-c': cmd=arg.lower()

    bh=BorgHelper(cfgfile=cfgfile_arg)

    optab={'stats':'Ccdn','login':'Ccdsnkprm','mount':'Ccdnb','umount':'Ccdn',
           'lstbkp':'Ccdn','lstbkpfls':'Ccdnb','restore':'CcdnbfwWL','diffbkp':'Ccdnbw',
           'delbkp':'Ccdnb','bkp':'CcdnI','prune':'Ccdn','report':'CcdnlNjo',
           'init':'Ccdn','key':'Ccdn','index':'CcdnFS','search':'CcdnfbB',
           'filehist':'CcdnfbB','cacheinfo':'Ccdn','cacheclean':'Ccdn','duidx':'CcdnfbBsj'}

    if cmd is None or cmd not in optab.keys():
        usage()

    options={}; nick=socket.gethostname()
    for opt,arg in opts:
        if opt[1] not in optab[cmd]:
            printer("step2"+opt[1]); usage(cmd)
        else:
            options[opt]=arg
        if opt=='-n': nick=arg

    if nick=="ALL":
        nick=bh.borg.cfgreadnicks(debug)

    if debug!=0:
        printer(f'La commande fume {cmd}')

    if cmd=='stats':
        bh.stats(nick if '-n' in options else None)
    elif cmd=='login':
        serna=options.get('-s',socket.gethostname())
        if '-n' not in options: nick=serna
        bh.login(serna,nick,options.get('-k',None),options.get('-p',None),options.get('-r',None),options.get('-m',None),debug=debug)
        if '-p' not in options: printer('p'); usage(cmd)
        if '-r' not in options: printer('r'); usage(cmd)
    elif cmd=='mount':
        bh.mount(nick,bid=options.get('-b','ALL'),debug=debug)
    elif cmd=='umount':
        bh.umount(nick,debug=debug)
    elif cmd=='lstbkp':
        bh.list_backups(nick,debug=debug)
    elif cmd=='lstbkpfls':
        bid=options.get('-b',None)
        if bid=='last': bid=None
        bh.list_files(nick,bid,debug=debug)
    elif cmd=='key':
        bh.key(nick,debug=debug)
    elif cmd=='report':
        _maxp=int(options['-N']) if '-N' in options else None
        if '-o' in options:
            errcmd=bh.report_offline(nick,as_json=('-j' in options),htrep=('-l' in options),maxp=_maxp,debug=debug)
        elif '-j' in options:
            errcmd=bh.report(nick,as_json=True,maxp=_maxp,debug=debug)
        elif '-l' in options:
            errcmd=bh.report(nick,htrep=True,maxp=_maxp,debug=debug)
        else:
            errcmd=bh.report(nick,maxp=_maxp,debug=debug)
        sys.exit(errcmd)
    elif cmd=='diffbkp':
        if '-b' not in options:
            bidun=None; bideux=None
        elif ',' in options['-b']:
            bidun,bideux=options['-b'].split(',',2)
        else:
            bidun=options['-b']; bideux=None
        bh.diffbkp(nick,bidun,bideux,debug=debug)
    elif cmd=='restore':
        bid=options.get('-b',None)
        if bid=='last': bid=None
        if '-f' not in options: usage(cmd)
        if '-L' in options:
            bh.listperms(nick,bid,options['-f'],debug=debug)
        else:
            if '-w' not in options and '-W' not in options: usage(cmd)
            if '-W' in options: where=options['-W']; flat=True
            else: where=options['-w']; flat=False
            bh.restore(nick,bid,options['-f'],where,flat=flat,debug=debug)
    elif cmd=='delbkp':
        if '-b' not in options or 'last' in options['-b']: usage(cmd)
        bh.delbkp(nick,options['-b'],debug=debug)
    elif cmd=='bkp':
        bh.backup(nick,no_index=('-I' in options),debug=debug)
    elif cmd=='prune':
        errcmd=0; ret={}
        if ',' in nick:
            nicks=nick
            for nick in nicks.split(','):
                print(f"Prunning {nick}...")
                ret=bh.prune(nick,debug=debug)
                if ret['exitcode']!=0: print(ret); errcmd=ret['exitcode']
        else:
            print(f"Prunning {nick}...")
            ret=bh.prune(nick,debug=debug)
            errcmd=ret['exitcode']
            if errcmd!=0: print(ret)
        sys.exit(errcmd)
    elif cmd=='init':
        bh.init_repo(nick,debug=debug)
    elif cmd=='cacheinfo':
        bh.cache_info(nick,debug=debug)
    elif cmd=='cacheclean':
        bh.cache_clean(nick,debug=debug)
    elif cmd=='index':
        _force='-F' in options; _snaponly='-S' in options
        for n in nick.split(','):
            if _snaponly: bh.indexsnap(n,debug=debug,force=_force)
            else: bh.index(n,debug=debug,force=_force)
    elif cmd=='search':
        if '-f' not in options: usage(cmd)
        bh.search(nick,options['-f'],archive_from=options.get('-b',None),archive_to=options.get('-B',None),debug=debug)
    elif cmd=='filehist':
        if '-f' not in options: usage(cmd)
        bh.filehist(nick,options['-f'],archive_from=options.get('-b',None),archive_to=options.get('-B',None),debug=debug)
    elif cmd=='duidx':
        _du_sort=options.get('-s','chemin')
        _du_rev=_du_sort.endswith(':desc')
        _du_sort=_du_sort.replace(':asc','').replace(':desc','')
        if _du_sort not in ('chemin','added','removed','présent','present'): _du_sort='chemin'
        if _du_sort=='present': _du_sort='présent'
        bh.duidx(nick,options.get('-f',None),sort_by=_du_sort,reverse=_du_rev,
                 as_json=('-j' in options),archive_from=options.get('-b',None),
                 archive_to=options.get('-B',None),debug=debug)
    else:
        printer("Mais comment on peut en arriver la ?"); usage()


if __name__=='__main__':
    _cli_main()
