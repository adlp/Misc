    def _diff_archive_filter(self,nick,archive_from,conn,archive_to=None):
        def _date_of(archive):
            row=conn.execute("SELECT archive_new_date FROM diff_index WHERE nick=? AND (archive_new=? OR archive_old=?) LIMIT 1",(nick,archive,archive)).fetchone()
            return row[0] if row and row[0] else archive
        clauses=[]; params=[]
        if archive_from is None and archive_to is None:
            row=conn.execute("SELECT MAX(archive_new) FROM diff_index WHERE nick=?",(nick,)).fetchone()
            if row and row[0]: return ' AND archive_new=?',[row[0]]
            return '',[]
        if archive_from and archive_from!='ALL':
            d=_date_of(archive_from); clauses.append('archive_new_date>=?'); params.append(d)
        if archive_to:
            d=_date_of(archive_to); clauses.append('archive_new_date<=?'); params.append(d)
        if not clauses: return '',[]
        return ' AND '+' AND '.join(clauses),params

    def _duidx_collect(self,nick,sel,key_fn,archive_from=None,archive_to=None):
        totals={}
        for n in nick.split(','):
            db_path=self.get_diff_db(n)
            self.ensure_diff_db(db_path,create=False)
            if self._is_index_empty(n,db_path):
                printer(f"[ERREUR] Index vide pour {n} — lancez : borgHelper -c Index -n {n}"); continue
            conn=None
            try:
                conn=_open_db(db_path,nick=n,role='read')
                af_sql,af_params=self._diff_archive_filter(n,archive_from,conn,archive_to)
                psql,pprm,pyf=_psel_duidx(conn,sel)
                for ct,path,sz in conn.execute("SELECT change_type,path,CASE WHEN change_type='removed' THEN size_before ELSE size_after END FROM diff_index WHERE nick=?"+_wh(psql)+af_sql,[n]+pprm+af_params):
                    path=_path_decode(conn,path)
                    if pyf and not pyf(path): continue
                    k=key_fn(path)
                    if k is not None: _duidx_add(totals,k,ct,sz)  # None : hors motif (_duidx_group_spec)
                df,dt=_snap_params(af_params,archive_from,archive_to)
                snap_extra=[x for x in [df,dt] if x]
                for path,sz in conn.execute("SELECT path,size FROM archive_snapshot_v WHERE nick=?"+_wh(psql)+" "+_snap_notin(df,dt),[n]+pprm+snap_extra):
                    path=_path_decode(conn,path)
                    if pyf and not pyf(path): continue
                    k=key_fn(path)
                    if k is not None: _duidx_add(totals,k,'présent',sz)
                conn.close()
            except DbCodecError as e: _codec_fail(n,e,conn)
            except sqlite3.Error as e:
                _close_quiet(conn)
                printer(f"SQLite error ({db_path}): {e}")
        return totals

    def _duidx_collect_global(self,nick,sel,archive_from=None,archive_to=None):
        totals={}
        for n in nick.split(','):
            db_path=self.get_diff_db(n)
            self.ensure_diff_db(db_path,create=False)
            if self._is_index_empty(n,db_path):
