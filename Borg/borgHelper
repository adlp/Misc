    def backup(self,nick,no_index=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        if not no_index and self._nick_noidx(nick): no_index=True
        if 'SSH_REPO' in cfg.keys():
            forceEnv={'BORG_REPO':cfg['SSH_REPO']}
        else:
            forceEnv=None
        preBorg=['ssh','-o','SendEnv BORG_*']
        if 'SSH_REMFO' in cfg.keys():
            preBorg.append('-R'); preBorg.append(cfg['SSH_REMFO'])
        preBorg.extend(f'-A -o VisualHostKey=no -o StrictHostKeyChecking=accept-new {cfg["SER_LOGIN"]}@{cfg["SER_NAME"]}'.split(' '))
        if 'SSH_KEY' in cfg.keys():
            preBorg.append('-i'); preBorg.append(cfg['SSH_KEY'])
        if 'SSH_REMFO' not in cfg.keys() or len(cfg['SSH_REMFO'])==0:
            preBorg=None
        archive_old=None
        if not no_index:
            try:
                prev=self.borg.getlastbkp(nick,1,debug=debug)
                archive_old=prev[0] if prev else None
            except Exception: archive_old=None
        create=['create']
        base_flags='--log-json --json --debug -v --stats'
        if not no_index: base_flags+=' --list --filter AMCBTd'
        create.extend(base_flags.split(' '))
        archname='root'
        if 'BORG_ARCHNAME' in cfg.keys(): archname=cfg['BORG_ARCHNAME']
        if archname[:2]=="::": create.append(archname+'-{now}')
        else: create.append('::{fqdn}-'+archname+'-{now}')
        rootbkp="/"
        if 'BORG_ROOTBKP' in cfg.keys(): rootbkp=cfg['BORG_ROOTBKP']
        create.append(rootbkp)
        if 'EXCLUDE' not in list(cfg.keys()):
            printer(list(cfg.keys()))
            printer("Il est necessaire que EXCLUDE soit configures dans ~/.borghelperrc")
            printer('  EXCLUDE = --exclude /media --exclude /dev --exclude /proc --exclude /sys --exclude /var/run --exclude /run --exclude /lost+found --exclude /mnt --exclude /var/lib/lxcfs --exclude /tmp --exclude /var/lib/docker --exclude-if-present .nobackup  --exclude-caches --exclude-nodump --keep-exclude-tags')
            exit(1)
        create.extend(cfg['EXCLUDE'].split(' '))
        if 'EXCLUDE_NEXT' in list(cfg.keys()):
            create.extend(cfg['EXCLUDE_NEXT'].split(' '))
        self.db.set_priority_lock(nick)
        try:
            anaRet=self.borg.boex(nick,create,preBorg=preBorg,forceEnv=forceEnv,debug=debug)
            newretC=0
            if anaRet['exitcode']:
                for i in anaRet['stderr']:
                    if isinstance(i,dict) and i.get('levelname') in ('ERROR','CRITICAL'):
                        newretC=2; break
            if 'stdout' in anaRet.keys() and len(anaRet['stdout']):
                out=dict(anaRet['stdout'][0])
                if newretC==0:
                    all_entries=_bkp_parse_list(anaRet.get('stderr',[]))
                    counts={}
                    for e in all_entries:
                        counts[e['change_type']]=counts.get(e['change_type'],0)+1
                    out['borgHelper_file_counts']=counts
                    if debug: out['borgHelper_files']=all_entries
                print(json.dumps(out,indent=4),file=sys.stdout,flush=True)
            if 'stderr' in anaRet.keys() and len(anaRet['stderr']):
                for i in anaRet['stderr']:
                    if _bkp_is_list_entry(i): continue
                    if isinstance(i,dict):
                        lvl=i.get('levelname','INFO'); msg=i.get('message',str(i))
                        print(f"[{lvl}] {msg}",file=sys.stderr,flush=True)
                        if debug: printer(i)
                    elif isinstance(i,str) and i.strip():
                        print(i,file=sys.stderr,flush=True)
            if newretC==0 and anaRet['stdout']:
                try:
                    arch_info=anaRet['stdout'][0].get('archive',{})
                    archive_new=arch_info.get('name')
                    archive_new_date=arch_info.get('start')
                    db_path=self.db.get_diff_db(nick)
                    self.db.ensure_diff_db(db_path)
                    if archive_new:
                        st=arch_info.get('stats',{})
                        self.db.store_archive_stats(nick,archive_new,archive_new_date,arch_info.get('duration'),
                            st.get('original_size'),st.get('compressed_size'),st.get('deduplicated_size'),st.get('nfiles'),db_path)
                    if not no_index and archive_new and archive_old:
                        all_bkp=_bkp_parse_list(anaRet['stderr'])
                        entries=[]; exclu={}
                        for e in all_bkp:
                            if self._idx_path_ok(e['path'],cfg):
                                entries.append(e)
                            else:
                                ct=e['change_type']
                                if ct not in exclu: exclu[ct]={'count':0,'size':0}
                                exclu[ct]['count']+=1
                        self.db.store_diff_entries(nick,archive_old,archive_new,archive_new_date,entries,db_path)
                        if exclu:
                            self.db.store_excluded_diff_stats(nick,archive_old,archive_new,exclu,db_path)
                        exclu_msg=f" ({sum(s['count'] for s in exclu.values())} exclus)" if exclu else ""
                        print(f"Index : {len(entries)} entrée(s) stockée(s) ({archive_old} → {archive_new}){exclu_msg}",file=sys.stderr,flush=True)
                    if not no_index: self.indexsnap(nick,debug=debug)
                except Exception as e:
                    printer(f"[WARN] indexation post-backup échouée : {e}")
            sys.exit(newretC)
        finally:
            self.db.clear_priority_lock(nick)

    def prune(self,nick,dryrun=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        cmd=['prune']
        for i in list(cfg.keys()):
            if 'KEEP_DAILY'==i: cmd.extend(['--keep-daily',cfg[i]])
            elif 'KEEP_WEEKLY'==i: cmd.extend(['--keep-weekly',cfg[i]])
            elif 'KEEP_MONTHLY'==i: cmd.extend(['--keep-monthly',cfg[i]])
            elif 'KEEP_YEARLY'==i: cmd.extend(['--keep-yearly',cfg[i]])
            elif 'KEEP_HOURLY'==i: cmd.extend(['--keep-hourly',cfg[i]])
        if len(cmd)>1:
            if dryrun: cmd.append('--dry-run')
            else: cmd.append('--stats')
            cmd.extend(f'--save-space --info --list --glob-archives={cfg["GLOB_ARCH"]}'.split(' '))
            ret=self.borg.boex(nick,cmd,debug=debug)['stderr']
            if not dryrun:
                rb=self.borg.boex(nick,['compact','--cleanup-commits'],debug=debug)
                self.db.clear_cache_nick(nick)
                self._cleanup_index_after_prune(nick,debug=debug)
                return rb
            else:
                return ret
        else:
            usage('prune')

    def indexsnap(self,nick,debug=0,db_path=None,force=False):
        if self._nick_noidx(nick):
            printer(f"{nick}: indexation désactivée (NOIDX=1)"); return 0
        if db_path is None: db_path=self.db.get_diff_db(nick)
        self.db.ensure_diff_db(db_path)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError as e:
            printer(f"{nick}: {e}"); return 1
        archives=rb['stdout'][0]['archives']
        if not archives:
            printer(f"{nick}: aucune archive"); return 0
        latest=archives[-1]
        archive_name=latest['name']; archive_date=latest['start']
        if self.db.is_archive_snapshot_indexed(nick,archive_name,db_path):
            if not force:
                print(f"{nick}: snapshot {archive_name} déjà indexé"); return 0
            try:
                conn=sqlite3.connect(db_path)
                conn.execute("DELETE FROM archive_snapshot WHERE nick=? AND archive=?",(nick,archive_name))
                conn.execute("DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive=?",(nick,archive_name))
                self.db._cleanup_snapshot_file_orphans(nick,conn)
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error (purge snapshot): {e}")
        print(f"  {nick}: snapshot {archive_name}...",flush=True)
        rb2=self.borg.boex(nick,['list','--format','{size} {isomtime} {path}{NL}',f"::{archive_name}"],debug=debug,retjson=False)
        if rb2['exitcode']!=0:
            printer(f"borg list a échoué (code {rb2['exitcode']})")
            for i in rb2['stderr']:
                if isinstance(i,dict): printer(f"  [{i.get('levelname','?')}] {i.get('message',i)}")
                elif isinstance(i,str) and i.strip(): printer(f"  {i}")
            return rb2['exitcode']
        files=[]; exclu_count=0; exclu_size=0
        for line in rb2['stdout']:
            line=line.strip()
            if not line: continue
            parts=line.split(' ',2)
            if len(parts)==3:
                try: size=int(parts[0])
                except ValueError: size=None
                path=parts[2]
                if self._idx_path_ok(path,cfg):
                    files.append({'path':path,'size':size,'mtime':parts[1]})
                else:
                    exclu_count+=1; exclu_size+=(size or 0)
        self.db.store_archive_snapshot(nick,archive_name,archive_date,files,db_path)
        if exclu_count:
            self.db.store_excluded_snap_stats(nick,archive_name,exclu_count,exclu_size,db_path)
            print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name} ({exclu_count} exclus, {convert_octets_readable(exclu_size)})")
        else:
            print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name}")
        return 0

    def index(self,nick,debug=0,db_path=None,force=False):
        if self._nick_noidx(nick):
            printer(f"{nick}: indexation désactivée (NOIDX=1)"); return 0
        if db_path is None: db_path=self.db.get_diff_db(nick)
        self.db.ensure_diff_db(db_path)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError as e:
            printer(f"{nick}: {e}"); return 1
        archives=rb['stdout'][0]['archives']
        if len(archives)<2:
            printer(f"{nick}: moins de 2 archives, rien à indexer"); return 0
        # Phase 1 : paires à indexer + purge groupée si force
        pairs_todo=[]; skipped=0; pairs_to_purge=[]
        for i in range(len(archives)-1):
            a_old=archives[i]['name']; a_new=archives[i+1]['name']; date_new=archives[i+1]['start']
            already=self.db.is_diff_pair_indexed(nick,a_old,a_new,db_path)
            if already and not force: skipped+=1; continue
            if already and force: pairs_to_purge.append((a_old,a_new))
            pairs_todo.append((a_old,a_new,date_new))
        if pairs_to_purge:
            try:
                conn=sqlite3.connect(db_path)
                for a_old,a_new in pairs_to_purge:
                    conn.execute("DELETE FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    conn.execute("DELETE FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error (purge): {e}")
        # Phase 2 : borg diff en parallèle
        workers=max(1,int(cfg.get('IDX_WORKERS','4')))
        def _run_diff(pair):
            a_old,a_new,date_new=pair
            print(f"  {nick}: {a_old} → {a_new}",flush=True)
            rb2=self.borg.boex(nick,['diff',f"{cfg['BORG_REPO']}::{a_old}",a_new],debug=debug,retjson=False)
            entries=[]; exclu={}  # exclu accumule en RAM jusqu'à fin du diff
            for line in rb2['stdout']:
                p=parse_diff_line(line)
                if not p or not p['path']: continue
                if self._idx_path_ok(p['path'],cfg):
                    entries.append(p)
                else:
                    ct=p['change_type']
                    sz=p.get('size_after') or p.get('size_before') or 0
                    if ct not in exclu: exclu[ct]={'count':0,'size':0}
                    exclu[ct]['count']+=1; exclu[ct]['size']+=sz
            return (a_old,a_new,date_new,entries,exclu)
        interrupted=False
        results=[]
        if pairs_todo:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs={ex.submit(_run_diff,p):p for p in pairs_todo}
                for fut in as_completed(futs):
                    if not interrupted and self.db.check_priority_lock(nick):
                        printer(f"  {nick}: opération prioritaire (Bkp/Restore) détectée — indexation interrompue")
                        for f in futs:
                            if not f.done(): f.cancel()
                        interrupted=True
                    try: results.append(fut.result())
                    except CancelledError: pass
                    except Exception as e: printer(f"[WARN] borg diff échoué : {e}")
        if interrupted:
            remaining=len(pairs_todo)-len(results)
            if remaining: printer(f"  {nick}: {remaining} paire(s) non indexée(s) — reprendre avec : borgHelper -c Index -n {nick}")
        # Phase 3 : insert groupé
        if results:
            try:
                conn=sqlite3.connect(db_path)
                for a_old,a_new,date_new,entries,exclu in results:
                    if entries:
                        conn.executemany("INSERT INTO diff_index (nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES (?,?,?,?,?,?,?,?)",
                            [(nick,a_old,a_new,date_new,e['change_type'],e['path'],e.get('size_before'),e.get('size_after')) for e in entries])
                    conn.execute("INSERT OR IGNORE INTO diff_indexed_pairs (nick,archive_old,archive_new,entry_count) VALUES (?,?,?,?)",(nick,a_old,a_new,len(entries)))
                    if exclu:
                        conn.executemany(
                            "INSERT OR REPLACE INTO diff_excluded_stats "
                            "(nick,archive_old,archive_new,change_type,file_count,total_size) VALUES (?,?,?,?,?,?)",
                            [(nick,a_old,a_new,ct,s['count'],s['size']) for ct,s in exclu.items()])
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error (insert): {e}")
        new_pairs=len(results)
        print(f"{nick}: {new_pairs} paires indexées (+{skipped} déjà en cache)")
        diff_keep=cfg.get('DIFF_KEEP','')
        if diff_keep.strip().isdigit():
            self.db._diff_keep_purge(nick,int(diff_keep),db_path)
        # archive_stats : seulement si archives manquantes
        archive_names=set(a['name'] for a in archives)
        try:
            conn=sqlite3.connect(db_path)
            existing=set(r[0] for r in conn.execute("SELECT archive FROM archive_stats WHERE nick=?",(nick,)).fetchall())
            conn.close()
        except sqlite3.Error: existing=set()
        missing=archive_names-existing
        if missing or force:
            rbi=self.borg.boex(nick,['info','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
            try:
                self.borg._boex_check_stdout(rbi,nick,'borg info')
                for a in rbi['stdout'][0]['archives']:
                    if force or a['name'] in missing:
                        st=a.get('stats',{})
                        self.db.store_archive_stats(nick,a['name'],a.get('start'),a.get('duration'),
                            st.get('original_size'),st.get('compressed_size'),st.get('deduplicated_size'),st.get('nfiles'),db_path)
            except (RuntimeError,KeyError,TypeError): pass
        self.indexsnap(nick,debug=debug,db_path=db_path,force=force)
        return 0

    def search(self,nick,pattern,archive_from=None,archive_to=None,debug=0):
        sql_pat=pattern.replace('*','%').replace('?','_')
        if '%' not in sql_pat and '_' not in sql_pat: sql_pat='%'+sql_pat+'%'
        rows=[]
        for n in nick.split(','):
            db_path=self.db.get_diff_db(n)
            self.db.ensure_diff_db(db_path)
            if self.db._is_index_empty(n,db_path):
                printer(f"[ERREUR] Index vide pour {n} — lancez : borgHelper -c Index -n {n}"); continue
            try:
                conn=sqlite3.connect(db_path)
                af_sql,af_params=self.db._diff_archive_filter(n,archive_from,conn,archive_to)
                cur=conn.execute("SELECT nick,archive_new_date,archive_new,change_type,path,size_before,size_after FROM diff_index WHERE nick=? AND path LIKE ?"+af_sql+" ORDER BY archive_new_date,path",[n,sql_pat]+af_params)
                rows.extend(cur.fetchall())
                df,dt=_snap_params(af_params,archive_from,archive_to)
                snap_extra=[x for x in [df,dt] if x]
                cur=conn.execute("SELECT nick,archive_date,archive,'présent',path,NULL,size FROM archive_snapshot_v WHERE nick=? AND path LIKE ? "+_snap_notin(df,dt)+" ORDER BY archive,path",[n,sql_pat]+snap_extra)
                rows.extend(cur.fetchall()); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error ({n}): {e}")
        if not rows: print("Aucun résultat."); return
        from prettytable import PrettyTable
        t=PrettyTable(['nick','date','archive','type','chemin','avant','après'])
        t.align['chemin']='l'; t.align['archive']='l'
        for nick_r,date_r,arch_r,type_r,path_r,sb,sa in rows:
            t.add_row([nick_r,(date_r or '')[:19],arch_r,type_r,path_r,convert_octets_readable(sb) if sb else '',convert_octets_readable(sa) if sa else ''])
        print(t)

