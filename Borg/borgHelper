                try:
                    BorgHelperDB._executescript_atomic(c,"CREATE TABLE t_new(a); INSERT INTO t_new SELECT a FROM t;"
                                                         " DROP TABLE t; SELECT fonction_inexistante();")
                    return False
                except sqlite3.OperationalError: pass
                names={r[0] for r in c.execute("SELECT name FROM sqlite_master WHERE type='table'")}
                kept=names=={'t'} and c.execute("SELECT COUNT(*) FROM t").fetchone()[0]==2 and not c.in_transaction
                BorgHelperDB._executescript_atomic(c,"CREATE TABLE t_new(a); INSERT INTO t_new SELECT a FROM t;"
                                                     " DROP TABLE t; ALTER TABLE t_new RENAME TO t;")
                return kept and c.execute("SELECT COUNT(*) FROM t").fetchone()[0]==2
            finally:
