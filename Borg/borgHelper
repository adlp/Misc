    opts, args = getopt.getopt(sys.argv[1:],"c:hH:s:n:k:p:r:m:b:f:w:dvlC:", ["help"])
except getopt.GetoptError as err:
    print(err)  # will print something like "option -a not recognized"
    usage()
    sys.exit(2)

debug=0
cmd=None

optab={ 'stats'     :'Ccdn',      'login'     :'Ccdsnkprm',
        'mount'     :'Ccdnb',     'umount'    :'Ccdn',
        'lstbkp'    :'Ccdn',      'lstbkpfls' :'Ccdnb',
        'restore'   :'Ccdnbfw',   'diffbkp'   :'Ccdnbw',
        'delbkp'    :'Ccdnb',     'bkp'       :'Ccdn',
        'prune'     :'Ccdn',      'report'    :'Ccdnbl',
        'init'      :'Ccdn',
        'key'       :'Ccdn',      'index'     :'Ccdn',
        'search'    :'Ccdnf',     'filehist'  :'Ccdnf',
        'cacheinfo' :'Ccdn',      'cacheclean':'Ccdn',
        'indexsnap' :'Ccdn',}

for opt,arg in opts:
    if   opt in '-h':
        usage()
    elif opt in '-H':
        usage(arg.lower())
    elif opt in '-c':
        cmd=arg.lower()
    elif opt in '-d':
        debug+=1
    elif opt in '-v':
        version()
    elif opt in '-C':
        cfgfile=os.path.expanduser(arg)

init_db_paths()

if cmd is None or cmd not in optab.keys():
    usage()
# On part du principe que usage(xxx) quitte avec un exitcode

options={}
nick=socket.gethostname()

for opt,arg in opts:
    if opt[1] not in optab[cmd]:
        printer("step2"+opt[1])
        usage(cmd)
    else:
        options[opt]=arg
    if opt in '-n':
        nick=arg

if nick == "ALL":
    nick=cfgreadnicks(debug)

if debug != 0:
    printer(f'La commande fume {cmd}')


