# ── Crochet d'audit du selftest (1.0.161, story 24, A33) ──
# CodecSelfTest relève tout accès aux vrais dossiers de l'utilisateur (borg, rc, CACHE_DIR par défaut) : dans son propre
# processus et dans les borgHelper enfants, qui reçoivent le journal et les racines par l'environnement et posent le
# crochet dès le chargement du module (CLI comme import). sys.addaudithook ne se retire pas : posé une fois par
# processus, inactif quand _AUDIT['log'] est None. Limites : os.stat n'a pas d'évènement ; borg (binaire) n'est pas vu —
# il est isolé par le wrapper BORG_EXE et la garde _rbc.
_AUDIT={'log':None,'roots':(),'installed':False}
_AUDIT_TLS=threading.local()   # .off : accès voulu (garde _rb_home_leaks) ou écriture du journal en cours
_AUDIT_EVENTS=('open','os.mkdir','os.listdir','os.scandir','sqlite3.connect','os.remove','os.rename','os.rmdir',
               'shutil.rmtree','os.chmod','os.chown','os.utime','os.truncate','os.link','os.symlink')
_AUDIT_TWO=frozenset(('os.rename','os.link','os.symlink'))   # deux chemins (source, destination) ; les autres : le 1er seul
_AUDIT_MARK='.borghelper-selftest-temoin'   # chemin inexistant visé par les témoins : l'évènement part avant l'appel

def _audit_path(ev,a):
    """Chemin absolu d'un argument d'évènement, ou None (descripteur, :memory:, type inconnu). sqlite3.connect en URI
    (file:///chemin?mode=ro, lectures en lecture seule de borgHelper) : chemin extrait."""
    if a is None or isinstance(a,int): return None
    try: s=os.fsdecode(a)
    except (TypeError,ValueError): return None
    if ev=='sqlite3.connect':
        if s in ('',':memory:'): return None
        if s.startswith('file:'):
            import urllib.parse
            s=urllib.parse.unquote(s[5:].split('?',1)[0])
            if s.startswith('//'):   # file://[hôte]/chemin
                s=s[2:]; s='/'+s.split('/',1)[1] if '/' in s else ''
            if not s: return None
    return os.path.abspath(s)

def _audit_hook(ev,args):
    if ev not in _AUDIT_EVENTS: return
    log=_AUDIT['log']
    if not log or getattr(_AUDIT_TLS,'off',False): return
    for a in (args[:2] if ev in _AUDIT_TWO else args[:1]):
        try: pth=_audit_path(ev,a)
        except Exception: continue   # jamais d'exception hors du crochet : l'appel audité échouerait
        if pth is None: continue
        if not any(pth==r or pth.startswith(r+os.sep) for r in _AUDIT['roots']): continue
        _AUDIT_TLS.off=True
        try:
            where=[]; f=sys._getframe(1)
            while f is not None and len(where)<3:
                if f.f_code.co_filename==__file__: where.append(f"{f.f_code.co_name}:{f.f_lineno}")
                f=f.f_back
            with open(log,'a') as fh: fh.write(f"{os.getpid()}\t{ev}\t{pth}\t{' < '.join(where)}\n")
        except Exception: pass   # (écriture du journal, chemin non encodable…) jamais propagé à l'appel audité
        finally: _AUDIT_TLS.off=False
        return

def _audit_witness(tag):
    """Témoins du contrôle d'isolation : sous chaque racine, un appel voué à l'échec par évènement surveillé, sur
    <racine>/<_AUDIT_MARK>-<tag>/x (parent inexistant : l'évènement part avant l'appel, rien n'est créé, lu ni modifié)."""
    for r in _AUDIT['roots']:
        base=os.path.join(r,f"{_AUDIT_MARK}-{tag}"); x=os.path.join(base,'x')
        for fn in (lambda: open(x), lambda: os.mkdir(x), lambda: os.listdir(x), lambda: os.scandir(x),
                   lambda: sqlite3.connect(_audit_uri(x)+'?mode=ro',uri=True), lambda: os.remove(x), lambda: os.rename(x,x+'2'),
                   lambda: os.rmdir(x), lambda: shutil.rmtree(x), lambda: os.chmod(x,0o600), lambda: os.chown(x,-1,-1),
                   lambda: os.utime(x), lambda: os.truncate(x,0), lambda: os.link(x,x+'l'), lambda: os.symlink(x,x+'s')):
            try: fn()
            except Exception: pass

def _audit_uri(p):
    import pathlib
    return pathlib.PurePosixPath(p).as_uri()

def _audit_start(log,roots):
    """Active le crochet vers le journal `log` pour les racines `roots` (posé au premier appel seulement)."""
    _AUDIT.update(log=log,roots=tuple(roots))
    if not _AUDIT['installed']: sys.addaudithook(_audit_hook); _AUDIT['installed']=True

def _audit_roots():
    """Vrais dossiers de l'utilisateur à ne jamais toucher pendant le selftest : pour le dossier personnel pwd (celui
    d'un borg lancé par boex) et HOME, .config/borg, .cache/borg, .cache/borghelper (CACHE_DIR par défaut) et
    .borghelperrc — jamais lu ici (choix de l'utilisateur) : tout usage du CACHE_DIR du vrai rc passe par sa lecture,
    elle-même relevée ; XDG_CONFIG_HOME/borg,
    XDG_CACHE_HOME/borg ; dossiers borg de BORG_BASE_DIR et BORG_CACHE_DIR, BORG_CONFIG_DIR, BORG_SECURITY_DIR,
    BORG_KEYS_DIR de l'environnement. Racine trop large (moins de 2 niveaux, ex. « / ») : écartée."""
    import pwd
    env=os.environ; r=set()
    for h in {pwd.getpwuid(os.getuid()).pw_dir,env.get('HOME') or ''}-{''}:
        for s in (('.config','borg'),('.cache','borg'),('.cache','borghelper'),('.borghelperrc',)): r.add(os.path.join(h,*s))
    for k in ('XDG_CONFIG_HOME','XDG_CACHE_HOME'):
        if env.get(k): r.add(os.path.join(env[k],'borg'))
    if env.get('BORG_BASE_DIR'):
        r.update({os.path.join(env['BORG_BASE_DIR'],'.config','borg'),os.path.join(env['BORG_BASE_DIR'],'.cache','borg')})
    for k in ('BORG_CACHE_DIR','BORG_CONFIG_DIR','BORG_SECURITY_DIR','BORG_KEYS_DIR'):
        if env.get(k): r.add(env[k])
    out=set()
    for x in r:
        x=os.path.abspath(os.path.expanduser(x))
        for y in (os.path.normpath(x),os.path.realpath(x)):
            if len([c for c in y.split(os.sep) if c])>=2: out.add(y)
    return sorted(out)

if os.environ.get('BORGHELPERC_SELFTEST_AUDIT'):   # borgHelper enfant d'un CodecSelfTest : même journal, mêmes racines
    try: _roots=[x for x in json.loads(os.environ.get('BORGHELPERC_SELFTEST_AUDIT_ROOTS') or '[]') if isinstance(x,str) and x]
    except ValueError: _roots=[]
    _audit_start(os.environ['BORGHELPERC_SELFTEST_AUDIT'],_roots)
    if os.environ.get('BORGHELPERC_SELFTEST_AUDIT_WITNESS'):   # témoins du contrôle d'isolation (jeton du selftest)
        _audit_witness('enfant-'+os.environ['BORGHELPERC_SELFTEST_AUDIT_WITNESS'])

def mountedornot(mountpoint,debug=0):
    founded=False
    with open('/proc/mounts') as fd:
        while (line:=fd.readline()) and not founded:
            if mountpoint in line: founded=True
    return founded

def parse_borg_size(s):
    s=s.strip()
    for unit,mult in [('TB',10**12),('GB',10**9),('MB',10**6),('kB',10**3),('B',1)]:
        if s.endswith(unit):
            try: return int(float(s[:-len(unit)].strip())*mult)
            except (ValueError,TypeError): return None
    return None

def parse_diff_line(line):
    line=line.rstrip()
    if not line: return None
    m=re.match(r'^added\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'added','size_before':None,'size_after':parse_borg_size(m.group(1)),'path':m.group(2)}
    m=re.match(r'^removed\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'removed','size_before':parse_borg_size(m.group(1)),'size_after':None,'path':m.group(2)}
    m=re.match(r'^modified\s+\+([\d.]+\s+\w+)\s+-([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'modified','size_before':parse_borg_size(m.group(2)),'size_after':parse_borg_size(m.group(1)),'path':m.group(3)}
    m=re.match(r'^([A-Z])\s+(.+)$',line)
    if m: return {'change_type':m.group(1),'size_before':None,'size_after':None,'path':m.group(2)}
    return None

