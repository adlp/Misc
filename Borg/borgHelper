def _iso_now():
    """Heure locale ISO avec décalage (2026-09-28T10:00:00+02:00) : relue juste dans tout fuseau (UI)."""
    from datetime import datetime
    return datetime.now().astimezone().isoformat(timespec='seconds')

def printer(data,debug=0):
    if isinstance(data,str):
        with _PRINT_LOCK:
            _PRINT_TAIL.append(data)
            if len(_PRINT_TAIL)>200: del _PRINT_TAIL[:100]; _PRINT_DROPPED[0]+=100
    if isinstance(data,str) and ('[ERREUR]' in data or '[WARN]' in data):
        print(f"{data}  [borgHelper v{Version}]",file=sys.stderr)
    else:
        print(data,file=sys.stderr)

def _db_name_from_cfg(path):
    base=os.path.basename(os.path.abspath(path)).lstrip('.')
    return re.sub(r'[^a-zA-Z0-9_-]','_',base)

def getDataFromEnvOrFile(env=None,envpath=None,paths=None):
    if env:
        data=os.environ.get(env)
        if data: return data
    if envpath:
        fileName=os.environ.get(envpath)
        if fileName and os.path.isfile(fileName) and os.access(fileName,os.R_OK):
            with open(fileName,'r',encoding='utf-8') as f:
                return f.readline().strip()
    pathlst=[p.strip() for p in paths.split(',')]
    for path in pathlst:
        if os.path.isfile(path) and os.access(path,os.R_OK):
            with open(path,'r',encoding='utf-8') as f:
                return f.readline().strip()
    return None

def _fmt_dedup_delta(curr,prev):
    if prev is None or prev==0: return '—'
    pct=int(round((curr-prev)*100/prev))
    return f"+{pct}%" if pct>=0 else f"{pct}%"

def convert_octets_readable(size_in_bytes,sib=1000):
    suffixes=['B','KB','MB','GB','TB','PB','EB','ZB','YB']
    index=0
    while size_in_bytes>=sib and index<len(suffixes)-1:
        size_in_bytes/=sib; index+=1
    return f"{size_in_bytes:.2f} {suffixes[index]}"

def _dir_size(path):
    """Taille en octets des fichiers sous `path` (ou du fichier seul), liens non suivis ; 0 si absent ou illisible."""
    if not os.path.isdir(path) or os.path.islink(path):
        try: return os.lstat(path).st_size
        except OSError: return 0
    t=0
    for r,_ds,fs in os.walk(path):
        for f in fs:
            try: t+=os.lstat(os.path.join(r,f)).st_size
            except OSError: pass
    return t

def _local_state(path,timeout=2):
    """'absent' seulement si `path` n'existe certainement pas (FileNotFoundError / NotADirectoryError) ; accès refusé ou
    autre erreur : 'present' ; stat qui ne répond pas en `timeout` s (montage réseau bloqué : Status, Report et /access ne
    doivent jamais y rester pendus) : 'unknown' (1.0.161 : rien d'autre n'y est lu ensuite)."""
    res=[]
    def _st():
        try: os.stat(path); res.append('present')
        except (FileNotFoundError,NotADirectoryError): res.append('absent')
        except (OSError,ValueError): res.append('present')
    th=threading.Thread(target=_st,daemon=True); th.start(); th.join(timeout)
    return res[0] if res else 'unknown'

def _local_absent(path,timeout=2):
    """True seulement si `path` n'existe certainement pas ; présent, doute ou délai dépassé : False — jamais proposé au
    nettoyage sur un doute."""
    return _local_state(path,timeout)=='absent'

def _repo_current_id(path,timeout=2):
    """1.0.161 (story 24, A34) : identifiant du dépôt borg local `path` — `id` de la section [repository] de
    <path>/config (borg 1.2 : 64 hexadécimaux), lu sans borg. None sur tout doute : config absente ou illisible, sans
    id valide, ou lecture qui ne répond pas en `timeout` s (montage bloqué) — jamais un reste proposé sur un doute."""
    res=[]
    def _rd():
        cp=configparser.ConfigParser(interpolation=None)
        try:
            with open(os.path.join(path,'config')) as f: cp.read_file(f)
            v=cp['repository']['id'].strip().lower()
            res.append(v if re.match(r'^[0-9a-f]{64}$',v) else None)
        except (OSError,UnicodeDecodeError,configparser.Error,KeyError,ValueError): res.append(None)
    th=threading.Thread(target=_rd,daemon=True); th.start(); th.join(timeout)
    return res[0] if res else None

def _borg_leftovers(home,repos):
    """1.0.160 (story 23, A30) : entrées borg d'un dossier personnel `home` pour des dépôts LOCAUX disparus — lecture
    seule, jamais borg. Emplacement : fichier `location` de .config/borg/security/<id>, sinon `previous_location` du
    cache .cache/borg/<id>/config (cache sans entrée de sécurité). Signalé si c'est un chemin absolu absent et hors de
    `repos` (BORG_REPO locaux du rc, normalisés) ; distant (ssh://, user@host:) ou forme inconnue : jamais. Clés
    (.config/borg/keys, 1re ligne 'BORG_KEY <id>') rattachées par id, à part : irréversibles. Entrée illisible : ignorée.
    1.0.161 (story 24, A34) : emplacement local PRÉSENT (du rc ou non) dont le dépôt porte un autre identifiant
    (_repo_current_id) = ancien dépôt recréé au même chemin, signalé aussi (`recreated`) ; même id ou id illisible : jamais.
    1.0.161 : `plain` = dépôt non chiffré (key-type 2 none, 6/7 authenticated, dans security/<id>/key-type) — sans son
    entrée de sécurité, borg sans terminal refuse ce dépôt s'il existe encore (mesuré, borg 1.2.6 : « Aborting », code 2) ;
    son cache seul peut partir sans effet (mesuré : code 0).
    Rend [{'id','location','paths','anchor','size','keys','key_size','recreated','current_id','plain'}]."""
    sec=os.path.join(home,'.config','borg','security'); cache=os.path.join(home,'.cache','borg')
    keysd=os.path.join(home,'.config','borg','keys'); idre=re.compile(r'^[0-9a-f]{64}$')
    def _ls(d):
        try: return sorted(os.listdir(d))
        except OSError: return []
    locs={}
    for i in _ls(sec):
        if not idre.match(i): continue
        try:
            with open(os.path.join(sec,i,'location')) as f: locs[i]=f.read().strip()
        except (OSError,UnicodeDecodeError): continue
    for i in _ls(cache):
        if not idre.match(i) or i in locs or os.path.isdir(os.path.join(sec,i)): continue
        cp=configparser.ConfigParser(interpolation=None)
        try:
            cp.read(os.path.join(cache,i,'config')); locs[i]=cp['cache']['previous_location'].strip()
        except (configparser.Error,KeyError,OSError,UnicodeDecodeError): continue
    keyof={}
    for k in _ls(keysd):
        kp=os.path.join(keysd,k)
        try:
            with open(kp) as f: first=f.readline().split()
        except (OSError,UnicodeDecodeError): continue
        if len(first)==2 and first[0]=='BORG_KEY' and idre.match(first[1]): keyof.setdefault(first[1],[]).append(kp)
    out=[]
    for i,loc in sorted(locs.items()):
        if not loc.startswith('/'): continue
        cur=None; st=_local_state(loc)
        if st=='unknown': continue   # montage qui ne répond pas : gardé, rien d'autre lu
        if st=='absent':
            if os.path.normpath(loc) in repos or os.path.realpath(loc) in repos: continue   # disque du rc démonté : gardé
        else:
            cur=_repo_current_id(loc)
            if cur is None or cur==i: continue   # dépôt courant, ou doute (config illisible, délai) : gardé
        sp=os.path.join(sec,i) if os.path.lexists(os.path.join(sec,i)) else None
        cp=os.path.join(cache,i) if os.path.lexists(os.path.join(cache,i)) else None
        paths=[x for x in (sp,cp) if x]
        ks=keyof.get(i,[]); kt=''
        if sp:
            try:
                with open(os.path.join(sp,'key-type')) as f: kt=f.read().strip()
            except (OSError,UnicodeDecodeError): kt=''
        # anchor : ce qui porte l'emplacement (sécurité, sinon cache) — gardé tant que la clé l'est, sinon la clé
        # deviendrait introuvable (plus rien ne dirait à quel dépôt elle appartient)
        out.append({'id':i,'location':loc,'paths':paths,'anchor':sp or cp,'size':sum(_dir_size(x) for x in paths),
                    'keys':ks,'key_size':sum(_dir_size(x) for x in ks),'recreated':cur is not None,'current_id':cur,
                    'plain':kt in ('2','6','7')})
    return out

