def _diff_stats_for_nick(nick):
    """Counts and sizes per archive_new from diff_index."""
    try:
        db_path=get_diff_db(nick)
        conn=sqlite3.connect(db_path)
        rows=conn.execute(
            "SELECT archive_new,change_type,COUNT(*),SUM(size_after),SUM(size_before) "
            "FROM diff_index WHERE nick=? GROUP BY archive_new,change_type",(nick,)).fetchall()
        conn.close()
        stats={}
        for arch,ctype,cnt,sz_after,sz_before in rows:
            if arch not in stats:
                stats[arch]={'added':0,'removed':0,'modified':0,
                             'added_sz':0,'removed_sz':0,'modified_sz':0}
            if ctype=='added':
                stats[arch]['added']+=cnt
                stats[arch]['added_sz']+=(sz_after or 0)
            elif ctype=='removed':
                stats[arch]['removed']+=cnt
                stats[arch]['removed_sz']+=(sz_before or 0)
            else:
                stats[arch]['modified']+=cnt
                stats[arch]['modified_sz']+=(sz_after or 0)
        return stats
    except Exception:
        return {}

