            return leading+'/'.join(parts[:d])
        stats=defaultdict(lambda:{'total':0,'added_n':0,'added_s':0,'removed_n':0,'removed_s':0,'modified_n':0,'size':0})
        total_count=0; total_size=0; total_added=0; total_modified=0
        conn=None
        try:
            conn=_open_db(db_path,nick=nick,role='read',timeout=60)
            cur=conn.execute(
                "SELECT path,change_type,size_before,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",
                (nick,arch_old,arch_new))
            while True:
                rows=cur.fetchmany(50000)
                if not rows: break
                for path,ct,sb,sa in rows:
                    pfx=get_prefix(_path_decode(conn,path),depth)
                    s=stats[pfx]
                    s['total']+=1
                    sz=(sa or sb or 0)
                    s['size']+=sz
                    if ct in _DIFF_ADDED_TYPES:     s['added_n']+=1;   s['added_s']+=(sa or 0); total_added+=1
                    elif ct in _DIFF_REMOVED_TYPES: s['removed_n']+=1; s['removed_s']+=(sb or 0)
                    else:              s['modified_n']+=1; total_modified+=1
                    total_count+=1; total_size+=sz
            conn.close()
        except DbCodecError as e:
            _codec_fail(nick,e,conn); return
        except sqlite3.Error as e:
            _close_quiet(conn)
            printer(f"  SQLite error ({db_path}): {e}"); return
        if not total_count:
            printer(f"  {nick}: aucune entrée pour cette paire ({arch_old} → {arch_new})"); return
        conn3=None
        try:
            conn3=_open_db(db_path,nick=nick,role='read',timeout=60)
            exclu_rows3=conn3.execute("SELECT change_type,SUM(file_count),SUM(total_size) FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=? GROUP BY change_type",(nick,arch_old,arch_new)).fetchall()
            nfiles_row=conn3.execute("SELECT nfiles FROM archive_stats WHERE nick=? AND archive=?",(nick,arch_new)).fetchone()
            conn3.close()
            exclu_by_ct3={r[0]:(r[1] or 0,r[2] or 0) for r in exclu_rows3}
            exclu_n=sum(v[0] for v in exclu_by_ct3.values()); exclu_sz=sum(v[1] for v in exclu_by_ct3.values())
            nfiles_new=nfiles_row[0] if nfiles_row and nfiles_row[0] else None
        except sqlite3.Error:
            _close_quiet(conn3); exclu_by_ct3={}; exclu_n=0; exclu_sz=0; nfiles_new=None
        top=sorted(stats.items(),key=lambda x:x[1]['total'],reverse=True)[:topn]
        from prettytable import PrettyTable
        t=PrettyTable()
        t.field_names=['arborescence','total','+nb','+taille','-nb','-taille','=nb','taille']
        for f in t.field_names: t.align[f]='r'
        t.align['arborescence']='l'
        for pfx,s in top:
            pct=f"{100*s['total']//total_count}%"
            t.add_row([
                pfx,
                f"{s['total']:,} ({pct})",
                f"{s['added_n']:,}" if s['added_n'] else '—',
                convert_octets_readable(s['added_s']) if s['added_s'] else '—',
                f"{s['removed_n']:,}" if s['removed_n'] else '—',
                convert_octets_readable(s['removed_s']) if s['removed_s'] else '—',
                f"{s['modified_n']:,}" if s['modified_n'] else '—',
                convert_octets_readable(s['size']),
            ])
        printer(f"\n{nick} — top {topn} par changements (profondeur {depth})")
        printer(f"  {arch_old}")
        printer(f"→ {arch_new}")
        added_total=total_added+exclu_by_ct3.get('added',(0,0))[0]
        modified_total=total_modified+exclu_by_ct3.get('modified',(0,0))[0]
        unchanged=max(0,nfiles_new-added_total-modified_total) if nfiles_new is not None else None
        printer(f"Indexés : {total_count:,} changements · {convert_octets_readable(total_size)}")
        if exclu_n:
            exclu_detail3=' · '.join(f"{s}{exclu_by_ct3[ct][0]:,}" for ct,s in [('added','+'),('removed','-'),('modified','=')] if ct in exclu_by_ct3)
            printer(f"Exclus  : {exclu_n:,} entrées · {convert_octets_readable(exclu_sz)} (IDX_EXCLUDE) — {exclu_detail3}")
        if unchanged is not None:
            pct_unch=f" ({100*unchanged//nfiles_new}%)" if nfiles_new>0 else ""
            printer(f"Inchangés: {unchanged:,}{pct_unch} sur {nfiles_new:,} fichiers dans {arch_new}")
        printer(str(t))

    def _snapurge_check(self,nick,conn,keep):
        archives=sorted([r[0] for r in conn.execute(
            "SELECT archive FROM archive_snapshot_indexed WHERE nick=?",(nick,))])
        total=len(archives)
        if total<=keep: return [],0
        to_delete=archives[:total-keep]
        ph=','.join('?'*len(to_delete))
        count=conn.execute(
            f"SELECT COUNT(*) FROM archive_snapshot WHERE nick=? AND archive IN ({ph})",
            [nick]+to_delete).fetchone()[0]
        return to_delete,count

    def _snapurge_exec(self,nick,conn,to_delete):
        ph=','.join('?'*len(to_delete))
        conn.execute(f"DELETE FROM archive_snapshot WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        conn.execute(f"DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        conn.execute(f"DELETE FROM snap_excluded_stats WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        self.db._cleanup_snapshot_file_orphans(nick,conn)

    def idxpurge(self,nick,pattern=None,dryrun=False,debug=0):
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent"); return
        cfg=self.borg.cfgread(nick)
        keep_snap=int(cfg.get('IDX_SNAP_KEEP',
            sum(int(cfg.get(k,0)) for k in ['KEEP_DAILY','KEEP_WEEKLY','KEEP_MONTHLY','KEEP_YEARLY','KEEP_HOURLY'])
            or 10))
        includes=excludes=[]
        if pattern is None:
            includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
            excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
            if includes: printer(f"  {nick}: IDX_INCLUDE : {' '.join(includes)}")
            if excludes: printer(f"  {nick}: IDX_EXCLUDE : {' '.join(excludes)}")
        def _is_glob(pat): return any(c in pat for c in '*?[')
        _norm=_norm_lp
        def _pat_cond(conn,patterns):
            # plain : GLOB en SQL ; sinon le motif est un préfixe (égalité + intervalle, jamais LIKE).
            # Un préfixe vide ne cible rien (jamais toute la base).
            parts=[]; args=[]
            for pat in patterns:
                if pat.startswith('/'):
                    parts.append("0")  # les chemins stockés n'ont jamais de '/' initial : ne cible rien (comportement historique)
                elif _is_glob(pat):
                    g,ga,_=_psel_glob(conn,pat); parts.append(g); args.extend(ga)
                elif not pat.rstrip('/'):
                    parts.append("0")
                else:
                    u,ua,_=_psel_under(conn,pat.rstrip('/'),self_too=True); parts.append(u); args.extend(ua)
            return ' OR '.join(parts),args
        def _py_match(patterns):
            # chiffré : mêmes correspondances que _pat_cond, évaluées sur le chemin logique décodé
            patterns=[pat for pat in patterns if not pat.startswith('/')]  # '/' initial : ne cible rien
            rxs=[_glob_regex(pat) for pat in patterns if _is_glob(pat)]
            bases=[b for b in (_norm(pat) for pat in patterns if not _is_glob(pat)) if b]
            return lambda p: any(r.fullmatch(p) for r in rxs) or any(p==b or p.startswith(b+'/') for b in bases)
        def _narrow(conn,patterns):
            # chiffré : sur-ensemble de lignes candidates par intervalles (SQL) ; None = tout lire
            parts=[]; args=[]
            for pat in patterns:
                if pat.startswith('/'): continue
                if _is_glob(pat):
                    head=pat[:min(k for k,c in enumerate(pat) if c in '*?[')]
                    d=_norm(head.rsplit('/',1)[0]) if '/' in head else ''
                    if not d: return None
                    u,ua,_=_psel_under(conn,d)
                else:
                    b=_norm(pat)
                    if not b: continue
                    u,ua,_=_psel_under(conn,b,self_too=True)
                parts.append(u); args.extend(ua)
            return (' OR '.join(parts),args) if parts else ('0',[])
        try:
            conn=_open_db(db_path,nick=nick,role='write',timeout=60)
            count=0; size=0
            sql_where=None; params=None      # plain : condition SQL
            ids=None                          # chiffré : id des lignes à supprimer, choisies en Python
            has_cond=pattern is not None or bool(includes) or bool(excludes)
            if has_cond and conn.codec is None:
                if pattern is not None:
                    c_sql,c_args=_pat_cond(conn,[pattern])
                    sql_where=f"nick=? AND ({c_sql})"; params=tuple([nick]+c_args)
                elif includes and excludes:
                    inc_sql,inc_args=_pat_cond(conn,includes)
                    exc_sql,exc_args=_pat_cond(conn,excludes)
                    sql_where=f"nick=? AND (NOT ({inc_sql}) OR ({exc_sql}))"
                    params=tuple([nick]+inc_args+exc_args)
                elif includes:
                    inc_sql,inc_args=_pat_cond(conn,includes)
                    sql_where=f"nick=? AND NOT ({inc_sql})"
                    params=tuple([nick]+inc_args)
                else:
                    exc_sql,exc_args=_pat_cond(conn,excludes)
                    sql_where=f"nick=? AND ({exc_sql})"
                    params=tuple([nick]+exc_args)
            elif has_cond:
                if pattern is not None: pred=_py_match([pattern]); nar=_narrow(conn,[pattern])
                elif includes and excludes:
                    inc,exc=_py_match(includes),_py_match(excludes)
                    pred=lambda p: (not inc(p)) or exc(p); nar=None
                elif includes:
                    inc=_py_match(includes); pred=lambda p: not inc(p); nar=None
                else: pred=_py_match(excludes); nar=_narrow(conn,excludes)
                q="SELECT id,path,COALESCE(size_after,size_before,0) FROM diff_index WHERE nick=?"; qa=[nick]
                if nar is not None: q+=" AND ("+nar[0]+")"; qa+=nar[1]
                ids=[]
                for rid,sp,sz in conn.execute(q,qa):
                    if pred(_path_decode(conn,sp)): ids.append(rid); size+=sz or 0
                count=len(ids)
            if sql_where:
                row=conn.execute(
                    f"SELECT COUNT(*),SUM(COALESCE(size_after,size_before,0)) FROM diff_index WHERE {sql_where}",
                    params).fetchone()
                count,size=row[0],row[1] or 0
            snap_del,snap_count=self._snapurge_check(nick,conn,keep_snap)
            if not count and not snap_del:
                if not has_cond and pattern is None:
                    printer(f"  {nick}: aucun IDX_INCLUDE/IDX_EXCLUDE dans la config")
                else:
                    printer(f"  {nick}: aucune entrée à purger")
                conn.close(); return
            if count:
                label=f" — '{pattern}'" if pattern is not None else ""
                printer(f"  {nick}: {count:,} entrées diff · {convert_octets_readable(size)}{label}")
            if snap_del:
                printer(f"  {nick}: {len(snap_del)} snapshot(s) ancien(s) à purger ({snap_count:,} entrées) — keep={keep_snap}")
            if dryrun:
                printer(f"  {nick}: dry-run — aucune modification")
                conn.close(); return
            if count:
                if ids is not None: conn.executemany("DELETE FROM diff_index WHERE id=?",[(rid,) for rid in ids])  # chiffré : suppression par id
                else: conn.execute(f"DELETE FROM diff_index WHERE {sql_where}",params)
                conn.execute("""UPDATE diff_indexed_pairs SET entry_count=(
                    SELECT COUNT(*) FROM diff_index di
                    WHERE di.nick=diff_indexed_pairs.nick
                    AND di.archive_old=diff_indexed_pairs.archive_old
                    AND di.archive_new=diff_indexed_pairs.archive_new)
                    WHERE nick=?""",(nick,))
            if snap_del:
                self._snapurge_exec(nick,conn,snap_del)
            conn.commit(); conn.close()
            if count: printer(f"  {nick}: {count:,} entrées diff supprimées")
            if snap_del: printer(f"  {nick}: {snap_count:,} entrées snapshot supprimées ({len(snap_del)} archives)")
            self._vacuum_db(db_path,verbose=True,nick=nick)
        except DbCodecError as e:
            _codec_fail(nick,e,conn); return
        except sqlite3.Error as e:
            printer(f"  SQLite error ({db_path}): {e}")
            try: conn.close()
            except: pass

    def prep_report_from_db(self,nick,maxp=None):
        """Comme prep_report() mais lit uniquement l'index SQLite — utilisé quand le dépôt est occupé."""
        db_path=self.db.get_diff_db(nick)
        if not _db_has_schema(db_path):  # jamais indexé (AD-12) : _open_db peut avoir touché un fichier
                                          # 0 octet sans schéma (autre commande de lecture) — pas une base
            return {nick:{'nom':nick,'_msg':f"diff.db absent — lancez : borgHelper -c Index -n {nick}"}},{}
        self.db.ensure_diff_db(db_path,create=False)
        conn=_open_db(db_path,nick=nick,role='read')
        try:
            rows=conn.execute("SELECT archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles FROM archive_stats WHERE nick=? ORDER BY archive_date",(nick,)).fetchall()
        except sqlite3.OperationalError as e:
            if 'no such table' not in str(e): raise Exception(f"SQLite error ({db_path}): {e}")
            rows=[]  # base présente mais jamais indexée (create=False)
        except sqlite3.Error as e:
            raise Exception(f"SQLite error ({db_path}): {e}")
        finally:
            conn.close()
        if not rows:
            return {nick:{'nom':nick,'_msg':f"Aucune archive indexée — lancez : borgHelper -c Index -n {nick}"}},{}
        diff_stats=self.db._diff_stats_for_nick(nick)
        def _fmt_stats(s,nf,total_sz=0,summary=False):
            na,nr,nm=s['added'],s['removed'],s['modified']
            prev_nf=nf-na+nr
            pn_modif=f"{100*(nm+nr)//prev_nf}%nb" if prev_nf>0 else "—"
            total_changed_sz=s['added_sz']+s['modified_sz']+s['removed_sz']
            ps_modif=convert_octets_readable(total_changed_sz) if total_changed_sz>0 else "—"
            return {'modifications':f"{pn_modif} / {ps_modif}"}
        kept={}
        for archive,arch_date,duration,orig,compr,dedup,nfiles in rows:
            kept[archive]={'name':archive,'durationM':(duration or 0)/60,
                'original_size':orig or 0,'compressed_size':compr or 0,
                'deduplicated_size':dedup or 0,'nfiles':nfiles or 0,
                'archive_date':arch_date,'prunMe':'No'}
        c=len(kept)
        last_arch=rows[-1][0]; last_date=rows[-1][1]
        dabesi=d2DateNSince(last_date) if last_date else {'date':'—','since':0.0}
        total_dedup=sum(v['deduplicated_size'] for v in kept.values())
        last_k=kept[last_arch]
        tcmpl={}
        repo_st=self.db.get_repo_stats(nick)
        tcmpl[nick]={'nom':nick,'date derniere':dabesi['date'],'depuis':dabesi['since'],
            'duree':last_k['durationM'],'derniere':last_k['deduplicated_size'],
            'taille':repo_st.get('unique_csize'),'recuperable':None,'reste':self.borg.dfRepo(nick)}
        s_last=diff_stats.get(last_arch)
        if s_last:
            for k,v in _fmt_stats(s_last,last_k['nfiles'],last_k['original_size'],summary=True).items(): tcmpl[nick][k]=v
        else:
            tcmpl[nick]['modifications']='—'
        all_arches=list(kept.keys())
        size_delta_map={arch:_fmt_dedup_delta(kept[arch]['original_size'],
            kept[all_arches[idx-1]]['original_size'] if idx>0 else None)
            for idx,arch in enumerate(all_arches)}
        tcmpl[nick]['size_delta_last']=size_delta_map.get(last_arch,'—')
        tbkps={'Prunable':{'name':'Prunable','original_size':0,'compressed_size':0,'deduplicated_size':0}}
        display_keys=all_arches
        if maxp is not None: display_keys=display_keys[-maxp:]
        for arch in display_keys:
            k=kept[arch]
            tbkps[arch]={'name':arch,'duration':k['durationM'],
                'original_size':k['original_size'],'compressed_size':k['compressed_size'],
                'deduplicated_size':k['deduplicated_size'],'size_delta':size_delta_map[arch],'nfiles':k['nfiles']}
            s=diff_stats.get(arch)
            if s:
                for kk,vv in _fmt_stats(s,k['nfiles'],k['original_size']).items(): tbkps[arch][kk]=vv
            else:
                tbkps[arch]['modifications']='—'
        total_orig=sum(v['original_size'] for v in kept.values())
        total_compr=sum(v['compressed_size'] for v in kept.values())
        total_dedup2=sum(v['deduplicated_size'] for v in kept.values())
        tbkps['Totaux']={'name':'Totaux','original_size':total_orig,'compressed_size':total_compr,'deduplicated_size':total_dedup2}
        return tcmpl,tbkps

