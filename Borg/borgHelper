    def restore(self,nick,bid,ftor,where,flat=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        stdout_mode=(where=='-')
        out=sys.stderr if stdout_mode else sys.stdout
        if bid is None:
            bid=self._find_last_archive_with_file(nick,ftor,debug=debug)
            if bid: print(f"Archive sélectionnée depuis l'index : {bid}",file=out,flush=True)
            else:
                bid=self.borg.getlastbkp(nick,debug=debug)[0]
                print(f"Archive sélectionnée (dernière) : {bid}",file=out,flush=True)
        self.db.set_priority_lock(nick)
        self.db.wait_index_idle(nick)
        try:
            if stdout_mode or _is_tar_dest(where):
                self._restore_to_tar(nick,bid,ftor,where,flat=flat,debug=debug)
            elif flat:
                import tempfile,shutil
                with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
                    rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
                    _print_boex_stderr(rb)
                    if rb['exitcode'] not in (0,1): sys.exit(rb['exitcode'])
                    os.makedirs(where,exist_ok=True)
                    try:
                        for root,_,files in os.walk(tmpdir):
                            for f in files: shutil.copy2(os.path.join(root,f),os.path.join(where,f))
                    except OSError as e:
                        import errno as _errno
                        if e.errno==_errno.ENOSPC: printer(f"[ERREUR] Espace disque insuffisant : {e.filename or where}")
                        else: printer(f"[ERREUR] Copie impossible : {e}")
                        sys.exit(3)
                    print(f"Restauré (plat) dans {where}",flush=True)
                sys.exit(rb['exitcode'])
            else:
                rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=where,debug=debug)
                _print_boex_stderr(rb); sys.exit(rb['exitcode'])
        finally:
            self.db.clear_priority_lock(nick)

    def _restore_to_tar(self,nick,bid,ftor,tarpath,flat=False,debug=0):
        import tempfile,tarfile as tf_mod
        stdout_mode=(tarpath=='-')
        with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
            rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
            _print_boex_stderr(rb)
            if rb['exitcode'] not in (0,1): sys.exit(rb['exitcode'])
            if stdout_mode:
                mode='w|'
            else:
                is_gz=tarpath.endswith('.tgz') or tarpath.endswith('.tar.gz')
                exists=os.path.exists(tarpath)
                if is_gz:
                    if exists:
                        print(f"[ERREUR] {tarpath} existe déjà — impossible d'ajouter à un fichier gzip.",file=sys.stderr)
                        print(f"  Supprimez-le manuellement ou choisissez un autre nom.",file=sys.stderr)
                        sys.exit(3)
                    mode='w:gz'
                else:
                    mode='a' if exists else 'w'
            try:
                fobj=sys.stdout.buffer if stdout_mode else None
                with (tf_mod.open(fileobj=fobj,mode=mode) if stdout_mode else tf_mod.open(tarpath,mode)) as tf:
                    for root,dirs,files in os.walk(tmpdir):
                        if not flat:
                            for d in dirs:
                                dp=os.path.join(root,d)
                                tf.add(dp,arcname=os.path.relpath(dp,tmpdir),recursive=False)
                        for f in files:
                            fp=os.path.join(root,f)
                            arcname=(os.path.basename(fp) if flat else os.path.relpath(fp,tmpdir))
                            tf.add(fp,arcname=arcname)
            except BrokenPipeError:
                sys.exit(0)
            except OSError as e:
                import errno as _errno
                if e.errno==_errno.ENOSPC: print(f"[ERREUR] Espace disque insuffisant : {e.filename or tarpath}",file=sys.stderr)
                else: print(f"[ERREUR] Écriture impossible : {e}",file=sys.stderr)
                sys.exit(3)
            if not stdout_mode: print(f"Restauré {'(plat) ' if flat else ''}dans {tarpath}",flush=True)
        sys.exit(rb['exitcode'])

    def delbkp(self,nick,bid,debug=0):
        rb=self.borg.boex(nick,['delete','::'+bid],debug=debug)
        if rb['exitcode']!=0: print(rb); sys.exit(rb['exitcode'])
        self.borg.boex(nick,['compact','--cleanup-commits'],debug=debug)
        self.db.clear_cache_nick(nick); sys.exit(rb['exitcode'])

    def init_repo(self,nick,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        ret=self.borg.boex(nick,"init --encryption repokey".split(' '),debug=debug)
        print(ret)

    def _pair_file_counts(self,nick,archive_old,archive_new,db_path,with_files=False):
        """Comptages par type de changement (added/modified/removed/C/B/T) de la paire
        archive_old -> archive_new, depuis diff_index (+ diff_excluded_stats : fichiers exclus de
        l'indexation, comptés comme dans Report). None si la paire n'est pas (encore) indexée — ex.
        Index post-Bkp interrompu. with_files : liste {change_type,path} (chemins décodés, mode -d)."""
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            try:
                if not conn.execute("SELECT 1 FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",
                                    (nick,archive_old,archive_new)).fetchone():
                    return None
                counts={}
                for ct,n in conn.execute("SELECT change_type,COUNT(*) FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=? GROUP BY change_type",
                                         (nick,archive_old,archive_new)):
                    counts[ct]=counts.get(ct,0)+n
                for ct,n in conn.execute("SELECT change_type,SUM(file_count) FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=? GROUP BY change_type",
                                         (nick,archive_old,archive_new)):
                    counts[ct]=counts.get(ct,0)+(n or 0)
                files=[{'change_type':ct,'path':_path_decode(conn,p)} for p,ct in conn.execute(
                    "SELECT path,change_type FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=? ORDER BY id",
                    (nick,archive_old,archive_new))] if with_files else None
                return counts,files
            finally: conn.close()
        except (sqlite3.Error,DbCodecError) as e:
            printer(f"  [WARN] {nick}: comptage des fichiers de la paire impossible : {e}"); return None

    def backup(self,nick,no_index=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        if not no_index and self._nick_noidx(nick): no_index=True
        if 'SSH_REPO' in cfg.keys():
            forceEnv={'BORG_REPO':cfg['SSH_REPO']}
        else:
            forceEnv=None
        preBorg=['ssh','-o','SendEnv BORG_*']
        if 'SSH_REMFO' in cfg.keys():
            preBorg.append('-R'); preBorg.append(cfg['SSH_REMFO'])
        preBorg.extend(f'-A -o VisualHostKey=no -o StrictHostKeyChecking=accept-new {cfg["SER_LOGIN"]}@{cfg["SER_NAME"]}'.split(' '))
        if 'SSH_KEY' in cfg.keys():
            preBorg.append('-i'); preBorg.append(cfg['SSH_KEY'])
        if 'SSH_REMFO' not in cfg.keys() or len(cfg['SSH_REMFO'])==0:
            preBorg=None
        archive_old=None
        if not no_index:
            try:
                prev=self.borg.getlastbkp(nick,1,debug=debug)
                archive_old=prev[0] if prev else None
            except Exception: archive_old=None
        create=['create']
        # --list limité aux statuts C/E (1.0.117) : signal de qualité seulement, jamais un diff — les
        # changements de la paire viennent de l'Index post-Bkp (borg diff, voir 1.0.116 : 'd' =
        # répertoire, pris pour « supprimé »). Volume quasi nul ; actif même avec -I (pas de l'indexation).
        create.extend('--log-json --json --debug -v --stats --list --filter CE'.split(' '))
        archname='root'
        if 'BORG_ARCHNAME' in cfg.keys(): archname=cfg['BORG_ARCHNAME']
        if archname[:2]=="::": create.append(archname+'-{now:%Y-%m-%dT%H%M%S}')
        else: create.append('::{fqdn}-'+archname+'-{now:%Y-%m-%dT%H%M%S}')
        rootbkp="/"
        if 'BORG_ROOTBKP' in cfg.keys(): rootbkp=cfg['BORG_ROOTBKP']
        create.append(rootbkp)
        if 'EXCLUDE' not in list(cfg.keys()):
            printer(list(cfg.keys()))
            printer("Il est necessaire que EXCLUDE soit configures dans ~/.borghelperrc")
            printer('  EXCLUDE = --exclude /media --exclude /dev --exclude /proc --exclude /sys --exclude /var/run --exclude /run --exclude /lost+found --exclude /mnt --exclude /var/lib/lxcfs --exclude /tmp --exclude /var/lib/docker --exclude-if-present .nobackup  --exclude-caches --exclude-nodump --keep-exclude-tags')
            exit(1)
        create.extend(cfg['EXCLUDE'].split(' '))
        if 'EXCLUDE_NEXT' in list(cfg.keys()):
            create.extend(cfg['EXCLUDE_NEXT'].split(' '))
        self.db.set_priority_lock(nick)
        self.db.wait_index_idle(nick)
        # bkp_status (Story 1, spec-notifications-push) : signal dédié, exclusif à backup(), écrit
        # AVANT tout appel boex() — préalable à la détection de fin par le watcher borgHelperWWW.
        # Reste À L'INTÉRIEUR du try (ensure_diff_db peut sys.exit/lever sur DB corrompue) : le
        # `finally` ci-dessous doit couvrir cette fenêtre pour toujours libérer priority.lock.
        try:
            run_id=uuid.uuid4().hex
            bkp_status_db=self.db.get_diff_db(nick)
            self.db.ensure_diff_db(bkp_status_db)
            if not self.db.store_bkp_status_start(nick,run_id,bkp_status_db):
                printer(f"[WARN] store_bkp_status_start a échoué pour {nick} (run_id={run_id})")
            anaRet=self.borg.boex(nick,create,preBorg=preBorg,forceEnv=forceEnv,debug=debug)
            newretC=0
            if anaRet['exitcode']:
                for i in anaRet['stderr']:
                    if isinstance(i,dict) and i.get('levelname') in ('ERROR','CRITICAL'):
                        newretC=2; break
            # JSON de sortie imprimé APRÈS l'indexation (1.0.116) : borgHelper_file_counts vient du vrai
            # borg diff de la paire (Index post-Bkp), plus de la sortie --list de borg create.
            out=None
            if 'stdout' in anaRet.keys() and len(anaRet['stdout']):
                out=dict(anaRet['stdout'][0])
                out['borghelper_version']=Version
            warn={k:[] for k in _BKP_WARN_STATUSES.values()}
            if 'stderr' in anaRet.keys() and len(anaRet['stderr']):
                for i in anaRet['stderr']:
                    fs=_bkp_file_status(i)
                    if fs is not None:
                        key=_BKP_WARN_STATUSES.get(fs[0])
                        if key and fs[1]: warn[key].append(fs[1])
                        continue
                    if isinstance(i,dict):
                        lvl=i.get('levelname','INFO'); msg=i.get('message',str(i))
                        if lvl=='DEBUG' and not debug: continue
                        print(f"[{lvl}] {msg}",file=sys.stderr,flush=True)
                        if debug: printer(i)
                    elif isinstance(i,str) and i.strip():
                        print(i,file=sys.stderr,flush=True)
            for key,label in (('changed_during_backup','fichier(s) modifié(s) PENDANT la sauvegarde — copie possiblement incohérente'),
                              ('read_errors','erreur(s) de lecture — fichier(s) non ou partiellement sauvegardé(s)')):
                if warn[key]:
                    lst=warn[key][:_BKP_WARN_PATHS_MAX]
                    more=f" (+{len(warn[key])-len(lst)} autres)" if len(warn[key])>len(lst) else ""
                    printer(f"[WARN] {nick}: {len(warn[key])} {label} : {', '.join(lst)}{more}")
            if out is not None:
                out['borgHelper_backup_warnings']={k:{'count':len(v),'paths':v[:_BKP_WARN_PATHS_MAX]} for k,v in warn.items()}
            if newretC==0 and anaRet['stdout']:
                try:
                    arch_info=anaRet['stdout'][0].get('archive',{})
                    archive_new=arch_info.get('name')
                    archive_new_date=arch_info.get('start')
                    db_path=self.db.get_diff_db(nick)
                    self.db.ensure_diff_db(db_path)
                    if archive_new:
                        st=arch_info.get('stats',{})
                        self.db.store_archive_stats(nick,archive_new,archive_new_date,arch_info.get('duration'),
                            st.get('original_size'),st.get('compressed_size'),st.get('deduplicated_size'),st.get('nfiles'),db_path,
                            changed_during_backup=len(warn['changed_during_backup']),read_errors=len(warn['read_errors']))
                        cst=anaRet['stdout'][0].get('cache',{}).get('stats',{})
                        if cst.get('unique_csize') is not None:
                            self.db.store_repo_stats(nick,'bkp',cst['unique_csize'],cst.get('total_size'),cst.get('total_csize'),db_path)
                    if not no_index and archive_new and archive_old:
                        # borg diff réel de la nouvelle paire, PUIS snapshot incrémental (index() finit par
                        # indexsnap) — jamais l'inverse : le snapshot s'appuie sur le diff de la paire.
                        # Messages d'Index sur stderr : le stdout de Bkp reste le seul JSON de sortie.
                        self.db.clear_priority_lock(nick)
                        with contextlib.redirect_stdout(sys.stderr):
                            self.index(nick,debug=debug,target_archive=archive_new,set_pending=False)
                        if out is not None:
                            fc=self._pair_file_counts(nick,archive_old,archive_new,db_path,with_files=bool(debug))
                            if fc is not None:
                                out['borgHelper_file_counts']=fc[0]
                                if debug: out['borgHelper_files']=fc[1]
                    elif not no_index:
                        with contextlib.redirect_stdout(sys.stderr):
                            self.indexsnap(nick,debug=debug)  # première archive : pas de paire, snapshot complet
                    if not no_index and self.db.check_index_pending_lock(nick):
                        self.db.clear_index_pending_lock(nick)
                        printer(f"{nick}: reprise de l'Index interrompu...")
                        with contextlib.redirect_stdout(sys.stderr):
                            self.index(nick,debug=debug,set_pending=False)
                except Exception as e:
                    printer(f"[WARN] indexation post-backup échouée : {e}")
            if out is not None:
                print(json.dumps(out,indent=4),file=sys.stdout,flush=True)
            self.db.store_bkp_status_finish(nick,run_id,'success' if newretC==0 else 'error',bkp_status_db,
                changed_during_backup=len(warn['changed_during_backup']),read_errors=len(warn['read_errors']))
            if newretC!=0:  # même règle que la notification push d'échec ; SENTRY_ALERTS=bkp_error requis
                sentry_alert('bkp_error',nick,f"Sauvegarde en échec — {nick} (code {newretC})",cfg,
                             extra={'exitcode':newretC,'changed_during_backup':len(warn['changed_during_backup']),
                                    'read_errors':len(warn['read_errors'])})
            sys.exit(newretC)
        finally:
            self.db.clear_priority_lock(nick)
            # Filet de sécurité (spec Boundaries) : si une exception non gérée (boex() ou ailleurs)
            # a empêché store_bkp_status_finish ci-dessus, ferme la ligne en 'error' immédiatement —
            # sans attendre le timeout AD-7 du watcher. No-op (CAS sur finished_at IS NULL) si la fin
            # normale a déjà écrit le résultat.
            self.db.store_bkp_status_safety_net(nick,run_id,bkp_status_db)

    def prune(self,nick,dryrun=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        # Garantit que cache.db/diff.db sont à jour (migrations auto) avant que Prune n'y touche —
        # Prune ne passait jusqu'ici par aucun ensure_*_db(), contrairement à Bkp/Index/Report.
        self.db.ensure_cache_db(self.db.get_cache_db(nick))
        self.db.ensure_diff_db(self.db.get_diff_db(nick))
        # priority.lock (spec-status-cli-etat-rapide) : posé avant tout appel boex(), relâché dans un
        # finally couvrant tout le corps — même patron que backup()/restore() — pour que Status()
        # puisse détecter un Prune en cours (ambiguïté assumée avec Restore, priority.lock ne
        # distingue pas l'opération).
        self.db.set_priority_lock(nick)
        try:
            cmd=['prune']
            for i in list(cfg.keys()):
                if 'KEEP_DAILY'==i: cmd.extend(['--keep-daily',cfg[i]])
                elif 'KEEP_WEEKLY'==i: cmd.extend(['--keep-weekly',cfg[i]])
                elif 'KEEP_MONTHLY'==i: cmd.extend(['--keep-monthly',cfg[i]])
                elif 'KEEP_YEARLY'==i: cmd.extend(['--keep-yearly',cfg[i]])
                elif 'KEEP_HOURLY'==i: cmd.extend(['--keep-hourly',cfg[i]])
            if len(cmd)>1:
                if dryrun: cmd.append('--dry-run')
                else: cmd.append('--stats')
                cmd.extend(f'--save-space --info --list --glob-archives={cfg["GLOB_ARCH"]}'.split(' '))
                ret=self.borg.boex(nick,cmd,debug=debug)['stderr']
                if not dryrun:
                    rb=self.borg.boex(nick,['compact','--cleanup-commits'],debug=debug)
                    self.db.clear_cache_nick(nick)
                    self._cleanup_index_after_prune(nick,debug=debug)
                    # Gain Prune (spine AD-3) : borg info --json APRÈS compact --cleanup-commits — c'est
                    # compact, pas prune --stats, qui libère réellement l'espace disque (sinon delta faux/
                    # quasi nul). Appel léger (métadonnées seulement), jamais en --dry-run.
                    try:
                        rbi=self.borg.boex(nick,['info','--json'],debug=debug)
                        self.borg._boex_check_stdout(rbi,nick,'borg info')
                        cst=rbi['stdout'][0].get('cache',{}).get('stats',{})
                        if cst.get('unique_csize') is not None:
                            self.db.store_repo_stats(nick,'prune',cst['unique_csize'],cst.get('total_size'),cst.get('total_csize'))
                    except (RuntimeError,KeyError,TypeError,IndexError,AttributeError,ValueError): pass
                    return rb
                else:
                    return ret
            else:
                usage('prune')
        finally:
            self.db.clear_priority_lock(nick)

    def _indexsnap_incremental(self,nick,archive_name,archive_date,cfg,db_path,debug=0):
        """Mise à jour incrémentale du snapshot via diff_index.
        Retourne (nfiles, exclu_count, exclu_size, n_added, n_removed, n_modified) ou None (fallback borg list)."""
        try:
            conn=_open_db(db_path,nick=nick,role='write',timeout=60)
            _write_mode_check(conn)
            row=conn.execute(
                "SELECT archive FROM archive_snapshot_indexed WHERE nick=? AND archive<? ORDER BY archive DESC LIMIT 1",
                (nick,archive_name)).fetchone()
            if not row:
                conn.close(); return None
            prev_archive=row[0]
            if not conn.execute(
                "SELECT 1 FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",
                (nick,prev_archive,archive_name)).fetchone():
                conn.close(); return None
            diffs=conn.execute(
                "SELECT path,change_type,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",
                (nick,prev_archive,archive_name)).fetchall()
            # borg diff distingue fichiers, répertoires et liens ('removed directory', 'added link'...) :
            # tous appliqués (1.0.116 — seuls 'removed'/'added' l'étaient, un répertoire supprimé
            # restait dans le snapshot).
            removed=[p for p,ct,_ in diffs if ct in _DIFF_REMOVED_TYPES and self._idx_path_ok(p,cfg)]
            modified=[(sz,p) for p,ct,sz in diffs if ct=='modified' and self._idx_path_ok(p,cfg)]
            added=[p for p,ct,_ in diffs if ct in _DIFF_ADDED_TYPES and self._idx_path_ok(p,cfg)]
            exclu_count=sum(1 for p,ct,_ in diffs if not self._idx_path_ok(p,cfg))
            exclu_size=sum(sz or 0 for p,ct,sz in diffs if not self._idx_path_ok(p,cfg))
            if len(added)>5000:
                conn.close(); return None
            # Clone prev snapshot → archive_name
            conn.execute(
                "INSERT OR IGNORE INTO archive_snapshot (nick,archive,archive_date,file_id) "
                "SELECT nick,?,?,file_id FROM archive_snapshot WHERE nick=? AND archive=?",
                (archive_name,archive_date,nick,prev_archive))
            # Apply removed
            for path in removed:
                conn.execute(
                    "DELETE FROM archive_snapshot WHERE nick=? AND archive=? AND file_id="
                    "(SELECT id FROM snapshot_file WHERE nick=? AND path=?)",
                    (nick,archive_name,nick,path))
            if removed:
                self.db._cleanup_snapshot_file_orphans(nick,conn)
            # Apply modified (update size, keep mtime)
            for sz,path in modified:
                if sz is not None:
                    conn.execute("UPDATE snapshot_file SET size=? WHERE nick=? AND path=?",(sz,nick,path))
            conn.commit()
            # Fetch added via targeted borg list (avec mtime, type, mode et propriétaire)
            if added:
                rb=self.borg.boex(nick,
                    ['list','--format','{mode} {type} {user} {group} {uid} {gid} {size} {isomtime} {path}{NL}',f'::{archive_name}']+added,
                    debug=debug,retjson=False)
                if rb['exitcode']!=0:
                    conn.execute("DELETE FROM archive_snapshot WHERE nick=? AND archive=?",(nick,archive_name))
                    self.db._cleanup_snapshot_file_orphans(nick,conn)
                    conn.commit(); conn.close(); return None
                add_rows=[]
                for line in rb['stdout']:
                    line=line.strip()
                    if not line: continue
                    parts=line.split(' ',8)
                    if len(parts)==9:
                        mode,ftype,user,group,uid,gid,sz_s,mtime,path=parts
                        try: sz2=int(sz_s)
                        except ValueError: sz2=None
                        owner=f"{user}:{group} ({uid}:{gid})"
                        # (nick,path,size,mtime,type,mode,owner) — ordre exact des colonnes de l'INSERT ci-dessous
                        # path stocké (_path_stored) : borg list renvoie un chemin logique, jamais écrit tel quel
                        add_rows.append((nick,_path_stored(conn,path),sz2,mtime,ftype,mode,owner))
                if add_rows:
                    _write_mode_check(conn)  # AD-11 : revérifié après le sous-processus borg list, avant la 2e phase d'écriture
                    conn.executemany("INSERT OR REPLACE INTO snapshot_file (nick,path,size,mtime,type,mode,owner) VALUES (?,?,?,?,?,?,?)",add_rows)
                    conn.executemany(
                        "INSERT OR IGNORE INTO archive_snapshot (nick,archive,archive_date,file_id) "
                        "SELECT ?,?,?,id FROM snapshot_file WHERE nick=? AND path=?",
                        [(nick,archive_name,archive_date,nick,r[1]) for r in add_rows])
            nfiles=conn.execute(
                "SELECT COUNT(*) FROM archive_snapshot WHERE nick=? AND archive=?",(nick,archive_name)).fetchone()[0]
            conn.execute(
                "INSERT OR IGNORE INTO archive_snapshot_indexed (nick,archive,entry_count) VALUES (?,?,?)",
                (nick,archive_name,nfiles))
            conn.commit(); conn.close()
            return nfiles,exclu_count,exclu_size,len(added),len(removed),len(modified)
        except sqlite3.Error as e:
            printer(f"  [WARN] indexsnap incrémental échoué ({e}) — fallback borg list")
            try: conn.close()
            except: pass
            return None
        except DbModeError:  # barrière AD-11 : ne pas avaler, ne pas retomber sur un fallback qui réécrirait
            try: conn.close()
            except: pass
            raise

    def indexsnap(self,nick,debug=0,db_path=None,force=False):
        if self._nick_noidx(nick):
            printer(f"{nick}: indexation désactivée (NOIDX=1)"); return 0
        if db_path is None: db_path=self.db.get_diff_db(nick)
        self.db.ensure_diff_db(db_path)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError as e:
            printer(f"{nick}: {e}"); return 1
        archives=rb['stdout'][0]['archives']
        if not archives:
            printer(f"{nick}: aucune archive"); return 0
        latest=archives[-1]
        archive_name=latest['name']; archive_date=latest['start']
        if self.db.is_archive_snapshot_indexed(nick,archive_name,db_path):
            if not force:
                print(f"{nick}: snapshot {archive_name} déjà indexé"); return 0
            try:
                conn=_open_db(db_path,nick=nick,role='write')
                conn.execute("DELETE FROM archive_snapshot WHERE nick=? AND archive=?",(nick,archive_name))
                conn.execute("DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive=?",(nick,archive_name))
                self.db._cleanup_snapshot_file_orphans(nick,conn)
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error ({db_path}): {e}")
        print(f"  {nick}: snapshot {archive_name}...",flush=True)
        # Auto-réparation : le clonage incrémental réutilise le file_id (donc type/mode/owner) des
        # fichiers inchangés — une colonne manquante (migration snapshot_file.type/.mode/.owner, ou
        # ancien snapshot pré-1.0.86/1.0.92/1.0.93) ne se répare jamais tout seul via l'incrémental.
        # S'il en reste, un resnapshot complet est forcé une fois pour tout repeupler ; les backups
        # suivants repassent en incrémental normal.
        auto_repair=False
        if not force:
            try:
                rconn=_open_db(db_path,nick=nick,role='read')
                has_null=rconn.execute("SELECT 1 FROM snapshot_file WHERE nick=? AND (type IS NULL OR mode IS NULL OR owner IS NULL) LIMIT 1",(nick,)).fetchone()
                rconn.close()
                if has_null:
                    auto_repair=True
                    print(f"  {nick}: type/mode/propriétaire manquant pour certaines entrées — resnapshot complet (auto-réparation)")
            except sqlite3.Error: pass
        # Tentative incrémentale (pas en mode force, pas en auto-réparation)
        try:
            inc=None
            if not force and not auto_repair:
                inc=self._indexsnap_incremental(nick,archive_name,archive_date,cfg,db_path,debug)
            if inc is not None:
                nfiles,exclu_count,exclu_size,n_add,n_rem,n_mod=inc
                suffix=f" (+{n_add} -{n_rem} ~{n_mod}, incrémental)"
                if exclu_count:
                    print(f"{nick}: {nfiles} fichiers dans le snapshot {archive_name}{suffix} ({exclu_count} exclus, {convert_octets_readable(exclu_size)})")
                else:
                    print(f"{nick}: {nfiles} fichiers dans le snapshot {archive_name}{suffix}")
            else:
                # Fallback : borg list complet
                rb2=self.borg.boex(nick,['list','--format','{mode} {type} {user} {group} {uid} {gid} {size} {isomtime} {path}{NL}',f"::{archive_name}"],debug=debug,retjson=False)
                if rb2['exitcode']!=0:
                    printer(f"borg list a échoué (code {rb2['exitcode']})")
                    for i in rb2['stderr']:
                        if isinstance(i,dict): printer(f"  [{i.get('levelname','?')}] {i.get('message',i)}")
                        elif isinstance(i,str) and i.strip(): printer(f"  {i}")
                    return rb2['exitcode']
                files=[]; exclu_count=0; exclu_size=0
                for line in rb2['stdout']:
                    line=line.strip()
                    if not line: continue
                    parts=line.split(' ',8)
                    if len(parts)==9:
                        mode,ftype,user,group,uid,gid,size_s,mtime,path=parts
                        try: size=int(size_s)
                        except ValueError: size=None
                        owner=f"{user}:{group} ({uid}:{gid})"
                        if self._idx_path_ok(path,cfg):
                            files.append({'path':path,'size':size,'mtime':mtime,'type':ftype,'mode':mode,'owner':owner})
                        else:
                            exclu_count+=1; exclu_size+=(size or 0)
                self.db.store_archive_snapshot(nick,archive_name,archive_date,files,db_path)
                if exclu_count:
                    self.db.store_excluded_snap_stats(nick,archive_name,exclu_count,exclu_size,db_path)
                    print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name} ({exclu_count} exclus, {convert_octets_readable(exclu_size)})")
                else:
                    print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name}")
        except DbModeError as e:
            # AD-11 : mode changé pendant indexsnap (incrémental ou fallback) — jamais avalée en
            # silence, mais dégradée proprement (index_pending) plutôt qu'une traceback jusqu'à
            # l'appelant CLI direct (Index/Index -S, sans try/except englobant sur ce chemin).
            printer(f"[WARN] {nick}: mode changé pendant indexsnap : {e}")
            self.db.set_index_pending_lock(nick)
            return 1
        keep_snap=int(cfg.get('IDX_SNAP_KEEP',
            sum(int(cfg.get(k,0)) for k in ['KEEP_DAILY','KEEP_WEEKLY','KEEP_MONTHLY','KEEP_YEARLY','KEEP_HOURLY'])
            or 10))
        try:
            conn=_open_db(db_path,nick=nick,role='write',timeout=60)
            snap_del,snap_count=self._snapurge_check(nick,conn,keep_snap)
            if snap_del:
                self._snapurge_exec(nick,conn,snap_del)
                conn.commit()
                print(f"{nick}: {snap_count:,} entrées snapshot supprimées ({len(snap_del)} archives anciennes)")
            conn.close()
        except sqlite3.Error as e:
            printer(f"  [WARN] purge snapshot échouée ({e})")
        return 0

    def _refresh_chart_stats(self,nick,cfg,db_path,archives,force=False,debug=0):
        """Statistiques des graphiques d'évolution (spec-charts-evolution-sauvegardes), rafraîchies à
        chaque Index — y compris NOIDX=1 ou moins de 2 archives, où l'indexation des chemins elle-même
        n'a pas lieu : ces statistiques ne portent aucun chemin.
        - archive_stats : archives sans ligne (créées avant cette fonctionnalité, ou hors borgHelper) —
          `borg info --json --glob-archives` (coûteux : n'est lancé que s'il en manque, ou si force).
          ⚠️ deduplicated_size y vaut la taille UNIQUE à l'archive AUJOURD'HUI (borg info), pas la
          donnée ajoutée lors de sa création (borg create --stats, cas d'un Bkp) — proches, pas égales.
        - repo_stats : point op='index' (`borg info --json` du dépôt, métadonnées seulement) si les
          tailles diffèrent du dernier point — jamais de doublon juste après un Bkp (qui relance
          Index) ; donne un historique de taille du dépôt même sans Bkp/Prune faits par borgHelper.
        Erreurs signalées (printer), jamais fatales pour Index."""
        archive_names=set(a['name'] for a in archives)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            existing=set(r[0] for r in conn.execute("SELECT archive FROM archive_stats WHERE nick=?",(nick,)).fetchall())
            conn.close()
        except sqlite3.Error: existing=set()
        missing=archive_names-existing
        if missing or (force and archive_names):
            rbi=self.borg.boex(nick,['info','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
            try:
                self.borg._boex_check_stdout(rbi,nick,'borg info')
                n=0
                for a in rbi['stdout'][0]['archives']:
                    if force or a['name'] in missing:
                        st=a.get('stats',{})
                        self.db.store_archive_stats(nick,a['name'],a.get('start'),a.get('duration'),
                            st.get('original_size'),st.get('compressed_size'),st.get('deduplicated_size'),st.get('nfiles'),db_path)
                        n+=1
                if n: print(f"{nick}: statistiques de {n} archive(s) enregistrées (graphiques)")
            except (RuntimeError,KeyError,TypeError,IndexError,AttributeError,ValueError) as e:
                printer(f"{nick}: statistiques d'archives (graphiques) non récupérées : {e}")
        rbr=self.borg.boex(nick,['info','--json'],debug=debug)
        try:
            self.borg._boex_check_stdout(rbr,nick,'borg info')
            cst=rbr['stdout'][0].get('cache',{}).get('stats',{})
            if cst.get('unique_csize') is not None:
                cur={'unique_csize':cst['unique_csize'],'total_size':cst.get('total_size'),'total_csize':cst.get('total_csize')}
                if self.db.get_repo_stats(nick,db_path)!=cur:
                    self.db.store_repo_stats(nick,'index',cur['unique_csize'],cur['total_size'],cur['total_csize'],db_path)
        except (RuntimeError,KeyError,TypeError,IndexError,AttributeError,ValueError) as e:
            printer(f"{nick}: taille du dépôt (graphiques) non récupérée : {e}")

    def index(self,nick,debug=0,db_path=None,force=False,target_archive=None,set_pending=True):
        noidx=self._nick_noidx(nick)
        if self.db.check_priority_lock(nick):
            if set_pending and not noidx: self.db.set_index_pending_lock(nick)
            printer(f"{nick}: opération prioritaire (Bkp/Restore) en cours — Index annulé"); return 1
        if db_path is None: db_path=self.db.get_diff_db(nick)
        self.db.ensure_diff_db(db_path)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError as e:
            printer(f"{nick}: {e}"); return 1
        archives=rb['stdout'][0]['archives']
        if noidx:
            self._refresh_chart_stats(nick,cfg,db_path,archives,force=force,debug=debug)
            printer(f"{nick}: indexation des chemins désactivée (NOIDX=1) — statistiques des graphiques seules"); return 0
        if len(archives)<2:
            self._refresh_chart_stats(nick,cfg,db_path,archives,force=force,debug=debug)
            printer(f"{nick}: moins de 2 archives, rien à indexer"); return 0
        # Phase 1 : paires à indexer + purge groupée si force
        pairs_todo=[]; skipped=0; pairs_to_purge=[]
        for i in range(len(archives)-1):
            a_old=archives[i]['name']; a_new=archives[i+1]['name']; date_new=archives[i+1]['start']
            if target_archive is not None:
                if a_new!=target_archive: skipped+=1; continue
                pairs_to_purge.append((a_old,a_new))
                pairs_todo.append((a_old,a_new,date_new)); continue
            already=self.db.is_diff_pair_indexed(nick,a_old,a_new,db_path)
            if already and not force:
                if self.db.diff_pair_has_sizes(nick,a_old,a_new,db_path): skipped+=1; continue
                pairs_to_purge.append((a_old,a_new))  # indexé sans tailles (post-backup) → re-indexer
            elif already and force: pairs_to_purge.append((a_old,a_new))
            pairs_todo.append((a_old,a_new,date_new))
        if pairs_to_purge:
            try:
                conn=_open_db(db_path,nick=nick,role='write')
                for a_old,a_new in pairs_to_purge:
                    conn.execute("DELETE FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    conn.execute("DELETE FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"SQLite error ({db_path}): {e}")
        # Phase 2 : borg diff en parallèle
        workers=max(1,int(cfg.get('IDX_WORKERS','4')))
        borg_exe=cfg.get('BORG_EXE','borg')
        varcur=os.environ.copy()
        diff_env={k:cfg[k] for k in cfg.keys() if k in ('BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO','BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE')}
        diff_env['PATH']=varcur['PATH']; diff_env['LC_ALL']='fr_FR.UTF-8'
        running_procs={}; running_procs_lock=threading.Lock()
        def _run_diff(pair):
            a_old,a_new,date_new=pair
            print(f"  {nick}: {a_old} → {a_new}",flush=True)
            cmd=[borg_exe,'diff','--json-lines',f"{cfg['BORG_REPO']}::{a_old}",a_new]
            ps=subprocess.Popen(cmd,encoding='utf-8',env=diff_env,cwd=os.getcwd(),
                                stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
            with running_procs_lock: running_procs[pair]=ps
            entries=[]; exclu={}
            try:
                for line in ps.stdout:          # streaming — parse au fil de l'eau
                    p=parse_diff_line_json(line)
                    if not p or not p['path']: continue
                    if self._idx_path_ok(p['path'],cfg):
                        entries.append(p)
                    else:
                        ct=p['change_type']
                        sz=p.get('size_after') or p.get('size_before') or 0
                        if ct not in exclu: exclu[ct]={'count':0,'size':0}
                        exclu[ct]['count']+=1; exclu[ct]['size']+=sz
                ps.wait()
            finally:
                with running_procs_lock: running_procs.pop(pair,None)
            ok=ps.returncode in (0,1)
            if not ok: entries=[]; exclu={}
            return (a_old,a_new,date_new,entries,exclu,ok)
        interrupted_event=threading.Event()  # UNIQUEMENT : opération prioritaire détectée (vraie interruption)
        monitor_stop=threading.Event()       # fin normale : arrête le thread de surveillance, sans rien signaler
        results=[]
        mode_changed=False  # AD-11 : une fois DbModeError vue, mode durablement changé pour le reste du run
        if pairs_todo:
            self.db.set_index_running_lock(nick)
            db_conn=None
            try:
                try: db_conn=_open_db(db_path,nick=nick,role='read')
                except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}")
                with ThreadPoolExecutor(max_workers=workers) as ex:
                    futs={ex.submit(_run_diff,p):p for p in pairs_todo}
                    def _priority_monitor():
                        while not interrupted_event.is_set() and not monitor_stop.is_set():
                            if self.db.check_priority_lock(nick) or self.db.check_report_running(nick):
                                printer(f"  {nick}: opération prioritaire (Bkp/Restore/Report) détectée — arrêt des diffs en cours")
                                interrupted_event.set()
                                for f in list(futs):
                                    if not f.done(): f.cancel()
                                with running_procs_lock:
                                    for ps in list(running_procs.values()):
                                        try: ps.kill()
                                        except OSError: pass
                                # Attendre que les _run_diff aient reap leurs processus (plus de zombies)
                                deadline=time.time()+15
                                while time.time()<deadline:
                                    with running_procs_lock:
                                        if not running_procs: break
                                    time.sleep(0.1)
                                # Purger les répertoires PyInstaller orphelins (_MEI*) laissés par SIGKILL
                                import glob as _glob, shutil as _shutil
                                for _d in _glob.glob('/tmp/_MEI*'):
                                    try:
                                        if subprocess.run(['fuser',_d],capture_output=True).returncode!=0:
                                            _shutil.rmtree(_d,ignore_errors=True)
                                    except Exception: pass
                                # Purger les stale locks borg laissés par les process tués
                                if 'BORG_REPO' in cfg:
                                    printer(f"  {nick}: purge des locks borg (break-lock)...")
                                    try:
                                        bl=subprocess.run([borg_exe,'break-lock',cfg['BORG_REPO']],
                                                          env=diff_env,timeout=30,capture_output=True)
                                        if bl.returncode!=0:
                                            printer(f"  [WARN] borg break-lock : {bl.stderr.decode(errors='replace')[:200]}")
                                    except Exception as e:
                                        printer(f"  [WARN] borg break-lock échoué : {e}")
                                return
                            time.sleep(0.5)
                    monitor=threading.Thread(target=_priority_monitor,daemon=True)
                    monitor.start()
                    try:
                        for fut in as_completed(futs):
                            try:
                                result=fut.result()
                                if mode_changed: continue  # déjà signalé une fois ; le mode reste changé pour le reste du run
                                results.append(result)
                                if db_conn:
                                    a_old,a_new,date_new,entries,exclu,ok=result
                                    _write_mode_check(db_conn)  # AD-11 : avant tout INSERT/UPDATE/executemany de cette paire
                                    if not ok:
                                        db_conn.execute("DELETE FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                                        db_conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                                        db_conn.execute("DELETE FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                                    else:
                                        if entries:
                                            db_conn.executemany("INSERT INTO diff_index (nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES (?,?,?,?,?,?,?,?)",
                                                [(nick,a_old,a_new,date_new,e['change_type'],_path_stored(db_conn,e['path']),e.get('size_before'),e.get('size_after')) for e in entries])
                                        db_conn.execute("INSERT OR IGNORE INTO diff_indexed_pairs (nick,archive_old,archive_new,entry_count) VALUES (?,?,?,?)",(nick,a_old,a_new,len(entries)))
                                        if exclu:
                                            db_conn.executemany(
                                                "INSERT OR REPLACE INTO diff_excluded_stats "
                                                "(nick,archive_old,archive_new,change_type,file_count,total_size) VALUES (?,?,?,?,?,?)",
                                                [(nick,a_old,a_new,ct,s['count'],s['size']) for ct,s in exclu.items()])
                                    db_conn.commit()
                            except CancelledError: pass
                            except DbModeError:
                                # AD-11 : mode de la base changé depuis l'ouverture — la paire n'est ni marquée
                                # indexée ni committée (aucun INSERT/DELETE exécuté, la barrière a précédé tout
                                # écriture) ; reportée via index_pending (mécanisme existant, pas dupliqué) ;
                                # Bkp ne doit jamais échouer pour cette seule paire. Le mode changé est durable
                                # pour le reste du run : signalé UNE fois, les paires restantes sont ignorées
                                # sans re-tester la barrière (évite le bruit d'un set_index_pending_lock/message
                                # par paire).
                                if not mode_changed:
                                    mode_changed=True
                                    self.db.set_index_pending_lock(nick)
                                    printer(f"  {nick}: mode de la base changé pendant l'indexation — paires restantes reportées")
                            except Exception as e: printer(f"[WARN] borg diff échoué : {e}")
                    finally:
                        # Jamais interrupted_event ici : le tester plus bas ferait passer TOUT Index ayant
                        # traité au moins une paire pour « interrompu » (return 1, index_pending posé,
                        # statistiques/snapshot/DIFF_KEEP jamais atteints) — bug corrigé en 1.0.114.
                        monitor_stop.set()
                        monitor.join(timeout=2)
            finally:
                self.db.clear_index_running_lock(nick)
                if db_conn:
                    try: db_conn.close()
                    except: pass
        if interrupted_event.is_set():
            if set_pending: self.db.set_index_pending_lock(nick)
            printer(f"{nick}: indexation interrompue — reprise automatique après le backup"); return 1
        ok_results=[r for r in results if r[5]]
        new_pairs=len(ok_results)
        total_exclu=sum(sum(s['count'] for s in exclu.values()) for _,_,_,_,exclu,_ in ok_results)
        exclu_suffix=f", {total_exclu:,} exclus" if total_exclu else ""
        print(f"{nick}: {new_pairs} paires indexées (+{skipped} déjà en cache{exclu_suffix})")
        diff_keep=cfg.get('DIFF_KEEP','')
        if diff_keep.strip().isdigit():
            self.db._diff_keep_purge(nick,int(diff_keep),db_path)
        self._refresh_chart_stats(nick,cfg,db_path,archives,force=force,debug=debug)
        self.indexsnap(nick,debug=debug,db_path=db_path,force=force)
        return 0

    def search(self,nick,pattern,archive_from=None,archive_to=None,debug=0,as_json=False):
        """as_json=True : imprime {nick: [...lignes]} par nick réussi, {nick: {'error': msg}} par
        nick en échec (index vide/erreur SQLite) — deux formes par clé, à distinguer par type
        (list vs dict) côté consommateur."""
        sql_pat=pattern.replace('*','%').replace('?','_')
        if '%' not in sql_pat and '_' not in sql_pat: sql_pat='%'+sql_pat+'%'
        rows=[]
        results={} if as_json else None
        for n in nick.split(','):
            db_path=self.db.get_diff_db(n)
            self.db.ensure_diff_db(db_path,create=False)
            if self.db._is_index_empty(n,db_path):
                msg=f"Index vide pour {n} — lancez : borgHelper -c Index -n {n}"
                if as_json: results[n]={'error':msg}
                else: printer(f"[ERREUR] {msg}")
                continue
            try:
                conn=_open_db(db_path,nick=n,role='read')
                af_sql,af_params=self.db._diff_archive_filter(n,archive_from,conn,archive_to)
                psql,pprm,pyf=_psel_like(conn,sql_pat)
                def _fetch(q,params,key):
                    out=[]
                    for r in conn.execute(q,params):
                        r=list(r); r[4]=_path_decode(conn,r[4])
                        if pyf and not pyf(r[4]): continue
                        out.append(tuple(r))
                    # ORDER BY <colonne>,path en Python (NULL en premier comme SQLite ; chemin à l'ordre octet UTF-8)
                    out.sort(key=lambda r:(r[key] is not None,r[key] or '',_path_sort_key(r[4])))
                    return out
                n_rows=_fetch("SELECT nick,archive_new_date,archive_new,change_type,path,size_before,size_after FROM diff_index WHERE nick=?"+_wh(psql)+af_sql,[n]+pprm+af_params,1)
                df,dt=_snap_params(af_params,archive_from,archive_to)
                snap_extra=[x for x in [df,dt] if x]
                n_rows+=_fetch("SELECT nick,archive_date,archive,'présent',path,NULL,size FROM archive_snapshot_v WHERE nick=?"+_wh(psql)+" "+_snap_notin(df,dt),[n]+pprm+snap_extra,2)
                conn.close()
            except DbCodecError as e:
                msg=_codec_fail(n,e,conn)
                if as_json: results[n]={'error':msg}
                continue
            except sqlite3.Error as e:
                if as_json: results[n]={'error':f"SQLite error ({db_path}): {e}"}
                else: printer(f"SQLite error ({db_path}): {e}")
                continue
            rows.extend(n_rows)
            if as_json:
                results[n]=[{'date':(d or '')[:19],'archive':a,'type':t,'path':p,'size_before':sb,'size_after':sa}
                            for _,d,a,t,p,sb,sa in n_rows]
        if as_json:
            print(json.dumps(results,ensure_ascii=False,indent=2)); return
        if not rows: print("Aucun résultat."); return
        from prettytable import PrettyTable
        t=PrettyTable(['nick','date','archive','type','chemin','avant','après'])
        t.align['chemin']='l'; t.align['archive']='l'
        for nick_r,date_r,arch_r,type_r,path_r,sb,sa in rows:
            t.add_row([nick_r,(date_r or '')[:19],arch_r,type_r,path_r,convert_octets_readable(sb) if sb else '',convert_octets_readable(sa) if sa else ''])
        print(t)

    def filehist(self,nick,path,archive_from=None,archive_to=None,debug=0,as_json=False):
        """as_json : voir search() — même forme par-nick, list ou {'error':msg}."""
        rows=[]
        results={} if as_json else None
        for n in nick.split(','):
            db_path=self.db.get_diff_db(n)
            self.db.ensure_diff_db(db_path,create=False)
            if self.db._is_index_empty(n,db_path):
                msg=f"Index vide pour {n} — lancez : borgHelper -c Index -n {n}"
                if as_json: results[n]={'error':msg}
                else: printer(f"[ERREUR] {msg}")
                continue
            try:
                conn=_open_db(db_path,nick=n,role='read')
                af_sql,af_params=self.db._diff_archive_filter(n,archive_from,conn,archive_to)
                pstored=_path_stored(conn,path)
                cur=conn.execute("SELECT nick,archive_new_date,archive_old,archive_new,change_type,size_before,size_after FROM diff_index WHERE nick=? AND path=?"+af_sql+" ORDER BY archive_new_date",[n,pstored]+af_params)
                n_rows=cur.fetchall()
                df,dt=_snap_params(af_params,archive_from,archive_to)
                snap_extra=[x for x in [df,dt] if x]
                cur=conn.execute("SELECT nick,archive_date,'',archive,'présent',NULL,size FROM archive_snapshot_v WHERE nick=? AND path=? "+_snap_notin(df,dt),[n,pstored]+snap_extra)
                n_rows+=cur.fetchall(); conn.close()
            except sqlite3.Error as e:
                if as_json: results[n]={'error':f"SQLite error ({db_path}): {e}"}
                else: printer(f"SQLite error ({db_path}): {e}")
                continue
            n_rows.sort(key=lambda r:(r[1] or ''))
            rows.extend(n_rows)
            if as_json:
                results[n]=[{'date':(d or '')[:19],'archive_before':ao,'archive_after':an,'type':t,'size_before':sb,'size_after':sa}
                            for _,d,ao,an,t,sb,sa in n_rows]
        if as_json:
            print(json.dumps(results,ensure_ascii=False,indent=2)); return
        if not rows: print(f"Aucune entrée pour : {path}"); return
        rows.sort(key=lambda r:(r[1] or ''))
        from prettytable import PrettyTable
        t=PrettyTable(['nick','date','archive avant','archive après','type','avant','après'])
        t.align['archive avant']='l'; t.align['archive après']='l'
        for nick_r,date_r,a_old,a_new,type_r,sb,sa in rows:
            t.add_row([nick_r,(date_r or '')[:19],a_old,a_new,type_r,convert_octets_readable(sb) if sb else '',convert_octets_readable(sa) if sa else ''])
        print(t)

    def _treehist_listing(self,n,prefix,conn,archive_from=None,archive_to=None,debug=0,as_json=False):
        """Liste le contenu DIRECT du répertoire courant (dernière archive snapshotée) en un seul
        tableau : le répertoire courant lui-même en '.', puis ses enfants immédiats — même sans
        événement dans la plage demandée. Colonne 'genre' (répertoire/fichier/lien symbolique/…) tirée
        du type réel stocké par borg ; 'aucun événement dans la plage' si l'entrée n'a pas bougé.
        as_json=True : ne print rien, retourne un dict {path,archive,entries:[...]} ou {'error':msg}
        (utilisé par borgHelperWWW pour l'explorateur d'arborescence)."""
        prefix=_norm_lp(prefix)
        row=conn.execute("SELECT archive FROM archive_snapshot_v WHERE nick=? ORDER BY archive_date DESC LIMIT 1",(n,)).fetchone()
        if row is None:
            msg=f"aucun snapshot indexé sous {prefix or '/'} — lancez : borgHelper -c Index -n {n}"
            if as_json: return {'error':msg}
            print(f"{n}: {msg}"); return None
        latest=row[0]
        # le préfixe lui-même ET ses descendants : égalité + intervalle (racine : aucune borne)
        psql,pprm,_=_psel_under(conn,prefix,self_too=True)
        plen=len(prefix)+1 if prefix else 0
        children={}       # name -> is_dir (heuristique de secours si le type est inconnu)
        type_by_name={}    # name -> type réel de SA PROPRE entrée (pas celui d'un enfant plus profond)
        mode_by_name={}    # name -> droits unix (dernier état connu) de SA PROPRE entrée
        owner_by_name={}   # name -> propriétaire (dernier état connu) de SA PROPRE entrée
        own_type=None; own_mode=None; own_owner=None
        if conn.codec is not None:
            # Base chiffrée — « piste 2 » (1.0.121, choix utilisateur) : SEULS le répertoire listé et ses
            # enfants DIRECTS sont décodés (donc vérifiés), plus chaque chemin du sous-arbre. AD-3 ne
            # chiffre pas le séparateur '/' : la structure se lit sur la valeur STOCKÉE (même nombre de
            # '/' que le chemin logique, alphabet base64 ASCII — substr/instr de SQLite y sont exacts au
            # caractère près). SQLite sépare donc lui-même les lignes des enfants directs (reste sans '/')
            # des descendants plus profonds, dont il ne renvoie que le segment chiffré de l'enfant direct
            # (DISTINCT) : Python décode une valeur par entrée affichée, pas une par ligne du sous-arbre
            # (…/kernel de la démo : 6 474 -> 15). Compromis accepté : un segment altéré PLUS PROFOND
            # qu'un enfant direct n'est détecté qu'en descendant jusqu'à lui (ou par TreeFind/Search, qui
            # décodent tout) — le répertoire listé et ses enfants restent vérifiés à chaque affichage.
            enc_prefix=conn.codec.path.encode(prefix) if prefix else ''
            skip=len(enc_prefix)+1 if enc_prefix else 0
            usql,uprm,_=_psel_under(conn,prefix)
            rest=f"substr(path,{skip+1})"
            if prefix:
                own=conn.execute("SELECT type,mode,owner FROM archive_snapshot_v WHERE nick=? AND archive=? AND path=?",
                                 (n,latest,enc_prefix)).fetchone()
                if own: own_type,own_mode,own_owner=own
            def _child(stored_child):
                lp=conn.codec.decode_path(stored_child)  # préfixe (mémo) + segment de l'enfant, vérifiés
                return lp[plen:] if prefix else lp
            for path,ftype,fmode,fowner in conn.execute(
                    f"SELECT path,type,mode,owner FROM archive_snapshot_v WHERE nick=? AND archive=?{_wh(usql)} AND instr({rest},'/')=0",
                    [n,latest]+uprm):
                name=_child(path)
                children.setdefault(name,False)
                type_by_name[name]=ftype; mode_by_name[name]=fmode; owner_by_name[name]=fowner
            for (seg,) in conn.execute(
                    f"SELECT DISTINCT substr({rest},1,instr({rest},'/')-1) FROM archive_snapshot_v WHERE nick=? AND archive=?{_wh(usql)} AND instr({rest},'/')>0",
                    [n,latest]+uprm):
                children[_child(f"{enc_prefix}/{seg}" if enc_prefix else seg)]=True
        else:
            for path,ftype,fmode,fowner in conn.execute("SELECT path,type,mode,owner FROM archive_snapshot_v WHERE nick=? AND archive=?"+_wh(psql),[n,latest]+pprm):
                lp=_path_decode(conn,path)
                if prefix and lp==prefix:
                    own_type=ftype; own_mode=fmode; own_owner=fowner; continue
                rel=lp[plen:] if prefix else lp
                if not rel: continue
                seg=rel.split('/',1)
                name=seg[0]; is_dir=len(seg)>1
                children[name]=children.get(name,False) or is_dir
                if not is_dir: type_by_name[name]=ftype; mode_by_name[name]=fmode; owner_by_name[name]=fowner
        # Enfants directs supprimés (diff_index) : jamais archive_snapshot_v/archive_snapshot, purgés
        # indépendamment selon IDX_SNAP_KEEP — diff_index n'est purgé qu'au prune réel de l'archive
        # (_cleanup_index_after_prune), donc une ligne survivante référence toujours une archive encore
        # restaurable. Un nom déjà présent dans children n'est jamais reconsidéré ici : l'appartenance
        # au snapshot courant prime toujours, même en cas d'historique suppression/réajout.
        # Enfants directs uniquement : la profondeur se juge en Python. Un premier essai (Story 6, voir
        # historique) a remplacé le `SELECT DISTINCT path` + requête par candidat par une seule requête
        # fenêtrée `ROW_NUMBER()` — mesuré PLUS LENT (le tri de la fenêtre sur tout `diff_index` du
        # périmètre coûte davantage que les quelques centaines de requêtes ponctuelles qu'il économise ;
        # l'index `idx_diff_nick_path` rend déjà le `DISTINCT` bon marché). Le vrai coût mesuré est le
        # DÉCODAGE de CHAQUE chemin distinct du sous-arbre (des dizaines de milliers sur une grosse base)
        # rien que pour éliminer ceux qui ne sont pas des enfants directs. Correctif retenu : AD-3 ne
        # chiffre pas le séparateur '/' entre segments (« Segments chiffrés joints par '/' » — la
        # profondeur/structure est une fuite explicitement acceptée, Deferred de la spine) : le nombre de
        # '/' de la valeur STOCKÉE est donc identique à celui du chemin logique, et un enfant direct se
        # reconnaît sur la valeur stockée SANS la décoder (juste un slice + test '/' in ...). Seuls les
        # candidats structurellement enfants directs sont décodés puis interrogés pour leur dernier
        # événement — la requête par candidat (petit nombre, jamais le goulot mesuré) est conservée telle
        # quelle. Mesuré Story 6/PerfBench : ~5,7 s -> voir TECHNICAL.md pour le chiffre après correctif.
        usql,uprm,_=_psel_under(conn,prefix)
        if conn.codec is not None:
            enc_prefix=conn.codec.path.encode(prefix) if prefix else ''
            stored_skip=len(enc_prefix)+1 if enc_prefix else 0
        else:
            stored_skip=plen
        del_rows=[]
        for (stored,) in conn.execute("SELECT DISTINCT path FROM diff_index WHERE nick=?"+_wh(usql),[n]+uprm).fetchall():
            rest=stored[stored_skip:]
            if not rest or '/' in rest: continue  # pas structurellement un enfant direct -- jamais décodé
            lp=_path_decode(conn,stored)
            nm=lp[plen:] if prefix else lp
            if not nm or nm in children: continue
            last=conn.execute("SELECT change_type,archive_old,size_before FROM diff_index WHERE nick=? AND path=? ORDER BY archive_new_date DESC,id DESC LIMIT 1",(n,stored)).fetchone()
            if last and last[0] in _DIFF_REMOVED_TYPES: del_rows.append((lp,last[1],_diff_entry_type(last[0],last[2])))
        deleted_children={}   # name -> (archive_old,type) — sélectionne, par chemin, l'événement
                               # diff_index le PLUS RÉCENT (archive_new_date max) ; ne garde que ceux
                               # dont ce dernier événement est une suppression, quel que soit le type
                               # ('removed', 'removed directory|link|fifo|…' — avant 1.0.126 seul
                               # 'removed' comptait : répertoires, liens, fifos supprimés invisibles).
                               # type = _diff_entry_type (tiré de change_type, plus d'heuristique de taille).
        for path,archive_old,etype in del_rows:
            name=path[plen:] if prefix else path
            if not name or name in children: continue
            deleted_children[name]=(archive_old,etype)
        if not children and not deleted_children and (not prefix or own_type is None):
            msg=f"{prefix or '/'} vide ou introuvable dans le snapshot ({latest})"
            if as_json: return {'error':msg}
            print(f"{n}: {msg}"); return None
        af_sql,af_params=self.db._diff_archive_filter(n,archive_from,conn,archive_to)
        def _events_for(full_path,recursive=False):
            # recursive=True (répertoires) : un événement n'importe où dans la sous-arborescence
            # compte comme un événement de CE répertoire — sans en lister le détail (pas de contenu
            # de sous-répertoire). added/removed ne concernent QUE l'entrée du répertoire lui-même
            # (ex. 'added directory'/'removed directory') ; un mouvement d'un descendant, quel qu'il
            # soit (added/removed/modified plus bas), remonte comme 'modified' générique.
            own=conn.execute("SELECT change_type,archive_new,archive_new_date FROM diff_index WHERE nick=? AND path=?"+af_sql+" ORDER BY archive_new_date",[n,_path_stored(conn,full_path)]+af_params).fetchall()
            if not recursive: return own
            dsql,dprm,_=_psel_under(conn,full_path)
            deep=conn.execute("SELECT DISTINCT archive_new,archive_new_date FROM diff_index WHERE nick=?"+_wh(dsql)+af_sql+" ORDER BY archive_new_date",[n]+dprm+af_params).fetchall()
            own_archives={a for _,a,_ in own}
            synthetic=[('modified',arch,date) for arch,date in deep if arch not in own_archives]
            return sorted(own+synthetic,key=lambda r:r[2] or '')
        def _genre(is_dir,known_type):
            if known_type: return _TREEHIST_GENRES.get(known_type,f"type '{known_type}'")
            return 'répertoire' if is_dir else 'inconnu (réindexer)'
        entries=[] if as_json else None
        if not as_json:
            from prettytable import PrettyTable
            t=PrettyTable(['nom','genre','droits','propriétaire','type','archive','date'])
            t.align['nom']='l'; t.align['archive']='l'
        def _add_rows(name,genre,droits,owner,full_path,is_dir,recursive=False):
            events=_events_for(full_path,recursive=recursive)
            droits_disp=droits or '—'; owner_disp=owner or '—'
            if as_json:
                entries.append({'name':name,'full_path':full_path,'genre':genre,'mode':droits,'owner':owner,'is_dir':is_dir,
                    'events':[{'type':ct,'archive':arch,'date':(date or '')[:19]} for ct,arch,date in events]})
                return
            if not events:
                t.add_row([name,genre,droits_disp,owner_disp,'—','—','aucun événement dans la plage'])
            else:
                for ct,arch,date in events:
                    t.add_row([name,genre,droits_disp,owner_disp,ct,arch,(date or '')[:19]])
        def _add_deleted_row(name,genre,full_path,is_dir,archive_old):
            # Entrée supprimée (diff_index) : pas d'historique 'events' comme pour une entrée présente
            # — seule compte l'archive de dernière présence (archive_old de l'événement 'removed' le
            # plus récent). Colonne 'type' marquée 'supprimé' pour rester visuellement distincte en
            # mode texte. Le champ JSON 'deleted' n'est ajouté qu'ici, jamais aux entrées présentes
            # (leur forme JSON reste strictement inchangée).
            if as_json:
                entries.append({'name':name,'full_path':full_path,'genre':genre,'mode':None,'owner':None,'is_dir':is_dir,
                    'deleted':True,'last_seen_archive':archive_old,'events':[]})
                return
            t.add_row([name,genre,'—','—','supprimé',archive_old,'—'])
        _add_rows('.',_TREEHIST_GENRES.get(own_type,'répertoire'),own_mode,own_owner,prefix,True,recursive=True)
        for name in sorted(set(children)|set(deleted_children)):
            full=f"{prefix}/{name}" if prefix else name
            if name in children:
                is_dir=children[name]
                _add_rows(name,_genre(is_dir,type_by_name.get(name)),mode_by_name.get(name),owner_by_name.get(name),full,is_dir,recursive=is_dir)
            else:
                archive_old,etype=deleted_children[name]
                _add_deleted_row(name,_TREEHIST_GENRES.get(etype,'inconnu'),full,etype=='d',archive_old)
        if as_json:
            return {'path':prefix,'archive':latest,'entries':entries}
        print(f"{n}: {prefix or '/'} (snapshot {latest})")
        print(t)
        return None

    @staticmethod
    def _archive_date(conn,n,archive):
        """Date d'UNE archive (sa propre date, jamais celle de l'archive suivante — contrairement au
        _date_of de _diff_archive_filter, qui peut renvoyer la date de la paire dont elle est l'ancienne) :
        archive_stats, sinon diff_index (archive_new), sinon archive_snapshot. None si inconnue."""
        for sql in ("SELECT archive_date FROM archive_stats WHERE nick=? AND archive=?",
                    "SELECT archive_new_date FROM diff_index WHERE nick=? AND archive_new=? LIMIT 1",
                    "SELECT archive_date FROM archive_snapshot WHERE nick=? AND archive=? LIMIT 1"):
            row=conn.execute(sql,(n,archive)).fetchone()
            if row and row[0]: return row[0]
        return None

    def _treehist_changes(self,n,prefix,conn,archive_from=None,archive_to=None,as_json=False):
        """Mode « changements » de TreeHist (-X, 1.0.133) : SEULS les enfants directs de <prefix> qui ont changé
        entre archive_from (EXCLUE : on compare depuis son contenu) et archive_to (INCLUSE) — fichier ajouté,
        modifié ou supprimé ; répertoire dès qu'un changement a eu lieu n'importe où en dessous (événements
        synthétiques 'modified' comme TreeHist). Sans archive_from (ou ALL) : depuis le début ; sans archive_to :
        jusqu'à la dernière archive. Source : diff_index seul (paires indexées) — jamais le snapshot, qui ne sert
        qu'aux droits/propriétaire (dernier état connu). Base chiffrée : même mécanique que la piste 2 (SQLite
        sépare enfants directs et descendants sur la valeur stockée, un décodage par entrée affichée).
        Entrée supprimée dans la plage (dernier événement propre = suppression) : deleted/last_seen_archive."""
        prefix=_norm_lp(prefix)
        rng=[]; rprm=[]
        for label,arch,op in (('depuis',archive_from,'>'),('jusqu\'à',archive_to,'<=')):
            if arch and arch!='ALL':
                d=self._archive_date(conn,n,arch)
                if d is None:
                    msg=f"archive inconnue de l'index ({label}) : {arch}"
                    if as_json: return {'error':msg}
                    print(f"{n}: {msg}"); return None
                rng.append(f"archive_new_date{op}?"); rprm.append(d)
        if len(rprm)==2 and rprm[0]>=rprm[1]:
            msg=f"{archive_from} n'est pas antérieure à {archive_to}"
            if as_json: return {'error':msg}
            print(f"{n}: {msg}"); return None
        rsql=''.join(' AND '+c for c in rng)
        stored_prefix=(conn.codec.path.encode(prefix) if conn.codec else prefix) if prefix else ''
        skip=len(stored_prefix)+1 if stored_prefix else 0
        usql,uprm,_=_psel_under(conn,prefix)
        rest=f"substr(path,{skip+1})"
        base=f"FROM diff_index WHERE nick=?{_wh(usql)}{rsql}"
        bprm=[n]+uprm+rprm
        def _name(stored_child):
            lp=_path_decode(conn,stored_child)
            return lp[len(prefix)+1:] if prefix else lp
        own={}   # stored -> [(change_type,archive_old,archive_new,date,size_before)] (chronologique)
        for stored,ct,a_old,a_new,d,sb in conn.execute(
                f"SELECT path,change_type,archive_old,archive_new,archive_new_date,size_before {base} AND instr({rest},'/')=0 "
                "ORDER BY archive_new_date,id",bprm):
            own.setdefault(stored,[]).append((ct,a_old,a_new,d,sb))
        deep={}  # segment stocké de l'enfant -> {archive_new: date}
        for seg,a_new,d in conn.execute(
                f"SELECT substr({rest},1,instr({rest},'/')-1),archive_new,MIN(archive_new_date) {base} AND instr({rest},'/')>0 "
                "GROUP BY 1,2",bprm):
            deep.setdefault(seg,{})[a_new]=d
        row=conn.execute("SELECT archive FROM archive_snapshot_v WHERE nick=? ORDER BY archive_date DESC LIMIT 1",(n,)).fetchone()
        latest=row[0] if row else None
        def _snap(full):
            if latest is None: return None
            return conn.execute("SELECT type,mode,owner FROM archive_snapshot_v WHERE nick=? AND archive=? AND path=?",
                                (n,latest,_path_stored(conn,full))).fetchone()
        entries=[]
        for key in set(own)|{(f"{stored_prefix}/{g}" if stored_prefix else g) for g in deep}:
            name=_name(key)
            if not name: continue
            full=f"{prefix}/{name}" if prefix else name
            seg=key[skip:]
            evs=[{'type':ct,'archive':a_new,'date':(d or '')[:19]} for ct,_o,a_new,d,_s in own.get(key,[])]
            seen={e['archive'] for e in evs}
            evs+=[{'type':'modified','archive':a,'date':(d or '')[:19]} for a,d in deep.get(seg,{}).items() if a not in seen]
            evs.sort(key=lambda e:e['date'])
            last_own=own[key][-1] if key in own else None
            snap=_snap(full)
            etype=(snap[0] if snap and snap[0] else None) or (_diff_entry_type(last_own[0],last_own[4]) if last_own else None)
            is_dir=seg in deep or etype=='d'
            if is_dir and etype is None: etype='d'
            e={'name':name,'full_path':full,'genre':_TREEHIST_GENRES.get(etype,'inconnu'),
               'mode':snap[1] if snap else None,'owner':snap[2] if snap else None,'is_dir':is_dir,'events':evs}
            if last_own and last_own[0] in _DIFF_REMOVED_TYPES:
                e['deleted']=True; e['last_seen_archive']=last_own[1]
            entries.append(e)
        entries.sort(key=lambda e:e['name'])
        if as_json:
            return {'path':prefix,'archive':latest,'changes':{'from':archive_from,'to':archive_to},'entries':entries}
        from prettytable import PrettyTable
        t=PrettyTable(['nom','genre','type','archive','date']); t.align['nom']='l'; t.align['archive']='l'
        for e in entries:
            for ev in e['events']:
                t.add_row([e['name']+('/' if e['is_dir'] else ''),e['genre'],
                           ev['type']+(' (supprimé)' if e.get('deleted') and ev is e['events'][-1] else ''),ev['archive'],ev['date']])
        print(f"{n}: {prefix or '/'} — changements {archive_from or 'début'} → {archive_to or 'dernière archive'} "
              f"({len(entries)} entrée(s))")
        if entries: print(t)
        return None

    def treehist(self,nick,prefix=None,archive_from=None,archive_to=None,debug=0,as_json=False,changes=False):
        # Contenu DIRECT de <prefix> (racine si omis) uniquement — jamais le contenu d'un
        # sous-répertoire. Liste toujours tout le répertoire courant (fichiers/sous-répertoires
        # présents, même sans événement dans la plage demandée), pas seulement ce qui a changé.
        prefix=_norm_lp((prefix or '').strip())
        results={}
        for n in nick.split(','):
            db_path=self.db.get_diff_db(n)
            self.db.ensure_diff_db(db_path,create=False)
            if self.db._is_index_empty(n,db_path):
                msg=f"Index vide pour {n} — lancez : borgHelper -c Index -n {n}"
                if as_json: results[n]={'error':msg}
                else: printer(f"[ERREUR] {msg}")
                continue
            try:
                conn=_open_db(db_path,nick=n,role='read')
                if changes:  # -X (1.0.133) : seulement ce qui a changé entre -b (exclue) et -B (incluse)
                    result=self._treehist_changes(n,prefix,conn,archive_from=archive_from,archive_to=archive_to,as_json=as_json)
                else:
                    result=self._treehist_listing(n,prefix,conn,archive_from=archive_from,archive_to=archive_to,debug=debug,as_json=as_json)
                if as_json: results[n]=result
                conn.close()
            except DbCodecError as e:
                msg=_codec_fail(n,e,conn)
                if as_json: results[n]={'error':msg}
            except sqlite3.Error as e:
                if as_json: results[n]={'error':f"SQLite error ({db_path}): {e}"}
                else: printer(f"SQLite error ({db_path}): {e}")
        if as_json:
            print(json.dumps(results,ensure_ascii=False,indent=2))

    def _treefind_listing(self,n,prefix,pattern,conn,debug=0,as_json=False):
        """Recherche récursive par NOM (pas le chemin complet) sous <prefix> (racine si omis), dans
        le dernier snapshot connu. Motif minimal : '*' = n'importe quelle suite de caractères, '.'
        reste littéral ; sans '*' (ni '?'), sous-chaîne implicite (comme Search). Comparaison
        insensible à la casse (casefold — plus large que l'ASCII-only de SQLite LIKE ailleurs dans ce
        fichier, correct aussi pour les caractères accentués). Retourne une liste plate
        {name,full_path,parent,is_dir,genre,mode,owner}, triée par chemin."""
        import fnmatch
        prefix=_norm_lp(prefix)
        pat=pattern or '*'
        if '*' not in pat and '?' not in pat: pat=f'*{pat}*'
        pat_cf=pat.casefold()
        row=conn.execute("SELECT archive FROM archive_snapshot_v WHERE nick=? ORDER BY archive_date DESC LIMIT 1",(n,)).fetchone()
        if row is None:
            msg=f"aucun snapshot indexé — lancez : borgHelper -c Index -n {n}"
            return {'error':msg} if as_json else None
        latest=row[0]
        psql,pprm,_=_psel_under(conn,prefix)  # descendants stricts (racine : tout)
        rows=[(_path_decode(conn,p),t,m,o) for p,t,m,o in
              conn.execute("SELECT path,type,mode,owner FROM archive_snapshot_v WHERE nick=? AND archive=?"+_wh(psql),[n,latest]+pprm)]
        present_paths={r[0] for r in rows}   # tout chemin présent — jamais reconsidéré via diff_index,
                                              # même hors du motif recherché (priorité au snapshot courant)
        matches=[]
        for path,ftype,mode,owner in rows:
            if prefix and path==prefix: continue  # le préfixe lui-même n'est pas un résultat
            name=path.rsplit('/',1)[-1]
            if not fnmatch.fnmatchcase(name.casefold(),pat_cf): continue
            is_dir=(ftype=='d')
            genre=_TREEHIST_GENRES.get(ftype,'répertoire' if is_dir else 'inconnu (réindexer)')
            parent=path.rsplit('/',1)[0] if '/' in path else ''
            matches.append({'name':name,'full_path':path,'parent':parent,'is_dir':is_dir,
                             'genre':genre,'mode':mode,'owner':owner})
        # Chemins supprimés (diff_index), récursivement sous le préfixe — jamais archive_snapshot_v
        # (purgé selon IDX_SNAP_KEEP, pas fiable ici) : même détection "dernier événement = removed"
        # que _treehist_listing, mais sans restriction à un seul niveau de profondeur.
        # 1.0.135 : « suppression sans événement plus récent pour ce chemin » (NOT EXISTS sur idx_diff_nick_path)
        # au lieu d'un fenêtrage ROW_NUMBER() sur TOUT diff_index du périmètre — mêmes lignes (vérifié sur le jeu
        # PerfBench 250k : 12 281 lignes identiques), ~970 -> ~360 ms : seules les suppressions sont examinées,
        # chacune par une recherche indexée. Départage à date égale par id, comme le fenêtrage.
        del_rows=[(_path_decode(conn,r[0]),)+tuple(r[1:]) for r in conn.execute("""
            SELECT d.path,d.archive_old,d.archive_new,d.archive_new_date,d.size_before,d.change_type
            FROM diff_index d WHERE d.nick=?"""+_wh(_psel_under(conn,prefix,col='d.path')[0])+"""
              AND d.change_type IN ("""+','.join('?'*len(_DIFF_REMOVED_TYPES))+""")
              AND NOT EXISTS (SELECT 1 FROM diff_index e WHERE e.nick=d.nick AND e.path=d.path
                    AND (e.archive_new_date>d.archive_new_date OR (e.archive_new_date=d.archive_new_date AND e.id>d.id)))
        """,[n]+pprm+list(_DIFF_REMOVED_TYPES))]
        for path,archive_old,archive_new,archive_new_date,size_before,change_type in del_rows:
            if prefix and path==prefix: continue
            if path in present_paths: continue  # présent dans le dernier snapshot -> jamais listé deux fois
            name=path.rsplit('/',1)[-1]
            if not fnmatch.fnmatchcase(name.casefold(),pat_cf): continue
            etype=_diff_entry_type(change_type,size_before)  # type tiré de change_type (1.0.126)
            is_dir=etype=='d'
            genre=_TREEHIST_GENRES.get(etype,'inconnu')
            parent=path.rsplit('/',1)[0] if '/' in path else ''
            matches.append({'name':name,'full_path':path,'parent':parent,'is_dir':is_dir,
                             'genre':genre,'mode':None,'owner':None,
                             'deleted':True,'last_seen_archive':archive_old})
        matches.sort(key=lambda e:e['full_path'])
        if as_json:
            return {'archive':latest,'scope':prefix,'pattern':pattern or '','matches':matches}
        if not matches:
            print(f"{n}: aucun résultat pour '{pattern}' sous {prefix or '/'} (snapshot {latest})")
            return None
        from prettytable import PrettyTable
        t=PrettyTable(['nom','genre','chemin','droits','propriétaire','état'])
        t.align['nom']='l'; t.align['chemin']='l'
        for e in matches:
            etat=f"supprimé ({e['last_seen_archive']})" if e.get('deleted') else ''
            t.add_row([e['name'],e['genre'],e['full_path'],e['mode'] or '—',e['owner'] or '—',etat])
        print(f"{n}: {len(matches)} résultat(s) pour '{pattern}' sous {prefix or '/'} (snapshot {latest})")
        print(t)
        return None

