            printer(f"  {nick}: {msg}"); return
        if not as_json:
            printer(f"  {nick}: historique archive_stats disponible via -j (JSON) — destiné à l'API")
            return
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            rows=[{'archive':r[0],'archive_date':r[1],'duration':r[2],'original_size':r[3],
                   'compressed_size':r[4],'deduplicated_size':r[5],'nfiles':r[6]}
                  for r in conn.execute(
                      "SELECT archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles "
                      # Bornage (1.0.127) : la série des graphiques s'arrête à STATS_RETENTION_MONTHS (13 par
                      # défaut) — les lignes plus anciennes restent en base (Report/Historique complet en ont
                      # besoin tant que l'archive existe ; purgées au Prune réel de l'archive). Format
                      # archive_date ISO 'T' : borne au même format. Départage stable à date égale.
                      "FROM archive_stats WHERE nick=? AND (archive_date IS NULL OR "
                      f"archive_date >= strftime('%Y-%m-%dT%H:%M:%S','now','-{int(self.db._stats_retention_months(nick))} months')) "
                      "ORDER BY archive_date,archive",
                      (nick,)).fetchall()]
            conn.close()
        except DbCodecError as e:
            print(json.dumps({'error':_codec_fail(nick,e,conn)},ensure_ascii=False,indent=2)); return
        except sqlite3.Error as e:
            print(json.dumps({'error':f"SQLite error ({db_path}): {e}"},ensure_ascii=False,indent=2)); return
        # Mesures du Bkp (history.db, 1.0.139) : C/E (null si inconnues) et taille dédupliquée à la création, préférée
        # à celle d'archive_stats (borg info) quand elle existe — décision utilisateur, sorties identiques à avant.
        measures=self.db.get_archive_measures(nick)
        for r in rows:
            m=measures.get((r['archive'],r['archive_date'] or '')) or measures.get((r['archive'],None))
            if m and m['deduplicated_size'] is not None: r['deduplicated_size']=m['deduplicated_size']
            r['changed_during_backup']=m['changed_during_backup'] if m else None
            r['read_errors']=m['read_errors'] if m else None
        diff_stats=self.db._diff_stats_for_nick(nick)
        for r in rows:
            st=diff_stats.get(r['archive'])
            r['files_added']=st['added'] if st else None
            r['files_modified']=st['modified'] if st else None
            r['files_removed']=st['removed'] if st else None
        # Lignes figées (history.db.archive_chart, 1.0.140) : graphiques sur STATS_RETENTION_MONTHS même quand les
        # archives vivent moins longtemps. Archive présente : valeur vivante si non nulle, sinon figée (comptages d'une
        # paire retirée). Archive disparue (gone) : sa ligne figée, pruned=true — jamais restaurable.
        frozen=self.db.get_archive_chart(nick)
        # Correspondance exacte (archive, date) : les deux dates viennent d'archive_stats ; un nom réutilisé par une
        # nouvelle archive (autre date) n'hérite jamais des valeurs de l'ancienne, qui reste affichée à part.
        fz={(f['archive'],f['archive_date']):f for f in frozen}
        live=set()
        for r in rows:
            live.add((r['archive'],r['archive_date'] or ''))
            f=fz.get((r['archive'],r['archive_date'] or ''))
            if f:
                for k in _CHART_FIELDS:
                    if r[k] is None and f[k] is not None: r[k]=f[k]
            r['pruned']=False
        for f in frozen:
            if f['gone'] and (f['archive'],f['archive_date']) not in live:
                rows.append({'archive':f['archive'],'archive_date':f['archive_date'],'duration':f['duration'],
                             'original_size':f['original_size'],'compressed_size':f['compressed_size'],
                             'deduplicated_size':f['deduplicated_size'],'nfiles':f['nfiles'],
                             'changed_during_backup':f['changed_during_backup'],'read_errors':f['read_errors'],
                             'files_added':f['files_added'],'files_modified':f['files_modified'],
                             'files_removed':f['files_removed'],'pruned':True})
        rows.sort(key=lambda r:(r['archive_date'] is not None,r['archive_date'] or '',r['archive']))
        print(json.dumps({'borghelper_version':Version,'nick':nick,'rows':rows},ensure_ascii=False,indent=2))

    def _status_one(self,nick,debug=0):
        """État rapide d'un seul nick — 100% local (spec-status-cli-etat-rapide) : jamais d'appel
        boex()/borg, uniquement archive_stats (dernier backup), bkp_status (Bkp en cours,
        get_running_bkp_status) et priority.lock (check_priority_lock, Restore/Prune ambigu)."""
        db_path=self.db.get_diff_db(nick)
        last_backup=None
        build={'state':'complete'}   # AD-10 : base sans build_state (antérieure au chantier) = complète
        if os.path.exists(db_path) and _db_has_schema(db_path):
            conn=None
            try:
                conn=_open_db(db_path,nick=nick,role='read')
                bs=conn.execute("SELECT value FROM db_meta WHERE key=?",(_build_state_key(nick),)).fetchone()
                if bs:
                    try: build=json.loads(bs[0])
                    except ValueError: pass
                row=conn.execute(
                    "SELECT archive,archive_date FROM archive_stats WHERE nick=? ORDER BY archive_date DESC LIMIT 1",
                    (nick,)).fetchone()
                if row: last_backup={'archive':row[0],'date':row[1]}
            except DbCodecError as e:
                last_backup={'error':_codec_fail(nick,e,conn)}
            except (DbKeyError,DbModeError,DbTamperError) as e:
                # 1.0.145 (story 8 R9) : clé absente ou base en migration — bkp_running, rebuild et priority_op_running,
                # lisibles sans clé, restent renseignés.
                last_backup={'error':f"base illisible ({type(e).__name__}: {e})"}; build=None
            except sqlite3.OperationalError as e:
                if 'no such table' not in str(e): raise
            except sqlite3.Error:
                pass
            finally:
                if conn is not None: conn.close()
        # history.db (1.0.139). 1.0.154 (story 17) : au-delà du délai de /access, Bkp interrompu (bkp_stale), plus « en cours ».
        # 1.0.155 (story 18) : délai du nick (clé rc BKP_STATUS_TIMEOUT, puis variable, puis 6 h), le même que borgHelperWWW
        timeout_s=self.bkp_status_timeout(nick)
        bkp_row=self.db.get_running_bkp_status(nick,timeout_s=timeout_s)
        bkp_running=bkp_row if bkp_row and not bkp_row['stale'] else None
        bkp_stale=bkp_row if bkp_row and bkp_row['stale'] else None
        rebuild=None   # fantôme (1.0.143, AD-10) : son build_state, lu sans codec ni borg ; {'state':'partial'} s'il n'en a pas
        sp=db_path+_SHADOW_SUFFIX
        if _db_has_schema(sp):   # jamais _open_db (O_CREAT) sur un fantôme que la bascule vient de supprimer
            v=self._db_meta_value(sp,_build_state_key(nick))
            try: rebuild=json.loads(v) if v else {'state':'partial'}
            except ValueError: rebuild={'state':'partial'}
        return {
            'nick':nick,
            'last_backup':last_backup,
            'bkp_running':{'started_at':bkp_running['started_at']} if bkp_running else None,
            'bkp_stale':{'started_at':bkp_stale['started_at'],'timeout_s':timeout_s} if bkp_stale else None,
            'priority_op_running':bool(self.db.check_priority_lock(nick)),
            'build':build,
            'rebuild':rebuild,
        }

    def bkp_status_timeout(self,nick):
        """Délai (s) au-delà duquel un Bkp sans fin de ce nick est tenu pour interrompu (1.0.155, story 18) : clé rc
        BKP_STATUS_TIMEOUT du nick (section ou [DEFAULT]), sinon BORGHELPERWWW_BKP_STATUS_TIMEOUT, sinon 21600. Lu par Status
        et par borgHelperWWW (/access, watcher, alerte de retard). Nick absent ou rc illisible : variable, sinon 21600."""
        try: cfg=self.borg.cfgread(nick)
