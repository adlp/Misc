def is_external(cfg):
    """Section EXTERNAL = true : dépôt dont les archives sont créées hors borgHelper (rc-keys.md). Lecture stricte
    (_cfg_bool) : une valeur invalide (faute de frappe) arrête avec le code 2, jamais un nick interne par défaut."""
    return cfg is not None and _cfg_bool(cfg,'EXTERNAL',False)

def command_op(cmd):
    """Nature d'une commande CLI : 'bkp' | 'restore' | 'prune' | 'delete' | 'read'."""
    return _CMD_OPS.get((cmd or '').lower(),'read')

def external_ops(cfg,nick=''):
    """Opérations permises sur un nick externe : 'read' toujours ; EXTERNAL_OPS absente = read,restore ; 'bkp' et toute
    valeur inconnue ignorés (avertissement une fois par nick et par valeur)."""
    raw=cfg.get('EXTERNAL_OPS') if cfg is not None else None
    if raw is None: return {'read','restore'}
    ops={'read'}
    for x in re.split(r'[,\s]+',raw.strip().lower()):
        if not x: continue
        if x in _EXT_OPS: ops.add(x)
        elif (nick,x) not in _EXT_OPS_WARNED:
            _EXT_OPS_WARNED.add((nick,x))
            printer(f"[WARN] {nick}: EXTERNAL_OPS : {x!r} ignoré"+(" (Bkp jamais permis sur un dépôt externe)" if x=='bkp'
                    else f" (valeurs : {', '.join(_EXT_OPS)})"))
    return ops

def op_allowed(cfg,op,nick=''):
    """Autorité unique (AD-12) : l'opération op est-elle permise sur ce nick ? Nick interne : toujours ; externe :
    jamais 'bkp', sinon selon external_ops. borgHelperWWW importe cette fonction (story 7)."""
    if not is_external(cfg): return True
    if op=='bkp': return False
    return op in external_ops(cfg,nick)

ALL_OPS=('read','restore','prune','delete','bkp')   # natures d'opération, dans l'ordre d'affichage (1.0.144)

def allowed_ops(cfg,nick=''):
