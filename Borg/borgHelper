            entry_count INTEGER DEFAULT 0,
            indexed_at  TEXT DEFAULT (datetime('now')),
            UNIQUE(nick, archive_old, archive_new)
        );
        CREATE INDEX IF NOT EXISTS idx_pairs_nick ON diff_indexed_pairs(nick);
        CREATE TABLE IF NOT EXISTS snapshot_file (
            id    INTEGER PRIMARY KEY AUTOINCREMENT,
            nick  TEXT NOT NULL,
            path  TEXT NOT NULL,
            size  INTEGER,
            mtime TEXT,
            UNIQUE(nick, path)
        );
        CREATE INDEX IF NOT EXISTS idx_snapfile_nick_path ON snapshot_file(nick, path);
        CREATE TABLE IF NOT EXISTS archive_snapshot_indexed (
            nick        TEXT NOT NULL,
            archive     TEXT NOT NULL,
            entry_count INTEGER DEFAULT 0,
            indexed_at  TEXT DEFAULT (datetime('now')),
            UNIQUE(nick, archive)
        );
        CREATE TABLE IF NOT EXISTS archive_stats (
            nick               TEXT NOT NULL,
            archive            TEXT NOT NULL,
            archive_date       TEXT,
            duration           REAL,
            original_size      INTEGER,
            compressed_size    INTEGER,
            deduplicated_size  INTEGER,
            nfiles             INTEGER,
            PRIMARY KEY (nick, archive)
        );
        CREATE INDEX IF NOT EXISTS idx_astats_nick ON archive_stats(nick);
    """)
    cols=[r[1] for r in conn.execute("PRAGMA table_info(archive_snapshot)").fetchall()]
    if 'path' in cols:
        _migrate_archive_snapshot(conn)
    else:
        conn.executescript("""
            CREATE TABLE IF NOT EXISTS archive_snapshot (
                nick         TEXT NOT NULL,
                archive      TEXT NOT NULL,
                archive_date TEXT,
                file_id      INTEGER NOT NULL,
                PRIMARY KEY (nick, archive, file_id)
            );
            CREATE INDEX IF NOT EXISTS idx_snap_nick_archive ON archive_snapshot(nick, archive);
        """)
    conn.executescript("""
        DROP VIEW IF EXISTS archive_snapshot_v;
        CREATE VIEW archive_snapshot_v AS
            SELECT s.nick, s.archive, s.archive_date, sf.path, sf.size, sf.mtime
            FROM archive_snapshot s
            JOIN snapshot_file sf ON sf.id=s.file_id;
    """)
    conn.commit()
