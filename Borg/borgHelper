    def bkp_running(self,nick,timeout_s,db_path=None):
        """True si un Bkp de ce nick est en cours : ligne bkp_status ouverte du nick (_BKP_OPEN_WHERE), démarrée depuis
        moins de timeout_s secondes (au-delà : bloquée, traitée en échec par le watcher, AD-7).
        Jamais de création de base (AD-12). Lecture impossible : False (voir bkp_running_state)."""
        return self.bkp_running_state(nick,timeout_s,db_path) is True

    def bkp_running_state(self,nick,timeout_s,db_path=None):
        """Comme bkp_running, à trois états (1.0.145, story 8 R3) : True (Bkp en cours depuis moins de timeout_s),
        False (aucun, ou bloqué au-delà : traité en échec par le watcher), None (lecture impossible — jamais
        confondue avec une fin de Bkp). history.db absente : False. Jamais de création de base (AD-12).
        1.0.155 (story 18, A18) : ligne ouverte au sens de _BKP_OPEN_WHERE (effacée par un Bkp plus récent réussi, comme
        Status) — un Bkp tué suivi d'un Bkp réussi n'est plus « en cours » jusqu'au délai, un Bkp vivant suivi d'un Bkp en
        échec l'est toujours ; timeout_s validé (_bkp_timeout_parse : < 1 s ou invalide -> 21600, plafond 10 ans)."""
        try:
            db_path=self._hist(nick,db_path)
            if db_path is None: return False
            conn=_open_db(db_path,nick=None,role='read')
            try:
                return conn.execute(f"SELECT 1 FROM bkp_status b WHERE {_BKP_OPEN_WHERE} "
                    "AND b.started_at >= datetime('now',?) LIMIT 1",(nick,f"-{_bkp_status_timeout(timeout_s)} seconds")).fetchone() is not None
            finally: conn.close()
        except (sqlite3.Error,OSError,DbKeyError,DbModeError,DbTamperError,DbCodecError,SchemaVersionError): return None

