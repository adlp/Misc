        def _duidx_spec():
            """_duidx_group_spec (1.0.125) : 'foo/*' et '*' inchangés (match None) ; suffixe après le dernier
            '/*' honoré ; '*'/'?' ne franchissent pas '/' ; autres caractères littéraux (%, _, ., [)."""
