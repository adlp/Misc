cfgfile=os.path.expanduser("~/.borghelperrc")
_cache_dir=None
_db_prefix=None

def _db_name_from_cfg(path):
    base=os.path.basename(os.path.abspath(path)).lstrip('.')
    return re.sub(r'[^a-zA-Z0-9_-]','_',base)

def init_db_paths():
    global _cache_dir,_db_prefix
    cp=configparser.ConfigParser()
    if os.path.exists(cfgfile):
        cp.read(cfgfile)
    _cache_dir=os.path.expanduser(cp.defaults().get('cache_dir','~/.cache/borghelper'))
    os.makedirs(_cache_dir,exist_ok=True)
    _db_prefix=_db_name_from_cfg(cfgfile)

def get_db_nick(nick):
    cfg=cfgread(nick)
    if cfg is not None and 'DB_NAME' in cfg:
        return re.sub(r'[^a-zA-Z0-9_-]','_',cfg['DB_NAME'])
    return nick

def get_cache_db(nick):
    return os.path.join(_cache_dir,f"{_db_prefix}-{get_db_nick(nick)}-cache.db")

def get_diff_db(nick):
    return os.path.join(_cache_dir,f"{_db_prefix}-{get_db_nick(nick)}-diff.db")

