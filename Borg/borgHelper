        return _bkp_status_timeout(cfg=cfg,nick=nick)

    def _status_print_one(self,st):
        printer(f"{st['nick']}:")
        if st.get('error'):
            printer(f"  Erreur : {st['error']}")
            return
        lb=st['last_backup']
        if lb and 'error' in lb:
            printer(f"  Dernier backup : {lb['error']}")
        elif lb:
            try: age=_age_readable(d2DateNSince(lb['date'])['since'])
            except (ValueError,TypeError): age=''
            printer(f"  Dernier backup : {lb['archive']} ({lb['date']}) {age}".rstrip())
        else:
            printer("  Dernier backup : aucune archive indexée")
        if st['bkp_running']:
            try: readable=_bkp_running_readable(st['bkp_running']['started_at'])
            except (ValueError,TypeError): readable=st['bkp_running']['started_at']
            printer(f"  Bkp en cours depuis {readable}")
        elif st.get('bkp_stale'):
            try: readable=_bkp_running_readable(st['bkp_stale']['started_at'])
            except (ValueError,TypeError): readable=st['bkp_stale']['started_at']
            t=st['bkp_stale'].get('timeout_s') or _bkp_status_timeout()
            printer(f"  Bkp sans fin depuis {readable} — probablement interrompu "
                    f"(délai {f'{t//3600} h' if t%3600==0 else f'{t} s'} dépassé)")
        if st['priority_op_running'] and not st['bkp_running']:
            # Ambiguïté assumée (Boundaries spec-status-cli-etat-rapide) : les fichiers priority.lock ne disent
            # pas quelle opération (Restore, Prune ou DelBkp) les tient. Affiché seulement si aucun Bkp détecté (sinon redondant : le Bkp
            # lui-même tient ce lock).
            printer("  Opération prioritaire en cours (Bkp peut-être toujours actif, Restore, Prune ou DelBkp)" if st.get('bkp_stale')
                    else "  Opération prioritaire en cours (Restore, Prune ou DelBkp)")
        b=st.get('build') or {}
        if b.get('state')=='partial':
            extra=''
            if b.get('stats_done') is not None: extra+=f", statistiques {b['stats_done']}/{b.get('archives_total')}"
            if b.get('snapshot') is False: extra+=", snapshot à faire"
            printer(f"  Construction partielle : {b.get('pairs_done')}/{b.get('pairs_total')} paires{extra} (Index par tranches)")
        rb=st.get('rebuild')
        if rb:
            if rb.get('pairs_total') is None: printer("  Reconstruction (fantôme) : démarrée")
            else:
                done='prête à basculer' if rb.get('state')=='complete' else 'en cours'
                printer(f"  Reconstruction (fantôme) {done} : {rb.get('pairs_done')}/{rb.get('pairs_total')} paires, "
                        f"statistiques {rb.get('stats_done')}/{rb.get('archives_total')}")

    def status(self,nick,debug=0,as_json=False):
        """Commande CLI Status (spec-status-cli-etat-rapide) : état rapide (dernier backup connu, Bkp
        en cours, opération prioritaire Restore/Prune ambiguë) par nick, 100% local — jamais d'appel
        boex()/borg (contrairement à getlastbkp/list_backups). Supporte -n nick1,nick2 et ALL nativement
        (contrairement à RepoHistory/ArchiveHistory qui rejettent le multi-nick)."""
        nicks=nick.split(',') if nick and nick!='ALL' else self.borg.cfgreadnicks(debug).split(',')
        nicks=[n for n in nicks if n]
        results=[]
        for n in nicks:
            try:
                results.append(self._status_one(n,debug=debug))
            except Exception as e:
                # Isolation par nick : une anomalie sur UN nick (base chiffrée sans passphrase, base
                # 'migrating' AD-11, erreur SQLite non prévue…) ne doit jamais faire échouer tout
                # l'appel -n ALL/multi-nick — c'est précisément le cas d'usage principal de Status.
                results.append({'nick':n,'last_backup':None,'bkp_running':None,'bkp_stale':None,
                                 'priority_op_running':False,'build':None,'rebuild':None,'error':str(e)})
        if as_json:
            # Toujours une liste (même à un seul nick) : Status supporte nativement ALL/multi-nick,
            # forme homogène pour les consommateurs machine (contrairement à RepoHistory/ArchiveHistory
            # qui rejettent le multi-nick et renvoient donc un objet unique).
            print(json.dumps(results,ensure_ascii=False,indent=2))
            return
        for st in results: self._status_print_one(st)

    # ── Nettoyage des restes de dépôts disparus et de nicks retirés (1.0.160, story 23, A30) ──
    def cleanup_scan(self,home=None):
        """Lecture seule, jamais borg. borg : _borg_leftovers du dossier personnel (pwd par défaut : celui qu'utilise
        borg lancé par boex, sans HOME) contre les BORG_REPO du rc — dépôts disparus, et (1.0.161) anciens dépôts recréés
        au même chemin (autre identifiant dans <dépôt>/config). borgHelper : fichiers de CACHE_DIR au préfixe du rc,
        de forme connue (_BH_ORPHAN_RE), qu'AUCUN nick actuel ne produit (base par nick ou DB_NAME, index-last par nick,
        verrous par dépôt : dépôts et DB_NAME partagés gardés) ; verrou tenu par un processus vivant jamais proposé.
        BORGHELPERC_CLEANUP_HOME (env) : autre dossier à scruter (le selftest y met un dossier vide : jamais les vraies
        entrées de l'utilisateur). Rend {'borg':[…], 'bh':[{'path','size','kind':'history'|'regen'}]}."""
        import pwd
        home=home or os.environ.get('BORGHELPERC_CLEANUP_HOME') or pwd.getpwuid(os.getuid()).pw_dir
        try: nicks=[n for n in (self.borg.cfgreadnicks(0) or '').split(',') if n]
        except (Exception,SystemExit): nicks=[]
        if not nicks: return {'borg':[],'bh':[]}   # rc vide ou illisible : rien proposé sur un doute
        repos=set(); stems=set()
        for n in nicks:
            try:
                r=((self.borg.cfgread(n) or {}).get('BORG_REPO') or '').strip()
                if r.startswith('file://'): r=r[len('file://'):]
                if r and ('://' not in r) and not re.match(r'^[^/]+@[^/]+:',r) and not re.match(r'^[^/]+:[^/]',r):
                    r=os.path.abspath(os.path.expanduser(r))   # ~ ou relatif : chemin local
                if r.startswith('/'): repos.update({os.path.normpath(r),os.path.realpath(r)})
                stems.update({self.db.get_db_nick(n),re.sub(r'[^a-zA-Z0-9_-]','_',n),self.db._repo_key(n)})
            except (Exception,SystemExit): return {'borg':[],'bh':[]}   # rc illisible : rien proposé sur un doute
        borg=_borg_leftovers(home,repos)
        bh=[]; pre=self.db.db_prefix+'-'
        try: names=sorted(os.listdir(self.db.cache_dir))
        except OSError: names=[]
        cand=[]; busy=set()
        for f in names:
            fp=os.path.join(self.db.cache_dir,f)
            m=_BH_ORPHAN_RE.search(f[len(pre)-1:]) if f.startswith(pre) else None
            if not m or m.start()==0 or not os.path.isfile(fp) or os.path.islink(fp): continue
            stem=f[len(pre):len(pre)-1+m.start()]   # tronc exact : 'web' ne protège pas 'web-old'
            if stem in stems: continue
            if '.lock' in f and self._cleanup_lock_alive(fp): busy.add(stem); continue
            cand.append((stem,fp,f))
        for stem,fp,f in cand:
            if stem in busy: continue   # un verrou vivant de ce tronc : aucun de ses fichiers (processus en cours)
            bh.append({'path':fp,'size':_dir_size(fp),'kind':'history' if '-history.db' in f else 'regen'})
        return {'borg':borg,'bh':bh}

    def _cleanup_lock_alive(self,fp):
        """Porteur vivant (ou fichier illisible) : jamais proposé, et son tronc protégé."""
        try: return self.db._lock_holder(fp) in ('alive','me')
        except (Exception,SystemExit): return True

    @staticmethod
    def _cleanup_kept_key(x):
        """Entrée borg réduite à sa clé gardée et à l'élément qui porte l'emplacement (après -y sans --keys) : hors notice
        (choix de l'utilisateur), toujours dans l'aperçu de BorgCleanup. 1.0.161 : dépôt non chiffré réduit à son entrée de
        sécurité (gardée comme une clé) : idem."""
        if not (x['keys'] or x.get('plain')) or x['paths']!=[x['anchor']]: return False
        if os.sep+'.config'+os.sep in x['anchor']: return True
        try: return set(os.listdir(x['anchor']))<={'config'}
        except OSError: return False

    @staticmethod
    def cleanup_summary(scan):
        """Nombres et tailles seulement (jamais de chemin) : notice, /access. Entrées réduites à une clé gardée : à part.
        1.0.161 : anciens dépôts recréés au même chemin hors notice (disques en rotation, choix de l'utilisateur) :
        `recreated` seulement."""
        b=[x for x in scan.get('borg',[]) if not BorgHelper._cleanup_kept_key(x) and not x.get('recreated')]; h=scan.get('bh',[])
        reg=[x for x in h if x['kind']!='history']; his=[x for x in h if x['kind']=='history']
        return {'borg_entries':len(b),'borg_size':sum(x['size'] for x in b),
                'keys':sum(len(x['keys']) for x in b),'keys_size':sum(x['key_size'] for x in b),
                'bh_files':len(reg),'bh_size':sum(x['size'] for x in reg),
                'history':len(his),'history_size':sum(x['size'] for x in his),
                'kept_keys':sum(len(x['keys']) for x in scan.get('borg',[]) if BorgHelper._cleanup_kept_key(x)),
                'recreated':sum(1 for x in scan.get('borg',[]) if x.get('recreated'))}

    def cleanup_notice(self,home=None):
        """Une ligne pour la fin de Status et de Report (texte, CLI), ou None — jamais d'exception. Jamais pour un appel
        lancé par borgHelperWWW (BORGHELPERC_NO_CLEANUP_NOTICE) : l'état de la machine n'y passe que par /access, réservé
        aux admins quand les groupes sont actifs."""
        if os.environ.get('BORGHELPERC_NO_CLEANUP_NOTICE'): return None
        try: s=self.cleanup_summary(self.cleanup_scan(home))
        except (Exception,SystemExit): return None
        parts=[]
        if s['borg_entries']: parts.append(f"{s['borg_entries']} entrée(s) borg de dépôts disparus ({convert_octets_readable(s['borg_size'])})")
        if s['keys']: parts.append(f"{s['keys']} clé(s) borg de ces dépôts")
        if s['bh_files']: parts.append(f"{s['bh_files']} fichier(s) borgHelper de nicks retirés ({convert_octets_readable(s['bh_size'])})")
        if s['history']: parts.append(f"{s['history']} historique(s) mesuré(s) de nicks retirés")
        return ("Nettoyage possible : "+", ".join(parts)+" — aperçu : borgHelper -c BorgCleanup") if parts else None

    @staticmethod
    def _cleanup_ask(prompt,want):
        """Confirmation lue sur l'entrée standard (décision de l'utilisateur, story 23) : 'o' -> o/oui/y/yes ; 'oui' ->
        le mot « oui » exactement. Fin de l'entrée (cron, script sans réponse) : refus."""
        sys.stderr.write(prompt); sys.stderr.flush()
        try: ans=sys.stdin.readline() if sys.stdin else ''
        except (OSError,ValueError): ans=''
        a=ans.strip().lower()
        return a=='oui' if want=='oui' else a in ('o','oui','y','yes')

    def borg_cleanup(self,confirm=False,keys=False,history=False,home=None,ask=None):
        """Commande CLI BorgCleanup : aperçu par défaut (1.0.161 : anciens dépôts recréés au même chemin listés à part, leur
        identifiant relu avant suppression) ; -y retire les entrées borg (sécurité, cache) et les fichiers
        borgHelper régénérables ; --keys (avec -y) les clés borg — irréversible ; --history (avec -y) les history.db.
        Avec -y : confirmation sur l'entrée standard (« o »), puis, pour les clés et historiques, le mot « oui » ;
        refus ou fin de l'entrée -> code 2, rien supprimé. `ask(prompt,want)` : autre source de réponse (tests).
        Jamais depuis borgHelperWWW. Emplacement et verrous revérifiés juste avant de supprimer. Code 1 si une
        suppression échoue."""
        scan=self.cleanup_scan(home); b=scan['borg']; h=scan['bh']
        if not b and not h:
            printer("Rien à nettoyer : aucune entrée borg de dépôt local disparu, aucun fichier borgHelper de nick retiré."); return 0
        gone=[x for x in b if not x.get('recreated')]; again=[x for x in b if x.get('recreated')]
        for title,part in (("Entrées borg de dépôts locaux disparus (hors rc) :",gone),
                           ("Entrées borg d'anciens dépôts recréés au même chemin (autre identifiant — disque en rotation ? "
                            "borg recrée seul l'entrée et le cache d'un dépôt qui revient) :",again)):
            if not part: continue
            printer(title)
            for x in part:
                printer(f"  {x['location']}  ({convert_octets_readable(x['size'])})"
                        +(f"  ancien id {x['id'][:12]}…, actuel {x['current_id'][:12]}…" if x.get('recreated') else ""))
                for q in x['paths']: printer(f"    {q}")
                if x.get('plain'):
                    printer("    ⚠ dépôt non chiffré : sans cette entrée de sécurité, borg sans terminal (cron) refuse ce dépôt s'il"
                            " existe encore — retirée seulement avec --keys ; -y ne retire que son cache")
                for k in x['keys']:
                    printer(f"    ⚠ clé {k} — suppression irréversible (dépôt illisible s'il existe encore ailleurs"
                            +(", par exemple sur un disque en rotation monté à ce chemin" if x.get('recreated') else "")
                            +") : --keys ; sans --keys, l'entrée qui porte l'emplacement est gardée avec elle")
        if h:
            printer("Fichiers borgHelper de nicks absents du rc :")
            for x in h:
                printer(f"  {x['path']}  ({convert_octets_readable(x['size'])})"
                        +("  ⚠ historique mesuré, non régénérable : --history" if x['kind']=='history' else ""))
        if not confirm:
            printer("Aperçu seulement. -y : retire les entrées borg (sécurité, cache) et les fichiers régénérables ; "
                    "-y --keys : aussi les clés ; -y --history : aussi les historiques mesurés.")
            return 0
        ask=ask or self._cleanup_ask
        nk=sum(len(x['keys']) for x in b) if keys else 0; nh=sum(1 for x in h if x['kind']=='history') if history else 0
        np_=sum(1 for x in b if x.get('plain')) if keys else 0
        nr=len(b)+sum(1 for x in h if x['kind']!='history')
        if not ask(f"Supprimer {nr} élément(s) régénérable(s) (entrées borg, caches, fichiers borgHelper) ? [o/N] ",'o'):
            printer("Rien supprimé (non confirmé)."); return 2
        if (nk or nh or np_) and not ask(f"⚠ Perte définitive : {nk} clé(s) borg, {np_} entrée(s) de dépôt non chiffré, {nh} historique(s)"
                                         " mesuré(s). Taper « oui » pour confirmer : ",'oui'):
            printer("Rien supprimé (perte définitive non confirmée)."); return 2
        done=errs=0
        def _rm(q):
            nonlocal done,errs
            try:
                if os.path.isdir(q) and not os.path.islink(q): shutil.rmtree(q)
                else: os.unlink(q)
                done+=1
            except FileNotFoundError: pass
            except OSError as e: errs+=1; printer(f"  [ERREUR] {q} : {e}")
        for x in b:
            if x.get('recreated'):   # 1.0.161 : identifiant relu — disque remis, config illisible ou dépôt parti : gardé
                cur=_repo_current_id(x['location'])
                if cur is None or cur==x['id']: printer(f"  {x['location']} : ancien dépôt remis, dépôt parti ou identifiant illisible — gardé"); continue
            elif not _local_absent(x['location']): printer(f"  {x['location']} est réapparu — gardé"); continue
            keep_anchor=bool(x['keys'] or x.get('plain')) and not keys   # clé gardée : son emplacement aussi ; non chiffré : l'entrée
            for q in x['paths']:
                if keep_anchor and q==x['anchor']:
                    if os.sep+'.cache'+os.sep in q and os.path.isdir(q):   # cache seul : garder son config (emplacement)
                        for e in os.listdir(q):
                            if e!='config': _rm(os.path.join(q,e))
                    continue
                _rm(q)
            if keys:
                for k in x['keys']: _rm(k)
        for x in h:
            if '.lock' in x['path'] and self._cleanup_lock_alive(x['path']):
                printer(f"  {x['path']} : verrou repris entre-temps — gardé"); continue
            if x['kind']!='history' or history: _rm(x['path'])
        kept=([f"{sum(len(x['keys']) for x in b)} clé(s)"] if not keys and any(x['keys'] for x in b) else [])+\
             ([f"{sum(1 for x in b if x.get('plain'))} entrée(s) de dépôt non chiffré"] if not keys and any(x.get('plain') for x in b) else [])+\
             ([f"{sum(1 for x in h if x['kind']=='history')} historique(s)"] if not history and any(x['kind']=='history' for x in h) else [])
        printer(f"{done} élément(s) retiré(s)"+(f", {errs} en échec" if errs else "")+(f" ; gardés : {', '.join(kept)}" if kept else "")
                +" — relancer borgHelper -c BorgCleanup pour l'aperçu")
        return 1 if errs else 0

    def difftop(self,nick,bkp=None,depth=3,topn=10,debug=0,as_json=False):
        from collections import defaultdict
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            if as_json: print(json.dumps({'error':f"diff.db absent pour {nick}"},ensure_ascii=False,indent=2)); return
            printer(f"  {nick}: diff.db absent — lancez borgHelper -c Index -n {nick}"); return
        if bkp:
            parts=bkp.split(',')
            if len(parts)==2: arch_old,arch_new=parts[0].strip(),parts[1].strip()
            else:
                if as_json: print(json.dumps({'error':"-b attend 'archive-old,archive-new'"},ensure_ascii=False,indent=2)); return
                printer(f"  {nick}: -b attend 'archive-old,archive-new'"); return
        else:
            conn=None
            try:
                conn=_open_db(db_path,nick=nick,role='read',timeout=60)
                row=conn.execute(
                    "SELECT archive_old,archive_new FROM diff_indexed_pairs WHERE nick=? ORDER BY indexed_at DESC LIMIT 1",
                    (nick,)).fetchone()
                conn.close()
            except sqlite3.Error as e:
                _close_quiet(conn)
                if as_json: print(json.dumps({'error':f"SQLite error ({db_path}): {e}"},ensure_ascii=False,indent=2)); return
                printer(f"  SQLite error ({db_path}): {e}"); return
            if not row:
                if as_json: print(json.dumps({'error':f"aucune paire indexée pour {nick}"},ensure_ascii=False,indent=2)); return
                printer(f"  {nick}: aucune paire indexée — lancez borgHelper -c Index -n {nick}"); return
            arch_old,arch_new=row
        if as_json:
            # Story 1.4 : mode brut par-chemin (jamais groupé/top-N — borgHelperWWW s'en charge après
            # filtrage par périmètre), même paire d'archives que le mode texte ci-dessous.
            rows=[]
            conn=None
            try:
                conn=_open_db(db_path,nick=nick,role='read',timeout=60)
                cur=conn.execute(
                    "SELECT path,change_type,size_before,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",
                    (nick,arch_old,arch_new))
                while True:
                    batch=cur.fetchmany(50000)
                    if not batch: break
                    for path,ct,sb,sa in batch:
                        rows.append({'chemin':_path_decode(conn,path),'type':ct,'taille_avant':sb or 0,'taille_apres':sa or 0})
                conn.close()
            except DbCodecError as e:
                print(json.dumps({'error':_codec_fail(nick,e,conn)},ensure_ascii=False,indent=2)); return
            except sqlite3.Error as e:
                _close_quiet(conn)
                print(json.dumps({'error':f"SQLite error ({db_path}): {e}"},ensure_ascii=False,indent=2)); return
            print(json.dumps({'borghelper_version':Version,'nick':nick,'archive_old':arch_old,'archive_new':arch_new,
                               'rows':rows},ensure_ascii=False,indent=2))
            return
        def get_prefix(path,d):
            if not path: return '(vide)'
            leading='/' if path[0]=='/' else ''
            parts=[p for p in path.split('/') if p]
            if len(parts)<=d: return path
            return leading+'/'.join(parts[:d])
        stats=defaultdict(lambda:{'total':0,'added_n':0,'added_s':0,'removed_n':0,'removed_s':0,'modified_n':0,'size':0})
        total_count=0; total_size=0; file_added=0; file_modified=0
        conn=None
        try:
            conn=_open_db(db_path,nick=nick,role='read',timeout=60)
            cur=conn.execute(
                "SELECT path,change_type,size_before,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",
                (nick,arch_old,arch_new))
            while True:
                rows=cur.fetchmany(50000)
                if not rows: break
                for path,ct,sb,sa in rows:
                    pfx=get_prefix(_path_decode(conn,path),depth)
                    s=stats[pfx]
                    s['total']+=1
                    sz=(sa or sb or 0)
                    s['size']+=sz
                    if ct in _DIFF_ADDED_TYPES:     s['added_n']+=1;   s['added_s']+=(sa or 0)
                    elif ct in _DIFF_REMOVED_TYPES: s['removed_n']+=1; s['removed_s']+=(sb or 0)
                    else:              s['modified_n']+=1
                    # « Inchangés » (1.0.156, story 19) : nfiles de borg ne compte que les fichiers ordinaires — seuls les
                    # types exacts added/modified (fichiers) sont retranchés, comme IdxTop ; pas les répertoires, liens,
                    # ni les entrées ctime/mtime d'un répertoire dont le contenu change.
                    if ct=='added': file_added+=1
                    elif ct=='modified': file_modified+=1
                    total_count+=1; total_size+=sz
            conn.close()
        except DbCodecError as e:
            _codec_fail(nick,e,conn); return
        except sqlite3.Error as e:
            _close_quiet(conn)
            printer(f"  SQLite error ({db_path}): {e}"); return
        conn3=None
        try:
            conn3=_open_db(db_path,nick=nick,role='read',timeout=60)
            exclu_rows3=conn3.execute("SELECT change_type,SUM(file_count),SUM(total_size) FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=? GROUP BY change_type",(nick,arch_old,arch_new)).fetchall()
            nfiles_row=conn3.execute("SELECT nfiles FROM archive_stats WHERE nick=? AND archive=?",(nick,arch_new)).fetchone()
            conn3.close()
            exclu_by_ct3={r[0]:(r[1] or 0,r[2] or 0) for r in exclu_rows3}
            exclu_n=sum(v[0] for v in exclu_by_ct3.values()); exclu_sz=sum(v[1] for v in exclu_by_ct3.values())
            nfiles_new=nfiles_row[0] if nfiles_row and nfiles_row[0] else None
        except sqlite3.Error:
            _close_quiet(conn3); exclu_by_ct3={}; exclu_n=0; exclu_sz=0; nfiles_new=None
        if not total_count and not exclu_n:   # 1.0.154 : paire vidée par IdxPurge -> ses exclus restent affichés
            printer(f"  {nick}: aucune entrée pour cette paire ({arch_old} → {arch_new})"); return
        top=sorted(stats.items(),key=lambda x:x[1]['total'],reverse=True)[:topn]
        from prettytable import PrettyTable
        t=PrettyTable()
        t.field_names=['arborescence','total','+nb','+taille','-nb','-taille','=nb','taille']
        for f in t.field_names: t.align[f]='r'
        t.align['arborescence']='l'
        for pfx,s in top:
            pct=f"{100*s['total']//total_count}%"
            t.add_row([
                pfx,
                f"{s['total']:,} ({pct})",
                f"{s['added_n']:,}" if s['added_n'] else '—',
                convert_octets_readable(s['added_s']) if s['added_s'] else '—',
                f"{s['removed_n']:,}" if s['removed_n'] else '—',
                convert_octets_readable(s['removed_s']) if s['removed_s'] else '—',
                f"{s['modified_n']:,}" if s['modified_n'] else '—',
                convert_octets_readable(s['size']),
            ])
        printer(f"\n{nick} — top {topn} par changements (profondeur {depth})")
        printer(f"  {arch_old}")
        printer(f"→ {arch_new}")
        added_total=file_added+exclu_by_ct3.get('added',(0,0))[0]
        modified_total=file_modified+exclu_by_ct3.get('modified',(0,0))[0]
        unchanged=max(0,nfiles_new-added_total-modified_total) if nfiles_new is not None else None
        printer(f"Indexés : {total_count:,} changements · {convert_octets_readable(total_size)}")
        if exclu_n:
            exclu_detail3=_exclu_detail(exclu_by_ct3)
            printer(f"Exclus  : {exclu_n:,} entrées · {convert_octets_readable(exclu_sz)} (IDX_* / IdxPurge) — {exclu_detail3}")
        if unchanged is not None:
            pct_unch=f" ({100*unchanged//nfiles_new}%)" if nfiles_new>0 else ""
            printer(f"Inchangés: {unchanged:,}{pct_unch} sur {nfiles_new:,} fichiers dans {arch_new}")
        if total_count: printer(str(t))

    def _snapurge_check(self,nick,conn,keep):
        archives=sorted([r[0] for r in conn.execute(
            "SELECT archive FROM archive_snapshot_indexed WHERE nick=?",(nick,))])
        total=len(archives)
        if total<=keep: return [],0
        to_delete=archives[:total-keep]
        ph=','.join('?'*len(to_delete))
        count=conn.execute(
            f"SELECT COUNT(*) FROM archive_snapshot WHERE nick=? AND archive IN ({ph})",
            [nick]+to_delete).fetchone()[0]
        return to_delete,count

    def _snapurge_exec(self,nick,conn,to_delete):
        ph=','.join('?'*len(to_delete))
        conn.execute(f"DELETE FROM archive_snapshot WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        conn.execute(f"DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        conn.execute(f"DELETE FROM snap_excluded_stats WHERE nick=? AND archive IN ({ph})",[nick]+to_delete)
        self.db._cleanup_snapshot_file_orphans(nick,conn)

    def idxpurge(self,nick,pattern=None,dryrun=False,debug=0,db_path=None):
        if db_path is None: db_path=self.db.get_diff_db(nick)   # db_path : fantôme avant bascule (1.0.143)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent"); return
        cfg=self.borg.cfgread(nick)
        keep_snap=int(cfg.get('IDX_SNAP_KEEP',
            sum(int(cfg.get(k,0)) for k in ['KEEP_DAILY','KEEP_WEEKLY','KEEP_MONTHLY','KEEP_YEARLY','KEEP_HOURLY'])
            or 10))
        includes=excludes=[]
        if pattern is None:
            includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
            excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
            if includes: printer(f"  {nick}: IDX_INCLUDE : {' '.join(includes)}")
            if excludes: printer(f"  {nick}: IDX_EXCLUDE : {' '.join(excludes)}")
        def _is_glob(pat): return any(c in pat for c in '*?[')
        _norm=_norm_lp
        def _pat_cond(conn,patterns):
            # plain : GLOB en SQL ; sinon le motif est un préfixe (égalité + intervalle, jamais LIKE).
            # Un préfixe vide ne cible rien (jamais toute la base).
            parts=[]; args=[]
            for pat in patterns:
                if pat.startswith('/'):
                    parts.append("0")  # les chemins stockés n'ont jamais de '/' initial : ne cible rien (comportement historique)
                elif _is_glob(pat):
                    g,ga,_=_psel_glob(conn,pat); parts.append(g); args.extend(ga)
                elif not pat.rstrip('/'):
                    parts.append("0")
                else:
                    u,ua,_=_psel_under(conn,pat.rstrip('/'),self_too=True); parts.append(u); args.extend(ua)
            return ' OR '.join(parts),args
        def _py_match(patterns):
            # chiffré : mêmes correspondances que _pat_cond, évaluées sur le chemin logique décodé
            patterns=[pat for pat in patterns if not pat.startswith('/')]  # '/' initial : ne cible rien
            rxs=[_glob_regex(pat) for pat in patterns if _is_glob(pat)]
            bases=[b for b in (_norm(pat) for pat in patterns if not _is_glob(pat)) if b]
            return lambda p: any(r.fullmatch(p) for r in rxs) or any(p==b or p.startswith(b+'/') for b in bases)
        def _narrow(conn,patterns):
            # chiffré : sur-ensemble de lignes candidates par intervalles (SQL) ; None = tout lire
            parts=[]; args=[]
            for pat in patterns:
                if pat.startswith('/'): continue
                if _is_glob(pat):
                    head=pat[:min(k for k,c in enumerate(pat) if c in '*?[')]
                    d=_norm(head.rsplit('/',1)[0]) if '/' in head else ''
                    if not d: return None
                    u,ua,_=_psel_under(conn,d)
                else:
                    b=_norm(pat)
                    if not b: continue
                    u,ua,_=_psel_under(conn,b,self_too=True)
                parts.append(u); args.extend(ua)
            return (' OR '.join(parts),args) if parts else ('0',[])
        try:
            conn=_open_db(db_path,nick=nick,role='write',timeout=60)
            count=0; size=0
            sql_where=None; params=None      # plain : condition SQL
            ids=None                          # chiffré : id des lignes à supprimer, choisies en Python
            has_cond=pattern is not None or bool(includes) or bool(excludes)
            if has_cond and conn.codec is None:
                if pattern is not None:
                    c_sql,c_args=_pat_cond(conn,[pattern])
                    sql_where=f"nick=? AND ({c_sql})"; params=tuple([nick]+c_args)
                elif includes and excludes:
                    inc_sql,inc_args=_pat_cond(conn,includes)
                    exc_sql,exc_args=_pat_cond(conn,excludes)
                    sql_where=f"nick=? AND (NOT ({inc_sql}) OR ({exc_sql}))"
                    params=tuple([nick]+inc_args+exc_args)
                elif includes:
                    inc_sql,inc_args=_pat_cond(conn,includes)
                    sql_where=f"nick=? AND NOT ({inc_sql})"
                    params=tuple([nick]+inc_args)
                else:
                    exc_sql,exc_args=_pat_cond(conn,excludes)
                    sql_where=f"nick=? AND ({exc_sql})"
                    params=tuple([nick]+exc_args)
            elif has_cond:
                if pattern is not None: pred=_py_match([pattern]); nar=_narrow(conn,[pattern])
                elif includes and excludes:
                    inc,exc=_py_match(includes),_py_match(excludes)
                    pred=lambda p: (not inc(p)) or exc(p); nar=None
                elif includes:
                    inc=_py_match(includes); pred=lambda p: not inc(p); nar=None
                else: pred=_py_match(excludes); nar=_narrow(conn,excludes)
                q=("SELECT id,path,COALESCE(size_after,size_before,0),archive_old,archive_new,change_type,"
                   "COALESCE(NULLIF(size_after,0),size_before,0) FROM diff_index WHERE nick=?"); qa=[nick]
                if nar is not None: q+=" AND ("+nar[0]+")"; qa+=nar[1]
                ids=[]; meta={}
                for rid,sp,sz,a_old,a_new,ct,xsz in conn.execute(q,qa):
                    if pred(_path_decode(conn,sp)):
                        ids.append(rid); size+=sz or 0; meta[rid]=(a_old,a_new,ct,xsz or 0,sp)
                count=len(ids)
            if sql_where:
                row=conn.execute(
                    f"SELECT COUNT(*),SUM(COALESCE(size_after,size_before,0)) FROM diff_index WHERE {sql_where}",
                    params).fetchone()
                count,size=row[0],row[1] or 0
            snap_del,snap_count=self._snapurge_check(nick,conn,keep_snap)
            if not count and not snap_del:
                if not has_cond and pattern is None:
                    printer(f"  {nick}: aucun IDX_INCLUDE/IDX_EXCLUDE dans la config")
                else:
                    printer(f"  {nick}: aucune entrée à purger")
                conn.close(); return
            if count:
                label=f" — '{pattern}'" if pattern is not None else ""
                printer(f"  {nick}: {count:,} entrées diff · {convert_octets_readable(size)}{label}")
            if snap_del:
                printer(f"  {nick}: {len(snap_del)} snapshot(s) ancien(s) à purger ({snap_count:,} entrées) — keep={keep_snap}")
            if dryrun:
                printer(f"  {nick}: dry-run — aucune modification")
                conn.close(); return
            if count:
                # Agrégat des exclus et DELETE sous le même verrou d'écriture (revue story 17) : un Index ou un autre IdxPurge
                # concurrent ne fait ni compter une ligne non supprimée, ni supprimer une ligne non comptée.
                conn.execute("BEGIN IMMEDIATE")
                if ids is None:   # plain : agrégat SQL, puis DELETE
                    exclu={(a_old,a_new,ct):[n,xsz or 0] for a_old,a_new,ct,n,xsz in conn.execute(
                        "SELECT archive_old,archive_new,change_type,COUNT(*),SUM(COALESCE(NULLIF(size_after,0),size_before,0)) "
                        f"FROM diff_index WHERE {sql_where} GROUP BY archive_old,archive_new,change_type",params)}
                    count=conn.execute(f"DELETE FROM diff_index WHERE {sql_where}",params).rowcount
                else:             # chiffré : suppression par id ; seules les lignes réellement supprimées comptent
                    exclu={}; count=0
                    for rid in ids:   # même ligne qu'à la sélection (un id libéré peut être réattribué entre-temps)
                        a_old,a_new,ct,xsz,sp=meta[rid]
                        if conn.execute("DELETE FROM diff_index WHERE id=? AND nick=? AND archive_old=? AND archive_new=? "
                                        "AND change_type=? AND path=?",(rid,nick,a_old,a_new,ct,sp)).rowcount:
                            count+=1
                            e=exclu.setdefault((a_old,a_new,ct),[0,0]); e[0]+=1; e[1]+=xsz
                # 1.0.154 (story 17) : les entrées retirées rejoignent les exclus de leur paire (nombre + taille par type,
                # taille comme à l'Index : size_after or size_before) — stats de Report et IdxTop inchangées, et une paire
                # vidée n'est plus « 0 entrée sans exclu » (indiscernable d'une paire vide à tort, révision de 1.0.153).
                conn.executemany(
                    "INSERT INTO diff_excluded_stats (nick,archive_old,archive_new,change_type,file_count,total_size) "
                    "VALUES (?,?,?,?,?,?) ON CONFLICT(nick,archive_old,archive_new,change_type) DO UPDATE SET "
                    "file_count=file_count+excluded.file_count,total_size=total_size+excluded.total_size",
                    [(nick,a_old,a_new,ct,n,xsz) for (a_old,a_new,ct),(n,xsz) in exclu.items()])
                conn.execute("""UPDATE diff_indexed_pairs SET entry_count=(
                    SELECT COUNT(*) FROM diff_index di
                    WHERE di.nick=diff_indexed_pairs.nick
                    AND di.archive_old=diff_indexed_pairs.archive_old
                    AND di.archive_new=diff_indexed_pairs.archive_new)
                    WHERE nick=?""",(nick,))
            if snap_del:
                self._snapurge_exec(nick,conn,snap_del)
            conn.commit(); conn.close()
            if count: printer(f"  {nick}: {count:,} entrées diff supprimées")
