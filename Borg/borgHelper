        resume['lastname']=r['archives'][c-1]['name']

    if debug > 0:
        print(json.dumps(r,indent=4))
        print(json.dumps(resume,indent=4))
        print(json.dumps(kept,indent=4))

    avail=dfRepo(nick)
    dabesi=d2DateNSince(resume['last'])

    tcmpl={}
    tcmpl[nick]={}
    #tcmpl[nick]['nom']          =cfg['SER_NAME']
    tcmpl[nick]['nom']          =nick
    tcmpl[nick]['date derniere']=dabesi["date"]
    tcmpl[nick]['depuis']       =dabesi['since']
    if not c:
        tcmpl[nick]['duree']        =-1
        tcmpl[nick]['derniere']     =0
    else:
        tcmpl[nick]['duree']        =kept[resume['lastname']]['durationM']
        tcmpl[nick]['derniere']     =kept[resume['lastname']]['deduplicated_size']
    tcmpl[nick]['moy']          =resume['moy_deduplicated_size']
    tcmpl[nick]['taille']       =resume['unique_csize']
    tcmpl[nick]['recuperable']  =resume['prunable']
    tcmpl[nick]['reste']        =avail

    tbkps={}
    tbkps['Prunable']={}
    tbkps['Prunable']['name']               ='Prunable'
    tbkps['Prunable']['original_size']      =resume['prunable_os']
    tbkps['Prunable']['compressed_size']    =resume['prunable_cs']
    tbkps['Prunable']['deduplicated_size']  =resume['prunable']
    
    cpt=0
    for i in kept.keys():
        if kept[i]['prunMe'] == 'No':
            if (maxp is None) or ((notPrunable - cpt ) <= maxp):
                tbkps[i]=kept[i]
                tbkps[i]['duration']=kept[i]['durationM']
                tbkps[i].pop('durationM')
                tbkps[i].pop('prunMe')
            cpt+=1
    tbkps['Totaux']={}
    tbkps['Totaux']['name']='Totaux'
    tbkps['Totaux']['original_size']       =resume['total_size']
    tbkps['Totaux']['compressed_size']     =resume['total_csize']
    tbkps['Totaux']['deduplicated_size']   =resume['unique_csize']

    diff_stats=_diff_stats_for_nick(nick)

    def _fmt_stats(s,nf,total_sz=0):
        na,nr,nm=s['added'],s['removed'],s['modified']
        present=max(0,nf-na-nm)
        total_prev=present+nr+nm
        present_sz=max(0,total_sz-s['added_sz']-s['modified_sz'])
        pct_n =lambda n:  f" ({100*n//total_prev}%)"  if total_prev>0 else ""
        pct_sz=lambda sz: f" ({100*sz//total_sz}%)"   if total_sz>0  else ""
        return {
            '+ajouté' :f"{na}{pct_n(na)} · {convert_octets_readable(s['added_sz'])}{pct_sz(s['added_sz'])}",
            '-supprimé':f"{nr}{pct_n(nr)} · {convert_octets_readable(s['removed_sz'])}{pct_sz(s['removed_sz'])}",
            '=présent' :f"{present}{pct_n(present)} · {convert_octets_readable(present_sz)}{pct_sz(present_sz)}",
        }

    # Stats du dernier backup dans le tableau résumé
    last_arch=resume.get('lastname','')
    s_last=diff_stats.get(last_arch) if last_arch else None
    if s_last:
        nf_last=kept.get(last_arch,{}).get('nfiles',0) or 0
        sz_last=kept.get(last_arch,{}).get('original_size',0) or 0
        for k,v in _fmt_stats(s_last,nf_last,sz_last).items():
            tcmpl[nick][k]=v
    else:
        tcmpl[nick]['+ajouté'] ='—'
        tcmpl[nick]['-supprimé']='—'
        tcmpl[nick]['=présent'] ='—'

    # Stats par backup dans le tableau détaillé
    for arch in list(tbkps.keys()):
        if 'nfiles' not in tbkps[arch]:
            continue
        s=diff_stats.get(arch)
        if s:
            nf=tbkps[arch].get('nfiles',0) or 0
            sz=tbkps[arch].get('original_size',0) or 0
            for k,v in _fmt_stats(s,nf,sz).items():
                tbkps[arch][k]=v
        else:
            tbkps[arch]['+ajouté'] ='—'
            tbkps[arch]['-supprimé']='—'
            tbkps[arch]['=présent'] ='—'

    return(tcmpl,tbkps)

def filtrer_lignes(tableau, X):
    # Convertir les clés en liste pour les indexer
    toutes_cles = list(tableau.keys())

    # Si X est supérieur au nombre total de hashes
    if X > len(toutes_cles):
        # Conserver les 2 premiers et tous les derniers
        cles_a_conserver = toutes_cles
    else:
        # Si X <= nombre total, conserver seulement les 2 premiers et les X derniers
        cles_a_conserver = toutes_cles[:2] + toutes_cles[-X:]

    # Reconstruire le hash avec les clés sélectionnées
    nouveau_hash = {cle: tableau[cle] for cle in cles_a_conserver}

    return nouveau_hash

