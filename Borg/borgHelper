def _memo_evict(memo):
    """Mémo plein : retire la MOITIÉ la plus ancienne (ordre d'insertion des dict) au lieu de tout vider
    (1.0.128). Un balayage d'une grosse base dépassait sans cesse la borne : le vidage complet jetait aussi
    les entrées chaudes (préfixes communs), recalculées aussitôt. Coût amorti : O(1) par insertion."""
    for k in list(itertools.islice(memo,len(memo)//2)): del memo[k]
