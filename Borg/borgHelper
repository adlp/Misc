    for x in colnames:
        if x in errhost: ret+=f"    <th colspan=1 style='background:#FF6161;'>{x}</td><td style='width:20px;background:#FF6161;'></th>\n"
        else: ret+=f"    <th colspan=1 style='background:#00A4E6;'>{x}</td><td style='width:20px;background:#00A4E6;'></th>\n"
    ret+="    </tr>\n"
    blue=0; listy=len(tabl.keys())
    for y in tabl.keys():
        ret+='  <tr>\n'; listy-=1; concol=0; colstyl=""
        for x in colnames:
            val=""
            if concol: colstyl='text-align:right;'
            if x in tabl[y]: val=tabl[y][x]
            if listy==0: ret+=f"    <td colspan=1 style='{colstyl}'><em>{val}</em></td><td style='width:20px;'></td>\n"
            elif val in errhost: ret+=f"    <td colspan=1 style='{colstyl}background:#FF6161;'>{val}</td><td style='width:20px;background:#FF6161;'></td>\n"
