    rb=boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
    try:
        _boex_check_stdout(rb,nick,'borg list')
    except RuntimeError as e:
        printer(f"{nick}: {e}")
        return 1
    archives=rb['stdout'][0]['archives']
    if not archives:
        printer(f"{nick}: aucune archive")
        return 0
    latest=archives[-1]
    archive_name=latest['name']
    archive_date=latest['start']
    if is_archive_snapshot_indexed(nick,archive_name,db_path):
        if not force:
            print(f"{nick}: snapshot {archive_name} déjà indexé")
            return 0
        try:
            conn=sqlite3.connect(db_path)
            conn.execute("DELETE FROM archive_snapshot WHERE nick=? AND archive=?",(nick,archive_name))
            conn.execute("DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive=?",(nick,archive_name))
            _cleanup_snapshot_file_orphans(nick,conn)
            conn.commit()
            conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error (purge snapshot): {e}")
    print(f"  {nick}: snapshot {archive_name}...",flush=True)
    rb2=boex(nick,['list','--format','{size} {isomtime} {path}{NL}',f"::{archive_name}"],debug=debug,retjson=False)
    if rb2['exitcode'] != 0:
        printer(f"borg list a échoué (code {rb2['exitcode']})")
        for i in rb2['stderr']:
            if isinstance(i,dict):
                printer(f"  [{i.get('levelname','?')}] {i.get('message',i)}")
            elif isinstance(i,str) and i.strip():
                printer(f"  {i}")
        return rb2['exitcode']
    files=[]
    for line in rb2['stdout']:
        line=line.strip()
        if not line:
            continue
        parts=line.split(' ',2)
        if len(parts)==3:
            try:
                size=int(parts[0])
            except ValueError:
                size=None
            path=parts[2]
            if _idx_path_ok(path,cfg):
                files.append({'path':path,'size':size,'mtime':parts[1]})
    store_archive_snapshot(nick,archive_name,archive_date,files,db_path)
    print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name}")
    return 0

