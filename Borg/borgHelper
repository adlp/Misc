        bh.search(nick,options['-f'],archive_from=options.get('-b',None),archive_to=options.get('-B',None),debug=debug,as_json=('-j' in options))
    elif cmd=='filehist':
        if '-f' not in options: usage(cmd)
        bh.filehist(nick,options['-f'],archive_from=options.get('-b',None),archive_to=options.get('-B',None),debug=debug,as_json=('-j' in options))
    elif cmd=='treehist':
        bh.treehist(nick,options.get('-f',None),archive_from=options.get('-b',None),archive_to=options.get('-B',None),debug=debug,as_json=('-j' in options),
                    changes=('-X' in options))
    elif cmd=='treefind':
        bh.treefind(nick,options.get('-f',None),options.get('-m',None),debug=debug,as_json=('-j' in options))
    elif cmd=='duidx':
        _du_sort=options.get('-s','chemin')
        _du_rev=_du_sort.endswith(':desc')
        _du_sort=_du_sort.replace(':asc','').replace(':desc','')
        if _du_sort not in ('chemin','added','removed','présent','present'): _du_sort='chemin'
        if _du_sort=='present': _du_sort='présent'
        bh.duidx(nick,options.get('-f',None),sort_by=_du_sort,reverse=_du_rev,
                 as_json=('-j' in options),archive_from=options.get('-b',None),
                 archive_to=options.get('-B',None),debug=debug,raw=('-R' in options))
    elif cmd=='idxtop':
        _depth=int(options.get('-p','3'))
        _topn=int(options.get('-N','20'))
        if '-j' in options and len(nick.split(','))>1:
            printer("IdxTop -j ne supporte qu'un seul nick à la fois (pas nick=a,b ni ALL avec plusieurs nicks configurés)")
            usage(cmd)
        for n in nick.split(','):
            bh.idxtop(n,depth=_depth,topn=_topn,debug=debug,as_json=('-j' in options))
    elif cmd=='repohistory':
        if '-j' in options and len(nick.split(','))>1:
            printer("RepoHistory -j ne supporte qu'un seul nick à la fois (pas nick=a,b ni ALL avec plusieurs nicks configurés)")
            usage(cmd)
        for n in nick.split(','):
