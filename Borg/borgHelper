        # altéré) : erreur de données/configuration, pas un bug — message clair, code 2, jamais de trace
        # Python ni d'événement Sentry (1.0.124 ; auparavant toutes les commandes de lecture plantaient).
        printer(f"[ERREUR] {type(e).__name__} : {e}"); sys.exit(2)
