            if 'mode' not in sf_cols:
                conn.execute("ALTER TABLE snapshot_file ADD COLUMN mode TEXT")
            if 'owner' not in sf_cols:
                conn.execute("ALTER TABLE snapshot_file ADD COLUMN owner TEXT")
            # Paliers 7/9 (bkp_status) et 6 (repo_stats) : ne s'appliquent plus qu'à une base d'avant 1.0.139, pour
            # normaliser ses tables avant de les copier dans history.db (_migrate_to_history) — ces tables ne sont
            # plus créées dans diff.db.
            bkps_cols=[r[1] for r in conn.execute("PRAGMA table_info(bkp_status)").fetchall()]
            for col in ('changed_during_backup','read_errors'):
                if bkps_cols and col not in bkps_cols: conn.execute(f"ALTER TABLE bkp_status ADD COLUMN {col} INTEGER")
            if bkps_cols and 'start_notified_at' not in bkps_cols:
                conn.execute("ALTER TABLE bkp_status ADD COLUMN start_notified_at TEXT")
                # Backfill obligatoire (revue de code) : sans lui, chaque ligne bkp_status déjà
                # existante (créée par Story 1, avant cette colonne) se retrouve start_notified_at
                # NULL -> le prochain passage watcher les traiterait TOUTES comme un "début" en
                # attente et enverrait un push pour chaque sauvegarde historique jamais enregistrée.
                # On les marque déjà notifiées (started_at comme sentinelle) : seules les lignes
                # créées après cette migration (donc réellement nouvelles) restent éligibles.
                conn.execute("UPDATE bkp_status SET start_notified_at=started_at WHERE start_notified_at IS NULL")
            cols=[r[1] for r in conn.execute("PRAGMA table_info(archive_snapshot)").fetchall()]
            if 'path' in cols:
                self._migrate_archive_snapshot(conn)
            else:
                conn.executescript("""
                    CREATE TABLE IF NOT EXISTS archive_snapshot (
                        nick         TEXT NOT NULL,
                        archive      TEXT NOT NULL,
                        archive_date TEXT,
                        file_id      INTEGER NOT NULL,
                        PRIMARY KEY (nick, archive, file_id)
                    );
                    CREATE INDEX IF NOT EXISTS idx_snap_nick_archive ON archive_snapshot(nick, archive);
                """)
            rstats_cols=[r[1] for r in conn.execute("PRAGMA table_info(repo_stats)").fetchall()]
            if rstats_cols and 'op' not in rstats_cols:
                self._migrate_repo_stats(conn)
            # Vue archive_snapshot_v : (re)créée si absente OU si sa définition diffère de celle du code
            # (1.0.131, _archive_view_state) — auparavant simple contrôle d'existence : une évolution du
            # SELECT ne s'appliquait jamais aux bases existantes. Jamais de DROP/CREATE inconditionnel
            # (Story 1.5 : avancerait le mtime, donc invaliderait à tort le cache par périmètre de
            # borgHelperWWW) : réécrite seulement en cas d'écart réel. Base d'un schéma PLUS RÉCENT que
            # ce code : jamais touchée (sa définition est la bonne, _check_set_meta lève ensuite).
            if self._archive_view_state(conn) in ('mismatch','absent'):
                self._repair_archive_view(conn)
            conn.commit()
            self._migrate_to_history(conn,db_path)   # 1.0.139 (AD-8) : AVANT _check_set_meta (version 10 = migrée)
            self._check_set_meta(conn,DIFF_DB_SCHEMA_VERSION,db_path,DIFF_DB_BASE_SCHEMA_VERSION)
            conn.commit(); conn.close()
        except sqlite3.DatabaseError as e:
            _db_schema_fail(db_path,e,"l'index")

    def ensure_history_db(self,path,create=True):
        """Schéma de history.db (1.0.139, AD-7). create=False : ne rien créer si le fichier est absent (lecteurs,
        AD-12). Mémorisé par processus. Ouverte sans nick (nick=None) : jamais de codec ni d'avertissement « base
        non chiffrée » — history.db ne porte aucun chemin et n'est jamais chiffrée."""
        if path in self._hist_ready and os.path.exists(path): return True
        if not create and not os.path.exists(path): return False
        try:
            try: conn=_open_db(path,nick=None,role='admin',timeout=60)
            except sqlite3.OperationalError as e: _db_open_fail(path,e)
            try:
                _ensure_wal(conn)
                conn.executescript(_HISTORY_SCHEMA)
                self._check_set_meta(conn,HISTORY_DB_SCHEMA_VERSION,path)
                conn.commit()
            finally: conn.close()
        except sqlite3.DatabaseError as e:
            _db_schema_fail(path,e,"historique des mesures",regenerable=False)
        self._hist_ready.add(path)
        return True

    def _migrate_to_history(self,conn,diff_path):
        """Migration automatique des mesures de diff.db vers history.db (1.0.139, AD-8), appelée par ensure_diff_db
        à chaque ouverture ; ne fait rien si diff.db n'a plus de mesure. Deux étapes idempotentes :
          1. copie + marqueur 'migrated_from_diff' dans UNE transaction BEGIN IMMEDIATE de history.db, qui relit le
             marqueur (deux processus simultanés ne copient qu'une fois) ;
          2. retrait des tables/colonnes mesurées de diff.db (BEGIN IMMEDIATE, état relu dans la transaction).
        Marqueur à deux états : 'copied' (étape 1 faite) puis 'done' (étape 2 faite). Tuée entre les deux ('copied') :
        la relance ne refait que l'étape 2. Tables réapparues après 'done' (un binaire antérieur les recrée : son
        ensure_diff_db exécute le schéma AVANT de refuser la version 10, et Bkp avale ce refus) : leurs lignes, écrites
        après la migration, sont recopiées (repo_stats sans imposer d'id, le reste sans doublon), puis retirées.
        Base 'migrating' (DbEncrypt/DbDecrypt en cours) : rien, reprise à une ouverture suivante. Mesures par archive :
        seules les lignes dont C/E n'est pas NULL (seule preuve d'un Bkp, >= 1.0.117) ; archive_stats.deduplicated_size
        reste dans diff.db."""
        def _state():
            tables={r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            acols=[r[1] for r in conn.execute("PRAGMA table_info(archive_stats)")]
            ce=[c for c in ('changed_during_backup','read_errors') if c in acols]
            # C/E laissées en place par SQLite < 3.35 (pas de DROP COLUMN) : vidées à la migration, donc plus rien à migrer
            ce_live=bool(ce) and conn.execute("SELECT 1 FROM archive_stats WHERE "+' OR '.join(f"{c} IS NOT NULL" for c in ce)+" LIMIT 1").fetchone() is not None
            return tables,ce,ce_live
        def _pending(tables,ce_live): return 'repo_stats' in tables or 'bkp_status' in tables or ce_live
        tables,ce_cols,ce_live=_state()
        if not _pending(tables,ce_live): return
        row=conn.execute("SELECT value FROM db_meta WHERE key='schema_version'").fetchone()
        if row and str(row[0]).isdigit() and int(row[0])>DIFF_DB_SCHEMA_VERSION: return   # base plus récente : jamais touchée (_check_set_meta refuse)
        raw=_enc_header_read(conn)
        if raw is not None and _enc_header_parse(raw).get('path_enc')=='migrating': return
        hist=_history_path_for(diff_path)
        self.ensure_history_db(hist,create=True)
        # Verrou d'écriture de diff.db tenu de bout en bout (revue story 2) : aucun écrivain — pas même un binaire antérieur —
        # ne peut écrire entre la copie et le retrait, et deux processus sont sérialisés ici. L'état est relu SOUS verrou :
        # un processus arrivé en second voit la migration faite, jamais des tables disparues entre-temps. Ordre des verrous
        # partout : diff.db puis history.db.
        conn.execute("BEGIN IMMEDIATE")
        try:
            tables,ce_cols,ce_live=_state()
            if not _pending(tables,ce_live):
                conn.rollback(); return
            h=None
            try:
                h=_open_db(hist,nick=None,role='admin',timeout=60,isolation_level=None)
                h.execute("BEGIN IMMEDIATE")
                try:
                    row=h.execute("SELECT value FROM db_meta WHERE key='migrated_from_diff'").fetchone()
                    state=None if row is None else (row[0] if row[0] in ('copied','done') else 'done')
                    if state!='copied':
                        printer(f"  Migration des mesures vers {os.path.basename(hist)}"+(" (lignes écrites par une version antérieure)" if state=='done' else "")+"...")
                        if 'repo_stats' in tables:
                            rs=conn.execute("SELECT id,nick,op,unique_csize,total_size,total_csize,updated_at FROM repo_stats ORDER BY id").fetchall()
                            if state is None and h.execute("SELECT count(*) FROM repo_stats").fetchone()[0]==0:
                                h.executemany("INSERT INTO repo_stats (id,nick,op,unique_csize,total_size,total_csize,updated_at) VALUES (?,?,?,?,?,?,?)",rs)
                            else:   # lignes postérieures à une migration déjà faite : ordre gardé, id attribués par history.db
                                h.executemany("INSERT INTO repo_stats (nick,op,unique_csize,total_size,total_csize,updated_at) VALUES (?,?,?,?,?,?)",[r[1:] for r in rs])
                        if 'bkp_status' in tables:
                            cols='nick,run_id,started_at,finished_at,result,notified_at,changed_during_backup,read_errors,start_notified_at'
                            h.executemany(f"INSERT OR IGNORE INTO bkp_status ({cols}) VALUES (?,?,?,?,?,?,?,?,?)",
                                          conn.execute(f"SELECT {cols} FROM bkp_status").fetchall())
                        if ce_live:
                            sel=','.join(c if c in ce_cols else 'NULL' for c in ('changed_during_backup','read_errors'))
                            where=' OR '.join(f"{c} IS NOT NULL" for c in ce_cols)
                            h.executemany("INSERT OR IGNORE INTO archive_measure (nick,archive,archive_date,deduplicated_size,changed_during_backup,read_errors) VALUES (?,?,?,?,?,?)",
                                          conn.execute(f"SELECT nick,archive,COALESCE(archive_date,''),deduplicated_size,{sel} FROM archive_stats WHERE {where}").fetchall())
                        h.execute("INSERT OR REPLACE INTO db_meta VALUES('migrated_from_diff','copied')")
                    h.execute("COMMIT")
                except BaseException:
                    h.execute("ROLLBACK"); raise
            except sqlite3.DatabaseError as e:
                # erreur de history.db : jamais le conseil de supprimer diff.db (qui porte encore les seules copies des mesures)
                _db_schema_fail(hist,e,"historique des mesures",regenerable=False)
            finally:
                if h is not None: h.close()
            if 'repo_stats' in tables: conn.execute("DROP TABLE repo_stats")
            if 'bkp_status' in tables: conn.execute("DROP TABLE bkp_status")
            if sqlite3.sqlite_version_info>=(3,35,0):
                for c in ce_cols: conn.execute(f"ALTER TABLE archive_stats DROP COLUMN {c}")
            elif ce_cols:   # pas de DROP COLUMN : colonnes vidées, plus jamais lues ni écrites
                conn.execute("UPDATE archive_stats SET "+','.join(f"{c}=NULL" for c in ce_cols))
            conn.commit()
        except BaseException:
            conn.rollback(); raise
        h=_open_db(hist,nick=None,role='admin',timeout=60)
        try: h.execute("UPDATE db_meta SET value='done' WHERE key='migrated_from_diff'"); h.commit()
        finally: h.close()

