    def diff_pair_has_sizes(self,nick,archive_old,archive_new,db_path=None):
        """True si la paire indexée contient des tailles (borg diff), False si stockée sans tailles (backup list)."""
        if db_path is None: db_path=self.get_diff_db(nick)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            row=conn.execute("SELECT entry_count FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=? LIMIT 1",(nick,archive_old,archive_new)).fetchone()
            if row is None: conn.close(); return False
            if row[0]==0: conn.close(); return True  # aucun changement → pas de taille à vérifier
            # S'il n'y a que des entrées C/B/T (sans taille par nature), considère comme "avec tailles"
            has_content=conn.execute("SELECT 1 FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=? AND change_type IN ('added','removed','modified') LIMIT 1",(nick,archive_old,archive_new)).fetchone()
            if not has_content: conn.close(); return True
            has_sz=conn.execute("SELECT 1 FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=? AND (size_after IS NOT NULL OR size_before IS NOT NULL) LIMIT 1",(nick,archive_old,archive_new)).fetchone()
            conn.close(); return has_sz is not None
        except sqlite3.Error: return False

    def _with_lock_retry(self,fn,max_wait=300):
        t0=time.time(); warned=False
        while True:
            try: return fn()
            except sqlite3.OperationalError as e:
                if "database is locked" not in str(e).lower(): raise
                if time.time()-t0>=max_wait: raise
                if not warned:
                    printer(f"  SQLite verrouillé — attente déverrouillage (max {max_wait}s)...")
                    warned=True
                time.sleep(2)

    def store_diff_entries(self,nick,archive_old,archive_new,archive_new_date,entries,db_path=None):
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                _write_mode_check(conn)
                if entries:
                    conn.executemany(
                        "INSERT INTO diff_index (nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES (?,?,?,?,?,?,?,?)",
                        [(nick,archive_old,archive_new,archive_new_date,e['change_type'],_path_stored(conn,e['path']),e.get('size_before'),e.get('size_after')) for e in entries])
                conn.execute("INSERT OR IGNORE INTO diff_indexed_pairs (nick,archive_old,archive_new,entry_count) VALUES (?,?,?,?)",(nick,archive_old,archive_new,len(entries)))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_archive_stats(self,nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles,db_path=None,
                            changed_during_backup=None,read_errors=None):
        """Upsert (1.0.117, était INSERT OR REPLACE) : changed_during_backup/read_errors (statuts C/E
        de borg create --list, connus seulement au Bkp) ne sont jamais remis à NULL par un appel qui ne
        les fournit pas — ex. rattrapage des statistiques par Index -F."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.execute("INSERT INTO archive_stats (nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles,changed_during_backup,read_errors) "
                             "VALUES (?,?,?,?,?,?,?,?,?,?) ON CONFLICT(nick,archive) DO UPDATE SET "
                             "archive_date=excluded.archive_date,duration=excluded.duration,original_size=excluded.original_size,"
                             "compressed_size=excluded.compressed_size,deduplicated_size=excluded.deduplicated_size,nfiles=excluded.nfiles,"
                             "changed_during_backup=COALESCE(excluded.changed_during_backup,archive_stats.changed_during_backup),"
                             "read_errors=COALESCE(excluded.read_errors,archive_stats.read_errors)",
                             (nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles,changed_during_backup,read_errors))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    # ── bkp_status (Story 1, spec-notifications-push) : exclusif à backup(), jamais Restore/Index/
    # Prune (AD-3). Aucune colonne `path` -> hors du périmètre du codec de chiffrement des chemins,
    # écritures/lectures directes, sans _write_mode_check ni _path_stored.

    def store_bkp_status_start(self,nick,run_id,db_path=None):
        """Écrite par backup(), juste après set_priority_lock, avant tout appel boex()."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.execute("INSERT INTO bkp_status (nick,run_id,started_at) VALUES (?,?,datetime('now'))",(nick,run_id))
                # Rétention (1.0.127) : même STATS_RETENTION_MONTHS que les historiques — une sauvegarde
                # démarrée il y a plus de N mois est forcément terminée et notifiée depuis longtemps.
                conn.execute(f"DELETE FROM bkp_status WHERE nick=? AND started_at < datetime('now','-{int(self._stats_retention_months(nick))} months')",(nick,))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_bkp_status_finish(self,nick,run_id,result,db_path=None,changed_during_backup=None,read_errors=None):
        """Écrite par backup() à la fin normale, avant sys.exit(newretC) — result dérivé du même
        newretC qu'aujourd'hui ('success' si 0, sinon 'error'). changed_during_backup/read_errors
        (1.0.118) : statuts C/E de borg create --list, repris dans la notification push de fin."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.execute("UPDATE bkp_status SET finished_at=datetime('now'),result=?,changed_during_backup=?,read_errors=? "
                             "WHERE nick=? AND run_id=?",(result,changed_during_backup,read_errors,nick,run_id))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_bkp_status_safety_net(self,nick,run_id,db_path=None):
        """Filet de sécurité appelé depuis le `finally` de backup() : ne touche QUE une ligne encore
        sans finished_at (exception non gérée depuis boex()/ailleurs) — jamais d'écrasement d'un
        résultat déjà écrit par la fin normale. Ferme immédiatement ce cas, sans attendre le timeout
        AD-7 (qui reste un filet supplémentaire pour un processus tué avant même d'atteindre ce
        `finally`, ex. SIGKILL/OOM)."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.execute("UPDATE bkp_status SET finished_at=datetime('now'),result='error' "
                             "WHERE nick=? AND run_id=? AND finished_at IS NULL",(nick,run_id))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def last_archive_stat(self,nick,db_path=None):
        """(archive, archive_date) de l'archive la plus récente connue d'archive_stats — même source
        que la colonne « depuis » de Report (MAX_AGE_BKP) — ou None (aucune archive connue, base
        absente/illisible). Lecture seule, utilisée par le watcher de borgHelperWWW (retard de sauvegarde).
        Jamais de création de base (AD-12) : fichier absent -> None sans l'ouvrir."""
        if db_path is None: db_path=self.get_diff_db(nick)
        if not os.path.exists(db_path): return None
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            try:
                r=conn.execute("SELECT archive,archive_date FROM archive_stats WHERE nick=? AND archive_date IS NOT NULL "
                               "ORDER BY archive_date DESC LIMIT 1",(nick,)).fetchone()
            finally: conn.close()
            return (r[0],r[1]) if r else None
        except sqlite3.Error: return None

    def bkp_running(self,nick,timeout_s,db_path=None):
        """True si un Bkp de ce nick est en cours : ligne bkp_status sans finished_at, démarrée depuis
        moins de timeout_s secondes (au-delà : bloquée, traitée en échec par le watcher, AD-7).
        Jamais de création de base (AD-12)."""
        if db_path is None: db_path=self.get_diff_db(nick)
        if not os.path.exists(db_path): return False
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            try:
                return conn.execute("SELECT 1 FROM bkp_status WHERE nick=? AND finished_at IS NULL "
                    f"AND started_at >= datetime('now','-{int(timeout_s)} seconds') LIMIT 1",(nick,)).fetchone() is not None
            finally: conn.close()
        except sqlite3.Error: return False

    def list_pending_bkp_status(self,nick,timeout_s,db_path=None):
        """Lignes bkp_status prêtes à être réclamées par le watcher (borgHelperWWW) : terminées
        (finished_at renseigné) ou bloquées depuis plus de timeout_s secondes sans fin (AD-7).
        Jamais de réclamation ici (lecture seule) — voir claim_bkp_status."""
        if db_path is None: db_path=self.get_diff_db(nick)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            rows=conn.execute(
                "SELECT run_id,started_at,finished_at,result,changed_during_backup,read_errors FROM bkp_status WHERE nick=? AND notified_at IS NULL "
                f"AND (finished_at IS NOT NULL OR started_at < datetime('now','-{int(timeout_s)} seconds'))",
                (nick,)).fetchall()
            conn.close()
            return [{'run_id':r[0],'started_at':r[1],'finished_at':r[2],'result':r[3],
                     'changed_during_backup':r[4],'read_errors':r[5]} for r in rows]
        except sqlite3.Error: return []

    def claim_bkp_status(self,nick,run_id,db_path=None):
        """Réclamation par comparer-et-échanger (AD-3) : UPDATE ... WHERE notified_at IS NULL, jamais
        de lecture-puis-écriture séparées — condition nécessaire à un déploiement multi-workers sans
        double envoi. True si CETTE réclamation a gagné (une ligne affectée), False si déjà réclamée
        par un autre worker (0 ligne affectée, jamais une erreur)."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                cur=conn.execute("UPDATE bkp_status SET notified_at=datetime('now') WHERE nick=? AND run_id=? AND notified_at IS NULL",(nick,run_id))
                conn.commit(); return cur.rowcount==1
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def get_running_bkp_status(self,nick,db_path=None):
        """Ligne bkp_status la plus récente encore en cours (finished_at IS NULL) pour ce nick, s'il y
        en a une (normalement 0 ou 1, jamais plus — un seul Bkp actif à la fois par nick via
        priority.lock). Lecture seule, aucune réclamation — utilisée par la commande Status (100%
        locale, jamais d'appel boex)."""
        if db_path is None: db_path=self.get_diff_db(nick)
        # Garde AD-12 (même patron que archive_stats dans _status_one) : _open_db crée le fichier
        # (os.O_CREAT) s'il n'existe pas — sans cette garde, une commande Status en lecture seule
        # créerait un diff.db vide 0600 pour tout nick jamais indexé, effet de bord inacceptable pour
        # une commande explicitement "100% locale".
        if not (os.path.exists(db_path) and _db_has_schema(db_path)): return None
        conn=None
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            row=conn.execute(
                "SELECT run_id,started_at FROM bkp_status WHERE nick=? AND finished_at IS NULL "
                "ORDER BY started_at DESC LIMIT 1",(nick,)).fetchone()
            return {'run_id':row[0],'started_at':row[1]} if row else None
        except (sqlite3.Error,DbKeyError,DbModeError,DbCodecError):
            # base absente/jamais indexée, migrating (AD-11), chiffrée sans passphrase résolue, etc. —
            # Status reste 100% best-effort : une anomalie sur bkp_status ne doit jamais faire échouer
            # tout l'appel multi-nick.
            return None
        finally:
            if conn is not None: conn.close()

    def list_pending_bkp_status_start(self,nick,db_path=None):
        """Lignes bkp_status prêtes pour la réclamation de DÉBUT (Story 2b, spec-notifications-push) :
        `started_at` déjà écrit (toujours vrai dès l'INSERT de store_bkp_status_start), aucun délai à
        attendre contrairement à list_pending_bkp_status (fin) — un début est immédiatement éligible.
        Lecture seule — voir claim_bkp_status_start."""
        if db_path is None: db_path=self.get_diff_db(nick)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            rows=conn.execute(
                "SELECT run_id,started_at FROM bkp_status WHERE nick=? AND start_notified_at IS NULL",
