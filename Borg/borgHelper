            SANS except -> remontait non attrapée au lieu du [ERREUR]/code 2 des autres refus de la même
            méthode."""
            b,paths=_db5_env('m15')
            b.db_encrypt('m15',confirm=True)
            orig=globals()['_enc_header_cas']
            globals()['_enc_header_cas']=lambda *a,**k: False  # simule un en-tête changé entre-temps
            out=io.StringIO(); r=None
