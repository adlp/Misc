def _boex_check_stdout(rb,nick,cmd='borg'):
    """Lève RuntimeError si boex a échoué ou retourné stdout vide."""
    if rb['exitcode']!=0 or not rb['stdout']:
        msgs=[]
        for i in rb.get('stderr',[]):
            if isinstance(i,dict) and i.get('levelname')=='ERROR':
                msgs.append(i.get('message','').split('\n')[0])
            elif isinstance(i,str) and i.strip() and not i.startswith('Platform'):
                msgs.append(i.strip()[:100])
        raise RuntimeError('; '.join(msgs[:2]) or f"{cmd} failed (code {rb['exitcode']})")

def _boex_last_modified(nick,debug=0):
    """Appelle borg info --json, retourne last_modified, lève RuntimeError si échec."""
    rb=boex(nick,['info','--json'],debug=debug)
    if rb['exitcode']!=0 or not rb['stdout']:
        msgs=[]
        for i in rb['stderr']:
            if isinstance(i,dict) and i.get('levelname')=='ERROR':
                msgs.append(i.get('message','').split('\n')[0])
            elif isinstance(i,str) and i.strip() and not i.startswith('Platform') and not i.startswith('Borg:'):
                msgs.append(i.strip())
        raise RuntimeError('; '.join(msgs[:3]) or f"borg info failed (code {rb['exitcode']})")
    return rb['stdout'][0]['repository']['last_modified']

def cache_prune_dryrun(nick,last_modified,debug=0,db_path=None):
    """Retourne la liste des archives à pruner, mise en cache par last_modified."""
    if db_path is None:
        db_path=get_cache_db(nick)
    ensure_cache_db(db_path)
    nom=f"{nick}:prune"
    purge_stale_cache(nom,last_modified,db_path)
    try:
        conn=sqlite3.connect(db_path)
        row=conn.execute(
            "SELECT details FROM cachejsonboexlm WHERE nom=? AND lastmodified=? LIMIT 1",
            (nom,last_modified)).fetchone()
        conn.close()
    except sqlite3.Error:
        row=None
    if row is not None:
        if debug: print(f'Cache hit (prune {nick})')
        return json.loads(row[0])
    if debug: print(f'Cache miss (prune {nick}) — borg prune --dry-run')
    cfg=cfgreaded(nick,debug=debug)
    cmd=['prune','--dry-run','--save-space','--info','--list']
    for key,flag in [('KEEP_DAILY','--keep-daily'),('KEEP_WEEKLY','--keep-weekly'),
                     ('KEEP_MONTHLY','--keep-monthly'),('KEEP_YEARLY','--keep-yearly'),
                     ('KEEP_HOURLY','--keep-hourly')]:
        if key in cfg:
            cmd.extend([flag,cfg[key]])
    cmd.append(f'--glob-archives={cfg["GLOB_ARCH"]}')
    ret=boex(nick,cmd,debug=debug)['stderr']
    pruneme=[]
    for i in ret:
        line=i if isinstance(i,str) else i.get('message','')
        if 'Would prune:' in line:
            pruneme.append((re.sub(r'( )*',r'\1',line)).split(' ')[2])
    try:
        conn=sqlite3.connect(db_path)
        conn.execute(
            "INSERT OR IGNORE INTO cachejsonboexlm (nom,lastmodified,details) VALUES (?,?,?)",
            (nom,last_modified,json.dumps(pruneme)))
        conn.commit()
        conn.close()
    except sqlite3.Error as e:
        printer(f"Cache write error (prune): {e}")
    return pruneme

def cacheJsonBoexWithLM(nick,boexarg,output="stdout",debug=0,db_path=None,last_modified=None):
