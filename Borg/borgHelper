                    and d4==1 and m4('foo/xbar') and m4('foo/xbar/deep/f') and not m4('foo/xbaz') and not m4('foo/a/bar')
                    and sel5==('under','foo') and d5==2 and m5('foo/x/bar/f') and not m5('foo/x/y/bar') and not m5('foo/bar')
                    and m6('a/b1/[x]%_.c/z') and not m6('a/b12/[x]%_.c/z') and not m6('a/b1/x%_.c/z') and not m6('a/b1/[x]%_Xc/z'))
        check("DuIdx groupé : _duidx_group_spec honore le motif composant par composant, 'foo/*' et '*' inchangés",_duidx_spec)
        def _view_check():
