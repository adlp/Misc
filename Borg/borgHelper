                    conn.executemany("INSERT OR IGNORE INTO archive_snapshot (nick,archive,archive_date,file_id) SELECT ?,?,?,id FROM snapshot_file WHERE nick=? AND path=?",
                                     [(nick,archive,archive_date,nick,f['path']) for f in files])
                conn.execute("INSERT OR IGNORE INTO archive_snapshot_indexed (nick,archive,entry_count) VALUES (?,?,?)",(nick,archive,len(files)))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
