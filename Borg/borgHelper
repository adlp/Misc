def parse_borg_size(s):
    s=s.strip()
    for unit,mult in [('TB',10**12),('GB',10**9),('MB',10**6),('kB',10**3),('B',1)]:
        if s.endswith(unit):
            try:
                return int(float(s[:-len(unit)].strip())*mult)
            except (ValueError,TypeError):
                return None
    return None

def parse_diff_line(line):
    line=line.rstrip()
    if not line:
        return None
    m=re.match(r'^added\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'added','size_before':None,
                'size_after':parse_borg_size(m.group(1)),'path':m.group(2)}
    m=re.match(r'^removed\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'removed','size_before':parse_borg_size(m.group(1)),
                'size_after':None,'path':m.group(2)}
    m=re.match(r'^modified\s+\+([\d.]+\s+\w+)\s+-([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'modified',
                'size_before':parse_borg_size(m.group(2)),
                'size_after':parse_borg_size(m.group(1)),
                'path':m.group(3)}
    m=re.match(r'^([A-Z])\s+(.+)$',line)
    if m:
        return {'change_type':m.group(1),'size_before':None,
                'size_after':None,'path':m.group(2)}
    return None

def cmd_index(nick,debug=0,db_path=None,force=False):
    if _nick_noidx(nick):
        printer(f"{nick}: indexation désactivée (NOIDX=1)")
        return 0
    if db_path is None:
        db_path=get_diff_db(nick)
    ensure_diff_db(db_path)
    cfg=cfgreaded(nick,debug=debug)
    rb=boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
    try:
        _boex_check_stdout(rb,nick,'borg list')
    except RuntimeError as e:
        printer(f"{nick}: {e}")
        return 1
    archives=rb['stdout'][0]['archives']
    if len(archives)<2:
        printer(f"{nick}: moins de 2 archives, rien à indexer")
        return 0

    # Phase 1 : déterminer les paires à indexer + purge groupée si force
    pairs_todo=[]
    skipped=0
    pairs_to_purge=[]
    for i in range(len(archives)-1):
        a_old=archives[i]['name']
        a_new=archives[i+1]['name']
        date_new=archives[i+1]['start']
        already=is_diff_pair_indexed(nick,a_old,a_new,db_path)
        if already and not force:
            skipped+=1
            continue
        if already and force:
            pairs_to_purge.append((a_old,a_new))
        pairs_todo.append((a_old,a_new,date_new))
    if pairs_to_purge:
        try:
            conn=sqlite3.connect(db_path)
            for a_old,a_new in pairs_to_purge:
                conn.execute("DELETE FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
            conn.commit()
            conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error (purge): {e}")

    # Phase 2 : borg diff en parallèle
    workers=max(1,int(cfg.get('IDX_WORKERS','4')))
    from concurrent.futures import ThreadPoolExecutor,as_completed
    def _run_diff(pair):
        a_old,a_new,date_new=pair
        print(f"  {nick}: {a_old} → {a_new}",flush=True)
        rb2=boex(nick,['diff',f"{cfg['BORG_REPO']}::{a_old}",a_new],debug=debug,retjson=False)
        entries=[p for line in rb2['stdout']
                 for p in [parse_diff_line(line)]
                 if p and p['path'] and _idx_path_ok(p['path'],cfg)]
        return (a_old,a_new,date_new,entries)
    results=[]
    if pairs_todo:
        with ThreadPoolExecutor(max_workers=workers) as ex:
            futs={ex.submit(_run_diff,p):p for p in pairs_todo}
            for fut in as_completed(futs):
                try:
                    results.append(fut.result())
                except Exception as e:
                    printer(f"[WARN] borg diff échoué : {e}")

    # Phase 3 : insert groupé (connexion unique)
    if results:
        try:
            conn=sqlite3.connect(db_path)
            for a_old,a_new,date_new,entries in results:
                if entries:
                    conn.executemany(
                        "INSERT INTO diff_index (nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES (?,?,?,?,?,?,?,?)",
                        [(nick,a_old,a_new,date_new,e['change_type'],e['path'],e.get('size_before'),e.get('size_after'))
                         for e in entries])
                conn.execute(
                    "INSERT OR IGNORE INTO diff_indexed_pairs (nick,archive_old,archive_new,entry_count) VALUES (?,?,?,?)",
                    (nick,a_old,a_new,len(entries)))
            conn.commit()
            conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error (insert): {e}")
    new_pairs=len(results)
    print(f"{nick}: {new_pairs} paires indexées (+{skipped} déjà en cache)")
    # Peuplement archive_stats : seulement si des archives manquent
    archive_names=set(a['name'] for a in archives)
    try:
        conn=sqlite3.connect(db_path)
        existing=set(r[0] for r in conn.execute(
            "SELECT archive FROM archive_stats WHERE nick=?",(nick,)).fetchall())
        conn.close()
    except sqlite3.Error:
        existing=set()
    missing=archive_names-existing
    if missing or force:
        rbi=boex(nick,['info','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            _boex_check_stdout(rbi,nick,'borg info')
            for a in rbi['stdout'][0]['archives']:
                if force or a['name'] in missing:
                    st=a.get('stats',{})
                    store_archive_stats(nick,a['name'],a.get('start'),
                        a.get('duration'),
                        st.get('original_size'),st.get('compressed_size'),
                        st.get('deduplicated_size'),st.get('nfiles'),
                        db_path)
        except (RuntimeError,KeyError,TypeError):
            pass
    cmd_indexsnap(nick,debug=debug,db_path=db_path,force=force)
    return 0

def cmd_indexsnap(nick,debug=0,db_path=None,force=False):
    if _nick_noidx(nick):
        printer(f"{nick}: indexation désactivée (NOIDX=1)")
        return 0
    if db_path is None:
        db_path=get_diff_db(nick)
