# ── BorgRunner — borg subprocess + borghelperrc config ────────────────────────

class BorgRunner:
    """Borg subprocess wrapper and borghelperrc configuration layer."""

    def __init__(self,cfgfile=None):
        self.cfgfile=cfgfile or os.path.expanduser("~/.borghelperrc")

    def cfgread(self,nick,debug=0):
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            if nick not in config.keys(): return None
            return config[nick]
        return None

    def cfgreadnicks(self,debug=0):
        preret=[]
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            for nick in config.keys():
                if nick!="DEFAULT" and 'ALL' not in config[nick].keys():
                    preret.append(nick)
            return ','.join(preret)
        return None

    def cfgreaded(self,nick,debug=0):
        cfg=self.cfgread(nick,debug=debug)
        if cfg is None:
            printer("Ce serveur est inconnu"); sys.exit(3)
        return cfg

    def cfgwrite(self,nick,serna,passphrase,repo,mountpoint,debug=0):
        config=configparser.ConfigParser()
        config.optionxform=str
        config.read(self.cfgfile)
        config[nick]={}
        config[nick]['BORG_REPO']=repo
        config[nick]['BORG_PASSPHRASE']=passphrase
        config[nick]['SER_NAME']=serna
        config[nick]['GLOB_ARCH']=serna+'-root-*'
        config[nick]['MOUNTPOINT']="/mnt/borg/"+nick if mountpoint is None else mountpoint
        with open(self.cfgfile,'w') as fd:
            config.write(fd)

    def _boex_check_stdout(self,rb,nick,cmd='borg'):
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb.get('stderr',[]):
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform'):
                    msgs.append(i.strip()[:100])
            raise RuntimeError('; '.join(msgs[:2]) or f"{cmd} failed (code {rb['exitcode']})")

    def _boex_last_modified(self,nick,debug=0):
        rb=self.boex(nick,['info','--json'],debug=debug)
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb['stderr']:
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform') and not i.startswith('Borg:'):
                    msgs.append(i.strip())
            raise RuntimeError('; '.join(msgs[:3]) or f"borg info failed (code {rb['exitcode']})")
        return rb['stdout'][0]['repository']['last_modified']

    def getlastbkp(self,nick,nbl=1,debug=0):
        cfg=self.cfgreaded(nick,debug=debug)
        rb=self.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        self._boex_check_stdout(rb,nick,'borg list')
        lines=rb['stdout'][0]['archives']
        return [lines[i]['name'] for i in range(nbl*-1,0)]

    def dfRepo(self,nick,debug=0):
        cfg=self.cfgreaded(nick,debug=debug)
        if ':' not in cfg['BORG_REPO']:
            process=subprocess.Popen(f'df {cfg["BORG_REPO"]} --output=avail | tail -1',stdout=subprocess.PIPE,stderr=subprocess.PIPE,shell=True)
            stdout,stderr=process.communicate()
            if process.returncode==0:
                return int(stdout.decode('utf-8').split(" ")[-1])*1024
        return None

    def boex(self,nick,arg,rep=None,debug=0,preBorg=None,forceEnv=None,retjson=True):
        cfg=self.cfgreaded(nick,debug=debug)
        varcur=os.environ.copy()
        varfut={}
        if debug!=0: printer('Boex the first')
        for k in list(cfg.keys()):
            if k in ['BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO','BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE']:
                varfut[k]=cfg[k]
        if forceEnv is not None:
            for k in list(forceEnv.keys()): varfut[k]=forceEnv[k]
        if debug!=0: printer(varfut)
        borg_exe=cfg.get('BORG_EXE','borg')
        if preBorg is not None:
            commande=preBorg; commande.append(borg_exe)
        else:
            commande=[borg_exe]
        if rep is None: rep=os.getcwd()
        commande.extend(arg)
        varfut['PATH']=varcur['PATH']
        varfut["LC_ALL"]="fr_FR.UTF-8"
        if debug:
            for k in varfut: printer(f' {k}={varfut[k]}')
            printer(f"+{rep}"); printer(commande)
            printer(f"{' '.join(commande)}")
            printer(f"+{rep} >{' '.join(commande)}")
            if arg[1] in "extract": sys.exit(4)
        ps=subprocess.Popen(commande,encoding='utf-8',env=varfut,cwd=rep,bufsize=8192,
                            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        try:
            inf,errs=ps.communicate()
        except KeyboardInterrupt:
            ps.kill(); ps.wait()
            printer("\n[INTERRUPTED] Opération annulée par l'utilisateur.")
            sys.exit(130)
        ret={'stdout':[],'stderr':[]}
        if len(inf):
            if inf[0] in '[{' and retjson: ret['stdout'].append(json.loads(inf))
            else:
                for i in inf.split('\n'): ret['stdout'].append(i)
        if len(errs):
            if errs[0] in '{':
                try:
                    theJson='['+','.join(errs.split('\n'))[:-1]+']'
                    ret['stderr']=json.loads(theJson)
                except json.JSONDecodeError:
                    for i in errs.split('\n'): ret['stderr'].append(i)
            else:
                for i in errs.split('\n'): ret['stderr'].append(i)
        ret['exitcode']=ps.returncode
        if debug: printer(json.dumps(ret,indent=4))
        return ret

# ── BorgHelper — high-level service layer (DB + Borg combined) ────────────────

class BorgHelper:
    """High-level borgbackup service layer. Combines BorgHelperDB and BorgRunner.

    Usage as library:
        bh = BorgHelper('/path/to/.borghelperrc')
        bh.backup('myserver')
        bh.index('myserver')
        bh.report('myserver')
    """

    def __init__(self,cfgfile=None,cache_dir=None):
        self.borg=BorgRunner(cfgfile)
        cp=configparser.ConfigParser()
        if os.path.exists(self.borg.cfgfile): cp.read(self.borg.cfgfile)
        resolved_cache=cache_dir or os.path.expanduser(cp.defaults().get('cache_dir','~/.cache/borghelper'))
        os.makedirs(resolved_cache,exist_ok=True)
        self.db=BorgHelperDB(resolved_cache,_db_name_from_cfg(self.borg.cfgfile),cfg_reader=self.borg.cfgread)

    # ── Internal helpers ───────────────────────────────────────────────────────

    def _nick_noidx(self,nick):
        cfg=self.borg.cfgread(nick)
        return cfg is not None and cfg.get('NOIDX','0').strip()=='1'

    def _idx_path_ok(self,path,cfg):
        import fnmatch
        includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
        excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
        def _match(path,pat):
            # glob pattern (*, ?, [) → fnmatch (* matches any chars including /)
            # plain prefix (/home/, /etc) → startswith
            if any(c in pat for c in ('*','?','[')):
                return fnmatch.fnmatch(path,pat)
            return path.startswith(pat)
        if includes:
            if not any(_match(path,p) for p in includes): return False
        if excludes:
            if any(_match(path,p) for p in excludes): return False
        return True

    def cache_prune_dryrun(self,nick,last_modified,debug=0,db_path=None):
        if db_path is None: db_path=self.db.get_cache_db(nick)
        self.db.ensure_cache_db(db_path)
        nom=f"{nick}:prune"
        self.db.purge_stale_cache(nom,last_modified,db_path)
        try:
            conn=sqlite3.connect(db_path)
            row=conn.execute("SELECT details FROM cachejsonboexlm WHERE nom=? AND lastmodified=? LIMIT 1",(nom,last_modified)).fetchone()
            conn.close()
        except sqlite3.Error: row=None
        if row is not None:
            if debug: print(f'Cache hit (prune {nick})')
            return json.loads(row[0])
        if debug: print(f'Cache miss (prune {nick}) — borg prune --dry-run')
        cfg=self.borg.cfgreaded(nick,debug=debug)
        cmd=['prune','--dry-run','--save-space','--info','--list']
        for key,flag in [('KEEP_DAILY','--keep-daily'),('KEEP_WEEKLY','--keep-weekly'),
                         ('KEEP_MONTHLY','--keep-monthly'),('KEEP_YEARLY','--keep-yearly'),
                         ('KEEP_HOURLY','--keep-hourly')]:
            if key in cfg: cmd.extend([flag,cfg[key]])
        cmd.append(f'--glob-archives={cfg["GLOB_ARCH"]}')
        ret=self.borg.boex(nick,cmd,debug=debug)['stderr']
        pruneme=[]
        for i in ret:
            line=i if isinstance(i,str) else i.get('message','')
            if 'Would prune:' in line:
                pruneme.append((re.sub(r'( )*',r'\1',line)).split(' ')[2])
        try:
            conn=sqlite3.connect(db_path)
            conn.execute("INSERT OR IGNORE INTO cachejsonboexlm (nom,lastmodified,details) VALUES (?,?,?)",(nom,last_modified,json.dumps(pruneme)))
            conn.commit(); conn.close()
        except sqlite3.Error as e:
            printer(f"Cache write error (prune): {e}")
        return pruneme

    def cacheJsonBoexWithLM(self,nick,boexarg,output="stdout",debug=0,db_path=None,last_modified=None):
        if db_path is None: db_path=self.db.get_cache_db(nick)
        self.db.ensure_cache_db(db_path)
        if last_modified is None: last_modified=self.borg._boex_last_modified(nick,debug=debug)
        self.db.purge_stale_cache(nick,last_modified,db_path)
        try:
            conn=sqlite3.connect(db_path)
            row=conn.execute("SELECT details FROM cachejsonboexlm WHERE nom=? AND lastmodified=? LIMIT 1",(nick,last_modified)).fetchone()
            conn.close()
        except sqlite3.Error as e:
            printer(f"Cache SQLite error: {e}"); row=None
        if row is None:
            if debug: print('Cache miss — appel borg')
            details=self.borg.boex(nick,boexarg,debug=debug)[output][0]
            try:
                conn=sqlite3.connect(db_path)
                conn.execute("INSERT OR IGNORE INTO cachejsonboexlm (nom,lastmodified,details) VALUES (?,?,?)",(nick,last_modified,json.dumps(details)))
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"Cache write error: {e}")
        else:
            if debug: print('Cache hit')
            details=json.loads(row[0])
        if type(details) is list: return details[0]
        return details

    def _cleanup_index_after_prune(self,nick,debug=0):
        if self._nick_noidx(nick): return
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path): return
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError: return
        current=set(a['name'] for a in rb['stdout'][0]['archives'])
        try:
            conn=sqlite3.connect(db_path)
            if current:
                ph=','.join('?'*len(current)); lst=list(current)
                r1=conn.execute(f"DELETE FROM diff_index WHERE nick=? AND archive_new NOT IN ({ph})",[nick]+lst).rowcount
                r2=conn.execute(f"DELETE FROM diff_indexed_pairs WHERE nick=? AND (archive_old NOT IN ({ph}) OR archive_new NOT IN ({ph}))",[nick]+lst+lst).rowcount
                r3=conn.execute(f"DELETE FROM archive_snapshot WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst).rowcount
                r4=conn.execute(f"DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst).rowcount
                conn.execute(f"DELETE FROM archive_stats WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst)
                conn.execute(f"DELETE FROM diff_excluded_stats WHERE nick=? AND (archive_old NOT IN ({ph}) OR archive_new NOT IN ({ph}))",[nick]+lst+lst)
                conn.execute(f"DELETE FROM snap_excluded_stats WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst)
            else:
                r1=conn.execute("DELETE FROM diff_index WHERE nick=?",(nick,)).rowcount
                r2=conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=?",(nick,)).rowcount
                r3=conn.execute("DELETE FROM archive_snapshot WHERE nick=?",(nick,)).rowcount
                r4=conn.execute("DELETE FROM archive_snapshot_indexed WHERE nick=?",(nick,)).rowcount
                conn.execute("DELETE FROM archive_stats WHERE nick=?",(nick,))
                conn.execute("DELETE FROM diff_excluded_stats WHERE nick=?",(nick,))
                conn.execute("DELETE FROM snap_excluded_stats WHERE nick=?",(nick,))
            self.db._cleanup_snapshot_file_orphans(nick,conn)
            conn.commit()
            total=r1+r2+r3+r4
            if total>0: print(f"{nick}: index nettoyé ({r1} diff, {r2} paires, {r3}+{r4} snapshots)")
            conn.execute("VACUUM"); conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite cleanup error: {e}")

    def _find_last_archive_with_file(self,nick,path,debug=0):
        db_path=self.db.get_diff_db(nick)
        has_glob='*' in path or '?' in path
        sql_pat=path.replace('*','%').replace('?','_') if has_glob else None
        op='LIKE' if has_glob else '='
        val=sql_pat if has_glob else path
        try:
            self.db.ensure_diff_db(db_path)
            conn=sqlite3.connect(db_path)
            row=conn.execute(f"SELECT archive FROM archive_snapshot_v WHERE nick=? AND path {op} ? ORDER BY archive DESC LIMIT 1",(nick,val)).fetchone()
            if row: conn.close(); return row[0]
            row=conn.execute(f"SELECT archive_new FROM diff_index WHERE nick=? AND path {op} ? AND change_type!='removed' ORDER BY archive_new_date DESC LIMIT 1",(nick,val)).fetchone()
            conn.close(); return row[0] if row else None
        except sqlite3.Error: return None

    # ── Commands ───────────────────────────────────────────────────────────────

    def stats(self,nick=None,debug=0):
        if os.path.exists(self.borg.cfgfile) and os.path.isfile(self.borg.cfgfile):
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.borg.cfgfile)
            def _affconf(n):
                cfg=self.borg.cfgreaded(n)
                print(n+': ',end='')
                print('**Mounted**' if mountedornot(cfg['MOUNTPOINT'],debug=debug) else 'Not Mounted')
            if nick is None:
                for n in config.keys():
                    if n in 'DEFAULT': continue
                    _affconf(n)
            elif nick in config.keys():
                _affconf(nick)
            else:
                print(f'{nick} pas trouvé dans {self.borg.cfgfile}'); sys.exit(1)
        else:
            printer(f'Fichier {self.borg.cfgfile} absent'); sys.exit(2)

    def login(self,serna,nick,keyfile,passphrase,repo,mountpoint,debug=0):
        self.borg.cfgwrite(nick,serna,passphrase,repo,mountpoint,debug=debug)
        cfg=self.borg.cfgread(nick,debug=debug)
        if keyfile is not None:
            if os.path.exists(keyfile) and os.path.isfile(keyfile):
                rb=self.borg.boex(nick,['key','import',repo,keyfile],debug=debug)
                print(rb); sys.exit(rb['exitcode'])
            else:
                printer("Fichier "+keyfile+" absent, Mais attention, machine "+nick+" integre")
                sys.exit(2)

    def mount(self,nick,bid='ALL',debug=0):
        cfg=self.borg.cfgreaded(nick)
        if bid is None or bid=='last': bid=self.borg.getlastbkp(nick,debug=debug)[0]
        repo=cfg['BORG_REPO']+"::"+bid
        if bid=="ALL": repo=cfg['BORG_REPO']
        if os.path.exists(cfg['MOUNTPOINT']) and os.path.isdir(cfg['MOUNTPOINT']) and len(os.listdir(cfg['MOUNTPOINT']))==0:
            if not mountedornot(cfg['MOUNTPOINT'],debug=debug):
                rb=self.borg.boex(nick,['mount',repo,cfg['MOUNTPOINT']],debug=debug)
                if rb['exitcode']!=0 or len(rb['stdout'])!=0 or len(rb['stderr']): print(rb)
                sys.exit(rb['exitcode'])
            else:
                printer('Deja monte'); sys.exit(3)
        else:
            printer("Il faut que le repertoire "+cfg['MOUNTPOINT']+" existe et soit vide!"); sys.exit(2)

    def umount(self,nick,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        if mountedornot(cfg['MOUNTPOINT'],debug=debug):
            rb=self.borg.boex(nick,['umount',cfg['MOUNTPOINT']],debug=debug)
            if rb['exitcode']!=0 or len(rb['stdout'])!=0 or len(rb['stderr']): print(rb)
            sys.exit(rb['exitcode'])
        else:
            printer('Pas monte'); sys.exit(3)

    def list_backups(self,nick,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        for i in rb['stdout'][0]['archives']:
            print(f"{i['name']} {i['start']}")
        sys.exit(rb['exitcode'])

    def list_files(self,nick,bid,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        if bid is None: bid=self.borg.getlastbkp(nick,debug=debug)[0]
        rb=self.borg.boex(nick,['list','--glob-archives',cfg['GLOB_ARCH'],'::'+bid],debug=debug,retjson=False)
        for i in rb['stdout']: print(i)
        sys.exit(rb['exitcode'])

    def key(self,nicks,debug=0):
        for nick in nicks.split(','):
            cfg=self.borg.cfgreaded(nick,debug=debug)
            rb=self.borg.boex(nick,['key','export','--paper'],debug=debug)
            if rb['exitcode']==0:
                print(f"[{nick}]:{cfg['BORG_PASSPHRASE']}")
                for i in rb["stdout"]: print(i)

    def cache_info(self,nick=None,debug=0):
        nicks=nick.split(',') if nick and nick!='ALL' else self.borg.cfgreadnicks(debug).split(',')
        rows=[]
        for n in nicks:
            rows.extend(self.db.get_cache_rows(n))
        if not rows:
            print("Cache vide."); return
        from prettytable import PrettyTable
        t=PrettyTable(['nick','last_modified','taille'])
        for nom,lm,size in rows:
            t.add_row([nom,lm,convert_octets_readable(size) if size else '0 B'])
        print(t)

    def cache_clean(self,nick=None,debug=0):
        nicks_to_clean=nick.split(',') if nick and nick!='ALL' else self.borg.cfgreadnicks(debug).split(',')
        total=0
        for n in nicks_to_clean:
            db_path=self.db.get_cache_db(n)
            self.db.ensure_cache_db(db_path)
            cfg=self.borg.cfgread(n,debug=debug)
            if cfg is None:
                count=self.db.clear_cache_nick(n,db_path)
                print(f"  {n}: {count} entrée(s) supprimée(s) — nick absent de la conf")
                total+=count; continue
            try:
                lm=self.borg._boex_last_modified(n,debug=debug)
                deleted=self.db.purge_stale_cache(n,lm,db_path)
                deleted+=self.db.purge_stale_cache(f"{n}:prune",lm,db_path)
                if deleted: print(f"  {n}: {deleted} entrée(s) périmée(s) supprimée(s)")
                else: print(f"  {n}: cache à jour")
                total+=deleted
            except Exception:
                printer(f"  {n}: erreur lors de la vérification")
        print(f"Total supprimé : {total}")

    def diffbkp(self,nick,bidun=None,bideux=None,debug=0,db_path=None):
        if db_path is None: db_path=self.db.get_diff_db(nick)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        twodiff=self.borg.getlastbkp(nick,2,debug=debug)
        if bidun is None and bideux is None:
            bidun=twodiff[0]; bideux=twodiff[1]
        elif bideux is None:
            bideux=bidun; bidun=twodiff[1]
        if bidun==bideux:
            printer("Desole, ce sont les memes backups"); sys.exit(1)
        if bidun>bideux: bidun,bideux=bideux,bidun
        if debug: printer(f"Comparaison de {bidun} et {bideux}")
        self.db.ensure_diff_db(db_path)
        if not self.db.is_diff_pair_indexed(nick,bidun,bideux,db_path):
            print(f"Paire non indexée — calcul en cours...",flush=True)
            rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
            try:
                self.borg._boex_check_stdout(rb,nick,'borg list')
            except RuntimeError as e:
                printer(f"borg list a échoué : {e}"); sys.exit(2)
            archives=rb['stdout'][0]['archives']
            date_new=next((a['start'] for a in archives if a['name']==bideux),None)
            rb2=self.borg.boex(nick,['diff',f"{cfg['BORG_REPO']}::{bidun}",bideux],debug=debug,retjson=False)
            if rb2['exitcode']!=0:
                printer(f"borg diff a échoué (code {rb2['exitcode']})"); sys.exit(rb2['exitcode'])
            entries=[p for line in rb2['stdout'] for p in [parse_diff_line(line)] if p and p['path']]
            self.db.store_diff_entries(nick,bidun,bideux,date_new,entries,db_path)
        try:
            conn=sqlite3.connect(db_path)
            cur=conn.execute(
                "SELECT change_type,path,size_before,size_after FROM diff_index "
                "WHERE nick=? AND archive_old=? AND archive_new=? ORDER BY path,change_type",
                (nick,bidun,bideux))
            rows=cur.fetchall(); conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error: {e}"); sys.exit(3)
        print(f"{bidun} → {bideux}")
        if not rows: print("Aucune différence."); sys.exit(0)
        n_add=n_rem=n_mod=0
        for ct,path,sb,sa in rows:
            if ct=='added':
                sym='+'; n_add+=1
                tail=f"  {convert_octets_readable(sa)}" if sa else ''
            elif ct=='removed':
                sym='-'; n_rem+=1
                tail=f"  {convert_octets_readable(sb)}" if sb else ''
            else:
                sym='='; n_mod+=1
                if sb and sa:
                    tail=f"  {convert_octets_readable(sb)} → {convert_octets_readable(sa)}"
                elif sa: tail=f"  {convert_octets_readable(sa)}"
                elif sb: tail=f"  {convert_octets_readable(sb)}"
                else: tail=f"  [{ct}]" if ct!='modified' else ''
            print(f"{sym} {path}{tail}")
        print(f"\n+ {n_add}  - {n_rem}  = {n_mod}")
        sys.exit(0)

    def listperms(self,nick,bid,ftor,debug=0):
        if bid is None:
            bid=self._find_last_archive_with_file(nick,ftor,debug=debug)
            if bid: print(f"Archive : {bid}",flush=True)
            else:
                bid=self.borg.getlastbkp(nick,debug=debug)[0]
                print(f"Archive (dernière) : {bid}",flush=True)
        fmt='{mode} {user:8} {group:8} {size:>12} {isomtime} {path}{NL}'
        args=['list','--format',fmt,f'::{bid}']
        if '*' in ftor or '?' in ftor: args+=[f'--pattern=sh:{ftor}']
        else: args.append(ftor)
        rb=self.borg.boex(nick,args,debug=debug,retjson=False)
        for line in rb['stdout']:
            if line.strip(): print(line)
        _print_boex_stderr(rb); sys.exit(rb['exitcode'])

    def restore(self,nick,bid,ftor,where,flat=False,debug=0):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        stdout_mode=(where=='-')
        out=sys.stderr if stdout_mode else sys.stdout
        if bid is None:
            bid=self._find_last_archive_with_file(nick,ftor,debug=debug)
            if bid: print(f"Archive sélectionnée depuis l'index : {bid}",file=out,flush=True)
            else:
                bid=self.borg.getlastbkp(nick,debug=debug)[0]
                print(f"Archive sélectionnée (dernière) : {bid}",file=out,flush=True)
        self.db.set_priority_lock(nick)
        try:
            if stdout_mode or _is_tar_dest(where):
                self._restore_to_tar(nick,bid,ftor,where,flat=flat,debug=debug)
            elif flat:
                import tempfile,shutil
                with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
                    rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
                    _print_boex_stderr(rb)
                    if rb['exitcode'] not in (0,1): sys.exit(rb['exitcode'])
                    os.makedirs(where,exist_ok=True)
                    try:
                        for root,_,files in os.walk(tmpdir):
                            for f in files: shutil.copy2(os.path.join(root,f),os.path.join(where,f))
                    except OSError as e:
                        import errno as _errno
                        if e.errno==_errno.ENOSPC: printer(f"[ERREUR] Espace disque insuffisant : {e.filename or where}")
                        else: printer(f"[ERREUR] Copie impossible : {e}")
                        sys.exit(3)
                    print(f"Restauré (plat) dans {where}",flush=True)
                sys.exit(rb['exitcode'])
            else:
                rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=where,debug=debug)
                _print_boex_stderr(rb); sys.exit(rb['exitcode'])
        finally:
            self.db.clear_priority_lock(nick)

    def _restore_to_tar(self,nick,bid,ftor,tarpath,flat=False,debug=0):
        import tempfile,tarfile as tf_mod
        stdout_mode=(tarpath=='-')
        with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
            rb=self.borg.boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
            _print_boex_stderr(rb)
            if rb['exitcode'] not in (0,1): sys.exit(rb['exitcode'])
            if stdout_mode:
                mode='w|'
            else:
                is_gz=tarpath.endswith('.tgz') or tarpath.endswith('.tar.gz')
                exists=os.path.exists(tarpath)
                if is_gz:
                    if exists:
                        print(f"[ERREUR] {tarpath} existe déjà — impossible d'ajouter à un fichier gzip.",file=sys.stderr)
                        print(f"  Supprimez-le manuellement ou choisissez un autre nom.",file=sys.stderr)
                        sys.exit(3)
                    mode='w:gz'
                else:
                    mode='a' if exists else 'w'
            try:
                fobj=sys.stdout.buffer if stdout_mode else None
                with (tf_mod.open(fileobj=fobj,mode=mode) if stdout_mode else tf_mod.open(tarpath,mode)) as tf:
                    for root,dirs,files in os.walk(tmpdir):
                        if not flat:
                            for d in dirs:
                                dp=os.path.join(root,d)
                                tf.add(dp,arcname=os.path.relpath(dp,tmpdir),recursive=False)
                        for f in files:
                            fp=os.path.join(root,f)
                            arcname=(os.path.basename(fp) if flat else os.path.relpath(fp,tmpdir))
                            tf.add(fp,arcname=arcname)
            except BrokenPipeError:
                sys.exit(0)
            except OSError as e:
                import errno as _errno
                if e.errno==_errno.ENOSPC: print(f"[ERREUR] Espace disque insuffisant : {e.filename or tarpath}",file=sys.stderr)
                else: print(f"[ERREUR] Écriture impossible : {e}",file=sys.stderr)
                sys.exit(3)
            if not stdout_mode: print(f"Restauré {'(plat) ' if flat else ''}dans {tarpath}",flush=True)
        sys.exit(rb['exitcode'])

    def delbkp(self,nick,bid,debug=0):
        rb=self.borg.boex(nick,['delete','::'+bid],debug=debug)
        if rb['exitcode']!=0: print(rb); sys.exit(rb['exitcode'])
        self.borg.boex(nick,['compact','--cleanup-commits'],debug=debug)
        self.db.clear_cache_nick(nick); sys.exit(rb['exitcode'])

