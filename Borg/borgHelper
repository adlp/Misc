def _db_name_from_cfg(path):
    base=os.path.basename(os.path.abspath(path)).lstrip('.')
    return re.sub(r'[^a-zA-Z0-9_-]','_',base)

def getDataFromEnvOrFile(env=None,envpath=None,paths=None):
    if env:
        data=os.environ.get(env)
        if data: return data
    if envpath:
        fileName=os.environ.get(envpath)
        if fileName and os.path.isfile(fileName) and os.access(fileName,os.R_OK):
            with open(fileName,'r',encoding='utf-8') as f:
                return f.readline().strip()
    pathlst=[p.strip() for p in paths.split(',')]
    for path in pathlst:
        if os.path.isfile(path) and os.access(path,os.R_OK):
            with open(path,'r',encoding='utf-8') as f:
                return f.readline().strip()
    return None

def convert_octets_readable(size_in_bytes,sib=1000):
    suffixes=['B','KB','MB','GB','TB','PB','EB','ZB','YB']
    index=0
    while size_in_bytes>=sib and index<len(suffixes)-1:
        size_in_bytes/=sib; index+=1
    return f"{size_in_bytes:.2f} {suffixes[index]}"

def mountedornot(mountpoint,debug=0):
    founded=False
    with open('/proc/mounts') as fd:
        while (line:=fd.readline()) and not founded:
            if mountpoint in line: founded=True
    return founded

def parse_borg_size(s):
    s=s.strip()
    for unit,mult in [('TB',10**12),('GB',10**9),('MB',10**6),('kB',10**3),('B',1)]:
        if s.endswith(unit):
            try: return int(float(s[:-len(unit)].strip())*mult)
            except (ValueError,TypeError): return None
    return None

def parse_diff_line(line):
    line=line.rstrip()
    if not line: return None
    m=re.match(r'^added\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'added','size_before':None,'size_after':parse_borg_size(m.group(1)),'path':m.group(2)}
    m=re.match(r'^removed\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'removed','size_before':parse_borg_size(m.group(1)),'size_after':None,'path':m.group(2)}
    m=re.match(r'^modified\s+\+([\d.]+\s+\w+)\s+-([\d.]+\s+\w+)\s+(.+)$',line)
    if m: return {'change_type':'modified','size_before':parse_borg_size(m.group(2)),'size_after':parse_borg_size(m.group(1)),'path':m.group(3)}
    m=re.match(r'^([A-Z])\s+(.+)$',line)
    if m: return {'change_type':m.group(1),'size_before':None,'size_after':None,'path':m.group(2)}
    return None

def _bkp_parse_list(stderr):
    entries=[]
    for i in stderr:
        if isinstance(i,dict):
            if i.get('name')=='borg.output.list' or i.get('type')=='file_status':
                if i.get('type')=='file_status':
                    status=i.get('status',''); path=i.get('path','')
                else:
                    msg=i.get('message','')
                    if len(msg)>=3 and msg[1]==' ': status,path=msg[0],msg[2:]
                    else: continue
                ct=_BKP_STATUS_MAP.get(status)
                if ct and path: entries.append({'change_type':ct,'path':path,'size_before':None,'size_after':None})
        elif isinstance(i,str):
            s=i.strip()
            if len(s)>=3 and s[1]==' ' and s[0] in _BKP_STATUS_MAP:
                entries.append({'change_type':_BKP_STATUS_MAP[s[0]],'path':s[2:],'size_before':None,'size_after':None})
    return entries

def _bkp_is_list_entry(i):
    if isinstance(i,dict): return i.get('name')=='borg.output.list' or i.get('type')=='file_status'
    if isinstance(i,str):
        s=i.strip()
        return len(s)>=3 and s[1]==' ' and s[0] in _BKP_STATUS_MAP
    return False

def _borg_extract_args(bid,ftor):
    base=['extract','--numeric-owner','--exclude','*/log/*',f'::{bid}']
    if '*' in ftor or '?' in ftor: base+=[f'--pattern=sh:{ftor}']
    else: base.append(ftor)
    return base

def _is_tar_dest(path):
    return path.endswith('.tar') or path.endswith('.tgz') or path.endswith('.tar.gz')

def _print_boex_stderr(rb):
    for i in rb['stderr']:
        if isinstance(i,dict):
            lvl=i.get('levelname','INFO')
            if lvl not in ('DEBUG',): print(f"[{lvl}] {i.get('message',i)}",file=sys.stderr)
        elif isinstance(i,str) and i.strip(): print(i,file=sys.stderr)

def d2DateNSince(datepourrie):
    from datetime import datetime
    now=datetime.now()
    datelisible=datetime.strptime(datepourrie,"%Y-%m-%dT%H:%M:%S.%f")
    since=(now-datelisible).total_seconds()/60/60
    return {'since':since,'date':datelisible.strftime("%Y/%m/%d %H:%M:%S")}

def prettyTabelise(tab):
    from prettytable import PrettyTable
    clefs={}; serrure=0
    for i in tab.keys():
        for j in tab[i].keys():
            if j not in clefs: clefs[j]=serrure; serrure+=1
    t=PrettyTable(clefs.keys())
    for i in tab.keys():
        liste=[tab[i][j] if j in tab[i] else "" for j in clefs]
        t.add_row(liste)
    return t

def htmlTabelise(tabl,border=0,colnames=None,errhost=[]):
    ret="<table border='0'>\n  <tr>\n"
    if colnames is None:
        colnames=[]
        for y in tabl.keys():
            for x in tabl[y].keys(): colnames.append(x)
    for x in colnames:
        if x in errhost: ret+=f"    <th colspan=1 style='background:#FF6161;'>{x}</td><td style='width:20px;background:#FF6161;'></th>\n"
        else: ret+=f"    <th colspan=1 style='background:#00A4E6;'>{x}</td><td style='width:20px;background:#00A4E6;'></th>\n"
    ret+="    </tr>\n"
    blue=0; listy=len(tabl.keys())
    for y in tabl.keys():
        ret+='  <tr>\n'; listy-=1; concol=0; colstyl=""
        for x in colnames:
            val=""
            if concol: colstyl='text-align:right;'
            if x in tabl[y]: val=tabl[y][x]
            if listy==0: ret+=f"    <td colspan=1 style='{colstyl}'><em>{val}</em></td><td style='width:20px;'></td>\n"
            elif val in errhost: ret+=f"    <td colspan=1 style='{colstyl}background:#FF6161;'>{val}</td><td style='width:20px;background:#FF6161;'></td>\n"
            elif blue: ret+=f"    <td colspan=1 style='{colstyl}background:#BEEDFF;'>{val}</td><td style='width:20px;background:#BEEDFF;'></td>\n"
            else: ret+=f"    <td colspan=1 style='{colstyl}'>{val}</td><td style='width:20px;'></td>\n"
            concol+=1
        ret+='    </tr>\n'
        blue=0 if blue else 1
    ret+='</table>\n'
    return ret

def filtrer_lignes(tableau,X):
    toutes_cles=list(tableau.keys())
    if X>len(toutes_cles): cles_a_conserver=toutes_cles
    else: cles_a_conserver=toutes_cles[:2]+toutes_cles[-X:]
    return {cle:tableau[cle] for cle in cles_a_conserver}

def _snap_notin(date_from='',date_to=''):
    conds=[]
    if date_from: conds.append('d.archive_new_date>=?')
    if date_to: conds.append('d.archive_new_date<=?')
    extra=(' AND '+' AND '.join(conds)) if conds else ''
    return f"AND NOT EXISTS(SELECT 1 FROM diff_index d WHERE d.nick=archive_snapshot_v.nick AND d.path=archive_snapshot_v.path{extra})"

def _snap_params(af_params,archive_from,archive_to):
    date_from=date_to=''
    if archive_from and archive_from!='ALL' and af_params: date_from=af_params[0]
    if archive_to and len(af_params)>=(2 if date_from else 1): date_to=af_params[-1]
    return date_from,date_to

def _duidx_path_key(path,depth):
    parts=path.split('/')
    return '/'.join(parts[:depth+1]) if depth<len(parts) else path

def _duidx_add(totals,key,ct,sz):
    k=(key,ct)
    if k not in totals: totals[k]=[0,0]
    totals[k][0]+=1; totals[k][1]+=(sz or 0)

def _duidx_merge(totals):
    merged={}
    for (pk,ct),(cnt,sz) in totals.items():
        eff='added' if ct in ('added','modified','C','B','T') else ct
        k=(pk,eff)
        if k not in merged: merged[k]=[0,0]
        merged[k][0]+=cnt; merged[k][1]+=sz
    return merged

def _duidx_sort_key(pk,merged,sort_by,reverse):
    if sort_by=='chemin': return pk
    idx=_DUIDX_COL_KEYS.index(sort_by) if sort_by in _DUIDX_COL_KEYS else 0
    sz=merged.get((pk,_DUIDX_COL_KEYS[idx]),[0,0])[1]
    return -sz if reverse else sz

def _duidx_fmt(cnt,sz):
    return f"{cnt} / {convert_octets_readable(sz)}" if cnt else '—'

def _duidx_print(totals,label,grouped,sort_by='chemin',reverse=False,as_json=False):
    if not totals:
        print("Aucune donnée." if not as_json else '{}'); return
    if grouped:
        merged=_duidx_merge(totals)
        paths=sorted(set(pk for pk,_ in merged),
                     key=lambda pk:_duidx_sort_key(pk,merged,sort_by,reverse),
                     reverse=(reverse if sort_by!='chemin' else False))
        totcol={ck:[0,0] for ck in _DUIDX_COL_KEYS}
        rows_data=[]
        for pk in paths:
            entry={'chemin':pk}
            for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES):
                cnt,sz=merged.get((pk,ck),[0,0])
                entry[cn]={'nb':cnt,'taille':sz}
                totcol[ck][0]+=cnt; totcol[ck][1]+=sz
            rows_data.append(entry)
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{cn:{'nb':totcol[ck][0],'taille':totcol[ck][1]} for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES)}}
            print(json.dumps(out,ensure_ascii=False,indent=2)); return
        from prettytable import PrettyTable
        t=PrettyTable(['chemin']+_DUIDX_COL_NAMES)
        t.align['chemin']='l'
        for cn in _DUIDX_COL_NAMES: t.align[cn]='r'
        for entry in rows_data:
            t.add_row([entry['chemin']]+[_duidx_fmt(entry[cn]['nb'],entry[cn]['taille']) for cn in _DUIDX_COL_NAMES])
        t.add_row(['---']+['---']*len(_DUIDX_COL_NAMES))
        t.add_row(['TOTAL']+[_duidx_fmt(totcol[ck][0],totcol[ck][1]) for ck in _DUIDX_COL_KEYS])
    else:
        order=_DUIDX_TYPE_ORDER
        rows_data=[]
        for (pk,ct),(cnt,sz) in sorted(totals.items(),key=lambda x:(order.index(x[0][1]) if x[0][1] in order else 99)):
            rows_data.append({'type':ct,'nb':cnt,'taille':sz})
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{'nb':sum(r['nb'] for r in rows_data),'taille':sum(r['taille'] for r in rows_data)}}
            print(json.dumps(out,ensure_ascii=False,indent=2)); return
        from prettytable import PrettyTable
        t=PrettyTable(['type','nb','taille'])
        t.align['type']='l'; t.align['taille']='r'
        total_count=total_size=0
        for r in rows_data:
            t.add_row([r['type'],r['nb'],convert_octets_readable(r['taille']) if r['taille'] else '—'])
            total_count+=r['nb']; total_size+=r['taille']
        t.add_row(['---','---','---'])
        t.add_row(['TOTAL',total_count,convert_octets_readable(total_size)])
    if label: print(f"Pattern : {label}")
    print(t)

