        def _db_migrate_resume_validates_legacy_rows():
            """Revue : l'échantillon de validation ne couvrait que les lignes migrées PENDANT l'invocation
            courante. Sur une reprise (interruption puis relance), une ligne déjà migrée avant l'interruption
            et corrompue entre-temps ne serait jamais revalidée avant le commit final -> corruption silencieuse.
            Scénario : table1 (snapshot_file) intégralement migrée, table2 (diff_index) partiellement migrée,
            interruption simulée, corruption d'une ligne de table1 (déjà migrée, donc PAS revue par cette
            invocation sauf via l'échantillon 'legacy'), reprise -> doit être détectée (code 2, jamais commitée
            en siv1)."""
            b,paths=_db5_env('m16')
            p=b.db.get_diff_db('m16')
            globals()['_MIGRATE_BATCH']=3
            orig_encode=PathCodec.encode; calls=[0]
            def _boom(self,path):
                calls[0]+=1
                # snapshot_file=24 lignes (8 lots de 3) puis diff_index=6 lignes : 1er lot (3) committé,
                # interruption au milieu du 2e lot de diff_index (table2 partielle, table1 complète).
                if calls[0]==29: raise RuntimeError('simulated crash: table1 complete, table2 partial')
                return orig_encode(self,path)
            PathCodec.encode=_boom
            try:
                try: b.db_encrypt('m16',confirm=True)
                except RuntimeError: pass
            finally:
                PathCodec.encode=orig_encode
                globals()['_MIGRATE_BATCH']=saved_batch
            h=_db5_header(b,'m16')
            if h is None or h['path_enc']!='migrating': return False
            c=sqlite3.connect(p)
            row=c.execute("SELECT id,path FROM snapshot_file WHERE nick=? ORDER BY id LIMIT 1",('m16',)).fetchone()
            rid,stored=row
            tampered=('B' if stored[0]!='B' else 'C')+stored[1:]  # casse le tag SIV -> decode() doit lever
            c.execute("UPDATE snapshot_file SET path=? WHERE id=?",(tampered,rid)); c.commit(); c.close()
            r=b.db_encrypt('m16',confirm=True)  # reprise : la corruption est dans table1, déjà migrée avant l'interruption
            return r==2 and _db5_mode(b,'m16')=='migrating'  # jamais commitée en siv1 malgré la corruption
        check("DbEncrypt repris après interruption : la validation finale relit aussi les lignes migrées AVANT la reprise (échantillon 'legacy'), détecte une corruption qui y a été introduite",_db_migrate_resume_validates_legacy_rows)
        def _rc_atomic_write():
            """cfgwrite (1.0.123) : un crash pendant l'écriture laisse le rc INTACT (plus de troncature en
            place), aucun temporaire résiduel ; droits du rc existant conservés, 0600 à la création."""
            rc=os.path.join(tmp,'atomic.rc'); new=os.path.join(tmp,'atomic-new.rc')
            with open(rc,'w') as f: f.write('[a]\nBORG_PASSPHRASE=origine\n')
            os.chmod(rc,0o640)
            class _Boom:
                def write(self,f): f.write('partiel'); raise RuntimeError('crash simulé')
            try: _atomic_write_rc(rc,_Boom())
            except RuntimeError: pass
            intact=open(rc).read()=='[a]\nBORG_PASSPHRASE=origine\n'
            no_tmp=not [f for f in os.listdir(tmp) if f.startswith('.atomic.rc.')]
            c=configparser.ConfigParser(); c.optionxform=str; c['a']={'BORG_PASSPHRASE':'nouvelle'}
            _atomic_write_rc(rc,c); _atomic_write_rc(new,c)
            return (intact and no_tmp and 'nouvelle' in open(rc).read()
                    and stat.S_IMODE(os.stat(rc).st_mode)==0o640 and stat.S_IMODE(os.stat(new).st_mode)==0o600)
        check("cfgwrite atomique : crash en cours d'écriture -> rc intact, pas de temporaire ; droits conservés (0600 à la création)",_rc_atomic_write)
        def _migration_atomic():
            """_executescript_atomic (1.0.124) : échec APRÈS un DROP TABLE -> ROLLBACK, table et données
            intactes, aucune table temporaire laissée ; succès -> tout appliqué."""
            c=sqlite3.connect(os.path.join(tmp,'migr.db'))
            try:
