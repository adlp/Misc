def _atomic_write_rc(cfgfile,config):
    """Réécrit le rc sans jamais le laisser tronqué (1.0.123) : il contient les passphrases, un crash en
    cours d'écriture (ancien `O_TRUNC` en place) le perdait. Fichier temporaire dans le MÊME répertoire
    (même système de fichiers, `os.replace` atomique), `fsync`, puis remplacement. Droits : ceux du rc
    existant (0600 s'il n'existe pas) ; propriétaire conservé si possible (root réécrivant le rc d'un
    autre compte). Lien symbolique : c'est sa CIBLE qui est remplacée, le lien reste en place."""
    import tempfile
    target=os.path.realpath(cfgfile)
    try: st=os.stat(target)
    except FileNotFoundError: st=None
    fd,tmp=tempfile.mkstemp(dir=os.path.dirname(target),prefix='.'+os.path.basename(target)+'.')
    try:
        os.fchmod(fd,(st.st_mode&0o7777) if st else 0o600)
        if st and (st.st_uid,st.st_gid)!=(os.getuid(),os.getgid()):
            try: os.fchown(fd,st.st_uid,st.st_gid)
            except PermissionError: pass  # non-root : le rc devient le sien, droits identiques
        with os.fdopen(fd,'w') as f:
            config.write(f); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,target)
    except BaseException:
        try: os.unlink(tmp)
        except FileNotFoundError: pass
        raise
    try:  # rend le renommage durable (métadonnées du répertoire)
        dfd=os.open(os.path.dirname(target),os.O_RDONLY)
        try: os.fsync(dfd)
        finally: os.close(dfd)
    except OSError: pass

class BorgHelperDB:
    """SQLite layer: cache.db and diff.db operations. No borg calls."""

    def __init__(self,cache_dir,db_prefix,cfg_reader=None):
        self.cache_dir=cache_dir
        self.db_prefix=db_prefix
        self._cfg_reader=cfg_reader  # callable(nick) -> configparser section | None
        self._hist_migrated=set()   # diff.db déjà ouvertes (migration vers history.db tentée) par ce processus
        self._hist_ready=set()      # history.db dont le schéma est garanti dans ce processus
        if cfg_reader is not None:
            _DB_CFG_READERS[os.path.realpath(cache_dir)]=cfg_reader  # résolution paresseuse de la passphrase par _open_db

    def get_db_nick(self,nick):
        if self._cfg_reader:
            cfg=self._cfg_reader(nick)
            if cfg is not None and 'DB_NAME' in cfg:
                return re.sub(r'[^a-zA-Z0-9_-]','_',cfg['DB_NAME'])
        return nick

    def get_cache_db(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self.get_db_nick(nick)}-cache.db")

    def get_diff_db(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self.get_db_nick(nick)}-diff.db")

    def get_history_db(self,nick):
        return _history_path_for(self.get_diff_db(nick))

    def history_path(self,nick):
        """Chemin de history.db pour un LECTEUR (1.0.139) : ouvre d'abord diff.db (ensure_diff_db, sans jamais la
        créer), ce qui migre ses mesures si elle vient d'une version antérieure (AD-8 : migration à toute
        ouverture) — une fois par processus et par base. Ne crée jamais history.db."""
        diff=self.get_diff_db(nick)
        if diff not in self._hist_migrated:
            if os.path.exists(diff):
                # Base occupée ou corrompue : ensure_diff_db a déjà affiché son message et fait sys.exit — un LECTEUR de
                # mesures (Status -n ALL, get_repo_stats…) continue sur history.db telle quelle ; nouvel essai plus tard.
                try: self.ensure_diff_db(diff,create=False)
                except SystemExit: return self.get_history_db(nick)
            self._hist_migrated.add(diff)
        return self.get_history_db(nick)

    def _repo_key(self,nick):
        cfg=self._cfg_reader(nick) if self._cfg_reader else None
        if cfg and 'BORG_REPO' in cfg:
            return re.sub(r'[^a-zA-Z0-9_-]','_',cfg['BORG_REPO'])
        return self.get_db_nick(nick)

    def _pid_lock_path(self,nick,suffix):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self._repo_key(nick)}-{suffix}.lock")

    def _set_pid_lock(self,path):
        # Écriture atomique (1.0.138) : open('w') tronque puis écrit ; un lecteur (_check_pid_lock, sondé à chaque
        # tranche de _swap_db et par le moniteur d'Index) pouvait lire un fichier vide entre les deux, le prendre
        # pour un verrou orphelin et le supprimer — la protection d'un Bkp tombait.
        tmp=f"{path}.{os.getpid()}.tmp"
        try:
            with open(tmp,'w') as f: f.write(str(os.getpid()))
            os.replace(tmp,path)
        except OSError:
            try: os.unlink(tmp)
            except OSError: pass

    def _clear_pid_lock(self,path):
        try: os.unlink(path)
        except OSError: pass

    @staticmethod
    def _lock_holder(path):
        """'me' | 'alive' | 'dead' | 'gone' (1.0.141). Fichier vide ou illisible de moins de 2 s : 'alive' (en cours
        d'écriture par son créateur) ; PID d'un autre utilisateur (PermissionError) : vivant, sauf PID repris.
        PID repris (1.0.148, story 11 A9) : processus démarré plus de 60 s après la dernière écriture du fichier (porteur
        tué par SIGKILL, numéro réattribué, y compris au processus courant) -> 'dead' ; démarrage inconnu : inchangé.
        Marge de 60 s : _pid_start_time suit l'horloge murale (btime), un saut de quelques secondes ne tue aucun verrou
        vivant. PID ≤ 0 : 'dead'."""
        try:
            with open(path) as f: txt=f.read().strip(); mt=os.fstat(f.fileno()).st_mtime   # PID et date du même fichier
        except FileNotFoundError: return 'gone'
        except OSError: return 'alive'
        try: pid=int(txt)
        except ValueError: return 'alive' if time.time()-mt<2 else 'dead'
        if pid<=0 or pid>=2**31: return 'dead'   # os.kill(0|-1) viserait un groupe ; au-delà : OverflowError
        if pid!=os.getpid():
            try: os.kill(pid,0)
            except PermissionError: pass
            except OSError: return 'dead'
        started=_pid_start_time(pid)
        if started is not None and started>mt+60: return 'dead'
        return 'me' if pid==os.getpid() else 'alive'

    def _check_pid_lock(self,path):
        h=self._lock_holder(path)
        if h=='alive': return True
        if h=='dead':
            try: os.unlink(path)
            except OSError: pass
        return False

    # Verrou prioritaire à porteurs multiples (1.0.145, story 8 R1) : un fichier par processus '<priority.lock>.<pid>'.
    # Un Restore qui finit pendant un Bkp du même dépôt ne retire que le sien — celui du Bkp reste. L'ancien fichier
    # unique '<priority.lock>' est encore lu (processus d'avant la mise à jour), jamais plus écrit.
    def _priority_lock_path(self,nick): return self._pid_lock_path(nick,'priority')
    def _priority_holder_path(self,nick,pid=None): return f"{self._priority_lock_path(nick)}.{pid or os.getpid()}"
    def set_priority_lock(self,nick): self._set_pid_lock(self._priority_holder_path(nick))
    def clear_priority_lock(self,nick):
        self._clear_pid_lock(self._priority_holder_path(nick))
        legacy=self._priority_lock_path(nick)
        if self._lock_holder(legacy)=='me': self._clear_pid_lock(legacy)
    def check_priority_lock(self,nick):
        """True si un autre processus prioritaire (Bkp/Restore/Prune/DelBkp) vivant tient le verrou — jamais le sien.
        Fichiers de porteurs morts retirés au passage."""
        legacy=self._priority_lock_path(nick)
        held=self._check_pid_lock(legacy)
        for p in glob.glob(glob.escape(legacy)+'.*'):
            if not p[len(legacy)+1:].isdigit(): continue   # '.tmp' de _set_pid_lock
            if self._check_pid_lock(p): held=True   # PID repris : 'dead' par _lock_holder (1.0.148), fichier retiré
        return held

    # Résultat du dernier Index par nick (1.0.149, story 12 A4) : fichier JSON jetable dans CACHE_DIR, jamais history.db.
    def index_last_path(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{re.sub(r'[^a-zA-Z0-9_-]','_',nick)}-index-last.json")
    def write_index_last(self,nick,rec):
        """Écriture atomique (fichier temporaire 0600 puis os.replace). Lève OSError : l'appelant n'en fait qu'un
        avertissement."""
        path=self.index_last_path(nick); tmp=f"{path}.{os.getpid()}.tmp"
        try:
            fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
            with os.fdopen(fd,'w',encoding='utf-8') as f: json.dump(rec,f,ensure_ascii=False)
            os.replace(tmp,path)
        except (OSError,ValueError):
            with contextlib.suppress(OSError): os.unlink(tmp)
            raise
    def read_index_last(self,nick):
        """dict ou None (absent, illisible, JSON invalide ou pas un objet) — jamais d'exception, rien créé."""
        try:
            with open(self.index_last_path(nick),encoding='utf-8') as f: rec=json.load(f)
        except (OSError,ValueError): return None
        return rec if isinstance(rec,dict) else None

    def _report_running_lock_path(self,nick): return self._pid_lock_path(nick,'report-running')
    def set_report_running_lock(self,nick): self._set_pid_lock(self._report_running_lock_path(nick))
    def clear_report_running_lock(self,nick): self._clear_pid_lock(self._report_running_lock_path(nick))
    def check_report_running(self,nick): return self._check_pid_lock(self._report_running_lock_path(nick))

    def _index_running_lock_path(self,nick): return self._pid_lock_path(nick,'index-running')
    def set_index_running_lock(self,nick): self._set_pid_lock(self._index_running_lock_path(nick))
    def clear_index_running_lock(self,nick): self._clear_pid_lock(self._index_running_lock_path(nick))
    def check_index_running(self,nick): return self._check_pid_lock(self._index_running_lock_path(nick))

    # Prise exclusive (1.0.141, AD-4 amendé) : un seul Index par dépôt. os.link d'un fichier temporaire déjà rempli :
    # création atomique ET contenu complet (jamais un fichier vide lu par un autre processus). Verrou d'un PID mort
    # ou illisible : retiré, nouvel essai. Réentrant pour le même processus (Index de fin de Bkp).
    def _acquire_pid_lock_excl(self,path):
        me=str(os.getpid())
        for _ in range(4):
            tmp=f"{path}.{me}.tmp"
            try:
                with open(tmp,'w') as f: f.write(me)
                try: os.link(tmp,path); return True
                except FileExistsError: pass
                except OSError:
                    # Système de fichiers sans liens physiques : création exclusive puis PID écrit aussitôt (un fichier
                    # vide de moins de 2 s est vu 'alive' par _lock_holder, jamais retiré).
                    try:
                        fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
                        with os.fdopen(fd,'w') as f: f.write(me)
                        return True
                    except FileExistsError: pass
            except OSError: return False
            finally:
                try: os.unlink(tmp)
                except OSError: pass
            h=self._lock_holder(path)
            if h=='me': return True
            if h=='alive': return False
            if h=='gone': continue
            # Verrou orphelin : mis de côté par rename (atomique) puis revérifié, jamais un unlink du chemin — un autre
            # processus peut l'avoir repris entre la lecture et le retrait ; dans ce cas on le lui rend.
            aside=f"{path}.stale.{me}"
            try: os.rename(path,aside)
            except OSError: continue
            if self._lock_holder(aside) in ('alive','me'):
                try: os.link(aside,path)
                except OSError: pass
                try: os.unlink(aside)
                except OSError: pass
                return False
            try: os.unlink(aside)
            except OSError: pass
        return False

    def _release_own_lock(self,path):
        """Retire le verrou seulement s'il est à ce processus (jamais celui d'un autre, pris depuis)."""
        try:
            with open(path) as f:
                if f.read().strip()!=str(os.getpid()): return
            os.unlink(path)
        except OSError: pass

    def _owns_lock(self,path):
        # 1.0.148 : même verdict que _lock_holder — un fichier ancien portant notre PID (repris) n'est pas à nous, sinon
        # index() sauterait le tour d'Index pendant qu'un autre processus, qui le voit mort, le prend.
        return self._lock_holder(path)=='me'

    def acquire_index_running_lock(self,nick,wait=0):
        """Tour d'Index exclusif ; wait : secondes d'attente maximale si un autre le tient (Index de fin de Bkp)."""
        end=time.monotonic()+wait
        while True:
            if self._acquire_pid_lock_excl(self._index_running_lock_path(nick)): return True
            if time.monotonic()>=end: return False
            time.sleep(0.5)
    def release_index_running_lock(self,nick): self._release_own_lock(self._index_running_lock_path(nick))
    def index_running_owned(self,nick): return self._owns_lock(self._index_running_lock_path(nick))

    def _index_paused_lock_path(self,nick): return self._pid_lock_path(nick,'index-paused')
    def acquire_index_paused_lock(self,nick): return self._acquire_pid_lock_excl(self._index_paused_lock_path(nick))
    def release_index_paused_lock(self,nick): self._release_own_lock(self._index_paused_lock_path(nick))
    def check_index_paused(self,nick): return self._check_pid_lock(self._index_paused_lock_path(nick))

    def wait_index_idle(self,nick,timeout=120):
        """Attend que l'Index en cours sur ce dépôt libère ses verrous borg (max timeout s)."""
        waited=0
        while waited<timeout:
            if not self.check_index_running(nick): return   # 1.0.141 : même lecture que les autres (_lock_holder)
            if waited==0: printer(f"  {nick}: indexation en cours — report en attente (max {timeout}s)...")
            time.sleep(1); waited+=1
        printer(f"  [WARN] Timeout attente Index ({timeout}s) — lancement quand même")

    def _index_pending_lock_path(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self.get_db_nick(nick)}-index-pending.lock")

    def set_index_pending_lock(self,nick):
        try:
            with open(self._index_pending_lock_path(nick),'w') as f: f.write('')
        except OSError: pass

    def clear_index_pending_lock(self,nick):
        try: os.unlink(self._index_pending_lock_path(nick))
        except OSError: pass

    def check_index_pending_lock(self,nick):
        return os.path.exists(self._index_pending_lock_path(nick))

    @staticmethod
    def _archive_view_state(conn):
        """'ok' | 'absent' | 'mismatch' | 'newer' (schéma de la base > DIFF_DB_SCHEMA_VERSION : code plus ancien
        que la base, rien à comparer). Comparaison du texte stocké par SQLite (sqlite_master.sql, verbatim)
        à _ARCHIVE_SNAPSHOT_V_SQL, espaces et casse normalisés."""
        try: row=conn.execute("SELECT value FROM db_meta WHERE key='schema_version'").fetchone()
        except sqlite3.OperationalError: row=None
        if row and int(row[0])>DIFF_DB_SCHEMA_VERSION: return 'newer'
        v=conn.execute("SELECT sql FROM sqlite_master WHERE type='view' AND name='archive_snapshot_v'").fetchone()
        if v is None: return 'absent'
        return 'ok' if _sql_norm(v[0])==_sql_norm(_ARCHIVE_SNAPSHOT_V_SQL) else 'mismatch'

    @classmethod
    def _repair_archive_view(cls,conn):
        cls._executescript_atomic(conn,"DROP VIEW IF EXISTS archive_snapshot_v;\n"+_ARCHIVE_SNAPSHOT_V_SQL+";")

    def archive_view_check(self,db_path,repair=False):
        """Contrôle (et réparation si repair=True et 'mismatch'/'absent') de la vue d'une base existante,
        sans passphrase (la vue ne porte aucun chemin). Pour borgHelperWWW, qui tourne en continu : -> état
        AVANT réparation, ou 'error: …'."""
        try:
            conn=_open_db(db_path,nick=None,role='admin' if repair else 'read')
            try:
                st=self._archive_view_state(conn)
                if repair and st in ('mismatch','absent'): self._repair_archive_view(conn)
                return st
            finally: conn.close()
        except sqlite3.Error as e:
            return f"error: {e}"

    def _check_set_meta(self,conn,schema_version,db_path,base_version=None):
        """schema_version = version maximale comprise ; base_version = version écrite dans une base
        plain (défaut : schema_version). Une base plain n'est réécrite qu'à base_version — égale à la maximale
        pour diff.db depuis 1.0.139 (version 10), et pour history.db."""
        if base_version is None: base_version=schema_version
        row=conn.execute("SELECT value FROM db_meta WHERE key='schema_version'").fetchone()
        stored=int(row[0]) if row else 0
        if stored>schema_version:
            raise SchemaVersionError(
                f"({db_path}) schéma DB v{stored} > attendu v{schema_version} — "
                "DB créée par une version plus récente de borgHelper, mettez à jour borgHelper.")
        # Story 1.5 : n'écrire (donc ne jamais avancer le mtime du fichier DB, chaque connexion
        # étant fermée avec checkpoint WAL) que si la valeur stockée diffère réellement — sinon un
        # appel en lecture pure invaliderait à tort toute empreinte de cache basée sur ce mtime
        # (voir borgHelperWWW, nouveau cache SQLite par périmètre).
        if stored<base_version:
            conn.execute("INSERT OR REPLACE INTO db_meta VALUES('schema_version',?)",(str(base_version),))
        ver_row=conn.execute("SELECT value FROM db_meta WHERE key='borghelper_version'").fetchone()
        stored_ver=ver_row[0] if ver_row else None
        if stored_ver!=Version:
            conn.execute("INSERT OR REPLACE INTO db_meta VALUES('borghelper_version',?)",(Version,))

    def ensure_cache_db(self,db_path,create=True):
        """create=False (AD-12) : appelants de lecture seule — si le fichier n'existe pas encore,
        ne rien créer (ni fichier, ni schéma, ni en-tête) et retourner tel quel ; l'appelant répond
        « non indexé »/« cache vide » comme si la base existait mais était vide. Si le fichier existe
        déjà, comportement inchangé (migrations/_check_set_meta). Seuls Index/Bkp/indexsnap gardent
        le défaut create=True (créateurs légitimes, AD-12)."""
        if not create and not _db_has_schema(db_path): return
        try:
            try: conn=_open_db(db_path,nick=None,role='admin',timeout=60)
            except sqlite3.OperationalError as e: _db_open_fail(db_path,e)
            _ensure_wal(conn)
            conn.executescript("""
                CREATE TABLE IF NOT EXISTS db_meta (
                    key   TEXT PRIMARY KEY,
                    value TEXT
                );
                CREATE TABLE IF NOT EXISTS cachejsonboexlm (
                    id           INTEGER PRIMARY KEY AUTOINCREMENT,
                    nom          TEXT NOT NULL,
                    lastmodified TEXT NOT NULL,
                    details      TEXT,
                    UNIQUE(nom, lastmodified)
                );
                CREATE INDEX IF NOT EXISTS idx_cache_nom ON cachejsonboexlm(nom);
            """)
            self._check_set_meta(conn,CACHE_DB_SCHEMA_VERSION,db_path,CACHE_DB_BASE_SCHEMA_VERSION)
            conn.commit(); conn.close()
        except sqlite3.DatabaseError as e:
            _db_schema_fail(db_path,e,'le cache')

    @staticmethod
    def _executescript_atomic(conn,script):
        """Migration de schéma en UNE transaction (1.0.124) : `executescript` seul valide chaque
        instruction à part — un crash entre `DROP TABLE x` et `ALTER TABLE x_new RENAME TO x` laissait
        diff.db sans la table. DDL SQLite transactionnel : tout ou rien, ROLLBACK sur erreur."""
        try:
            conn.executescript("BEGIN IMMEDIATE;\n"+script+"\nCOMMIT;")
        except BaseException:
            if conn.in_transaction:
                try: conn.execute("ROLLBACK")
                except sqlite3.Error: pass
            raise

