                psql,pprm,pyf=_psel_duidx(conn,sel)
                df,dt=_snap_params(af_params,archive_from,archive_to)
                snap_extra=[x for x in [df,dt] if x]
                def _acc(k,cnt,sz):
                    if k not in totals: totals[k]=[0,0]
                    totals[k][0]+=cnt; totals[k][1]+=(sz or 0)
                if pyf is None:  # agrégation en SQL (aucun prédicat de nom à exécuter en Python)
                    for ct,cnt,sz in conn.execute("SELECT change_type,COUNT(*),SUM(CASE WHEN change_type='removed' THEN size_before ELSE size_after END) FROM diff_index WHERE nick=?"+_wh(psql)+af_sql+" GROUP BY change_type",[n]+pprm+af_params):
                        _acc(('',ct),cnt,sz)
                    row=conn.execute("SELECT COUNT(*),SUM(size) FROM archive_snapshot_v WHERE nick=?"+_wh(psql)+" "+_snap_notin(df,dt),[n]+pprm+snap_extra).fetchone()
                    if row and row[0]: _acc(('','présent'),row[0],row[1])
                else:  # prédicat de nom en Python (base chiffrée) : agrégation sur chemins décodés
                    for ct,path,sz in conn.execute("SELECT change_type,path,CASE WHEN change_type='removed' THEN size_before ELSE size_after END FROM diff_index WHERE nick=?"+_wh(psql)+af_sql,[n]+pprm+af_params):
                        if pyf(_path_decode(conn,path)): _acc(('',ct),1,sz)
                    for path,sz in conn.execute("SELECT path,size FROM archive_snapshot_v WHERE nick=?"+_wh(psql)+" "+_snap_notin(df,dt),[n]+pprm+snap_extra):
                        if pyf(_path_decode(conn,path)): _acc(('','présent'),1,sz)
                conn.close()
            except DbCodecError as e: _codec_fail(n,e,conn)
            except sqlite3.Error as e:
                _close_quiet(conn)
                printer(f"SQLite error ({db_path}): {e}")
        return totals

    def _duidx_collect_raw(self,nick,sel,archive_from=None,archive_to=None):
        """Story 1.4 : mêmes deux requêtes SQL que _duidx_collect() (diff_index + archive_snapshot_v,
        même sélection de chemins/archive), mais SANS agrégation par key_fn — une ligne JSON par chemin,
        jamais groupée. Seul moyen correct de filtrer par périmètre de chemin a posteriori
        (borgHelperWWW) : _duidx_collect()/_duidx_collect_global() agrègent déjà en SQL/Python avant
        qu'un filtre puisse s'appliquer, ce qui peut couper une frontière de périmètre au milieu
