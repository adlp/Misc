def glob_args(cfg,form='list',archives=False):
    """Arguments de filtre d'archives d'un nick — SEUL lecteur de GLOB_ARCH (AD-11). GLOB_ARCH absent ou vide : aucun
    argument (toutes les archives du dépôt), sauf archives=True -> motif '*' : `borg info` sans filtre ne décrit que le
    dépôt, sans la liste 'archives'. form='list' -> ['--glob-archives', motif] ; 'eq' -> ['--glob-archives=motif']."""
    g=(cfg.get('GLOB_ARCH') or '').strip() if cfg is not None else ''
    if not g:
        name=getattr(cfg,'name',None)
        if name and not is_external(cfg) and name not in _GLOB_WARNED:
            _GLOB_WARNED.add(name)
            printer(f"[WARN] {name}: GLOB_ARCH absent pour un nick interne — toutes les archives du dépôt, y compris celles "
                    "d'autres hôtes (Prune refusé)")
        if not archives: return []
        g='*'
    return [f'--glob-archives={g}'] if form=='eq' else ['--glob-archives',g]

