    elif cmd=='difftop':
        _depth=int(options.get('-p','3'))
        _topn=int(options.get('-N','10'))
        if '-j' in options and len(nick.split(','))>1:
            printer("DiffTop -j ne supporte qu'un seul nick à la fois (pas nick=a,b ni ALL avec plusieurs nicks configurés)")
            usage(cmd)
        for n in nick.split(','):
            bh.difftop(n,bkp=options.get('-b'),depth=_depth,topn=_topn,debug=debug,as_json=('-j' in options))
    elif cmd=='idxpurge':
        _dryrun='-D' in options
        for n in nick.split(','):
            bh.idxpurge(n,pattern=options.get('-x'),dryrun=_dryrun,debug=debug)
    elif cmd=='dbencrypt':
        _dryrun='-D' in options; _yes='-y' in options; errcmd=0
        _nicks=nick.split(',') if nick and nick!='ALL' else bh.borg.cfgreadnicks(debug).split(',')
        for n in _nicks:
            r=bh.db_encrypt(n,dryrun=_dryrun,confirm=_yes,debug=debug)
            if r: errcmd=r
        sys.exit(errcmd)
    elif cmd=='dbdecrypt':
        _dryrun='-D' in options; _yes='-y' in options; errcmd=0
        _nicks=nick.split(',') if nick and nick!='ALL' else bh.borg.cfgreadnicks(debug).split(',')
        for n in _nicks:
            r=bh.db_decrypt(n,dryrun=_dryrun,confirm=_yes,debug=debug)
            if r: errcmd=r
        sys.exit(errcmd)
    elif cmd=='dbrekey':
        _yes='-y' in options; errcmd=0
        _nicks=nick.split(',') if nick and nick!='ALL' else bh.borg.cfgreadnicks(debug).split(',')
        for n in _nicks:
            r=bh.db_rekey(n,confirm=_yes,debug=debug)
            if r: errcmd=r
        sys.exit(errcmd)
    elif cmd=='dbstatus':
        _nicks=nick.split(',') if nick and nick!='ALL' else bh.borg.cfgreadnicks(debug).split(',')
        for n in _nicks:
            bh.db_status(n,debug=debug)
