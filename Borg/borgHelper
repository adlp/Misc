                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_archive_stats(self,nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles,db_path=None):
        """Upsert des statistiques RÉGÉNÉRABLES d'une archive (diff.db). Les mesures du Bkp (C/E, taille dédupliquée
        à la création) vont dans history.db (store_archive_measure, 1.0.139) : un rattrapage d'Index ne les touche
        donc jamais. deduplicated_size : valeur du Bkp ou de borg info — l'affichage préfère la mesure."""
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.execute("INSERT INTO archive_stats (nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles) "
                             "VALUES (?,?,?,?,?,?,?,?) ON CONFLICT(nick,archive) DO UPDATE SET "
                             "archive_date=excluded.archive_date,duration=excluded.duration,original_size=excluded.original_size,"
                             "compressed_size=excluded.compressed_size,deduplicated_size=excluded.deduplicated_size,nfiles=excluded.nfiles",
                             (nick,archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    # ── history.db (1.0.139, AD-7) : mesures non régénérables, ouvertes sans nick (aucun chemin, jamais chiffrée) ──

    def _hist(self,nick,db_path=None,create=False):
        """history.db à utiliser : db_path explicite, sinon celle du nick (après migration éventuelle de diff.db,
        history_path). create=True (écrivain qui crée : Bkp, Prune, refresh d'Index) : schéma garanti. Sinon (lecteur,
        réclamation du watcher) : None si le fichier n'existe pas — jamais de création sur une lecture."""
        if db_path is None: db_path=self.history_path(nick)
        if create:
            self.ensure_history_db(db_path,create=True); return db_path
        return db_path if os.path.exists(db_path) else None

    def store_archive_measure(self,nick,archive,archive_date,deduplicated_size,changed_during_backup,read_errors,db_path=None):
        """Mesures d'une archive prises au Bkp (Bkp seul, AD-7) : taille dédupliquée à la création et C/E."""
        db_path=self._hist(nick,db_path,create=True)
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                conn.execute("INSERT OR REPLACE INTO archive_measure (nick,archive,archive_date,deduplicated_size,changed_during_backup,read_errors) "
                             "VALUES (?,?,?,?,?,?)",(nick,archive,archive_date or '',deduplicated_size,changed_during_backup,read_errors))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def get_archive_measures(self,nick,db_path=None):
        """{(archive, archive_date ou ''): {'deduplicated_size','changed_during_backup','read_errors'}} — {} si aucune."""
        db_path=self._hist(nick,db_path)
        if db_path is None: return {}
        try:
            conn=_open_db(db_path,nick=None,role='read')
            try:
                rows=conn.execute("SELECT archive,archive_date,deduplicated_size,changed_during_backup,read_errors "
                                  "FROM archive_measure WHERE nick=?",(nick,)).fetchall()
            finally: conn.close()
            out={(r[0],r[1]):{'deduplicated_size':r[2],'changed_during_backup':r[3],'read_errors':r[4]} for r in rows}
            # Repli (revue story 2) : clé (archive, None) = mesure retrouvée par le seul nom quand il est unique — une
            # archive_stats reconstruite peut porter une archive_date formatée autrement (ou absente) que celle du Bkp.
            names={}
            for r in rows: names.setdefault(r[0],[]).append(r)
            for n,rs in names.items():
                if len(rs)==1: out[(n,None)]=out[(n,rs[0][1])]
            return out
        except sqlite3.Error: return {}

    def delete_archive_measures(self,nick,keep=None,db_path=None):
        """Retire les mesures des archives disparues (keep = noms encore présents ; None ou vide = toutes). Rétention
        AD-7 : une mesure vit tant que son archive existe."""
        db_path=self._hist(nick,db_path)
        if db_path is None: return 0
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                if keep:
                    lst=list(keep); ph=','.join('?'*len(lst))
                    n=conn.execute(f"DELETE FROM archive_measure WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst).rowcount
                else: n=conn.execute("DELETE FROM archive_measure WHERE nick=?",(nick,)).rowcount
                conn.commit(); return n
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return 0

    def freeze_archive_chart(self,nick,rows,db_path=None):
        """Fige des lignes de graphique dans history.db (1.0.140, AD-7 amendé) — rows : dicts avec 'archive',
        'archive_date' (non vide, sinon ignorée), 'gone' (bool) et tout ou partie de _CHART_FIELDS. Une valeur
        figée non nulle n'est jamais écrasée par une valeur nulle ; gone ne repasse jamais à 0. Purge ensuite les
        lignes plus anciennes que STATS_RETENTION_MONTHS. Lève sqlite3.Error : l'appelant ne purge rien si le figeage
        a échoué (ordre figer puis purger, AD-9). Retourne le nombre de lignes écrites."""
        rows=[r for r in rows if r.get('archive_date')]
        if not rows: return 0
        db_path=self._hist(nick,db_path,create=True)
        cols=','.join(_CHART_FIELDS)
        upd=','.join(f"{c}=COALESCE(excluded.{c},{c})" for c in _CHART_FIELDS)
        months=int(self._stats_retention_months(nick))
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                conn.executemany(
                    f"INSERT INTO archive_chart (nick,archive,archive_date,{cols},gone) VALUES (?,?,?,{','.join('?'*len(_CHART_FIELDS))},?) "
                    f"ON CONFLICT(nick,archive,archive_date) DO UPDATE SET {upd},gone=MAX(gone,excluded.gone),frozen_at=datetime('now')",
                    [(nick,r['archive'],r['archive_date'])+tuple(r.get(c) for c in _CHART_FIELDS)+(1 if r.get('gone') else 0,) for r in rows])
                conn.execute("DELETE FROM archive_chart WHERE nick=? AND archive_date < "
                             f"strftime('%Y-%m-%dT%H:%M:%S','now','-{months} months')",(nick,))
                conn.commit(); return len(rows)
            finally: conn.close()
        return self._with_lock_retry(_do)

    def get_archive_chart(self,nick,db_path=None):
        """Lignes figées d'archive_chart dans la rétention STATS_RETENTION_MONTHS (bornée aussi à la lecture) :
        [{'archive','archive_date',*_CHART_FIELDS,'gone'}], [] si history.db ou la table est absente."""
        db_path=self._hist(nick,db_path)
        if db_path is None: return []
        try:
            conn=_open_db(db_path,nick=None,role='read')
            try:
                rows=conn.execute(f"SELECT archive,archive_date,{','.join(_CHART_FIELDS)},gone FROM archive_chart WHERE nick=? AND "
                                  f"archive_date >= strftime('%Y-%m-%dT%H:%M:%S','now','-{int(self._stats_retention_months(nick))} months')",
                                  (nick,)).fetchall()
            finally: conn.close()
        except sqlite3.Error: return []
        keys=('archive','archive_date')+_CHART_FIELDS+('gone',)
        return [dict(zip(keys,r)) for r in rows]

    # ── bkp_status (Story 1, spec-notifications-push) : exclusif à backup(), jamais Restore/Index/
    # Prune (AD-3). Aucune colonne `path` -> hors du périmètre du codec de chiffrement des chemins,
    # écritures/lectures directes, sans _write_mode_check ni _path_stored.

    def store_bkp_status_start(self,nick,run_id,db_path=None):
        """Écrite par backup(), juste après set_priority_lock, avant tout appel boex()."""
        db_path=self._hist(nick,db_path,create=True)
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                conn.execute("INSERT INTO bkp_status (nick,run_id,started_at) VALUES (?,?,datetime('now'))",(nick,run_id))
                # Rétention (1.0.127) : même STATS_RETENTION_MONTHS que les historiques — une sauvegarde
                # démarrée il y a plus de N mois est forcément terminée et notifiée depuis longtemps.
                conn.execute(f"DELETE FROM bkp_status WHERE nick=? AND started_at < datetime('now','-{int(self._stats_retention_months(nick))} months')",(nick,))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_bkp_status_finish(self,nick,run_id,result,db_path=None,changed_during_backup=None,read_errors=None):
        """Écrite par backup() à la fin normale, avant sys.exit(newretC) — result dérivé du même
        newretC qu'aujourd'hui ('success' si 0, sinon 'error'). changed_during_backup/read_errors
        (1.0.118) : statuts C/E de borg create --list, repris dans la notification push de fin."""
        db_path=self._hist(nick,db_path,create=True)
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                conn.execute("UPDATE bkp_status SET finished_at=datetime('now'),result=?,changed_during_backup=?,read_errors=? "
                             "WHERE nick=? AND run_id=?",(result,changed_during_backup,read_errors,nick,run_id))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def store_bkp_status_safety_net(self,nick,run_id,db_path=None):
        """Filet de sécurité appelé depuis le `finally` de backup() : ne touche QUE une ligne encore
        sans finished_at (exception non gérée depuis boex()/ailleurs) — jamais d'écrasement d'un
        résultat déjà écrit par la fin normale. Ferme immédiatement ce cas, sans attendre le timeout
        AD-7 (qui reste un filet supplémentaire pour un processus tué avant même d'atteindre ce
        `finally`, ex. SIGKILL/OOM)."""
        db_path=self._hist(nick,db_path,create=True)
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                conn.execute("UPDATE bkp_status SET finished_at=datetime('now'),result='error' "
                             "WHERE nick=? AND run_id=? AND finished_at IS NULL",(nick,run_id))
                conn.commit(); return True
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def last_archive_stat(self,nick,db_path=None):
        """(archive, archive_date) de l'archive la plus récente connue d'archive_stats — même source
        que la colonne « depuis » de Report (MAX_AGE_BKP) — ou None (aucune archive connue, base
        absente/illisible). Lecture seule, utilisée par le watcher de borgHelperWWW (retard de sauvegarde).
