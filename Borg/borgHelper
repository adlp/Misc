_BKP_STATUS_MAP={'A':'added','M':'modified','C':'C','B':'B','T':'T','d':'removed'}

def _bkp_parse_list(stderr):
    """Extrait les entrées de fichiers depuis la sortie --list de borg create."""
    entries=[]
    for i in stderr:
        if isinstance(i,dict):
            # borg.output.list avec --log-json : message = "<status> <path>"
            if i.get('name')=='borg.output.list' or i.get('type')=='file_status':
                if i.get('type')=='file_status':
                    status=i.get('status',''); path=i.get('path','')
                else:
                    msg=i.get('message','')
                    if len(msg)>=3 and msg[1]==' ':
                        status,path=msg[0],msg[2:]
                    else:
                        continue
                ct=_BKP_STATUS_MAP.get(status)
                if ct and path:
                    entries.append({'change_type':ct,'path':path,'size_before':None,'size_after':None})
        elif isinstance(i,str):
            s=i.strip()
            if len(s)>=3 and s[1]==' ' and s[0] in _BKP_STATUS_MAP:
                ct=_BKP_STATUS_MAP[s[0]]
                entries.append({'change_type':ct,'path':s[2:],'size_before':None,'size_after':None})
    return entries

def _bkp_is_list_entry(i):
    """True si l'entrée est une ligne --list (à masquer dans l'affichage)."""
    if isinstance(i,dict):
        return i.get('name')=='borg.output.list' or i.get('type')=='file_status'
    if isinstance(i,str):
        s=i.strip()
        return len(s)>=3 and s[1]==' ' and s[0] in _BKP_STATUS_MAP
    return False

def cmd_bkp(nick,no_index=False,debug=0):
    cfg=cfgreaded(nick,debug=debug)
    if not no_index and _nick_noidx(nick):
        no_index=True

    if 'SSH_REPO' in cfg.keys():
        forceEnv={}
        forceEnv['BORG_REPO']=cfg['SSH_REPO']
    else:
        forceEnv=None

    preBorg=['ssh','-o','SendEnv BORG_*']
    if 'SSH_REMFO' in cfg.keys():
        preBorg.append('-R')
        preBorg.append(cfg['SSH_REMFO'])
    preBorg.extend(f'-A -o VisualHostKey=no -o StrictHostKeyChecking=accept-new {cfg["SER_LOGIN"]}@{cfg["SER_NAME"]}'.split(' '))
    if 'SSH_KEY' in cfg.keys():
        preBorg.append('-i')
        preBorg.append(cfg['SSH_KEY'])
    if 'SSH_REMFO' not in cfg.keys() or len(cfg['SSH_REMFO']) == 0:
        preBorg=None

    # Récupérer l'archive précédente avant backup (pour diff index)
    archive_old=None
    if not no_index:
        try:
            prev=getlastbkp(nick,1,debug=debug)
            archive_old=prev[0] if prev else None
        except Exception:
            archive_old=None

    create=['create']
    base_flags='--log-json --json --debug -v --stats'
    if not no_index:
        base_flags+=' --list --filter AMCBTd'
    create.extend(base_flags.split(' '))
    archname='root'
    if 'BORG_ARCHNAME' in cfg.keys():
        archname=cfg['BORG_ARCHNAME']
    if archname[:2] == "::":
        create.append(archname+'-{now}')
    else:
        create.append('::{fqdn}-'+archname+'-{now}')

    rootbkp="/"
    if 'BORG_ROOTBKP' in cfg.keys():
        rootbkp=cfg['BORG_ROOTBKP']
    create.append(rootbkp)

    if 'EXCLUDE' not in list(cfg.keys()):
        printer(list(cfg.keys()))
        printer("Il est necessaire que EXCLUDE soit configures dans ~/.borghelperrc")
        printer('  EXCLUDE = --exclude /media --exclude /dev --exclude /proc --exclude /sys --exclude /var/run --exclude /run --exclude /lost+found --exclude /mnt --exclude /var/lib/lxcfs --exclude /tmp --exclude /var/lib/docker --exclude-if-present .nobackup  --exclude-caches --exclude-nodump --keep-exclude-tags')
        exit(1)
    create.extend(cfg['EXCLUDE'].split(' '))
    if 'EXCLUDE_NEXT' in list(cfg.keys()):
        create.extend(cfg['EXCLUDE_NEXT'].split(' '))

    anaRet=boex(nick,create,preBorg=preBorg,forceEnv=forceEnv,debug=debug)

    newretC=0
    if anaRet['exitcode']:
        for i in anaRet['stderr']:
            if isinstance(i,dict) and i.get('levelname') in ('ERROR','CRITICAL'):
                newretC=2
                break
        # INFO/WARNING only → borg exit 1 = avertissements, pas une erreur

    if 'stdout' in anaRet.keys() and len(anaRet['stdout']):
        out=dict(anaRet['stdout'][0])
        if newretC==0:
            all_entries=_bkp_parse_list(anaRet.get('stderr',[]))
            counts={}
            for e in all_entries:
                counts[e['change_type']]=counts.get(e['change_type'],0)+1
            out['borgHelper_file_counts']=counts
            if debug:
                out['borgHelper_files']=all_entries
        print(json.dumps(out,indent=4),file=sys.stdout,flush=True)

    if 'stderr' in anaRet.keys() and len(anaRet['stderr']):
        for i in anaRet['stderr']:
            if _bkp_is_list_entry(i):
                continue
            if isinstance(i,dict):
                lvl=i.get('levelname','INFO')
                msg=i.get('message',str(i))
                print(f"[{lvl}] {msg}",file=sys.stderr,flush=True)
                if debug:
                    printer(i)
            elif isinstance(i,str) and i.strip():
                print(i,file=sys.stderr,flush=True)

    # Indexation + archive_stats depuis la sortie --list / --json
    if newretC==0 and anaRet['stdout']:
        try:
            arch_info=anaRet['stdout'][0].get('archive',{})
            archive_new=arch_info.get('name')
            archive_new_date=arch_info.get('start')
            db_path=get_diff_db(nick)
            ensure_diff_db(db_path)
            # Stockage des stats de taille de la nouvelle archive
            if archive_new:
                st=arch_info.get('stats',{})
                store_archive_stats(nick,archive_new,archive_new_date,
                    arch_info.get('duration'),
                    st.get('original_size'),st.get('compressed_size'),
                    st.get('deduplicated_size'),st.get('nfiles'),
                    db_path)
            if not no_index and archive_new and archive_old:
                entries=[e for e in _bkp_parse_list(anaRet['stderr'])
                         if _idx_path_ok(e['path'],cfg)]
                store_diff_entries(nick,archive_old,archive_new,archive_new_date,entries,db_path)
                print(f"Index : {len(entries)} entrée(s) stockée(s) ({archive_old} → {archive_new})",
                      file=sys.stderr,flush=True)
            if not no_index:
                cmd_indexsnap(nick,debug=debug)
        except Exception as e:
