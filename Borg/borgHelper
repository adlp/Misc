    def claim_bkp_status(self,nick,run_id,db_path=None):
        """Réclamation par comparer-et-échanger (AD-3) : UPDATE ... WHERE notified_at IS NULL, jamais
        de lecture-puis-écriture séparées — condition nécessaire à un déploiement multi-workers sans
        double envoi. True si CETTE réclamation a gagné (une ligne affectée), False si déjà réclamée
        par un autre worker (0 ligne affectée, jamais une erreur)."""
        db_path=self._hist(nick,db_path)
        if db_path is None: return False
        def _do():
            conn=_open_db(db_path,nick=None,role='write')
            try:
                cur=conn.execute("UPDATE bkp_status SET notified_at=datetime('now') WHERE nick=? AND run_id=? AND notified_at IS NULL",(nick,run_id))
                conn.commit(); return cur.rowcount==1
            finally: conn.close()
        try: return self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}"); return False

    def get_running_bkp_status(self,nick,db_path=None,timeout_s=None):
        """Ligne bkp_status la plus récente encore en cours (finished_at IS NULL) pour ce nick, s'il y
        en a une. Plusieurs lignes ouvertes sont possibles (1.0.156, story 19 : l'ancienne mention « un seul Bkp actif à
        la fois via priority.lock » était fausse) : priority.lock admet plusieurs porteurs et backup() ne refuse pas un
        second Bkp — il échoue en général sur le verrou du dépôt, mais peut réussir s'il démarre pendant l'Index de fin du
        premier (borg create déjà fini) —, et un Bkp tué laisse sa ligne ouverte. Lecture seule, aucune réclamation — utilisée par la commande Status (100%
        locale, jamais d'appel boex). 1.0.154 (story 17) : un Bkp tué suivi d'autres Bkp n'est plus rendu ; 1.0.155 (story 18) :
        la plus récente des lignes ouvertes au sens de _BKP_OPEN_WHERE (effacée seulement par un Bkp plus récent réussi :
        un Bkp vivant suivi d'un Bkp en échec sur le verrou du dépôt reste rendu). timeout_s : ajoute 'stale' — True si la ligne
        a démarré depuis plus de timeout_s secondes (même condition que bkp_running_state : Bkp tenu pour interrompu) ;
        validé comme la variable (< 1 : 21600, plafond 10 ans)."""
        db_path=self._hist(nick,db_path)
        if db_path is None: return None
        # Garde AD-12 : _hist rend None si history.db n'existe pas — _open_db créerait sinon le fichier (O_CREAT).
        conn=None
        try:
            conn=_open_db(db_path,nick=None,role='read')
            t=_bkp_status_timeout(timeout_s) if timeout_s is not None else 0
            row=conn.execute(
                "SELECT run_id,started_at,COALESCE(started_at >= datetime('now',?),0) FROM bkp_status b "
                f"WHERE {_BKP_OPEN_WHERE} ORDER BY b.started_at DESC, b.rowid DESC LIMIT 1",(f"-{t} seconds",nick)).fetchone()
            if not row: return None
            r={'run_id':row[0],'started_at':row[1]}
            if timeout_s is not None: r['stale']=not row[2]
            return r
        except (sqlite3.Error,DbKeyError,DbModeError,DbCodecError):
            # base absente/jamais indexée, migrating (AD-11), chiffrée sans passphrase résolue, etc. —
            # Status reste 100% best-effort : une anomalie sur bkp_status ne doit jamais faire échouer
            # tout l'appel multi-nick.
            return None
        finally:
            if conn is not None: conn.close()

