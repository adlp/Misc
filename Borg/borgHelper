_SENTRY_SENSITIVE_KEYS=('passphrase','password','pw','dek','secret','k_path','k_enc','k_blob','k_hdr',
                         'wrapped_dek','kek','derived','chemin','path')

def _sentry_scrub(obj,depth=0):
    """Retire récursivement toute valeur dont la clé évoque un chemin ou un secret (AD-15).
    Portée : extra/contexts/vars de frame (before_send). Le texte libre (message d'exception, message,
    fils d'Ariane) passe par _sentry_scrub_text (1.0.130)."""
    if depth>6: return '[truncated]'
    if isinstance(obj,dict):
        return {k:('[redacted]' if isinstance(k,str) and any(s in k.lower() for s in _SENTRY_SENSITIVE_KEYS)
                    else _sentry_scrub(v,depth+1)) for k,v in obj.items()}
    if isinstance(obj,list):
        return [_sentry_scrub(v,depth+1) for v in obj]
    return obj

_SENTRY_PATH_SEG=r"[^\s/'\"`()\[\]{}<>,;=|]+"
_SENTRY_PATH_RE=re.compile(
    r"[A-Za-z][A-Za-z0-9+.-]*://[^\s'\"`<>]*"                                  # URL entière (ssh://h/dépôt)
    r"|(?:~|\.{1,2})?(?:/"+_SENTRY_PATH_SEG+r")+/?"                              # /abs/olu, ~/x, ./x
    r"|(?:"+_SENTRY_PATH_SEG+r"/)+(?:"+_SENTRY_PATH_SEG+r")?")                   # rel/at/if (groupe : jamais « +? » paresseux)
_SENTRY_SECRET_ENVS=('BORG_PASSPHRASE','BORGHELPERC_RUNTIME_PASSPHRASE')

def _sentry_scrub_text(text):
    """Texte libre envoyé à Sentry (1.0.130, AD-15 étendu) : toute suite qui ressemble à un chemin (au moins
    un '/' : absolu, relatif, ~/, URL de dépôt ssh://…) devient '<chemin>', toute passphrase connue du
    processus devient '[redacted]'. Volontairement large (faux positifs acceptés : « a/b », dates
    2026/09/27) — un chemin de sauvegarde ne doit jamais sortir du processus."""
    if not isinstance(text,str) or not text: return text
    for env in _SENTRY_SECRET_ENVS:
        v=os.environ.get(env)
        if v and len(v)>=4: text=text.replace(v,'[redacted]')
    return _SENTRY_PATH_RE.sub('<chemin>',text)

def _sentry_before_send(event,hint):
    """before_send Sentry : purge chemins/passphrase/DEK des extra/contexts/frames (AD-15) et, depuis 1.0.130,
    des textes libres (message d'exception, message, logentry, fils d'Ariane)."""
    if 'extra' in event: event['extra']=_sentry_scrub(event['extra'])
    if 'contexts' in event: event['contexts']=_sentry_scrub(event['contexts'])
    exc=event.get('exception')
    if isinstance(exc,dict):
        for val in exc.get('values') or []:
            if 'value' in val: val['value']=_sentry_scrub_text(val['value'])
            frames=((val.get('stacktrace') or {}).get('frames')) or []
            for fr in frames:
                if 'vars' in fr: fr['vars']=_sentry_scrub(fr['vars'])
    if isinstance(event.get('message'),str): event['message']=_sentry_scrub_text(event['message'])
    le=event.get('logentry')
    if isinstance(le,dict):
        for k in ('message','formatted'):
            if k in le: le[k]=_sentry_scrub_text(le[k])
        if 'params' in le: le['params']=['[redacted]' for _ in (le['params'] or [])]
    bc=event.get('breadcrumbs')
    for b in (bc.get('values') if isinstance(bc,dict) else bc if isinstance(bc,list) else []) or []:
        if isinstance(b,dict) and 'message' in b: b['message']=_sentry_scrub_text(b['message'])
        if isinstance(b,dict) and 'data' in b: b['data']=_sentry_scrub(b['data'])
    return event

def _sentry_dsn():
    return getDataFromEnvOrFile(env="BORGHELPERC_SENTRY_DSN",envpath="BORGHELPERC_SENTRY_FILE",paths="/usr/local/etc/borghelper-sentry")

def _sentry_init(dsn,release=None):
    """Initialise Sentry (CLI au démarrage ; borgHelperWWW à la première alerte). Aucune trace de
    performance (1.0.132 : plus de traces_sample_rate — auparavant 1.0, une transaction envoyée à CHAQUE
    invocation, donc à chaque clic de l'interface web) : seules partent les erreurs logicielles
    (exceptions non prévues, via l'excepthook) et les alertes SENTRY_ALERTS explicites (sentry_alert).
    auto_enabling_integrations=False : évite la découverte automatique d'intégrations tierces (boto3,
    frameworks web…), ~100-180 ms par invocation. Ne JAMAIS ajouter default_integrations=False : ça
    désactive aussi excepthook/logging/dedupe/atexit — plus aucune exception ne remonterait (borgHelper
    n'appelle jamais capture_exception() lui-même). include_local_variables=False + before_send : aucun
    chemin/passphrase/DEK ne sort du processus (AD-15), y compris via les variables locales des frames."""
    import sentry_sdk
    kw=dict(dsn=dsn,environment="production",release=release or f"borgHelper@{Version}",
            auto_enabling_integrations=False,before_send=_sentry_before_send)
    try:
        sentry_sdk.init(include_local_variables=False,**kw)
    except TypeError as e:
        # sentry-sdk < 1.26 : option renommée (with_locals). Ne rattraper QUE ce cas précis — toute autre
        # TypeError (mauvais usage, autre kwarg) doit remonter plutôt que d'être masquée par ce repli.
        if 'include_local_variables' not in str(e): raise
        sentry_sdk.init(with_locals=False,**kw)

_SENTRY_ALERT_KINDS=('bkp_error','overdue')

def _sentry_alert_kinds(cfg):
    """SENTRY_ALERTS du nick (rc, [DEFAULT] hérité) -> ensemble de types d'alerte actifs. Liste séparée par
    des virgules/espaces : bkp_error (sauvegarde en échec), overdue (dernière sauvegarde plus vieille que
    MAX_AGE_BKP) ; 'all' = les deux ; absent/vide/'none' = aucune (défaut). Valeur inconnue ignorée."""
    raw=(cfg.get('SENTRY_ALERTS','') if cfg is not None else '') or ''
    toks={t.strip().lower() for t in re.split(r'[,\s]+',raw) if t.strip()}
    if 'all' in toks: return set(_SENTRY_ALERT_KINDS)
    return toks & set(_SENTRY_ALERT_KINDS)

def sentry_alert(kind,nick,message,cfg,extra=None,release=None):
    """Alerte opérationnelle vers Sentry (1.0.132) — pas une erreur logicielle : SEULEMENT si `kind` figure
    dans SENTRY_ALERTS du nick et qu'un DSN est configuré. Événement de niveau 'error', regroupé par
    (type, nick) dans Sentry (empreinte), étiquettes alert/nick, texte filtré par before_send comme le reste.
    Initialise Sentry si le processus ne l'a pas encore fait (borgHelperWWW). True si l'événement est parti.
    Ne lève jamais : une alerte ne doit pas faire échouer la sauvegarde ni le watcher."""
    if kind not in _sentry_alert_kinds(cfg): return False
    try:
        dsn=_sentry_dsn()
        if not dsn: return False
        import sentry_sdk
        if sentry_sdk.Hub.current.client is None: _sentry_init(dsn,release=release)
        with sentry_sdk.push_scope() as scope:
            scope.set_tag('alert',kind); scope.set_tag('nick',nick)
            scope.fingerprint=['borghelper-alert',kind,nick]
            for k,v in (extra or {}).items(): scope.set_extra(k,v)
            sentry_sdk.capture_message(message,level='error')
        sentry_sdk.flush(timeout=5)
        return True
    except Exception as e:
        print(f"[WARN] alerte Sentry {kind} ({nick}) non envoyée : {type(e).__name__}: {e}",file=sys.stderr,flush=True)
        return False

