    def diffbkp(self,nick,bidun=None,bideux=None,debug=0,db_path=None,as_json=False):
        if db_path is None: db_path=self.db.get_diff_db(nick)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        twodiff=self.borg.getlastbkp(nick,2,debug=debug)
        if bidun is None and bideux is None:
            bidun=twodiff[0]; bideux=twodiff[1]
        elif bideux is None:
            bideux=bidun; bidun=twodiff[1]
        if bidun==bideux:
            msg="Desole, ce sont les memes backups"
            if as_json: print(json.dumps({'error':msg},ensure_ascii=False)); sys.exit(1)
            printer(msg); sys.exit(1)
        if bidun>bideux: bidun,bideux=bideux,bidun
        if debug: printer(f"Comparaison de {bidun} et {bideux}")
        self.db.ensure_diff_db(db_path,create=False)
        if not self.db.is_diff_pair_indexed(nick,bidun,bideux,db_path):
            if as_json: printer("Paire non indexée — calcul en cours...")
            else: print(f"Paire non indexée — calcul en cours...",flush=True)
            rb=self.borg.boex(nick,['list','--json']+glob_args(cfg),debug=debug)
            try:
                self.borg._boex_check_stdout(rb,nick,'borg list')
            except RuntimeError as e:
                msg=f"borg list a échoué : {e}"
                if as_json: print(json.dumps({'error':msg},ensure_ascii=False)); sys.exit(2)
                printer(msg); sys.exit(2)
            archives=rb['stdout'][0]['archives']
            date_new=next((a['start'] for a in archives if a['name']==bideux),None)
            rb2=self.borg.boex(nick,['diff','--json-lines',f"{cfg['BORG_REPO']}::{bidun}",bideux],debug=debug,retjson=False)
            if rb2['exitcode']!=0:
                msg=f"borg diff a échoué (code {rb2['exitcode']})"
                if as_json: print(json.dumps({'error':msg},ensure_ascii=False)); sys.exit(rb2['exitcode'])
                printer(msg); sys.exit(rb2['exitcode'])
            all_entries=[p for line in rb2['stdout'] for p in [parse_diff_line_json(line)] if p and p['path']]
            entries_ok=[]; exclu={}
            for p in all_entries:
                if self._idx_path_ok(p['path'],cfg):
                    entries_ok.append(p)
                else:
                    ct=p['change_type']; sz=p.get('size_after') or p.get('size_before') or 0
                    if ct not in exclu: exclu[ct]={'count':0,'size':0}
                    exclu[ct]['count']+=1; exclu[ct]['size']+=sz
            self.db.ensure_diff_db(db_path)  # paire non indexée : on écrit -> création légitime (AD-12 ne visait que le lookup ci-dessus)
            self.db.store_diff_entries(nick,bidun,bideux,date_new,entries_ok,db_path)
            if exclu: self.db.store_excluded_diff_stats(nick,bidun,bideux,exclu,db_path)
            display_entries=all_entries
        else:
            try:
                conn=_open_db(db_path,nick=nick,role='read')
                rows=[(ct,_path_decode(conn,p),sb,sa) for ct,p,sb,sa in conn.execute("SELECT change_type,path,size_before,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,bidun,bideux))]
                rows.sort(key=lambda r:(_path_sort_key(r[1]),r[0]))  # ORDER BY path,change_type en Python (octets UTF-8)
                conn.close()
            except DbCodecError as e:
                msg=_codec_fail(nick,e,conn)
                if as_json: print(json.dumps({'error':msg},ensure_ascii=False)); sys.exit(3)
                sys.exit(3)
            except sqlite3.Error as e:
                msg=f"SQLite error ({db_path}): {e}"
                if as_json: print(json.dumps({'error':msg},ensure_ascii=False)); sys.exit(3)
                printer(msg); sys.exit(3)
            display_entries=[{'change_type':ct,'path':path,'size_before':sb,'size_after':sa} for ct,path,sb,sa in rows]
        n_add=sum(1 for p in display_entries if p['change_type'] in _DIFF_ADDED_TYPES)
        n_rem=sum(1 for p in display_entries if p['change_type'] in _DIFF_REMOVED_TYPES)
        n_mod=len(display_entries)-n_add-n_rem
        if as_json:
            print(json.dumps({'archive_old':bidun,'archive_new':bideux,'entries':display_entries,
                'n_add':n_add,'n_rem':n_rem,'n_mod':n_mod},ensure_ascii=False,indent=2))
            sys.exit(0)
        print(f"{bidun} → {bideux}")
        if not display_entries: print("Aucune différence."); sys.exit(0)
        for p in display_entries:
            ct,path,sb,sa=p['change_type'],p['path'],p.get('size_before'),p.get('size_after')
            if ct in _DIFF_ADDED_TYPES:
                sym='+'
                tail=f"  {convert_octets_readable(sa)}" if sa else ''
                if ct!='added': tail+=f"  [{ct}]"
            elif ct in _DIFF_REMOVED_TYPES:
                sym='-'
                tail=f"  {convert_octets_readable(sb)}" if sb else ''
                if ct!='removed': tail+=f"  [{ct}]"
            else:
                sym='='
                if sb and sa:
                    tail=f"  {convert_octets_readable(sb)} → {convert_octets_readable(sa)}"
                elif sa: tail=f"  {convert_octets_readable(sa)}"
                elif sb: tail=f"  {convert_octets_readable(sb)}"
                else: tail=f"  [{ct}]" if ct!='modified' else ''
            print(f"{sym} {path}{tail}")
        print(f"\n+ {n_add}  - {n_rem}  = {n_mod}")
        sys.exit(0)

