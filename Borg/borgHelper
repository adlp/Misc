# ── BorgRunner — borg subprocess + borghelperrc config ────────────────────────

class BorgRunner:
    """Borg subprocess wrapper and borghelperrc configuration layer."""

    def __init__(self,cfgfile=None,passphrase=None):
        self.cfgfile=cfgfile or os.path.expanduser("~/.borghelperrc")
        self.passphrase=passphrase

    def cfgread(self,nick,debug=0):
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            _warn_rc_perms(self.cfgfile)
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            if nick not in config.keys(): return None
            cfg=config[nick]
            if self.passphrase is not None: cfg['BORG_PASSPHRASE']=self.passphrase
            return cfg
        return None

    def cfgreadnicks(self,debug=0):
        preret=[]
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            _warn_rc_perms(self.cfgfile)
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            for nick in config.keys():
                # Une section dont le nom commence par '_' est réservée à un autre composant (ex.
                # [_borgHelperWWW], spec-borghelperrc-www-section) — jamais un nick, ignorée en
                # silence ici. S'applique à toute section '_*' future sans code supplémentaire.
                if nick!="DEFAULT" and not nick.startswith('_') and 'ALL' not in config[nick].keys():
                    preret.append(nick)
            return ','.join(preret)
        return None

    def cfgreaded(self,nick,debug=0):
        cfg=self.cfgread(nick,debug=debug)
        if cfg is None:
            printer("Ce serveur est inconnu"); sys.exit(3)
        return cfg

    def cfgwrite(self,nick,serna,passphrase,repo,mountpoint,debug=0):
        config=configparser.ConfigParser()
        config.optionxform=str
        config.read(self.cfgfile)
        config[nick]={}
        config[nick]['BORG_REPO']=repo
        config[nick]['BORG_PASSPHRASE']=passphrase
        config[nick]['SER_NAME']=serna
        config[nick]['GLOB_ARCH']=serna+'-root-*'
        config[nick]['MOUNTPOINT']="/mnt/borg/"+nick if mountpoint is None else mountpoint
        _atomic_write_rc(self.cfgfile,config)

    def _boex_check_stdout(self,rb,nick,cmd='borg'):
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb.get('stderr',[]):
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform'):
                    msgs.append(i.strip()[:100])
            raise RuntimeError('; '.join(msgs[:2]) or f"{cmd} failed (code {rb['exitcode']})")

    def _boex_last_modified(self,nick,debug=0):
        rb=self.boex(nick,['info','--json'],debug=debug)
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb['stderr']:
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform') and not i.startswith('Borg:'):
                    msgs.append(i.strip())
            raise RuntimeError('; '.join(msgs[:3]) or f"borg info failed (code {rb['exitcode']})")
        return rb['stdout'][0]['repository']['last_modified']

    def getlastbkp(self,nick,nbl=1,debug=0):
        cfg=self.cfgreaded(nick,debug=debug)
        rb=self.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        self._boex_check_stdout(rb,nick,'borg list')
        lines=rb['stdout'][0]['archives']
        return [lines[i]['name'] for i in range(nbl*-1,0)]

    def dfRepo(self,nick,debug=0):
        cfg=self.cfgreaded(nick,debug=debug)
        if ':' not in cfg['BORG_REPO']:
            process=subprocess.Popen(f'df {cfg["BORG_REPO"]} --output=avail | tail -1',stdout=subprocess.PIPE,stderr=subprocess.PIPE,shell=True)
            stdout,stderr=process.communicate()
            if process.returncode==0:
                return int(stdout.decode('utf-8').split(" ")[-1])*1024
        return None

    def boex(self,nick,arg,rep=None,debug=0,preBorg=None,forceEnv=None,retjson=True):
        cfg=self.cfgreaded(nick,debug=debug)
        varcur=os.environ.copy()
        varfut={}
        if debug!=0: printer('Boex the first')
        for k in list(cfg.keys()):
            if k in ['BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO','BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE']:
                varfut[k]=cfg[k]
        if forceEnv is not None:
            for k in list(forceEnv.keys()): varfut[k]=forceEnv[k]
        if debug!=0: printer(varfut)
        borg_exe=cfg.get('BORG_EXE','borg')
        if preBorg is not None:
            commande=preBorg; commande.append(borg_exe)
        else:
            commande=[borg_exe]
        if rep is None: rep=os.getcwd()
        commande.extend(arg)
        varfut['PATH']=varcur['PATH']
        varfut["LC_ALL"]="fr_FR.UTF-8"
        if debug:
            for k in varfut: printer(f' {k}={varfut[k]}')
            printer(f"+{rep}"); printer(commande)
            printer(f"{' '.join(commande)}")
            printer(f"+{rep} >{' '.join(commande)}")
            if arg[1] in "extract": sys.exit(4)
        ps=subprocess.Popen(commande,encoding='utf-8',env=varfut,cwd=rep,bufsize=8192,
                            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        try:
            inf,errs=ps.communicate()
        except KeyboardInterrupt:
            ps.kill(); ps.wait()
            import glob as _glob, shutil as _shutil
            for _d in _glob.glob('/tmp/_MEI*'):
                try:
                    if subprocess.run(['fuser',_d],capture_output=True).returncode!=0:
                        _shutil.rmtree(_d,ignore_errors=True)
                except Exception: pass
            printer("\n[INTERRUPTED] Opération annulée par l'utilisateur.")
            sys.exit(130)
        ret={'stdout':[],'stderr':[]}
        if len(inf):
            if inf[0] in '[{' and retjson: ret['stdout'].append(json.loads(inf))
            else:
                for i in inf.split('\n'): ret['stdout'].append(i)
        if len(errs):
            for _line in errs.split('\n'):
                if not _line.strip(): continue
                if _line[0]=='{':
                    try: ret['stderr'].append(json.loads(_line))
                    except json.JSONDecodeError: ret['stderr'].append(_line)
                else: ret['stderr'].append(_line)
        ret['exitcode']=ps.returncode
        if debug: printer(json.dumps(ret,indent=4))
        return ret

# ── BorgHelper — high-level service layer (DB + Borg combined) ────────────────

class BorgHelper:
    """High-level borgbackup service layer. Combines BorgHelperDB and BorgRunner.

    Usage as library:
        bh = BorgHelper('/path/to/.borghelperrc')
        bh.backup('myserver')
        bh.index('myserver')
        bh.report('myserver')
    """

    def __init__(self,cfgfile=None,cache_dir=None,passphrase=None):
        self.borg=BorgRunner(cfgfile,passphrase=passphrase)
        cp=configparser.ConfigParser()
        if os.path.exists(self.borg.cfgfile): cp.read(self.borg.cfgfile)
        resolved_cache=cache_dir or os.path.expanduser(cp.defaults().get('cache_dir','~/.cache/borghelper'))
        os.makedirs(resolved_cache,mode=0o700,exist_ok=True)  # 0700 à la création seulement
        self.db=BorgHelperDB(resolved_cache,_db_name_from_cfg(self.borg.cfgfile),cfg_reader=self.borg.cfgread)

    # ── Internal helpers ───────────────────────────────────────────────────────

    def _nick_noidx(self,nick):
        cfg=self.borg.cfgread(nick)
        return cfg is not None and cfg.get('NOIDX','0').strip()=='1'

    def _idx_path_ok(self,path,cfg):
        import fnmatch
        includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
        excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
        def _match(path,pat):
            # glob pattern (*, ?, [) → fnmatch (* matches any chars including /)
            # plain prefix (/home/, /etc) → startswith
            if any(c in pat for c in ('*','?','[')):
                return fnmatch.fnmatch(path,pat)
            return path.startswith(pat)
        if includes:
            if not any(_match(path,p) for p in includes): return False
        if excludes:
            if any(_match(path,p) for p in excludes): return False
        return True

    def cache_prune_dryrun(self,nick,last_modified,debug=0,db_path=None):
        if db_path is None: db_path=self.db.get_cache_db(nick)
        self.db.ensure_cache_db(db_path,create=False)
        nom=f"{nick}:prune"
        if _db_has_schema(db_path): self.db.purge_stale_cache(nom,last_modified,db_path)  # jamais mis en cache -> rien à purger (AD-12 : ne pas toucher le fichier)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            row=conn.execute("SELECT details FROM cachejsonboexlm WHERE nom=? AND lastmodified=? LIMIT 1",(nom,last_modified)).fetchone()
            if row is not None and conn.codec is not None:
                try: row=(conn.codec.blob.decrypt(row[0]),)
                except DbCodecError: row=None  # ligne illisible = cache miss (AD-9), jamais une erreur
            conn.close()
        except sqlite3.Error: row=None
        if row is not None:
            if debug: print(f'Cache hit (prune {nick})')
            return json.loads(row[0])
        if debug: print(f'Cache miss (prune {nick}) — borg prune --dry-run')
        cfg=self.borg.cfgreaded(nick,debug=debug)
        cmd=['prune','--dry-run','--save-space','--info','--list']
        for key,flag in [('KEEP_DAILY','--keep-daily'),('KEEP_WEEKLY','--keep-weekly'),
                         ('KEEP_MONTHLY','--keep-monthly'),('KEEP_YEARLY','--keep-yearly'),
                         ('KEEP_HOURLY','--keep-hourly')]:
            if key in cfg: cmd.extend([flag,cfg[key]])
        cmd.append(f'--glob-archives={cfg["GLOB_ARCH"]}')
        ret=self.borg.boex(nick,cmd,debug=debug)['stderr']
        pruneme=[]
        for i in ret:
            line=i if isinstance(i,str) else i.get('message','')
            if 'Would prune:' in line:
                pruneme.append((re.sub(r'( )*',r'\1',line)).split(' ')[2])
        try:
            self.db.ensure_cache_db(db_path)  # cache miss confirmé : on écrit -> création légitime (AD-12 ne visait que le lookup)
            conn=_open_db(db_path,nick=nick,role='write')
            details_json=json.dumps(pruneme)
            stored=conn.codec.blob.encrypt(details_json) if conn.codec is not None else details_json
            conn.execute("INSERT OR IGNORE INTO cachejsonboexlm (nom,lastmodified,details) VALUES (?,?,?)",(nom,last_modified,stored))
            conn.commit(); conn.close()
        except sqlite3.Error as e:
            printer(f"Cache write error ({db_path}): {e}")
        return pruneme

    def cacheJsonBoexWithLM(self,nick,boexarg,output="stdout",debug=0,db_path=None,last_modified=None):
        if db_path is None: db_path=self.db.get_cache_db(nick)
        self.db.ensure_cache_db(db_path,create=False)
        if last_modified is None: last_modified=self.borg._boex_last_modified(nick,debug=debug)
        if _db_has_schema(db_path): self.db.purge_stale_cache(nick,last_modified,db_path)  # jamais mis en cache -> rien à purger (AD-12 : ne pas toucher le fichier)
        try:
            conn=_open_db(db_path,nick=nick,role='read')
            row=conn.execute("SELECT details FROM cachejsonboexlm WHERE nom=? AND lastmodified=? LIMIT 1",(nick,last_modified)).fetchone()
            if row is not None and conn.codec is not None:
                try: row=(conn.codec.blob.decrypt(row[0]),)
                except DbCodecError: row=None  # ligne illisible = cache miss (AD-9), jamais une erreur
            conn.close()
        except sqlite3.Error as e:
            printer(f"Cache SQLite error ({db_path}): {e}"); row=None
        if row is None:
            if debug: print('Cache miss — appel borg')
            details=self.borg.boex(nick,boexarg,debug=debug)[output][0]
            try:
                self.db.ensure_cache_db(db_path)  # cache miss confirmé : on écrit -> création légitime (AD-12 ne visait que le lookup)
                conn=_open_db(db_path,nick=nick,role='write')
                details_json=json.dumps(details)
                stored=conn.codec.blob.encrypt(details_json) if conn.codec is not None else details_json
                conn.execute("INSERT OR IGNORE INTO cachejsonboexlm (nom,lastmodified,details) VALUES (?,?,?)",(nick,last_modified,stored))
                conn.commit(); conn.close()
            except sqlite3.Error as e:
                printer(f"Cache write error ({db_path}): {e}")
        else:
            if debug: print('Cache hit')
            details=json.loads(row[0])
        if type(details) is list: return details[0]
        return details

    def _vacuum_db(self,db_path,verbose=True,nick=None):
        """VACUUM INTO dans le même répertoire que db_path (évite de saturer /tmp).
        verbose=True : imprime 'compactage en cours/terminé' + hint manuel en cas d'échec.
        Retourne True si succès, False sinon."""
        tmp_path=db_path+'.vacuum_tmp'
        try:
            conn=_open_db(db_path,nick=nick,role='write',timeout=60)
            if verbose: printer(f"  compactage en cours...")
            conn.execute(f"VACUUM INTO '{tmp_path}'")
            conn.close()
            try: os.chmod(tmp_path,stat.S_IMODE(os.stat(db_path).st_mode))  # VACUUM INTO crée avec l'umask : garder les droits d'origine
            except OSError: pass
            os.replace(tmp_path,db_path)
            if verbose: printer(f"  compactage terminé")
            return True
        except sqlite3.Error as ve:
            try:
                if os.path.exists(tmp_path): os.unlink(tmp_path)
            except OSError: pass
            printer(f"  [WARN] compactage impossible ({ve}) — entrées purgées mais espace non récupéré")
            if verbose:
                printer(f"  [WARN] relancer manuellement : sqlite3 '{db_path}' \"VACUUM INTO '{db_path}.tmp'\" && mv '{db_path}.tmp' '{db_path}'")
            return False

    # ── DbEncrypt / DbDecrypt / DbRekey / DbStatus (chiffrement des chemins — story 5) ──────────
    # Migration en place, reprenable, sans copie complète (AD-7). 'migrating' est un état partagé par
    # DbEncrypt (plain->migrating->siv1) et DbDecrypt (siv1->migrating->plain) : le champ 'migrating_dir'
    # ('encrypt'/'decrypt'), ajouté à l'en-tête pour la seule durée de la migration (retiré/disparaît au
    # commit final), dit laquelle des deux commandes a le droit de la reprendre — sans lui, une reprise
    # par la commande opposée traiterait des lignes déjà migrées comme si elles ne l'étaient pas encore.

    def _db_locks_busy(self,nick):
        """Message si une opération concurrente interdit de démarrer une migration/un rekey (AD-11), sinon None."""
        if self.db.check_priority_lock(nick): return f"{nick}: Bkp/Restore en cours (priority lock)"
        if self.db.check_report_running(nick): return f"{nick}: Report en cours"
        if self.db.check_index_running(nick): return f"{nick}: Index en cours"
        return None

    def _db_migrate_run(self,nick,db_path,direction,passphrase,cfg,debug=0):
        """Boucle de migration de diff.db (snapshot_file puis diff_index, AD-7), par lots transactionnels
        (BEGIN IMMEDIATE couvrant les UPDATE du lot + l'avancement du curseur dans l'en-tête : jamais de
        lot partiel visible). Connexion admin nue (nick=None) : le codec est géré ici à la main (DEK
        déchiffrée une fois), jamais via conn.codec — la base reste 'migrating' pendant toute l'opération,
        hors de portée de _open_db pour tout rôle non-admin (AD-11)."""
        conn=_open_db(db_path,nick=None,role='admin')
        try:
            raw=_enc_header_read(conn)
            # Re-vérification des verrous juste avant la toute première écriture qui bascule la base en
            # 'migrating' (_db_migrate ne les a vérifiés qu'avant d'ouvrir cette connexion) : ne supprime
            # pas la fenêtre de course — la protection ferme d'AD-11 démarre une fois le mode réellement
            # 'migrating' — mais la réduit entre « on a décidé de démarrer » et « on a démarré ».
            busy=self._db_locks_busy(nick)
            if busy: raise DbModeError(f"{busy} — migration refusée")
            if raw is None:
                if direction=='decrypt': raise DbModeError(f"{nick}: déjà en clair")
                level=db_kdf_level(nick,cfg=cfg)
                new_header,_dek=_enc_header_build(passphrase,'migrating',level)
                new_header['migrating_dir']='encrypt'
                if not _enc_header_write(conn,new_header):
                    raise DbModeError(f"{nick}: en-tête créé entre-temps par un autre processus — relancer")
                raw=_enc_header_read(conn)
            header=_enc_header_parse(raw)
            if header['path_enc']=='siv1':
                if direction=='encrypt': raise DbModeError(f"{nick}: déjà chiffrée")
                # le MAC de l'enveloppe couvre path_enc (_wrap_mac) : un simple dict(header,path_enc=...)
                # laisserait un MAC calculé pour l'ancien path_enc — toujours reconstruire via
                # _enc_header_build (même DEK, nouveau sel/nonce/MAC) dès que path_enc change.
                dek0=_enc_header_unlock(header,passphrase)
                level=db_kdf_level(nick,cfg=cfg)
                new_header,_dek0=_enc_header_build(passphrase,'migrating',level,dek=dek0)
                new_header['migrating_dir']='decrypt'
                if not _enc_header_cas(conn,raw,new_header):
                    raise DbModeError(f"{nick}: en-tête changé entre-temps — relancer")
                raw=_enc_header_read(conn); header=_enc_header_parse(raw)
            if header['path_enc']!='migrating':
                raise DbTamperError(f"{nick}: état d'en-tête inattendu ({header['path_enc']!r})")
            if header.get('migrating_dir') not in (None,direction):
                other='DbDecrypt' if direction=='encrypt' else 'DbEncrypt'
                raise DbModeError(f"{nick}: migration en cours dans l'autre sens — relancer {other} pour la terminer")
            if header.get('migrating_dir') is None:
                patched=dict(header,migrating_dir=direction)  # migration démarrée avant cette version : garde défensive
                if _enc_header_cas(conn,raw,patched):
                    raw=_enc_header_read(conn); header=_enc_header_parse(raw)
            dek=_enc_header_unlock(header,passphrase)
            codec=DbCodec(dek)
            cursor=header.get('migration_cursor') or {'table':_MIGRATE_TABLES[0],'id':0}
            if cursor.get('table') not in _MIGRATE_TABLES: cursor={'table':_MIGRATE_TABLES[0],'id':0}
            start_idx=_MIGRATE_TABLES.index(cursor['table'])
            # sample : ('fresh',table,rowid,orig,new) pour les lignes migrées PENDANT cette invocation
            # (pré-image connue, aller-retour vérifié contre elle) ; ('legacy',table,rowid) pour les
            # lignes déjà migrées par une invocation précédente (reprise après interruption) — sans
            # pré-image en mémoire, seule une auto-cohérence est vérifiable (voir boucle de validation
            # plus bas). Sans cette seconde catégorie, une reprise ne validerait jamais les lignes migrées
            # avant l'interruption : seules celles de la dernière invocation seraient couvertes.
            sample=[]
            if start_idx>0 or cursor['id']>0:
                for ti,table in enumerate(_MIGRATE_TABLES):
                    if ti>start_idx: break
                    bound=None if ti<start_idx else cursor['id']  # table déjà complète : aucune borne ; table en cours : id<=curseur
                    q=f"SELECT id FROM {table}" + ("" if bound is None else " WHERE id<=?")
                    args=() if bound is None else (bound,)
                    firsts=conn.execute(q+" ORDER BY id LIMIT ?",args+(_MIGRATE_VALIDATE_LEGACY//2,)).fetchall()
                    lasts=conn.execute(q+" ORDER BY id DESC LIMIT ?",args+(_MIGRATE_VALIDATE_LEGACY//2,)).fetchall()
                    for (rid,) in firsts+lasts:
                        sample.append(('legacy',table,rid))
            for ti,table in enumerate(_MIGRATE_TABLES):
                if ti<start_idx: continue
                last_id=cursor['id'] if table==cursor['table'] else 0
                while True:
                    rows=conn.execute(f"SELECT id,path FROM {table} WHERE id>? ORDER BY id LIMIT ?",(last_id,_MIGRATE_BATCH)).fetchall()
                    if not rows: break
                    conn.execute("BEGIN IMMEDIATE")
                    try:
                        chk=conn.execute("SELECT value FROM db_meta WHERE key='enc_header'").fetchone()
                        if chk is None or chk[0]!=raw:
                            raise DbModeError(f"{nick}: en-tête modifié pendant la migration (concurrence inattendue)")
                        batch_last=last_id
                        for rid,stored in rows:
                            if direction=='encrypt':
                                orig=stored; new=codec.path.encode(_norm_lp(orig))
                            else:
                                orig=stored; new=codec.path.decode(orig)
                            conn.execute(f"UPDATE {table} SET path=? WHERE id=?",(new,rid))
                            batch_last=rid
                            if len(sample)<_MIGRATE_VALIDATE_SAMPLE: sample.append(('fresh',table,rid,orig,new))
                        new_header=dict(header,migration_cursor={'table':table,'id':batch_last})
                        new_raw=json.dumps(new_header,sort_keys=True)
                        conn.execute("UPDATE db_meta SET value=? WHERE key='enc_header' AND value=?",(new_raw,raw))
                        conn.commit()
                    except BaseException:
                        conn.rollback(); raise
                    raw=new_raw; header=new_header; last_id=batch_last
                    if debug: printer(f"  {nick}: {table} — jusqu'à id={last_id}")
            # Validation avant tout commit final (jamais avant — voir Design Notes de la story) : relit
            # chaque ligne échantillonnée et vérifie l'aller-retour complet. 'fresh' (migrée pendant CETTE
            # invocation) : decode(stored)==original en chiffrement, encode(stored)==original en
            # déchiffrement, contre la pré-image connue. 'legacy' (migrée avant une reprise, pas de
            # pré-image mémorisée) : auto-cohérence — en chiffrement, decode ne doit pas lever et
            # encode(decode(x))==x (round-trip du codec) ; en déchiffrement, la valeur doit être du texte
            # déjà normalisé (aucun MAC ne protège plus une valeur redevenue plain, seule une vérification
            # de forme est possible).
            for entry in sample:
                kind,table,rid=entry[0],entry[1],entry[2]
                row=conn.execute(f"SELECT path FROM {table} WHERE id=?",(rid,)).fetchone()
                got=row[0] if row else None
                if got is None:
                    raise DbTamperError(f"{nick}: ligne {table}#{rid} disparue — commit final annulé")
                if kind=='fresh':
                    orig,expected=entry[3],entry[4]
                    if got!=expected:
                        raise DbTamperError(f"{nick}: incohérence relue sur {table}#{rid} — commit final annulé")
                    ok=(codec.path.decode(got)==_norm_lp(orig)) if direction=='encrypt' else (codec.path.encode(got)==orig)
                    if not ok:
                        raise DbTamperError(f"{nick}: aller-retour invalide sur {table}#{rid} — commit final annulé")
                else:
                    if direction=='encrypt':
                        try: dec=codec.path.decode(got)
                        except DbCodecError as e:
                            raise DbTamperError(f"{nick}: {table}#{rid} (migré avant reprise) illisible ({e}) — commit final annulé")
                        if codec.path.encode(dec)!=got:
                            raise DbTamperError(f"{nick}: {table}#{rid} (migré avant reprise) aller-retour invalide — commit final annulé")
                    else:
                        if _norm_lp(got)!=got:
                            raise DbTamperError(f"{nick}: {table}#{rid} (migré avant reprise) valeur non normalisée — commit final annulé")
            raw=_enc_header_read(conn); header=_enc_header_parse(raw)
            if direction=='encrypt':
                # même remarque que plus haut : path_enc change (migrating->siv1) -> en-tête reconstruit
                # en entier (même DEK, nouveau sel/nonce/MAC), jamais un simple dict(...,path_enc=...).
                level=db_kdf_level(nick,cfg=cfg)
                final,_dekf=_enc_header_build(passphrase,'siv1',level,dek=dek)
                if not _enc_header_cas(conn,raw,final):
                    raise DbModeError(f"{nick}: en-tête changé pendant la validation — relancer")
            else:
                if not _enc_header_cas_delete(conn,raw):
                    raise DbModeError(f"{nick}: en-tête changé pendant la validation — relancer")
        finally:
            conn.close()

    def _db_migrate_cache(self,nick,direction,passphrase,cfg,debug=0):
        """cache.db (cachejsonboexlm) : purge + recréation dans le mode cible, JAMAIS de migration ligne
        à ligne (Story 4/spine) — un cache est reconstructible par un simple appel borg, sans valeur à
        préserver au prix d'une migration en place coûteuse."""
        cache_path=self.db.get_cache_db(nick)
        if not os.path.exists(cache_path): return  # rien à migrer ; créée dans le bon mode au prochain accès (AD-12)
        self.db.ensure_cache_db(cache_path)
        conn=_open_db(cache_path,nick=None,role='admin')
        try:
            raw=_enc_header_read(conn)
            cur='plain' if raw is None else _enc_header_parse(raw)['path_enc']
            if (direction=='encrypt' and cur=='siv1') or (direction=='decrypt' and cur=='plain'):
                return  # déjà dans le mode cible
            conn.execute("DELETE FROM cachejsonboexlm"); conn.commit()
            if direction=='encrypt':
                level=db_kdf_level(nick,cfg=cfg)
                header,_dek=_enc_header_build(passphrase,'siv1',level)
                if not _enc_header_write(conn,header):
                    raise DbModeError(f"{nick}: cache.db — en-tête apparu entre-temps, relancer DbEncrypt")
            else:
                if not _enc_header_cas_delete(conn,raw):
                    raise DbModeError(f"{nick}: cache.db — en-tête changé entre-temps, relancer DbDecrypt")
            if debug: printer(f"  {nick}: cache.db purgé et recréé ({'siv1' if direction=='encrypt' else 'plain'})")
        finally:
            conn.close()

    def _db_migrate(self,nick,direction,dryrun=False,confirm=False,debug=0):
        verb='DbEncrypt' if direction=='encrypt' else 'DbDecrypt'
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent — rien à faire"); return 0
        self.db.ensure_diff_db(db_path)  # schéma courant requis avant migration (migrations legacy d'abord, AD-7)
        cfg=self.borg.cfgread(nick)
        if direction=='encrypt' and not db_encrypt_enabled(nick,cfg=cfg):
            printer(f"  [ERREUR] {nick}: DB_ENCRYPT=false pour ce nick — {verb} refusé explicitement"); return 2
        busy=self._db_locks_busy(nick)
        if busy:
            printer(f"  [ERREUR] {busy} — {verb} refusé"); return 2
        passphrase=cfg.get('BORG_PASSPHRASE') if cfg else None
        if not passphrase:
            printer(f"  [ERREUR] {nick}: passphrase absente — {verb} impossible"); return 2
        conn=_open_db(db_path,nick=None,role='admin')
        raw=_enc_header_read(conn)
        cur_mode='plain' if raw is None else _enc_header_parse(raw)['path_enc']
        if direction=='encrypt' and cur_mode=='siv1':
            printer(f"  {nick}: déjà chiffrée (siv1)"); conn.close(); return 0
        if direction=='decrypt' and cur_mode=='plain':
            printer(f"  {nick}: déjà en clair"); conn.close(); return 0
        if cur_mode=='migrating':
            migrating_dir=_enc_header_parse(raw).get('migrating_dir')
            if migrating_dir not in (None,direction):
                other='DbDecrypt' if direction=='encrypt' else 'DbEncrypt'
                printer(f"  [ERREUR] {nick}: migration en cours dans l'autre sens — relancer {other} pour la terminer"); conn.close(); return 2
        if not _check_disk_space(db_path):
            printer(f"  [ERREUR] {nick}: espace disque insuffisant pour {verb} (marge {_DB_SPACE_MARGIN:.0%} de {os.path.getsize(db_path):,} octets)"); conn.close(); return 2
        counts={t:conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0] for t in _MIGRATE_TABLES}
        size=os.path.getsize(db_path)
        conn.close()
        if dryrun and confirm:
            printer(f"  {nick}: -D et -y sont exclusifs"); return 2
        if dryrun:
            printer(f"  {nick}: {verb} -D — état actuel={cur_mode} · snapshot_file={counts['snapshot_file']:,} · diff_index={counts['diff_index']:,} · {convert_octets_readable(size)}")
            printer(f"  {nick}: dry-run — aucune modification")
            return 0
        if not confirm:
            printer(f"  {nick}: exécution réelle -> ajouter -y (ou -D pour un aperçu sans rien changer)"); return 2
        try:
            self._db_migrate_run(nick,db_path,direction,passphrase,cfg,debug=debug)
            self._db_migrate_cache(nick,direction,passphrase,cfg,debug=debug)
        except (DbKeyError,DbModeError,DbTamperError,DbCodecError) as e:
            printer(f"  [ERREUR] {nick}: {type(e).__name__}: {e}"); return 2
        printer(f"  {nick}: {verb} terminé ({'siv1' if direction=='encrypt' else 'plain'})")
        return 0

    def db_encrypt(self,nick,dryrun=False,confirm=False,debug=0):
        return self._db_migrate(nick,'encrypt',dryrun=dryrun,confirm=confirm,debug=debug)

    def db_decrypt(self,nick,dryrun=False,confirm=False,debug=0):
        return self._db_migrate(nick,'decrypt',dryrun=dryrun,confirm=confirm,debug=debug)

    def db_rekey(self,nick,confirm=False,debug=0):
        """Ré-enveloppe la DEK existante de diff.db avec une nouvelle KEK (nouveau sel, nouveau nonce,
        DB_KDF courant) — AUCUNE ligne de donnée touchée (AD-4). Ne concerne QUE diff.db : cache.db est
        purgé/recréé par DbEncrypt, sa DEK n'a pas besoin d'être ré-enveloppée séparément.
        borgHelperWWW >= 1.26.4 relit l'en-tête de chiffrement à chaque usage de son memo de codec
        (_NICK_CODEC_MEMO) : un DbRekey/DbEncrypt/DbDecrypt CLI est pris en compte sans redémarrage."""
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent"); return 1
        cfg=self.borg.cfgread(nick)
        passphrase=cfg.get('BORG_PASSPHRASE') if cfg else None
        if not passphrase:
            printer(f"  [ERREUR] {nick}: passphrase absente"); return 2
        busy=self._db_locks_busy(nick)
        if busy:
            printer(f"  [ERREUR] {busy} — DbRekey refusé"); return 2
        conn=_open_db(db_path,nick=None,role='admin')
        try:
            raw=_enc_header_read(conn)
            if raw is None:
                printer(f"  [ERREUR] {nick}: base non chiffrée (plain) — rien à re-clé"); return 2
            header=_enc_header_parse(raw)
            if header['path_enc']!='siv1':
                printer(f"  [ERREUR] {nick}: base en cours de migration ({header['path_enc']}) — pas de DbRekey pendant une migration"); return 2
            try:
                dek=_enc_header_unlock(header,passphrase)
            except DbKeyError as e:
                printer(f"  [ERREUR] {nick}: {e}"); return 2
            if not confirm:
                printer(f"  {nick}: DbRekey -> ajouter -y pour ré-envelopper la DEK avec une nouvelle KEK"); return 2
            level=db_kdf_level(nick,cfg=cfg)
            new_header,_dek2=_enc_header_build(passphrase,'siv1',level,dek=dek)
            try:
                if not _enc_header_cas(conn,raw,new_header):
                    raise DbModeError(f"{nick}: en-tête changé entre-temps — relancer DbRekey")
            except DbModeError as e:
                printer(f"  [ERREUR] {nick}: {e}"); return 2
            ck=(os.path.realpath(db_path),header['mac'],hashlib.sha256(_pw_bytes(passphrase)).digest())
            _DEK_CACHE.pop(ck,None); _CODEC_CACHE.pop(ck,None)  # ancienne enveloppe : mémo de ce processus purgé par prudence
            printer(f"  {nick}: DEK ré-enveloppée (nouvelle KEK) — pris en compte par borgHelperWWW >= 1.26.4 sans redémarrage")
            return 0
        finally:
            conn.close()

    def db_status(self,nick,debug=0):
        """AD-6 : mode de chaque base (cache.db/diff.db) pour ce nick. Lecture directe hors _open_db
        (seule exception documentée à AD-1) : on ne lit QUE db_meta.enc_header pour en afficher le mode,
        jamais une ligne de path/blob — le codec n'entre jamais en jeu ici. Passer par _open_db exigerait
        une passphrase même pour simplement annoncer qu'une base est 'siv1', ce que DbStatus doit pouvoir
        faire sans."""
        cfg=self.borg.cfgread(nick)
        for label,path in (('cache.db',self.db.get_cache_db(nick)),('diff.db',self.db.get_diff_db(nick))):
            if not os.path.exists(path):
                printer(f"  {nick}: {label}: absent"); continue
            peek=sqlite3.connect(path)
            try:
                try: raw=_enc_header_read(peek)
                finally: peek.close()
                mode='plain' if raw is None else _enc_header_parse(raw)['path_enc']
            except DbTamperError as e:
                printer(f"  {nick}: {label}: en-tête invalide ({e})"); continue
            printer(f"  {nick}: {label}: {mode}")
            if mode=='plain':
                try:
                    if db_encrypt_enabled(nick,cfg=cfg) and (cfg.get('BORG_PASSPHRASE') if cfg else None):
                        _warn_plain_db(nick,path)
                except SystemExit: pass

    def _cleanup_index_after_prune(self,nick,debug=0):
        if self._nick_noidx(nick): return
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path): return
        self.db.ensure_diff_db(db_path)
        cfg=self.borg.cfgreaded(nick,debug=debug)
        rb=self.borg.boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            self.borg._boex_check_stdout(rb,nick,'borg list')
        except RuntimeError: return
        current=set(a['name'] for a in rb['stdout'][0]['archives'])
        try:
            conn=_open_db(db_path,nick=nick,role='write')
            if current:
                ph=','.join('?'*len(current)); lst=list(current)
                r1=conn.execute(f"DELETE FROM diff_index WHERE nick=? AND archive_new NOT IN ({ph})",[nick]+lst).rowcount
                r2=conn.execute(f"DELETE FROM diff_indexed_pairs WHERE nick=? AND (archive_old NOT IN ({ph}) OR archive_new NOT IN ({ph}))",[nick]+lst+lst).rowcount
                r3=conn.execute(f"DELETE FROM archive_snapshot WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst).rowcount
                r4=conn.execute(f"DELETE FROM archive_snapshot_indexed WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst).rowcount
                conn.execute(f"DELETE FROM archive_stats WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst)
                conn.execute(f"DELETE FROM diff_excluded_stats WHERE nick=? AND (archive_old NOT IN ({ph}) OR archive_new NOT IN ({ph}))",[nick]+lst+lst)
                conn.execute(f"DELETE FROM snap_excluded_stats WHERE nick=? AND archive NOT IN ({ph})",[nick]+lst)
            else:
                r1=conn.execute("DELETE FROM diff_index WHERE nick=?",(nick,)).rowcount
                r2=conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=?",(nick,)).rowcount
                r3=conn.execute("DELETE FROM archive_snapshot WHERE nick=?",(nick,)).rowcount
                r4=conn.execute("DELETE FROM archive_snapshot_indexed WHERE nick=?",(nick,)).rowcount
                conn.execute("DELETE FROM archive_stats WHERE nick=?",(nick,))
                conn.execute("DELETE FROM diff_excluded_stats WHERE nick=?",(nick,))
                conn.execute("DELETE FROM snap_excluded_stats WHERE nick=?",(nick,))
            self.db._cleanup_snapshot_file_orphans(nick,conn)
            conn.commit(); conn.close()
            total=r1+r2+r3+r4
            if total>0: print(f"{nick}: index nettoyé ({r1} diff, {r2} paires, {r3}+{r4} snapshots)")
            self._vacuum_db(db_path,verbose=False,nick=nick)
        except sqlite3.Error as e:
            printer(f"SQLite cleanup error ({db_path}): {e}")
            try: conn.close()
            except: pass

    def _find_last_archive_with_file(self,nick,path,debug=0):
        db_path=self.db.get_diff_db(nick)
        has_glob='*' in path or '?' in path
        sql_pat=path.replace('*','%').replace('?','_') if has_glob else None
        try:
            self.db.ensure_diff_db(db_path,create=False)
            conn=_open_db(db_path,nick=nick,role='read')
            psql,pprm,pyf=_psel_like(conn,sql_pat) if has_glob else _psel_eq(conn,path)
            # prédicat en Python (chiffré) : pas de LIMIT, le premier chemin qui correspond gagne
            lim='' if pyf else ' LIMIT 1'
            found=None
            for arch,p in conn.execute("SELECT archive,path FROM archive_snapshot_v WHERE nick=?"+_wh(psql)+" ORDER BY archive DESC"+lim,[nick]+pprm):
                if pyf is None or pyf(_path_decode(conn,p)): found=arch; break
            if found is None:
                for arch,p in conn.execute("SELECT archive_new,path FROM diff_index WHERE nick=?"+_wh(psql)+" AND change_type NOT IN ("+','.join('?'*len(_DIFF_REMOVED_TYPES))+") ORDER BY archive_new_date DESC"+lim,[nick]+pprm+list(_DIFF_REMOVED_TYPES)):
                    if pyf is None or pyf(_path_decode(conn,p)): found=arch; break
            conn.close(); return found
        except DbCodecError as e: _codec_fail(nick,e,conn); return None
        except sqlite3.Error: return None

