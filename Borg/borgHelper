    # https://pypi.org/project/prettytable/

    clefs={}
    serrure=0
    for i in tab.keys():
        for j in tab[i].keys():
            if j not in clefs.keys():
                clefs[j]=serrure
                serrure+=1
    t=PrettyTable(clefs.keys())
    for i in tab.keys():
        liste=[]
        for j in clefs:
            if j not in tab[i]:
                liste.append("")
            else:
                liste.append(tab[i][j])
        t.add_row(liste)
    return(t)

def htmlTabelise(tabl,border=0,colnames=None,errhost=[]):
    ret=""
    ret+="<table border='0'>\n  <tr>\n"
    # Generation du tableau pour les titres
    if colnames == None:
        colnames=[]
        for y in tabl.keys(): # On cherche ds tout les elements
            for x in tabl[y].keys():   # On pecho la clef, car ca c'est de la bonne
                colnames.append(x)
    for x in colnames:
        if x in errhost:
            ret+=f"    <th colspan=1 style='background:#FF6161;'>{x}</td><td style='width:20px;background:#FF6161;'></th>\n"
        else:
            ret+=f"    <th colspan=1 style='background:#00A4E6;'>{x}</td><td style='width:20px;background:#00A4E6;'></th>\n"
    ret+="    </tr>\n"
    blue=0
    listy=len(tabl.keys())
    for y in tabl.keys():
        ret+='  <tr>\n'
        listy-=1
        concol=0
        colstyl=""
        for x in colnames:
            val=""
            if concol:
                colstyl='text-align:right;'
            if x in tabl[y].keys():
                val=tabl[y][x]
            if listy == 0:
                ret+=f"    <td colspan=1 style='{colstyl}'><em>{val}</em></td><td style='width:20px;'></td>\n"
            elif val in errhost:
                ret+=f"    <td colspan=1 style='{colstyl}background:#FF6161;'>{val}</td><td style='width:20px;background:#FF6161;'></td>\n"
            elif blue:
                ret+=f"    <td colspan=1 style='{colstyl}background:#BEEDFF;'>{val}</td><td style='width:20px;background:#BEEDFF;'></td>\n"
            else:
                ret+=f"    <td colspan=1 style='{colstyl}'>{val}</td><td style='width:20px;'></td>\n"
            concol+=1
        ret+='    </tr>\n'
        if blue:
            blue=0
        else:
            blue=1
    ret+='</table>\n'
    return(ret)

