def _migrate_archive_snapshot(conn):
    """Migration v1→v2 : archive_snapshot plat → snapshot_file (dédup) + archive_snapshot mince."""
    print("  Migration snapshot → schéma déduplication...", file=sys.stderr, flush=True)
    conn.executescript("""
        INSERT OR IGNORE INTO snapshot_file (nick, path, size, mtime)
            SELECT nick, path, size, mtime FROM archive_snapshot;
        CREATE TABLE archive_snapshot_new (
            nick         TEXT NOT NULL,
            archive      TEXT NOT NULL,
            archive_date TEXT,
            file_id      INTEGER NOT NULL,
            PRIMARY KEY (nick, archive, file_id)
        );
        INSERT INTO archive_snapshot_new (nick, archive, archive_date, file_id)
            SELECT a.nick, a.archive, a.archive_date, sf.id
            FROM archive_snapshot a
            JOIN snapshot_file sf ON sf.nick=a.nick AND sf.path=a.path;
        DROP TABLE archive_snapshot;
        ALTER TABLE archive_snapshot_new RENAME TO archive_snapshot;
        CREATE INDEX IF NOT EXISTS idx_snap_nick_archive ON archive_snapshot(nick, archive);
    """)

