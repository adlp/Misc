            s=diff_stats.get(arch)
            if s:
                nf=tbkps[arch].get('nfiles',0) or 0; sz=tbkps[arch].get('original_size',0) or 0
                for k,v in _fmt_stats(s,nf,sz).items(): tbkps[arch][k]=v
            else:
                tbkps[arch]['modifications']='—'
        return tcmpl,tbkps

