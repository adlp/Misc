# ── BorgHelperDB — all SQLite operations ──────────────────────────────────────

class BorgHelperDB:
    """SQLite layer: cache.db and diff.db operations. No borg calls."""

    def __init__(self,cache_dir,db_prefix,cfg_reader=None):
        self.cache_dir=cache_dir
        self.db_prefix=db_prefix
        self._cfg_reader=cfg_reader  # callable(nick) -> configparser section | None

    def get_db_nick(self,nick):
        if self._cfg_reader:
            cfg=self._cfg_reader(nick)
            if cfg is not None and 'DB_NAME' in cfg:
                return re.sub(r'[^a-zA-Z0-9_-]','_',cfg['DB_NAME'])
        return nick

    def get_cache_db(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self.get_db_nick(nick)}-cache.db")

    def get_diff_db(self,nick):
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{self.get_db_nick(nick)}-diff.db")

    def _priority_lock_path(self,nick):
        cfg=self._cfg_reader(nick) if self._cfg_reader else None
        if cfg and 'BORG_REPO' in cfg:
            repo_key=re.sub(r'[^a-zA-Z0-9_-]','_',cfg['BORG_REPO'])
        else:
            repo_key=self.get_db_nick(nick)
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{repo_key}-priority.lock")

    def set_priority_lock(self,nick):
        try:
            with open(self._priority_lock_path(nick),'w') as f: f.write(str(os.getpid()))
        except OSError: pass

    def clear_priority_lock(self,nick):
        try: os.unlink(self._priority_lock_path(nick))
        except OSError: pass

    def check_priority_lock(self,nick):
        """True si un processus prioritaire (Bkp/Restore) tient le lock et est encore vivant."""
        p=self._priority_lock_path(nick)
        if not os.path.exists(p): return False
        try:
            with open(p) as f: pid=int(f.read().strip())
            if pid==os.getpid(): return False
            os.kill(pid,0); return True
        except (OSError,ValueError):
            try: os.unlink(p)
            except OSError: pass
            return False

    def _index_running_lock_path(self,nick):
        cfg=self._cfg_reader(nick) if self._cfg_reader else None
        if cfg and 'BORG_REPO' in cfg:
            repo_key=re.sub(r'[^a-zA-Z0-9_-]','_',cfg['BORG_REPO'])
        else:
            repo_key=self.get_db_nick(nick)
        return os.path.join(self.cache_dir,f"{self.db_prefix}-{repo_key}-index-running.lock")

    def set_index_running_lock(self,nick):
        try:
            with open(self._index_running_lock_path(nick),'w') as f: f.write(str(os.getpid()))
        except OSError: pass

    def clear_index_running_lock(self,nick):
        try: os.unlink(self._index_running_lock_path(nick))
        except OSError: pass

    def check_index_running(self,nick):
        p=self._index_running_lock_path(nick)
        if not os.path.exists(p): return False
        try:
            with open(p) as f: pid=int(f.read().strip())
            if pid==os.getpid(): return False
            os.kill(pid,0); return True
        except (OSError,ValueError):
            try: os.unlink(p)
            except OSError: pass
            return False

    def wait_index_idle(self,nick,timeout=120):
        """Attend que l'Index en cours sur ce dépôt libère ses verrous borg (max timeout s)."""
        p=self._index_running_lock_path(nick)
        waited=0
        while waited<timeout:
            if not os.path.exists(p): return
            try:
                with open(p) as f: pid=int(f.read().strip())
                os.kill(pid,0)
                if waited==0: printer(f"  Index en cours sur ce dépôt — attente libération verrous borg...")
                time.sleep(1); waited+=1
            except (OSError,ValueError):
                try: os.unlink(p)
                except OSError: pass
                return
        printer(f"  [WARN] Timeout attente Index ({timeout}s) — lancement quand même")

    def _check_set_meta(self,conn,schema_version,db_path):
        row=conn.execute("SELECT value FROM db_meta WHERE key='schema_version'").fetchone()
        stored=int(row[0]) if row else 0
        if stored>schema_version:
            raise SchemaVersionError(
                f"({db_path}) schéma DB v{stored} > attendu v{schema_version} — "
                "DB créée par une version plus récente de borgHelper, mettez à jour borgHelper.")
        conn.execute("INSERT OR REPLACE INTO db_meta VALUES('schema_version',?)",(str(schema_version),))
        conn.execute("INSERT OR REPLACE INTO db_meta VALUES('borghelper_version',?)",(Version,))

    def _db_connect(self,db_path):
        try:
            return sqlite3.connect(db_path)
        except sqlite3.OperationalError as e:
            parent=os.path.dirname(os.path.abspath(db_path))
            if not os.path.exists(parent):
                printer(f"DB : répertoire introuvable : {parent}")
            elif not os.access(parent,os.W_OK):
                printer(f"DB : permission refusée sur le répertoire : {parent}")
            elif os.path.exists(db_path) and not os.access(db_path,os.R_OK|os.W_OK):
                printer(f"DB : fichier inaccessible : {db_path}")
            else:
                printer(f"DB : impossible d'ouvrir {db_path}")
                printer(f"  -> {e}")
            sys.exit(1)

    def ensure_cache_db(self,db_path):
        try:
            conn=self._db_connect(db_path)
            conn.execute("PRAGMA journal_mode=WAL")
            conn.executescript("""
                CREATE TABLE IF NOT EXISTS db_meta (
                    key   TEXT PRIMARY KEY,
                    value TEXT
                );
                CREATE TABLE IF NOT EXISTS cachejsonboexlm (
                    id           INTEGER PRIMARY KEY AUTOINCREMENT,
                    nom          TEXT NOT NULL,
                    lastmodified TEXT NOT NULL,
                    details      TEXT,
                    UNIQUE(nom, lastmodified)
                );
                CREATE INDEX IF NOT EXISTS idx_cache_nom ON cachejsonboexlm(nom);
            """)
            self._check_set_meta(conn,CACHE_DB_SCHEMA_VERSION,db_path)
            conn.commit(); conn.close()
        except sqlite3.DatabaseError as e:
            printer(f"DB corrompue : {db_path}")
            printer(f"  -> {e}")
            printer("  Supprimez le fichier et relancez pour reconstruire le cache.")
            sys.exit(1)

    def _migrate_archive_snapshot(self,conn):
        print("  Migration snapshot → schéma déduplication...",file=sys.stderr,flush=True)
        conn.executescript("""
            INSERT OR IGNORE INTO snapshot_file (nick, path, size, mtime)
                SELECT nick, path, size, mtime FROM archive_snapshot;
            CREATE TABLE archive_snapshot_new (
                nick         TEXT NOT NULL,
                archive      TEXT NOT NULL,
                archive_date TEXT,
                file_id      INTEGER NOT NULL,
                PRIMARY KEY (nick, archive, file_id)
            );
            INSERT INTO archive_snapshot_new (nick, archive, archive_date, file_id)
                SELECT a.nick, a.archive, a.archive_date, sf.id
                FROM archive_snapshot a
                JOIN snapshot_file sf ON sf.nick=a.nick AND sf.path=a.path;
            DROP TABLE archive_snapshot;
            ALTER TABLE archive_snapshot_new RENAME TO archive_snapshot;
            CREATE INDEX IF NOT EXISTS idx_snap_nick_archive ON archive_snapshot(nick, archive);
        """)

    def ensure_diff_db(self,db_path):
        try:
            conn=self._db_connect(db_path)
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("PRAGMA auto_vacuum=INCREMENTAL")
            conn.executescript("""
                CREATE TABLE IF NOT EXISTS db_meta (
                    key   TEXT PRIMARY KEY,
                    value TEXT
                );
                CREATE TABLE IF NOT EXISTS diff_index (
                    id               INTEGER PRIMARY KEY AUTOINCREMENT,
                    nick             TEXT NOT NULL,
                    archive_old      TEXT NOT NULL,
                    archive_new      TEXT NOT NULL,
                    archive_new_date TEXT,
                    change_type      TEXT NOT NULL,
                    path             TEXT NOT NULL,
                    size_before      INTEGER,
                    size_after       INTEGER,
                    indexed_at       TEXT DEFAULT (datetime('now'))
                );
                CREATE INDEX IF NOT EXISTS idx_diff_nick_path    ON diff_index(nick, path);
                CREATE INDEX IF NOT EXISTS idx_diff_nick_archive ON diff_index(nick, archive_new);
                CREATE INDEX IF NOT EXISTS idx_diff_nick_newtype ON diff_index(nick, archive_new, change_type);
                CREATE INDEX IF NOT EXISTS idx_diff_nick_date    ON diff_index(nick, archive_new_date);
                CREATE TABLE IF NOT EXISTS diff_indexed_pairs (
                    id          INTEGER PRIMARY KEY AUTOINCREMENT,
                    nick        TEXT NOT NULL,
                    archive_old TEXT NOT NULL,
                    archive_new TEXT NOT NULL,
                    entry_count INTEGER DEFAULT 0,
                    indexed_at  TEXT DEFAULT (datetime('now')),
                    UNIQUE(nick, archive_old, archive_new)
                );
                CREATE INDEX IF NOT EXISTS idx_pairs_nick ON diff_indexed_pairs(nick);
                CREATE TABLE IF NOT EXISTS snapshot_file (
                    id    INTEGER PRIMARY KEY AUTOINCREMENT,
                    nick  TEXT NOT NULL,
                    path  TEXT NOT NULL,
                    size  INTEGER,
                    mtime TEXT,
                    UNIQUE(nick, path)
                );
                CREATE INDEX IF NOT EXISTS idx_snapfile_nick_path ON snapshot_file(nick, path);
                CREATE TABLE IF NOT EXISTS archive_snapshot_indexed (
                    nick        TEXT NOT NULL,
                    archive     TEXT NOT NULL,
                    entry_count INTEGER DEFAULT 0,
                    indexed_at  TEXT DEFAULT (datetime('now')),
                    UNIQUE(nick, archive)
                );
                CREATE TABLE IF NOT EXISTS archive_stats (
                    nick               TEXT NOT NULL,
                    archive            TEXT NOT NULL,
                    archive_date       TEXT,
                    duration           REAL,
                    original_size      INTEGER,
                    compressed_size    INTEGER,
                    deduplicated_size  INTEGER,
                    nfiles             INTEGER,
                    PRIMARY KEY (nick, archive)
                );
                CREATE INDEX IF NOT EXISTS idx_astats_nick ON archive_stats(nick);
                CREATE TABLE IF NOT EXISTS diff_excluded_stats (
                    nick        TEXT NOT NULL,
                    archive_old TEXT NOT NULL,
                    archive_new TEXT NOT NULL,
                    change_type TEXT NOT NULL,
                    file_count  INTEGER NOT NULL DEFAULT 0,
                    total_size  INTEGER NOT NULL DEFAULT 0,
                    PRIMARY KEY (nick, archive_old, archive_new, change_type)
                );
                CREATE INDEX IF NOT EXISTS idx_exclu_nick_arch ON diff_excluded_stats(nick, archive_new);
                CREATE TABLE IF NOT EXISTS snap_excluded_stats (
                    nick       TEXT NOT NULL,
                    archive    TEXT NOT NULL,
                    file_count INTEGER NOT NULL DEFAULT 0,
                    total_size INTEGER NOT NULL DEFAULT 0,
                    PRIMARY KEY (nick, archive)
                );
                CREATE TABLE IF NOT EXISTS repo_stats (
                    nick           TEXT NOT NULL PRIMARY KEY,
                    unique_csize   INTEGER,
                    total_size     INTEGER,
                    total_csize    INTEGER,
                    updated_at     TEXT DEFAULT (datetime('now'))
                );
            """)
            cols=[r[1] for r in conn.execute("PRAGMA table_info(archive_snapshot)").fetchall()]
            if 'path' in cols:
                self._migrate_archive_snapshot(conn)
            else:
                conn.executescript("""
                    CREATE TABLE IF NOT EXISTS archive_snapshot (
                        nick         TEXT NOT NULL,
                        archive      TEXT NOT NULL,
                        archive_date TEXT,
                        file_id      INTEGER NOT NULL,
                        PRIMARY KEY (nick, archive, file_id)
                    );
                    CREATE INDEX IF NOT EXISTS idx_snap_nick_archive ON archive_snapshot(nick, archive);
                """)
            conn.executescript("""
                DROP VIEW IF EXISTS archive_snapshot_v;
                CREATE VIEW archive_snapshot_v AS
                    SELECT s.nick, s.archive, s.archive_date, sf.path, sf.size, sf.mtime
                    FROM archive_snapshot s
                    JOIN snapshot_file sf ON sf.id=s.file_id;
            """)
            self._check_set_meta(conn,DIFF_DB_SCHEMA_VERSION,db_path)
            conn.commit(); conn.close()
        except sqlite3.DatabaseError as e:
            printer(f"DB corrompue : {db_path}")
            printer(f"  -> {e}")
            printer("  Supprimez le fichier et relancez pour reconstruire l'index.")
            sys.exit(1)

