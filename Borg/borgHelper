    def idxtop(self,nick,depth=3,topn=20,debug=0):
        from collections import defaultdict
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent — lancez borgHelper -c Index -n {nick}"); return
        def get_prefix(path,d):
            if not path: return '(vide)'
            leading='/' if path[0]=='/' else ''
            parts=[p for p in path.split('/') if p]
            if len(parts)<=d: return path
            return leading+'/'.join(parts[:d])
        stats=defaultdict(lambda:{'count':0,'size':0})
        total_count=0; total_size=0
        try:
            conn=sqlite3.connect(db_path)
            cur=conn.execute("SELECT path,COALESCE(size_after,size_before,0) FROM diff_index WHERE nick=?",(nick,))
            while True:
                rows=cur.fetchmany(50000)
                if not rows: break
                for path,size in rows:
                    pfx=get_prefix(path,depth)
                    stats[pfx]['count']+=1; stats[pfx]['size']+=(size or 0)
                    total_count+=1; total_size+=(size or 0)
            conn.close()
        except sqlite3.Error as e:
            printer(f"  SQLite error ({db_path}): {e}"); return
        if not total_count:
            printer(f"  {nick}: diff_index vide"); return
        try:
            conn2=sqlite3.connect(db_path)
            exclu_rows=conn2.execute("SELECT change_type,SUM(file_count),SUM(total_size) FROM diff_excluded_stats WHERE nick=? GROUP BY change_type",(nick,)).fetchall()
            # inchangés par archive : added+modified indexés par archive_new
            idx_am=conn2.execute(
                "SELECT archive_new,"
                " SUM(CASE WHEN change_type='added' THEN 1 ELSE 0 END),"
                " SUM(CASE WHEN change_type='modified' THEN 1 ELSE 0 END)"
                " FROM diff_index WHERE nick=? GROUP BY archive_new",(nick,)).fetchall()
            # added+modified exclus par archive_new
            exclu_am=conn2.execute(
                "SELECT archive_new,"
                " SUM(CASE WHEN change_type='added' THEN file_count ELSE 0 END),"
                " SUM(CASE WHEN change_type='modified' THEN file_count ELSE 0 END)"
                " FROM diff_excluded_stats WHERE nick=? GROUP BY archive_new",(nick,)).fetchall()
            # nfiles par archive
            nfiles_rows=conn2.execute("SELECT archive,nfiles FROM archive_stats WHERE nick=?",(nick,)).fetchall()
            conn2.close()
            exclu_by_ct={r[0]:(r[1] or 0,r[2] or 0) for r in exclu_rows}
            exclu_n=sum(v[0] for v in exclu_by_ct.values()); exclu_sz=sum(v[1] for v in exclu_by_ct.values())
            idx_am_d={r[0]:(r[1] or 0,r[2] or 0) for r in idx_am}
            exclu_am_d={r[0]:(r[1] or 0,r[2] or 0) for r in exclu_am}
            nfiles_d={r[0]:r[1] for r in nfiles_rows if r[1]}
        except sqlite3.Error: exclu_by_ct={}; exclu_n=0; exclu_sz=0; idx_am_d={}; exclu_am_d={}; nfiles_d={}
        top=sorted(stats.items(),key=lambda x:x[1]['count'],reverse=True)[:topn]
        from prettytable import PrettyTable
        t=PrettyTable(); t.field_names=['arborescence','entrées','taille','% total']
        for f in t.field_names: t.align[f]='r'
        t.align['arborescence']='l'
        for pfx,s in top:
            pct=f"{100*s['count']//total_count}%"
            t.add_row([pfx,f"{s['count']:,}",convert_octets_readable(s['size']),pct])
        printer(f"\n{nick} — top {topn} arborescences dans diff_index (profondeur {depth})")
        printer(f"Indexés : {total_count:,} entrées · {convert_octets_readable(total_size)}")
        if exclu_n:
            exclu_detail=' · '.join(f"{s}{exclu_by_ct[ct][0]:,}" for ct,s in [('added','+'),('removed','-'),('modified','=')] if ct in exclu_by_ct)
            printer(f"Exclus  : {exclu_n:,} entrées · {convert_octets_readable(exclu_sz)} (IDX_EXCLUDE) — {exclu_detail}")
        archives_with_nfiles=sorted(arch for arch in nfiles_d if arch in idx_am_d or arch in exclu_am_d)
        if archives_with_nfiles:
            printer("Inchangés par archive :")
            for arch in archives_with_nfiles:
                nf=nfiles_d[arch]
                add_t=idx_am_d.get(arch,(0,0))[0]+exclu_am_d.get(arch,(0,0))[0]
                mod_t=idx_am_d.get(arch,(0,0))[1]+exclu_am_d.get(arch,(0,0))[1]
                unch=max(0,nf-add_t-mod_t)
                pct=f" ({100*unch//nf}%)" if nf>0 else ""
                printer(f"  {arch} : {unch:,}{pct} / {nf:,} fichiers")
        printer(str(t))


    def difftop(self,nick,bkp=None,depth=3,topn=10,debug=0):
        from collections import defaultdict
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent — lancez borgHelper -c Index -n {nick}"); return
        if bkp:
            parts=bkp.split(',')
            if len(parts)==2: arch_old,arch_new=parts[0].strip(),parts[1].strip()
            else: printer(f"  {nick}: -b attend 'archive-old,archive-new'"); return
        else:
            try:
                conn=sqlite3.connect(db_path,timeout=60)
                row=conn.execute(
                    "SELECT archive_old,archive_new FROM diff_indexed_pairs WHERE nick=? ORDER BY indexed_at DESC LIMIT 1",
                    (nick,)).fetchone()
                conn.close()
            except sqlite3.Error as e:
                printer(f"  SQLite error ({db_path}): {e}"); return
            if not row:
                printer(f"  {nick}: aucune paire indexée — lancez borgHelper -c Index -n {nick}"); return
            arch_old,arch_new=row
        def get_prefix(path,d):
            if not path: return '(vide)'
            leading='/' if path[0]=='/' else ''
            parts=[p for p in path.split('/') if p]
            if len(parts)<=d: return path
            return leading+'/'.join(parts[:d])
        stats=defaultdict(lambda:{'total':0,'added_n':0,'added_s':0,'removed_n':0,'removed_s':0,'modified_n':0,'size':0})
        total_count=0; total_size=0; total_added=0; total_modified=0
        try:
            conn=sqlite3.connect(db_path,timeout=60)
            cur=conn.execute(
                "SELECT path,change_type,size_before,size_after FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",
                (nick,arch_old,arch_new))
            while True:
                rows=cur.fetchmany(50000)
                if not rows: break
                for path,ct,sb,sa in rows:
                    pfx=get_prefix(path,depth)
                    s=stats[pfx]
                    s['total']+=1
                    sz=(sa or sb or 0)
                    s['size']+=sz
                    if ct=='added':    s['added_n']+=1;    s['added_s']+=(sa or 0); total_added+=1
                    elif ct=='removed': s['removed_n']+=1; s['removed_s']+=(sb or 0)
                    else:              s['modified_n']+=1; total_modified+=1
                    total_count+=1; total_size+=sz
            conn.close()
        except sqlite3.Error as e:
            printer(f"  SQLite error ({db_path}): {e}"); return
        if not total_count:
            printer(f"  {nick}: aucune entrée pour cette paire ({arch_old} → {arch_new})"); return
        try:
            conn3=sqlite3.connect(db_path,timeout=60)
            exclu_rows3=conn3.execute("SELECT change_type,SUM(file_count),SUM(total_size) FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=? GROUP BY change_type",(nick,arch_old,arch_new)).fetchall()
            nfiles_row=conn3.execute("SELECT nfiles FROM archive_stats WHERE nick=? AND archive=?",(nick,arch_new)).fetchone()
            conn3.close()
            exclu_by_ct3={r[0]:(r[1] or 0,r[2] or 0) for r in exclu_rows3}
            exclu_n=sum(v[0] for v in exclu_by_ct3.values()); exclu_sz=sum(v[1] for v in exclu_by_ct3.values())
            nfiles_new=nfiles_row[0] if nfiles_row and nfiles_row[0] else None
        except sqlite3.Error: exclu_by_ct3={}; exclu_n=0; exclu_sz=0; nfiles_new=None
        top=sorted(stats.items(),key=lambda x:x[1]['total'],reverse=True)[:topn]
        from prettytable import PrettyTable
        t=PrettyTable()
        t.field_names=['arborescence','total','+nb','+taille','-nb','-taille','=nb','taille']
        for f in t.field_names: t.align[f]='r'
        t.align['arborescence']='l'
        for pfx,s in top:
            pct=f"{100*s['total']//total_count}%"
            t.add_row([
                pfx,
                f"{s['total']:,} ({pct})",
                f"{s['added_n']:,}" if s['added_n'] else '—',
                convert_octets_readable(s['added_s']) if s['added_s'] else '—',
                f"{s['removed_n']:,}" if s['removed_n'] else '—',
                convert_octets_readable(s['removed_s']) if s['removed_s'] else '—',
                f"{s['modified_n']:,}" if s['modified_n'] else '—',
                convert_octets_readable(s['size']),
            ])
        printer(f"\n{nick} — top {topn} par changements (profondeur {depth})")
        printer(f"  {arch_old}")
        printer(f"→ {arch_new}")
        added_total=total_added+exclu_by_ct3.get('added',(0,0))[0]
        modified_total=total_modified+exclu_by_ct3.get('modified',(0,0))[0]
        unchanged=max(0,nfiles_new-added_total-modified_total) if nfiles_new is not None else None
        printer(f"Indexés : {total_count:,} changements · {convert_octets_readable(total_size)}")
        if exclu_n:
            exclu_detail3=' · '.join(f"{s}{exclu_by_ct3[ct][0]:,}" for ct,s in [('added','+'),('removed','-'),('modified','=')] if ct in exclu_by_ct3)
            printer(f"Exclus  : {exclu_n:,} entrées · {convert_octets_readable(exclu_sz)} (IDX_EXCLUDE) — {exclu_detail3}")
        if unchanged is not None:
            pct_unch=f" ({100*unchanged//nfiles_new}%)" if nfiles_new>0 else ""
            printer(f"Inchangés: {unchanged:,}{pct_unch} sur {nfiles_new:,} fichiers dans {arch_new}")
        printer(str(t))

    def idxpurge(self,nick,pattern=None,dryrun=False,debug=0):
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            printer(f"  {nick}: diff.db absent"); return
        def _pat_cond(patterns):
            parts=[]; args=[]
            for pat in patterns:
                if any(c in pat for c in '*?['):
                    parts.append("path GLOB ?"); args.append(pat)
                else:
                    parts.append("(path=? OR path LIKE ?)")
                    args.extend([pat,pat.rstrip('/')+'/%'])
            return ' OR '.join(parts),args
        if pattern is not None:
            is_glob=any(c in pattern for c in '*?[')
            if is_glob:
                sql_where="nick=? AND path GLOB ?"; params=(nick,pattern)
            else:
                sql_where="nick=? AND (path=? OR path LIKE ?)"; params=(nick,pattern,pattern.rstrip('/')+'/%')
        else:
            cfg=self.borg.cfgread(nick)
            includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
            excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
            if not includes and not excludes:
                printer(f"  {nick}: aucun IDX_INCLUDE/IDX_EXCLUDE dans la config"); return
            if includes: printer(f"  {nick}: IDX_INCLUDE : {' '.join(includes)}")
            if excludes: printer(f"  {nick}: IDX_EXCLUDE : {' '.join(excludes)}")
            if includes and excludes:
                inc_sql,inc_args=_pat_cond(includes)
                exc_sql,exc_args=_pat_cond(excludes)
                sql_where=f"nick=? AND (NOT ({inc_sql}) OR ({exc_sql}))"
                params=tuple([nick]+inc_args+exc_args)
            elif includes:
                inc_sql,inc_args=_pat_cond(includes)
                sql_where=f"nick=? AND NOT ({inc_sql})"
                params=tuple([nick]+inc_args)
            else:
                exc_sql,exc_args=_pat_cond(excludes)
                sql_where=f"nick=? AND ({exc_sql})"
                params=tuple([nick]+exc_args)
        try:
            conn=sqlite3.connect(db_path,timeout=60)
            row=conn.execute(
                f"SELECT COUNT(*),SUM(COALESCE(size_after,size_before,0)) FROM diff_index WHERE {sql_where}",
                params).fetchone()
            count,size=row[0],row[1] or 0
            if not count:
                printer(f"  {nick}: aucune entrée à purger")
                conn.close(); return
            label=f" — '{pattern}'" if pattern is not None else ""
            printer(f"  {nick}: {count:,} entrées · {convert_octets_readable(size)}{label}")
            if dryrun:
                printer(f"  {nick}: dry-run — aucune modification")
                conn.close(); return
            conn.execute(f"DELETE FROM diff_index WHERE {sql_where}",params)
            conn.execute("""UPDATE diff_indexed_pairs SET entry_count=(
                SELECT COUNT(*) FROM diff_index di
                WHERE di.nick=diff_indexed_pairs.nick
                AND di.archive_old=diff_indexed_pairs.archive_old
                AND di.archive_new=diff_indexed_pairs.archive_new)
                WHERE nick=?""",(nick,))
            conn.commit(); conn.close()
            printer(f"  {nick}: {count:,} entrées supprimées — compactage en cours...")
            tmp_path=db_path+'.vacuum_tmp'
            try:
                conn2=sqlite3.connect(db_path,timeout=60)
                conn2.execute(f"VACUUM INTO '{tmp_path}'")
                conn2.close()
                os.replace(tmp_path,db_path)
                printer(f"  {nick}: compactage terminé")
            except sqlite3.Error as ve:
                try:
                    if os.path.exists(tmp_path): os.unlink(tmp_path)
                except OSError: pass
                printer(f"  [WARN] compactage impossible ({ve}) — entrées supprimées mais espace non récupéré")
                printer(f"  [WARN] relancer manuellement : sqlite3 '{db_path}' \"VACUUM INTO '{db_path}.tmp'\" && mv '{db_path}.tmp' '{db_path}'")
        except sqlite3.Error as e:
            printer(f"  SQLite error ({db_path}): {e}")
            try: conn.close()
            except: pass

    def prep_report_from_db(self,nick,maxp=None):
        """Comme prep_report() mais lit uniquement l'index SQLite — utilisé quand le dépôt est occupé."""
        db_path=self.db.get_diff_db(nick)
        if not os.path.exists(db_path):
            raise Exception(f"diff.db absent — lancez borgHelper -c Index -n {nick}")
        self.db.ensure_diff_db(db_path)
        try:
            conn=sqlite3.connect(db_path)
            rows=conn.execute("SELECT archive,archive_date,duration,original_size,compressed_size,deduplicated_size,nfiles FROM archive_stats WHERE nick=? ORDER BY archive_date",(nick,)).fetchall()
            conn.close()
        except sqlite3.Error as e:
            raise Exception(f"SQLite error ({db_path}): {e}")
        if not rows:
            raise Exception(f"archive_stats vide — lancez borgHelper -c Index -n {nick}")
        diff_stats=self.db._diff_stats_for_nick(nick)
        def _fmt_stats(s,nf,total_sz=0,summary=False):
            na,nr,nm=s['added'],s['removed'],s['modified']
            prev_nf=nf-na+nr; prev_sz=total_sz-s['added_sz']+s['removed_sz']
            pn_modif=f"{100*(nm+nr)//prev_nf}%nb" if prev_nf>0 else "—"
            ps_modif=f"{100*(s['modified_sz']+s['removed_sz'])//prev_sz}%B" if prev_sz>0 else "—"
            return {'modifications':f"{pn_modif} / {ps_modif}"}
        kept={}
        for archive,arch_date,duration,orig,compr,dedup,nfiles in rows:
            kept[archive]={'name':archive,'durationM':(duration or 0)/60,
                'original_size':orig or 0,'compressed_size':compr or 0,
                'deduplicated_size':dedup or 0,'nfiles':nfiles or 0,
                'archive_date':arch_date,'prunMe':'No'}
        c=len(kept)
        last_arch=rows[-1][0]; last_date=rows[-1][1]
        dabesi=d2DateNSince(last_date) if last_date else {'date':'—','since':0.0}
        total_dedup=sum(v['deduplicated_size'] for v in kept.values())
        last_k=kept[last_arch]
        tcmpl={}
        repo_st=self.db.get_repo_stats(nick)
        tcmpl[nick]={'nom':nick,'date derniere':dabesi['date'],'depuis':dabesi['since'],
            'duree':last_k['durationM'],'derniere':last_k['deduplicated_size'],
            'moy':total_dedup/c if c else 0,
            'taille':repo_st.get('unique_csize'),'recuperable':None,'reste':self.borg.dfRepo(nick)}
        s_last=diff_stats.get(last_arch)
        if s_last:
            for k,v in _fmt_stats(s_last,last_k['nfiles'],last_k['original_size'],summary=True).items(): tcmpl[nick][k]=v
        else:
            tcmpl[nick]['modifications']='—'
        tbkps={'Prunable':{'name':'Prunable','original_size':0,'compressed_size':0,'deduplicated_size':0}}
        display_keys=list(kept.keys())
        if maxp is not None: display_keys=display_keys[-maxp:]
        for arch in display_keys:
            k=kept[arch]
            tbkps[arch]={'name':arch,'duration':k['durationM'],
                'original_size':k['original_size'],'compressed_size':k['compressed_size'],
                'deduplicated_size':k['deduplicated_size'],'nfiles':k['nfiles']}
            s=diff_stats.get(arch)
            if s:
                for kk,vv in _fmt_stats(s,k['nfiles'],k['original_size']).items(): tbkps[arch][kk]=vv
            else:
                tbkps[arch]['modifications']='—'
        total_orig=sum(v['original_size'] for v in kept.values())
        total_compr=sum(v['compressed_size'] for v in kept.values())
        total_dedup2=sum(v['deduplicated_size'] for v in kept.values())
        tbkps['Totaux']={'name':'Totaux','original_size':total_orig,'compressed_size':total_compr,'deduplicated_size':total_dedup2}
        return tcmpl,tbkps

    def prep_report(self,nick,debug=0,maxp=None):
        cfg=self.borg.cfgreaded(nick,debug=debug)
        last_modified=self.borg._boex_last_modified(nick,debug=debug)
        pruneme=self.cache_prune_dryrun(nick,last_modified,debug=debug)
        r=self.cacheJsonBoexWithLM(nick,['info','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug,last_modified=last_modified)
        resume={}
        for i in ['duration','compressed_size','deduplicated_size','nfiles','original_size','prunable','prunable_os','prunable_cs']:
            resume[i]=0
        c=0; kept={}; notPrunable=0
        for i in r['archives']:
            resume['duration']+=i['duration']
            resume['compressed_size']+=i['stats']['compressed_size']
            resume['deduplicated_size']+=i['stats']['deduplicated_size']
            resume['original_size']+=i['stats']['original_size']
            resume['nfiles']+=i['stats']['nfiles']
            i['command_line']=[]; i['chunker_params']=[]
            kept[i['name']]={'name':i['name'],'durationM':i['duration']/60,
                'original_size':i['stats']['original_size'],'compressed_size':i['stats']['compressed_size'],
                'deduplicated_size':i['stats']['deduplicated_size'],'nfiles':i['stats']['nfiles']}
            if i['name'] in pruneme:
                i['pruneMe']='Yes'; kept[i['name']]['prunMe']='Yes'
                resume['prunable']+=i['stats']['deduplicated_size']
                resume['prunable_os']+=i['stats']['original_size']
                resume['prunable_cs']+=i['stats']['compressed_size']
            else:
                i['pruneMe']='No'; kept[i['name']]['prunMe']='No'; notPrunable+=1
            c+=1
        if c:
            resume['moy_duration']=resume['duration']/c
            resume['unique_csize']=r['cache']['stats']['unique_csize']
            for i in ['duration','compressed_size','deduplicated_size','nfiles','original_size','unique_csize']:
                resume['moy_'+i]=resume[i]/c
        else:
            resume['moy_duration']=resume['duration']
            resume['unique_csize']=r['cache']['stats']['unique_csize']
            for i in ['duration','compressed_size','deduplicated_size','nfiles','original_size','unique_csize']:
                resume['moy_'+i]=resume[i]
        resume['total_size']=r['cache']['stats']['total_size']
        resume['total_csize']=r['cache']['stats']['total_csize']
        if not c:
            resume['last']=r['repository']['last_modified']; resume['lastname']=""
        else:
            resume['last']=r['archives'][c-1]['start']; resume['lastname']=r['archives'][c-1]['name']
        if debug>0:
            print(json.dumps(r,indent=4)); print(json.dumps(resume,indent=4)); print(json.dumps(kept,indent=4))
        avail=self.borg.dfRepo(nick)
        dabesi=d2DateNSince(resume['last'])
        tcmpl={}
        tcmpl[nick]={'nom':nick,'date derniere':dabesi["date"],'depuis':dabesi['since']}
        if not c:
            tcmpl[nick]['duree']=-1; tcmpl[nick]['derniere']=0
        else:
            tcmpl[nick]['duree']=kept[resume['lastname']]['durationM']
            tcmpl[nick]['derniere']=kept[resume['lastname']]['deduplicated_size']
        tcmpl[nick]['moy']=resume['moy_deduplicated_size']
        tcmpl[nick]['taille']=resume['unique_csize']
        tcmpl[nick]['recuperable']=resume['prunable']
        tcmpl[nick]['reste']=avail
        tbkps={'Prunable':{'name':'Prunable','original_size':resume['prunable_os'],'compressed_size':resume['prunable_cs'],'deduplicated_size':resume['prunable']}}
        cpt=0
        for i in kept.keys():
            if kept[i]['prunMe']=='No':
                if (maxp is None) or ((notPrunable-cpt)<=maxp):
                    tbkps[i]=kept[i]
                    tbkps[i]['duration']=kept[i]['durationM']
                    tbkps[i].pop('durationM'); tbkps[i].pop('prunMe')
                cpt+=1
        tbkps['Totaux']={'name':'Totaux','original_size':resume['total_size'],'compressed_size':resume['total_csize'],'deduplicated_size':resume['unique_csize']}
        diff_stats=self.db._diff_stats_for_nick(nick)
        def _fmt_stats(s,nf,total_sz=0,summary=False):
            na,nr,nm=s['added'],s['removed'],s['modified']
            prev_nf=nf-na+nr; prev_sz=total_sz-s['added_sz']+s['removed_sz']
            pn_modif=f"{100*(nm+nr)//prev_nf}%nb" if prev_nf>0 else "—"
            ps_modif=f"{100*(s['modified_sz']+s['removed_sz'])//prev_sz}%B" if prev_sz>0 else "—"
            return {'modifications':f"{pn_modif} / {ps_modif}"}
        last_arch=resume.get('lastname','')
        s_last=diff_stats.get(last_arch) if last_arch else None
        if s_last:
            nf_last=kept.get(last_arch,{}).get('nfiles',0) or 0
            sz_last=kept.get(last_arch,{}).get('original_size',0) or 0
            for k,v in _fmt_stats(s_last,nf_last,sz_last,summary=True).items(): tcmpl[nick][k]=v
        else:
            tcmpl[nick]['modifications']='—'
        for arch in list(tbkps.keys()):
            if 'nfiles' not in tbkps[arch]: continue
            s=diff_stats.get(arch)
            if s:
                nf=tbkps[arch].get('nfiles',0) or 0; sz=tbkps[arch].get('original_size',0) or 0
                for k,v in _fmt_stats(s,nf,sz).items(): tbkps[arch][k]=v
            else:
                tbkps[arch]['modifications']='—'
        return tcmpl,tbkps

