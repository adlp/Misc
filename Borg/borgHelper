def getDataFromEnvOrFile(env=None,envpath=None,paths=None):
    """
    Vérifie si `env_var` est définie, sinon cherche un fichier dans `path_list_str`.
    Appelle `toto(data)` avec la valeur trouvée.
    """
    # 🔍 Vérifie la variable d’environnement
    if env:
        data = os.environ.get(env)
        if data:
            return(data)
    if envpath:
        fileName = os.environ.get(envpath)
        if fileName and os.path.isfile(fileName) and os.access(fileName, os.R_OK):
            with open(fileName, 'r', encoding='utf-8') as f:
                data = f.readline().strip()
                return(data)

    # 🔍 Recherche du premier fichier accessible
    pathlst = [p.strip() for p in paths.split(',')]
    for path in pathlst:
        if os.path.isfile(path) and os.access(path, os.R_OK):
            with open(path, 'r', encoding='utf-8') as f:
                data = f.readline().strip()
                print(f"📄 Fichier trouvé : {path}")
                return(data)

    # ❌ Rien trouvé
    return(None)


