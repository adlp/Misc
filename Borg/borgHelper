    def _diff_keep_purge(self,nick,keep,db_path,archives=None):
        """Garde les `keep` paires les plus récentes (1.0.141, bug DIFF_KEEP) : dans l'ordre de la liste d'archives
        (archives, celle de borg list) ; sans liste, par date d'archive (archive_stats) puis nom — jamais indexed_at
        (à la seconde, et réécrit par chaque re-diff : la paire gardée changeait d'un Index à l'autre)."""
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                rows=conn.execute("SELECT p.archive_old,p.archive_new FROM diff_indexed_pairs p LEFT JOIN archive_stats s "
                                  "ON s.nick=p.nick AND s.archive=p.archive_new WHERE p.nick=? "
                                  "ORDER BY s.archive_date DESC,p.archive_new DESC",(nick,)).fetchall()
                if archives is not None:
                    kept={(o,n) for o,n,_ in BorgHelper._diff_keep_pairs(archives,keep)}
                    to_delete=[r for r in rows if tuple(r) not in kept]
                else: to_delete=rows[keep:]
                if not to_delete: return
                # 1.0.140 : comptages des archives restantes figés avant de retirer leur paire (graphiques sur
                # STATS_RETENTION_MONTHS) ; échec du figeage -> sqlite3.Error, rien purgé.
                # Fantôme (1.0.143) : jamais d'écriture dans history.db — la base servie fige ses propres paires (AD-7).
                if not _is_shadow(db_path):
                    try: self.freeze_archive_chart(nick,self._chart_counts(nick,conn,{a_new for _,a_new in to_delete}),
                                                   _history_path_for(db_path))
                    except SystemExit: raise sqlite3.OperationalError("history.db indisponible — DIFF_KEEP reporté")
                for a_old,a_new in to_delete:
                    conn.execute("DELETE FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    conn.execute("DELETE FROM diff_indexed_pairs WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                    # 1.0.140 : exclus de la paire aussi — restés seuls, ils donnaient des comptages partiels non nuls
                    # qui masquaient les comptages figés.
                    conn.execute("DELETE FROM diff_excluded_stats WHERE nick=? AND archive_old=? AND archive_new=?",(nick,a_old,a_new))
                conn.commit()
                print(f"{nick}: DIFF_KEEP={keep} — {len(to_delete)} paire(s) ancienne(s) purgées")
            finally: conn.close()
        try: self._with_lock_retry(_do)
        except sqlite3.Error as e: printer(f"SQLite error ({db_path}): {e}")

    def store_excluded_diff_stats(self,nick,archive_old,archive_new,exclu,db_path=None):
        """exclu : {change_type: {'count': N, 'size': M}}"""
        if not exclu: return
        if db_path is None: db_path=self.get_diff_db(nick)
        def _do():
            conn=_open_db(db_path,nick=nick,role='write')
            try:
                conn.executemany(
                    "INSERT OR REPLACE INTO diff_excluded_stats "
                    "(nick,archive_old,archive_new,change_type,file_count,total_size) VALUES (?,?,?,?,?,?)",
                    [(nick,archive_old,archive_new,ct,s['count'],s['size']) for ct,s in exclu.items()])
                conn.commit()
