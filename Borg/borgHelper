def _idx_path_ok(path,cfg):
    """True si le chemin doit être indexé selon IDX_INCLUDE/IDX_EXCLUDE du nick."""
    import fnmatch
    includes=[p for p in cfg.get('IDX_INCLUDE','').split() if p]
    excludes=[p for p in cfg.get('IDX_EXCLUDE','').split() if p]
    if includes:
        if not any(path.startswith(p) or fnmatch.fnmatch(path,p) for p in includes):
            return False
    if excludes:
        if any(path.startswith(p) or fnmatch.fnmatch(path,p) for p in excludes):
            return False
    return True

