def parse_borg_size(s):
    s=s.strip()
    for unit,mult in [('TB',10**12),('GB',10**9),('MB',10**6),('kB',10**3),('B',1)]:
        if s.endswith(unit):
            try:
                return int(float(s[:-len(unit)].strip())*mult)
            except (ValueError,TypeError):
                return None
    return None

def parse_diff_line(line):
    line=line.rstrip()
    if not line:
        return None
    m=re.match(r'^added\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'added','size_before':None,
                'size_after':parse_borg_size(m.group(1)),'path':m.group(2)}
    m=re.match(r'^removed\s+([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'removed','size_before':parse_borg_size(m.group(1)),
                'size_after':None,'path':m.group(2)}
    m=re.match(r'^modified\s+\+([\d.]+\s+\w+)\s+-([\d.]+\s+\w+)\s+(.+)$',line)
    if m:
        return {'change_type':'modified',
                'size_before':parse_borg_size(m.group(2)),
                'size_after':parse_borg_size(m.group(1)),
                'path':m.group(3)}
    m=re.match(r'^([A-Z])\s+(.+)$',line)
    if m:
        return {'change_type':m.group(1),'size_before':None,
                'size_after':None,'path':m.group(2)}
    return None

def cmd_index(nick,debug=0,db_path=None):
    if db_path is None:
        db_path=get_diff_db(nick)
    ensure_diff_db(db_path)
    cfg=cfgreaded(nick,debug=debug)
    rb=boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
    archives=rb['stdout'][0]['archives']
    if len(archives)<2:
        printer(f"{nick}: moins de 2 archives, rien à indexer")
        return 0
    new_pairs=0
    skipped=0
    for i in range(len(archives)-1):
        a_old=archives[i]['name']
        a_new=archives[i+1]['name']
        date_new=archives[i+1]['start']
        if is_diff_pair_indexed(nick,a_old,a_new,db_path):
            skipped+=1
            continue
        print(f"  {nick}: {a_old} → {a_new}",flush=True)
        rb2=boex(nick,['diff',f"{cfg['BORG_REPO']}::{a_old}",a_new],debug=debug,retjson=False)
        entries=[]
        for line in rb2['stdout']:
            p=parse_diff_line(line)
            if p and p['path']:
                entries.append(p)
        store_diff_entries(nick,a_old,a_new,date_new,entries,db_path)
        new_pairs+=1
    print(f"{nick}: {new_pairs} paires indexées (+{skipped} déjà en cache)")
    cmd_indexsnap(nick,debug=debug,db_path=db_path)
    return 0

def cmd_indexsnap(nick,debug=0,db_path=None):
    if db_path is None:
        db_path=get_diff_db(nick)
    ensure_diff_db(db_path)
    cfg=cfgreaded(nick,debug=debug)
    rb=boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
    archives=rb['stdout'][0]['archives']
    if not archives:
        printer(f"{nick}: aucune archive")
        return 0
    latest=archives[-1]
    archive_name=latest['name']
    archive_date=latest['start']
    if is_archive_snapshot_indexed(nick,archive_name,db_path):
        print(f"{nick}: snapshot {archive_name} déjà indexé")
        return 0
    print(f"  {nick}: snapshot {archive_name}...",flush=True)
    rb2=boex(nick,['list','--format','{size} {isomtime} {path}{NL}',f"::{archive_name}"],debug=debug,retjson=False)
    if rb2['exitcode'] != 0:
        printer(f"borg list a échoué (code {rb2['exitcode']})")
        for i in rb2['stderr']:
            if isinstance(i,dict):
                printer(f"  [{i.get('levelname','?')}] {i.get('message',i)}")
            elif isinstance(i,str) and i.strip():
                printer(f"  {i}")
        return rb2['exitcode']
    files=[]
    for line in rb2['stdout']:
        line=line.strip()
        if not line:
            continue
        parts=line.split(' ',2)
        if len(parts)==3:
            try:
                size=int(parts[0])
            except ValueError:
                size=None
            files.append({'path':parts[2],'size':size,'mtime':parts[1]})
    store_archive_snapshot(nick,archive_name,archive_date,files,db_path)
    print(f"{nick}: {len(files)} fichiers dans le snapshot {archive_name}")
    return 0

