def _bkp_file_status(i):
    """(status, path) si `i` (entrée stderr de boex, dict --log-json ou chaîne) est une ligne
    borg create --list, sinon None."""
    if isinstance(i,dict):
        if i.get('type')=='file_status': return i.get('status',''),i.get('path','')
        if i.get('name')=='borg.output.list':
            m=i.get('message','')
            if len(m)>=3 and m[1]==' ': return m[0],m[2:]
    return None

# Types de changement borg diff (--json-lines) qui ajoutent / suppriment une entrée — fichier,
# répertoire ou lien (parse_diff_line_json garde le type borg brut hors added/removed/modified).
# borg diff (1.2) qualifie par un suffixe tout ce qui n'est pas un fichier ordinaire : 'added directory',
# 'removed link', 'added fifo', 'removed chrdev'/'blkdev', 'changed link' ; un fichier ordinaire est
# 'added'/'removed' (avec taille) ou 'modified'. Le type de l'entrée est donc DÉJÀ dans change_type,
# y compris pour les lignes indexées avant 1.0.126 — aucune colonne de type n'est nécessaire (1.0.126 :
# fifo/chrdev/blkdev ajoutés ici, ils manquaient ; supprimés ignorés par TreeHist/TreeFind, voir _diff_entry_type).
_DIFF_TYPE_OF_SUFFIX={'directory':'d','link':'l','fifo':'p','chrdev':'c','blkdev':'b'}
_DIFF_ADDED_TYPES=('added',)+tuple('added '+x for x in _DIFF_TYPE_OF_SUFFIX)
_DIFF_REMOVED_TYPES=('removed',)+tuple('removed '+x for x in _DIFF_TYPE_OF_SUFFIX)

def _exclu_detail(by_ct):
    """Détail des exclus d'IdxTop/DiffTop (1.0.155, story 18) : {change_type: (nombre, taille)} -> '+N · -N · =N', par
    familles comme Report (_diff_stats_for_nick) : ajouts (_DIFF_ADDED_TYPES), suppressions (_DIFF_REMOVED_TYPES), tout le
    reste (modified, changed link, mode…) ; la somme vaut toujours le total. Avant, seuls added/removed/modified."""
    fam={'+':0,'-':0,'=':0}
    for ct,(n,_sz) in by_ct.items():
        fam['+' if ct in _DIFF_ADDED_TYPES else '-' if ct in _DIFF_REMOVED_TYPES else '=']+=n or 0
    return ' · '.join(f"{k}{v:,}" for k,v in fam.items() if v)

def _diff_entry_type(change_type,size_before=None):
    """Type borg ('-','d','l','p','c','b', clés de _TREEHIST_GENRES) d'une ligne diff_index d'après son
    change_type ; None si l'événement ne le dit pas (changement de mode/propriétaire/dates seul). Repli
    historique : 'removed' SANS taille -> 'd' (lignes synthétiques/anciennes ; borg donne toujours une
    taille, même 0, à un fichier supprimé)."""
    if change_type in ('added','modified'): return '-'
    if change_type=='removed': return 'd' if size_before is None else '-'
    head,_,suffix=(change_type or '').partition(' ')
    if head in ('added','removed','changed'): return _DIFF_TYPE_OF_SUFFIX.get(suffix)
    return None

def parse_diff_line_json(line):
    line=line.strip()
    if not line: return None
    try: obj=json.loads(line)
    except (json.JSONDecodeError,ValueError): return None
    path=obj.get('path')
    if not path: return None
    changes=obj.get('changes',[])
    if not changes: return None
    change_type=None; size_before=None; size_after=None
    for ch in changes:
        t=ch.get('type','')
        if t=='added':
            change_type='added'; size_after=ch.get('size'); break
        elif t=='removed':
            change_type='removed'; size_before=ch.get('size'); break
        elif t=='modified':
            change_type='modified'; size_after=ch.get('added'); size_before=ch.get('removed'); break
    if change_type is None:
        change_type=changes[0].get('type','?')
    return {'change_type':change_type,'size_before':size_before,'size_after':size_after,'path':path}

def _borg_glob_args(ftor):
    """Sélection par joker (`*`/`?`) pour borg extract/list (1.0.122). borg exige un opérateur en tête de
    --pattern (`sh:X` seul -> ArgumentTypeError, la restauration par joker n'a jamais fonctionné), et un
    `+` seul ne restreint rien (le défaut reste « inclure tout ») : inclure le motif PUIS exclure le reste.
    Vérifié sur borg 1.2.6 (démo : motif e1000 -> 4 fichiers sur 15 244 ; `/` de tête accepté)."""
    return [f'--pattern=+sh:{ftor}','--pattern=-sh:**']

def _borg_extract_args(bid,ftor):
    base=['extract','--numeric-owner','--exclude','*/log/*',f'::{bid}']
    if '*' in ftor or '?' in ftor: base+=_borg_glob_args(ftor)
    else: base.append(ftor)
    return base

