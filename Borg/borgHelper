def ensure_table_exists(db_path, table_name, create_query):
    """
    Vérifie si une table existe dans la base SQLite, et la crée si elle est absente.

    :param db_path: Chemin vers le fichier .sqlite
    :param table_name: Nom de la table à vérifier
    :param create_query: Requête SQL complète pour créer la table
    """
    try:
        conn = sqlite3.connect(db_path)
        cursor = conn.cursor()

        # Vérifie si la table existe
        cursor.execute("""
            SELECT name FROM sqlite_master
            WHERE type='table' AND name=?;
        """, (table_name,))
        result = cursor.fetchone()

        if result:
            if debug:
                print(f"✅ La table '{table_name}' existe déjà.")
        else:
            if debug:
                print(f"⚠️ La table '{table_name}' n'existe pas. Création en cours...")
            cursor.execute(create_query)
            conn.commit()
            if debug:
                print(f"✅ Table '{table_name}' créée avec succès.")

    except sqlite3.Error as e:
        print(f"❌ Erreur SQLite : {e}")
    finally:
        conn.close()

def get_details_if_exists(db_path, table_name, nom, lastmodified):
    """
    Recherche une entrée dans la table avec les champs 'nom' et 'lastmodified'.
    Si elle existe, retourne 'details', sinon retourne None.

    :param db_path: Chemin vers le fichier .sqlite
    :param table_name: Nom de la table à interroger
    :param nom: Valeur du champ 'nom'
    :param lastmodified: Valeur du champ 'lastmodified'
    :return: Valeur du champ 'details' ou None
    """
    try:
        conn = sqlite3.connect(db_path)
        cursor = conn.cursor()

        query = f"""
        SELECT details FROM {table_name}
        WHERE nom = ? AND lastmodified = ?
        LIMIT 1;
        """
        cursor.execute(query, (nom, lastmodified))
        result = cursor.fetchone()

        return result[0] if result else None

    except sqlite3.Error as e:
        print(f"❌ Erreur SQLite : {e}")
        return None
    finally:
        conn.close()

def insert_in_db(db_path, table_name, nom, lastmodified, details):
    """
    Insère une ligne dans la table si aucune entrée ne correspond à 'nom' et 'lastmodified'.

    :param db_path: Chemin vers le fichier .sqlite
    :param table_name: Nom de la table
    :param nom: Valeur du champ 'nom'
    :param lastmodified: Valeur du champ 'lastmodified'
    :param details: Valeur à insérer dans le champ 'details'
    :return: True si insertion effectuée, False si déjà présent
    """
    try:
        conn = sqlite3.connect(db_path)
        cursor = conn.cursor()

        # Insère la nouvelle entrée
        query_insert = f"""
        INSERT INTO {table_name} (nom, lastmodified, details)
        VALUES (?, ?, ?);
        """
        cursor.execute(query_insert, (nom, lastmodified, details))
        conn.commit()
        if debug:
            print(f"✅ Entrée insérée avec succès.")
        return True

    except sqlite3.Error as e:
        print(f"❌ Erreur SQLite : {e}")
        return False
    finally:
        conn.close()

