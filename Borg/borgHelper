def cmd_diffbkp(nick,bidun=None,bideux=None,debug=0,db_path=None):
    if db_path is None:
        db_path=get_diff_db(nick)
    cfg=cfgreaded(nick,debug=debug)
    twodiff=getlastbkp(nick,2,debug=debug)
    if bidun is None and bideux is None:
        bidun=twodiff[0]
        bideux=twodiff[1]
    elif bideux is None:
        bideux=bidun
        bidun=twodiff[1]
    if bidun == bideux:
        printer("Desole, ce sont les memes backups")
        sys.exit(1)

    if bidun > bideux:
        bidun,bideux=bideux,bidun

    if debug:
        printer(f"Comparaison de {bidun} et {bideux}")

    ensure_diff_db(db_path)

    if not is_diff_pair_indexed(nick,bidun,bideux,db_path):
        print(f"Paire non indexée — calcul en cours...",flush=True)
        rb=boex(nick,['list','--json','--glob-archives',cfg['GLOB_ARCH']],debug=debug)
        try:
            _boex_check_stdout(rb,nick,'borg list')
        except RuntimeError as e:
            printer(f"borg list a échoué : {e}")
            sys.exit(2)
        archives=rb['stdout'][0]['archives']
        date_new=next((a['start'] for a in archives if a['name']==bideux),None)
        rb2=boex(nick,['diff',f"{cfg['BORG_REPO']}::{bidun}",bideux],debug=debug,retjson=False)
        if rb2['exitcode'] != 0:
            printer(f"borg diff a échoué (code {rb2['exitcode']})")
            sys.exit(rb2['exitcode'])
        entries=[]
        for line in rb2['stdout']:
            p=parse_diff_line(line)
            if p and p['path']:
                entries.append(p)
        store_diff_entries(nick,bidun,bideux,date_new,entries,db_path)

    try:
        conn=sqlite3.connect(db_path)
        cur=conn.execute(
            "SELECT change_type,path,size_before,size_after "
            "FROM diff_index WHERE nick=? AND archive_old=? AND archive_new=? "
            "ORDER BY change_type,path",
            (nick,bidun,bideux))
        rows=cur.fetchall()
        conn.close()
    except sqlite3.Error as e:
        printer(f"SQLite error: {e}")
        sys.exit(3)

    print(f"{bidun} → {bideux}")
    if not rows:
        print("Aucune différence.")
        sys.exit(0)

    from prettytable import PrettyTable
    t=PrettyTable(['type','chemin','avant','après'])
    t.align['chemin']='l'
    for type_r,path_r,sb,sa in rows:
        t.add_row([type_r,path_r,
                   convert_octets_readable(sb) if sb else '',
                   convert_octets_readable(sa) if sa else ''])
    print(t)
    sys.exit(0)

def _find_last_archive_with_file(nick,path,debug=0):
    """Retourne la dernière archive connue contenant ce chemin ou pattern (via SQLite), ou None."""
    db_path=get_diff_db(nick)
    has_glob='*' in path or '?' in path
    sql_pat=path.replace('*','%').replace('?','_') if has_glob else None
    op='LIKE' if has_glob else '='
    val=sql_pat if has_glob else path
    try:
        ensure_diff_db(db_path)
        conn=sqlite3.connect(db_path)
        row=conn.execute(
            f"SELECT archive FROM archive_snapshot_v WHERE nick=? AND path {op} ? ORDER BY archive DESC LIMIT 1",
            (nick,val)).fetchone()
        if row:
            conn.close()
            return row[0]
        row=conn.execute(
            f"SELECT archive_new FROM diff_index WHERE nick=? AND path {op} ? AND change_type!='removed' "
            "ORDER BY archive_new_date DESC LIMIT 1",
            (nick,val)).fetchone()
        conn.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None

def _borg_extract_args(bid,ftor):
    """Construit les args borg extract selon que ftor est un pattern ou un chemin exact.
    --numeric-owner : préserve uid/gid numériques pour restaurer les droits d'origine."""
    base=['extract','--numeric-owner','--exclude','*/log/*',f'::{bid}']
    if '*' in ftor or '?' in ftor:
        base+=[f'--pattern=sh:{ftor}']
    else:
        base.append(ftor)
    return base

def _is_tar_dest(path):
    return path.endswith('.tar') or path.endswith('.tgz') or path.endswith('.tar.gz')

def _print_boex_stderr(rb):
    for i in rb['stderr']:
        if isinstance(i,dict):
            lvl=i.get('levelname','INFO')
            if lvl not in ('DEBUG',):
                print(f"[{lvl}] {i.get('message',i)}",file=sys.stderr)
        elif isinstance(i,str) and i.strip():
            print(i,file=sys.stderr)

def _restore_to_tar(nick,bid,ftor,tarpath,flat=False,debug=0):
    import tempfile,tarfile as tf_mod
    stdout_mode=(tarpath=='-')
    with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
        rb=boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
        _print_boex_stderr(rb)
        if rb['exitcode'] not in (0,1):
            sys.exit(rb['exitcode'])
        if stdout_mode:
            mode='w|'   # streaming non-compressé vers stdout
        else:
            is_gz=tarpath.endswith('.tgz') or tarpath.endswith('.tar.gz')
            exists=os.path.exists(tarpath)
            if is_gz:
                if exists:
                    print(f"[ERREUR] {tarpath} existe déjà — impossible d'ajouter à un fichier gzip.",file=sys.stderr)
                    print(f"  Supprimez-le manuellement ou choisissez un autre nom.",file=sys.stderr)
                    sys.exit(3)
                mode='w:gz'
            else:
                mode='a' if exists else 'w'
        try:
            fobj=sys.stdout.buffer if stdout_mode else None
            with (tf_mod.open(fileobj=fobj,mode=mode) if stdout_mode
                  else tf_mod.open(tarpath,mode)) as tf:
                for root,dirs,files in os.walk(tmpdir):
                    if not flat:
                        for d in dirs:
                            dp=os.path.join(root,d)
                            tf.add(dp,arcname=os.path.relpath(dp,tmpdir),recursive=False)
                    for f in files:
                        fp=os.path.join(root,f)
                        arcname=(os.path.basename(fp) if flat
                                 else os.path.relpath(fp,tmpdir))
                        tf.add(fp,arcname=arcname)
        except BrokenPipeError:
            sys.exit(0)
        except OSError as e:
            import errno as _errno
            if e.errno==_errno.ENOSPC:
                print(f"[ERREUR] Espace disque insuffisant sur la cible : {e.filename or tarpath}",file=sys.stderr)
            else:
                print(f"[ERREUR] Écriture impossible : {e}",file=sys.stderr)
            sys.exit(3)
        if not stdout_mode:
            print(f"Restauré {'(plat) ' if flat else ''}dans {tarpath}",flush=True)
    sys.exit(rb['exitcode'])

