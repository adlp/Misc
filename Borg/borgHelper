_SNAP_NOTIN="AND NOT EXISTS(SELECT 1 FROM diff_index d WHERE d.nick=archive_snapshot_v.nick AND d.path=archive_snapshot_v.path{extra})"

def _diff_archive_filter(nick,archive_from,conn,archive_to=None):
    """Retourne (sql_extra, params) pour filtrer diff_index par plage d'archives.
    archive_from=None, archive_to=None  → uniquement la dernière paire
    archive_from='ALL'                  → tout l'index (+ filtre to si précisé)
    archive_from=name                   → depuis name (inclus)
    archive_to=name                     → jusqu'à name (inclus)
    """
    def _date_of(archive):
        row=conn.execute(
            "SELECT archive_new_date FROM diff_index WHERE nick=? AND (archive_new=? OR archive_old=?) LIMIT 1",
            (nick,archive,archive)).fetchone()
        return row[0] if row and row[0] else archive

    clauses=[]; params=[]

    if archive_from is None and archive_to is None:
        row=conn.execute("SELECT MAX(archive_new) FROM diff_index WHERE nick=?",(nick,)).fetchone()
        if row and row[0]:
            return ' AND archive_new=?',[row[0]]
        return '',[]

    if archive_from and archive_from!='ALL':
        d=_date_of(archive_from)
        clauses.append('archive_new_date>=?'); params.append(d)

    if archive_to:
        d=_date_of(archive_to)
        clauses.append('archive_new_date<=?'); params.append(d)

    if not clauses:
        return '',[]
    return ' AND '+' AND '.join(clauses),params

def _snap_notin(date_from='',date_to=''):
    """Clause NOT EXISTS pour archive_snapshot, avec filtres dates optionnels."""
    conds=[]
    if date_from: conds.append('d.archive_new_date>=?')
    if date_to:   conds.append('d.archive_new_date<=?')
    extra=(' AND '+' AND '.join(conds)) if conds else ''
    return f"AND NOT EXISTS(SELECT 1 FROM diff_index d WHERE d.nick=archive_snapshot_v.nick AND d.path=archive_snapshot_v.path{extra})"

def _duidx_path_key(path,depth):
    parts=path.split('/')
    return '/'.join(parts[:depth+1]) if depth<len(parts) else path

def _duidx_add(totals,key,ct,sz):
    k=(key,ct)
    if k not in totals: totals[k]=[0,0]
    totals[k][0]+=1
    totals[k][1]+=(sz or 0)

def _snap_params(af_params,archive_from,archive_to):
    """Retourne (date_from, date_to) pour _snap_notin depuis les params du filtre."""
    date_from=date_to=''
    if archive_from and archive_from!='ALL' and af_params:
        date_from=af_params[0]
    if archive_to and len(af_params)>=(2 if date_from else 1):
        date_to=af_params[-1]
    return date_from,date_to

def _duidx_collect(nick,sql_pat,key_fn,archive_from=None,archive_to=None):
    """Collecte par chemin (clé = key_fn(path))."""
    totals={}
    for n in nick.split(','):
        db_path=get_diff_db(n)
        ensure_diff_db(db_path)
        if _is_index_empty(n,db_path):
            printer(f"[ERREUR] Index vide pour {n} — lancez : borgHelper -c Index -n {n}")
            continue
        try:
            conn=sqlite3.connect(db_path)
            af_sql,af_params=_diff_archive_filter(n,archive_from,conn,archive_to)
            for ct,path,sz in conn.execute(
                    "SELECT change_type,path,"
                    "CASE WHEN change_type='removed' THEN size_before ELSE size_after END "
                    "FROM diff_index WHERE nick=? AND path LIKE ?"+af_sql,
                    [n,sql_pat]+af_params):
                _duidx_add(totals,key_fn(path),ct,sz)
            df,dt=_snap_params(af_params,archive_from,archive_to)
            snap_extra=[x for x in [df,dt] if x]
            for path,sz in conn.execute(
                    "SELECT path,size FROM archive_snapshot_v WHERE nick=? AND path LIKE ? "+_snap_notin(df,dt),
                    [n,sql_pat]+snap_extra):
                _duidx_add(totals,key_fn(path),'présent',sz)
            conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error ({n}): {e}")
    return totals

def _duidx_collect_global(nick,sql_pat,archive_from=None,archive_to=None):
    """Collecte globale agrégée par type (sans groupement chemin)."""
    totals={}
    for n in nick.split(','):
        db_path=get_diff_db(n)
        ensure_diff_db(db_path)
        if _is_index_empty(n,db_path):
            printer(f"[ERREUR] Index vide pour {n} — lancez : borgHelper -c Index -n {n}")
            continue
        try:
            conn=sqlite3.connect(db_path)
            af_sql,af_params=_diff_archive_filter(n,archive_from,conn,archive_to)
            for ct,cnt,sz in conn.execute(
                    "SELECT change_type,COUNT(*),SUM(CASE WHEN change_type='removed' THEN size_before ELSE size_after END) "
                    "FROM diff_index WHERE nick=? AND path LIKE ? GROUP BY change_type"+af_sql,
                    [n,sql_pat]+af_params):
                k=('',ct)
                if k not in totals: totals[k]=[0,0]
                totals[k][0]+=cnt; totals[k][1]+=(sz or 0)
            df,dt=_snap_params(af_params,archive_from,archive_to)
            snap_extra=[x for x in [df,dt] if x]
            row=conn.execute(
                "SELECT COUNT(*),SUM(size) FROM archive_snapshot_v WHERE nick=? AND path LIKE ? "+_snap_notin(df,dt),
                [n,sql_pat]+snap_extra).fetchone()
            if row and row[0]:
                k=('','présent')
                if k not in totals: totals[k]=[0,0]
                totals[k][0]+=row[0]; totals[k][1]+=(row[1] or 0)
            conn.close()
        except sqlite3.Error as e:
            printer(f"SQLite error ({n}): {e}")
    return totals

_DUIDX_COL_KEYS  =['added','removed','présent']
_DUIDX_COL_NAMES =['added/modif','removed','présent']

def _duidx_fmt(cnt,sz):
    return f"{cnt} / {convert_octets_readable(sz)}" if cnt else '—'

def _duidx_merge(totals):
    """Fusionne added/modified/C/B/T → 'added' pour la vue pivotée."""
    merged={}
    for (pk,ct),(cnt,sz) in totals.items():
        eff='added' if ct in ('added','modified','C','B','T') else ct
        k=(pk,eff)
        if k not in merged: merged[k]=[0,0]
        merged[k][0]+=cnt; merged[k][1]+=sz
    return merged

def _duidx_sort_key(pk,merged,sort_by,reverse):
    """Clé de tri pour une ligne de la vue pivotée."""
    if sort_by=='chemin': return pk
    idx=_DUIDX_COL_KEYS.index(sort_by) if sort_by in _DUIDX_COL_KEYS else 0
    sz=merged.get((pk,_DUIDX_COL_KEYS[idx]),[0,0])[1]
    return -sz if reverse else sz

def _duidx_print(totals,label,grouped,sort_by='chemin',reverse=False,as_json=False):
    if not totals:
        print("Aucune donnée." if not as_json else '{}')
        return
    if grouped:
        merged=_duidx_merge(totals)
        paths=sorted(set(pk for pk,_ in merged),
                     key=lambda pk:_duidx_sort_key(pk,merged,sort_by,reverse),
                     reverse=(reverse if sort_by!='chemin' else False))
        totcol={ck:[0,0] for ck in _DUIDX_COL_KEYS}
        rows_data=[]
        for pk in paths:
            entry={'chemin':pk}
            for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES):
                cnt,sz=merged.get((pk,ck),[0,0])
                entry[cn]={'nb':cnt,'taille':sz}
                totcol[ck][0]+=cnt; totcol[ck][1]+=sz
            rows_data.append(entry)
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{cn:{'nb':totcol[ck][0],'taille':totcol[ck][1]}
                          for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES)}}
            print(json.dumps(out,ensure_ascii=False,indent=2))
            return
        from prettytable import PrettyTable
        t=PrettyTable(['chemin']+_DUIDX_COL_NAMES)
        t.align['chemin']='l'
        for cn in _DUIDX_COL_NAMES: t.align[cn]='r'
        for entry in rows_data:
            t.add_row([entry['chemin']]+[_duidx_fmt(entry[cn]['nb'],entry[cn]['taille'])
                                          for cn in _DUIDX_COL_NAMES])
        t.add_row(['---']+['---']*len(_DUIDX_COL_NAMES))
        t.add_row(['TOTAL']+[_duidx_fmt(totcol[ck][0],totcol[ck][1]) for ck in _DUIDX_COL_KEYS])
    else:
        order=_DUIDX_TYPE_ORDER
        rows_data=[]
        for (pk,ct),(cnt,sz) in sorted(totals.items(),
                key=lambda x:(order.index(x[0][1]) if x[0][1] in order else 99)):
            rows_data.append({'type':ct,'nb':cnt,'taille':sz})
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{'nb':sum(r['nb'] for r in rows_data),
                          'taille':sum(r['taille'] for r in rows_data)}}
            print(json.dumps(out,ensure_ascii=False,indent=2))
            return
        from prettytable import PrettyTable
        t=PrettyTable(['type','nb','taille'])
        t.align['type']='l'; t.align['taille']='r'
        total_count=total_size=0
        for r in rows_data:
            t.add_row([r['type'],r['nb'],convert_octets_readable(r['taille']) if r['taille'] else '—'])
            total_count+=r['nb']; total_size+=r['taille']
        t.add_row(['---','---','---'])
        t.add_row(['TOTAL',total_count,convert_octets_readable(total_size)])
    if label: print(f"Pattern : {label}")
    print(t)

def cmd_duidx(nick,pattern=None,sort_by='chemin',reverse=False,as_json=False,archive_from=None,archive_to=None,debug=0):
    if pattern is None:
        totals=_duidx_collect_global(nick,'%',archive_from,archive_to)
        _duidx_print(totals,None,False,sort_by,reverse,as_json)
        return
    if '/*' in pattern or pattern=='*':
        prefix=pattern.rsplit('/*',1)[0] if '/*' in pattern else ''
        depth=prefix.count('/')+1 if prefix else 0
        sql_pat=(prefix+'/%').lstrip('/') if prefix else '%'
        totals=_duidx_collect(nick,sql_pat,lambda p:_duidx_path_key(p,depth),archive_from,archive_to)
        _duidx_print(totals,pattern,True,sort_by,reverse,as_json)
    else:
        sql_pat=pattern.replace('*','%').replace('?','_')
        if '%' not in sql_pat and '_' not in sql_pat:
            sql_pat='%'+sql_pat+'%'
        totals=_duidx_collect_global(nick,sql_pat,archive_from,archive_to)
        _duidx_print(totals,pattern,False,sort_by,reverse,as_json)

