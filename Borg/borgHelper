                    for a in archives:
                        indexed+=conn.execute("SELECT DISTINCT archive_new FROM diff_indexed_pairs WHERE nick=? AND archive_new=?",(nick,a)).fetchall()
                        rows+=conn.execute("SELECT archive_new,change_type,COUNT(*),SUM(size_after),SUM(size_before) FROM diff_index WHERE nick=? AND archive_new=? GROUP BY archive_new,change_type",(nick,a)).fetchall()
                        exclu_rows+=conn.execute("SELECT archive_new,change_type,SUM(file_count),SUM(total_size) FROM diff_excluded_stats WHERE nick=? AND archive_new=? GROUP BY archive_new,change_type",(nick,a)).fetchall()
            finally:
                if own: conn.close()
            zero=lambda: {'added':0,'removed':0,'modified':0,'added_sz':0,'removed_sz':0,'modified_sz':0}
            stats={arch:zero() for (arch,) in indexed}
            # 1.0.116 : répertoires/liens ajoutés ou supprimés comptés comme tels (étaient « modifiés »).
            for arch,ctype,cnt,sz_after,sz_before in rows:
                if arch not in stats: stats[arch]=zero()
                if ctype in _DIFF_ADDED_TYPES: stats[arch]['added']+=cnt; stats[arch]['added_sz']+=(sz_after or 0)
                elif ctype in _DIFF_REMOVED_TYPES: stats[arch]['removed']+=cnt; stats[arch]['removed_sz']+=(sz_before or 0)
                else: stats[arch]['modified']+=cnt; stats[arch]['modified_sz']+=(sz_after or 0)
            for arch,ctype,cnt,sz in exclu_rows:
                if arch not in stats: stats[arch]=zero()
                if ctype in _DIFF_ADDED_TYPES: stats[arch]['added']+=cnt; stats[arch]['added_sz']+=(sz or 0)
                elif ctype in _DIFF_REMOVED_TYPES: stats[arch]['removed']+=cnt; stats[arch]['removed_sz']+=(sz or 0)
                else: stats[arch]['modified']+=cnt; stats[arch]['modified_sz']+=(sz or 0)
