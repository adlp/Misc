# ── PerfBench — mesures de performance sur jeu de données synthétique (story 6) ─
# Générateur SQL direct (INSERT/executemany par gros lots), jamais de vrai `borg backup` (bien trop
# lent pour représenter plusieurs Go en temps de test raisonnable). Bases TEMPORAIRES uniquement
# (comme CodecSelfTest) : aucune vraie base ni vrai rc n'est touché, tout est nettoyé en `finally`.

_PB_DEFAULT_DIFF_ROWS=250000  # voir Implementation Notes (TECHNICAL.md) pour la justification de
# cet ordre de grandeur (octets/ligne mesurés x nombre de lignes ~ taille cible)
_PB_KDF_DEFAULT_ROWS=30000  # -K SANS -n explicite : jeu réduit dédié pour KDF/DbEncrypt/DbDecrypt
# ("plus lent, optionnel" — ne doit jamais migrer le jeu par défaut/complet, seulement un -n explicite
# doit gouverner cette taille aussi, voir perf_bench())
_PB_JUDGMENT_S=1.0  # seuil de jugement (Intent/Boundaries de la story) : opération de lecture
# interactive (TreeHist/TreeFind/Search) qui dépasse la seconde sur le jeu de référence
_PB_ARCHIVES=[f"pb-a{i}" for i in range(5)]        # pb-a0..pb-a4 ; pb-a4 = dernière (snapshot courant)
_PB_DATES=[f"2026-0{i+1}-15T00:00:00" for i in range(5)]

def _pb_build_dirs(n_dirs_target,seed):
    """Arborescence synthétique, profondeur variable (jamais tout au même niveau) : part d'une
    vingtaine de répertoires de tête réalistes, puis étend récursivement au hasard jusqu'à atteindre
    n_dirs_target, en bornant la profondeur (7) pour rester réaliste."""
    import random
    rnd=random.Random(seed)
    top=['etc','var','var/log','var/lib','var/cache','home','home/user1','home/user2','home/user3',
         'usr','usr/share','usr/lib','usr/local','opt','srv','data','data/archive','data/archive/2024',
         'data/archive/2025','mnt/backup','mnt/backup/daily','mnt/backup/weekly']
    sub=['sub','cache','tmp','logs','conf.d','modules','plugins','assets','build','node_modules',
         'src','include','bin','lib','share','doc','vendor','dist','releases','snapshots']
    dirs=list(top)
    while len(dirs)<n_dirs_target:
        parent=dirs[rnd.randrange(len(dirs))]
        if parent.count('/')>=7: parent=top[rnd.randrange(len(top))]
        dirs.append(parent+'/'+sub[rnd.randrange(len(sub))]+str(rnd.randrange(1000)))
    return dirs

def _pb_build_paths(n_files,dirs,seed):
    """n_files chemins uniques (garantis, suffixe numérique en cas de collision (répertoire,nom)) —
    même nom de fichier réutilisé dans des répertoires différents (cas réaliste que AD-3 protège),
    profondeur héritée de `dirs`."""
    import random
    rnd=random.Random(seed)
    fname=['app.log','config.json','data.db','index.html','main.py','README.md','style.css',
           'output.txt','error.log','settings.yaml','backup.tar.gz','image.png','script.sh',
           'notes.txt','archive.zip','report.pdf','cache.bin','session.dat','manifest.xml','token.key']
    counts={}; paths=[]
    for _ in range(n_files):
        d=dirs[rnd.randrange(len(dirs))]; f=fname[rnd.randrange(len(fname))]
        c=counts.get((d,f),0); counts[(d,f)]=c+1
        paths.append(f"{d}/{f}" if c==0 else f"{d}/{f}.{c}")
    return paths

def _pb_build_db(db_path,nick,paths,root_removed,diff_target,encrypted,passphrase=None):
    """Construit un diff_index/snapshot_file synthétique par INSERT direct (executemany en gros lots) :
    snapshot complet uniquement sur la dernière archive (pb-a4, comme un jeu de mesure, pas un
    historique complet à indexer), churn (added/modified/removed) réparti sur les 4 paires
    d'archives ; `root_removed` (quelques centaines de chemins à la racine) disparaît à la toute
    dernière paire -> supprimés récupérables directement sous la racine (TreeHist/TreeFind)."""
    import random
    rnd=random.Random(4242)
    for suf in ('','-wal','-shm'):
        if os.path.exists(db_path+suf): os.unlink(db_path+suf)
    dbh=BorgHelperDB(os.path.dirname(db_path),'pb')
    dbh.ensure_diff_db(db_path)
    if encrypted:
        hdr,_dek=_enc_header_build(passphrase,'siv1','light')  # 'light' ici : coût KDF mesuré à part (-K)
        c=_open_db(db_path,nick=None,role='admin'); _enc_header_write(c,hdr); c.close()
    conn=_open_db(db_path,nick=nick,passphrase=passphrase,role='write',timeout=120)
    conn.execute("PRAGMA synchronous=OFF")  # fixture jetable : seule la vitesse de construction compte
    E=(lambda p: conn.codec.path.encode(p)) if conn.codec else (lambda p: p)
    BATCH=10000
    def _run_batched(sql,rows_iter):
        buf=[]
        for r in rows_iter:
            buf.append(r)
            if len(buf)>=BATCH: conn.executemany(sql,buf); buf=[]
        if buf: conn.executemany(sql,buf)
    _run_batched("INSERT INTO snapshot_file(nick,path,size,mtime,type,mode,owner) VALUES(?,?,?,?,?,?,?)",
                 ((nick,E(p),rnd.randrange(1,5_000_000),'2026-05-15T00:00:00','-','-rw-r--r--','1000:1000') for p in paths))
    conn.commit()
    ids={stored:rid for stored,rid in conn.execute("SELECT path,id FROM snapshot_file WHERE nick=?",(nick,))}
    _run_batched("INSERT INTO archive_snapshot(nick,archive,archive_date,file_id) VALUES(?,?,?,?)",
                 ((nick,_PB_ARCHIVES[-1],_PB_DATES[-1],ids[E(p)]) for p in paths))
    conn.execute("INSERT INTO archive_snapshot_indexed(nick,archive,entry_count) VALUES(?,?,?)",(nick,_PB_ARCHIVES[-1],len(paths)))
    for a,d in zip(_PB_ARCHIVES,_PB_DATES):
        conn.execute("INSERT INTO archive_stats(nick,archive,archive_date,nfiles) VALUES(?,?,?,?)",(nick,a,d,len(paths)))
    for ao,an in zip(_PB_ARCHIVES,_PB_ARCHIVES[1:]):
        conn.execute("INSERT INTO diff_indexed_pairs(nick,archive_old,archive_new,entry_count) VALUES(?,?,?,0)",(nick,ao,an))
    conn.commit()
    n_pairs=len(_PB_ARCHIVES)-1
    per_pair=max(1,diff_target//n_pairs)
    def _diff_rows():
        for pi in range(n_pairs):
            ao,an,dn=_PB_ARCHIVES[pi],_PB_ARCHIVES[pi+1],_PB_DATES[pi+1]
            for _ in range(per_pair):
                p=paths[rnd.randrange(len(paths))]; r=rnd.random()
                if r<0.30: ct,sb,sa='added',None,rnd.randrange(1,1_000_000)
                elif r<0.85: ct,sb,sa='modified',rnd.randrange(1,1_000_000),rnd.randrange(1,1_000_000)
                else: ct,sb,sa='removed',rnd.randrange(1,1_000_000),None
                yield (nick,ao,an,dn,ct,E(p),sb,sa)
            if pi==n_pairs-1:
                for p in root_removed: yield (nick,ao,an,dn,'removed',E(p),rnd.randrange(1,100000),None)
    _run_batched("INSERT INTO diff_index(nick,archive_old,archive_new,archive_new_date,change_type,path,size_before,size_after) VALUES(?,?,?,?,?,?,?,?)",
                 _diff_rows())
    conn.commit(); conn.close()

def perf_bench(size=None,with_kdf=False):
    """Génère un jeu de données synthétique réaliste (SQL direct, PAS de vrai borg) et chronomètre
    chaque commande listée dans l'Intent de la story 6, en mode plain ET chiffré (`time.perf_counter`).
    -K (with_kdf=True) : ajoute le coût KDF (DB_KDF=standard/light/strong) et DbEncrypt/DbDecrypt —
    sur un jeu réduit dédié (`_PB_KDF_DEFAULT_ROWS`) si `-n` n'a pas été donné explicitement (sinon,
    `-n` gouverne aussi ce jeu, même combiné à `-K`). Fichiers temporaires nettoyés en `finally`
    (succès ou échec). Ne corrige jamais rien — seulement question posée à l'utilisateur pour toute
    mesure qui dépasse le seuil de jugement (Boundaries de la story) ; retourne 0 si toutes les
    mesures ont pu s'exécuter, 1 si l'une d'elles a levé une exception (voir `results`)."""
    import tempfile,shutil,time,io,contextlib
    size_explicit=size is not None
    n_diff=size or _PB_DEFAULT_DIFF_ROWS
    n_files=max(1000,n_diff//3)
    n_dirs=max(50,n_files//20)
    n_root_removed=300
    tmp=tempfile.mkdtemp(prefix='borghelper-perfbench-')
    results=[]
    try:
        cache=os.path.join(tmp,'cache'); os.makedirs(cache)
        rc=os.path.join(tmp,'rc')
        with open(rc,'w') as f:
            f.write("[pb_plain]\nBORG_REPO=/r\nBORG_PASSPHRASE=x\nSER_NAME=s\nGLOB_ARCH=s-*\nMOUNTPOINT=/m\n\n")
            f.write("[pb_enc]\nBORG_REPO=/r\nBORG_PASSPHRASE=benchpw\nSER_NAME=s\nGLOB_ARCH=s-*\nMOUNTPOINT=/m\nDB_ENCRYPT=true\n\n")
