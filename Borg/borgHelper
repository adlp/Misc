def filtrer_lignes(tableau,X):
    toutes_cles=list(tableau.keys())
    if X>len(toutes_cles): cles_a_conserver=toutes_cles
    else: cles_a_conserver=toutes_cles[:2]+toutes_cles[-X:]
    return {cle:tableau[cle] for cle in cles_a_conserver}

def _snap_notin(date_from='',date_to=''):
    conds=[]
    if date_from: conds.append('d.archive_new_date>=?')
    if date_to: conds.append('d.archive_new_date<=?')
    extra=(' AND '+' AND '.join(conds)) if conds else ''
    return f"AND NOT EXISTS(SELECT 1 FROM diff_index d WHERE d.nick=archive_snapshot_v.nick AND d.path=archive_snapshot_v.path{extra})"

def _snap_params(af_params,archive_from,archive_to):
    date_from=date_to=''
    if archive_from and archive_from!='ALL' and af_params: date_from=af_params[0]
    if archive_to and len(af_params)>=(2 if date_from else 1): date_to=af_params[-1]
    return date_from,date_to

def _duidx_path_key(path,depth):
    parts=path.split('/')
    return '/'.join(parts[:depth+1]) if depth<len(parts) else path

def _duidx_add(totals,key,ct,sz):
    k=(key,ct)
    if k not in totals: totals[k]=[0,0]
    totals[k][0]+=1; totals[k][1]+=(sz or 0)

def _duidx_merge(totals):
    merged={}
    for (pk,ct),(cnt,sz) in totals.items():
        eff='added' if ct in ('added','modified','C','B','T') else ct
        k=(pk,eff)
        if k not in merged: merged[k]=[0,0]
        merged[k][0]+=cnt; merged[k][1]+=sz
    return merged

def _duidx_sort_key(pk,merged,sort_by,reverse):
    if sort_by=='chemin': return pk
    idx=_DUIDX_COL_KEYS.index(sort_by) if sort_by in _DUIDX_COL_KEYS else 0
    sz=merged.get((pk,_DUIDX_COL_KEYS[idx]),[0,0])[1]
    return -sz if reverse else sz

def _duidx_fmt(cnt,sz):
    return f"{cnt} / {convert_octets_readable(sz)}" if cnt else '—'

def _duidx_print(totals,label,grouped,sort_by='chemin',reverse=False,as_json=False):
    if not totals:
        print("Aucune donnée." if not as_json else '{}'); return
    if grouped:
        merged=_duidx_merge(totals)
        paths=sorted(set(pk for pk,_ in merged),
                     key=lambda pk:_duidx_sort_key(pk,merged,sort_by,reverse),
                     reverse=(reverse if sort_by!='chemin' else False))
        totcol={ck:[0,0] for ck in _DUIDX_COL_KEYS}
        rows_data=[]
        for pk in paths:
            entry={'chemin':pk}
            for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES):
                cnt,sz=merged.get((pk,ck),[0,0])
                entry[cn]={'nb':cnt,'taille':sz}
                totcol[ck][0]+=cnt; totcol[ck][1]+=sz
            rows_data.append(entry)
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{cn:{'nb':totcol[ck][0],'taille':totcol[ck][1]} for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES)}}
            print(json.dumps(out,ensure_ascii=False,indent=2)); return
        from prettytable import PrettyTable
        t=PrettyTable(['chemin']+_DUIDX_COL_NAMES)
        t.align['chemin']='l'
        for cn in _DUIDX_COL_NAMES: t.align[cn]='r'
        for entry in rows_data:
            t.add_row([entry['chemin']]+[_duidx_fmt(entry[cn]['nb'],entry[cn]['taille']) for cn in _DUIDX_COL_NAMES])
        t.add_row(['---']+['---']*len(_DUIDX_COL_NAMES))
        t.add_row(['TOTAL']+[_duidx_fmt(totcol[ck][0],totcol[ck][1]) for ck in _DUIDX_COL_KEYS])
    else:
        order=_DUIDX_TYPE_ORDER
        rows_data=[]
        for (pk,ct),(cnt,sz) in sorted(totals.items(),key=lambda x:(order.index(x[0][1]) if x[0][1] in order else 99)):
            rows_data.append({'type':ct,'nb':cnt,'taille':sz})
        if as_json:
            out={'pattern':label,'rows':rows_data,
                 'total':{'nb':sum(r['nb'] for r in rows_data),'taille':sum(r['taille'] for r in rows_data)}}
            print(json.dumps(out,ensure_ascii=False,indent=2)); return
        from prettytable import PrettyTable
        t=PrettyTable(['type','nb','taille'])
        t.align['type']='l'; t.align['taille']='r'
        total_count=total_size=0
        for r in rows_data:
            t.add_row([r['type'],r['nb'],convert_octets_readable(r['taille']) if r['taille'] else '—'])
            total_count+=r['nb']; total_size+=r['taille']
        t.add_row(['---','---','---'])
        t.add_row(['TOTAL',total_count,convert_octets_readable(total_size)])
    if label: print(f"Pattern : {label}")
    print(t)

