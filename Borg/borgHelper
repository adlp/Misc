def _b64e(b):
    """base64 standard sans padding, '+'->'.' et '/'->'-' (alphabet A-Za-z0-9.-)."""
    return base64.b64encode(bytes(b)).decode('ascii').rstrip('=').replace('+','.').replace('/','-')

# Même alphabet que _B64_ALPHABET (CodecSelfTest vérifie l'égalité) : une regex compilée remplace le
# test caractère par caractère en Python, qui représentait ~la moitié du coût de décodage (1.0.120).
_B64_RE=re.compile(r'[A-Za-z0-9.\-]*')

def _b64d(s):
    """Décodage strict : alphabet exact, longueur != 1 mod 4, forme canonique (bits de bourrage nuls)."""
    if not isinstance(s,str) or not _B64_RE.fullmatch(s):
        raise DbCodecError("caractère hors alphabet")
    if len(s)%4==1:
        raise DbCodecError("longueur invalide")
    try:
        raw=base64.b64decode(s.replace('.','+').replace('-','/')+'='*(-len(s)%4),validate=True)
    except ValueError:
        raise DbCodecError("base64 invalide")
    if _b64e(raw)!=s:
        raise DbCodecError("encodage non canonique")
    return raw

def _xor(a,b):
    """XOR octet à octet, tronqué à la plus courte (comme zip) — par entier (1.0.120) plutôt que
    par générateur d'octets Python : même résultat, bien plus rapide."""
    n=min(len(a),len(b))
    return (int.from_bytes(a[:n],'big')^int.from_bytes(b[:n],'big')).to_bytes(n,'big')
def _hmac(key,*parts): return hmac.new(key,b''.join(parts),hashlib.sha256).digest()
def _lp(b): return len(b).to_bytes(4,'big')+b
def _pw_bytes(pw):
    """Passphrase str (surrogateescape) ou bytes -> bytes ; ValueError sinon."""
    if isinstance(pw,str): return pw.encode('utf-8','surrogateescape')
    if isinstance(pw,(bytes,bytearray)): return bytes(pw)
    raise ValueError("passphrase : str ou bytes attendu")

def _subkeys(dek):
    """Sous-clés à étiquettes distinctes dérivées de la DEK."""
    return {n:_hmac(dek,b'borghelper/db/'+n.encode()) for n in ('k_path','k_enc','k_blob','k_hdr')}

class PathCodec:
    """Chemin logique <-> chemin stocké (SIV déterministe chaîné, AD-3). Sans état, thread-safe."""
    def __init__(self,k_path,k_enc):
        self._kp=bytes(k_path); self._ke=bytes(k_enc)

    @staticmethod
    def _segments(path):
        if isinstance(path,str): path=path.encode('utf-8','surrogateescape')
        return [s for s in path.split(b'/') if s]

    def _ks(self,tag,n): return hashlib.shake_256(self._ke+tag).digest(n)

    def encode(self,path):
        prev=b'\0'*_PATH_TAG_LEN; out=[]
        for seg in self._segments(path):
            tag=_hmac(self._kp,prev,seg)[:_PATH_TAG_LEN]
            out.append(_b64e(tag+_xor(seg,self._ks(tag,len(seg)))))
            prev=tag
        return '/'.join(out)

    def decode(self,stored):
        if stored=='': return ''
        prev=b'\0'*_PATH_TAG_LEN; segs=[]
        for part in stored.split('/'):
            raw=_b64d(part)
            if len(raw)<=_PATH_TAG_LEN: raise DbCodecError("segment trop court")
            tag,ct=raw[:_PATH_TAG_LEN],raw[_PATH_TAG_LEN:]
            seg=_xor(ct,self._ks(tag,len(ct)))
            if not hmac.compare_digest(_hmac(self._kp,prev,seg)[:_PATH_TAG_LEN],tag):
                raise DbCodecError("tag de segment invalide")
            segs.append(seg); prev=tag
        return b'/'.join(segs).decode('utf-8','surrogateescape')

    def prefix_bounds(self,prefix):
        """(bas, haut) tels que enc(x) est sous prefix ssi bas <= enc(x) < haut ('/'+1 = '0')."""
        e=self.encode(prefix)
        return (e+'/',e+'0')

class BlobCodec:
    """Payloads de cache : nonce 16 o aléatoire, keystream SHAKE-256, chiffrer puis HMAC (AD-9)."""
    def __init__(self,k_blob):
        self._ke=_hmac(k_blob,b'blob-enc'); self._km=_hmac(k_blob,b'blob-mac')

    def encrypt(self,data):
        if isinstance(data,str): data=data.encode('utf-8','surrogateescape')
        nonce=secrets.token_bytes(16)
        ct=_xor(data,hashlib.shake_256(self._ke+nonce).digest(len(data)))
        return _b64e(nonce+ct+_hmac(self._km,nonce,ct))

    def decrypt(self,token):
        raw=_b64d(token)
        if len(raw)<16+32: raise DbCodecError("blob trop court")
        nonce,ct,mac=raw[:16],raw[16:-32],raw[-32:]
        if not hmac.compare_digest(_hmac(self._km,nonce,ct),mac): raise DbCodecError("MAC de blob invalide")
        return _xor(ct,hashlib.shake_256(self._ke+nonce).digest(len(ct)))

class DbCodec:
    """Ensemble de codecs d'une base chiffrée (porté par BhConnection.codec ; None si plain)."""
    def __init__(self,dek):
        k=_subkeys(dek)
        self.path=PathCodec(k['k_path'],k['k_enc']); self.blob=BlobCodec(k['k_blob']); self.k_hdr=k['k_hdr']
        self._memo={}
        self._seg_memo={}  # (prev_tag,segment_chiffré) -> (segment_clair,tag) -- voir decode_path_verified

    def decode_path(self,stored):
        """PathCodec.decode avec mémo borné (vidé quand plein) : les mêmes chemins reviennent d'une requête à l'autre.
        Sur un défaut du mémo : decode_path_verified (1.0.120, était PathCodec.decode) — même vérification
        de chaque segment, mais le travail des répertoires communs est mémorisé par segment : lister un
        sous-répertoire ne redécode plus son préfixe pour chacun des milliers de chemins du sous-arbre."""
        v=self._memo.get(stored)
        if v is None:
            v=self.decode_path_verified(stored)
            if len(self._memo)>=_DEC_MEMO_MAX: _memo_evict(self._memo)
            self._memo[stored]=v
        return v

    def decode_path_verified(self,stored):
        """Comme `PathCodec.decode` (valide le tag de CHAQUE segment, toute la profondeur -- même garantie
        que `decode`/`decode_path`, jamais limité au premier niveau) mais mémoïse par SEGMENT
        (`(prev_tag, segment_chiffré) -> (segment_clair, tag)`, borné/vidé comme `_memo`) : des chemins qui
        partagent un même préfixe de répertoires (cas courant dans une arborescence réelle) ne refont pas
        le travail crypto déjà fait pour ce préfixe -- accélère un balayage de beaucoup de chemins voisins
        SANS relâcher la détection d'altération sur AUCUN segment, à AUCUNE profondeur (contrairement à un
        décodage volontairement limité au premier niveau, qui laisserait une altération plus profonde
        passer inaperçue — voir Story 6/CHANGELOG pour l'historique de ce choix). NB : depuis 1.0.121
        (piste 2), TreeHist sur base chiffrée ne l'appelle plus que pour le répertoire listé et ses enfants
        directs (via decode_path) — c'est TreeHist qui limite la profondeur vérifiée, pas cette méthode."""
        if stored=='': return ''
        p=self.path
        prev=b'\0'*_PATH_TAG_LEN; segs=[]
        for part in stored.split('/'):
            key=(prev,part)
            hit=self._seg_memo.get(key)
            if hit is None:
                raw=_b64d(part)
                if len(raw)<=_PATH_TAG_LEN: raise DbCodecError("segment trop court")
                tag,ct=raw[:_PATH_TAG_LEN],raw[_PATH_TAG_LEN:]
                seg=_xor(ct,p._ks(tag,len(ct)))
                if not hmac.compare_digest(_hmac(p._kp,prev,seg)[:_PATH_TAG_LEN],tag):
                    raise DbCodecError("tag de segment invalide")
                if len(self._seg_memo)>=_DEC_MEMO_MAX: _memo_evict(self._seg_memo)
                hit=(seg,tag); self._seg_memo[key]=hit
            seg,tag=hit
            segs.append(seg); prev=tag
        return b'/'.join(segs).decode('utf-8','surrogateescape')

def _kdf_params(level='standard'):
    """Paramètres KDF réellement utilisés pour un niveau (repli PBKDF2 sans hashlib.scrypt)."""
    if level not in _KDF_LEVELS: raise ValueError(f"DB_KDF inconnu : {level!r}")
    if level=='light': return {'id':'pbkdf2','iter':100000}
    if hasattr(hashlib,'scrypt'):
        return {'id':'scrypt','n':2**14 if level=='standard' else 2**15,'r':8,'p':1}
    return {'id':'pbkdf2','iter':300000 if level=='standard' else 600000}

def _kdf_derive(passphrase,salt,params):
    pw=_pw_bytes(passphrase)
    if params.get('id')=='pbkdf2':
        return hashlib.pbkdf2_hmac('sha256',pw,salt,int(params['iter']),32)
    if params.get('id')=='scrypt':
        if not hasattr(hashlib,'scrypt'):
            raise DbKeyError("KDF scrypt requis par cette base mais indisponible (OpenSSL/hashlib sans scrypt)")
        n,r,p=int(params['n']),int(params['r']),int(params['p'])
        return hashlib.scrypt(pw,salt=salt,n=n,r=r,p=p,maxmem=128*n*r*p*2+(1<<20),dklen=32)
    raise DbTamperError("identifiant KDF inconnu dans l'en-tête")

def _wrap_mac(kek,path_enc,kdf_json,salt,nonce,ct):
    return _hmac(_hmac(kek,b'wrap-mac'),_lp(path_enc.encode()),_lp(kdf_json.encode()),_lp(salt),_lp(nonce),_lp(ct))

def _kdf_json(params): return json.dumps(params,sort_keys=True,separators=(',',':'))

def _enc_header_build(passphrase,path_enc='siv1',kdf_level='standard',dek=None):
    """Nouvel en-tête (dict JSON-sérialisable) enveloppant une DEK fraîche (ou fournie). -> (header,dek)."""
    if path_enc not in _PATH_ENC_MODES: raise ValueError(f"path_enc invalide : {path_enc!r}")
    if dek is None: dek=secrets.token_bytes(32)
    elif len(dek)!=32: raise ValueError("DEK : 32 octets attendus")
    params=_kdf_params(kdf_level); kj=_kdf_json(params)
    salt=secrets.token_bytes(16); nonce=secrets.token_bytes(16)
    kek=_kdf_derive(passphrase,salt,params)
    ct=_xor(dek,hashlib.shake_256(_hmac(kek,b'wrap-enc')+nonce).digest(32))
    mac=_wrap_mac(kek,path_enc,kj,salt,nonce,ct)
    return ({'v':1,'path_enc':path_enc,'kdf':params,'salt':_b64e(salt),'nonce':_b64e(nonce),
             'wrapped_dek':_b64e(ct),'mac':_b64e(mac),'migration_cursor':None},dek)

def _int_in(v,lo,hi):
    if type(v) is not int or not lo<=v<=hi: raise ValueError("paramètre KDF hors bornes")
    return v

def _enc_header_parse(value):
    """Valide la forme d'un en-tête lu en base ; DbTamperError sur toute anomalie (dont plain,
    version inconnue, paramètres KDF absents/mal typés/hors bornes — évite un déni de service par en-tête forgé)."""
    try:
        h=json.loads(value)
        if not isinstance(h,dict) or type(h.get('v')) is not int or h['v']!=1: raise ValueError
        for k in ('path_enc','kdf','salt','nonce','wrapped_dek','mac'):
            if k not in h: raise ValueError
        kdf=h['kdf']
        if not isinstance(kdf,dict): raise ValueError
        if kdf['id']=='pbkdf2':
            _int_in(kdf['iter'],1,10_000_000)
        elif kdf['id']=='scrypt':
            n=_int_in(kdf['n'],2**10,2**20)
            if n&(n-1): raise ValueError
            _int_in(kdf['r'],1,32); _int_in(kdf['p'],1,16)
        else: raise ValueError
    except (KeyError,ValueError,TypeError):
        raise DbTamperError("en-tête de chiffrement illisible ou invalide")
    if h['path_enc'] not in _PATH_ENC_MODES:
        raise DbTamperError(f"en-tête de chiffrement présent avec path_enc={h['path_enc']!r} (rétrogradation ?)")
    return h

def _enc_header_unlock(header,passphrase):
    """DEK déchiffrée, ou DbKeyError (mauvaise passphrase / enveloppe altérée)."""
    if not passphrase: raise DbKeyError("passphrase absente")
    try:
        salt,nonce,ct,mac=(_b64d(header[k]) for k in ('salt','nonce','wrapped_dek','mac'))
    except DbCodecError as e:
        raise DbTamperError(f"en-tête de chiffrement corrompu ({e})")
    kek=_kdf_derive(passphrase,salt,header['kdf'])
    exp=_wrap_mac(kek,header['path_enc'],_kdf_json(header['kdf']),salt,nonce,ct)
    if not hmac.compare_digest(exp,mac):
        raise DbKeyError("passphrase incorrecte ou en-tête altéré")
    return _xor(ct,hashlib.shake_256(_hmac(kek,b'wrap-enc')+nonce).digest(len(ct)))

def _enc_header_read(conn):
    """Valeur brute de db_meta.enc_header, ou None (pas de table / pas de ligne / fichier illisible)."""
    try:
        row=conn.execute("SELECT value FROM db_meta WHERE key='enc_header'").fetchone()
    except sqlite3.OperationalError as e:
        if 'no such table' in str(e): return None
        raise
    except sqlite3.DatabaseError as e:
        # Fichier illisible (corrompu, pas une base SQLite) : AVANT 1.0.124, traité comme « pas d'en-tête »
        # -> une base chiffrée dont la page d'en-tête est abîmée s'ouvrait en 'plain' (un écrivain non
        # chiffré aurait pu y mêler des chemins en clair). Refus net : on ne sait pas vérifier le mode.
        raise DbTamperError(f"base illisible, mode de chiffrement invérifiable ({e})") from None
    return row[0] if row else None

def _enc_header_write(conn,header):
    """Écrit l'en-tête s'il n'existe pas (BEGIN IMMEDIATE + ON CONFLICT DO NOTHING). True si écrit.
    Jamais INSERT OR REPLACE : deux créateurs concurrents ne doivent pas écraser la DEK."""
    conn.commit()
    conn.execute("BEGIN IMMEDIATE")
    try:
        cur=conn.execute("INSERT INTO db_meta(key,value) VALUES('enc_header',?) ON CONFLICT(key) DO NOTHING",
                         (json.dumps(header,sort_keys=True),))
        done=cur.rowcount==1
        conn.commit()
    except BaseException:
        conn.rollback(); raise
    return done

def _enc_header_cas(conn,old_raw,new_header):
    """Mise à jour d'un en-tête déjà existant (distincte de _enc_header_write, réservée à la toute
    première écriture) : compare-and-swap sur la valeur brute (BEGIN IMMEDIATE, UPDATE ... WHERE
    value=old_raw). old_raw doit avoir été lu dans la même transaction (_enc_header_read juste avant).
    Utilisée par DbEncrypt/DbDecrypt pour toute transition sur un en-tête déjà présent (siv1->migrating,
    avancement du curseur, migrating->siv1, ré-enveloppe DbRekey). Retourne True si mis à jour.
    sqlite3.OperationalError (ex. "database is locked" sous contention de BEGIN IMMEDIATE) est converti
    en DbModeError : les appelants de cette story n'ont qu'un seul contrat d'échec à gérer (True/False/
    DbModeError), jamais une sqlite3.Error brute à traiter en plus."""
    conn.commit()
    try:
        conn.execute("BEGIN IMMEDIATE")
        cur=conn.execute("UPDATE db_meta SET value=? WHERE key='enc_header' AND value=?",
                          (json.dumps(new_header,sort_keys=True),old_raw))
        done=cur.rowcount==1
        conn.commit()
    except sqlite3.OperationalError as e:
        conn.rollback(); raise DbModeError(f"en-tête verrouillé ({e}) — relancer")
    except BaseException:
        conn.rollback(); raise
    return done

def _enc_header_cas_delete(conn,old_raw):
    """Suppression compare-and-swap de l'en-tête (dernier commit de DbDecrypt : retour à une base
    VRAIMENT plain, sans ligne enc_header — AD-2 interdit path_enc='plain' en base). Retourne True
    si supprimé. sqlite3.OperationalError (contention BEGIN IMMEDIATE) -> DbModeError, même contrat que
    _enc_header_cas."""
    conn.commit()
    try:
        conn.execute("BEGIN IMMEDIATE")
        cur=conn.execute("DELETE FROM db_meta WHERE key='enc_header' AND value=?",(old_raw,))
        done=cur.rowcount==1
        conn.commit()
    except sqlite3.OperationalError as e:
        conn.rollback(); raise DbModeError(f"en-tête verrouillé ({e}) — relancer")
    except BaseException:
        conn.rollback(); raise
    return done

def _check_disk_space(db_path,margin=_DB_SPACE_MARGIN):
    """Espace libre suffisant avant DbEncrypt/DbDecrypt (AD-7) : True si le volume qui porte db_path a
    au moins `margin` fois la taille actuelle du fichier (0 si absent) de libre. Migration en place
    (jamais de copie complète), mais WAL/pages libres temporaires pendant les lots justifient une marge
    (20% par défaut, voir _DB_SPACE_MARGIN). Ne bloque jamais si l'espace ne peut pas être mesuré."""
    try:
        size=os.path.getsize(db_path) if os.path.exists(db_path) else 0
        free=shutil.disk_usage(os.path.dirname(os.path.abspath(db_path)) or '.').free
        return free>=size*margin
    except OSError:
        return True

_DEK_CACHE={}  # dérivation une seule fois par processus et par base : (chemin, mac, condensé passphrase) -> DEK
_CODEC_CACHE={}  # même clé -> DbCodec (partage le mémo de décodage entre connexions du processus)
_DB_CFG_READERS={}  # realpath(cache_dir) -> callable(nick)->section de config ; enregistré par BorgHelperDB

def _find_cfg_reader(db_path=None):
    """Lecteur de config du répertoire de cache de db_path ; sans db_path, le seul lecteur enregistré s'il est unique."""
    if db_path is not None:
        try: return _DB_CFG_READERS.get(os.path.realpath(os.path.dirname(os.path.abspath(db_path))))
        except (OSError,ValueError,TypeError): return None
    return next(iter(_DB_CFG_READERS.values())) if len(_DB_CFG_READERS)==1 else None

def _resolve_passphrase(nick,db_path=None):
    rd=_find_cfg_reader(db_path)
    if rd is None or nick is None: return None
    try: cfg=rd(nick)
    except (Exception,SystemExit): return None
    return cfg.get('BORG_PASSPHRASE') if cfg is not None else None

class BhConnection(sqlite3.Connection):
    """sqlite3.Connection portant .codec (None si plain), .mode, .role et .nick."""
    codec=None; mode='plain'; role='read'; nick=None

_DB_ROLES=('read','write','admin')

def _db_open_fail(db_path,e):
    """Diagnostic + sys.exit(1) sur échec d'ouverture ; à appeler par les créateurs de base."""
    parent=os.path.dirname(os.path.abspath(db_path))
    if not os.path.exists(parent):
        printer(f"[ERREUR] DB : répertoire introuvable : {parent}")
    elif not os.access(parent,os.W_OK):
        printer(f"[ERREUR] DB : permission refusée sur le répertoire : {parent}")
    elif os.path.exists(db_path) and not os.access(db_path,os.R_OK|os.W_OK):
        printer(f"[ERREUR] DB : fichier inaccessible : {db_path}")
    else:
        printer(f"[ERREUR] DB : impossible d'ouvrir {db_path}")
        printer(f"  -> {e}")
    sys.exit(1)

def _db_busy(e):
    """Vrai si l'erreur SQLite est un verrou tenu par un autre processus (locked/busy), pas une corruption."""
    return isinstance(e,sqlite3.OperationalError) and any(w in str(e).lower() for w in ('locked','busy'))

def _db_schema_fail(db_path,e,what,regenerable=True):
    """Diagnostic + sys.exit(1) des ensure_*_db. Un verrou n'est JAMAIS présenté comme une corruption :
    conseiller de supprimer diff.db sur un simple « database is locked » ferait perdre l'historique."""
    if _db_busy(e):
        printer(f"[ERREUR] DB occupée : {db_path}")
        printer(f"  -> {e}")
        printer("  Un autre processus tient un verrou sur la base : réessayer plus tard (ne PAS supprimer le fichier).")
    elif not regenerable:
        printer(f"[ERREUR] DB corrompue : {db_path}")
        printer(f"  -> {e}")
        printer(f"  {what} : données NON régénérables — restaurer le fichier depuis une sauvegarde plutôt que le supprimer.")
    else:
        printer(f"[ERREUR] DB corrompue : {db_path}")
        printer(f"  -> {e}")
        printer(f"  Supprimez le fichier et relancez pour reconstruire {what}.")
    sys.exit(1)

def _ensure_wal(conn):
    """Passe la base en WAL si elle n'y est pas déjà (1.0.137). Changer de mode exige un accès exclusif :
    base ouverte par un autre processus -> SQLITE_BUSY immédiat (le délai d'attente ne s'applique pas à ce
    PRAGMA). On laisse alors la base dans son mode courant, qui reste utilisable ; le prochain ouvreur sans
    concurrent la repassera en WAL. Avant 1.0.137 : PRAGMA inconditionnel -> « database is locked » sur
    une base sortie de _vacuum_db (mode delete) dès qu'un Index/Bkp y écrivait, pris pour une corruption."""
    try:
        if str(conn.execute("PRAGMA journal_mode").fetchone()[0]).lower()=='wal': return True
        return str(conn.execute("PRAGMA journal_mode=WAL").fetchone()[0]).lower()=='wal'
    except sqlite3.OperationalError as e:
        if _db_busy(e): return False
        raise

class _SwapAbort(Exception):
    """Levée par le rappel de progression de _swap_db pour annuler la copie (base servie inchangée)."""

def _unlink_db(path):
    """Retire une base SQLite et ses -wal/-shm (1.0.149, story 12 A6 : seul helper) ; absents ignorés."""
    for f in (path,path+'-wal',path+'-shm'):
        try: os.unlink(f)
        except OSError: pass

def _swap_db(live,new,nick=None,abort=None,changed=None,pages=4096,busy_limit=120,keep_new=False):
    """Remplace le contenu de la base servie `live` par celui de `new` (1.0.138, story 1 du chantier
    reconstruction, AD-6 amendé), puis supprime `new`. Retourne 'ok', 'abort' (abort() vrai : opération
    prioritaire), 'changed' (changed() vrai : `live` modifiée depuis la préparation de `new`), 'busy' (`live`
    verrouillée en écriture par un autre processus plus de `busy_limit` s) ou 'invalid' (`new` absente, vide ou
    d'une seule page : jamais copiée, elle viderait la base servie).

    Mécanisme : API backup de SQLite, par tranches de `pages` pages, puis wal_checkpoint(TRUNCATE). Les
    verrous de SQLite garantissent qu'un lecteur voit l'ancienne base ou la nouvelle, jamais un mélange, et
    que les connexions déjà ouvertes (persistantes comprises) voient la nouvelle à leur transaction suivante.
    Les écrivains attendent la fin de la copie. Jamais os.replace sur une base servie : mesuré, un -wal non
    vide est alors rejoué sur la nouvelle base (lecteurs « no such table », ancien contenu réapparu) ; et
    supprimer -wal/-shm laisse les connexions ouvertes écrire dans l'ancien fichier (écritures perdues).

    abort() est évalué après chaque tranche, y compris quand la tranche attend un verrou (SQLITE_BUSY) ;
    changed() après la première tranche réussie : le verrou d'écriture de `live` est alors tenu par la copie
    jusqu'à la fin, donc un changed() faux garantit qu'aucune écriture ne sera écrasée. Le rappel de CPython
    passe aussi après la dernière tranche (SQLITE_DONE, copie validée) : jamais d'annulation à ce moment, et au
    moins deux tranches pour que changed() précède toujours la validation. Annulation ou erreur : `live` reste
    l'ancienne base. Coût : `live` + WAL (taille de `new`) + `new` sur le disque pendant la copie.
    keep_new=True (fantôme, 1.0.143) : `new` n'est supprimée qu'après 'ok' ou 'invalid' ; annulation ou erreur la
    gardent pour une nouvelle tentative (sinon toute la reconstruction serait perdue)."""
    _DONE,_BUSY,_LOCKED=101,5,6
    res=None
    if not os.path.isfile(new) or os.path.getsize(new)==0:   # jamais _open_db (O_CREAT) sur un absent
        if keep_new: _unlink_db(new)
        return 'invalid'
    src=dst=None; state={'first':True}; t0=time.monotonic()
    def _prog(status,remaining,total):
        if status==_DONE: return
        if abort is not None and abort(): raise _SwapAbort('abort')
        if status in (_BUSY,_LOCKED):
            if time.monotonic()-t0>busy_limit: raise _SwapAbort('busy')
            return
        if state['first'] and changed is not None and changed(): raise _SwapAbort('changed')
        state['first']=False
    try:
        src=_open_db(new,nick=None,role='admin')
        n=src.execute("PRAGMA page_count").fetchone()[0]
        if n<2: res='invalid'; return res
        # timeout court : une tranche bloquée rend la main vite (SQLITE_BUSY), abort() et busy_limit sont sondés
        dst=_open_db(live,nick=None,role='admin',timeout=1)
        try:
            src.backup(dst,pages=max(1,min(pages,n//2)),progress=_prog)
            res='ok'; return res
        except _SwapAbort as e:
            res=str(e); return res
    finally:
        if dst is not None:
            # Récupère le WAL (copie validée, annulée ou en erreur) sans attendre : busy_timeout=0, sinon un lecteur
            # en cours ferait patienter TRUNCATE — qui bloque les nouveaux écrivains pendant l'attente — jusqu'à 60 s.
            try: dst.execute("PRAGMA busy_timeout=0"); dst.execute("PRAGMA wal_checkpoint(TRUNCATE)")
            except sqlite3.Error: pass
        for c in (src,dst):
            if c is not None:
                try: c.close()
                except sqlite3.Error: pass
        if not keep_new or res in ('ok','invalid'): _unlink_db(new)

def _open_db(db_path,nick=None,role='read',passphrase=None,**kw):
    """Point d'ouverture UNIQUE des bases SQLite (AD-1). kw -> sqlite3 (timeout=60, ...).
    role : read|write|admin (validé et mémorisé, sans effet fonctionnel pour l'instant).
    nick=None : pas de codec au niveau base (_vacuum_db sans nick, scopecache.db).
    passphrase : résolue paresseusement (config du nick) et seulement si un enc_header l'exige."""
    if role not in _DB_ROLES: raise ValueError(f"role invalide : {role!r} (attendu {'|'.join(_DB_ROLES)})")
    if isinstance(db_path,(str,bytes,os.PathLike)) and str(db_path)!=':memory:':
        try:
            fd=os.open(db_path,os.O_RDWR|os.O_CREAT,0o600)  # 0600 à la création, fichier existant intact
            os.close(fd)
        except OSError:
            pass  # sqlite3 rejouera l'erreur avec son propre message (OperationalError)
    conn=sqlite3.connect(db_path,factory=BhConnection,**kw)
    conn.role=role; conn.nick=nick
    try:
        if nick is not None:
            try: raw=_enc_header_read(conn)
            except DbTamperError as e: raise DbTamperError(f"{nick}: {e}") from None
            if raw is not None:
                header=_enc_header_parse(raw)
                if header['path_enc']=='migrating' and role!='admin':
                    # AD-11 : barrière de migration — seule la connexion admin de DbEncrypt/DbDecrypt
                    # peut ouvrir une base 'migrating' ; tout autre lecteur/écrivain est refusé net
                    # (pas de mode mixte, pas de résultat partiel silencieux).
                    raise DbModeError(f"{nick}: base en cours de migration (DbEncrypt/DbDecrypt) — réessayer une fois l'opération terminée")
                pw=passphrase if passphrase is not None else _resolve_passphrase(nick,db_path)
                if not pw: raise DbKeyError(f"{nick}: base chiffrée, passphrase absente")
                ck=(os.path.realpath(db_path),header['mac'],hashlib.sha256(_pw_bytes(pw)).digest())
                dek=_DEK_CACHE.get(ck)
                if dek is None:
                    try: dek=_enc_header_unlock(header,pw)
                    except DbKeyError as e: raise DbKeyError(f"{nick}: {e}") from None  # nick dans le message
                    _DEK_CACHE[ck]=dek
                codec=_CODEC_CACHE.get(ck)
                if codec is None: codec=_CODEC_CACHE[ck]=DbCodec(dek)
                conn.codec=codec; conn.mode=header['path_enc']
                # défense en profondeur (AD-8) : jamais sur une connexion plain (changerait les LIKE de nom qui y restent)
                try: conn.execute("PRAGMA case_sensitive_like=ON")
                except sqlite3.Error: pass  # pragma déprécié : simple défense en profondeur, jamais bloquant
            else:
                # AD-6 : base restée 'plain' alors qu'elle pourrait être chiffrée (flag actif + passphrase
                # dispo) — avertissement, jamais bloquant (mode plain toujours valide, voir AD-2/AD-5).
                # db_encrypt_enabled peut lever SystemExit sur une config invalide : n'importe pas ici,
                # ce n'est qu'un avertissement — la commande réelle lèvera la même erreur à son tour.
                try:
                    if (not _is_shadow(db_path) and db_encrypt_enabled(nick)   # fantôme : même mode que sa base, déjà signalée
                            and (passphrase if passphrase is not None else _resolve_passphrase(nick,db_path))):
                        _warn_plain_db(nick,db_path)
                except SystemExit: pass
    except BaseException:
        conn.close(); raise
    return conn

def _cfg_bool(cfg,key,default):
    v=cfg.get(key) if cfg is not None else None
    if v is None: return default
    s=str(v).strip().lower()
    if s in ('true','yes','on','1'): return True
    if s in ('false','no','off','0'): return False
    printer(f"[ERREUR] {key}={v!r} invalide (attendu true/yes/on/1 ou false/no/off/0)"); sys.exit(2)

def _nick_cfg(nick,cfg):
    rd=_find_cfg_reader()
    if cfg is not None or rd is None or nick is None: return cfg
    try: return rd(nick)
    except (Exception,SystemExit): return None

def db_encrypt_enabled(nick,cfg=None):
    """DB_ENCRYPT effectif : valeur du nick, sinon [DEFAULT], sinon True. Sans effet runtime en story 1
    (consultée à la création de base et par DbEncrypt dans les stories suivantes)."""
    return _cfg_bool(_nick_cfg(nick,cfg),'DB_ENCRYPT',True)

def db_kdf_level(nick,cfg=None):
    """DB_KDF effectif (light|standard|strong), défaut standard ; valeur invalide -> arrêt avec message."""
    cfg=_nick_cfg(nick,cfg)
    v=cfg.get('DB_KDF') if cfg is not None else None
    if v is None: return 'standard'
    s=str(v).strip().lower()
    if s not in _KDF_LEVELS:
        printer(f"[ERREUR] DB_KDF={v!r} invalide (attendu {'|'.join(_KDF_LEVELS)})"); sys.exit(2)
    return s

_RC_PERM_WARNED=False
def _warn_rc_perms(path):
    """Avertit une fois (stderr) si le rc est accessible au groupe/autres ; ne change ni stdout ni le code de sortie."""
    global _RC_PERM_WARNED
    if _RC_PERM_WARNED: return
    try: mode=os.stat(path).st_mode
    except OSError: return
    if mode&(stat.S_IRWXG|stat.S_IRWXO):
        _RC_PERM_WARNED=True
        printer(f"[WARN] {path} est accessible au groupe/autres (mode {stat.S_IMODE(mode):04o}) — il contient des passphrases : chmod 600 conseillé")

_PLAIN_WARNED=set()
_PLAIN_WARNED_LOCK=threading.Lock()
def db_plain_anomalies(nick,db_paths,cfg):
    """Bases restées EN CLAIR alors qu'elles devraient être chiffrées (DB_ENCRYPT actif + passphrase disponible) —
    même condition que l'avertissement AD-6 (_warn_plain_db), sans rien écrire (1.0.134, badge de l'UI).
    db_paths : [(libellé, chemin)] ; -> libellés en anomalie. Base absente/vide : ignorée ; illisible : ignorée
    (ce n'est pas « en clair »). DB_ENCRYPT=false volontaire : jamais une anomalie."""
    try:
        if cfg is None or not db_encrypt_enabled(nick,cfg) or not cfg.get('BORG_PASSPHRASE'): return []
    except (Exception,SystemExit):
        return []
    out=[]
    for label,p in db_paths:
        if not _db_has_schema(p): continue
        try:
            import pathlib; c=sqlite3.connect(pathlib.Path(p).resolve().as_uri()+'?mode=ro',uri=True)
            try: raw=_enc_header_read(c)
            finally: c.close()
        except (sqlite3.Error,DbTamperError,OSError):
            continue
        if raw is None: out.append(label)
    return out

def _warn_plain_db(nick,db_path):
    """AD-6 : avertit une fois (stderr, par nick+base) qu'une base restée 'plain' pourrait être
    chiffrée. Précédent : _warn_rc_perms. Appelé seulement quand DB_ENCRYPT est actif pour ce nick et
    qu'une passphrase est disponible (sinon DbEncrypt échouerait de toute façon). Verrou : _open_db est
    appelée depuis des threads (ex. ThreadPoolExecutor des workers diff dans index()) — sans lui, un
    check-then-add non atomique sur ce set partagé pourrait avertir deux fois ou pas du tout."""
    try: key=(nick,os.path.realpath(db_path))
    except (OSError,ValueError,TypeError): key=(nick,db_path)
    with _PLAIN_WARNED_LOCK:
        if key in _PLAIN_WARNED: return
        _PLAIN_WARNED.add(key)
    printer(f"[WARN] {nick}: base non chiffrée ({db_path}) — lancer 'borgHelper -c DbEncrypt -n {nick} -y' pour la chiffrer")

# ── Accès aux chemins stockés (AD-8, AD-16) — frontière unique plain/chiffré ────
# Le code métier manipule des chemins LOGIQUES ; ces helpers sont les seuls à savoir si la connexion
# est chiffrée (conn.codec). Préfixe et égalité : bornes/valeur stockées fournies par le codec (jamais
# de LIKE sur un chemin). Prédicat sur le NOM (sous-chaîne LIKE, GLOB) : en SQL en plain, en Python
# sur chemins décodés en chiffré. Tri sur un chemin : toujours en Python (_path_sort_key).
# Chaque _psel_* retourne (condition SQL nue ou '', paramètres, filtre Python ou None) : quand le
# filtre Python n'est pas None, l'appelant décode chaque chemin lu et l'applique.

def _norm_lp(p):
    """Normalisation UNIQUE d'un chemin logique, dans les deux modes : segments non vides joints par '/'
    (sans '/' initial/final, '//' fusionnés) — la même que le codec."""
    return '/'.join(x for x in p.split('/') if x)

def _path_decode(conn,stored):
    """Chemin stocké -> chemin logique (no-op en plain ; DbCodecError si la valeur est altérée)."""
    c=conn.codec
    return stored if c is None or stored is None else c.decode_path(stored)

def _path_stored(conn,path):
    """Chemin logique -> valeur stockée pour une égalité (plain : tel quel ; chiffré : encodé, normalisé)."""
    path=_norm_lp(path); c=conn.codec
    return path if c is None else c.path.encode(path)

def _write_mode_check(conn):
    """Barrière de migration (AD-11) : relit enc_header.path_enc dans la transaction en cours et le
    compare au mode constaté à l'ouverture (conn.mode). Lève DbModeError si le mode a changé depuis
    l'ouverture (migration passée en 'migrating'/'siv1' entre-temps) — pas un verrou d'exclusion
    mutuelle, une garde de cohérence (voir Design Notes de la story). À appeler en tout premier, avant
    le premier INSERT/UPDATE/executemany d'un site qui écrit un chemin."""
    raw=_enc_header_read(conn)
    current='plain' if raw is None else _enc_header_parse(raw)['path_enc']
    if current!=conn.mode:
        raise DbModeError(f"mode de la base changé depuis l'ouverture ({conn.mode} -> {current})")

def _path_range(conn,prefix):
    """(bas, haut) des descendants STRICTS de prefix (path >= bas AND path < haut), ou None pour la
    racine (préfixe vide : pas de borne). Plain : 'p/' et 'p0' ('/'+1) ; chiffré : PathCodec.prefix_bounds."""
    c=conn.codec
    prefix=_norm_lp(prefix)
    if c is None: return (prefix+'/',prefix+'0') if prefix else None
    if not c.path.encode(prefix): return None
    return c.path.prefix_bounds(prefix)

def _psel_under(conn,prefix,self_too=False,col='path'):
    """Descendants de prefix (et prefix lui-même si self_too). Racine : aucune condition ('')."""
    b=_path_range(conn,prefix)
    if b is None: return '',[],None
    rng=f"({col}>=? AND {col}<?)"
    if self_too: return f"({col}=? OR {rng})",[_path_stored(conn,prefix),b[0],b[1]],None
    return rng,[b[0],b[1]],None

def _psel_eq(conn,path,col='path'):
    return f"{col}=?",[_path_stored(conn,path)],None

@functools.lru_cache(maxsize=256)
def _like_regex(pat):
    """Motif SQLite LIKE (sans ESCAPE) : % = suite quelconque, _ = un caractère ; insensible à la casse
    pour les lettres ASCII SEULEMENT (comme SQLite), les autres caractères exacts."""
    out=[]
    for ch in pat:
        if ch=='%': out.append('.*')
        elif ch=='_': out.append('.')
        elif ch.isascii() and ch.isalpha(): out.append('['+ch.lower()+ch.upper()+']')
        else: out.append(re.escape(ch))
    return re.compile(''.join(out),re.DOTALL)

@functools.lru_cache(maxsize=256)
def _glob_regex(pat):
    """Motif SQLite GLOB (sensible à la casse) : * ? [...] avec [^...] et intervalles ; '[' non fermé = jamais de correspondance."""
    out=[]; i=0; n=len(pat)
    while i<n:
        c=pat[i]; i+=1
        if c=='*': out.append('.*')
        elif c=='?': out.append('.')
        elif c=='[':
            j=i; neg=False
            if j<n and pat[j]=='^': neg=True; j+=1
            items=[]; first=True; closed=False
            while j<n:
                d=pat[j]
                if d==']' and not first: closed=True; break
                first=False
                if j+2<n and pat[j+1]=='-' and pat[j+2]!=']':
                    if d<=pat[j+2]: items.append(re.escape(d)+'-'+re.escape(pat[j+2]))
                    j+=3
                else: items.append(re.escape(d)); j+=1
            if not closed: return re.compile(r'(?!)')
            i=j+1
            if items: out.append('['+('^' if neg else '')+''.join(items)+']')
            else: out.append('.' if neg else '(?!)')
        else: out.append(re.escape(c))
    return re.compile(''.join(out),re.DOTALL)

def _psel_like(conn,pat,col='path'):
    """Prédicat de nom LIKE (plain : SQL ; chiffré : Python, même sémantique ASCII)."""
    if conn.codec is None: return f"{col} LIKE ?",[pat],None
    rx=_like_regex(pat); return '',[],(lambda p: rx.fullmatch(p) is not None)

def _psel_glob(conn,pat,col='path'):
    """Prédicat de nom GLOB (plain : SQL ; chiffré : Python)."""
    if conn.codec is None: return f"{col} GLOB ?",[pat],None
    rx=_glob_regex(pat); return '',[],(lambda p: rx.fullmatch(p) is not None)

def _psel_duidx(conn,sel):
    """sel : ('all',) | ('under',prefix) | ('like',motif_LIKE) — sélection de DuIdx."""
    if sel[0]=='under': return _psel_under(conn,sel[1])
    if sel[0]=='like': return _psel_like(conn,sel[1])
    return '',[],None

def _close_quiet(conn):
    """Ferme une connexion sur un chemin d'erreur (1.0.124) : sqlite3.Error au milieu d'une requête ne
    doit pas laisser la connexion ouverte. None (échec à l'ouverture) ou déjà fermée : sans effet."""
    if conn is None: return
    try: conn.close()
    except Exception: pass

def _codec_fail(label,e,conn=None):
    """Valeur de chemin stockée illisible (DbCodecError, pas une sqlite3.Error) : ferme la connexion, message par nick."""
    msg=f"{label}: chemin stocké illisible ({e}) — base altérée ou clé incorrecte"
    printer(f"[ERREUR] {msg}")
    try: conn.close()
    except Exception: pass
    return msg

def _wh(sql):
    """' AND <cond>' ou ''."""
    return f" AND {sql}" if sql else ''

def _path_sort_key(path):
    """Ordre octet UTF-8 (celui du tri BINARY de SQLite)."""
    return path.encode('utf-8','surrogateescape')

def _db_has_schema(db_path):
    """True si db_path contient au moins une table. _open_db(role='read') touche le fichier (0 octet)
    même pour une simple lecture (permissions 0600 à la création) ; un fichier existant mais vide n'est
    donc PAS une base créée — ensure_*_db(create=False) doit s'y fier plutôt qu'à os.path.exists (AD-12)."""
    if not os.path.exists(db_path): return False
    try:
        conn=sqlite3.connect(db_path,timeout=60)
        try: return conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchone() is not None
        finally: conn.close()
    except sqlite3.Error:
        return False

