def d2DateNSince(datepourrie):
    from datetime import datetime
    now=datetime.now()
    datelisible=datetime.strptime(datepourrie,"%Y-%m-%dT%H:%M:%S.%f")
    since=(now-datelisible).total_seconds()/60/60
    return {'since':since,'date':datelisible.strftime("%Y/%m/%d %H:%M:%S")}

def _age_readable(since_hours):
    """'il y a XhYY' depuis un nombre d'heures (float, voir d2DateNSince) — utilisé par Status pour
    l'âge du dernier backup connu."""
    total_min=int(round(since_hours*60))
    h,m=divmod(max(total_min,0),60)
    return f"il y a {h}h{m:02d}"

def _bkp_running_readable(started_at):
    """'HH:MM (XhYYmin)' depuis un started_at bkp_status (écrit via sqlite datetime('now'), donc UTC —
    voir borgHelperWWW _expires_matches pour le même constat). Conversion UTC->local par offset naïf
    (pas de zoneinfo dans ce projet), uniquement pour l'affichage de l'heure de début ; l'écoulé est
    calculé en UTC des deux côtés (pas d'offset possible dessus)."""
    from datetime import datetime
    started_utc=datetime.strptime(started_at,"%Y-%m-%d %H:%M:%S")
    now_utc=datetime.utcnow()
    started_local=started_utc+(datetime.now()-now_utc)
    total_min=int((now_utc-started_utc).total_seconds()//60)
    h,m=divmod(max(total_min,0),60)
    fmt='%Y-%m-%d %H:%M' if total_min>=24*60 else '%H:%M'   # 1.0.154 : date au-delà de 24 h (Bkp interrompu ancien)
    return f"{started_local.strftime(fmt)} ({h}h{m:02d}min)"

_BKP_STATUS_TIMEOUT_MAX=10*365*86400   # au-delà, datetime('now','-N seconds') rend NULL (ligne tenue pour interrompue)

# 1.0.155 (story 18) : ligne bkp_status « ouverte » du nick — sans fin, et aucun Bkp démarré après elle (ordre started_at
# puis rowid, celui de last_bkp_status) n'a fini en succès. Un Bkp tué suivi d'un Bkp réussi n'est plus « en cours » ; un
# Bkp vivant suivi d'un Bkp en échec (verrou du dépôt tenu par le premier) l'est toujours. Alias de table : b.
_BKP_OPEN_WHERE=("b.nick=? AND b.finished_at IS NULL AND NOT EXISTS (SELECT 1 FROM bkp_status s WHERE s.nick=b.nick "
                 "AND s.result='success' AND (s.started_at>b.started_at OR (s.started_at=b.started_at AND s.rowid>b.rowid)))")
_BKP_TIMEOUT_WARNED=set()

def _bkp_timeout_parse(v):
    """'90' / '90s' / '5m' / '12h' (ou un nombre) -> secondes, >= 1, plafonnées à 10 ans ; sinon None (1.0.155)."""
    if isinstance(v,bool): return None
    if isinstance(v,(int,float)):
        try: n=int(v)
        except (ValueError,OverflowError): return None   # nan, inf
    else:
        m=re.fullmatch(r'\s*(\d+)\s*([smhSMH]?)\s*',str(v))
        if not m: return None
        n=int(m.group(1))*{'':1,'s':1,'m':60,'h':3600}[m.group(2).lower()]
    return min(n,_BKP_STATUS_TIMEOUT_MAX) if n>=1 else None

def _bkp_status_timeout(value=None,cfg=None,nick=None):
    """Délai (s) au-delà duquel un Bkp sans fin est tenu pour interrompu (1.0.154, story 17), plafonné à 10 ans.
    1.0.155 (story 18) : cfg (section rc du nick) — clé BKP_STATUS_TIMEOUT (section ou [DEFAULT]) si présente et non
    vide, sinon la variable BORGHELPERWWW_BKP_STATUS_TIMEOUT (environnement de chaque processus), sinon 21600. Valeur :
    secondes, ou suffixe s/m/h ; invalide -> 21600. [WARN] une fois par nick et par valeur si elle est invalide ou sous
    300 s (un Bkp plus long serait notifié en échec). value : valeur à valider telle quelle (ni clé ni variable)."""
    if value is not None:
        t=_bkp_timeout_parse(value); return t if t is not None else 21600
    src=v=None
    if cfg is not None:
        try: v=cfg.get('BKP_STATUS_TIMEOUT',raw=True) if hasattr(cfg,'parser') else cfg.get('BKP_STATUS_TIMEOUT')
        except Exception: v='?'   # section illisible : clé invalide
        v=str(v or '').strip()
        if v: src='BKP_STATUS_TIMEOUT'
    if not src:
        v=(os.environ.get('BORGHELPERWWW_BKP_STATUS_TIMEOUT') or '').strip()
        if not v: return 21600
        src='BORGHELPERWWW_BKP_STATUS_TIMEOUT'
    t=_bkp_timeout_parse(v)
    if (t is None or t<300) and (nick,src,v) not in _BKP_TIMEOUT_WARNED:
        _BKP_TIMEOUT_WARNED.add((nick,src,v))
        who=f"{nick}: " if nick else ''
        printer(f"[WARN] {who}{src}={v!r} invalide — 6 h appliquées (secondes, ou suffixe s/m/h : 90s, 5m, 12h)" if t is None else
                f"[WARN] {who}{src}={v!r} : {t} s, très court — un Bkp plus long sera notifié en échec (suffixe h pour des heures)")
    return t if t is not None else 21600

