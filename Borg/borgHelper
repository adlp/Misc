def _pid_start_time(pid):
    """Heure de démarrage (epoch) d'un processus, d'après /proc (champ 22 de stat + btime) ; None si inconnue."""
    try:
        with open(f'/proc/{pid}/stat') as f: ticks=int(f.read().rsplit(')',1)[1].split()[19])
        with open('/proc/stat') as f: btime=next(int(l.split()[1]) for l in f if l.startswith('btime '))
        return btime+ticks/os.sysconf('SC_CLK_TCK')
    except (OSError,ValueError,IndexError,StopIteration): return None

def _mei_in_use(d):
    """Vrai si un processus lisible mappe un fichier de d, y a son répertoire courant ou un descripteur ouvert
    dedans. fuser ne suffit pas : un borg vivant ne fait que mapper ses bibliothèques (fuser rc=1). Le moindre doute
    (lecture de /proc impossible) compte comme « utilisé »."""
    pre=os.path.realpath(d)+'/'
    try: pids=[p for p in os.listdir('/proc') if p.isdigit()]
    except OSError: return True
    for pid in pids:
        try:
            with open(f'/proc/{pid}/maps') as f:
                if pre in f.read(): return True
            if (os.readlink(f'/proc/{pid}/cwd')+'/').startswith(pre): return True
            for fd in os.listdir(f'/proc/{pid}/fd'):
                try:
                    if os.readlink(f'/proc/{pid}/fd/{fd}').startswith(pre): return True
                except OSError: pass
        except (FileNotFoundError,ProcessLookupError): pass   # processus fini entre-temps
        except PermissionError: pass   # autre utilisateur : ne peut pas ouvrir nos répertoires 0700
        except OSError: return True
    return False

def _purge_mei_orphans(min_age=120):
    """Répertoires PyInstaller (<TMPDIR>/_MEI*, ~60 Mo chacun) laissés par un borg arrêté par SIGKILL, ou par SIGTERM
    pendant son démarrage : retirés s'ils sont à nous, plus modifiés depuis min_age s (jamais une extraction en cours)
    et utilisés par aucun processus (_mei_in_use). Appelé après tout arrêt de borg (1.0.145 : boex à l'échéance
    compris — un selftest en laissait 2 Go dans /tmp)."""
    import tempfile
    for d in glob.glob(os.path.join(tempfile.gettempdir(),'_MEI*')):
        try:
            st=os.lstat(d)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid!=os.getuid() or time.time()-st.st_mtime<min_age: continue
            if not _mei_in_use(d): shutil.rmtree(d,ignore_errors=True)
        except Exception: pass

def _mei_dirs():
    """_MEI* de tempfile.gettempdir() et de /tmp : boex reconstruit l'environnement de borg sans TMPDIR."""
    import tempfile
    return set().union(*(glob.glob(os.path.join(x,'_MEI*')) for x in {tempfile.gettempdir(),'/tmp'}))

def _mei_newest(d):
    """mtime le plus récent de d et de son arborescence (lstat) : une extraction écrit dans les sous-répertoires."""
    m=os.lstat(d).st_mtime
    for root,dirs,files in os.walk(d):
        for x in dirs+files:
            try: m=max(m,os.lstat(os.path.join(root,x)).st_mtime)
            except OSError: pass
    return m

def _purge_run_mei(before,min_age=10,wait=15):
    """Fin de CodecSelfTest (1.0.151, story 14 A15) : retire les _MEI* apparus pendant le run (absents de `before`), à
    nous, utilisés par aucun processus et dont rien (arborescence comprise) n'a changé depuis min_age s. Un candidat
    plus récent est attendu, `wait` s au plus pour tout le nettoyage, puis tout est revérifié : modifié pendant
    l'attente (extraction en cours) -> gardé. Rend le nombre retiré ; toute erreur est ignorée. _purge_mei_orphans
    (après un arrêt de borg, 2 min) laisse le dernier d'un run."""
    n=0; end=time.monotonic()+wait; uid=os.getuid()
    def mine(d):
        st=os.lstat(d); return stat.S_ISDIR(st.st_mode) and st.st_uid==uid
    for d in sorted(_mei_dirs()-set(before)):
        try:
            if not mine(d) or _mei_in_use(d): continue   # borg vivant : jamais d'attente pour lui
            m=_mei_newest(d); pause=min_age-(time.time()-m)
            if pause>0:
                if time.monotonic()+pause>end: continue
                time.sleep(pause)
                if not mine(d) or _mei_newest(d)!=m or _mei_in_use(d): continue
            shutil.rmtree(d,ignore_errors=True); n+=not os.path.exists(d)
        except Exception: pass
    return n

class BorgRunner:
    """Borg subprocess wrapper and borghelperrc configuration layer."""
    # Demande d'arrêt (1.0.141, moteur d'Index) : callable -> True quand le borg lancé par boex() doit être arrêté
    # (opération prioritaire, échéance de tranche). Sondé toutes les 0,5 s ; le résultat porte alors 'killed': True.
    # Propre à chaque thread (deux Index dans un même processus ne se volent pas leur condition) ; _kills compte les
    # borg arrêtés, pour que l'appelant sache qu'une unité a été jetée.
    _tls=threading.local()
    @property
    def _stop(self): return getattr(BorgRunner._tls,'stop',None)
    @_stop.setter
    def _stop(self,v): BorgRunner._tls.stop=v
    @property
    def _kills(self): return getattr(BorgRunner._tls,'kills',0)

    def __init__(self,cfgfile=None,passphrase=None):
        self.cfgfile=cfgfile or os.path.expanduser("~/.borghelperrc")
        self.passphrase=passphrase

    def cfgread(self,nick,debug=0):
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            _warn_rc_perms(self.cfgfile)
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            if nick not in config.keys(): return None
            cfg=config[nick]
            if self.passphrase is not None: cfg['BORG_PASSPHRASE']=self.passphrase
            return cfg
        return None

    def cfgreadnicks(self,debug=0):
        preret=[]
        if os.path.exists(self.cfgfile) and os.path.isfile(self.cfgfile):
            _warn_rc_perms(self.cfgfile)
            config=configparser.ConfigParser()
            config.optionxform=str
            config.read(self.cfgfile)
            for nick in config.keys():
                # Une section dont le nom commence par '_' est réservée à un autre composant (ex.
                # [_borgHelperWWW], spec-borghelperrc-www-section) — jamais un nick, ignorée en
                # silence ici. S'applique à toute section '_*' future sans code supplémentaire.
                if nick!="DEFAULT" and not nick.startswith('_') and 'ALL' not in config[nick].keys():
                    preret.append(nick)
            return ','.join(preret)
        return None

    def cfgreaded(self,nick,debug=0):
        cfg=self.cfgread(nick,debug=debug)
        if cfg is None:
            printer("Ce serveur est inconnu"); sys.exit(3)
        return cfg

    def cfgwrite(self,nick,serna,passphrase,repo,mountpoint,debug=0):
        config=configparser.ConfigParser()
        config.optionxform=str
        config.read(self.cfgfile)
        config[nick]={}
        config[nick]['BORG_REPO']=repo
        config[nick]['BORG_PASSPHRASE']=passphrase
        config[nick]['SER_NAME']=serna
        config[nick]['GLOB_ARCH']=serna+'-root-*'
        config[nick]['MOUNTPOINT']="/mnt/borg/"+nick if mountpoint is None else mountpoint
        _atomic_write_rc(self.cfgfile,config)

    def _boex_check_stdout(self,rb,nick,cmd='borg'):
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb.get('stderr',[]):
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform'):
                    msgs.append(i.strip()[:100])
            raise RuntimeError('; '.join(msgs[:2]) or f"{cmd} failed (code {rb['exitcode']})")

    def _boex_last_modified(self,nick,debug=0):
        rb=self.boex(nick,['info','--json'],debug=debug)
        if rb['exitcode']!=0 or not rb['stdout']:
            msgs=[]
            for i in rb['stderr']:
                if isinstance(i,dict) and i.get('levelname')=='ERROR':
                    msgs.append(i.get('message','').split('\n')[0])
                elif isinstance(i,str) and i.strip() and not i.startswith('Platform') and not i.startswith('Borg:'):
                    msgs.append(i.strip())
            raise RuntimeError('; '.join(msgs[:3]) or f"borg info failed (code {rb['exitcode']})")
        return rb['stdout'][0]['repository']['last_modified']

    def getlastbkp(self,nick,nbl=1,debug=0,strict=True):
        cfg=self.cfgreaded(nick,debug=debug)
        rb=self.boex(nick,['list','--json']+glob_args(cfg),debug=debug)
        self._boex_check_stdout(rb,nick,'borg list')
        lines=rb['stdout'][0]['archives']
        if len(lines)<nbl:
            if not strict: return []   # appelant qui tolère un dépôt encore vide (1er Bkp)
            printer(f"{nick}: {len(lines)} archive(s) dans le dépôt, {nbl} nécessaire(s)"); sys.exit(3)
        return [lines[i]['name'] for i in range(nbl*-1,0)]

    def dfRepo(self,nick,debug=0):
        cfg=self.cfgreaded(nick,debug=debug)
