def cmd_resto(nick,bid,ftor,where,flat=False,debug=0):
    cfg=cfgreaded(nick,debug=debug)
    stdout_mode=(where=='-')
    out=sys.stderr if stdout_mode else sys.stdout
    if bid is None:
        bid=_find_last_archive_with_file(nick,ftor,debug=debug)
        if bid:
            print(f"Archive sélectionnée depuis l'index : {bid}",file=out,flush=True)
        else:
            bid=getlastbkp(nick,debug=debug)[0]
            print(f"Archive sélectionnée (dernière) : {bid}",file=out,flush=True)
    if stdout_mode or _is_tar_dest(where):
        _restore_to_tar(nick,bid,ftor,where,flat=flat,debug=debug)
    elif flat:
        # Extraction plate vers répertoire : temp → copie sans sous-répertoires
        import tempfile,shutil
        with tempfile.TemporaryDirectory(prefix='borghelper_restore_') as tmpdir:
            rb=boex(nick,_borg_extract_args(bid,ftor),rep=tmpdir,debug=debug)
            _print_boex_stderr(rb)
            if rb['exitcode'] not in (0,1):
                sys.exit(rb['exitcode'])
            os.makedirs(where,exist_ok=True)
            try:
                for root,_,files in os.walk(tmpdir):
                    for f in files:
                        shutil.copy2(os.path.join(root,f),os.path.join(where,f))
            except OSError as e:
                import errno as _errno
                if e.errno==_errno.ENOSPC:
                    printer(f"[ERREUR] Espace disque insuffisant sur la cible : {e.filename or where}")
                else:
                    printer(f"[ERREUR] Copie impossible : {e}")
                sys.exit(3)
            print(f"Restauré (plat) dans {where}",flush=True)
        sys.exit(rb['exitcode'])
    else:
        rb=boex(nick,_borg_extract_args(bid,ftor),rep=where,debug=debug)
        _print_boex_stderr(rb)
        sys.exit(rb['exitcode'])

