        def _swap_reader(live,out,persistent,stop_file):
            """Processus lecteur : chaque lecture doit être une base complète, A (3000 lignes) ou B (9000)."""
            r={'A':0,'B':0,'bad':0,'err':[]}
            c=sqlite3.connect(live,timeout=20) if persistent else None
            while not os.path.exists(stop_file):
                try:
                    cc=c or sqlite3.connect(live,timeout=20); cc.execute("BEGIN")
                    n,dv,v=cc.execute("SELECT count(*),count(DISTINCT v),min(v) FROM t").fetchone(); g=cc.execute("SELECT gen FROM meta").fetchone()[0]
                    cc.execute("COMMIT")
                    if not persistent: cc.close()
                    good=dv==1 and v==g*40 and ((g=='A' and n==3000) or (g=='B' and n==9000))
                    r[g if good else 'bad']+=1
                except Exception as e: r['err'].append(str(e)[:60])
            with open(out,'w') as f: json.dump(r,f)
            os._exit(0)
        def _swap_writer(live,out,stop_file):
            """Processus écrivain persistant : compte ses commits réussis (aucun ne doit disparaître)."""
            c=sqlite3.connect(live,timeout=20); ok=0; err=[]; i=0
            while not os.path.exists(stop_file):
                try: c.execute("INSERT INTO w VALUES(?)",(i,)); c.commit(); ok+=1
                except Exception as e: err.append(str(e)[:60])
                # Un commit toutes les ~150 ms : des compactages réussissent pendant qu'il écrit. Face à un écrivain
                # continu (commit toutes les ~50 ms sous contention), le compactage est reporté à chaque essai, sans
                # perte (mesuré). Les vrais écrivains de diff.db hors verrou (bkp_status) sont bien plus rares.
                i+=1; time.sleep(0.15)
            with open(out,'w') as f: json.dump({'ok':ok,'err':err},f)
            os._exit(0)
