; borgHelper — fichier de conf DEMO, 100% local, aucun accès réseau/SSH.
; Sauvegarde le host local sur lui-même, dans deux dépôts distincts sous /tmp.
; Usage :
;   borgHelper -C demo.borghelperrc -c Init    -n demo-modules
;   borgHelper -C demo.borghelperrc -c Init    -n demo-usrlocal
;   borgHelper -C demo.borghelperrc -c Bkp     -n demo-modules
;   borgHelper -C demo.borghelperrc -c Bkp     -n demo-usrlocal
;   borgHelper -C demo.borghelperrc -c Stats
;   borgHelper -C demo.borghelperrc -c LstBkp  -n demo-modules
;   borgHelper -C demo.borghelperrc -c Report  -n ALL
;
; ⚠️ Démo uniquement : BORG_PASSPHRASE en clair, dépôts jetables sous /tmp
; (perdus au reboot). Ne pas copier tel quel en production.

[DEFAULT]
CACHE_DIR = /tmp/demo_borghelper/cache
; Chiffrement des bases SQLite (fondations : lu et validé, sans effet pour l'instant)
; DB_ENCRYPT = true       ; false/no/off/0 pour désactiver (global ici, ou par nick)
; DB_KDF     = standard   ; light | standard | strong

[demo-modules]
BORG_REPO       = /tmp/demo_borghelper/repo-modules
BORG_PASSPHRASE = demo-passphrase-modules
SER_NAME        = p-sxb-35
SER_LOGIN       = root
GLOB_ARCH       = p-sxb-35-modules-*
MOUNTPOINT      = /tmp/demo_borghelper/mnt-modules
BORG_ARCHNAME   = modules
BORG_ROOTBKP    = /lib/modules
EXCLUDE         = --exclude-caches --exclude-nodump --keep-exclude-tags
KEEP_DAILY      = 7
KEEP_WEEKLY     = 4
MAX_AGE_BKP     = 25
DISPLAY_BKP     = 5
; Exemple d'autorisation par groupes (n'a d'effet que si borgHelperWWW est lancé avec
; --groups-header/BORGHELPERWWW_GROUPS_HEADER — voir README.md du projet) :
;GROUPS_ADMIN   = ops-admins
;GROUPS_WRITE   = ops-admins,ops-writers
;GROUPS_READ    = ops-admins,ops-writers,ops-readers
; Exemple de périmètre de chemin par groupe (restreint ops-readers à un sous-répertoire de ce
; nick ; ops-admins/ops-writers, absents de GROUPS_PATHS, gardent un accès chemin illimité) :
;GROUPS_PATHS   = ops-readers:/lib/modules/6.8.0-generic

[demo-usrlocal]
BORG_REPO       = /tmp/demo_borghelper/repo-usrlocal
BORG_PASSPHRASE = demo-passphrase-usrlocal
SER_NAME        = p-sxb-35
SER_LOGIN       = root
GLOB_ARCH       = p-sxb-35-usrlocal-*
MOUNTPOINT      = /tmp/demo_borghelper/mnt-usrlocal
BORG_ARCHNAME   = usrlocal
BORG_ROOTBKP    = /usr/local
EXCLUDE         = --exclude-caches --exclude-nodump --keep-exclude-tags
KEEP_DAILY      = 7
KEEP_WEEKLY     = 4
MAX_AGE_BKP     = 25
DISPLAY_BKP     = 5
