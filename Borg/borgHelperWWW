# spec) — extrait en fonction pure (_clamp_push_default_expiry) plutôt qu'un try/except inline pour
# rester testable indépendamment par push_selftest() ci-dessous.
def _clamp_push_default_expiry(raw):
    """Repli sur 30 si `raw` n'est pas un entier, ou si l'entier est <1 (même patron de clamp que
    BKP_STATUS_TIMEOUT/_stats_retention_months) — jamais de crash serveur sur une valeur invalide."""
    try:
        v=int(raw)
    except (TypeError,ValueError):
        return 30
    return v if v>=1 else 30

