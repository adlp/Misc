    if not os.path.isfile(_conf_path):
        sys.exit(f"Fichier de conf borgHelperWWW introuvable : {_conf_path}")
    _cp=configparser.ConfigParser()
    _cp.read(_conf_path)
    _apply_conf_section(_cp['borgHelperWWW'] if _cp.has_section('borgHelperWWW') else _cp['DEFAULT'])

