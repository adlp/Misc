    def line(status,issue=''):
        print(f"[req] {ip} {user or '-'} \"{request.method} {_loggable_path(request.url.path,request.url.query)}\" "
              f"{status} {int((time.monotonic()-t0)*1000)}ms{issue}",file=sys.stderr,flush=True)
