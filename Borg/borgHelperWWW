class _ClosingStreamingResponse(StreamingResponse):
    """1.31.6 (story 60, mesuré) : réponse de téléchargement qui FERME son corps à la fin, même annulée. Sous le middleware
    (BaseHTTPMiddleware), un client qui part fait annuler la tâche interne pendant un envoi : le générateur body() de _borg_stream
    n'était jamais fermé, son finally (borg arrêté, verrou du dépôt rendu) n'arrivait qu'à sa finalisation par le ramasse-miettes
    — 28 s, 58 s ou jamais avant l'arrêt du serveur (mesuré, deux piles). aclose protégé de l'annulation (CancelScope shield),
    défensif : la fermeture actuelle (_Body.aclose, finally sans attente) ne suspend pas — une annulation en cours ne l'interrompt
    pas aujourd'hui (revue : mutant sans protection équivalent) ; une attente ajoutée plus tard le serait sans elle."""
    async def __call__(self,scope,receive,send):
        try: await super().__call__(scope,receive,send)
        finally:
            ac=getattr(self.body_iterator,'aclose',None)
            if ac is not None:
