        ex=lambda ns: sorted(mp.get(n,n) for n in ns) if isinstance(ns,list) else ns
        def tun(s_):   # revue 87a (row 22) : « tunnel non résolu (<nick nu>) » -> nom exposé (jamais deux rc réunis)
            m_=re.fullmatch(r'tunnel non résolu \((.*)\)',s_) if isinstance(s_,str) else None
            return f"tunnel non résolu ({mp[m_.group(1)]})" if m_ and m_.group(1) in mp else s_
        def rid(r_):
            p_=r_.split('|',2) if isinstance(r_,str) else []
            return '|'.join([p_[0],mp[p_[1]],*p_[2:]]) if len(p_)>=2 and p_[0]=='tunnel?' and p_[1] in mp else r_
        st=[dict(s,storage=tun(s.get('storage')),nicks=ex(s.get('nicks')),
                 repos=[dict(r,nicks=ex(r.get('nicks')),repo_id=rid(r.get('repo_id'))) if isinstance(r,dict) else r for r in (s.get('repos') or [])])
            if isinstance(s,dict) else s for s in (data.get('storages') or [])]
        er=data.get('errors')
        pfx=next((v.partition(':')[0] for v in mp.values() if ':' in v),None)
        if isinstance(er,dict) and pfx and '*' in er:   # row 54 : erreur du rc entier -> « <préfixe>:* » (jamais écrasée à la fusion)
            er={(f"{pfx}:*" if k=='*' else k):v for k,v in er.items()}
        def hint(k,v):   # revue 87a (row 50) : « borgHelper -c Status -n <nu> » -> -C du rc du nick, comme _rc_scrub
            if not (isinstance(v,str) and k in mp and ':' in mp[k]): return v
            return v.replace('borgHelper -c ',f"borgHelper -C <rc {mp[k].partition(':')[0]}> -c ")
        return dict(data,storages=st,errors={mp.get(k,k):hint(k,v) for k,v in er.items()} if isinstance(er,dict) else er)
    if isinstance(data,list):
        return [dict(x,nick=mp[x['nick']]) if isinstance(x,dict) and isinstance(x.get('nick'),str) and x['nick'] in mp else x
                for x in data]
    if not isinstance(data,dict): return data
    if cmd in _NICK_KEYED_CMDS: data={mp.get(k,k):v for k,v in data.items()}
    if isinstance(data.get('nick'),str) and data['nick'] in mp: data=dict(data,nick=mp[data['nick']])
    if cmd=='report':
        if isinstance(data.get('summary'),dict):
            data=dict(data,summary={mp.get(k,k):(_expose_row(r,k,mp) if k in mp else r) for k,r in data['summary'].items()})
        if isinstance(data.get('backups'),dict):
            def rows(k,arch):
                if k not in mp or not isinstance(arch,dict): return arch
                # revue 2 (row 35) : seul le champ nick d'une ligne (« {nick: <nom de l'archive>} » de report_offline : valeur = clé de
                # la ligne) est renommé — jamais une colonne qui porterait le même nom qu'un nick (borg, duration…)
                return {a:({(mp[k] if kk==k and vv==a else kk):vv for kk,vv in r.items()} if isinstance(r,dict) else r) for a,r in arch.items()}
            data=dict(data,backups={mp.get(k,k):rows(k,a) for k,a in data['backups'].items()})
    return data

def _expose_stdout(cmd,out,mp):
    """stdout d'UN rc : JSON aux nicks exposés (réécrit seulement s'il change), texte tel quel (nicks nus de borgHelper)."""
    if not mp or not (out or '').strip(): return out
    try: d=json.loads(out)
    except ValueError: return out
    x=_expose_json(cmd,d,mp)
    return out if x==d else json.dumps(x,ensure_ascii=False,indent=2)

def _readable_bytes(v):
    m=re.fullmatch(r'\s*([0-9]+(?:\.[0-9]+)?) ([A-Z]{1,2})\s*',str(v))
    return float(m.group(1))*1000**_SIZE_UNITS.index(m.group(2)) if m and m.group(2) in _SIZE_UNITS else None

def _report_totaux(rows):
    """Totaux de Report sur plusieurs rc : somme des Totaux de chaque rc — valeurs AFFICHÉES (2 décimales, base 1000) additionnées :
    écart au total exact au plus 0,005 unité affichée par rc (limite écrite dans README) ; durée « N min » additionnée ; valeur
    illisible : « — »."""
    out={}
    for k in rows[0]:
        vals=[r.get(k) for r in rows]
        if k=='nom': out[k]='Totaux'; continue
        mins=[re.fullmatch(r'\s*([0-9]+(?:\.[0-9]+)?) min\s*',str(v)) for v in vals]
        if all(mins): out[k]=f"{sum(float(m.group(1)) for m in mins):.2f} min"; continue
        b=[_readable_bytes(v) for v in vals]
        out[k]=convert_octets_readable(sum(b)) if None not in b else '—'
    return out

def _merge_json(cmd,parts):
    """Sorties JSON (objets, déjà exposées) de plusieurs rc -> une. parts : [(préfixe, objet)]. Clés réunies ; objets de même clé
    réunis (summary, backups) ; revue 1 (row 6) : jamais une valeur perdue en silence — même clé, valeur différente : gardée sous
    « préfixe:clé » pour les rc suivants ; Report : Totaux du résumé additionnés, en dernier."""
    out={}
    def put(o,k,v,pfx):
        if k not in o: o[k]=v
        elif o[k]==v: pass
        elif isinstance(o[k],dict) and isinstance(v,dict):
            o[k]=dict(o[k])
            for kk,vv in v.items():
                if cmd=='report' and k=='summary' and kk=='Totaux': continue   # recalculé plus bas
                put(o[k],kk,vv,pfx)
        else: o[f"{pfx}:{k}"]=v
    for pfx,d in parts:
        for k,v in d.items(): put(out,k,v,pfx)
    if cmd=='report' and isinstance(out.get('summary'),dict):
        tots=[d['summary']['Totaux'] for _p,d in parts if isinstance(d.get('summary'),dict) and isinstance(d['summary'].get('Totaux'),dict)]
        s={k:v for k,v in out['summary'].items() if k!='Totaux'}
        if tots: s['Totaux']=_report_totaux(tots) if len(tots)>1 else tots[0]
        out['summary']=s
    return out

def _merge_parts(cmd,parts,duidx=None,json_req=False):
    """parts : [(_RcEntry, {nu: exposé}, code, stdout, stderr)] (chemins de rc déjà retirés). Un rc : sa sortie, JSON exposé.
    Plusieurs : code = le plus grand ; stderr de chaque rc sous « ── préfixe ── » ; stdout : objets JSON fusionnés (_merge_json),
    sinon textes concaténés sous « ── préfixe ── » (nicks nus de borgHelper). Revue 1 (row 6) : réponse JSON demandée (-j, -R) :
    stdout reste du JSON — la sortie non JSON d'un rc passe dans stderr, sous son préfixe ; DuIdx -j : lignes brutes -R réunies
    puis _recompute_duidx, erreurs de chaque rc gardées (`error`, « préfixe : … »), aucune ligne : `{}` comme sur un rc."""
    if len(parts)==1:
        e,mp,code,out,err=parts[0]
        return CommandResult(exitcode=code,stdout=_expose_stdout(cmd,out,mp),stderr=err)
    hdr=lambda e,t: f"── {e.prefix} ──\n{t}"+('' if t.endswith('\n') else '\n')
    code=max(p[2] for p in parts)
    err=''.join(hdr(e,t) for e,_m,_c,_o,t in parts if t)
    objs=[]; other=[]
    for e,mp,_c,o,_t in parts:
        if not (o or '').strip(): continue
        try: d=json.loads(o)
        except ValueError: d=None
        if isinstance(d,dict): objs.append((e,_expose_json(cmd,d,mp)))
        else: other.append((e,o))
    if not json_req and other:
        return CommandResult(exitcode=code,stdout=''.join(hdr(e,o) for e,_m,_c,o,_t in parts if o),stderr=err)
    if other and _SCOPED_CALL.get():   # revue 2 (row 25) : appelant à périmètre — jamais une sortie non filtrée, même dans stderr
        err+=''.join(hdr(e,"[ERREUR] sortie non JSON de ce rc — non relayée (appelant à périmètre restreint)") for e,_o in other)
        code=max(code,1)
    elif other:   # JSON demandé : jamais un corps texte
        err+=''.join(hdr(e,f"[WARN] sortie non JSON de ce rc :\n{o}") for e,o in other)
    if not objs: out=''
    elif duidx is not None:
        wr=[d for _e,d in objs if isinstance(d.get('rows'),list)]
        errs='; '.join(f"{e.prefix} : {d['error']}" for e,d in objs if isinstance(d.get('error'),str))
        if wr:
            raw={'borghelper_version':wr[0].get('borghelper_version'),'pattern':duidx[0],'rows':[r for d in wr for r in d['rows']]}
            res=_recompute_duidx(raw,None,duidx[0],duidx[1])
            if errs: res['error']=errs
        else: res={'error':errs} if errs else {}
        out=json.dumps(res,ensure_ascii=False,indent=2) if res else '{}'
    else: out=json.dumps(_merge_json(cmd,[(e.prefix,d) for e,d in objs]),ensure_ascii=False,indent=2)
    return CommandResult(exitcode=code,stdout=out,stderr=err)

def _opt_values(args,opts=('-f','-s','-b','-B','-N','-p')):
    """Valeurs des options à argument d'une liste d'arguments CLI -> ({option: valeur}, positions des drapeaux seuls)."""
    vals={}; flags=[]; i=0
    while i<len(args):
        if args[i] in opts and i+1<len(args): vals[args[i]]=args[i+1]; i+=2
        else: flags.append(i); i+=1
    return vals,flags

# Décision 11 (revue 1) : commandes sans fusion sensée sur plusieurs rc — 400 plutôt qu'une réponse fausse
_ONE_RC_CMDS=('repohistory','archivehistory','lstbkpfls','diffbkp')
_ONE_RC_MSG="un seul fichier de conf par requête pour cette commande"

def _exec_dir(cmd,nick,extra_args,passphrase=None):
    """Mode dossier : un borgHelper par rc des nicks de la requête (-C de CE rc, nicks nus), séquentiels (TIMEOUT par rc) ; sortie
    exposée et fusionnée (_merge_parts). DuIdx -j sur plusieurs rc : -R (lignes brutes) puis recalcul unique. Plusieurs rc pour
    Report -l, RepoHistory, ArchiveHistory, LstBkpFls, DiffBkp, IdxTop/DiffTop -j : 400 (décision 11). Délai dépassé sur le k-ième
    rc (k > 1) : sorties des rc faits gardées, marqueur [ERREUR] dans stderr, code 124 (row 14)."""
    args=list(extra_args); duidx=None; skipped=[]
    groups=_rc_groups(nick,cmd,args,skipped)
    vals,flags=_opt_values(args)
    fl={args[i] for i in flags}
    if len(groups)>1 and (cmd in _ONE_RC_CMDS or (cmd=='report' and '-l' in fl) or (cmd in ('idxtop','difftop') and '-j' in fl)):
        raise HTTPException(400,detail=_ONE_RC_MSG)
    if len(groups)>1 and passphrase:   # revue 2 (row 27) : jamais la passphrase d'un hôte transmise aux borgHelper des autres rc
        raise HTTPException(400,detail="X-Borg-Passphrase : un seul fichier de conf par requête (nicks de plusieurs rc)")
    if not groups: return CommandResult(exitcode=0,stdout='',stderr=''.join(f"{m}\n" for m in skipped))
    for e,_nv,_mp in groups: _rc_launch_check(e)   # revue 2 (row 24)
    if cmd=='duidx' and len(groups)>1:
        js=[i for i in flags if args[i]=='-j']
        if js:
            duidx=(vals.get('-f'),vals.get('-s','chemin'))
            args=['-R' if i in js else a for i,a in enumerate(args)]
    parts=[]
    for k,(e,nv,mp) in enumerate(groups):
        argv,env=_build_borghelper_argv_env(cmd,nv,args,passphrase,cfgfile=e.path)
        try: proc=_run_group(argv,TIMEOUT,env)
        except subprocess.TimeoutExpired:
            if not parts: raise HTTPException(504,detail=f"Commande {cmd} : timeout après {TIMEOUT}s")
            rest=', '.join(g[0].prefix for g in groups[k+1:]) or 'aucun'
            parts.append((e,mp,124,'',f"[ERREUR] Commande {cmd} : timeout après {TIMEOUT}s sur ce rc — arrêtée ; rc non lancés : {rest}\n"))
            break
        parts.append((e,mp,proc.returncode,_rc_scrub_out(proc.stdout or '',e),_rc_scrub(proc.stderr or '',e)))
    r=_merge_parts(cmd,parts,duidx,json_req=bool(fl&{'-j','-R'}))
    if skipped: r.stderr=''.join(f"{m}\n" for m in skipped)+(r.stderr or '')
    return r

def _argv_env_for(cmd,nick,extra_args,passphrase=None):
    """argv/env de borgHelper pour UN nick exposé -> (argv, env, nick nu). Mode -C : _build_borghelper_argv_env(cmd, nick, …) comme
    avant ; mode dossier : -C du rc du nick, nick nu ; non résolu : 404 « Nick inconnu »."""
    if not DIR_MODE:
        argv,env=_build_borghelper_argv_env(cmd,nick,extra_args,passphrase); return argv,env,nick
    e,b=_rc_entry_of(nick)
    if e is None: raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    _rc_launch_check(e)   # revue 2 (row 24)
    argv,env=_build_borghelper_argv_env(cmd,b,extra_args,passphrase,cfgfile=e.path)
    return argv,env,b

def _exec_borghelper(cmd: str, nick: Optional[str], extra_args, passphrase: Optional[str]=None) -> CommandResult:
    """Sous-processus borgHelper brut, sans cache ni encapsulation JSONResponse — factorisé hors de
    `run_borghelper()` pour être réutilisé tel quel par `_run_scoped()` (Story 1.3), qui a besoin du
    `stdout` brut avant de le filtrer et ne doit jamais passer par `_RESPONSE_CACHE` (Boundaries du
    spec 1.3 : le cache reste réservé au cas non restreint). 1.32.0 (story 86) : mode dossier -> _exec_dir."""
    if DIR_MODE: return _exec_dir(cmd,nick,extra_args,passphrase)
    argv,env=_build_borghelper_argv_env(cmd,nick,extra_args,passphrase)
    try:
        proc=_run_group(argv,TIMEOUT,env)   # 1.31.1 (A91) : au délai, borgHelper ET son borg arrêtés (groupe)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail=f"Commande {cmd} : timeout après {TIMEOUT}s")
    return CommandResult(exitcode=proc.returncode,stdout=proc.stdout,stderr=proc.stderr)

class _PartialLaunch(Exception):
    """Mode dossier (revue 1, row 9) : lancement détaché fait pour certains rc, refusé pour d'autres — `done` « préfixe pid, … »,
    `failed` « préfixe : erreur ; … »."""
    def __init__(self,done,failed): super().__init__(failed); self.done=done; self.failed=failed

def _partial_launch_response(what,nick,x):
    """Réponse d'un lancement partiel : 500, code 1, ce qui est lancé dans stdout (jamais perdu : ne pas relancer ces rc), les
    refus dans stderr."""
    return JSONResponse(status_code=500,content={'exitcode':1,'stdout':f"{what} lancé pour {nick} sur une partie des rc : {x.done}",
                                                 'stderr':f"[ERREUR] lancement refusé : {x.failed}"})

def _launch_bkp_detached(nick: str, extra_args, passphrase: Optional[str]=None, cmd: str='bkp') -> int:
    """Lance `borgHelper -c Bkp` (ou `cmd`, 'index' pour POST /index depuis 1.28.0 : aucun suivi de résultat, seul
    l'avancement se lit dans /access) en sous-processus détaché (AD-2) : jamais attendu par la requête
    HTTP — le résultat réel est capté par `bkp_status` (borgHelper) et réclamé par le watcher, pas
    par le stdout/stderr/exitcode de ce sous-processus (jamais lus ici, `DEVNULL`).
    `start_new_session=True` : le sous-processus survit à un redémarrage de borgHelperWWW pendant la
    sauvegarde (AD-2) — sans ça, un redémarrage pendant un Bkp le tuerait avec le worker parent."""
    if DIR_MODE:   # 1.32.0 (story 86) : un détaché par rc (-C de ce rc, nicks nus) ; pids joints
        done=[]; failed=[]; groups=_rc_groups(nick,cmd,extra_args)
        if len(groups)>1 and passphrase:   # revue 2 (row 27)
            raise HTTPException(400,detail="X-Borg-Passphrase : un seul fichier de conf par requête (nicks de plusieurs rc)")
        if not groups: return 'aucun nick'
        for e,_nv,_mp in groups: _rc_launch_check(e)   # revue 2 (row 24)
        for e,nv,_mp in groups:
            argv,env=_build_borghelper_argv_env(cmd,nv,extra_args,passphrase,cfgfile=e.path)
            if cmd=='index': env['BORGHELPER_VIA']='http'
            try: done.append((e.prefix,subprocess.Popen(argv,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,stdin=subprocess.DEVNULL,
                                                        env=env,start_new_session=True).pid))
            except OSError as x: failed.append(f"{e.prefix} : {x}")   # revue 1 (row 9) : les rc suivants lancés quand même
        if failed and not done: raise OSError('; '.join(failed))
        if failed: raise _PartialLaunch(', '.join(f"{p} {pid}" for p,pid in done),'; '.join(failed))
        return done[0][1] if len(groups)==1 else ', '.join(f"{p} {pid}" for p,pid in done)
    argv,env=_build_borghelper_argv_env(cmd,nick,extra_args,passphrase)   # cmd='index' : POST /index (1.28.0)
    if cmd=='index': env['BORGHELPER_VIA']='http'   # 1.28.2 : résultat marqué « lancé par HTTP » (index_last)
    proc=subprocess.Popen(argv,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,stdin=subprocess.DEVNULL,
                           env=env,start_new_session=True)
    return proc.pid

def _http_status(exitcode) -> int:
    """Statut HTTP d'un résultat CLI : 0 -> 200, 4 (opération refusée sur un dépôt externe, 1.28.0) -> 403, sinon 400."""
    return 200 if exitcode==0 else 403 if exitcode==4 else 400

def run_borghelper(cmd: str, nick: Optional[str]=None, extra_args=(), passphrase: Optional[str]=None,
                    cacheable: bool=False) -> JSONResponse:
    pw_digest=_passphrase_digest(passphrase) if cacheable else None
    key=((cmd,nick,tuple(extra_args),pw_digest) if pw_digest is not None else (cmd,nick,tuple(extra_args))) \
        if cacheable else None
    fp=None
    if key is not None:
        fp=_response_fingerprint(cmd,nick)   # avant l'exécution : un changement pendant celle-ci -> pas de mise en cache
        cached=_RESPONSE_CACHE.get(key); ttl=_CACHE_TTL.get(cmd)
        if (cached is not None and cached[0]==fp
                and (ttl is None or time.monotonic()-cached[2]<ttl)):
            result_dict=cached[1]
            return JSONResponse(status_code=_http_status(result_dict['exitcode']),content=result_dict)
    result=_exec_borghelper(cmd,nick,extra_args,passphrase)
    # 1.28.8 (story 36, A62, décisions de l'utilisateur) : codes 0 et 1 seulement — 1 = alerte ou erreur tirée des bases (Report
    # -o : « diff.db absent », MAX_AGE_BKP ; lecteur : « Aucune archive indexée »), couverte par l'empreinte ; code >= 2 = état
    # extérieur aux bases (« ⚠ dépôt absent », borg, ssh, dépôt externe) : jamais resservi après remontage.
    # 1.29.0 (story 37) : arrêt d'un nick ([ERREUR]) exclu aussi (A67) ; entrée datée pour _CACHE_TTL (A66).
    # Revue : empreinte identique avant et après l'exécution (disque démonté pendant un Report -o : jamais rangé sous « absent »).
    if (key is not None and result.exitcode in (0,1) and not _never_cache(result)
            and _response_fingerprint(cmd,nick)==fp):
        if len(_RESPONSE_CACHE)>500: _RESPONSE_CACHE.clear()  # garde-fou anti-croissance illimitée
        _RESPONSE_CACHE[key]=(fp,_mdump(result),time.monotonic())
    return JSONResponse(status_code=_http_status(result.exitcode),content=_mdump(result))

# ── Filtrage a posteriori par périmètre (Story 1.3) ─────────────────────────
# _run_scoped() : variante non-cacheable de run_borghelper() pour les 6 routes Search/FileHist/
# LstBkpFls/DiffBkp/TreeHist/TreeFind quand au moins un nick de la requête porte un périmètre
# restreint (_any_scoped()). Force -j (si absent), parse le JSON renvoyé par borgHelper, applique
# une des fonctions _filter_* ci-dessous, ré-sérialise dans `stdout`. Jamais mis en
# `_RESPONSE_CACHE` : deux périmètres différents ne doivent jamais partager une réponse en cache
# (voir ARCHITECTURE-SPINE.md AD-5 — le cache dédié par périmètre est Story 1.5, pas celui-ci).

_SCOPED_CALL=contextvars.ContextVar('borghelperwww_scoped',default=False)   # 1.32.0 (row 25) : sortie pour un appelant à périmètre

def _scoped_exec(cmd,nick,args,passphrase):
    tok=_SCOPED_CALL.set(True)
    try: return _exec_borghelper(cmd,nick,args,passphrase)
    finally: _SCOPED_CALL.reset(tok)

def _run_scoped(cmd: str, nick: str, extra_args, filter_fn, passphrase: Optional[str]=None) -> JSONResponse:
    args=list(extra_args)
    if '-j' not in args: args=args+['-j']
    return _scoped_filter_result(_scoped_exec(cmd,nick,args,passphrase),filter_fn)

def _scoped_filter_result(result,filter_fn):
    """Sortie d'un appelant à périmètre restreint (commune à _run_scoped et _run_scoped_raw, 1.28.6). Filtrée QUEL QUE
    SOIT le code de sortie (borgHelper 1.0.167, story 30 : un lecteur multi-nicks imprime les résultats des autres nicks
    même quand l'un échoue) — avant, un code ≠ 0 relayait stdout tel quel. Fail-closed : stdout non-JSON ou d'une forme
    que le filtre ne connaît pas -> vidé (erreur) ou refusé (code 0, « ne devrait jamais arriver »)."""
    if result.exitcode==0 or (result.stdout or '').strip():
        try:
            parsed=json.loads(result.stdout)
            result.stdout=json.dumps(filter_fn(parsed),ensure_ascii=False,indent=2)
        except (ValueError,TypeError,KeyError,AttributeError) as e:
            if not isinstance(e,ValueError):   # JSON valide d'une forme que le filtre ne connaît pas : défaut à voir au journal
                print(f"[borgHelperWWW] filtre de périmètre en échec ({type(e).__name__}: {e}) — sortie refusée",file=sys.stderr,flush=True)
            if result.exitcode!=0: result.stdout=''   # erreur : jamais de sortie non filtrée (stderr gardé)
            else:
                result.exitcode=1; result.stdout=''; result.stderr=(result.stderr or '')+"\n[borgHelperWWW] réponse non-JSON reçue pour un appelant à périmètre restreint — requête refusée."
    return JSONResponse(status_code=_http_status(result.exitcode),content=_mdump(result))

def _filter_per_nick_list(results,scopes,path_key='path'):
    """Search : `results` = {nick: [{...,path_key:...}, ...] | {'error':msg}}. Filtre chaque liste
    par le périmètre de SON nick ; laisse les `{'error':...}` intacts (rien à filtrer)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        out[n]=[row for row in val if _path_in_scope(row.get(path_key,''),scopes.get(n))] if isinstance(val,list) else val
    return out

def _filter_filehist(results,path,scopes):
    """FileHist : mêmes formes que Search mais chaque ligne n'a PAS de champ path (c'est le `path`
    demandé, un seul par requête, implicite pour toutes les lignes d'un nick) — donc pas de
    filtrage ligne par ligne : soit le `path` demandé est dans le périmètre du nick (liste
    inchangée), soit il ne l'est pas (liste vidée pour ce nick — même défaut non-glamour que
    TreeHist/TreeFind sur un préfixe hors périmètre, voir Design Notes du spec 1.3)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        out[n]=(val if _path_in_scope(path,scopes.get(n)) else []) if isinstance(val,list) else val
    return out

def _filter_str_list(d,scope,key):
    """LstBkpFls : `d` = {'nick':...,'archive':...,'files':[chemin,...]} | {'error':msg} — pas de
    dict par nick (route mono-nick), `files` est une liste de chemins bruts (pas de dict par ligne)."""
    if isinstance(d,dict) and key in d:
        d=dict(d); d[key]=[s for s in d[key] if _path_in_scope(s,scope)]
    return d

def _filter_diffbkp(result,scope):
    """DiffBkp : `result` = {'archive_old','archive_new','entries':[{...,'path':...}],'n_add','n_rem',
    'n_mod'} | {'error':msg} — route mono-nick. Filtre `entries` par `path` puis RECALCULE
    n_add/n_rem/n_mod à partir des entrées filtrées (Boundaries du spec 1.3 / FR8 : jamais transmis
    depuis le compte non filtré) avec la même formule que `borgHelper.diffbkp()` : n_add = compte
    `change_type=='added'`, n_rem = compte `'removed'`, n_mod = reste."""
    if isinstance(result,dict) and 'entries' in result:
        result=dict(result)
        entries=[e for e in result['entries'] if _path_in_scope(e.get('path',''),scope)]
        n_add=sum(1 for e in entries if e['change_type'] in _DIFF_ADDED_TYPES)    # tous types (répertoire,
        n_rem=sum(1 for e in entries if e['change_type'] in _DIFF_REMOVED_TYPES)  # lien, fifo…), 1.26.2
        result['entries']=entries; result['n_add']=n_add; result['n_rem']=n_rem; result['n_mod']=len(entries)-n_add-n_rem
    return result

def _filter_per_nick_listkey(results,scopes,list_key,item_path_key='full_path'):
    """TreeHist (`list_key='entries'`) / TreeFind (`list_key='matches'`) : `results` = {nick:
    {...,list_key:[{...,item_path_key:...},...]} | {'error':msg}}. Filtre la liste imbriquée par le
    périmètre de SON nick, sur `full_path` (jamais `name`, qui n'est que le nom de base — Boundaries
    du spec 1.3). Pour TreeHist, l'entrée '.' (le préfixe demandé lui-même) est filtrée comme les
    autres : un préfixe hors périmètre vide donc naturellement le résultat, sans cas particulier.
    ⚠️ Ne pas confondre le `list_key`/`item_path_key` RBAC ici avec la clé JSON `'scope'` que
    TreeFind utilise pour son propre préfixe de recherche (sans rapport, voir Design Notes)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        if isinstance(val,dict) and list_key in val:
            val=dict(val)
            val[list_key]=[item for item in val[list_key] if _path_in_scope(item.get(item_path_key,''),scopes.get(n))]
        out[n]=val
    return out

def _path_is_scope_ancestor(path,scope):
    """True si `path` est un répertoire PARENT strict d'au moins un préfixe de `scope` (ex. 'opt' et
    'opt/backups' pour le périmètre ['/opt/backups/mysql']) — jamais un chemin dans le périmètre
    lui-même (voir `_path_in_scope`), jamais un simple préfixe de chaîne ('op' n'est pas parent de
    'opt/...'). `scope=None` -> False (illimité : rien à rendre navigable en plus). Même
    normalisation du '/' initial que `_path_in_scope`."""
    if scope is None: return False
    path=(path or '').strip('/')
    for prefix in scope:
        p=prefix.strip('/')
        if not p: continue
        if path=='' or p.startswith(path+'/'): return True
    return False

def _filter_treehist(results,scopes):
    """TreeHist (navigation de l'UI) : comme `_filter_per_nick_listkey(...,'entries')`, mais garde
    aussi les répertoires PARENTS du périmètre (`_path_is_scope_ancestor`), sinon un appelant borné
    à '/opt/backups/mysql' voit une racine vide et ne peut jamais descendre jusqu'à son périmètre.
    Un parent est réduit à une entrée de navigation nue : nom/chemin/is_dir seulement — droits,
    propriétaire, historique (`events`) et marque de suppression retirés (ces métadonnées décrivent
    un objet HORS périmètre ; `events` d'un répertoire agrège en plus les mouvements de toute sa
    sous-arborescence, donc de fichiers hors périmètre). Réservé à TreeHist : Search/TreeFind/
    rapports/restauration gardent le filtrage strict."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        scope=scopes.get(n)
        if isinstance(val,dict) and 'entries' in val:
            val=dict(val); kept=[]
            for item in val['entries']:
                fp=item.get('full_path') or ''
                if _path_in_scope(fp,scope): kept.append(item)
                elif _path_is_scope_ancestor(fp,scope):
                    kept.append({'name':item.get('name'),'full_path':item.get('full_path'),'genre':'répertoire',
                        'mode':None,'owner':None,'is_dir':True,'events':[],'scope_ancestor':True})
            val['entries']=kept
        out[n]=val
    return out

# ── Filtrage a posteriori DuIdx/IdxTop/DiffTop (Story 1.4) ──────────────────
# Contrairement à Search/FileHist/LstBkpFls/DiffBkp/TreeHist/TreeFind (Story 1.3), ces trois
# commandes groupent/agrègent déjà en Python (voire en SQL, pour DuIdx) AVANT de produire leur JSON
# existant — filtrer ce JSON après coup serait incorrect (une frontière de périmètre peut tomber au
# milieu d'un groupe déjà constitué, Intent du spec 1.4). borgHelper expose donc un mode BRUT,
# ungroupé, par-chemin : `-R` pour DuIdx (dont le `-j` existant reste le mode groupé historique,
# byte-identique, jamais touché ici) ; `-j` pour IdxTop/DiffTop, qui n'avaient aucun mode JSON avant
# cette story. Les fonctions ci-dessous filtrent ces lignes brutes par périmètre PUIS reproduisent —
# en miroir ligne-à-ligne de borgHelper au moment de l'écriture, jamais une réécriture "propre" — le
# regroupement/tri/top-N que borgHelper applique lui-même (Design Notes du spec 1.4 : garder ce
# mirroring littéral rend le contrôle de dérive tractable — diff les deux copies, jamais raisonner
# sur une équivalence comportementale).
#
# DuIdx/IdxTop/DiffTop sont traités comme mono-nick pour le périmètre (comme LstBkpFls/DiffBkp en
# Story 1.3) : jamais de filtrage/ré-agrégation multi-nick construit ici. `nick=ALL`/liste chez un
# appelant scopé est refusé proprement (fail-closed, aucune donnée) plutôt que de tenter un
# regroupement inter-nicks que cette story ne construit pas.

def _resolve_single_scope(request,nick):
    """`nick` développé via `_nick_list()` AVANT toute résolution de périmètre — jamais un
    `cfgread('ALL')` direct, qui reviendrait à tort « illimité » (même piège que le Groupe A du
    Triage Log de Story 1.3, pour `nick=ALL` avec un défaut de route). Retourne (None,None) si
    l'appelant est illimité sur toute la liste (byte-identique à avant cette story, y compris pour
    `nick=ALL`/multi-nick tel quel). Retourne (nick_unique, scope) si l'appelant est scopé et que la
    requête ne porte que sur un seul nick réel. Lève HTTPException(400) si scopé + plusieurs nicks —
    fail-closed, jamais de filtrage multi-nick approximatif ici."""
    nicks=list(dict.fromkeys(_nick_list(nick)))
    scopes=_resolve_scopes_for_request(request,nicks)
    if not _any_scoped(scopes):
        return None,None
    if len(nicks)!=1:
        raise HTTPException(400,detail="nick=ALL / plusieurs nicks non supporté pour un appelant à "
            "périmètre restreint sur cette route")
    return nicks[0],scopes[nicks[0]]

def _run_scoped_raw(cmd,nick,extra_args,raw_flag,filter_fn,passphrase=None):
    """Variante de `_run_scoped()` (Story 1.3) pour DuIdx/IdxTop/DiffTop : force `raw_flag` (mode brut
    par-chemin) au lieu du `-j` générique de `_run_scoped()` — DuIdx a besoin de `-R` spécifiquement
    puisque son `-j` existant reste le mode groupé historique. `filter_fn` reçoit le JSON brut parsé,
    filtre par périmètre PUIS ré-agrège/re-classe (jamais l'inverse — Boundaries du spec 1.4 / AD-2).
    Jamais mis en `_RESPONSE_CACHE` (même règle que `_run_scoped()`, AD-5)."""
    args=list(extra_args)
    if raw_flag not in args: args=args+[raw_flag]
    return _scoped_filter_result(_scoped_exec(cmd,nick,args,passphrase),filter_fn)   # 1.28.6 : même garde que _run_scoped

# ── Enveloppes de cache par périmètre autour de _run_scoped/_run_scoped_raw (Story 1.5) ────────
# Jamais à l'intérieur de _run_scoped()/_run_scoped_raw() elles-mêmes (Code Map du spec 1.5 : ces
# deux fonctions restent des primitives non-cacheables, c'est l'endpoint appelant qui décide).

def _scoped_cached_mono(cmd,nick,scope,fingerprint,params,run_fn):
    """Enveloppe de cache pour les cinq routes mono-nick (LstBkpFls/DiffBkp/DuIdx/IdxTop/DiffTop) :
    lookup avant d'appeler `run_fn` (le `_run_scoped`/`_run_scoped_raw` déjà construit par
    l'endpoint appelant, inchangé), écrit/rafraîchit la ligne après un miss. `run_fn` : callable
    sans argument renvoyant le JSONResponse de `_run_scoped`/`_run_scoped_raw` tel quel."""
    sig=_scope_signature(scope)
    cached=_scope_cache_get(nick,cmd,params,sig,fingerprint)
    if cached is not None:
        return JSONResponse(status_code=200 if cached.get('exitcode')==0 else 400,content=cached)
    resp=run_fn()
    try: result_dict=json.loads(resp.body)
    except ValueError: result_dict=None
    if (isinstance(result_dict,dict) and result_dict.get('exitcode')==0
            and not _never_cache(CommandResult(**{k:result_dict.get(k) for k in ('exitcode','stdout','stderr')}))):   # AD-13, A67
        _scope_cache_put(nick,cmd,params,sig,fingerprint,result_dict)
    return resp

def _scoped_cached_multi(cmd,nick,nicks,scopes,fingerprints,params,run_fn):
    """Enveloppe de cache pour les quatre routes multi-nick (Search/FileHist/TreeHist/TreeFind) :
    hit complet — chaque nick de `nicks` a une ligne fraîche en cache (empreinte+signature
    identiques) — synthétise la réponse SANS appeler borgHelper (json.loads(fragment['stdout'])
    par nick, jamais l'enveloppe {nick:...} — Implementation Notes du spec 1.5). Tout miss -> lance
    `run_fn` (l'appel combiné `_run_scoped` existant, EXACTEMENT comme avant cette story), puis
    écrit/rafraîchit une ligne par nick à partir de CE résultat — jamais l'inverse. `run_fn` :
    callable sans argument renvoyant le JSONResponse de `_run_scoped` tel quel.

    N'écrit AUCUN fragment si l'appel combiné échoue ou si son stdout ne parse pas en dict (rien
    de sensible à découper par nick) — les lignes précédentes (s'il y en a) restent inchangées, la
    prochaine requête retombe simplement en miss (jamais pire qu'avant cette story)."""
    fragments={}
    for n in nicks:
        frag=_scope_cache_get(n,cmd,params,_scope_signature(scopes.get(n)),fingerprints.get(n,''))
        if frag is None:
            fragments=None; break
        fragments[n]=frag
    if fragments is not None:
        try:
            combined={n:json.loads(fragments[n]['stdout']) for n in nicks}
        except ValueError:
            combined=None
        if combined is not None:
            # Chaque fragment peut avoir été écrit par un appel combiné DIFFÉRENT (nicks distincts
            # à des moments distincts) — jamais supposer un stderr partagé, concaténer celui de
            # chaque fragment réellement présent dans ce hit (dédoublonné, ordre stable). En
            # pratique toujours vide ici (Search/FileHist/TreeHist/TreeFind en mode JSON forcé
            # n'écrivent jamais sur stderr sur un succès), mais correct même si ça change un jour.
            seen=[];
            for n in nicks:
                s=fragments[n].get('stderr','')
                if s and s not in seen: seen.append(s)
            stderr='\n'.join(seen)
            result_dict={'exitcode':0,'stdout':json.dumps(combined,ensure_ascii=False,indent=2),'stderr':stderr}
            return JSONResponse(status_code=200,content=result_dict)
    resp=run_fn()
    try: result_dict=json.loads(resp.body)
    except ValueError: result_dict=None
    if (isinstance(result_dict,dict) and result_dict.get('exitcode')==0
            and not _never_cache(CommandResult(**{k:result_dict.get(k) for k in ('exitcode','stdout','stderr')}))):   # AD-13, A67
        try: parsed=json.loads(result_dict['stdout'])
        except ValueError: parsed=None
        if isinstance(parsed,dict):
            for n in nicks:
                if n in parsed:
                    frag={'exitcode':0,'stdout':json.dumps(parsed[n],ensure_ascii=False),
                          'stderr':result_dict.get('stderr','')}
                    _scope_cache_put(n,cmd,params,_scope_signature(scopes.get(n)),fingerprints.get(n,''),frag)
    return resp

_DUIDX_TYPE_ORDER=['added','modified','removed','C','B','T','présent']  # miroir borgHelper:_DUIDX_TYPE_ORDER
_DUIDX_COL_KEYS=['added','removed','présent']                            # miroir borgHelper:_DUIDX_COL_KEYS
_DUIDX_COL_NAMES=['added/modif','removed','présent']                     # miroir borgHelper:_DUIDX_COL_NAMES

def _duidx_path_key(path,depth):  # miroir borgHelper:_duidx_path_key
    parts=path.split('/')
    return '/'.join(parts[:depth+1]) if depth<len(parts) else path

def _duidx_sort_key(pk,merged,sort_by,reverse):  # miroir borgHelper:_duidx_sort_key
    if sort_by=='chemin': return pk
    idx=_DUIDX_COL_KEYS.index(sort_by) if sort_by in _DUIDX_COL_KEYS else 0
    sz=merged.get((pk,_DUIDX_COL_KEYS[idx]),[0,0])[1]
    return -sz if reverse else sz

def _parse_duidx_sort(sort):  # miroir de la normalisation `_du_sort`/`_du_rev` faite dans borgHelper:_cli_main()
    du_sort=sort or 'chemin'
    du_rev=du_sort.endswith(':desc')
    du_sort=du_sort.replace(':asc','').replace(':desc','')
    if du_sort not in ('chemin','added','removed','présent','present'): du_sort='chemin'
    if du_sort=='present': du_sort='présent'
    return du_sort,du_rev

def _recompute_duidx(parsed,scope,pattern,sort):
    """Filtre les lignes brutes DuIdx (`-R`) par périmètre puis reproduit `_duidx_print()`
    (borgHelper) — mode groupé (`pattern` en 'préfixe/*' ou '*') ou global (`pattern` absent ou
    littéral), même distinction que `duidx()` lui-même. `parsed` sans `rows` (ex. `{'error':...}`)
    passe inchangé."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    grouped=pattern is not None and ('/*' in pattern or pattern=='*')
    if grouped:
        # Même règle que borgHelper (importée, jamais recopiée) : profondeur du motif ; les lignes brutes
        # reçues sont déjà filtrées par le motif composant par composant (`foo/*bar`, borgHelper >= 1.0.125).
        _sel,depth,_match=_duidx_group_spec(pattern)
        sort_by,reverse=_parse_duidx_sort(sort)
        merged={}
        for r in rows:
            pk=_duidx_path_key(r.get('chemin',''),depth)
            ct=r.get('type')
            eff='added' if ct in ('added','modified','C','B','T') else ct
            k=(pk,eff)
            if k not in merged: merged[k]=[0,0]
            merged[k][0]+=1; merged[k][1]+=r.get('taille',0)
        paths=sorted(set(pk for pk,_ in merged),
                     key=lambda pk:_duidx_sort_key(pk,merged,sort_by,reverse),
                     reverse=(reverse if sort_by!='chemin' else False))
        totcol={ck:[0,0] for ck in _DUIDX_COL_KEYS}
        rows_data=[]
        for pk in paths:
            entry={'chemin':pk}
            for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES):
                cnt,sz=merged.get((pk,ck),[0,0])
                entry[cn]={'nb':cnt,'taille':sz}
                totcol[ck][0]+=cnt; totcol[ck][1]+=sz
            rows_data.append(entry)
        return {'borghelper_version':parsed.get('borghelper_version'),'pattern':pattern,'rows':rows_data,
                'total':{cn:{'nb':totcol[ck][0],'taille':totcol[ck][1]} for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES)}}
    totals={}
    for r in rows:
        ct=r.get('type')
        if ct not in totals: totals[ct]=[0,0]
        totals[ct][0]+=1; totals[ct][1]+=r.get('taille',0)
    order=_DUIDX_TYPE_ORDER
    rows_data=[{'type':ct,'nb':cnt,'taille':sz} for ct,(cnt,sz) in
               sorted(totals.items(),key=lambda x:(order.index(x[0]) if x[0] in order else 99))]
    return {'borghelper_version':parsed.get('borghelper_version'),'pattern':pattern,'rows':rows_data,
            'total':{'nb':sum(r['nb'] for r in rows_data),'taille':sum(r['taille'] for r in rows_data)}}

def _idxtop_get_prefix(path,d):  # miroir borgHelper:idxtop().get_prefix / difftop().get_prefix (identiques)
    if not path: return '(vide)'
    leading='/' if path[0]=='/' else ''
    parts=[p for p in path.split('/') if p]
    if len(parts)<=d: return path
    return leading+'/'.join(parts[:d])

def _recompute_idxtop(parsed,scope,depth,topn):
    """Filtre les lignes brutes IdxTop (`-j`) par périmètre puis reproduit le regroupement/tri/top-N
    de `idxtop()` (borgHelper). Volontairement SANS `exclu_n`/`nfiles_d` (Exclus/Inchangés par
    archive) : figures whole-nick sans colonne de chemin, non-scopables correctement — omises pour
    tout appelant scopé (Boundaries du spec 1.4), jamais approximées."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    stats=defaultdict(lambda:{'count':0,'size':0})
    total_count=0; total_size=0
    for r in rows:
        pfx=_idxtop_get_prefix(r.get('chemin',''),depth)
        sz=r.get('taille',0) or 0
        stats[pfx]['count']+=1; stats[pfx]['size']+=sz
        total_count+=1; total_size+=sz
    top=sorted(stats.items(),key=lambda x:x[1]['count'],reverse=True)[:topn]
    rows_out=[{'prefix':pfx,'count':s['count'],'size':s['size'],
               'pct':(100*s['count']//total_count) if total_count else 0} for pfx,s in top]
    return {'borghelper_version':parsed.get('borghelper_version'),'nick':parsed.get('nick'),'depth':depth,
            'topn':topn,'total_count':total_count,'total_size':total_size,'rows':rows_out}

def _recompute_difftop(parsed,scope,depth,topn):
    """Filtre les lignes brutes DiffTop (`-j`) par périmètre puis reproduit le regroupement/tri/top-N
    de `difftop()` (borgHelper). Une paire d'archives sans la moindre ligne dans le périmètre renvoie
    naturellement `rows=[]`/totaux à 0 — jamais une erreur (I/O matrix du spec 1.4). Volontairement
    SANS `exclu_n`/`nfiles_new` (Exclus/Inchangés), même raison que `_recompute_idxtop`."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    stats=defaultdict(lambda:{'total':0,'added_n':0,'added_s':0,'removed_n':0,'removed_s':0,'modified_n':0,'size':0})
    total_count=0; total_size=0
    for r in rows:
        pfx=_idxtop_get_prefix(r.get('chemin',''),depth)
        s=stats[pfx]
        s['total']+=1
        sa=r.get('taille_apres',0) or 0; sb=r.get('taille_avant',0) or 0
        sz=sa or sb or 0
        s['size']+=sz
        ct=r.get('type')
        if ct in _DIFF_ADDED_TYPES: s['added_n']+=1; s['added_s']+=sa
        elif ct in _DIFF_REMOVED_TYPES: s['removed_n']+=1; s['removed_s']+=sb
        else: s['modified_n']+=1
        total_count+=1; total_size+=sz
    top=sorted(stats.items(),key=lambda x:x[1]['total'],reverse=True)[:topn]
    rows_out=[]
    for pfx,s in top:
        pct=(100*s['total']//total_count) if total_count else 0
        rows_out.append({'prefix':pfx,'total':s['total'],'pct':pct,
                          'added_n':s['added_n'],'added_size':s['added_s'],
                          'removed_n':s['removed_n'],'removed_size':s['removed_s'],
                          'modified_n':s['modified_n'],'size':s['size']})
    return {'borghelper_version':parsed.get('borghelper_version'),'nick':parsed.get('nick'),
            'archive_old':parsed.get('archive_old'),'archive_new':parsed.get('archive_new'),
            'depth':depth,'topn':topn,'total_count':total_count,'total_size':total_size,'rows':rows_out}

# ── Téléchargements (accès borg direct, streaming binaire) ─────────────────────
# Seule exception au principe "tout passe par borgHelper en sous-processus" : un téléchargement
# doit streamer des octets bruts vers le navigateur, incompatible avec le pipe texte/JSON de
# run_borghelper(). Lit la conf via BorgRunner (mode librairie, cfgfile+passphrase), exécute borg
# directement (extract --stdout / export-tar) et streame son stdout comme réponse HTTP.

_BORG_ENV_KEYS=('BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO',
                 'BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE')
_FILENAME_UNSAFE=re.compile(r'[^A-Za-z0-9_.\-]+')

def _borg_cfg(nick: str, passphrase: Optional[str]):
    if DIR_MODE:   # 1.32.0 (story 86) : rc du nick, nick nu ; non résolu : même 404 qu'un nick inconnu
        e,b=_rc_entry_of(nick)
        cfg=BorgRunner(cfgfile=e.path,passphrase=passphrase).cfgread(b) if e is not None else None
    else: cfg=BorgRunner(cfgfile=CFGFILE,passphrase=passphrase).cfgread(nick)
    if cfg is None:
        raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return cfg

def _borg_env(cfg):
    """Environnement d'un borg lancé ici (téléchargements, dernière archive) : celui du serveur, clés borg du rc.
    1.31.11 (story 72, D142, décision de l'utilisateur) : BORG_EXIT_CODES=legacy forcé — borg 1.4 avec BORG_EXIT_CODES=modern
    (posé sur le service, copié d'ici) rend « never matched » en 101 et ses erreurs en 3-99 (mesuré sur 1.4.5 : /download/file
    d'un chemin absent en 502 au lieu de 404) ; lectures des codes (0/1/>= 2) inchangées ; borg 1.2 ignore la variable."""
    env=os.environ.copy()
    for k in _BORG_ENV_KEYS:
        if k in cfg.keys(): env[k]=cfg[k]
    env['BORG_EXIT_CODES']='legacy'
    return env

def _latest_archive(cfg,env):
    borg_exe=cfg.get('BORG_EXE','borg')
    try:
        proc=_run_group([borg_exe,'list','--short']+glob_args(cfg)+[cfg['BORG_REPO']],60,env)   # 1.31.1 (A91) : groupe arrêté au délai
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail="borg list : timeout")
    rb={'exitcode':proc.returncode,'stderr':proc.stderr.split('\n')}
    if proc.returncode not in (0,1):   # 1.30.1 (story 39, A77) : code 1 de borg = avertissement, liste gardée (avant : 502)
        # 1.30.0 (revue story 38) : message réduit (_rb_errmsg) — avant : stderr brut coupé à 300 caractères, trace sans la cause
        raise HTTPException(502,detail="borg list a échoué : "+_rb_errmsg(rb,'borg list'))
    if proc.returncode==1:   # avertissement au journal du serveur (dépôt cité : _latest_archive ne connaît pas le nick)
        msg=_rb_errmsg(rb,'borg list',n=5); msg='code 1 (avertissement)' if msg.startswith('borg list failed') else msg
