    # ── Garde BORGHELPERWWW_* égarée dans .borghelperrc[DEFAULT] (piège réel constaté en prod) ──
    def _stray_keys_warned():
        trap_rc=os.path.join(tmpdir,'trap.borghelperrc')
        os.makedirs(tmpdir,exist_ok=True)
        with open(trap_rc,'w') as f:
            f.write("[DEFAULT]\nBORGHELPERWWW_GROUPS_HEADER = X-GROUPS\nCACHE_DIR = /tmp\n")
        out=io.StringIO()
        with contextlib.redirect_stderr(out):
            _warn_stray_borghelperwww_keys(trap_rc)
        warned=('BORGHELPERWWW_GROUPS_HEADER' in out.getvalue() and '[WARN]' in out.getvalue())
        clean_rc=os.path.join(tmpdir,'clean.borghelperrc')
        with open(clean_rc,'w') as f:
            f.write("[DEFAULT]\nCACHE_DIR = /tmp\n")
        out2=io.StringIO()
        with contextlib.redirect_stderr(out2):
            _warn_stray_borghelperwww_keys(clean_rc)
        silent=(out2.getvalue()=='')
        return warned and silent
    tmpdir=tempfile.mkdtemp(prefix='borghelperwww-strayguard-selftest-')
    try:
        check("garde BORGHELPERWWW_* dans .borghelperrc[DEFAULT] : avertit si présent, silencieux sinon",
              _stray_keys_warned)
    finally:
        shutil.rmtree(tmpdir,ignore_errors=True)

    # ── .borghelperrc[_borgHelperWWW] (spec-borghelperrc-www-section) ──
    def _default_borghelperwww_section_ok():
        """_apply_conf_section (partagée avec borghelperwww.conf) comble bien os.environ depuis une
        section [_borgHelperWWW] ; ne touche jamais une variable déjà présente (priorité
        CLI/env) ; la garde ci-dessus reste silencieuse sur cette section (jamais confondue avec le
        piège [DEFAULT] nu, CAP-2)."""
        cp=configparser.ConfigParser()
        cp.read_string("[_borgHelperWWW]\ngroups_header = X-Test-Groups\napi_prefix = /custom\n")
        saved={k:os.environ.pop(k,None) for k in ('BORGHELPERWWW_GROUPS_HEADER','BORGHELPERWWW_API_PREFIX')}
        os.environ['BORGHELPERWWW_API_PREFIX']='/already-set'  # priorité : ne doit jamais être écrasée
        try:
            _apply_conf_section(cp['_borgHelperWWW'])
            applied_ok=(os.environ.get('BORGHELPERWWW_GROUPS_HEADER')=='X-Test-Groups'
                        and os.environ.get('BORGHELPERWWW_API_PREFIX')=='/already-set')
        finally:
            for k,v in saved.items():
                if v is None: os.environ.pop(k,None)
                else: os.environ[k]=v
        rc_path=os.path.join(tempfile.mkdtemp(prefix='borghelperwww-defaultwww-selftest-'),'test.borghelperrc')
        with open(rc_path,'w') as f:
            f.write("[DEFAULT]\nCACHE_DIR = /tmp\n\n[_borgHelperWWW]\ngroups_header = X-Test-Groups\n")
        out=io.StringIO()
        try:
            with contextlib.redirect_stderr(out):
                _warn_stray_borghelperwww_keys(rc_path)
        finally:
            shutil.rmtree(os.path.dirname(rc_path),ignore_errors=True)
        guard_silent_ok=(out.getvalue()=='')
        return applied_ok and guard_silent_ok
    check("[_borgHelperWWW] : comble os.environ sans écraser l'existant, jamais confondue avec le piège [DEFAULT] nu",
          _default_borghelperwww_section_ok)

    # ── _is_valid_http_token (garde GROUPS_HEADER, piège réel : commentaire inline collé à la valeur) ──
    def _is_valid_http_token_ok():
        return (_is_valid_http_token('X-Groups') and _is_valid_http_token('X-My-Group_2')
                and not _is_valid_http_token('X-Groups   ; commentaire — resté collé à la valeur')
                and not _is_valid_http_token('X Groups')  # espace : jamais un token valide
                and not _is_valid_http_token(''))
    check("_is_valid_http_token : accepte un nom de header RFC 7230, rejette un commentaire inline resté collé/un espace/vide",
          _is_valid_http_token_ok)

    # ── GROUPS_PATHS scindé lecture/restauration (spec-groups-paths-restore) ──
    def _groups_paths_restore_split_ok():
        """_resolve_path_scope(...,for_restore=True) applique GROUPS_PATHS_RESTORE avec repli PAR
        GROUPE sur GROUPS_PATHS quand for_restore=False utilise GROUPS_PATHS seule — jamais l'un
        pour l'autre. cfg synthétique = simple dict (voir _scope_nicks_for_groups), pas besoin d'un
        vrai .borghelperrc sur disque."""
        cfg={'GROUPS_READ':'compta,audit,direction',
             'GROUPS_PATHS':'compta:/srv/data/compta, audit:/srv/data/compta, direction:/srv/data/rh|/srv/data/compta',
             'GROUPS_PATHS_RESTORE':'compta:/srv/data/compta/archives'}
        # compta : lecture large (racine compta), restauration restreinte à un sous-dossier (a une
        # entrée GROUPS_PATHS_RESTORE dédiée) :
        read_compta=_resolve_path_scope({'compta'},cfg,for_restore=False)
        restore_compta=_resolve_path_scope({'compta'},cfg,for_restore=True)
        compta_ok=(read_compta==['/srv/data/compta'] and restore_compta==['/srv/data/compta/archives'])
        # audit : aucune entrée GROUPS_PATHS_RESTORE -> repli sur son entrée GROUPS_PATHS (identique
        # en lecture et en restauration) :
        read_audit=_resolve_path_scope({'audit'},cfg,for_restore=False)
        restore_audit=_resolve_path_scope({'audit'},cfg,for_restore=True)
        audit_ok=(read_audit==restore_audit==['/srv/data/compta'])
        # direction : plusieurs répertoires en lecture ('|'), même repli qu'audit en restauration
        # (pas d'entrée GROUPS_PATHS_RESTORE dédiée) :
        read_direction=_resolve_path_scope({'direction'},cfg,for_restore=False)
        restore_direction=_resolve_path_scope({'direction'},cfg,for_restore=True)
        direction_ok=(sorted(read_direction)==sorted(restore_direction)==['/srv/data/compta','/srv/data/rh'])
        return compta_ok and audit_ok and direction_ok
    check("GROUPS_PATHS_RESTORE : périmètre distinct par groupe, repli sur GROUPS_PATHS si absent (jamais l'inverse)",
          _groups_paths_restore_split_ok)
    def _require_path_in_scope_uses_restore_ok():
        """require_path_in_scope (Restore/RestorePerms/DownloadFile/DownloadTar) applique bien le
        périmètre de RESTAURATION, pas celui de lecture — un chemin autorisé en lecture mais hors du
        périmètre de restauration doit être refusé ici."""
        cfg={'GROUPS_READ':'compta','GROUPS_PATHS':'compta:/srv/data/compta',
             'GROUPS_PATHS_RESTORE':'compta:/srv/data/compta/archives'}
        old_gh,old_cfgread=GROUPS_HEADER,_bh_paths.borg.cfgread
        try:
            globals()['GROUPS_HEADER']='X-Test-Groups'
            _bh_paths.borg.cfgread=lambda n,debug=0: cfg if n=='rbactest' else None
            class _FakeReq:
                headers={'X-Test-Groups':'compta'}
            req=_FakeReq()
            # /srv/data/compta/courrier : dans le périmètre de LECTURE mais hors du périmètre de
            # RESTAURATION (sous-dossier 'archives' uniquement) -> refusé :
            denied=not require_path_in_scope(req,'rbactest','srv/data/compta/courrier')
            # /srv/data/compta/archives/2024 : dans le périmètre de restauration -> autorisé :
            allowed=require_path_in_scope(req,'rbactest','srv/data/compta/archives/2024')
            return denied and allowed
        finally:
            globals()['GROUPS_HEADER']=old_gh
            _bh_paths.borg.cfgread=old_cfgread
    check("require_path_in_scope (Restore/téléchargements) applique GROUPS_PATHS_RESTORE, pas le périmètre de lecture",
          _require_path_in_scope_uses_restore_ok)

    def _treehist_scope_ancestors_ok():
        """TreeHist garde les répertoires parents du périmètre (réduits à une entrée nue), jamais un
        voisin hors périmètre ni un faux parent par simple préfixe de chaîne ; filtrage strict
        inchangé pour Search/TreeFind (_filter_per_nick_listkey)."""
        scope=_canonicalize_scope(['/opt/backups/mysql/'])
        ent=lambda fp,d=True:{'name':fp.rsplit('/',1)[-1],'full_path':fp,'genre':'répertoire','mode':'drwx------',
            'owner':'root','is_dir':d,'events':[{'type':'modified','archive':'a1','date':'2026-01-01'}]}
        def names(prefix,fps):
            data={'h':{'path':prefix,'entries':[ent(fp,not fp.endswith('.sql')) for fp in fps]}}
            return data,_filter_treehist(data,{'h':scope})['h']['entries']
        _,root=names(None,['opt','etc','op'])
        _,opt=names('opt',['opt/backups','opt/other'])
        _,bk=names('opt/backups',['opt/backups/mysql','opt/backups/mysqlx'])
        _,my=names('opt/backups/mysql',['opt/backups/mysql/db.sql'])
        strict=_filter_per_nick_listkey({'h':{'entries':[ent('opt')]}},{'h':scope},'entries')['h']['entries']
        a=root[0] if root else {}
        return ([e['full_path'] for e in root]==['opt'] and a.get('scope_ancestor') is True
                and a['mode'] is None and a['owner'] is None and a['events']==[]
                and [e['full_path'] for e in opt]==['opt/backups']
                and [e['full_path'] for e in bk]==['opt/backups/mysql'] and not bk[0].get('scope_ancestor')
                and bk[0]['events'] and [e['full_path'] for e in my]==['opt/backups/mysql/db.sql']
                and strict==[] and _filter_treehist({'h':{'entries':[ent('etc')]}},{'h':None})['h']['entries'][0]['mode']=='drwx------')
    check("TreeHist : répertoires parents du périmètre GROUPS_PATHS navigables (entrée nue), rien d'autre hors périmètre",
          _treehist_scope_ancestors_ok)

    def _direct_path_access_ok():
        """Accès direct par périmètre (1.20.0) : groupe SANS tier cité dans GROUPS_PATHS -> lecture
        bornée, aucun téléchargement ; cité dans GROUPS_PATHS_RESTORE -> lecture + téléchargement
        bornés ; jamais au-delà du niveau lecture ; tier illimité d'un autre groupe l'emporte ; groupe
        cité nulle part -> aucun accès."""
        cfg={'GROUPS_ADMIN':'AD-Borg root','GROUPS_READ':'lecteurs',
             'GROUPS_PATHS':'dba:/opt/backups/mysql/, dev:/srv/app|/srv/lib, lecteurs:/srv/app',
             'GROUPS_PATHS_RESTORE':'dev:/srv/app/releases, sos:/home/sos'}
        L=_effective_level; R=_resolve_path_scope
        return (L({'dba'},cfg)==1 and R({'dba'},cfg)==['/opt/backups/mysql'] and R({'dba'},cfg,for_restore=True)==[]
            and L({'dev'},cfg)==1 and R({'dev'},cfg)==['/srv/app','/srv/lib']
            and R({'dev'},cfg,for_restore=True)==['/srv/app/releases']
            and L({'sos'},cfg)==1 and R({'sos'},cfg)==['/home/sos'] and R({'sos'},cfg,for_restore=True)==['/home/sos']
            and L({'dba','AD-Borg root'},cfg)==3 and R({'dba','AD-Borg root'},cfg) is None
            and R({'dba','lecteurs'},cfg)==['/opt/backups/mysql','/srv/app']
            and R({'dba','lecteurs'},cfg,for_restore=True)==['/srv/app']
            and L({'inconnu'},cfg)==0 and R({'inconnu'},cfg) is None
            and _scope_nicks_for_groups({'dba'},[('h1',cfg),('h2',{'GROUPS_ADMIN':'x'})])==['h1']
            and not _path_in_scope('opt/backups/mysql/db.sql',R({'dba'},cfg,for_restore=True)))
    check("Accès direct GROUPS_PATHS (lecture) / GROUPS_PATHS_RESTORE (+téléchargement) sans GROUPS_ADMIN/WRITE/READ",
          _direct_path_access_ok)

