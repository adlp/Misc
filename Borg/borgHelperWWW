    """1.33.0 (story 87a) : nicks comptés par /storage -> (nicks, erreurs) — tous (ALL : ceux du rc ; mode dossier : nicks exposés de
    chaque rc) sans autorisation par groupes ; avec : ceux que l'appelant peut LIRE (niveau >= lecture, accès direct par périmètre
    compris), jamais un autre (ni compté ni nommé). Décision 6 (revue 87a rows 18, 49) : droits d'un nick illisibles (rc illisible,
    GROUPS_PATHS devenu ambigu : _effective_level lève) -> nick omis, ni compté ni nommé ; une seule erreur générique
    `errors['*']` (_STORAGE_RIGHTS_MSG), le détail (nick, exception) au journal du serveur seulement. Rc illisible (row 35) : mode -C
    -> `errors['*']` (_STORAGE_RC_MSG) ; mode dossier -> `errors['<préfixe>:*']` sans autorisation par groupes, sinon l'erreur
    générique de décision 6 (jamais le nom d'un rc à un appelant). Nicks d'un rc lus une fois par requête (_rc_bare_nicks)."""
    errs={}
    def log(what,x):   # revue 87a (row 62) : type (+ clé) et numéro de ligne seuls d'une erreur de configparser, jamais la ligne brute du rc
        ln=getattr(x,'lineno',None)
        if ln is None and isinstance(x,configparser.ParsingError) and x.errors: ln=x.errors[0][0]
        t=_storage_err(x)+(f" (ligne {ln})" if isinstance(x,configparser.Error) and ln else '')
        print(f"[WARN] /storage : {what} — {_rc_scrub_all(t)}",file=sys.stderr,flush=True)
    if not DIR_MODE:   # row 55 : rc illisible (droits) -> erreur, jamais une vue vide en code 0 (cfgreadnicks avale l'OSError)
        try:
            with open(CFGFILE,'rb'): pass
        except (OSError,TypeError) as x: log("rc illisible",x); return [],{'*':_STORAGE_RC_MSG}
    try: nicks=_nick_list('ALL')
    except Exception as x: log("rc illisible",x); return [],{'*':_STORAGE_RC_MSG}
    # row 63 : nom hors règle de nick (section [ALL] comprise) écarté avant tout filtrage — jamais un `-n ALL` lancé
    nicks=[n for n in nicks if _valid_nick_name(n.partition(':')[2] if DIR_MODE else n)]
    if DIR_MODE:
        bad_rc=dict(((_RC_REQ.get() or {}).get('nicks_err') or {}))
        for p_ in _rc_state().unavailable:   # row 55 : rc écarté au rechargement (illisible, disparu) : dit de même
            bad_rc.setdefault(p_,RuntimeError('rc indisponible'))
        for p_,x in sorted(bad_rc.items()):
            log(f"rc du préfixe {p_} illisible",x)
            if GROUPS_HEADER: errs['*']=_STORAGE_RIGHTS_MSG
            else: errs[f"{p_}:*"]=_STORAGE_RC_MSG
    if not GROUPS_HEADER: return nicks,errs
    ug=_parse_groups(request.headers.get(GROUPS_HEADER)); keep=[]
    for n in nicks:
        try:
            cfg=_cfgread(n)
            if cfg is not None and _effective_level(ug,cfg)>=1: keep.append(n)
        except Exception as x: log(f"droits illisibles pour {n}, nick omis",x); errs['*']=_STORAGE_RIGHTS_MSG
    return keep,errs

@router.get("/storage",response_model=CommandResult,tags=["lecture"],
            summary="Stockages : dépôts regroupés par hôte (user@hôte[:port], cible de tunnel, montage local, STORAGE), taille et croissance — sans borg")
def storage(request: Request, x_api_key: Optional[str]=Header(default=None)):
    """1.33.0 (story 87a) : `borgHelper -c Storage -j` sur les nicks que l'appelant peut lire (_storage_nicks) — un borgHelper par
    rc (mode dossier ; -C : un seul), vues réunies (_storage_merge : même dépôt compté une fois), noms exposés. Revue 87a (row 3) :
    rc en échec (délai, refus de lancement, préfixe disparu, sortie non JSON) -> `errors['<préfixe>:*']` (mode -C : `errors['*']`),
    vue des autres rc gardée. Code : le pire des rc, 1 dès qu'une erreur est dite. Aucun nick lisible : vue vide (ses erreurs),
    rien lancé. Jamais en cache (rc, montages : état hors des bases). Lecture seule (history.db, df), jamais borg ni ssh."""
    require_api_key(x_api_key)
    nicks,errs=_storage_nicks(request)
    def add(k,m): errs[k]=m if k not in errs else errs[k] if m in errs[k] else f"{errs[k]} ; {m}"   # row 49 : jamais un avis écrasé
    groups={}
    for n in nicks: groups.setdefault(n.partition(':')[0] if DIR_MODE else '',[]).append(n)
    parts=[]; code=0; err=''
    for p,ns in groups.items():
        key=f"{p}:*" if p else '*'
        try: r=_exec_borghelper('storage',','.join(ns),['-j'])
        except HTTPException as x:
            add(key,_rc_scrub_all(f"HTTP {x.status_code} : {x.detail}")); continue
        except OSError as x:   # revue 87a (row 35) : lancement impossible -> erreur de ce rc, jamais une 500
            add(key,_rc_scrub_all(f"lancement impossible ({type(x).__name__} : {x})")); continue
        try: d=json.loads(r.stdout or '')
        except ValueError: d=None
        err+=r.stderr or ''
        if not isinstance(d,dict) or not isinstance(d.get('storages'),list):
            last=[l for l in (r.stderr or r.stdout or '').strip().splitlines() if l.strip()][-1:]
            add(key,_rc_scrub_all(f"code {r.exitcode}, réponse illisible"+(f" : {last[0][:300]}" if last else '')))
            code=max(code,r.exitcode if isinstance(r.exitcode,int) and r.exitcode>0 else 1); continue
        parts.append(d); code=max(code,r.exitcode)
    out=_storage_merge(parts)
    for k,m in errs.items(): out['errors'][k]=f"{out['errors'][k]} ; {m}" if k in out['errors'] else m
    out['borghelper_version']=out['borghelper_version'] or BORGHELPER_VERSION
    if out['errors']: code=max(code,1)
    return JSONResponse(status_code=_http_status(code),content={'exitcode':code,'stdout':json.dumps(out,ensure_ascii=False,indent=2),
                                                               'stderr':err})

