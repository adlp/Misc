@app.post("/login",response_model=CommandResult,tags=["admin"])
def login(servername: str, nickname: Optional[str]=None, repo: str=Query(...),
          repo_passphrase: str=Query(...,description="Passphrase persistée en clair dans le borghelperrc du serveur, PAS le header X-Borg-Passphrase"),
          keyfile: Optional[str]=None, mountpoint: Optional[str]=None,
          x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=['-s',servername,'-r',repo,'-p',repo_passphrase]
    if keyfile: extra+=['-k',keyfile]
    if mountpoint: extra+=['-m',mountpoint]
    return run_borghelper('login',nick=nickname,extra_args=extra)

