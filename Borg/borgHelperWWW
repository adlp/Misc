        raise HTTPException(400,detail="keyfile et mountpoint ne sont pas acceptés via l'API (chemins du serveur) — "
                            "les configurer avec la CLI : borgHelper -c Login")
    if DIR_MODE:   # 1.32.0 (story 86) : nick neuf écrit dans le rc de SON préfixe — nickname préfixé obligatoire, préfixe servi
        p,sep,b=(nickname or '').partition(':')
        if not sep or p not in _rc_state().entries:
            raise HTTPException(400,detail=f"nickname « préfixe:nick » requis en mode dossier, préfixe servi ({', '.join(_rc_state().entries)})"
                                f" : {nickname!r}")
    for what,v in (('servername',servername),('nickname',nickname.partition(':')[2] if DIR_MODE else nickname)):   # revue story 38 (G2)
        if v is not None and not _valid_nick_name(v):
            raise HTTPException(400,detail=f"{what} invalide : {v!r} — lettres, chiffres, « . », « _ », « - » (début : lettre ou chiffre), "
                                "ni ALL ni DEFAULT")
    if not _repo_is_remote(repo):
        raise HTTPException(400,detail=f"Dépôt local refusé via l'API : {repo} — dépôt distant seulement (ssh://…, "
                            "utilisateur@hôte:…) ; un dépôt local se configure avec la CLI : borgHelper -c Login")
    extra=['-s',servername,'-r',repo,'-p',repo_passphrase]
    return run_borghelper('login',nick=nickname,extra_args=extra)

