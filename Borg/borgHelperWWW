            except RuntimeError as x:
                # 1.31.10 (story 71, D146, décision de l'utilisateur) : client parti avant la réponse (StreamingResponse annulée
                # avant son en-tête) -> 499, aucune trace ; application sans réponse, client présent : 500 et trace (inchangé)
                if not _no_response_raised(x): raise
                try: gone=await request.is_disconnected()
                except Exception: gone=False   # revue story 71 : sonde en erreur = client présent, RuntimeError d'origine relancée
                if not gone: raise
                status=499; issue=' (client parti avant la réponse)'
                return _NoResponse()
            if (request.scope.get('state') or {}).get('stream_log'):
                # 1.31.10 (story 71, D143, décision de l'utilisateur) : flux (/download/*) -> ligne écrite à la fin réelle du
                # transfert (durée totale, issue), par _AbortableResponse
                deferred=True
