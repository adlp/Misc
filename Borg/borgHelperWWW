def _make_server(config):
    """1.31.0 (story 41, A86, décision de l'utilisateur) : uvicorn.Server dont le PREMIER signal d'arrêt tue les borg inactifs
    (sinon uvicorn attend sans limite la connexion d'un borg muet, et le SIGKILL de systemd le laissait orphelin — mesuré) et le
    second (arrêt forcé) tous les borg de téléchargement."""
