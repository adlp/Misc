    """Réponse filtrée par périmètre (lignes brutes `-R` filtrées puis regroupées/re-triées comme
    DuIdx lui-même) si l'appelant a un périmètre restreint sur `nick` (mono-nick pour le périmètre —
    Story 1.4, comme LstBkpFls/DiffBkp en Story 1.3) ; identique à avant cette story sinon. Story
    1.5 : réponse filtrée servie depuis le cache SQLite par périmètre si fraîche."""
    require_api_key(x_api_key)
    fingerprints=_capture_fingerprints(nick)
    scoped_nick,scope=_resolve_single_scope(request,nick)
    if scoped_nick is not None:
        extra=[]
        if pattern: extra+=['-f',pattern]
        if archive_from: extra+=['-b',archive_from]
        if archive_to: extra+=['-B',archive_to]
        params={'pattern':pattern or None,'sort':sort,'archive_from':archive_from,'archive_to':archive_to}
        return _scoped_cached_mono('duidx',scoped_nick,scope,fingerprints.get(scoped_nick,''),params,
            lambda:_run_scoped_raw('duidx',scoped_nick,extra,'-R',lambda data:_recompute_duidx(data,scope,pattern or None,sort)))
    extra=[]
    if pattern: extra+=['-f',pattern]
    extra+=['-s',sort]
    if json_output: extra.append('-j')
    if archive_from: extra+=['-b',archive_from]
    if archive_to: extra+=['-B',archive_to]
    return run_borghelper('duidx',nick=nick,extra_args=extra,cacheable=True)

def _scope_cache_nick_prefix(n):
    return json.dumps([n],ensure_ascii=False)[:-1]+','   # début de _scope_cache_key : ["<nick>",

def _scope_cache_stats(nicks):
    """{nick: (lignes, plus ancienne written_at)} dans SCOPE_CACHE_DB — jamais d'exception (pur cache)."""
    out={}
    try:
        conn=_open_db(SCOPE_CACHE_DB,nick=None,role='read')
        try:
            for n in nicks:
                pfx=_scope_cache_nick_prefix(n)
                out[n]=tuple(conn.execute("SELECT COUNT(*),MIN(written_at) FROM scope_cache WHERE substr(cache_key,1,?)=?",
                                          (len(pfx),pfx)).fetchone())
        finally: conn.close()
    except sqlite3.Error:
        pass
    return out

def _with_extra_stdout(resp,text):
    """Ajoute `text` au stdout d'une réponse CommandResult (sans toucher au cache de réponses de run_borghelper)."""
    try: data=json.loads(resp.body)
    except ValueError: return resp
    data['stdout']=(data.get('stdout') or '')+text
    return JSONResponse(status_code=resp.status_code,content=data)

