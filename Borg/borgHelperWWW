# ── Préférences par abonné en JSON (spec-push-ui-prefs-json) ───────────────────
# Source de vérité UNIQUE des préférences (scope_nicks, notify_start, notify_end, expires_at), indexées
# par endpoint. push.db ne garde que les clés VAPID et endpoint/p256dh/auth ; ses colonnes de préférence
# sont conservées (jamais de migration destructive sur une base non reconstructible, AD-6) mais ne sont
# plus ni lues ni tenues à jour — seule la migration initiale ci-dessous les consulte, une fois.
PUSH_PREFS_FILE=os.environ.get('BORGHELPERWWW_PUSH_PREFS') or \
    os.path.join(os.path.dirname(os.path.abspath(PUSH_DB)),f"{_bh_paths.db.db_prefix}-push-prefs.json")
_PUSH_TS_FMT='%Y-%m-%d %H:%M:%S'  # même format que datetime('now') SQLite (UTC), comparable en chaîne

class PushPrefsError(Exception):
    """Fichier de préférences illisible/corrompu — jamais écrasé automatiquement (données utilisateur)."""

def _utc_now_str():
    return datetime.datetime.now(datetime.timezone.utc).strftime(_PUSH_TS_FMT)

def _expires_at_value(days):
    """`days` déjà résolu (None = « à vie », sinon entier >=1) -> expires_at (chaîne UTC) ou None."""
    if days is None: return None
    return (datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(days=int(days))).strftime(_PUSH_TS_FMT)

@contextlib.contextmanager
def _push_prefs_locked():
    """Verrou exclusif inter-processus (plusieurs workers uvicorn + watcher) autour de toute
    lecture-modification-écriture. Fichier .lock séparé : os.replace() remplace le fichier de données,
    un flock posé dessus ne survivrait pas au remplacement."""
    import fcntl
    fd=os.open(PUSH_PREFS_FILE+'.lock',os.O_RDWR|os.O_CREAT,0o600)
    try:
        fcntl.flock(fd,fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd,fcntl.LOCK_UN); os.close(fd)

def _push_prefs_load():
    """Lecture sans verrou possible (os.replace est atomique : on lit l'ancienne ou la nouvelle version,
    jamais un fichier à moitié écrit). Absent -> vide. Corrompu -> PushPrefsError, jamais « vide »
    (sinon la prochaine écriture effacerait silencieusement toutes les préférences)."""
    try:
        with open(PUSH_PREFS_FILE,encoding='utf-8') as f: data=json.load(f)
    except FileNotFoundError:
        return {'version':2,'subscriptions':{}}
    except (OSError,ValueError) as e:
        raise PushPrefsError(f"{PUSH_PREFS_FILE} illisible ou JSON invalide ({e}) — jamais écrasé "
                             "automatiquement : corriger ou restaurer ce fichier") from e
    if not isinstance(data,dict) or not isinstance(data.get('subscriptions'),dict):
        raise PushPrefsError(f"{PUSH_PREFS_FILE} : structure inattendue (attendu "
                             "{\"subscriptions\": {endpoint: {...}}}) — jamais écrasé automatiquement")
    return data

def _push_prefs_save(data):
    """Écriture atomique : fichier temporaire (mkstemp -> 0600) dans le MÊME répertoire, fsync, puis
    os.replace — un lecteur concurrent ne voit jamais un JSON tronqué."""
    import tempfile
    fd,tmp=tempfile.mkstemp(prefix='.push-prefs-',suffix='.tmp',dir=os.path.dirname(PUSH_PREFS_FILE) or '.')
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            json.dump(data,f,ensure_ascii=False,indent=2,sort_keys=True); f.write('\n')
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp,PUSH_PREFS_FILE)
    except BaseException:
        with contextlib.suppress(OSError): os.unlink(tmp)
        raise

def _push_prefs_update(fn):
    """Lecture-modification-écriture sous verrou : `fn(subscriptions)` modifie le dict en place et peut
    retourner une valeur (retransmise). Une exception levée par `fn` annule l'écriture."""
    with _push_prefs_locked():
        data=_push_prefs_load()
        result=fn(data['subscriptions'])
        data['version']=2
        _push_prefs_save(data)
        return result

# Types de notification, réglables PAR HOST (borgHelperWWW 1.21.0) : début de sauvegarde, fin en succès,
# fin en échec (Bkp en erreur, ou bloqué au-delà de BKP_STATUS_TIMEOUT — AD-7).
_PUSH_KINDS=('start','success','error')
_PUSH_DEFAULT_HOST={'start':False,'success':True,'error':True}

def _prefs_entry(raw):
    """Normalise une entrée (le fichier est éditable à la main) : jamais de crash sur une clé absente ou
    mal typée. Fail-closed : scope_nicks invalide -> [] (aucune notification) ; expires_at non nul mais
    illisible -> considéré expiré, jamais « à vie » par accident. expires_at null/absent = « à vie ».

    `hosts` (format 2, 1.21.0) : {nick: {start,success,error}} — uniquement pour les nicks de
    `scope_nicks` (périmètre figé à l'abonnement, AD-4 : un host ajouté à la main hors de ce périmètre
    est ignoré) ; host du périmètre absent de `hosts`, ou valeur non booléenne -> False (rien envoyé).
    Entrée au format 1 (sans clé `hosts` : notify_start/notify_end globaux, abonnements < 1.21.0) ->
    convertie à la lecture : start=notify_start, success=error=notify_end, pour chaque nick."""
    e=raw if isinstance(raw,dict) else {}
    nicks=e.get('scope_nicks')
    nicks=[n for n in nicks if isinstance(n,str)] if isinstance(nicks,list) else []
    exp=e.get('expires_at')
    if exp is not None:
        try: datetime.datetime.strptime(exp,_PUSH_TS_FMT)
        except (TypeError,ValueError): exp='1970-01-01 00:00:00'
    hosts={}
    if 'hosts' not in e:
        end=e.get('notify_end',True) is True
        for n in nicks: hosts[n]={'start':e.get('notify_start') is True,'success':end,'error':end}
    else:
        raw_hosts=e['hosts'] if isinstance(e['hosts'],dict) else {}
        for n in nicks:
            h=raw_hosts.get(n); h=h if isinstance(h,dict) else {}
            hosts[n]={k:h.get(k) is True for k in _PUSH_KINDS}
    return {'scope_nicks':nicks,'hosts':hosts,'expires_at':exp,
            'updated_at':e.get('updated_at') if isinstance(e.get('updated_at'),str) else None}

def _push_sub_dict(row,raw_prefs):
    """Vue API d'un abonnement : identité/clés depuis push.db, préférences depuis le fichier JSON.
    `prefs_missing` : endpoint connu de push.db sans entrée dans le fichier (fichier supprimé/édité) —
    aucune notification ne part alors (scope_nicks vide), un réabonnement (POST) la recrée."""
    p=_prefs_entry(raw_prefs)
    return {'id':row['id'],'endpoint':row['endpoint'],'scope_nicks':p['scope_nicks'],
            'hosts':p['hosts'],'expires_at':p['expires_at'],
            'created_at':row['created_at'],'updated_at':p['updated_at'],'prefs_missing':raw_prefs is None}

def _migrate_push_prefs_from_db():
    """Une seule fois : fichier JSON absent -> exporte les préférences encore stockées dans les colonnes
    de push.db (abonnements créés avant borgHelperWWW 1.19.0). Re-vérifie l'existence sous verrou
    (deux workers uvicorn démarrant ensemble). Crée le fichier même vide : il devient visible pour
    l'admin dès le premier démarrage."""
    if os.path.exists(PUSH_PREFS_FILE): return
    with _push_prefs_locked():
        if os.path.exists(PUSH_PREFS_FILE): return
        conn=_push_conn('read')
        try:
            rows=conn.execute("SELECT endpoint,scope_nicks,notify_start,notify_end,expires_at "
                              "FROM push_subscriptions").fetchall()
        finally:
            conn.close()
        subs={}
        for r in rows:
            try: nicks=json.loads(r['scope_nicks'])
            except (TypeError,ValueError): nicks=[]
            subs[r['endpoint']]={'scope_nicks':nicks if isinstance(nicks,list) else [],
                                 'notify_start':bool(r['notify_start']),'notify_end':bool(r['notify_end']),
                                 'expires_at':r['expires_at'],'updated_at':_utc_now_str()}
        _push_prefs_save({'version':1,'subscriptions':subs})
        if subs:
            print(f"[push] préférences de {len(subs)} abonnement(s) migrées de push.db vers "
                  f"{PUSH_PREFS_FILE}",file=sys.stderr,flush=True)

try:
    _migrate_push_prefs_from_db()
except (OSError,sqlite3.Error) as _e:
    # Fonctionnalité optionnelle : jamais un crash de tout borgHelperWWW pour elle — les routes /push/*
    # remonteront l'erreur explicitement au premier usage.
    print(f"[WARN] préférences push : migration/création de {PUSH_PREFS_FILE} impossible ({_e})",
          file=sys.stderr,flush=True)

# ── Envoi push réel (Story 2b, spec-notifications-push) ────────────────────────
# Remplace la simple journalisation de la Story 1 : chaque réclamation CAS gagnée (début OU fin)
# déclenche ici un envoi `pywebpush` réel à chaque abonnement matché — jamais de retry par
# abonnement (voir Design Notes du spec : la ligne bkp_status est déjà réclamée, elle ne sera
# jamais revisitée, quel que soit le sort de chaque envoi individuel).

def _push_delete_endpoint(endpoint):
    """Désabonnement (DELETE /push/subscribe, ou endpoint mort côté navigateur 404/410 via le
    watcher) : ligne push.db D'ABORD (plus aucun envoi possible, quel que soit l'état du fichier de
    préférences), puis entrée du fichier JSON. True si l'un des deux contenait l'endpoint. Peut lever
    sqlite3.Error ou PushPrefsError — à l'appelant de décider (500 explicite en route, log au watcher)."""
    conn=_push_conn('write')
    try:
        cur=conn.execute("DELETE FROM push_subscriptions WHERE endpoint=?",(endpoint,))
        conn.commit()
        db_deleted=cur.rowcount>0
    finally:
        conn.close()
    prefs_deleted=_push_prefs_update(lambda subs: subs.pop(endpoint,None) is not None)
    return db_deleted or prefs_deleted

def _push_subscriptions_for(nick,kind):
    """Abonnements à notifier pour cet événement : entrée du fichier JSON avec le type `kind`
    ('start'|'success'|'error') actif POUR CE HOST (`hosts[nick][kind]`, jamais un réglage global),
    non expirée (expires_at null = « à vie », sinon comparée en chaîne au format UTC commun) — puis
    clés p256dh/auth lues dans push.db pour ces seuls endpoints (un endpoint sans ligne push.db est
    ignoré). `hosts` ne contient que des nicks de scope_nicks (voir _prefs_entry)."""
    assert kind in _PUSH_KINDS
    now=_utc_now_str()
    wanted=[]
    for ep,raw in _push_prefs_load()['subscriptions'].items():
        p=_prefs_entry(raw)
        if p['hosts'].get(nick,{}).get(kind) and (p['expires_at'] is None or p['expires_at']>now):
            wanted.append(ep)
    if not wanted: return []
    conn=_push_conn('read')
    try:
        return conn.execute(f"SELECT * FROM push_subscriptions WHERE endpoint IN ({','.join('?'*len(wanted))})",
                            wanted).fetchall()
    finally:
        conn.close()

def _send_bkp_push(nick,event,result):
    """Envoie un push réel à chaque abonnement matché pour cet événement (`event`: 'start'|'end',
    `result`: None pour un début, 'success'/'error' pour une fin). Erreur définitive (404/410,
    abonnement mort côté navigateur) -> désabonnement automatique ; toute autre erreur (réseau,
    autre code HTTP, exception non-WebPushException) -> journalisée seule, abonnement conservé,
    jamais de retry (voir Design Notes du spec — la ligne bkp_status est déjà réclamée par CAS)."""
    if not _PYWEBPUSH_AVAILABLE or PUSH_VAPID_PRIVATE_KEY is None:
        return  # dépendance optionnelle (pywebpush/py_vapid) absente — voir avertissement au démarrage
    # Toute fin autre qu'un succès (erreur, timeout AD-7) est un échec — type 'error'.
    kind='start' if event=='start' else ('success' if result=='success' else 'error')
    try:
        subs=_push_subscriptions_for(nick,kind)
    except (sqlite3.Error,PushPrefsError) as e:
        print(f"[watcher] push: erreur lecture abonnements nick={nick} : {e}",file=sys.stderr,flush=True)
        return
    if not subs: return
    payload=json.dumps({'nick':nick,'event':event,'result':result,
                         'timestamp':datetime.datetime.now(datetime.timezone.utc).isoformat()})
    for row in subs:
        endpoint=row['endpoint']
        subscription_info={'endpoint':endpoint,'keys':{'p256dh':row['p256dh'],'auth':row['auth']}}
        try:
            webpush(subscription_info=subscription_info,data=payload,
                    vapid_private_key=PUSH_VAPID_PRIVATE_KEY,
                    vapid_claims={'sub':PUSH_VAPID_SUB},
                    timeout=PUSH_SEND_TIMEOUT,ttl=PUSH_TTL_BKP)
        except WebPushException as e:
            if e.status_code in (404,410):
                # Revue de code : sqlite3.Error ici (DB verrouillée, etc.) ne doit jamais faire
                # sortir cette boucle en levant — les abonnements suivants de CE nick, et le passage
                # de début/fin restant pour ce nick dans _bkp_status_watcher_pass, doivent continuer.
                try:
                    _push_delete_endpoint(endpoint)
                    print(f"[watcher] push: abonnement mort désabonné (status={e.status_code}) "
                          f"nick={nick} event={event}",file=sys.stderr,flush=True)
                except (sqlite3.Error,PushPrefsError,OSError) as de:
                    print(f"[watcher] push: échec désabonnement (status={e.status_code}) "
                          f"nick={nick} event={event} : {de}",file=sys.stderr,flush=True)
            else:
                print(f"[watcher] push: échec envoi (status={e.status_code}) nick={nick} "
                      f"event={event} : {e}",file=sys.stderr,flush=True)
        except Exception as e:
            # Réseau/autre — jamais de désabonnement, jamais de retry pour cet événement précis.
            print(f"[watcher] push: erreur envoi nick={nick} event={event} : {e}",file=sys.stderr,flush=True)

def _scope_nicks_for_groups(user_groups,nick_cfgs):
    """Cœur pur de _current_scope_nicks, sans dépendance à Request ni à cfgread() — testable
    directement par push_selftest() avec des `cfg` synthétiques (voir plus bas), ce que la fonction
    Request-only ne permettait pas (d'où cette branche eff>=1 jamais réellement exercée par aucun
    test). `nick_cfgs` : itérable de `(nick, cfg)`, `cfg` étant un SectionProxy .borghelperrc[nick]
    (ou tout dict-like équivalent exposant `.get(clé, défaut)`, ex. un dict simple en test) ou None
    si le nick n'existe pas. Retourne la liste des nicks où `user_groups` a au moins un accès en
    lecture (eff>=1, via _effective_level)."""
    result=[]
    for n,cfg in nick_cfgs:
        eff=_effective_level(user_groups,cfg) if cfg is not None else 0
        if eff>=1: result.append(n)
    return result

def _current_scope_nicks(request: Request):
    """Périmètre RBAC figé à la souscription (AD-4) — même mécanisme que GET /access
    (`_effective_level`/`_parse_groups`/`_nick_list('ALL')`) : tout nick où l'appelant a au moins un
    accès en lecture (eff>=1). GROUPS_HEADER désactivé (autorisation par groupes éteinte) -> tous les
    nicks connus, cohérent avec /access qui reflète alors 'admin'/illimité partout. Boucle eff>=1
    elle-même déléguée à _scope_nicks_for_groups (voir sa docstring — extraite pour rester testable
    sans Request réelle)."""
    nicks=_nick_list('ALL')
    if not GROUPS_HEADER: return nicks
    user_groups=_parse_groups(request.headers.get(GROUPS_HEADER))
    return _scope_nicks_for_groups(user_groups,((n,_bh_paths.borg.cfgread(n)) for n in nicks))

def _scope_signature(scope):
    """AD-5 : signature canonique et univoque d'un périmètre déjà résolu/canonicalisé par
    `_canonicalize_scope`/`_resolve_path_scope` (trié, dédoublonné, préfixes redondants éliminés
    — jamais réimplémenté ici, seulement sérialisé) via `json.dumps` (jamais un simple
    `','.join`, un chemin pouvant contenir une virgule). `scope=None` (illimité) -> sentinel
    distinct et non falsifiable `'*'`, jamais une chaîne vide — un `json.dumps` d'une liste
    produit toujours une chaîne commençant par '[', donc `'*'` ne peut jamais entrer en
    collision avec un périmètre réel, quel qu'il soit. Un appelant totalement illimité sur un
    nick unique ne passe normalement jamais par ce cache (servi par `_RESPONSE_CACHE`), mais un
    nick peut être illimité tout en partageant une requête multi-nick avec un nick scopé — le
    sentinel doit donc exister et fonctionner dans les deux cas."""
    if scope is None: return '*'
    return json.dumps(scope,ensure_ascii=False,sort_keys=True)

def _scope_cache_key(nick,cmd,params,scope_signature):
    """Sérialise (nick, commande, paramètres, signature_périmètre) en une clé de ligne unique et
    déterministe. `params` est un dict simple (valeurs JSON-sérialisables) construit par chaque
    endpoint avec tout ce qui, en plus de nick/commande/périmètre, fait varier le résultat filtré
    (y compris les paramètres qui ne sont utilisés que pour le recalcul local DuIdx/IdxTop/
    DiffTop et ne sont jamais passés à borgHelper en sous-processus, ex. depth/topn/sort)."""
    return json.dumps([nick,cmd,params,scope_signature],ensure_ascii=False,sort_keys=True)

# ── Chiffrement par ligne de scopecache.db (Story 4, AD-9) ──────────────────────────────────────
# scopecache.db reste elle-même non chiffrée au niveau base (AD-9/Design Notes du spec 4) : seule
# la colonne result_json est chiffrée, avec la DEK du nick PROPRIÉTAIRE de la ligne (jamais celle
# de l'appelant), obtenue en ouvrant le diff.db de ce nick via le point d'ouverture unique
# `_open_db` (AD-1) — jamais une seconde implémentation du déchiffrement.
_NICK_CODEC_MEMO={}          # (nick, empreinte de passphrase) -> DbCodec | None | _CACHE_LOCKED
_NICK_CODEC_MEMO_MAX=256     # borné, mémoire du processus uniquement, jamais persisté (Boundaries)
_CACHE_LOCKED=object()       # sentinel : nick chiffré mais passphrase absente/incorrecte pour CE nick
_MEMO_MISS=object()          # sentinel local : distingue "pas encore mémoïsé" de "mémoïsé à None"

def _nick_owner_codec(nick):
    """DbCodec du diff.db du nick propriétaire d'une ligne de scopecache.db, ou None si ce nick est
    en clair (pas de diff.db, ou diff.db sans enc_header — comportement actuel, ligne non
    chiffrée), ou le sentinel `_CACHE_LOCKED` si ce nick est chiffré mais que sa passphrase
    (résolue depuis la config serveur, comme pour toute ouverture borgHelper de ce nick) est
    absente ou incorrecte — dans ce dernier cas l'appelant ne doit ni lire ni écrire de ligne de
    cache pour ce nick (jamais d'erreur visible, jamais de lecture erronée). Mémoïsé par
    (nick, empreinte de passphrase) en mémoire du processus WWW, jamais persisté sur disque."""
    diff_db=_bh_paths.db.get_diff_db(nick)
    if not os.path.exists(diff_db): return None  # jamais indexé : rien à ouvrir (AD-12)
    try:
        cfg=_bh_paths.borg.cfgread(nick)
    except (configparser.Error,OSError):
        cfg=None  # rc absent/section manquante/erreur de lecture attendue : passphrase absente, silencieux
    except Exception as e:
        # Toute autre exception ici est INATTENDUE (cfgread ne devrait lever ni configparser.Error ni
        # OSError autre) — dégrade quand même en "passphrase absente" (jamais une erreur visible pour
        # l'appelant, Boundaries), mais avec une trace distincte pour qu'un opérateur ne confonde pas
        # une vraie mauvaise config avec un simple nick verrouillé.
        cfg=None
        print(f"[WARN] _nick_owner_codec({nick!r}): cfgread a levé {type(e).__name__}: {e} — traité comme passphrase absente",file=sys.stderr)
    pw=cfg.get('BORG_PASSPHRASE') if cfg else None
    ck=(nick,hashlib.sha256((pw or '').encode('utf-8','surrogateescape')).hexdigest())
    cached=_NICK_CODEC_MEMO.get(ck,_MEMO_MISS)
    if cached is not _MEMO_MISS: return cached
    conn=None
    try:
        conn=_open_db(diff_db,nick=nick,role='read',passphrase=pw)
        result=conn.codec  # None (base plain) ou DbCodec (siv1 + passphrase correcte)
    except (DbKeyError,DbTamperError,DbCodecError,sqlite3.Error):
        result=_CACHE_LOCKED
    finally:
        # Séparé de la capture d'erreur ci-dessus : un échec de close() après une ouverture réussie ne
        # doit jamais faire passer un codec valide pour _CACHE_LOCKED (mémoïsé, donc collant sinon).
        if conn is not None:
            try: conn.close()
            except sqlite3.Error: pass
    if len(_NICK_CODEC_MEMO)>=_NICK_CODEC_MEMO_MAX: _NICK_CODEC_MEMO.clear()
    _NICK_CODEC_MEMO[ck]=result
    return result

def _scope_cache_get(nick,cmd,params,scope_signature,fingerprint):
    """Retourne le CommandResult (dict) en cache pour (nick, cmd, params, scope_signature) si son
    empreinte stockée correspond exactement à `fingerprint` (hit frais) ; None sinon (absent ou
    périmé — l'appelant retombe alors sur le chemin borgHelper existant, jamais pire qu'avant
    cette story). Ce cache est une pure optimisation : toute erreur SQLite (contention, corruption)
    ou ligne stockée corrompue (`json.loads` échoue) est traitée comme un miss, jamais propagée —
    une requête déjà calculable avant cette story ne doit jamais échouer à cause de ce cache.
    Story 4/AD-9 : si le nick propriétaire de la ligne est chiffré mais verrouillé (passphrase
    absente/incorrecte pour LUI), traité comme un miss — jamais une lecture erronée. Une ligne
    chiffrée illisible (MAC invalide, `DbCodecError`) est aussi un miss, jamais une exception."""
    codec=_nick_owner_codec(nick)
    if codec is _CACHE_LOCKED: return None
    key=_scope_cache_key(nick,cmd,params,scope_signature)
    try:
        conn=_open_db(SCOPE_CACHE_DB,nick=None,role='read')
        try:
            row=conn.execute("SELECT fingerprint,result_json FROM scope_cache WHERE cache_key=?",(key,)).fetchone()
        finally:
            conn.close()
    except sqlite3.Error:
        return None
    if row is None or row[0]!=fingerprint: return None
    payload=row[1]
    if codec is not None:
        try: payload=codec.blob.decrypt(payload)
        except DbCodecError: return None  # ligne illisible = cache miss (AD-9), jamais une erreur
    try:
        return json.loads(payload)
    except ValueError:
        return None

def _scope_cache_put(nick,cmd,params,scope_signature,fingerprint,result_dict):
    """Écrit/rafraîchit une ligne. Garde-fou anti-croissance : miroir exact de la politique brutale
    de `_RESPONSE_CACHE` (`DELETE FROM scope_cache` entièrement si plus de 500 lignes déjà
    présentes) — pas de LRU, cohérence plutôt que sophistication (Boundaries). Le compte-vérifie-
    purge-puis-insère tourne dans une seule transaction (`BEGIN IMMEDIATE`) : `SCOPE_CACHE_DB` peut
    être partagé entre plusieurs workers (--workers), contrairement à `_RESPONSE_CACHE` en mémoire —
    sans ça deux writers concurrents pourraient tous deux observer >500 lignes et purger chacun leur
    tour. Pure optimisation : toute erreur SQLite est avalée, jamais propagée — la réponse a déjà
    été calculée et doit être retournée à l'appelant quoi qu'il arrive ici.
    Story 4/AD-9 : `result_json` est chiffré avec la DEK du nick PROPRIÉTAIRE (`nick`, jamais celle
    d'un autre nick d'une requête multi-nick). Nick chiffré mais verrouillé (passphrase absente/
    incorrecte pour lui) : aucune écriture pour cette ligne, jamais d'erreur visible."""
    codec=_nick_owner_codec(nick)
    if codec is _CACHE_LOCKED: return  # jamais de mise en cache pour cette ligne (Boundaries)
    key=_scope_cache_key(nick,cmd,params,scope_signature)
    payload=json.dumps(result_dict,ensure_ascii=False)
    if codec is not None: payload=codec.blob.encrypt(payload)
    try:
        conn=_open_db(SCOPE_CACHE_DB,nick=None,role='write')
        try:
            conn.execute("BEGIN IMMEDIATE")
            count=conn.execute("SELECT COUNT(*) FROM scope_cache").fetchone()[0]
            if count>500: conn.execute("DELETE FROM scope_cache")
            conn.execute("INSERT OR REPLACE INTO scope_cache (cache_key,fingerprint,result_json,written_at) "
                         "VALUES (?,?,?,datetime('now'))",(key,fingerprint,payload))
            conn.commit()
        finally:
            conn.close()
    except sqlite3.Error:
        pass

def _capture_fingerprints(nick):
    """AD-5, garde-fou TOCTOU : DOIT être appelée en tout premier, juste après `require_api_key`,
    strictement avant que `_resolve_scopes_for_request()`/`_resolve_single_scope()` ne résolvent
    GROUPS_PATHS pour la requête courante — jamais après (capturer après ouvrirait la fenêtre
    TOCTOU que cette story existe à fermer : un .borghelperrc modifié entre la résolution du
    périmètre et la capture d'empreinte pourrait faire apparaître comme "frais" un résultat
    filtré sous l'ancien périmètre, désormais trop permissif).

    Retourne {nick_réel: empreinte} pour chaque nick réel contenu dans `nick` (déjà déplié via
    `_nick_list` — une simple opération de chaîne/lecture de la liste des nicks connus, sans
    aucune logique RBAC/périmètre, donc sans risque à appeler ici avant la résolution de
    périmètre). Empreinte = mtimes cache.db/diff.db de CE nick (`_cache_fingerprint`, même
    convention que `_RESPONSE_CACHE`) + mtime de .borghelperrc (un GROUPS_PATHS resserré/relâché
    doit invalider le cache même s'il ne touche ni cache.db ni diff.db) — une par nick réel, pour
    qu'un backup/index sur un seul nick n'invalide que la ligne de CE nick (I/O matrix)."""
    if not GROUPS_HEADER: return {}
    try: cfg_mtime=os.path.getmtime(CFGFILE)
    except OSError: cfg_mtime='absent'
    return {n:f"{_cache_fingerprint(n)}|cfgfile:{cfg_mtime}" for n in _nick_list(nick)}

def _build_borghelper_argv_env(cmd: str, nick: Optional[str], extra_args, passphrase: Optional[str]=None):
    """argv/env communs à tout lancement de borgHelper en sous-processus — factorisé pour être
    partagé entre `_exec_borghelper` (attend le résultat) et `_launch_bkp_detached` (AD-2, ne
    l'attend jamais)."""
    argv=[sys.executable,str(BORGHELPER_BIN),'-C',CFGFILE,'-c',cmd]
    if nick: argv+=['-n',nick]
    argv+=list(extra_args)
    env=os.environ.copy()
    if passphrase: env['BORGHELPERC_RUNTIME_PASSPHRASE']=passphrase
    return argv,env

def _exec_borghelper(cmd: str, nick: Optional[str], extra_args, passphrase: Optional[str]=None) -> CommandResult:
    """Sous-processus borgHelper brut, sans cache ni encapsulation JSONResponse — factorisé hors de
    `run_borghelper()` pour être réutilisé tel quel par `_run_scoped()` (Story 1.3), qui a besoin du
    `stdout` brut avant de le filtrer et ne doit jamais passer par `_RESPONSE_CACHE` (Boundaries du
    spec 1.3 : le cache reste réservé au cas non restreint)."""
    argv,env=_build_borghelper_argv_env(cmd,nick,extra_args,passphrase)
    try:
        proc=subprocess.run(argv,capture_output=True,text=True,timeout=TIMEOUT,env=env)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail=f"Commande {cmd} : timeout après {TIMEOUT}s")
    return CommandResult(exitcode=proc.returncode,stdout=proc.stdout,stderr=proc.stderr)

def _launch_bkp_detached(nick: str, extra_args, passphrase: Optional[str]=None) -> int:
    """Lance `borgHelper -c Bkp` en sous-processus détaché (AD-2) : jamais attendu par la requête
    HTTP — le résultat réel est capté par `bkp_status` (borgHelper) et réclamé par le watcher, pas
    par le stdout/stderr/exitcode de ce sous-processus (jamais lus ici, `DEVNULL`).
    `start_new_session=True` : le sous-processus survit à un redémarrage de borgHelperWWW pendant la
    sauvegarde (AD-2) — sans ça, un redémarrage pendant un Bkp le tuerait avec le worker parent."""
    argv,env=_build_borghelper_argv_env('bkp',nick,extra_args,passphrase)
    proc=subprocess.Popen(argv,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,stdin=subprocess.DEVNULL,
                           env=env,start_new_session=True)
    return proc.pid

def run_borghelper(cmd: str, nick: Optional[str]=None, extra_args=(), passphrase: Optional[str]=None,
                    cacheable: bool=False) -> JSONResponse:
    pw_digest=_passphrase_digest(passphrase) if cacheable else None
    key=((cmd,nick,tuple(extra_args),pw_digest) if pw_digest is not None else (cmd,nick,tuple(extra_args))) \
        if cacheable else None
    if key is not None:
        cached=_RESPONSE_CACHE.get(key)
        if cached is not None and cached[0]==_cache_fingerprint(nick):
            result_dict=cached[1]
            return JSONResponse(status_code=200 if result_dict['exitcode']==0 else 400,content=result_dict)
    result=_exec_borghelper(cmd,nick,extra_args,passphrase)
    if key is not None and not _is_db_key_error(result):
        if len(_RESPONSE_CACHE)>500: _RESPONSE_CACHE.clear()  # garde-fou anti-croissance illimitée
        _RESPONSE_CACHE[key]=(_cache_fingerprint(nick),result.dict())
    return JSONResponse(status_code=200 if result.exitcode==0 else 400,content=result.dict())

# ── Filtrage a posteriori par périmètre (Story 1.3) ─────────────────────────
# _run_scoped() : variante non-cacheable de run_borghelper() pour les 6 routes Search/FileHist/
# LstBkpFls/DiffBkp/TreeHist/TreeFind quand au moins un nick de la requête porte un périmètre
# restreint (_any_scoped()). Force -j (si absent), parse le JSON renvoyé par borgHelper, applique
# une des fonctions _filter_* ci-dessous, ré-sérialise dans `stdout`. Jamais mis en
# `_RESPONSE_CACHE` : deux périmètres différents ne doivent jamais partager une réponse en cache
# (voir ARCHITECTURE-SPINE.md AD-5 — le cache dédié par périmètre est Story 1.5, pas celui-ci).

def _run_scoped(cmd: str, nick: str, extra_args, filter_fn, passphrase: Optional[str]=None) -> JSONResponse:
    args=list(extra_args)
    if '-j' not in args: args=args+['-j']
    result=_exec_borghelper(cmd,nick,args,passphrase)
    if result.exitcode==0:
        try:
            parsed=json.loads(result.stdout)
            result.stdout=json.dumps(filter_fn(parsed),ensure_ascii=False,indent=2)
        except ValueError:
            # stdout non-JSON malgré -j : ne devrait jamais arriver, mais un appelant a un périmètre
            # restreint ici — fail-closed (jamais relayer du stdout non filtré), pas fail-open.
            result.exitcode=1; result.stdout=''; result.stderr=(result.stderr or '')+"\n[borgHelperWWW] réponse non-JSON reçue pour un appelant à périmètre restreint — requête refusée."
    return JSONResponse(status_code=200 if result.exitcode==0 else 400,content=result.dict())

def _filter_per_nick_list(results,scopes,path_key='path'):
    """Search : `results` = {nick: [{...,path_key:...}, ...] | {'error':msg}}. Filtre chaque liste
    par le périmètre de SON nick ; laisse les `{'error':...}` intacts (rien à filtrer)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        out[n]=[row for row in val if _path_in_scope(row.get(path_key,''),scopes.get(n))] if isinstance(val,list) else val
    return out

def _filter_filehist(results,path,scopes):
    """FileHist : mêmes formes que Search mais chaque ligne n'a PAS de champ path (c'est le `path`
    demandé, un seul par requête, implicite pour toutes les lignes d'un nick) — donc pas de
    filtrage ligne par ligne : soit le `path` demandé est dans le périmètre du nick (liste
    inchangée), soit il ne l'est pas (liste vidée pour ce nick — même défaut non-glamour que
    TreeHist/TreeFind sur un préfixe hors périmètre, voir Design Notes du spec 1.3)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        out[n]=(val if _path_in_scope(path,scopes.get(n)) else []) if isinstance(val,list) else val
    return out

def _filter_str_list(d,scope,key):
    """LstBkpFls : `d` = {'nick':...,'archive':...,'files':[chemin,...]} | {'error':msg} — pas de
    dict par nick (route mono-nick), `files` est une liste de chemins bruts (pas de dict par ligne)."""
    if isinstance(d,dict) and key in d:
        d=dict(d); d[key]=[s for s in d[key] if _path_in_scope(s,scope)]
    return d

def _filter_diffbkp(result,scope):
    """DiffBkp : `result` = {'archive_old','archive_new','entries':[{...,'path':...}],'n_add','n_rem',
    'n_mod'} | {'error':msg} — route mono-nick. Filtre `entries` par `path` puis RECALCULE
    n_add/n_rem/n_mod à partir des entrées filtrées (Boundaries du spec 1.3 / FR8 : jamais transmis
    depuis le compte non filtré) avec la même formule que `borgHelper.diffbkp()` : n_add = compte
    `change_type=='added'`, n_rem = compte `'removed'`, n_mod = reste."""
    if isinstance(result,dict) and 'entries' in result:
        result=dict(result)
        entries=[e for e in result['entries'] if _path_in_scope(e.get('path',''),scope)]
        n_add=sum(1 for e in entries if e['change_type']=='added')
        n_rem=sum(1 for e in entries if e['change_type']=='removed')
        result['entries']=entries; result['n_add']=n_add; result['n_rem']=n_rem; result['n_mod']=len(entries)-n_add-n_rem
    return result

def _filter_per_nick_listkey(results,scopes,list_key,item_path_key='full_path'):
    """TreeHist (`list_key='entries'`) / TreeFind (`list_key='matches'`) : `results` = {nick:
    {...,list_key:[{...,item_path_key:...},...]} | {'error':msg}}. Filtre la liste imbriquée par le
    périmètre de SON nick, sur `full_path` (jamais `name`, qui n'est que le nom de base — Boundaries
    du spec 1.3). Pour TreeHist, l'entrée '.' (le préfixe demandé lui-même) est filtrée comme les
    autres : un préfixe hors périmètre vide donc naturellement le résultat, sans cas particulier.
    ⚠️ Ne pas confondre le `list_key`/`item_path_key` RBAC ici avec la clé JSON `'scope'` que
    TreeFind utilise pour son propre préfixe de recherche (sans rapport, voir Design Notes)."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        if isinstance(val,dict) and list_key in val:
            val=dict(val)
            val[list_key]=[item for item in val[list_key] if _path_in_scope(item.get(item_path_key,''),scopes.get(n))]
        out[n]=val
    return out

def _path_is_scope_ancestor(path,scope):
    """True si `path` est un répertoire PARENT strict d'au moins un préfixe de `scope` (ex. 'opt' et
    'opt/backups' pour le périmètre ['/opt/backups/mysql']) — jamais un chemin dans le périmètre
    lui-même (voir `_path_in_scope`), jamais un simple préfixe de chaîne ('op' n'est pas parent de
    'opt/...'). `scope=None` -> False (illimité : rien à rendre navigable en plus). Même
    normalisation du '/' initial que `_path_in_scope`."""
    if scope is None: return False
    path=(path or '').strip('/')
    for prefix in scope:
        p=prefix.strip('/')
        if not p: continue
        if path=='' or p.startswith(path+'/'): return True
    return False

def _filter_treehist(results,scopes):
    """TreeHist (navigation de l'UI) : comme `_filter_per_nick_listkey(...,'entries')`, mais garde
    aussi les répertoires PARENTS du périmètre (`_path_is_scope_ancestor`), sinon un appelant borné
    à '/opt/backups/mysql' voit une racine vide et ne peut jamais descendre jusqu'à son périmètre.
    Un parent est réduit à une entrée de navigation nue : nom/chemin/is_dir seulement — droits,
    propriétaire, historique (`events`) et marque de suppression retirés (ces métadonnées décrivent
    un objet HORS périmètre ; `events` d'un répertoire agrège en plus les mouvements de toute sa
    sous-arborescence, donc de fichiers hors périmètre). Réservé à TreeHist : Search/TreeFind/
    rapports/restauration gardent le filtrage strict."""
    if not isinstance(results,dict): return results
    out={}
    for n,val in results.items():
        scope=scopes.get(n)
        if isinstance(val,dict) and 'entries' in val:
            val=dict(val); kept=[]
            for item in val['entries']:
                fp=item.get('full_path') or ''
                if _path_in_scope(fp,scope): kept.append(item)
                elif _path_is_scope_ancestor(fp,scope):
                    kept.append({'name':item.get('name'),'full_path':item.get('full_path'),'genre':'répertoire',
                        'mode':None,'owner':None,'is_dir':True,'events':[],'scope_ancestor':True})
            val['entries']=kept
        out[n]=val
    return out

# ── Filtrage a posteriori DuIdx/IdxTop/DiffTop (Story 1.4) ──────────────────
# Contrairement à Search/FileHist/LstBkpFls/DiffBkp/TreeHist/TreeFind (Story 1.3), ces trois
# commandes groupent/agrègent déjà en Python (voire en SQL, pour DuIdx) AVANT de produire leur JSON
# existant — filtrer ce JSON après coup serait incorrect (une frontière de périmètre peut tomber au
# milieu d'un groupe déjà constitué, Intent du spec 1.4). borgHelper expose donc un mode BRUT,
# ungroupé, par-chemin : `-R` pour DuIdx (dont le `-j` existant reste le mode groupé historique,
# byte-identique, jamais touché ici) ; `-j` pour IdxTop/DiffTop, qui n'avaient aucun mode JSON avant
# cette story. Les fonctions ci-dessous filtrent ces lignes brutes par périmètre PUIS reproduisent —
# en miroir ligne-à-ligne de borgHelper au moment de l'écriture, jamais une réécriture "propre" — le
# regroupement/tri/top-N que borgHelper applique lui-même (Design Notes du spec 1.4 : garder ce
# mirroring littéral rend le contrôle de dérive tractable — diff les deux copies, jamais raisonner
# sur une équivalence comportementale).
#
# DuIdx/IdxTop/DiffTop sont traités comme mono-nick pour le périmètre (comme LstBkpFls/DiffBkp en
# Story 1.3) : jamais de filtrage/ré-agrégation multi-nick construit ici. `nick=ALL`/liste chez un
# appelant scopé est refusé proprement (fail-closed, aucune donnée) plutôt que de tenter un
# regroupement inter-nicks que cette story ne construit pas.

def _resolve_single_scope(request,nick):
    """`nick` développé via `_nick_list()` AVANT toute résolution de périmètre — jamais un
    `cfgread('ALL')` direct, qui reviendrait à tort « illimité » (même piège que le Groupe A du
    Triage Log de Story 1.3, pour `nick=ALL` avec un défaut de route). Retourne (None,None) si
    l'appelant est illimité sur toute la liste (byte-identique à avant cette story, y compris pour
    `nick=ALL`/multi-nick tel quel). Retourne (nick_unique, scope) si l'appelant est scopé et que la
    requête ne porte que sur un seul nick réel. Lève HTTPException(400) si scopé + plusieurs nicks —
    fail-closed, jamais de filtrage multi-nick approximatif ici."""
    nicks=list(dict.fromkeys(_nick_list(nick)))
    scopes=_resolve_scopes_for_request(request,nicks)
    if not _any_scoped(scopes):
        return None,None
    if len(nicks)!=1:
        raise HTTPException(400,detail="nick=ALL / plusieurs nicks non supporté pour un appelant à "
            "périmètre restreint sur cette route")
    return nicks[0],scopes[nicks[0]]

def _run_scoped_raw(cmd,nick,extra_args,raw_flag,filter_fn,passphrase=None):
    """Variante de `_run_scoped()` (Story 1.3) pour DuIdx/IdxTop/DiffTop : force `raw_flag` (mode brut
    par-chemin) au lieu du `-j` générique de `_run_scoped()` — DuIdx a besoin de `-R` spécifiquement
    puisque son `-j` existant reste le mode groupé historique. `filter_fn` reçoit le JSON brut parsé,
    filtre par périmètre PUIS ré-agrège/re-classe (jamais l'inverse — Boundaries du spec 1.4 / AD-2).
    Jamais mis en `_RESPONSE_CACHE` (même règle que `_run_scoped()`, AD-5)."""
    args=list(extra_args)
    if raw_flag not in args: args=args+[raw_flag]
    result=_exec_borghelper(cmd,nick,args,passphrase)
    if result.exitcode==0:
        try:
            parsed=json.loads(result.stdout)
            result.stdout=json.dumps(filter_fn(parsed),ensure_ascii=False,indent=2)
        except ValueError:
            result.exitcode=1; result.stdout=''; result.stderr=(result.stderr or '')+"\n[borgHelperWWW] réponse non-JSON reçue pour un appelant à périmètre restreint — requête refusée."
    return JSONResponse(status_code=200 if result.exitcode==0 else 400,content=result.dict())

# ── Enveloppes de cache par périmètre autour de _run_scoped/_run_scoped_raw (Story 1.5) ────────
# Jamais à l'intérieur de _run_scoped()/_run_scoped_raw() elles-mêmes (Code Map du spec 1.5 : ces
# deux fonctions restent des primitives non-cacheables, c'est l'endpoint appelant qui décide).

def _scoped_cached_mono(cmd,nick,scope,fingerprint,params,run_fn):
    """Enveloppe de cache pour les cinq routes mono-nick (LstBkpFls/DiffBkp/DuIdx/IdxTop/DiffTop) :
    lookup avant d'appeler `run_fn` (le `_run_scoped`/`_run_scoped_raw` déjà construit par
    l'endpoint appelant, inchangé), écrit/rafraîchit la ligne après un miss. `run_fn` : callable
    sans argument renvoyant le JSONResponse de `_run_scoped`/`_run_scoped_raw` tel quel."""
    sig=_scope_signature(scope)
    cached=_scope_cache_get(nick,cmd,params,sig,fingerprint)
    if cached is not None:
        return JSONResponse(status_code=200 if cached.get('exitcode')==0 else 400,content=cached)
    resp=run_fn()
    try: result_dict=json.loads(resp.body)
    except ValueError: result_dict=None
    if isinstance(result_dict,dict) and result_dict.get('exitcode')==0:
        _scope_cache_put(nick,cmd,params,sig,fingerprint,result_dict)
    return resp

def _scoped_cached_multi(cmd,nick,nicks,scopes,fingerprints,params,run_fn):
    """Enveloppe de cache pour les quatre routes multi-nick (Search/FileHist/TreeHist/TreeFind) :
    hit complet — chaque nick de `nicks` a une ligne fraîche en cache (empreinte+signature
    identiques) — synthétise la réponse SANS appeler borgHelper (json.loads(fragment['stdout'])
    par nick, jamais l'enveloppe {nick:...} — Implementation Notes du spec 1.5). Tout miss -> lance
    `run_fn` (l'appel combiné `_run_scoped` existant, EXACTEMENT comme avant cette story), puis
    écrit/rafraîchit une ligne par nick à partir de CE résultat — jamais l'inverse. `run_fn` :
    callable sans argument renvoyant le JSONResponse de `_run_scoped` tel quel.

    N'écrit AUCUN fragment si l'appel combiné échoue ou si son stdout ne parse pas en dict (rien
    de sensible à découper par nick) — les lignes précédentes (s'il y en a) restent inchangées, la
    prochaine requête retombe simplement en miss (jamais pire qu'avant cette story)."""
    fragments={}
    for n in nicks:
        frag=_scope_cache_get(n,cmd,params,_scope_signature(scopes.get(n)),fingerprints.get(n,''))
        if frag is None:
            fragments=None; break
        fragments[n]=frag
    if fragments is not None:
        try:
            combined={n:json.loads(fragments[n]['stdout']) for n in nicks}
        except ValueError:
            combined=None
        if combined is not None:
            # Chaque fragment peut avoir été écrit par un appel combiné DIFFÉRENT (nicks distincts
            # à des moments distincts) — jamais supposer un stderr partagé, concaténer celui de
            # chaque fragment réellement présent dans ce hit (dédoublonné, ordre stable). En
            # pratique toujours vide ici (Search/FileHist/TreeHist/TreeFind en mode JSON forcé
            # n'écrivent jamais sur stderr sur un succès), mais correct même si ça change un jour.
            seen=[];
            for n in nicks:
                s=fragments[n].get('stderr','')
                if s and s not in seen: seen.append(s)
            stderr='\n'.join(seen)
            result_dict={'exitcode':0,'stdout':json.dumps(combined,ensure_ascii=False,indent=2),'stderr':stderr}
            return JSONResponse(status_code=200,content=result_dict)
    resp=run_fn()
    try: result_dict=json.loads(resp.body)
    except ValueError: result_dict=None
    if isinstance(result_dict,dict) and result_dict.get('exitcode')==0:
        try: parsed=json.loads(result_dict['stdout'])
        except ValueError: parsed=None
        if isinstance(parsed,dict):
            for n in nicks:
                if n in parsed:
                    frag={'exitcode':0,'stdout':json.dumps(parsed[n],ensure_ascii=False),
                          'stderr':result_dict.get('stderr','')}
                    _scope_cache_put(n,cmd,params,_scope_signature(scopes.get(n)),fingerprints.get(n,''),frag)
    return resp

_DUIDX_TYPE_ORDER=['added','modified','removed','C','B','T','présent']  # miroir borgHelper:_DUIDX_TYPE_ORDER
_DUIDX_COL_KEYS=['added','removed','présent']                            # miroir borgHelper:_DUIDX_COL_KEYS
_DUIDX_COL_NAMES=['added/modif','removed','présent']                     # miroir borgHelper:_DUIDX_COL_NAMES

def _duidx_path_key(path,depth):  # miroir borgHelper:_duidx_path_key
    parts=path.split('/')
    return '/'.join(parts[:depth+1]) if depth<len(parts) else path

def _duidx_sort_key(pk,merged,sort_by,reverse):  # miroir borgHelper:_duidx_sort_key
    if sort_by=='chemin': return pk
    idx=_DUIDX_COL_KEYS.index(sort_by) if sort_by in _DUIDX_COL_KEYS else 0
    sz=merged.get((pk,_DUIDX_COL_KEYS[idx]),[0,0])[1]
    return -sz if reverse else sz

def _parse_duidx_sort(sort):  # miroir de la normalisation `_du_sort`/`_du_rev` faite dans borgHelper:_cli_main()
    du_sort=sort or 'chemin'
    du_rev=du_sort.endswith(':desc')
    du_sort=du_sort.replace(':asc','').replace(':desc','')
    if du_sort not in ('chemin','added','removed','présent','present'): du_sort='chemin'
    if du_sort=='present': du_sort='présent'
    return du_sort,du_rev

def _recompute_duidx(parsed,scope,pattern,sort):
    """Filtre les lignes brutes DuIdx (`-R`) par périmètre puis reproduit `_duidx_print()`
    (borgHelper) — mode groupé (`pattern` en 'préfixe/*' ou '*') ou global (`pattern` absent ou
    littéral), même distinction que `duidx()` lui-même. `parsed` sans `rows` (ex. `{'error':...}`)
    passe inchangé."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    grouped=pattern is not None and ('/*' in pattern or pattern=='*')
    if grouped:
        prefix=pattern.rsplit('/*',1)[0] if '/*' in pattern else ''
        depth=prefix.count('/')+1 if prefix else 0
        sort_by,reverse=_parse_duidx_sort(sort)
        merged={}
        for r in rows:
            pk=_duidx_path_key(r.get('chemin',''),depth)
            ct=r.get('type')
            eff='added' if ct in ('added','modified','C','B','T') else ct
            k=(pk,eff)
            if k not in merged: merged[k]=[0,0]
            merged[k][0]+=1; merged[k][1]+=r.get('taille',0)
        paths=sorted(set(pk for pk,_ in merged),
                     key=lambda pk:_duidx_sort_key(pk,merged,sort_by,reverse),
                     reverse=(reverse if sort_by!='chemin' else False))
        totcol={ck:[0,0] for ck in _DUIDX_COL_KEYS}
        rows_data=[]
        for pk in paths:
            entry={'chemin':pk}
            for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES):
                cnt,sz=merged.get((pk,ck),[0,0])
                entry[cn]={'nb':cnt,'taille':sz}
                totcol[ck][0]+=cnt; totcol[ck][1]+=sz
            rows_data.append(entry)
        return {'borghelper_version':parsed.get('borghelper_version'),'pattern':pattern,'rows':rows_data,
                'total':{cn:{'nb':totcol[ck][0],'taille':totcol[ck][1]} for ck,cn in zip(_DUIDX_COL_KEYS,_DUIDX_COL_NAMES)}}
    totals={}
    for r in rows:
        ct=r.get('type')
        if ct not in totals: totals[ct]=[0,0]
        totals[ct][0]+=1; totals[ct][1]+=r.get('taille',0)
    order=_DUIDX_TYPE_ORDER
    rows_data=[{'type':ct,'nb':cnt,'taille':sz} for ct,(cnt,sz) in
               sorted(totals.items(),key=lambda x:(order.index(x[0]) if x[0] in order else 99))]
    return {'borghelper_version':parsed.get('borghelper_version'),'pattern':pattern,'rows':rows_data,
            'total':{'nb':sum(r['nb'] for r in rows_data),'taille':sum(r['taille'] for r in rows_data)}}

def _idxtop_get_prefix(path,d):  # miroir borgHelper:idxtop().get_prefix / difftop().get_prefix (identiques)
    if not path: return '(vide)'
    leading='/' if path[0]=='/' else ''
    parts=[p for p in path.split('/') if p]
    if len(parts)<=d: return path
    return leading+'/'.join(parts[:d])

def _recompute_idxtop(parsed,scope,depth,topn):
    """Filtre les lignes brutes IdxTop (`-j`) par périmètre puis reproduit le regroupement/tri/top-N
    de `idxtop()` (borgHelper). Volontairement SANS `exclu_n`/`nfiles_d` (Exclus/Inchangés par
    archive) : figures whole-nick sans colonne de chemin, non-scopables correctement — omises pour
    tout appelant scopé (Boundaries du spec 1.4), jamais approximées."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    stats=defaultdict(lambda:{'count':0,'size':0})
    total_count=0; total_size=0
    for r in rows:
        pfx=_idxtop_get_prefix(r.get('chemin',''),depth)
        sz=r.get('taille',0) or 0
        stats[pfx]['count']+=1; stats[pfx]['size']+=sz
        total_count+=1; total_size+=sz
    top=sorted(stats.items(),key=lambda x:x[1]['count'],reverse=True)[:topn]
    rows_out=[{'prefix':pfx,'count':s['count'],'size':s['size'],
               'pct':(100*s['count']//total_count) if total_count else 0} for pfx,s in top]
    return {'borghelper_version':parsed.get('borghelper_version'),'nick':parsed.get('nick'),'depth':depth,
            'topn':topn,'total_count':total_count,'total_size':total_size,'rows':rows_out}

def _recompute_difftop(parsed,scope,depth,topn):
    """Filtre les lignes brutes DiffTop (`-j`) par périmètre puis reproduit le regroupement/tri/top-N
    de `difftop()` (borgHelper). Une paire d'archives sans la moindre ligne dans le périmètre renvoie
    naturellement `rows=[]`/totaux à 0 — jamais une erreur (I/O matrix du spec 1.4). Volontairement
    SANS `exclu_n`/`nfiles_new` (Exclus/Inchangés), même raison que `_recompute_idxtop`."""
    if not isinstance(parsed,dict) or 'rows' not in parsed: return parsed
    rows=[r for r in parsed['rows'] if _path_in_scope(r.get('chemin',''),scope)]
    stats=defaultdict(lambda:{'total':0,'added_n':0,'added_s':0,'removed_n':0,'removed_s':0,'modified_n':0,'size':0})
    total_count=0; total_size=0
    for r in rows:
        pfx=_idxtop_get_prefix(r.get('chemin',''),depth)
        s=stats[pfx]
        s['total']+=1
        sa=r.get('taille_apres',0) or 0; sb=r.get('taille_avant',0) or 0
        sz=sa or sb or 0
        s['size']+=sz
        ct=r.get('type')
        if ct=='added': s['added_n']+=1; s['added_s']+=sa
        elif ct=='removed': s['removed_n']+=1; s['removed_s']+=sb
        else: s['modified_n']+=1
        total_count+=1; total_size+=sz
    top=sorted(stats.items(),key=lambda x:x[1]['total'],reverse=True)[:topn]
    rows_out=[]
    for pfx,s in top:
        pct=(100*s['total']//total_count) if total_count else 0
        rows_out.append({'prefix':pfx,'total':s['total'],'pct':pct,
                          'added_n':s['added_n'],'added_size':s['added_s'],
                          'removed_n':s['removed_n'],'removed_size':s['removed_s'],
                          'modified_n':s['modified_n'],'size':s['size']})
    return {'borghelper_version':parsed.get('borghelper_version'),'nick':parsed.get('nick'),
            'archive_old':parsed.get('archive_old'),'archive_new':parsed.get('archive_new'),
            'depth':depth,'topn':topn,'total_count':total_count,'total_size':total_size,'rows':rows_out}

# ── Téléchargements (accès borg direct, streaming binaire) ─────────────────────
# Seule exception au principe "tout passe par borgHelper en sous-processus" : un téléchargement
# doit streamer des octets bruts vers le navigateur, incompatible avec le pipe texte/JSON de
# run_borghelper(). Lit la conf via BorgRunner (mode librairie, cfgfile+passphrase), exécute borg
# directement (extract --stdout / export-tar) et streame son stdout comme réponse HTTP.

_BORG_ENV_KEYS=('BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO',
                 'BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE')
_FILENAME_UNSAFE=re.compile(r'[^A-Za-z0-9_.\-]+')

def _borg_cfg(nick: str, passphrase: Optional[str]):
    cfg=BorgRunner(cfgfile=CFGFILE,passphrase=passphrase).cfgread(nick)
    if cfg is None:
        raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return cfg

def _borg_env(cfg):
    env=os.environ.copy()
    for k in _BORG_ENV_KEYS:
        if k in cfg.keys(): env[k]=cfg[k]
    return env

def _latest_archive(cfg,env):
    borg_exe=cfg.get('BORG_EXE','borg')
    try:
        proc=subprocess.run([borg_exe,'list','--short','--glob-archives',cfg['GLOB_ARCH'],cfg['BORG_REPO']],
                             capture_output=True,text=True,env=env,timeout=60)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail="borg list : timeout")
    if proc.returncode!=0:
        raise HTTPException(502,detail=f"borg list a échoué : {proc.stderr[:300]}")
    lines=[l for l in proc.stdout.splitlines() if l.strip()]
    if not lines:
        raise HTTPException(404,detail="Aucune archive dans ce dépôt")
    return lines[-1]

def _safe_filename(name: str) -> str:
    name=(name or '').strip('/').split('/')[-1] or 'download'
    return _FILENAME_UNSAFE.sub('_',name) or 'download'

def _stream_proc(proc):
    try:
        while True:
            chunk=proc.stdout.read(65536)
            if not chunk: break
            yield chunk
    finally:
        try: proc.stdout.close()
        except Exception: pass
        proc.wait()

# ── Story 2.1 : réponses synthétiques "introuvable" (hors périmètre) ───────────────────────────
# Chacune des quatre fonctions ci-dessous imite, EXACTEMENT, la forme que sa route produit
# aujourd'hui pour un chemin qui n'existe dans aucune archive (voir Intent du spec 2.1) — jamais un
# 403 (voir require_path_in_scope ci-dessus). Texte/formes re-vérifiés EN DIRECT contre
# demo.borghelperrc avant implémentation (Design Notes du spec 2.1 : le texte gelé de l'Intent
# pouvait être obsolète) — deux écarts trouvés et corrigés par rapport au texte gelé, consignés dans
# le Spec Change Log du spec 2.1 :
#   1. `GET /restore/perms` : la ligne d'archive absente d'index est "Archive (dernière) : <bid>",
#      jamais "Archive : <bid>" (qui ne peut au contraire apparaître QUE quand le chemin a été
#      trouvé dans l'index — donc jamais dans le cas "introuvable" que cette story doit imiter).
#   2. `GET /download/tar` : le tar minimal vide fait 10240 octets (RECORDSIZE, `tarfile` bufferise
#      toujours un enregistrement complet en mode stream, même vide), jamais 1024 (deux blocs de
#      512 zéros) — vérifié byte-pour-byte identique à un `borg export-tar` réel sans le moindre
#      membre.
# Connu, non corrigé : `POST /restore` sur ce dépôt/cette version de borg ajoute une ligne
# "Warning: \"--numeric-owner\" has been deprecated..." AVANT "Include pattern... never matched." —
# présente sur TOUT appel réel de `borg extract` (montré, pas seulement le cas introuvable),
# reproduite ici à l'identique pour l'indiscernabilité mais couplée à la version de borg installée ;
# à re-vérifier si `borg`/le flag `--numeric-owner` de `_borg_extract_args` changent (voir
# CHANGELOG.md, Story 2.1). Même risque, même absence de source de vérité partagée, pour les libellés
# de ligne d'archive codés en dur ci-dessous ("Archive sélectionnée (dernière)", "Archive (dernière)")
# : ils recopient à l'identique ce qu'impriment aujourd'hui `borgHelper.restore()`/`listperms()` — si
# ces prints changent de formulation côté `borgHelper` sans qu'on pense à répercuter le changement
# ici, la synthèse dérive silencieusement du comportement réel qu'elle est censée imiter.
_RESTORE_NUMERIC_OWNER_WARNING='Warning: "--numeric-owner" has been deprecated. Use --numeric-ids instead.\n'

def _oos_last_archive_line(nick,bid,passphrase,label):
    """Construit la ligne d'archive (`"<label> : <bid>\\n"`) que `borgHelper` imprimerait pour un
    chemin introuvable — UNIQUEMENT quand `bid` est omis (borgHelper.restore()/listperms() n'impriment
    cette ligne QUE dans ce cas ; `bid` explicite -> aucune ligne du tout, chaîne vide ici aussi).
    Réutilise `_borg_cfg`/`_borg_env`/`_latest_archive` (déjà utilisés par download_file/download_tar
    ci-dessous) pour déterminer la dernière archive exactement comme `self.borg.getlastbkp()` le
    ferait côté borgHelper. Ceci appelle bien `borg list --short` en sous-processus — mais ce n'est
    PAS l'appel que le Boundaries "jamais d'appel borg/borgHelper" du spec 2.1 interdit : celui-ci ne
    porte que sur les NOMS D'ARCHIVE du nick (métadonnée déjà accessible à tout appelant qui détient
    ne serait-ce qu'un tier lecture sur ce nick, ex. via /lstbkp — jamais sur le CHEMIN hors périmètre
    demandé, qui seul est protégé ici).

    `_latest_archive()` peut lever `HTTPException` (404 : nick sans aucune archive ; 502/504 : `borg
    list` a échoué/timeout) — dans ce cas la ligne d'archive est simplement omise (chaîne vide) plutôt
    que de laisser l'exception se propager : la synthèse "introuvable" doit rester construite quel que
    soit l'état du dépôt, jamais un 404/502/504 qui serait une troisième forme de réponse distincte
    des deux promises par cette story (voir Review Triage Log du spec 2.1)."""
    if not bid:
        cfg=_borg_cfg(nick,passphrase)
        env=_borg_env(cfg)
        try:
            archive=_latest_archive(cfg,env)
        except HTTPException:
            return ''
        return f"{label} : {archive}\n"
    return ''

def _synth_restore_out_of_scope(nick,ftor,bid,passphrase):
    stdout=_oos_last_archive_line(nick,bid,passphrase,"Archive sélectionnée (dernière)")
    stderr=_RESTORE_NUMERIC_OWNER_WARNING+f"Include pattern '{ftor}' never matched.\n"
    return JSONResponse(status_code=400,content=CommandResult(exitcode=1,stdout=stdout,stderr=stderr).dict())

def _synth_restore_perms_out_of_scope(nick,ftor,bid,passphrase):
    stdout=_oos_last_archive_line(nick,bid,passphrase,"Archive (dernière)")
    return JSONResponse(status_code=200,content=CommandResult(exitcode=0,stdout=stdout,stderr='').dict())

_EMPTY_TAR_CACHE=None

def _empty_tar_bytes():
    """Tar minimal valide vide — vérifié byte-pour-byte identique (live, demo.borghelperrc) à ce que
    produit `borg export-tar` pour un export sans le moindre membre. Recalculé une fois via
    `tarfile` plutôt que codé en dur en octets, pour rester correct si RECORDSIZE change un jour
    côté bibliothèque standard."""
    global _EMPTY_TAR_CACHE
    if _EMPTY_TAR_CACHE is None:
        buf=io.BytesIO()
        tf=tarfile.open(fileobj=buf,mode='w|')
        tf.close()
        _EMPTY_TAR_CACHE=buf.getvalue()
    return _EMPTY_TAR_CACHE

def _synth_download_file_out_of_scope(path):
    return StreamingResponse(iter(()),media_type='application/octet-stream',
        headers={'Content-Disposition':f'attachment; filename="{_safe_filename(path)}"'})

def _download_tar_filename(nick,prefix):
    """Nom de fichier `.tar` — partagé entre `download_tar()` (corps réel) et
    `_synth_download_tar_out_of_scope` (synthèse hors périmètre) pour que les deux restent
    identiques par construction (voir AGENTS.md : pitfall `_fmt_stats`, même risque ici)."""
    return (_safe_filename(prefix) if prefix else nick)+'.tar'

def _synth_download_tar_out_of_scope(nick,prefix):
    return StreamingResponse(iter((_empty_tar_bytes(),)),media_type='application/x-tar',
        headers={'Content-Disposition':f'attachment; filename="{_download_tar_filename(nick,prefix)}"'})

@router.get("/download/file",tags=["téléchargement"],summary="Télécharge un fichier depuis une archive (borg extract --stdout)")
def download_file(nick: str, path: str, request: Request, bid: Optional[str]=None,
                   x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    if not require_path_in_scope(request,nick,path):
        return _synth_download_file_out_of_scope(path)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    proc=subprocess.Popen([borg_exe,'extract','--stdout',f"{cfg['BORG_REPO']}::{archive}",path],
                          stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    return StreamingResponse(_stream_proc(proc),media_type='application/octet-stream',
        headers={'Content-Disposition':f'attachment; filename="{_safe_filename(path)}"'})

@router.get("/download/tar",tags=["téléchargement"],summary="Télécharge un .tar d'une arborescence depuis une archive (borg export-tar)")
def download_tar(nick: str, request: Request, prefix: Optional[str]=None, bid: Optional[str]=None,
                  x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    # Préfixe absent = export de l'archive ENTIÈRE (racine) : jamais "dans le périmètre" pour un
    # appelant restreint quel qu'il soit (I/O Matrix du spec 2.1) — require_path_in_scope(...,'')
    # via `prefix` (None accepté tel quel, _path_in_scope normalise) tranche déjà correctement ce
    # cas : illimité -> True (accès identique à aujourd'hui), restreint -> toujours False.
    if not require_path_in_scope(request,nick,prefix):
        return _synth_download_tar_out_of_scope(nick,prefix)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    cmd=[borg_exe,'export-tar',f"{cfg['BORG_REPO']}::{archive}",'-']
    if prefix: cmd.append(prefix)
    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    return StreamingResponse(_stream_proc(proc),media_type='application/x-tar',
        headers={'Content-Disposition':f'attachment; filename="{_download_tar_filename(nick,prefix)}"'})

