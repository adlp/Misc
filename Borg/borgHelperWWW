# ── Préférences par abonné en JSON (spec-push-ui-prefs-json) ───────────────────
# Source de vérité UNIQUE des préférences (scope_nicks, notify_start, notify_end, expires_at), indexées
# par endpoint. push.db ne garde que les clés VAPID et endpoint/p256dh/auth ; ses colonnes de préférence
# sont conservées (jamais de migration destructive sur une base non reconstructible, AD-6) mais ne sont
# plus ni lues ni tenues à jour — seule la migration initiale ci-dessous les consulte, une fois.
PUSH_PREFS_FILE=os.environ.get('BORGHELPERWWW_PUSH_PREFS') or \
    os.path.join(os.path.dirname(os.path.abspath(PUSH_DB)),f"{_bh_paths.db.db_prefix}-push-prefs.json")
_PUSH_TS_FMT='%Y-%m-%d %H:%M:%S'  # même format que datetime('now') SQLite (UTC), comparable en chaîne

class PushPrefsError(Exception):
    """Fichier de préférences illisible/corrompu — jamais écrasé automatiquement (données utilisateur)."""

def _utc_now_str():
    return datetime.datetime.now(datetime.timezone.utc).strftime(_PUSH_TS_FMT)

def _expires_at_value(days):
    """`days` déjà résolu (None = « à vie », sinon entier >=1) -> expires_at (chaîne UTC) ou None."""
    if days is None: return None
    return (datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(days=int(days))).strftime(_PUSH_TS_FMT)

@contextlib.contextmanager
def _push_prefs_locked():
    """Verrou exclusif inter-processus (plusieurs workers uvicorn + watcher) autour de toute
    lecture-modification-écriture. Fichier .lock séparé : os.replace() remplace le fichier de données,
    un flock posé dessus ne survivrait pas au remplacement."""
    import fcntl
    fd=os.open(PUSH_PREFS_FILE+'.lock',os.O_RDWR|os.O_CREAT,0o600)
    try:
        fcntl.flock(fd,fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd,fcntl.LOCK_UN); os.close(fd)

def _push_prefs_load():
    """Lecture sans verrou possible (os.replace est atomique : on lit l'ancienne ou la nouvelle version,
    jamais un fichier à moitié écrit). Absent -> vide. Corrompu -> PushPrefsError, jamais « vide »
    (sinon la prochaine écriture effacerait silencieusement toutes les préférences)."""
    try:
        with open(PUSH_PREFS_FILE,encoding='utf-8') as f: data=json.load(f)
    except FileNotFoundError:
        return {'version':2,'subscriptions':{}}
    except (OSError,ValueError) as e:
        raise PushPrefsError(f"{PUSH_PREFS_FILE} illisible ou JSON invalide ({e}) — jamais écrasé "
                             "automatiquement : corriger ou restaurer ce fichier") from e
    if not isinstance(data,dict) or not isinstance(data.get('subscriptions'),dict):
        raise PushPrefsError(f"{PUSH_PREFS_FILE} : structure inattendue (attendu "
                             "{\"subscriptions\": {endpoint: {...}}}) — jamais écrasé automatiquement")
    return data

def _push_prefs_save(data):
    """Écriture atomique : fichier temporaire (mkstemp -> 0600) dans le MÊME répertoire, fsync, puis
    os.replace — un lecteur concurrent ne voit jamais un JSON tronqué."""
    import tempfile
    fd,tmp=tempfile.mkstemp(prefix='.push-prefs-',suffix='.tmp',dir=os.path.dirname(PUSH_PREFS_FILE) or '.')
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            json.dump(data,f,ensure_ascii=False,indent=2,sort_keys=True); f.write('\n')
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp,PUSH_PREFS_FILE)
    except BaseException:
        with contextlib.suppress(OSError): os.unlink(tmp)
        raise

def _push_prefs_update(fn):
    """Lecture-modification-écriture sous verrou : `fn(subscriptions)` modifie le dict en place et peut
    retourner une valeur (retransmise). Une exception levée par `fn` annule l'écriture."""
    with _push_prefs_locked():
        data=_push_prefs_load()
        result=fn(data['subscriptions'])
        data['version']=2
        _push_prefs_save(data)
        return result

# Types de notification, réglables PAR HOST (borgHelperWWW 1.21.0) : début de sauvegarde, fin en succès,
# fin en échec (Bkp en erreur, ou bloqué au-delà de BKP_STATUS_TIMEOUT — AD-7).
_PUSH_KINDS=('start','success','error')
_PUSH_DEFAULT_HOST={'start':False,'success':True,'error':True}

def _prefs_entry(raw):
    """Normalise une entrée (le fichier est éditable à la main) : jamais de crash sur une clé absente ou
    mal typée. Fail-closed : scope_nicks invalide -> [] (aucune notification) ; expires_at non nul mais
    illisible -> considéré expiré, jamais « à vie » par accident. expires_at null/absent = « à vie ».

    `hosts` (format 2, 1.21.0) : {nick: {start,success,error}} — uniquement pour les nicks de
    `scope_nicks` (périmètre figé à l'abonnement, AD-4 : un host ajouté à la main hors de ce périmètre
    est ignoré) ; host du périmètre absent de `hosts`, ou valeur non booléenne -> False (rien envoyé).
    Entrée au format 1 (sans clé `hosts` : notify_start/notify_end globaux, abonnements < 1.21.0) ->
    convertie à la lecture : start=notify_start, success=error=notify_end, pour chaque nick."""
    e=raw if isinstance(raw,dict) else {}
    nicks=e.get('scope_nicks')
    nicks=[n for n in nicks if isinstance(n,str)] if isinstance(nicks,list) else []
    exp=e.get('expires_at')
    if exp is not None:
        try: datetime.datetime.strptime(exp,_PUSH_TS_FMT)
        except (TypeError,ValueError): exp='1970-01-01 00:00:00'
    hosts={}
    if 'hosts' not in e:
        end=e.get('notify_end',True) is True
        for n in nicks: hosts[n]={'start':e.get('notify_start') is True,'success':end,'error':end}
    else:
        raw_hosts=e['hosts'] if isinstance(e['hosts'],dict) else {}
        for n in nicks:
            h=raw_hosts.get(n); h=h if isinstance(h,dict) else {}
            hosts[n]={k:h.get(k) is True for k in _PUSH_KINDS}
    # user (1.25.0) : identité (USER_HEADER) de la personne lors de sa dernière action sur l'abonnement —
    # pour l'accompagner (qui reçoit quoi), jamais utilisée pour décider d'un envoi.
    return {'scope_nicks':nicks,'hosts':hosts,'expires_at':exp,
            'updated_at':e.get('updated_at') if isinstance(e.get('updated_at'),str) else None,
            'user':_clean_user(e.get('user')) if isinstance(e.get('user'),str) else None}

def _push_sub_dict(row,raw_prefs):
    """Vue API d'un abonnement : identité/clés depuis push.db, préférences depuis le fichier JSON.
    `prefs_missing` : endpoint connu de push.db sans entrée dans le fichier (fichier supprimé/édité) —
    aucune notification ne part alors (scope_nicks vide), un réabonnement (POST) la recrée."""
    p=_prefs_entry(raw_prefs)
    return {'id':row['id'],'endpoint':row['endpoint'],'scope_nicks':p['scope_nicks'],
            'hosts':p['hosts'],'expires_at':p['expires_at'],'user':p['user'],
            'created_at':row['created_at'],'updated_at':p['updated_at'],'prefs_missing':raw_prefs is None}

def _migrate_push_prefs_from_db():
    """Une seule fois : fichier JSON absent -> exporte les préférences encore stockées dans les colonnes
    de push.db (abonnements créés avant borgHelperWWW 1.19.0). Re-vérifie l'existence sous verrou
    (deux workers uvicorn démarrant ensemble). Crée le fichier même vide : il devient visible pour
    l'admin dès le premier démarrage."""
    if os.path.exists(PUSH_PREFS_FILE): return
    with _push_prefs_locked():
        if os.path.exists(PUSH_PREFS_FILE): return
        conn=_push_conn('read')
        try:
            rows=conn.execute("SELECT endpoint,scope_nicks,notify_start,notify_end,expires_at "
                              "FROM push_subscriptions").fetchall()
        finally:
            conn.close()
        subs={}
        for r in rows:
            try: nicks=json.loads(r['scope_nicks'])
            except (TypeError,ValueError): nicks=[]
            subs[r['endpoint']]={'scope_nicks':nicks if isinstance(nicks,list) else [],
                                 'notify_start':bool(r['notify_start']),'notify_end':bool(r['notify_end']),
                                 'expires_at':r['expires_at'],'updated_at':_utc_now_str()}
        _push_prefs_save({'version':1,'subscriptions':subs})
        if subs:
            print(f"[push] préférences de {len(subs)} abonnement(s) migrées de push.db vers "
                  f"{PUSH_PREFS_FILE}",file=sys.stderr,flush=True)

