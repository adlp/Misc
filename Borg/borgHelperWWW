    class _Server(uvicorn.Server):
        async def startup(self,*a,**k):
            self._bh_loop=asyncio.get_running_loop()   # 1.31.4 : boucle du serveur, pour _abort_connections au 2e signal
            await super().startup(*a,**k)
        def _abort_connections(self):
            # 1.31.4 (revue story 57, mesuré) : arrêt forcé — connexions encore ouvertes coupées (abort : tampon d'envoi jeté).
            # Sous Python >= 3.12, uvicorn attend la fermeture de toutes les connexions (asyncio Server.wait_closed) même en arrêt
            # forcé : un client qui ne lit plus gardait le serveur vivant (borg déjà tué) jusqu'au SIGKILL.
            for c in list(getattr(getattr(self,'server_state',None),'connections',None) or ()):
                t=getattr(c,'transport',None)
                if t is not None: t.abort()
        def handle_exit(self,sig,frame):
            _kill_live_borg(idle_only=not self.should_exit)
            import signal as _sg
            _signal_groups(sig if not self.should_exit else _sg.SIGKILL)   # revue : commandes borgHelper en cours (session propre)
            again=self.should_exit
            super().handle_exit(sig,frame)
            if again: self.force_exit=True   # 1.31.4 (story 57) : uvicorn 0.54 ne force qu'au 2e SIGINT ; ici tout 2e signal
            # 1.31.4 (revue story 57) : uvicorn 0.54 relance après serve() les signaux reçus (gestionnaire par défaut rétabli) — le
            # processus mourait par SIGTERM sans atexit (_kill_live_borg) ; comme uvicorn 0.15 : sortie normale, atexit exécuté.
            cap=getattr(self,'_captured_signals',None)
            if isinstance(cap,list): cap.clear()
            loop=getattr(self,'_bh_loop',None)
            if again and loop is not None:
                try: loop.call_soon_threadsafe(self._abort_connections)   # jamais directement : peut tourner dans le gestionnaire de signal
                except RuntimeError: pass   # boucle déjà fermée
    return _Server(config)

