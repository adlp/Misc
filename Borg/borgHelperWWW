def _build_borghelper_argv_env(cmd: str, nick: Optional[str], extra_args, passphrase: Optional[str]=None, cfgfile: Optional[str]=None):
    """argv/env communs à tout lancement de borgHelper en sous-processus — factorisé pour être
    partagé entre `_exec_borghelper` (attend le résultat) et `_launch_bkp_detached` (AD-2, ne
    l'attend jamais). 1.32.0 (story 86) : `cfgfile` = rc du nick, OBLIGATOIRE en mode dossier (jamais le maître par défaut) ;
    mode -C : CFGFILE."""
    if cfgfile is None:
        if DIR_MODE: raise RuntimeError(f"mode dossier : rc du nick non fourni pour borgHelper -c {cmd}")
        cfgfile=CFGFILE
    argv=[sys.executable,str(BORGHELPER_BIN),'-C',cfgfile,'-c',cmd]
    if nick: argv+=['-n',nick]
    argv+=list(extra_args)
    env=os.environ.copy()
    if passphrase: env['BORGHELPERC_RUNTIME_PASSPHRASE']=passphrase
    # 1.28.5 (story 23) : jamais la notice de nettoyage dans /report ou /status texte (état de la machine) — elle ne
    # passe que par /access borg_cleanup, réservé aux admins quand les groupes sont actifs
    env['BORGHELPERC_NO_CLEANUP_NOTICE']='1'
    return argv,env

def _run_group(argv,timeout,env):
    """1.31.1 (story 42, A91, décision de l'utilisateur) : sous-processus (borgHelper, borg) en session propre ; au délai,
    SIGTERM à tout le GROUPE (borgHelper et son borg ; le borg PyInstaller relaie SIGTERM à son enfant et rend son verrou de
    dépôt), SIGKILL 10 s après, puis subprocess.TimeoutExpired. Avant : subprocess.run(timeout) tuait le seul processus lancé —
    son borg continuait orphelin (verrou gardé, écritures de fin perdues ; un /restore de plus de TIMEOUT finissait en douce).
    1.31.2 (story 43, A93 ; mesuré sur 1.31.1 : SIGKILL sauté) : la fin d'un arrêt est le GROUPE vide (`_group_pids`), jamais la
    fin des tubes de borgHelper — mort au SIGTERM, il fermait ses tubes et `communicate` rendait la main pendant que l'enfant de
    borg (tubes vers borgHelper) restait orphelin. Restes du groupe après une sortie de borgHelper SANS délai atteint (tué de
    l'extérieur, OOM, 1er signal d'arrêt relayé) : SIGTERM, 10 s, SIGKILL, puis réponse (décision de l'utilisateur), une ligne
    [WARN] au journal. Le groupe reste au registre (`_signal_groups`) jusqu'à vide. Bornes : au délai, la réponse part en général
    10 s après (SIGKILL), 30 s au plus (tubes encore tenus après le SIGKILL : 10 s de plus pour les lire) ; restes après une
    sortie sans délai : 10 s, 20 s au plus.
    1.31.9 (story 65, F334, décision de l'utilisateur ; mesuré : borg figé -> SIGKILL, ou délai pendant le démarrage de borg ->
    un /tmp/_MEI* de ~57 Mo laissé par arrêt — le chargeur PyInstaller ne retire son dossier que si son enfant sort de lui-même) :
    comme les téléchargements (_borg_killgrp/_borg_reap), _MEI* de CE groupe relevés avant chaque signal (`_mei_mapped`, avant
    le SIGTERM et le SIGKILL du délai ou des restes après sortie ; `_signal_groups` pour le signal d'arrêt du serveur relayé),
    retirés une fois le groupe vide s'ils ne sont plus utilisés (`_purge_mei_dirs`) — jamais l'extraction d'un autre borg ;
    sortie normale sans signal : rien relevé, aucune attente."""
    import signal as _sg
    proc=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,env=env,start_new_session=True)
    meis=set()   # 1.31.9 : _MEI* relevés avant chaque signal (ici et par _signal_groups), retirés dans le finally
    with _LIVE_GROUPS_LOCK: _LIVE_GROUPS[proc]=meis   # revue : relais des signaux d'arrêt du serveur (session propre)
    timed=False; out=err=None
    def mark():   # 1.31.9 : avant le signal (un mort ne mappe plus rien) ; une erreur du relevé n'empêche jamais le signal
        try: meis.update(_mei_mapped(_group_pids(proc.pid)))
        except Exception: pass
    def term():
        mark()
        try: os.killpg(proc.pid,_sg.SIGTERM)
        except OSError: pass
        return time.monotonic()+10
    try:
        try: out,err=proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed=True; until=term()
            try: out,err=proc.communicate(timeout=10)
            except subprocess.TimeoutExpired: pass   # tubes tenus : SIGKILL plus bas
        else:
            until=None
            if _group_alive(proc.pid):   # restes après une sortie sans délai (décision : tout arrêter), dits au journal
                print(f"[WARN] {_argv_label(argv)} : processus restés dans le groupe après la sortie de borgHelper "
                      f"(code {proc.returncode}, pids {_group_pids(proc.pid) or '?'}) — SIGTERM, SIGKILL après 10 s",file=sys.stderr)
                until=term()
        if until is not None and not _group_wait(proc.pid,until):   # /proc illisible : sonde killpg(0), jamais « vide » par défaut
            mark()
            try: os.killpg(proc.pid,_sg.SIGKILL)
            except OSError: pass
            _group_wait(proc.pid,time.monotonic()+10)
        if out is None:
            try: out,err=proc.communicate(timeout=10)
            except subprocess.TimeoutExpired: out,err='',''   # tube tenu hors groupe (démon) : jamais une attente sans fin
    finally:
        # 1.31.9 : retiré du registre AVANT la purge (_signal_groups n'ajoute plus rien au jeu ensuite) ; groupe vide ici (ou
        # membre que le SIGKILL n'atteint pas : ses dossiers, encore utilisés, sont gardés)
        with _LIVE_GROUPS_LOCK: _LIVE_GROUPS.pop(proc,None)
        if meis: _purge_mei_dirs(meis)
    if timed: raise subprocess.TimeoutExpired(argv,timeout)
    return subprocess.CompletedProcess(argv,proc.returncode,out,err)

def _argv_label(argv):
    """Nom court d'une commande lancée par _run_group pour le journal (`borgHelper -c <commande>` ou `borg <sous-commande>`),
    jamais ses arguments (chemins, motifs)."""
    a=list(argv)
    if '-c' in a[:-1]: return f"borgHelper {a[a.index('-c')+1]}"
    return ' '.join([os.path.basename(str(a[0]))]+[str(x) for x in a[1:2]]) if a else '?'

# 1.31.1 (revue story 42) : groupes lancés par _run_group (borgHelper et son borg, en session propre) — un Ctrl-C au terminal ne
# les atteint plus directement : _signal_groups relaie le signal d'arrêt du serveur (premier : le même, comme le terminal ou
# systemd le faisaient avant ; second, atexit : SIGKILL).
# 1.31.4 (revue story 57) : RLock — uvicorn >= 0.54 appelle handle_exit (-> _signal_groups) dans le VRAI gestionnaire de signal
# (signal.signal), donc sur le fil principal, éventuellement pendant qu'il tient déjà ce verrou : un Lock s'y interbloquerait.
# 1.31.9 (story 65) : {Popen: _MEI* relevés} — le jeu est celui de _run_group, qui le purge une fois le groupe vide.
_LIVE_GROUPS={}; _LIVE_GROUPS_LOCK=threading.RLock()

def _signal_groups(sig):
    # Jamais conditionné à pr.poll() : le 1er signal tue la tête (borgHelper) et laisse un enfant qui l'ignore — le groupe
    # reste au registre jusqu'à vide (1.31.2, _run_group) ; le 2e (SIGKILL) doit l'atteindre (mesuré).
    with _LIVE_GROUPS_LOCK: items=list(_LIVE_GROUPS.items())
    import signal as _sg
    for pr,meis in items:
        # 1.31.9 (story 65) : relevé avant le signal, purgé par le fil de _run_group une fois le groupe vide — jamais pour SIGKILL
        # (2e signal, atexit : le serveur sort, personne ne purgerait ; parcours de /proc évité dans le gestionnaire de signal).
        # Sous _LIVE_GROUPS_LOCK et seulement si le groupe est encore au registre : _run_group le retire (sous ce verrou) AVANT
        # de purger — jamais un ajout à un jeu déjà purgé. Une erreur du relevé n'empêche jamais le signal.
        if sig!=_sg.SIGKILL:
            with _LIVE_GROUPS_LOCK:
                if pr in _LIVE_GROUPS:
                    try: meis.update(_mei_mapped(_group_pids(pr.pid)))
                    except Exception: pass
        try: os.killpg(pr.pid,sig)
        except OSError: pass

