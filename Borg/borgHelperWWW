# toujours sur le fichier). Fonctionne dans les deux modes de lancement (direct et `uvicorn
# borgHelperWWW:app`), puisque seule une variable d'environnement (BORGHELPERWWW_CONF) y mène.
_CONF_KEYS={'cfgfile':'BORGHELPERWWW_CFGFILE','api_key':'BORGHELPERWWW_API_KEY',
            'borghelper_bin':'BORGHELPERWWW_BORGHELPER_BIN','ui_file':'BORGHELPERWWW_UI_FILE',
            'timeout':'BORGHELPERWWW_TIMEOUT','host':'BORGHELPERWWW_HOST','port':'BORGHELPERWWW_PORT',
