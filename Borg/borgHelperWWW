# Un endpoint par commande CLI de borgHelper (voir README.md), sauf Mount/UMount et BorgCleanup (suppression en CLI seulement).

_CLEANUP_CACHE={'t':None,'v':None}
def _borg_cleanup_summary():
    """1.28.5 (story 23, A30) : restes de dépôts borg disparus et fichiers de nicks retirés (borgHelper cleanup_scan,
    lecture seule) — nombres et tailles seulement, jamais de chemin ; None s'il n'y a rien ou si la lecture échoue.
    Recalculé au plus toutes les 5 min (/access est relu par l'UI toutes les 30 s). Aucune suppression ici : seulement
    la CLI (borgHelper -c BorgCleanup -y)."""
    now=time.monotonic()
    if _CLEANUP_CACHE['t'] is not None and now-_CLEANUP_CACHE['t']<300: return _CLEANUP_CACHE['v']
    try:
        s=_bh_paths.cleanup_summary(_bh_paths.cleanup_scan())
        v=s if (s['borg_entries'] or s['keys'] or s['bh_files'] or s['history']) else None
    except (Exception,SystemExit): v=None
    _CLEANUP_CACHE.update(t=now,v=v)
    return v

@router.get("/access",tags=["lecture"],summary="Niveau d'accès (lecture/écriture/admin) ET périmètres de chemin lecture+restauration de l'appelant sur chaque nick, d'après ses groupes — 200 pour un appel authentifié, SAUF 500 (non catché, par construction) si GROUPS_PATHS/GROUPS_PATHS_RESTORE a été rendu ambigu dans .borghelperrc depuis le démarrage du process — voir README.md")
def access(request: Request, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    nicks=_nick_list('ALL')
    def _plain(n):
        # 1.27.1 : bases restées en clair alors qu'elles devraient être chiffrées (badge de l'UI, anomalies seulement)
        try:
            return db_plain_anomalies(n,[('diff.db',_bh_paths.db.get_diff_db(n)),('cache.db',_bh_paths.db.get_cache_db(n))],
                                      _bh_paths.borg.cfgread(n))
        except Exception:
            return []
    def _state(n):
        """1.28.0 (story 7, AD-10/AD-12) : dépôt externe, opérations permises (allowed_ops de borgHelper), état de
        construction et Bkp en cours — lectures locales comme Status (jamais borg, rien créé)."""
        out={'external':False,'ops':None,'build':None,'rebuild':None,'bkp_running':None,'index_last':None,'bkp_last':None}
        try:
            cfg=_bh_paths.borg.cfgread(n)
            if cfg is not None: out.update(external=is_external(cfg),ops=allowed_ops(cfg,n))
        except SystemExit: out.update(external=None,ops=['read'])   # EXTERNAL invalide : les routes d'action refusent
        except Exception: pass
        try:
            st=_bh_paths._status_one(n)
            out.update(build=st.get('build'),rebuild=st.get('rebuild'))
        except (Exception,SystemExit): pass
        # 1.28.1 (story 8 R3) : Bkp en cours depuis moins de BKP_STATUS_TIMEOUT (au-delà : bloqué, le watcher le traite
        # en échec) ; None = lecture impossible — l'UI n'y voit jamais une fin de Bkp.
        # 1.28.4 (story 18) : délai du nick ; dernière ligne du nick seulement (borgHelper 1.0.155, comme Status).
        try: out['bkp_running']=_bh_paths.db.bkp_running_state(n,_bkp_timeout(n))
        except (Exception,SystemExit): out['bkp_running']=None
        # 1.28.2 (story 12 A4) : résultat du dernier Index du nick (CLI, cron ou POST /index) ; None si absent/illisible.
        try: out['index_last']=_bh_paths.db.read_index_last(n)
        except (Exception,SystemExit): out['index_last']=None
        # 1.28.3 (story 15) : dernier Bkp du nick (run_id, début, fin, résultat) — l'UI suit un ▶ Backup par run_id, sans
        # minutage ; None si aucune ligne ou lecture impossible (history.db jamais créée).
        try: out['bkp_last']=_bh_paths.db.last_bkp_status(n)
        except (Exception,SystemExit): out['bkp_last']=None
        return out
    if not GROUPS_HEADER:
        # Fonctionnalité désactivée : pas de restriction par nick ni de périmètre, seuls
        # allow_destructive/allow_downloads (globaux) s'appliquent — 'admin'/scope:null partout
        # reflète cette absence de restriction par groupes pour que l'UI n'ait qu'une seule forme
        # de réponse à traiter, sans cas particulier côté client.
        return {'groups_auth_enabled':False,'borg_cleanup':_borg_cleanup_summary(),
                'nicks':{n:{'level':'admin','read_scope':None,'restore_scope':None,'db_plain':_plain(n),**_state(n)} for n in nicks}}
    user_groups=_parse_groups(request.headers.get(GROUPS_HEADER))
    level_names={0:'none',1:'read',2:'write',3:'admin'}
    result={}
    for n in nicks:
        cfg=_bh_paths.borg.cfgread(n)
        eff=_effective_level(user_groups,cfg) if cfg is not None else 0
        # _resolve_path_scope (donc _parse_groups_paths) n'est JAMAIS catché ici — une config
        # GROUPS_PATHS(_RESTORE) ambiguë doit remonter en 500 non catché, pas être dégradée en
        # silence. Deux périmètres distincts depuis spec-groups-paths-restore : lecture (GROUPS_PATHS)
        # et restauration (GROUPS_PATHS_RESTORE, repli par groupe sur GROUPS_PATHS).
        read_scope=_resolve_path_scope(user_groups,cfg) if cfg is not None else None
        restore_scope=_resolve_path_scope(user_groups,cfg,for_restore=True) if cfg is not None else None
        result[n]={'level':level_names[eff],'read_scope':read_scope,'restore_scope':restore_scope,
                   'db_plain':_plain(n) if eff>0 else []}  # rien révélé d'un nick sans droit
        if eff>0: result[n].update(_state(n))
    # 1.28.5 : état de la machine (pas d'un nick) — seulement pour un admin d'au moins un nick
    admin=any(v['level']=='admin' for v in result.values())
    return {'groups_auth_enabled':True,'borg_cleanup':_borg_cleanup_summary() if admin else None,'nicks':result}

