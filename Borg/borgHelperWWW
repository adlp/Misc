def push_selftest():
    """Équivalent, pour la story push, de `CodecSelfTest` (borgHelper) — convention existante de ce
    projet pour toute vérification DB, adaptée ici car la logique testée (push.db, VAPID, py_vapid)
    est confinée à borgHelperWWW (AD-5 : borgHelper reste stdlib-only, ne peut donc pas l'héberger).
    Vérifie : génération VAPID (une fois, jamais régénérée), CRUD abonnement (création, mise à jour
    des préférences, suppression), calcul d'expires_at (fournie/absente=défaut/« à vie »), clamp de
    BORGHELPERWWW_PUSH_DEFAULT_EXPIRY_DAYS. Opère uniquement sur un fichier SQLite TEMPORAIRE dédié
    (jamais PUSH_DB réel) — nettoyé en `finally`, comme codec_selftest(). Retourne le nombre de
    contrôles en échec (0 = tout OK), affiche OK/FAIL par contrôle.

    ⚠️ Isolation partielle, à la différence de codec_selftest() : par construction de ce fichier
    (tout le module s'initialise au chargement, pas de dispatch de commande précoce comme le `-c
    CodecSelfTest` de borgHelper), le PUSH_DB réel du -C/--cfgfile fourni a déjà été créé/ouvert
    (ensure_push_db()/VAPID) avant que ce flag ne soit lu dans le bloc __main__ ci-dessous — sans
    conséquence (ensure_push_db()/_init_vapid_keys() sont idempotents, jamais destructifs sur un
    fichier existant), mais ce n'est donc pas un self-test qui s'exécute "avant" toute I/O réelle."""
    global PUSH_DB,PUSH_PREFS_FILE
    import tempfile,shutil,datetime as _dt
    from unittest import mock
    results=[]
    def check(name,fn):
        try: ok=bool(fn()); err=''
        except Exception as e: ok=False; err=f" ({type(e).__name__}: {e})"
