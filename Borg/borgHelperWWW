        compta_ok=(read_compta==['/srv/data/compta'] and restore_compta==['/srv/data/compta/archives'])
        # audit : aucune entrée GROUPS_PATHS_RESTORE -> repli sur son entrée GROUPS_PATHS (identique
        # en lecture et en restauration) :
        read_audit=_resolve_path_scope({'audit'},cfg,for_restore=False)
        restore_audit=_resolve_path_scope({'audit'},cfg,for_restore=True)
        audit_ok=(read_audit==restore_audit==['/srv/data/compta'])
        # direction : plusieurs répertoires en lecture ('|'), même repli qu'audit en restauration
        # (pas d'entrée GROUPS_PATHS_RESTORE dédiée) :
        read_direction=_resolve_path_scope({'direction'},cfg,for_restore=False)
        restore_direction=_resolve_path_scope({'direction'},cfg,for_restore=True)
        direction_ok=(sorted(read_direction)==sorted(restore_direction)==['/srv/data/compta','/srv/data/rh'])
        return compta_ok and audit_ok and direction_ok
    check("GROUPS_PATHS_RESTORE : périmètre distinct par groupe, repli sur GROUPS_PATHS si absent (jamais l'inverse)",
          _groups_paths_restore_split_ok)
    def _require_path_in_scope_uses_restore_ok():
        """require_path_in_scope (Restore/RestorePerms/DownloadFile/DownloadTar) applique bien le
        périmètre de RESTAURATION, pas celui de lecture — un chemin autorisé en lecture mais hors du
        périmètre de restauration doit être refusé ici."""
        cfg={'GROUPS_READ':'compta','GROUPS_PATHS':'compta:/srv/data/compta',
             'GROUPS_PATHS_RESTORE':'compta:/srv/data/compta/archives'}
        old_gh,old_cfgread=GROUPS_HEADER,_bh_paths.borg.cfgread
        try:
            globals()['GROUPS_HEADER']='X-Test-Groups'
            _bh_paths.borg.cfgread=lambda n,debug=0: cfg if n=='rbactest' else None
            class _FakeReq:
                headers={'X-Test-Groups':'compta'}
            req=_FakeReq()
            # /srv/data/compta/courrier : dans le périmètre de LECTURE mais hors du périmètre de
            # RESTAURATION (sous-dossier 'archives' uniquement) -> refusé :
            denied=not require_path_in_scope(req,'rbactest','srv/data/compta/courrier')
            # /srv/data/compta/archives/2024 : dans le périmètre de restauration -> autorisé :
            allowed=require_path_in_scope(req,'rbactest','srv/data/compta/archives/2024')
            return denied and allowed
        finally:
            globals()['GROUPS_HEADER']=old_gh
            _bh_paths.borg.cfgread=old_cfgread
    check("require_path_in_scope (Restore/téléchargements) applique GROUPS_PATHS_RESTORE, pas le périmètre de lecture",
          _require_path_in_scope_uses_restore_ok)

    def _treehist_scope_ancestors_ok():
        """TreeHist garde les répertoires parents du périmètre (réduits à une entrée nue), jamais un
        voisin hors périmètre ni un faux parent par simple préfixe de chaîne ; filtrage strict
        inchangé pour Search/TreeFind (_filter_per_nick_listkey)."""
        scope=_canonicalize_scope(['/opt/backups/mysql/'])
        ent=lambda fp,d=True:{'name':fp.rsplit('/',1)[-1],'full_path':fp,'genre':'répertoire','mode':'drwx------',
            'owner':'root','is_dir':d,'events':[{'type':'modified','archive':'a1','date':'2026-01-01'}]}
        def names(prefix,fps):
            data={'h':{'path':prefix,'entries':[ent(fp,not fp.endswith('.sql')) for fp in fps]}}
            return data,_filter_treehist(data,{'h':scope})['h']['entries']
        _,root=names(None,['opt','etc','op'])
        _,opt=names('opt',['opt/backups','opt/other'])
        _,bk=names('opt/backups',['opt/backups/mysql','opt/backups/mysqlx'])
        _,my=names('opt/backups/mysql',['opt/backups/mysql/db.sql'])
        strict=_filter_per_nick_listkey({'h':{'entries':[ent('opt')]}},{'h':scope},'entries')['h']['entries']
        a=root[0] if root else {}
        return ([e['full_path'] for e in root]==['opt'] and a.get('scope_ancestor') is True
                and a['mode'] is None and a['owner'] is None and a['events']==[]
                and [e['full_path'] for e in opt]==['opt/backups']
                and [e['full_path'] for e in bk]==['opt/backups/mysql'] and not bk[0].get('scope_ancestor')
                and bk[0]['events'] and [e['full_path'] for e in my]==['opt/backups/mysql/db.sql']
                and strict==[] and _filter_treehist({'h':{'entries':[ent('etc')]}},{'h':None})['h']['entries'][0]['mode']=='drwx------')
    check("TreeHist : répertoires parents du périmètre GROUPS_PATHS navigables (entrée nue), rien d'autre hors périmètre",
          _treehist_scope_ancestors_ok)

    def _direct_path_access_ok():
        """Accès direct par périmètre (1.20.0) : groupe SANS tier cité dans GROUPS_PATHS -> lecture
        bornée, aucun téléchargement ; cité dans GROUPS_PATHS_RESTORE -> lecture + téléchargement
        bornés ; jamais au-delà du niveau lecture ; tier illimité d'un autre groupe l'emporte ; groupe
