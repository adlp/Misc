def push_selftest():
    """Équivalent, pour la story push, de `CodecSelfTest` (borgHelper) — convention existante de ce
    projet pour toute vérification DB, adaptée ici car la logique testée (push.db, VAPID, py_vapid)
    est confinée à borgHelperWWW (AD-5 : borgHelper reste stdlib-only, ne peut donc pas l'héberger).
    Vérifie : génération VAPID (une fois, jamais régénérée), CRUD abonnement (création, mise à jour
    des préférences, suppression), calcul d'expires_at (fournie/absente=défaut/« à vie »), clamp de
    BORGHELPERWWW_PUSH_DEFAULT_EXPIRY_DAYS. Opère uniquement sur un fichier SQLite TEMPORAIRE dédié
    (jamais PUSH_DB réel) — nettoyé en `finally`, comme codec_selftest(). Retourne le nombre de
    contrôles en échec (0 = tout OK), affiche OK/FAIL par contrôle.

    ⚠️ Isolation partielle, à la différence de codec_selftest() : par construction de ce fichier
    (tout le module s'initialise au chargement, pas de dispatch de commande précoce comme le `-c
    CodecSelfTest` de borgHelper), le PUSH_DB réel du -C/--cfgfile fourni a déjà été créé/ouvert
    (ensure_push_db()/VAPID) avant que ce flag ne soit lu dans le bloc __main__ ci-dessous — sans
    conséquence (ensure_push_db()/_init_vapid_keys() sont idempotents, jamais destructifs sur un
    fichier existant), mais ce n'est donc pas un self-test qui s'exécute "avant" toute I/O réelle."""
    global PUSH_DB
    import tempfile,shutil,datetime as _dt
    from unittest import mock
    results=[]
    def check(name,fn):
        try: ok=bool(fn()); err=''
        except Exception as e: ok=False; err=f" ({type(e).__name__}: {e})"
        print(f"{'OK  ' if ok else 'FAIL'} {name}{err}"); results.append(ok)

    tmpdir=tempfile.mkdtemp(prefix='borghelperwww-push-selftest-')
    test_db=os.path.join(tmpdir,'push-selftest.db')
    old_push_db=PUSH_DB
    PUSH_DB=test_db  # Story 2b : _send_bkp_push/_push_conn ci-dessous doivent taper sur ce fichier
    # temporaire, jamais le PUSH_DB réel — restauré dans le `finally` externe.
    try:
        conn=_open_db(test_db,nick=None,role='admin')
        conn.row_factory=sqlite3.Row
        conn.executescript(_PUSH_DB_SCHEMA_SCRIPT)
        conn.commit()
        try:
            # ── VAPID : génération une fois, jamais régénérée ──
            priv1,pub1=_generate_and_store_vapid_keys(conn)
            check("VAPID : clés générées (non vides, distinctes)",lambda: bool(priv1) and bool(pub1) and priv1!=pub1)
            priv2,pub2=_load_or_generate_vapid_keys(conn)
            check("VAPID : réutilisées si déjà présentes (jamais régénérées)",lambda: (priv1,pub1)==(priv2,pub2))

            # ── CRUD abonnement ──
            conn.execute("""INSERT INTO push_subscriptions
                    (endpoint,p256dh,auth,scope_nicks,notify_start,notify_end,expires_at)
                    VALUES ('ep1','p256','auth1',?,0,1,datetime('now','+30 days'))""",(json.dumps(['n1','n2']),))
            conn.commit()
            row=conn.execute("SELECT * FROM push_subscriptions WHERE endpoint='ep1'").fetchone()
            check("CRUD : création lisible",lambda: row is not None and json.loads(row['scope_nicks'])==['n1','n2'])
            conn.execute("UPDATE push_subscriptions SET notify_start=1,notify_end=0 WHERE endpoint='ep1'")
            conn.commit()
            row=conn.execute("SELECT * FROM push_subscriptions WHERE endpoint='ep1'").fetchone()
            check("CRUD : préférences mises à jour, scope_nicks intact (AD-4)",
                  lambda: bool(row['notify_start']) and not bool(row['notify_end']) and json.loads(row['scope_nicks'])==['n1','n2'])
            conn.execute("DELETE FROM push_subscriptions WHERE endpoint='ep1'")
            conn.commit()
            row=conn.execute("SELECT * FROM push_subscriptions WHERE endpoint='ep1'").fetchone()
            check("CRUD : suppression effective",lambda: row is None)

            # ── scope_nicks via GROUPS_HEADER (_scope_nicks_for_groups, eff>=1) — jamais exercé
            # jusqu'ici : le CRUD ci-dessus insère scope_nicks en SQL brut, et la vérif manuelle
            # (demo.borghelperrc) tourne sans GROUPS_HEADER (court-circuit "return nicks" de
            # _current_scope_nicks, jamais la boucle) ──
            check("scope_nicks (GROUPS_HEADER) : nick accessible inclus, nick sans accès exclu",
                  lambda: _scope_nicks_for_groups(
                      {'grp-lecture'},
                      [('nick-ok',{'GROUPS_READ':'grp-lecture'}),
                       ('nick-refuse',{'GROUPS_READ':'autre-groupe'})])==['nick-ok'])

            # ── expires_at : fournie / absente (défaut) / « à vie » ──
            def _expires_matches(days_value):
                r=conn.execute(f"SELECT {_expires_at_expr(days_value)} AS v").fetchone()
                val=_dt.datetime.strptime(r['v'],'%Y-%m-%d %H:%M:%S')
                delta=(val-_dt.datetime.utcnow()).total_seconds()
                return abs(delta-days_value*86400)<60
            check("expires_at : valeur fournie (5 jours) -> date cohérente",lambda: _expires_matches(5))
            check("expires_at : absente -> défaut serveur (PUSH_DEFAULT_EXPIRY_DAYS)",lambda: _expires_matches(PUSH_DEFAULT_EXPIRY_DAYS))
            check("expires_at : « à vie » -> NULL",lambda: _expires_at_expr(None)=='NULL')

            # ── clamp BORGHELPERWWW_PUSH_DEFAULT_EXPIRY_DAYS ──
            check("clamp : valeur négative -> repli 30",lambda: _clamp_push_default_expiry('-5')==30)
            check("clamp : valeur non numérique -> repli 30",lambda: _clamp_push_default_expiry('abc')==30)
            check("clamp : zéro -> repli 30",lambda: _clamp_push_default_expiry('0')==30)
            check("clamp : valeur valide -> conservée",lambda: _clamp_push_default_expiry('7')==7)

            # ── _resolve_push_expiry_days : borne haute (999999999999 fait déborder SQLite vers NULL
            # sans elle — bug corrigé, voir PUSH_MAX_EXPIRY_DAYS) ──
            check("expiry : None explicite -> à vie",lambda: _resolve_push_expiry_days(None) is None)
            check("expiry : valeur dans les bornes -> conservée",lambda: _resolve_push_expiry_days(5)==5)
            check("expiry : valeur absurde (999999999999) -> repli défaut, jamais « à vie »",
                  lambda: _resolve_push_expiry_days(999999999999)==PUSH_DEFAULT_EXPIRY_DAYS)
            check("expiry : zéro -> repli défaut",lambda: _resolve_push_expiry_days(0)==PUSH_DEFAULT_EXPIRY_DAYS)
            check("expiry : au-delà de PUSH_MAX_EXPIRY_DAYS -> repli défaut",
                  lambda: _resolve_push_expiry_days(PUSH_MAX_EXPIRY_DAYS+1)==PUSH_DEFAULT_EXPIRY_DAYS)
            check("expiry : PUSH_MAX_EXPIRY_DAYS exactement -> conservée (borne incluse)",
                  lambda: _resolve_push_expiry_days(PUSH_MAX_EXPIRY_DAYS)==PUSH_MAX_EXPIRY_DAYS)

            # ── Envoi push réel, Story 2b (spec-notifications-push) : pywebpush mocké ──
            class _FakeResp:
                def __init__(self,code): self.status_code=code; self.text=''
            def _insert_sub(endpoint,nick,notify_start=0,notify_end=1,expires_at=None):
                conn.execute("""INSERT INTO push_subscriptions
                        (endpoint,p256dh,auth,scope_nicks,notify_start,notify_end,expires_at)
                        VALUES (?,?,?,?,?,?,?)""",
                    (endpoint,'p256','auth',json.dumps([nick]),notify_start,notify_end,expires_at))
                conn.commit()
            def _sub_exists(endpoint):
                return conn.execute("SELECT 1 FROM push_subscriptions WHERE endpoint=?",(endpoint,)).fetchone() is not None

            _insert_sub('push-ep-ok','nickPush')
            _insert_sub('push-ep-410','nickPush')
            _insert_sub('push-ep-500','nickPush')
            _insert_sub('push-ep-network','nickPush')
            _insert_sub('push-ep-notifystart-only','nickPush',notify_start=1,notify_end=0)
            _insert_sub('push-ep-expired','nickPush',expires_at="2000-01-01 00:00:00")
            _insert_sub('push-ep-otherscope','otherNick')

            sent_to=[]
            def _fake_webpush(subscription_info,data=None,vapid_private_key=None,vapid_claims=None,**kw):
                ep=subscription_info['endpoint']; sent_to.append((ep,data))
                if ep=='push-ep-ok': return 'ok'
                if ep=='push-ep-410': raise WebPushException("gone",response=_FakeResp(410))
                if ep=='push-ep-500': raise WebPushException("server error",response=_FakeResp(500))
                if ep=='push-ep-network': raise ConnectionError("network down")
                return 'ok'  # push-ep-notifystart-only (test 'start') : envoi simplement réussi

            with mock.patch(f"{__name__}.webpush",side_effect=_fake_webpush):
                _send_bkp_push('nickPush','end','success')

            check("push : envoi tenté pour chaque abonnement matché (type actif, périmètre, non expiré), "
                  "jamais pour un type inactif/périmètre différent/expiré",
                  lambda: {e for e,_ in sent_to}=={'push-ep-ok','push-ep-410','push-ep-500','push-ep-network'})
            check("push : payload JSON contient nick/event/result/timestamp",
                  lambda: all(json.loads(d)['nick']=='nickPush' and json.loads(d)['event']=='end'
                              and json.loads(d)['result']=='success' and 'timestamp' in json.loads(d)
                              for _,d in sent_to))
            check("push : envoi réussi -> abonnement conservé",lambda: _sub_exists('push-ep-ok'))
            check("push : WebPushException status_code=410 -> abonnement désabonné automatiquement",
                  lambda: not _sub_exists('push-ep-410'))
            check("push : WebPushException autre code (500) -> abonnement conservé, jamais désabonné",
                  lambda: _sub_exists('push-ep-500'))
            check("push : exception non-WebPushException (réseau) -> abonnement conservé, jamais désabonné",
                  lambda: _sub_exists('push-ep-network'))

            sent_to.clear()
            with mock.patch(f"{__name__}.webpush",side_effect=_fake_webpush):
                _send_bkp_push('nickPush','start',None)
            check("push : événement 'start' n'envoie qu'aux abonnements notify_start=1 (jamais notify_end seul)",
                  lambda: {e for e,_ in sent_to}=={'push-ep-notifystart-only'})
        finally:
            conn.close()
    finally:
        PUSH_DB=old_push_db
        shutil.rmtree(tmpdir,ignore_errors=True)

    # ── Garde BORGHELPERWWW_* égarée dans .borghelperrc[DEFAULT] (piège réel constaté en prod) ──
    def _stray_keys_warned():
        trap_rc=os.path.join(tmpdir,'trap.borghelperrc')
        os.makedirs(tmpdir,exist_ok=True)
        with open(trap_rc,'w') as f:
            f.write("[DEFAULT]\nBORGHELPERWWW_GROUPS_HEADER = X-GROUPS\nCACHE_DIR = /tmp\n")
        out=io.StringIO()
        with contextlib.redirect_stderr(out):
            _warn_stray_borghelperwww_keys(trap_rc)
        warned=('BORGHELPERWWW_GROUPS_HEADER' in out.getvalue() and '[WARN]' in out.getvalue())
        clean_rc=os.path.join(tmpdir,'clean.borghelperrc')
        with open(clean_rc,'w') as f:
            f.write("[DEFAULT]\nCACHE_DIR = /tmp\n")
        out2=io.StringIO()
        with contextlib.redirect_stderr(out2):
            _warn_stray_borghelperwww_keys(clean_rc)
        silent=(out2.getvalue()=='')
        return warned and silent
    tmpdir=tempfile.mkdtemp(prefix='borghelperwww-strayguard-selftest-')
    try:
        check("garde BORGHELPERWWW_* dans .borghelperrc[DEFAULT] : avertit si présent, silencieux sinon",
              _stray_keys_warned)
    finally:
        shutil.rmtree(tmpdir,ignore_errors=True)

    fails=results.count(False)
    print(f"push selftest : {len(results)-fails}/{len(results)} OK"+(f", {fails} FAIL" if fails else ""))
    return fails

if __name__=='__main__':
    if _SELFTEST_REQUESTED:
        sys.exit(1 if push_selftest() else 0)
    import uvicorn
