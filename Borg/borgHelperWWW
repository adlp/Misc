def _warn_stray_borghelperwww_keys(cfgfile):
    """Garde : une clé BORGHELPERWWW_* posée dans [DEFAULT] de .borghelperrc (piège réel constaté —
    ex. BORGHELPERWWW_GROUPS_HEADER) est silencieusement ignorée par configparser (clé inconnue,
    aucune erreur) : .borghelperrc n'est lu QUE par borgHelper (CLI, par nick) — borgHelperWWW lit
    ses PROPRES réglages uniquement depuis l'environnement ou --conf/BORGHELPERWWW_CONF (voir
    borghelperwww.conf.example), jamais depuis .borghelperrc. Conséquence concrète du piège :
    GROUPS_HEADER ainsi posé laisse le RBAC par groupes désactivé sans aucun signal — X-API-Key seule
    fait foi, accès total pour quiconque a une clé valide."""
    try:
        cp=configparser.ConfigParser(); cp.optionxform=str; cp.read(cfgfile)
    except configparser.Error:
        return  # fichier réellement invalide : cfgread() plus bas donnera l'erreur détaillée
    stray=sorted(k for k in cp.defaults() if k.startswith('BORGHELPERWWW_'))
    if stray:
        print(f"[WARN] {cfgfile} [DEFAULT] contient {', '.join(stray)} — ignoré(s) : borgHelperWWW ne "
              f"lit jamais .borghelperrc pour ses propres réglages (voir borghelperwww.conf.example). "
              f"Si c'est GROUPS_HEADER, le RBAC par groupes reste désactivé sans erreur (accès total "
              f"pour tout X-API-Key valide) — utiliser --conf/BORGHELPERWWW_CONF à la place.",
              file=sys.stderr,flush=True)

