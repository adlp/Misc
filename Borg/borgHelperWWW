def _parse_trusted_proxies(raw):
    """'127.0.0.1, 10.0.0.0/8' -> liste d'ip_network ; '*' -> None (toute IP de confiance). Entrée
    invalide -> ValueError (message explicite au démarrage, jamais une IP client fausse en silence)."""
    raw=(raw or '').strip()
    if raw=='*': return None
    nets=[]
    for part in raw.split(','):
        part=part.strip()
        if not part: continue
        try: nets.append(ipaddress.ip_network(part,strict=False))
        except ValueError: raise ValueError(f"trusted_proxies : {part!r} n'est ni une IP ni un CIDR")
    return nets

try:
    _TRUSTED_PROXY_NETS=_parse_trusted_proxies(os.environ.get('BORGHELPERWWW_TRUSTED_PROXIES','127.0.0.1'))
except ValueError as _e:
    sys.exit(f"BORGHELPERWWW_TRUSTED_PROXIES invalide — {_e}")

def _ip_trusted(ip,nets):
    if nets is None: return True
    try: a=ipaddress.ip_address(ip)
    except ValueError: return False
    return any(a in n for n in nets)

def _client_ip(peer,xff,nets):
    """IP du navigateur (1.25.0) : si la connexion vient d'un proxy de confiance (trusted_proxies),
    remonte X-Forwarded-For de droite à gauche en sautant les proxies de confiance — la première IP
    non fiable est le client (jamais la plus à gauche d'emblée : un client peut la forger). Sinon, l'IP
    de la connexion. Indépendant du mode de lancement (direct ou uvicorn externe)."""
    if not peer: return '-'
    if not xff or not _ip_trusted(peer,nets): return peer
    hops=[h.strip() for h in xff.split(',') if h.strip()]
    for h in reversed(hops):
        if not _ip_trusted(h,nets): return h
    return hops[0] if hops else peer

def _clean_user(value):
    """Valeur du header d'identité : caractères non imprimables retirés (jamais d'injection de ligne
    dans les logs ou le fichier JSON), 256 caractères max ; vide -> None."""
    if value is None: return None
    v=''.join(c for c in value if c.isprintable()).strip()[:256]
    return v or None

def _request_user(request):
    return _clean_user(request.headers.get(USER_HEADER)) if USER_HEADER else None

_SENSITIVE_PARAM=re.compile(r'pass|secret|token|key|pwd',re.I)
def _loggable_path(path,query):
    """Chemin + paramètres pour le journal, valeurs sensibles masquées (ex. /login?repo_passphrase=…,
    que le journal d'accès d'uvicorn affichait en clair)."""
    if not query: return path
    pairs=urllib.parse.parse_qsl(query,keep_blank_values=True)
    return path+'?'+urllib.parse.urlencode([(k,'***' if _SENSITIVE_PARAM.search(k) else v) for k,v in pairs],safe='/:*')
