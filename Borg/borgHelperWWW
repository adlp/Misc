@router.post("/push/test",tags=["mutation"],
             summary="Envoie une notification de TEST à un seul abonnement (endpoint) — vérifie toute la chaîne sans attendre un vrai Bkp")
def push_test(endpoint: str, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    if not _PYWEBPUSH_AVAILABLE or PUSH_VAPID_PRIVATE_KEY is None:
        raise HTTPException(503,detail="Envoi push indisponible sur ce serveur (voir le [WARN] au démarrage de borgHelperWWW)")
    if PUSH_DISABLED:
        raise HTTPException(503,detail="Envoi des notifications suspendu par l'administrateur (BORGHELPERWWW_PUSH_DISABLED)")
    row=_push_row(endpoint)
    if row is None:
        raise HTTPException(404,detail="Aucun abonnement pour cet endpoint")
    payload=json.dumps({'event':'test','nick':None,'result':None,
                        'timestamp':datetime.datetime.now(datetime.timezone.utc).isoformat()})
    try:
        webpush(subscription_info={'endpoint':endpoint,'keys':{'p256dh':row['p256dh'],'auth':row['auth']}},
                data=payload,vapid_private_key=PUSH_VAPID_PRIVATE_KEY,vapid_claims={'sub':PUSH_VAPID_SUB},
                timeout=PUSH_SEND_TIMEOUT,ttl=PUSH_TTL_TEST)
    except WebPushException as e:
        if e.status_code in (404,410):
            with contextlib.suppress(sqlite3.Error,PushPrefsError,OSError): _push_delete_endpoint(endpoint)
            raise HTTPException(410,detail=f"Abonnement expiré côté navigateur (HTTP {e.status_code}) — supprimé, se réabonner")
        raise HTTPException(502,detail=f"Service push du navigateur en erreur (HTTP {e.status_code}) : {e}")
    except Exception as e:
        # Typiquement réseau : service push du navigateur injoignable depuis CE serveur (pare-feu,
        # proxy sortant — requests respecte HTTPS_PROXY) ou délai PUSH_SEND_TIMEOUT dépassé.
        host=urllib.parse.urlsplit(endpoint).hostname or '?'
        raise HTTPException(502,detail=f"Envoi impossible vers le service push {host} depuis ce serveur "
            f"(pare-feu/proxy sortant ?) : {type(e).__name__}: {e}")
    return {'sent':True}

