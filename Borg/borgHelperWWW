@app.on_event("startup")
async def _start_bkp_status_watcher():
    global _bkp_watcher_task
    if not _PYWEBPUSH_AVAILABLE:
        print("[WARN] pywebpush absent — notifications push désactivées (abonnements/API restent "
              "fonctionnels, mais aucun envoi réel n'aura lieu). "
              "'pip3 install pywebpush' (ou dans un venv dédié) pour les activer.",
              file=sys.stderr,flush=True)
    _bkp_watcher_task=asyncio.create_task(_bkp_status_watcher())

@app.on_event("shutdown")
async def _stop_bkp_status_watcher():
    if _bkp_watcher_task is None: return
    _bkp_watcher_task.cancel()
    with contextlib.suppress(asyncio.CancelledError):
        await _bkp_watcher_task

