def _push_deps_hint(err):
    """Explique précisément pourquoi l'envoi push est indisponible, sans jamais renvoyer vers pip
    (choix de déploiement : aucun pip/venv en production, spec-push-vendoring). Trois cas : dossier
    vendor/ absent du déploiement ; un module vendorisé manquant dans vendor/ (copie partielle) ; une
    dépendance système absente (paquet apt à installer)."""
    missing=getattr(err,'name',None) or ''
    if missing.split('.')[0] in _VENDORED_PUSH_MODULES:
        if not _VENDOR_DIR.is_dir():
            return (f"dossier vendor/ introuvable ({_VENDOR_DIR}) — le déployer avec borgHelperWWW "
                    f"(il fait partie du dépôt, aucun pip requis)")
        return (f"module vendorisé '{missing}' absent de {_VENDOR_DIR} — redéployer vendor/ en entier "
                f"depuis le dépôt (aucun pip requis)")
    apt={'aiohttp':'python3-aiohttp','requests':'python3-requests','cryptography':'python3-cryptography'}
    pkg=apt.get(missing.split('.')[0])
    if pkg: return f"dépendance système '{missing}' absente — 'apt install {pkg}'"
    return (f"import impossible ({err}) — paquets système requis : 'apt install python3-aiohttp "
            f"python3-requests python3-cryptography' ; vendor/ attendu dans {_VENDOR_DIR}")

