# ── Notifications push — abonnements (Story 2a, spec-notifications-push) ────────────────────
# Stocke/expose uniquement (jamais d'envoi réel — Story 2b) : clés VAPID (générées plus haut, une
# fois) et abonnements PushSubscription du navigateur (endpoint/keys.p256dh/keys.auth, forme standard
# jamais réinventée). Gérés par `endpoint` (identité stable du navigateur abonné via
# pushManager.getSubscription(), Story 2b) — pas de compte séparé (voir Design Notes du spec).

class PushKeysBody(BaseModel):
    p256dh: str=Field(min_length=1)
    auth: str=Field(min_length=1)

class PushHostPrefs(BaseModel):
    """Réglages d'un host : un champ omis prend la valeur par défaut d'un nouvel abonnement."""
    start: bool=_PUSH_DEFAULT_HOST['start']
    success: bool=_PUSH_DEFAULT_HOST['success']
    error: bool=_PUSH_DEFAULT_HOST['error']

class PushSubscribeBody(BaseModel):
    endpoint: str=Field(min_length=1)
    keys: PushKeysBody
    # 1.21.0 : réglages par host. `defaults` s'applique à chaque host du périmètre absent de `hosts` ;
    # un host de `hosts` hors du périmètre de l'appelant est ignoré (la réponse montre l'effectif).
    defaults: Optional[PushHostPrefs]=None
    hosts: Dict[str,PushHostPrefs]={}
    # Hérités (API < 1.21.0), utilisés seulement si `defaults` est absent : notify_start -> start,
    # notify_end -> success ET error.
    notify_start: Optional[bool]=None
    notify_end: Optional[bool]=None
    expires_in_days: Optional[int]=None  # absent -> défaut serveur ; null explicite -> « à vie »

class PushPatchBody(BaseModel):
    endpoint: str=Field(min_length=1)
    # Hosts fournis : réglages REMPLACÉS pour ces hosts seulement (les autres inchangés) ; un host hors
    # du périmètre de l'abonnement -> 422.
    hosts: Optional[Dict[str,PushHostPrefs]]=None
    # Hérités (API < 1.21.0) : appliqués à TOUS les hosts de l'abonnement.
    notify_start: Optional[bool]=None
    notify_end: Optional[bool]=None
    expires_in_days: Optional[int]=None  # absent -> inchangé ; null explicite -> « à vie »

def _prefs_or_500(fn):
    """Fichier de préférences corrompu/illisible -> 500 explicite (jamais un écrasement silencieux)."""
    try: return fn()
    except (PushPrefsError,OSError) as e:
        raise HTTPException(500,detail=f"Préférences push indisponibles : {e}")

# Borne haute d'expires_in_days (jours) — sans elle, une valeur absurde (ex. 999999999999) fait
# silencieusement déborder `datetime('now','+N days')` côté SQLite vers NULL (« à vie »), au lieu du
# repli documenté sur le défaut serveur. Bornes symétriques : [1, PUSH_MAX_EXPIRY_DAYS].
PUSH_MAX_EXPIRY_DAYS=3650

def _resolve_push_expiry_days(expires_in_days):
    """Résout un `expires_in_days` PRÉSENT dans la requête (POST ou PATCH — l'appelant ne l'invoque
    que quand le champ est dans `__fields_set__`, l'absence ayant une sémantique différente selon la
    route) en `days` final pour `_expires_at_expr` : None (valeur explicite) -> « à vie » ; hors bornes
    [1, PUSH_MAX_EXPIRY_DAYS] (y compris valeurs qui feraient déborder SQLite, ex. 999999999999) ->
    repli sur le défaut serveur, jamais un « à vie » accidentel ; sinon la valeur telle quelle.
    Logique partagée entre push_subscribe et push_subscribe_patch (auparavant dupliquée, ce qui avait
    laissé passer l'absence de borne haute dans une des deux copies)."""
    if expires_in_days is None:
        return None  # « à vie », explicitement demandé
    if not (1<=expires_in_days<=PUSH_MAX_EXPIRY_DAYS):
        return PUSH_DEFAULT_EXPIRY_DAYS  # valeur absurde fournie -> même repli que le défaut serveur
    return expires_in_days

def _push_row(endpoint):
    conn=_push_conn('read')
    try: return conn.execute("SELECT * FROM push_subscriptions WHERE endpoint=?",(endpoint,)).fetchone()
    finally: conn.close()

@router.post("/push/subscribe",tags=["mutation"],
             summary="Créer/rafraîchir un abonnement push — scope_nicks recalculé à chaque appel (réabonnement explicite, AD-4/Design Notes) ; préférences écrites dans le fichier JSON")
def push_subscribe(request: Request, body: PushSubscribeBody, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    scope_nicks=_current_scope_nicks(request)
    if 'expires_in_days' not in body.__fields_set__:
        days=PUSH_DEFAULT_EXPIRY_DAYS  # absent de la requête -> défaut serveur (BORGHELPERWWW_PUSH_DEFAULT_EXPIRY_DAYS)
    else:
        days=_resolve_push_expiry_days(body.expires_in_days)
    conn=_push_conn('write')
    try:
        # Colonnes de préférence héritées : valeurs neutres, plus jamais lues (source de vérité = JSON).
        conn.execute("""INSERT INTO push_subscriptions (endpoint,p256dh,auth,scope_nicks) VALUES (?,?,?,'[]')
                ON CONFLICT(endpoint) DO UPDATE SET p256dh=excluded.p256dh, auth=excluded.auth""",
            (body.endpoint,body.keys.p256dh,body.keys.auth))
        conn.commit()
    finally:
        conn.close()
    if body.defaults is not None:
        base=body.defaults.dict()
    else:
        base=dict(_PUSH_DEFAULT_HOST)
        if body.notify_start is not None: base['start']=body.notify_start
        if body.notify_end is not None: base['success']=base['error']=body.notify_end
    hosts={n:(body.hosts[n].dict() if n in body.hosts else dict(base)) for n in scope_nicks}
    prefs={'scope_nicks':scope_nicks,'hosts':hosts,
           'expires_at':_expires_at_value(days),'updated_at':_utc_now_str()}
    def _set(subs): subs[body.endpoint]=prefs
    _prefs_or_500(lambda: _push_prefs_update(_set))
    row=_push_row(body.endpoint)
    if row is None:
        # TOCTOU : un DELETE concurrent entre l'INSERT et cette relecture — jamais un TypeError 500 brut.
        raise HTTPException(410,detail="Abonnement supprimé entre-temps")
    return _push_sub_dict(row,prefs)

@router.patch("/push/subscribe",tags=["mutation"],
              summary="Modifier les préférences (par host : début/succès/échec ; expiration) d'un abonnement existant — jamais scope_nicks (AD-4)")
def push_subscribe_patch(body: PushPatchBody, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    row=_push_row(body.endpoint)
    if row is None:
        raise HTTPException(404,detail="Aucun abonnement pour cet endpoint — pas de création silencieuse (PATCH != POST)")
    fields_set=body.__fields_set__
    # notify_start/notify_end n'ont pas d'état « null » significatif (un type de notification est
    # actif ou non) — contrairement à expires_in_days, où null explicite a une sémantique claire
    # (« à vie ») : un null explicite ici est rejeté plutôt que traité comme absent.
    for f in ('notify_start','notify_end','hosts'):
        if f in fields_set and getattr(body,f) is None:
            raise HTTPException(422,detail=f"{f} ne peut pas être explicitement null — "
                "omettre le champ pour ne pas le modifier")
    def _patch(subs):
        if body.endpoint not in subs:
            raise HTTPException(409,detail="Préférences absentes du fichier JSON pour cet endpoint "
                "(fichier supprimé/édité ?) — se réabonner (POST /push/subscribe) pour les recréer")
        p=_prefs_entry(subs[body.endpoint])
        if body.hosts:
            outside=sorted(n for n in body.hosts if n not in p['scope_nicks'])
            if outside:
                raise HTTPException(422,detail=f"Host(s) hors du périmètre de cet abonnement : "
                    f"{', '.join(outside)} — périmètre figé à l'abonnement (se réabonner pour le rafraîchir)")
            for n,h in body.hosts.items(): p['hosts'][n]=h.dict()
        for h in p['hosts'].values():
            if 'notify_start' in fields_set: h['start']=body.notify_start
            if 'notify_end' in fields_set: h['success']=h['error']=body.notify_end
        if 'expires_in_days' in fields_set:
            # sort de « à vie », renouvelle, ou y repasse
            p['expires_at']=_expires_at_value(_resolve_push_expiry_days(body.expires_in_days))
        p['updated_at']=_utc_now_str()
        subs[body.endpoint]=p
        return p
    return _push_sub_dict(row,_prefs_or_500(lambda: _push_prefs_update(_patch)))

