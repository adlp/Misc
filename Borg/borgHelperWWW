@app.get("/stats",response_model=CommandResult,tags=["lecture"])
def stats(nick: Optional[str]=None, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    return run_borghelper('stats',nick=nick)

@app.post("/login",response_model=CommandResult,tags=["admin"])
def login(servername: str, nickname: Optional[str]=None, repo: str=Query(...),
          repo_passphrase: str=Query(...,description="Passphrase persistée en clair dans le borghelperrc du serveur, PAS le header X-Borg-Passphrase"),
          keyfile: Optional[str]=None, mountpoint: Optional[str]=None,
          x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=['-s',servername,'-r',repo,'-p',repo_passphrase]
    if keyfile: extra+=['-k',keyfile]
    if mountpoint: extra+=['-m',mountpoint]
    return run_borghelper('login',nick=nickname,extra_args=extra)

@app.get("/lstbkp",response_model=CommandResult,tags=["lecture"])
def lstbkp(nick: str, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    return run_borghelper('lstbkp',nick=nick,cacheable=True)

@app.get("/lstbkpfls",response_model=CommandResult,tags=["lecture"])
def lstbkpfls(nick: str, bid: Optional[str]=None, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=['-b',bid] if bid else []
    return run_borghelper('lstbkpfls',nick=nick,extra_args=extra,cacheable=True)

@app.get("/report",response_model=CommandResult,tags=["lecture"])
def report(nick: str="ALL", n: Optional[int]=Query(default=None,description="n dernières archives"),
           html: bool=False, json_output: bool=Query(default=False,alias="json"),
           offline: bool=Query(default=False,description="diff.db uniquement, aucun appel borg"),
           x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=[]
    if n is not None: extra+=['-N',str(n)]
    if html: extra.append('-l')
    if json_output: extra.append('-j')
    if offline: extra.append('-o')
    # Cacheable uniquement en mode -o (offline) : le mode en ligne interroge le dépôt en direct
    # (borg info), non couvert par l'empreinte cache.db/diff.db.
    return run_borghelper('report',nick=nick,extra_args=extra,passphrase=x_borg_passphrase,cacheable=offline)

@app.get("/diffbkp",response_model=CommandResult,tags=["lecture"])
def diffbkp(nick: str, bid_old: Optional[str]=None, bid_new: Optional[str]=None,
            x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=[]
    if bid_old and bid_new: extra=['-b',f"{bid_old},{bid_new}"]
    elif bid_old: extra=['-b',bid_old]
    return run_borghelper('diffbkp',nick=nick,extra_args=extra,cacheable=True)

@app.get("/restore/perms",response_model=CommandResult,tags=["lecture"],summary="Liste les droits d'un fichier sans restaurer (Restore -L)")
def restore_perms(nick: str, ftor: str, bid: Optional[str]=None, x_api_key: Optional[str]=Header(default=None),
                   x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=['-f',ftor,'-L']
    if bid: extra+=['-b',bid]
    return run_borghelper('restore',nick=nick,extra_args=extra,passphrase=x_borg_passphrase)

@app.post("/restore",response_model=CommandResult,tags=["mutation"],summary="Restaure un fichier/une arborescence sur le disque du serveur borgHelperWWW")
def restore(nick: str, ftor: str, where: str, bid: Optional[str]=None, flat: bool=False,
            x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    extra=['-f',ftor,'-W' if flat else '-w',where]
    if bid: extra+=['-b',bid]
    return run_borghelper('restore',nick=nick,extra_args=extra,passphrase=x_borg_passphrase)

@app.delete("/delbkp",response_model=CommandResult,tags=["mutation"],summary="⚡ Supprime une archive sur le dépôt — irréversible")
def delbkp(nick: str, bid: str, x_api_key: Optional[str]=Header(default=None),
           x_borg_passphrase: Optional[str]=Header(default=None)):
