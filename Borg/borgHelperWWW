def _apply_conf_section(sect,from_rc=False):
    """Comble os.environ depuis une SectionProxy configparser selon _CONF_KEYS — ne touche jamais une
    variable déjà présente (priorité : CLI/env toujours prioritaires sur tout fichier). Factorisé pour
    être partagé par borghelperwww.conf et .borghelperrc[_borgHelperWWW] (spec-
    borghelperrc-www-section) — même règle, deux sources possibles.
    1.32.0 (story 86) : clés de mode (cfgfile, cfgdir, master) en bloc — jamais comblées si un mode est déjà choisi (CLI/env),
    jamais depuis le [_borgHelperWWW] d'un rc (`from_rc` : le rc lu est déjà celui du mode choisi)."""
    mode_set=any(os.environ.get(v) for v in _MODE_ENV)   # revue 1 (row 18) : variable de mode vide = absente
    for _key,_envvar in _CONF_KEYS.items():
        if _envvar in _MODE_ENV:
            if from_rc or mode_set or _key not in sect: continue
            # revue 3 (row 53) : -C seul en jeu (ni cfgdir ni master dans la section) — BORGHELPERWWW_CFGFILE présent, même vide,
            # jamais comblé (comportement de 1.31.19)
            if _envvar=='BORGHELPERWWW_CFGFILE' and _envvar in os.environ and not ({'cfgdir','master'}&set(sect.keys())): continue
            os.environ[_envvar]=sect[_key]
        elif _envvar not in os.environ and _key in sect:
            os.environ[_envvar]=sect[_key]

