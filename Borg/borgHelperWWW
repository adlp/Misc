_UI_FILE=Path(os.environ.get('BORGHELPERWWW_UI_FILE') or (Path(__file__).resolve().parent/'borgHelperWWW_ui.html'))
if not _UI_FILE.is_file():
    sys.exit(f"Interface web introuvable ({_UI_FILE}) — --ui-file ou BORGHELPERWWW_UI_FILE pour surcharger")
_UI_HTML=_UI_FILE.read_text(encoding='utf-8')
_UI_VERSION_MATCH=re.search(r'<!--\s*UI_VERSION:\s*(\S+)',_UI_HTML)
UI_VERSION=_UI_VERSION_MATCH.group(1) if _UI_VERSION_MATCH else 'inconnue'

@app.get("/",response_class=HTMLResponse,include_in_schema=False)
def ui_index():
    return _UI_HTML

@app.get("/version",tags=["lecture"],summary="Versions chargées au démarrage de borgHelperWWW (lui-même + borgHelper + borgHelperWWW_ui.html) — non protégé, aucune donnée sensible")
def version():
    return {'borghelperwww_version':WWW_VERSION,'borghelper_version':BORGHELPER_VERSION,'ui_version':UI_VERSION}

