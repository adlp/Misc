@router.post("/bkp",response_model=CommandResult,tags=["mutation"],
    summary="Lance un backup en tâche de fond (+ indexation automatique) — répond dès le lancement",
    description="⚠️ Asynchrone (rupture de compatibilité, AD-2) : détache le sous-processus et "
        "répond dès son lancement confirmé, jamais à la fin de la sauvegarde. `exitcode=0` "
        "signifie « lancement réussi », pas « sauvegarde réussie » — le résultat réel (succès/"
        "échec) est capté par `bkp_status` et journalisé par le watcher (Story 2 : notification "
        "push). Voir CHANGELOG.md.")
def bkp(nick: str, no_index: bool=False, x_api_key: Optional[str]=Header(default=None),
        x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    # Le sous-processus détaché ne fera remonter aucune erreur de lancement (cfgreaded()/EXCLUDE
    # manquant -> sys.exit avant store_bkp_status_start, invisible côté bkp_status/watcher) : valide
    # ici, de façon synchrone, ce que backup() validerait de toute façon avant le premier signal.
    cfg=_bh_paths.borg.cfgread(nick)
    if cfg is None:
        raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    if 'EXCLUDE' not in cfg.keys():
        raise HTTPException(400,detail=f"EXCLUDE non configuré pour {nick} dans ~/.borghelperrc")
    extra=['-I'] if no_index else []
    try:
        pid=_launch_bkp_detached(nick,extra,x_borg_passphrase)
    except OSError as e:
        raise HTTPException(500,detail=f"Échec du lancement de Bkp pour {nick} : {e}")
    return CommandResult(exitcode=0,
        stdout=f"Sauvegarde démarrée pour {nick} (pid {pid}) — asynchrone, résultat via bkp_status/watcher",
        stderr="")

