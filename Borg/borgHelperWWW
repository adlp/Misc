def _no_response_raised(x):
    """1.31.10 (story 71, D146) : RuntimeError « No response returned. » levée par call_next de BaseHTTPMiddleware LUI-MÊME
    (application finie sans réponse) — jamais une exception de l'application au même texte (relancée telle quelle par call_next,
    sa trace descend dans l'application)."""
    if type(x) is not RuntimeError or str(x)!='No response returned.': return False
    tb=x.__traceback__
    while tb is not None and tb.tb_next is not None: tb=tb.tb_next
    return (tb is not None and tb.tb_frame.f_code.co_name=='call_next'
            and tb.tb_frame.f_code.co_filename.replace(os.sep,'/').endswith('starlette/middleware/base.py'))

