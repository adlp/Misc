# ── Watcher bkp_status (Story 1, étendu Story 2b : spec-notifications-push) ────
# Premier composant de fond de borgHelperWWW : tâche asyncio démarrée via le hook de cycle de vie
# FastAPI (lifespan), un watcher par processus worker uvicorn (--workers 2 déjà documenté) — aucune
# coordination inter-process requise, chaque worker réclame les lignes bkp_status par comparer-et-
# échanger (AD-3), donc deux workers qui tombent sur la même ligne au même moment n'en traitent
# jamais qu'un seul (l'autre voit 0 ligne affectée et passe). Story 2b : la réclamation (début ET
# fin) déclenche désormais un envoi push réel (`_send_bkp_push`, pywebpush) en plus du log serveur
# — remplace la simple journalisation de la Story 1.
def _bkp_timeout(nick):
    """Délai du nick (1.28.4, story 18) : clé rc BKP_STATUS_TIMEOUT du nick ou [DEFAULT], sinon BKP_STATUS_TIMEOUT
    (variable BORGHELPERWWW_BKP_STATUS_TIMEOUT, sinon 6 h) — le même que Status (BorgHelper.bkp_status_timeout).
    Jamais d'exception (watcher, /access)."""
    try:
        bh,b=_bhn(nick); return bh.bkp_status_timeout(b)   # 1.32.0 : rc du nick (mode dossier)
    except (Exception,SystemExit): return BKP_STATUS_TIMEOUT

def _bkp_status_watcher_pass():
    with _rc_snapshot(): return _bkp_status_watcher_pass_1()   # revue 2 (row 33)

def _bkp_status_watcher_pass_1():
    """Un passage d'interrogation : parcourt chaque nick connu, réclame les lignes bkp_status prêtes
    — à la fois le passage de FIN (terminées, ou bloquées depuis plus de BKP_STATUS_TIMEOUT secondes,
    AD-7) et le passage de DÉBUT (Story 2b : `started_at` écrit, aucun délai à attendre) — et envoie
    un push réel pour chaque réclamation que CE worker a effectivement gagnée au CAS."""
    for nick in _nick_list('ALL'):
        try:
            bh,b=_bhn(nick)   # 1.32.0 (story 86) : BorgHelper du rc du nick, nick nu (mode -C : _bh_paths, nick)
            db_path=bh.db.get_diff_db(b)
            bh.db.ensure_diff_db(db_path,create=False)  # AD-12 : jamais créer pour un nick sans historique ; migre une base antérieure (1.0.139)
            hist=bh.db.get_history_db(b)              # bkp_status vit dans history.db (borgHelper 1.0.139) ; absente -> rien
            timeout_s=_bkp_timeout(nick)   # 1.28.4 : délai du nick (clé rc, sinon variable, sinon 6 h)
            for row in bh.db.list_pending_bkp_status(b,timeout_s,hist):
                if not bh.db.claim_bkp_status(b,row['run_id'],hist):
                    continue  # déjà réclamée par un autre worker (CAS perdu) — jamais de double traitement
                result=row['result'] if row['finished_at'] else 'error'  # AD-7 : jamais fini = échec
                # borgHelper >= 1.0.118 : statuts C/E de borg create (absents = inconnus).
                warnings={k:row.get(k) for k in ('changed_during_backup','read_errors')}
                print(f"[watcher] bkp_status (fin) réclamé : nick={nick} run_id={row['run_id']} result={result}"
                      +''.join(f" {k}={v}" for k,v in warnings.items() if v),file=sys.stderr,flush=True)
                _send_bkp_push(nick,'end',result,warnings)
                if not row['finished_at']:
                    # Bloquée au-delà de BKP_STATUS_TIMEOUT (AD-7) : seul le watcher le constate. Un échec
                    # ordinaire est déjà signalé à Sentry par borgHelper lui-même (même réglage) — pas de doublon.
                    sentry_alert('bkp_error',nick,f"Sauvegarde bloquée ou interrompue — {nick} "
                                 f"(sans fin après {timeout_s} s)",bh.borg.cfgread(b),
                                 extra={'run_id':row['run_id'],'timeout_s':timeout_s},release=f"borgHelperWWW@{WWW_VERSION}")
            _reconcile_interrupted(nick)   # 1.31.8 (story 63) : Bkp tué -> rapprochement en fil, fin notifiée aussitôt
            for row in bh.db.list_pending_bkp_status_start(b,hist):
                if not bh.db.claim_bkp_status_start(b,row['run_id'],hist):
                    continue  # déjà réclamée par un autre worker (CAS perdu) — jamais de double traitement
                print(f"[watcher] bkp_status (début) réclamé : nick={nick} run_id={row['run_id']}",
                      file=sys.stderr,flush=True)
                _send_bkp_push(nick,'start',None)
            _check_overdue(nick,db_path)
        except (Exception,SystemExit) as e:
            # Un nick en erreur (DB corrompue, etc.) ne doit jamais aveugler les autres nicks de ce
            # passage — isolation par nick, le passage suivant réessaiera. SystemExit inclus (1.27.6) :
            # les ensure_*_db de borgHelper font sys.exit(1) sur une base occupée/corrompue ; hors de ce
            # filet, il traversait le watcher et arrêtait tout le serveur (boucle asyncio).
            print(f"[watcher] nick={nick} erreur : {'sortie borgHelper (voir message ci-dessus)' if isinstance(e,SystemExit) else e}",
                  file=sys.stderr,flush=True)
            continue
    _storage_alert_pass()   # 1.34.0 (story 87b) : alerte « stockage presque plein », une par franchissement et par stockage

_RECONCILE={}   # (nick, run_id) -> {'state': 'en_cours' | 'fait' | 'à refaire', 'next': monotonic} — par processus
_RECONCILE_LOCK=threading.Lock()
_RECONCILE_RETRY=600   # s : nouvel essai après une vérification impossible (borg list en échec, dépôt absent) — jamais pour
# « passphrase absente » (RK_NOPASS, 1.31.15 : figé, fait — une ligne de journal par processus serveur)

def _reconcile_interrupted(nick):
    """1.31.8 (story 63, A118, décisions de l'utilisateur) : Bkp TUÉ (état de /access : interrompu, rien de vivant, orphelin
    vérifiable — dépôt local) -> `borgHelper -c BkpReconcile -n <nick> -j` dans un fil (un seul en vol par nick, jamais le
    passage bloqué par borg), une fois par Bkp tué (nouvel essai au plus tôt _RECONCILE_RETRY s après une vérification
    impossible — sauf « passphrase absente », RK_NOPASS, 1.31.15 : jamais réessayé par ce processus). Archive de ce run
    écrite : ligne fermée en succès, fin notifiée par le passage de FIN suivant. Rapprochement vérifié sans archive de ce run : fin « échec » réclamée ici (CAS, une seule notification entre workers) + Sentry
    « Sauvegarde interrompue ». État inconnu, dépôt distant (orphelin non vérifiable), Bkp vivant : rien — délai inchangé (AD-7).
    Coût par passage : _bkp_state (gardé : base et marqueurs) ; un borg list par Bkp tué ET par processus serveur (revue : chaque
    worker, chaque redémarrage refait le sien) — jamais après la fin notifiée de ce run (notified_at, durable)."""
    st=_bkp_state(nick); bi=st.get('bkp_interrupted')
    if st.get('bkp_running') is not False or not bi or not bi.get('verifie'): return
    try:
        bh,b=_bhn(nick)   # 1.32.0 : rc du nick
        row=bh.db.get_running_bkp_status(b)
        run_id=(row or {}).get('run_id')
        if not run_id or bh.db.bkp_status_notified(b,run_id): return   # revue : fin déjà notifiée (autre worker, avant redémarrage)
    except (Exception,SystemExit): return
    now=time.monotonic(); key=(nick,run_id)
    with _RECONCILE_LOCK:
        e=_RECONCILE.get(key)
        if e and (e['state'] in ('en_cours','fait') or now<e['next']): return
        if any(k[0]==nick and v['state']=='en_cours' for k,v in _RECONCILE.items()): return   # un seul fil par nick
        if len(_RECONCILE)>500:   # revue 2 : jamais une échéance de nouvel essai perdue (borg list relancé aussitôt)
            [_RECONCILE.pop(k) for k,v in list(_RECONCILE.items()) if v['state']=='fait' or (v['state']=='à refaire' and now>=v['next'])]
        _RECONCILE[key]={'state':'en_cours','next':0.0}
    try: threading.Thread(target=_reconcile_run,args=(nick,run_id),daemon=True,name=f"reconcile-{nick}").start()
    except Exception:
        with _RECONCILE_LOCK: _RECONCILE[key]={'state':'à refaire','next':now+_RECONCILE_RETRY}

def _reconcile_claim_error(nick,run_id):
    """Fin « échec » d'un run dont le rapprochement a VÉRIFIÉ l'absence d'archive : réclamation CAS (une seule notification entre
    workers), push « échec », Sentry « Sauvegarde interrompue ». Exception : propagée (l'appelant réessaie). Revue 2 : claim_bkp_status
    rend False aussi sur une erreur SQLite (avalée, dite) — notified_at relu : toujours vide = réclamation refusée par la base,
    exception (nouvel essai), jamais confondue avec un CAS perdu (autre worker : notified_at posé)."""
    bh,b=_bhn(nick)   # 1.32.0 : rc du nick, nick nu ; notification et Sentry sous le nick exposé
    hist=bh.db.get_history_db(b)
    if not bh.db.claim_bkp_status(b,run_id,hist):
        if not bh.db.bkp_status_notified(b,run_id,hist):
            raise RuntimeError(f"réclamation de la fin refusée par la base (run {run_id[:8]})")
    else:
        print(f"[watcher] bkp_status (fin) réclamé : nick={nick} run_id={run_id} result=error (Bkp interrompu, aucune archive de ce run)",
              file=sys.stderr,flush=True)
        _send_bkp_push(nick,'end','error',{})
        sentry_alert('bkp_error',nick,f"Sauvegarde interrompue — {nick} (borgHelper arrêté, aucune archive de ce Bkp)",
                     bh.borg.cfgread(b),extra={'run_id':run_id},release=f"borgHelperWWW@{WWW_VERSION}")

def _reconcile_run(nick,run_id):
    """Fil de _reconcile_interrupted : BkpReconcile (délai TIMEOUT, 3600 s s'il est illimité : jamais un fil en vol à vie), puis
    fin « échec » de CHAQUE run du compte rendu vérifié sans archive (revue : plusieurs Bkp tués de suite ; revue 2 : chacune isolée,
    celle du run de la décision en dernier). États figés (fin illisible, non vérifiable — dépôt devenu distant) : fait, dit au
    journal — la fin viendra du délai ; vivant/orphelin : revu au passage suivant ; non vérifié, erreur de base, non fermé (revue
    2 : écriture refusée — une ligne fermée ailleurs n'est plus relancée, la garde ne la voit plus), réclamation impossible ou
    refusée : nouvel essai après _RECONCILE_RETRY. Journal : code et dernière ligne [WARN]/[ERREUR] de borgHelper quand rien
    n'est vérifié. 1.31.15 (story 77, D182, décision Q1 de l'utilisateur) : run du compte rendu « passphrase absente »
    (RK_NOPASS — borg list refusé faute de passphrase : nick dont la passphrase n'est donnée qu'à la requête, jamais gardée côté
    serveur ; BkpReconcile hérite de l'environnement du serveur, BORGHELPERC_RUNTIME_PASSPHRASE compris) -> fait, une ligne de
    journal par processus serveur (_RECONCILE : par worker, perdu au redémarrage ou à la purge au-delà de 500), ni nouvel essai
    par ce processus, ni notification d'échec, ni Sentry : la fin vient du délai BKP_STATUS_TIMEOUT, comme un Bkp non vérifiable.
    Avant : borg list refait toutes les 10 min jusqu'au délai."""
    state,nxt='à refaire',_RECONCILE_RETRY
    try:
        argv,env,bare=_argv_env_for('BkpReconcile',nick,['-j'])   # 1.32.0 : -C du rc du nick, nick nu
        proc=_run_group(argv,TIMEOUT or 3600,env)
        try: data=json.loads(proc.stdout or '[]')
        except ValueError: data=[]
        o=next((x for x in data if isinstance(x,dict) and x.get('nick')==bare),None)
        ok=bool(o and o.get('verified')); runs=(o or {}).get('runs') or {}
        rs=runs.get(run_id) if ok else None
        if ok:
            # revue 2 : chaque réclamation isolée ; le run de la décision réclamé EN DERNIER, jamais après un échec — sa fin notifiée
            # arrête la garde de _reconcile_interrupted, qui ne relancerait plus les autres runs restés sans fin
            errs=[]
            for r in sorted((r for r,v in runs.items() if v==RK_ABSENT),key=lambda r: r==run_id):
                if errs and r==run_id: break
                try: _reconcile_claim_error(nick,r)
                except Exception as e: errs.append(f"{r[:8]} : {e}")
            if errs: raise RuntimeError('; '.join(errs))
            if rs in (RK_CLOSED,RK_ABSENT,None): state='fait'   # None : ligne plus ouverte (fermée ailleurs)
            elif rs in (RK_BADEND,RK_UNCHECKABLE):   # figés : la fin viendra du délai (AD-7) — dit au journal
                state='fait'
                print(f"[watcher] nick={nick} Bkp interrompu {run_id[:8]} : {rs} — fin au délai BKP_STATUS_TIMEOUT",file=sys.stderr,flush=True)
            elif rs in (RK_ALIVE,RK_ORPHAN): nxt=0   # état changé depuis la décision : revu au passage suivant
        elif runs.get(run_id)==RK_NOPASS:   # 1.31.15 (story 77, D182, Q1) : figé — rien vérifié, jamais réessayé, rien notifié
            state='fait'
            print(f"[watcher] nick={nick} Bkp interrompu {run_id[:8]} : passphrase absente côté serveur — fin au délai BKP_STATUS_TIMEOUT, "
                  f"sans avis d'échec immédiat (pour le retrouver : passphrase côté serveur — BORG_PASSPHRASE dans le rc, ou POST /login, "
                  f"ou BORGHELPERC_RUNTIME_PASSPHRASE dans l'environnement du serveur)",file=sys.stderr,flush=True)
        if state!='fait':
            why=rs or 'vérification impossible'
            if not ok:
                tail=[l for l in (proc.stderr or '').splitlines() if '[WARN]' in l or '[ERREUR]' in l]
                why+=f" (code {proc.returncode}"+(f" : {tail[-1][:160]}" if tail else '')+")"
            print(f"[watcher] nick={nick} rapprochement du Bkp interrompu {run_id[:8]} : {why} — réessayé"
                  +(f" dans {nxt} s" if nxt else ' au passage suivant'),file=sys.stderr,flush=True)
    except (Exception,SystemExit) as e:
        state,nxt='à refaire',_RECONCILE_RETRY
        print(f"[watcher] nick={nick} rapprochement du Bkp interrompu {run_id[:8]} impossible : {e}",file=sys.stderr,flush=True)
    finally:
        with _RECONCILE_LOCK: _RECONCILE[(nick,run_id)]={'state':state,'next':time.monotonic()+nxt}

def _max_age_bkp(cfg):
    """MAX_AGE_BKP du nick en heures (même clé et même défaut que Report : 25) — valeur illisible ou
    <= 0 -> 25, jamais un crash du watcher."""
    try:
        v=float((cfg.get('MAX_AGE_BKP','25') if cfg is not None else '25') or 25)
        return v if v>0 else 25.0
    except (TypeError,ValueError): return 25.0

def _archive_age_hours(archive_date):
    """Âge en heures d'une date d'archive borg (heure locale naïve, comme d2DateNSince de Report).
    None si illisible."""
    try: d=datetime.datetime.fromisoformat(str(archive_date))
    except ValueError: return None
    if d.tzinfo is not None: d=d.astimezone().replace(tzinfo=None)
    return (datetime.datetime.now()-d).total_seconds()/3600

def _overdue_claim(nick,last_archive,level):
    """Réserve l'envoi d'une alerte de retard (comparer-et-échanger en une seule instruction SQLite,
    sûr entre plusieurs workers uvicorn) : True seulement si ce nick n'a encore jamais été alerté pour
    cette dernière archive, ou à un niveau inférieur. Une nouvelle archive (sauvegarde réussie)
    remplace la ligne au prochain retard — le compteur repart de 1."""
    conn=_push_conn('write')
    try:
        cur=conn.execute(
            "INSERT INTO overdue_alerts (nick,last_archive,level,notified_at) VALUES (?,?,?,datetime('now')) "
            "ON CONFLICT(nick) DO UPDATE SET last_archive=excluded.last_archive,level=excluded.level,"
            "notified_at=excluded.notified_at "
            "WHERE overdue_alerts.last_archive!=excluded.last_archive OR overdue_alerts.level<excluded.level",
            (nick,last_archive,level))
        conn.commit()
        return cur.rowcount==1
    finally:
        conn.close()

def _check_overdue(nick,db_path):
    """(1.26.8 : alerte Sentry SENTRY_ALERTS=overdue en tête, indépendante de tout ce qui suit sur le push.)
    Sauvegarde en retard (1.24.0) : dernière archive connue plus vieille que MAX_AGE_BKP heures
    (même règle que Report, qui marque déjà ce nick en erreur) -> notification push de type ÉCHEC.
    Une alerte au franchissement du seuil, puis un rappel à chaque période MAX_AGE_BKP supplémentaire
    (2x, 3x...), jusqu'à la prochaine archive. Rien si aucune archive connue, si un Bkp est en cours
    (il peut simplement être long ; bloqué au-delà de BKP_STATUS_TIMEOUT, il est déjà traité en
    échec ; 1.31.5 : au sens de Status, _bkp_state — vivant, en attente de l'Index, borg create orphelin ; un Bkp tué sans
    rien de vivant ne suspend plus l'alerte), si l'envoi push est indisponible, ou si personne n'est abonné aux échecs de ce host —
    dans ces trois derniers cas l'alerte n'est PAS consommée : un abonnement pris pendant le retard
    reçoit l'alerte au passage suivant, pas seulement au rappel d'après."""
    if DIR_MODE and nick.partition(':')[0] in _RC['suspended']: return   # décision 10 : préfixe réattribué, alertes suspendues
    bh,b=_bhn(nick)   # 1.32.0 : rc du nick ; réservation et notification sous le nick exposé
    last=bh.db.last_archive_stat(b,db_path)
    if last is None: return
    archive,archive_date=last
    age=_archive_age_hours(archive_date)
    cfg=bh.borg.cfgread(b)
    max_age=_max_age_bkp(cfg)
    if age is None or age<=max_age: return
    r=_bkp_state(nick)['bkp_running']   # 1.31.5 (story 59) : état de Status — Bkp tué sans rien de vivant : alerte possible
    if r or r is None: return   # revue, décision de l'utilisateur : état inconnu -> suspendue (jamais « aucun Bkp »)
    level=int(age//max_age)
    # Alerte Sentry (1.26.8, SENTRY_ALERTS=overdue) : canal indépendant du push — réservation propre
    # ('<nick>#sentry' dans overdue_alerts), mêmes rappels à chaque période MAX_AGE_BKP.
    if 'overdue' in _sentry_alert_kinds(cfg) and _overdue_claim(f"{nick}#sentry",archive,level):
        sentry_alert('overdue',nick,f"Sauvegarde en retard — {nick} : dernière il y a {age:.0f} h "
                     f"(seuil MAX_AGE_BKP {max_age:g} h{', rappel' if level>1 else ''})",cfg,
                     extra={'age_hours':round(age,1),'max_age_hours':max_age,'level':level},
                     release=f"borgHelperWWW@{WWW_VERSION}")
    if not _PYWEBPUSH_AVAILABLE or PUSH_VAPID_PRIVATE_KEY is None: return
    if _push_muted(nick): return  # pause : alerte NON consommée, envoyée à la reprise si le retard persiste
    if not _push_subscriptions_for(nick,'error'): return
    if not _overdue_claim(nick,archive,level): return
    print(f"[watcher] sauvegarde en retard : nick={nick} dernière archive il y a {age:.1f} h "
          f"(MAX_AGE_BKP={max_age:g} h, alerte n°{level})",file=sys.stderr,flush=True)
    _send_bkp_push(nick,'overdue','error',{'age_hours':round(age,1),'max_age_hours':max_age,
                                           'last_backup':str(archive_date),'reminder':level>1})

_STORAGE_PUSH_TRIES=5          # revue 87b (row 71) : envois d'un franchissement à un abonné au plus (échecs transitoires)
_STORAGE_PUSH_BACKOFF=60       # s : attente avant le 3e essai, doublée ensuite (le 2e : passage suivant du watcher)
_STORAGE_PUSH_LEASE=60         # s : `retry_at` posé AVANT l'envoi (revue 87b row 78) — envoi interrompu ou écriture d'après ratée :
                               # renvoyé passé ce délai, jamais perdu

def _storage_claim(key,crossing):
    """1.34.0 (story 87b) : réserve l'envoi push d'une alerte « stockage presque plein » (comparer-et-échanger en une instruction,
    sûr entre workers uvicorn) -> (réservé, essais déjà faits) : réservé seulement si ce franchissement (`crossing`, « <numéro>|<date> »
    de l'état de borgHelper) n'a jamais été notifié à cet abonné pour ce stockage (`key` : `<préfixe>|<storage_id>|<endpoint>` —
    décision 13 : suivi par stockage ET par abonné, comme le retard), ou s'il attend un nouvel essai échu (`retry_at`, row 71).
    Revue 87b (row 48) : lu d'abord — déjà notifié, essai pas encore échu : rien écrit (passe du watcher)."""
    conn=_push_conn('read')
    try: r=conn.execute("SELECT crossing,attempts,retry_at FROM storage_alerts WHERE storage=?",(key,)).fetchone()
    finally: conn.close()
    if r is not None and r[0]==crossing:
        if r[2] is None or r[2]>_utc_now_str(): return False,r[1]
        conn=_push_conn('write')
        try:
            cur=conn.execute(f"UPDATE storage_alerts SET retry_at=datetime('now','+{int(_STORAGE_PUSH_LEASE)} seconds'),notified_at=datetime('now') "
                             "WHERE storage=? AND crossing=? AND retry_at=?",(key,crossing,r[2]))
            conn.commit()
            return cur.rowcount==1,r[1]
        finally: conn.close()
    conn=_push_conn('write')
    try:
        cur=conn.execute(
            f"INSERT INTO storage_alerts (storage,crossing,notified_at,attempts,retry_at) VALUES (?,?,datetime('now'),0,"
            f"datetime('now','+{int(_STORAGE_PUSH_LEASE)} seconds')) "
            "ON CONFLICT(storage) DO UPDATE SET crossing=excluded.crossing,notified_at=excluded.notified_at,attempts=0,retry_at=excluded.retry_at "
            "WHERE storage_alerts.crossing!=excluded.crossing",(key,crossing))
        conn.commit()
        return cur.rowcount==1,0
    finally:
        conn.close()

def _storage_claim_done(key,crossing):
    """Revue 87b (row 78) : envoi parti (ou refusé pour de bon, ou abandonné) -> `retry_at` effacé (servi) ; seulement si la ligne
    porte encore CE franchissement."""
    conn=_push_conn('write')
    try:
        conn.execute("UPDATE storage_alerts SET retry_at=NULL WHERE storage=? AND crossing=?",(key,crossing)); conn.commit()
    finally:
        conn.close()

def _storage_claim_retry(key,crossing,attempts):
    """Revue 87b (rows 58, 71) : envoi push en échec transitoire (5xx, 429, réseau) -> nouvel essai programmé (comparer-et-échanger :
    seulement si la ligne porte encore CE franchissement) : passage suivant, puis attente doublée depuis _STORAGE_PUSH_BACKOFF ;
    abandon après _STORAGE_PUSH_TRIES envois. -> True si un essai reste programmé."""
    n=attempts+1
    if n>=_STORAGE_PUSH_TRIES: return False
    wait=0 if n==1 else _STORAGE_PUSH_BACKOFF*2**(n-2)
    conn=_push_conn('write')
    try:
        conn.execute(f"UPDATE storage_alerts SET attempts=?,retry_at=datetime('now','+{int(wait)} seconds') WHERE storage=? AND crossing=?",
                     (n,key,crossing))
        conn.commit(); return True
    finally:
        conn.close()

def _storage_claims_purge(conn,endpoints):
    """Revue 87b (row 48) : réservations d'alerte de stockage (clé `<préfixe>|<storage_id>|<endpoint>`) des abonnements retirés —
    purgées avec eux (expirés, désabonnés, morts) ; `conn` : connexion d'écriture de push.db (commit à l'appelant)."""
    conn.executemany("DELETE FROM storage_alerts WHERE length(storage)>length(?)+1 AND substr(storage,length(storage)-length(?)+1)=? "
                     "AND substr(storage,length(storage)-length(?),1)='|'",[(ep,ep,ep,ep) for ep in endpoints])

def _storage_rcs():
    """(préfixe, BorgHelper, {nick nu: nick exposé}) de chaque rc servi : mode -C ('', BorgHelper du rc par _bhn, nicks du rc ; aucun
    nick : rien) ; mode dossier : chaque rc disponible, préfixe suspendu (décision 10 de la story 86) écarté."""
    if not DIR_MODE:
        ns=_nick_list('ALL')
        return [('',_bhn(ns[0])[0],{n:n for n in ns})] if ns else []
    return [(e.prefix,e.bh,{b:f"{e.prefix}:{b}" for b in _rc_bare_nicks(e)}) for e in _rc_state().entries.values()
            if e.prefix not in _RC['suspended']]

def _storage_alert_pass():
    """1.34.0 (story 87b, décisions 4 et 6 de l'utilisateur) : alerte push « stockage presque plein », UNE par franchissement et par
    stockage (une seule pour plusieurs nicks, qui les cite). Source : état d'alerte écrit par borgHelper à la fin d'un Bkp
    (CACHE_DIR/<préfixe>-storage-alert.json de chaque rc : 'triggered', `crossing`, `since`, `nicks` = nicks dont le dépôt dépasse
    son seuil, décisions 8 et 11) ; jamais ssh ni borg. Pour chaque stockage déclenché et chaque abonnement au type « échec » d'au
    moins un de ces nicks (hôte par hôte, comme le retard), nick en pause (PUSH_MUTE, préfixe réattribué) écarté : réservation CAS
    par (stockage, abonné) (_storage_claim, décision 13) puis UN push, abonné par abonné (revue 87b row 48), qui ne cite que les
    nicks de son périmètre (jamais un nick qu'il ne suit pas) avec les chiffres du dépôt le plus plein parmi eux (`views` de l'état,
    row 31) et `storage_key` (`<préfixe>|<storage_id>`, étiquette de notification du SW, row 49). pywebpush absent, abonné sans nick actif (pause comprise), abonné venu ensuite : alerte NON consommée pour
    lui — reçue au passage suivant si le stockage est toujours au-dessus (comme le retard). Sentry : envoyé par borgHelper au
    franchissement (jamais ici). Erreur d'un rc : journalisée, les autres rc continuent."""
    if not _PYWEBPUSH_AVAILABLE or PUSH_VAPID_PRIVATE_KEY is None: return
    served=set(); keep={p_ for p_ in (_RC.get('suspended') or ())} if DIR_MODE else set()
    try: rcs=_storage_rcs()
    except (Exception,SystemExit) as x: print(f"[watcher] alerte de stockage : rc servis : erreur {x}",file=sys.stderr,flush=True); return
    if DIR_MODE:   # revue 87b (row 67) : rc listé mais indisponible (illisible, absent un instant) : ses réservations gardées
        try: keep|=set(_rc_state().unavailable)
        except (Exception,SystemExit): return
    for pfx,bh,mp in rcs:
        try:
            st=_state_load(_storage_alert_path(bh.db),strict=True)
            if st is None: keep.add(pfx); st={}   # illisible : rien envoyé, ses réservations gardées
            served|={f"{pfx}|{sid}" for sid in st}
            for sid,e in sorted(st.items()):
                if e.get('state')!='triggered': continue
                nicks=[mp[n] for n in (e.get('nicks') if isinstance(e.get('nicks'),list) else []) if isinstance(n,str) and n in mp]
                if not nicks: continue
                prefs=_push_prefs_load()['subscriptions']; now=_utc_now_str(); per={}
                live=[n for n in nicks if not _push_muted(n)]
                for ep,raw in prefs.items():
                    p_=_prefs_entry(raw)
                    if p_['expires_at'] is not None and p_['expires_at']<=now: continue
                    seen=[n for n in live if p_['hosts'].get(n,{}).get('error')]
                    if seen: per[ep]=seen
                if not per: continue
                crossing=f"{e.get('crossing')}|{e.get('since')}"
                conn=_push_conn('read')
                try: rows={r['endpoint']:r for r in conn.execute(f"SELECT * FROM push_subscriptions WHERE endpoint IN ({','.join('?'*len(per))})",list(per))}
                finally: conn.close()
                lab=e.get('label'); m_=re.fullmatch(r'tunnel non résolu \((.*)\)',lab) if isinstance(lab,str) else None
                if m_ and m_.group(1) in mp: lab=f"tunnel non résolu ({mp[m_.group(1)]})"   # revue 87b row 44 : jamais un nick nu
                views=e.get('views') if isinstance(e.get('views'),dict) else {}
                inv={v:k for k,v in mp.items()}; n_sent=0
                for ep,row in rows.items():   # revue 87b row 48 : réserver puis envoyer, abonné par abonné
                    key=f"{pfx}|{sid}|{ep}"; got,tries=_storage_claim(key,crossing)
                    if not got: continue   # décision 13 : par (stockage, abonné)
                    # revue 87b row 31 : chiffres du dépôt le plus plein parmi les nicks de CET abonné (vue par nick de l'état) ;
                    # row 59 : aucune vue de ses nicks -> chiffres omis (jamais ceux d'un nick hors de son périmètre)
                    vs=[views[inv[n]] for n in per[ep] if isinstance(views.get(inv.get(n)),dict)]
                    fig=max(vs,key=lambda v:(v.get('pct') or 0) if isinstance(v.get('pct'),(int,float)) else 0) if vs else {}
                    data={'nick':per[ep][0],'event':'storage','result':'error','storage':lab,'storage_key':f"{pfx}|{sid}",'nicks':per[ep],
                          'timestamp':datetime.datetime.now(datetime.timezone.utc).isoformat()}
                    data.update({k:fig.get(k) for k in ('pct','free','size','days_left','source','measured_at') if fig.get(k) is not None})
                    try: res_=_push_deliver([row],json.dumps(data,ensure_ascii=False),per[ep][0],'storage')
                    except (Exception,SystemExit) as x_:   # row 73 : panne de l'envoi d'UN abonné -> les suivants servis, lui retenté
                        print(f"[watcher] push: erreur envoi stockage : {x_}",file=sys.stderr,flush=True); res_='retry'
                    if res_ is True: n_sent+=1
                    try:   # revue 87b (row 78) : écriture d'après dans son propre try — ratée : bail en place, renvoyé, jamais perdu
                        if res_=='retry' and _storage_claim_retry(key,crossing,tries): pass   # rows 58, 71 : 5xx, 429, réseau
                        else:
                            if res_=='retry': print(f"[watcher] push: alerte de stockage abandonnée après {_STORAGE_PUSH_TRIES} essais",
                                                    file=sys.stderr,flush=True)
                            _storage_claim_done(key,crossing)
                    except (Exception,SystemExit) as x_:
                        print(f"[watcher] push: alerte de stockage : suivi non écrit ({x_}) — renvoyée après {_STORAGE_PUSH_LEASE} s",
                              file=sys.stderr,flush=True)
                if n_sent: print(f"[watcher] stockage presque plein : {lab} (nicks {', '.join(nicks)}, franchissement {e.get('crossing')}) "
                                 f"— {n_sent} abonnement(s)",file=sys.stderr,flush=True)
        except (Exception,SystemExit) as x:
            keep.add(pfx)
            print(f"[watcher] alerte de stockage{f' (rc {pfx})' if pfx else ''} : erreur {x}",file=sys.stderr,flush=True)
    if not DIR_MODE and not rcs: return   # row 67 : -C sans nick lu (rc vide ou illisible un instant) : jamais de purge
    try: _storage_claims_stale(served,keep)
    except (Exception,SystemExit) as x: print(f"[watcher] alerte de stockage : purge des réservations : erreur {x}",file=sys.stderr,flush=True)

def _storage_claims_stale(live,keep):
    """Revue 87b (row 63) : réservations (`<préfixe>|<storage_id>|<endpoint>`) d'un stockage absent de tout état servi (entrée
    purgée ou retirée par borgHelper, rc retiré) -> supprimées ; préfixes de `keep` (état illisible, rc en erreur ou suspendu)
    gardés. Lecture d'abord : rien à retirer, rien écrit."""
    conn=_push_conn('read')
    try: keys=[r[0] for r in conn.execute("SELECT storage FROM storage_alerts")]
    finally: conn.close()
    stale=[k for k in keys for p_ in [k.split('|',2)] if len(p_)==3 and p_[0] not in keep and f"{p_[0]}|{p_[1]}" not in live]
    if not stale: return 0
    conn=_push_conn('write')
    try: conn.executemany("DELETE FROM storage_alerts WHERE storage=?",[(k,) for k in stale]); conn.commit()
