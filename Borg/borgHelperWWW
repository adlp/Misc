class _AbortableResponse:
    """1.30.2 (story 40, A83) : réponse relayée par le middleware ; si le corps a posé `request.state.stream_aborted` (borg en
    échec pendant un téléchargement), le dernier message de corps (fin de transfert) n'est jamais envoyé — uvicorn ferme la
    connexion sur une réponse incomplète et le client voit une erreur.
    1.31.10 (story 71, D143, décision de l'utilisateur) : `log` (réponse en flux, `request.state.stream_log` posé par
    _borg_stream) -> appelé UNE fois à la fin réelle de l'envoi avec l'issue : « (flux coupé) » (stream_aborted, ou exception
    hors envoi), « (client parti) » (envoi qui lève, fin de transfert non envoyée, ou corps jamais arrivé à sa fin —
    `stream_done` absent : sous starlette 1.7 le middleware envoie la fin de transfert même après le départ du client, à
    uvicorn qui l'ignore), « » (complet) ; tâche annulée pendant un arrêt du serveur (_STOPPING) avant la fin : « (flux coupé) »
    (arrêt demandé sans annulation : règles ordinaires). Ordre : avant la réponse, flux coupé, annulée à l'arrêt, envoi qui
    lève, autre exception, fin non atteinte, complet. `gone` (Request.is_disconnected du middleware) : client déjà parti quand l'en-tête est
    relayé (starlette 1.7 : l'en-tête est produit, uvicorn l'ignore — mesuré, s71) -> statut 499, « (client parti avant la
    réponse) », comme le chemin RuntimeError de starlette 0.18 ; en-tête relayé tel quel. Sonde par un receive annulé aussitôt :
    une requête GET sans corps (/download/*) n'y perd rien."""
    def __init__(self,resp,log=None,gone=None): self.resp=resp; self.status_code=resp.status_code; self.log=log; self.gone=gone
    async def __call__(self,scope,receive,send):
        fin=[False]; send_err=[False]; before=[False]
        async def send_w(msg):
            if msg.get('type')=='http.response.start' and self.gone is not None:
                # sonde (revue story 71) : toute erreur = « pas parti » — jamais un téléchargement sain cassé pour une ligne de
                # journal. Elle peut consommer un http.disconnect : sans perte, uvicorn le redonne à chaque receive suivant
                try: before[0]=bool(await self.gone())
                except Exception: before[0]=False
            last=msg.get('type')=='http.response.body' and not msg.get('more_body',False)
            if last and (scope.get('state') or {}).get('stream_aborted'): return
            try: await send(msg)
            except BaseException: send_err[0]=True; raise
            if last: fin[0]=True
        if self.log is None: return await self.resp(scope,receive,send_w)
        failed=False; cancelled=False
        try: await self.resp(scope,receive,send_w)
        except asyncio.CancelledError: cancelled=True; raise   # revue story 71 : seule une annulation réelle vaut arrêt
        except Exception: failed=True; raise
        finally:
            stt=scope.get('state') or {}; status=self.status_code
            if before[0]: status=499; issue=' (client parti avant la réponse)'
            elif stt.get('stream_aborted'): issue=' (flux coupé)'
            elif cancelled and _STOPPING[0] and not (fin[0] and stt.get('stream_done')): issue=' (flux coupé)'   # arrêt : tâche annulée
            elif send_err[0]: issue=' (client parti)'
            elif failed: issue=' (flux coupé)'
            elif not (fin[0] and stt.get('stream_done')): issue=' (client parti)'
            else: issue=''
            self.log(status,issue)

class _NoResponse:
    """1.31.10 (story 71, D146) : client parti avant la réponse — rien à envoyer (uvicorn ignore tout envoi après la perte de
    connexion) ; statut journalisé 499."""
    status_code=499
