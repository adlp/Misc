def _warn_stray_borghelperwww_keys(cfgfile):
    """Garde : une clé BORGHELPERWWW_* posée NUE dans [DEFAULT] de .borghelperrc (piège réel constaté
    — ex. BORGHELPERWWW_GROUPS_HEADER) est silencieusement ignorée par configparser (clé inconnue,
    aucune erreur) : [DEFAULT] de .borghelperrc n'est lu QUE par borgHelper (CLI, par nick). Ne
    concerne QUE le [DEFAULT] réel (cp.defaults()) — [_borgHelperWWW] (spec-
    borghelperrc-www-section) est une section ORDINAIRE distincte, jamais scannée ici, aucun faux
    positif sur ce mécanisme légitime. Conséquence concrète du piège : GROUPS_HEADER ainsi posé
    laisse le RBAC par groupes désactivé sans aucun signal — X-API-Key seule fait foi, accès total
    pour quiconque a une clé valide."""
    try:
        cp=configparser.ConfigParser(); cp.optionxform=str; cp.read(cfgfile)
    except configparser.Error:
        return  # fichier réellement invalide : cfgread() plus bas donnera l'erreur détaillée
    stray=sorted(k for k in cp.defaults() if k.startswith('BORGHELPERWWW_'))
    if stray:
        print(f"[WARN] {cfgfile} [DEFAULT] contient {', '.join(stray)} — ignoré(s) : borgHelperWWW ne "
              f"lit jamais [DEFAULT] pour ses propres réglages. Utiliser --conf/BORGHELPERWWW_CONF "
              f"(borghelperwww.conf.example), ou une section [_borgHelperWWW] dans ce même "
              f"fichier (clés en minuscule, ex. groups_header = X-Groups — jamais BORGHELPERWWW_*). "
              f"Si c'est GROUPS_HEADER, le RBAC par groupes reste désactivé sans erreur d'ici là "
              f"(accès total pour tout X-API-Key valide).",
              file=sys.stderr,flush=True)

