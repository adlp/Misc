def _generate_and_store_vapid_keys(conn):
    """Génère une nouvelle paire de clés VAPID (courbe EC P-256) et la persiste dans push_vapid_keys
    (id=1). Format de stockage : brut base64url (b64urlencode d'un entier 32 octets pour la privée,
    du point non compressé pour la publique) — compatible tel quel avec `py_vapid.Vapid.from_string()`/
    `from_raw()` (Story 2b, envoi réel via pywebpush) ET avec `applicationServerKey` côté navigateur
    pour la clé publique (`PushManager.subscribe()`, Story 2b) — pas de PEM, pas de ré-encodage requis
    dans un sens comme dans l'autre.

    N'est JAMAIS appelée si une ligne existe déjà (voir _load_or_generate_vapid_keys) — Non-goal du
    spec : aucune régénération automatique (une rotation invaliderait tous les abonnements existants).
    `INSERT ... ON CONFLICT(id) DO NOTHING` : filet en cas de course entre deux workers uvicorn qui
    démarreraient exactement en même temps sur un push.db tout neuf — le perdant relit simplement la
    ligne gagnante plutôt que d'écraser une paire déjà en usage."""
    from py_vapid import Vapid
    from py_vapid.utils import b64urlencode, num_to_bytes
    from cryptography.hazmat.primitives import serialization
    v=Vapid(); v.generate_keys()
    priv=b64urlencode(num_to_bytes(v.private_key.private_numbers().private_value,32))
    pub=b64urlencode(v.public_key.public_bytes(serialization.Encoding.X962,serialization.PublicFormat.UncompressedPoint))
    conn.execute("INSERT INTO push_vapid_keys (id,private_key,public_key) VALUES (1,?,?) "
                 "ON CONFLICT(id) DO NOTHING",(priv,pub))
    conn.commit()
    row=conn.execute("SELECT private_key,public_key FROM push_vapid_keys WHERE id=1").fetchone()
    return row[0],row[1]

def _load_or_generate_vapid_keys(conn):
    """Réutilise la paire déjà présente (id=1) sans y toucher ; en génère une seule fois si absente."""
    row=conn.execute("SELECT private_key,public_key FROM push_vapid_keys WHERE id=1").fetchone()
    if row is not None: return row[0],row[1]
    return _generate_and_store_vapid_keys(conn)

def _init_vapid_keys():
