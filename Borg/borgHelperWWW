# ── Autorisation par groupes (reverse proxy OIDC/auth_request, ex. nginx) ──────────────────────
# Complémentaire à X-API-Key (jamais un remplacement : X-API-Key reste requis sur toutes les routes
# via require_api_key). Désactivée par défaut (GROUPS_HEADER absent) — comportement inchangé. Une
# fois activée (BORGHELPERWWW_GROUPS_HEADER pointe sur le header posé par le reverse proxy, ex.
# X-Groups), chaque route est classée lecture/écriture/admin (_ROUTE_LEVELS) et chaque nick cible
# porte trois listes de groupes dans son .borghelperrc — GROUPS_ADMIN, GROUPS_WRITE, GROUPS_READ
# (repli sur [DEFAULT] comme tout autre réglage .borghelperrc) — hiérarchiques : appartenir à un
# groupe de GROUPS_ADMIN donne aussi accès écriture et lecture sur ce nick, GROUPS_WRITE donne aussi
# accès lecture, sans avoir à répéter le nom du groupe dans les trois listes.
#
# ⚠️ Le header n'est vérifié que pour sa PRÉSENCE/valeur — pas pour sa provenance : ce mécanisme
# suppose que borgHelperWWW n'est atteignable QUE via le reverse proxy de confiance qui pose ce
# header (bind sur 127.0.0.1 + reverse proxy sur la même machine, ou pare-feu équivalent), exactement
# la même hypothèse que le déploiement documenté pour X-Forwarded-For (voir README.md).
_LEVEL_KEYS={3:'GROUPS_ADMIN',2:'GROUPS_WRITE',1:'GROUPS_READ'}
_LEVEL_NAMES={1:'lecture',2:'écriture',3:'admin'}
# Clefs .borghelperrc du périmètre de chemin par groupe (Story 1.1 ; scission lecture/restauration :
# spec-groups-paths-restore) — mêmes conventions per-nick/repli [DEFAULT] que GROUPS_ADMIN/WRITE/READ,
# mais pas hiérarchiques : une restriction orthogonale au tier, jamais un tier de plus.
# GROUPS_PATHS régit la LECTURE (Search/TreeFind/FileHist/TreeHist/Report/DiffBkp/DuIdx/IdxTop/
# DiffTop) ; GROUPS_PATHS_RESTORE régit la RESTAURATION (Restore/RestorePerms/DownloadFile/
# DownloadTar) — repli PAR GROUPE sur GROUPS_PATHS si un groupe n'a pas d'entrée dans
# GROUPS_PATHS_RESTORE (rétro-compatible : une config qui n'utilise que GROUPS_PATHS restreint la
# restauration de la même façon que la lecture, comme avant cette scission). Caractères réservés
# (séparateurs de la syntaxe 'groupe:/a|/b, groupe2:/c') — voir _parse_groups_paths.
_GROUPS_PATHS_KEY='GROUPS_PATHS'
_GROUPS_PATHS_RESTORE_KEY='GROUPS_PATHS_RESTORE'
_GP_RESERVED_CHARS=(':','|',',')
_ROUTE_LEVELS={
    '/stats':1,'/lstbkp':1,'/lstbkpfls':1,'/report':1,'/diffbkp':1,'/search':1,'/filehist':1,
    '/treehist':1,'/treefind':1,'/duidx':1,'/cacheinfo':1,'/idxtop':1,'/difftop':1,
    '/repohistory':1,'/archivehistory':1,
    '/restore/perms':1,'/download/file':1,'/download/tar':1,
    '/bkp':2,'/index':2,'/restore':2,'/cacheclean':2,
    '/prune':3,'/delbkp':3,'/idxpurge':3,'/init':3,'/key':3,
    # Story 2a (spec-notifications-push) : ces routes n'ont PAS de paramètre de requête `nick` (un
    # abonnement porte plusieurs nicks, figés dans scope_nicks à la création — jamais un nick unique
    # en paramètre) — _check_group_access (voir plus haut, `nick_param is None: return`) les laisse
    # donc passer sans jamais consulter cette entrée, exactement comme /access. Cataloguées ici pour
    # la documentation/cohérence uniquement, jamais consultées en pratique pour ces chemins.
    '/push/subscribe':1,'/push/subscriptions':1,'/push/test':1,
}

def _parse_groups(header_value):
    if not header_value: return set()
    return {g.strip() for g in header_value.split(',') if g.strip()}

def _effective_level(user_groups,cfg):
    """cfg : SectionProxy (.borghelperrc[nick], avec repli [DEFAULT] déjà natif à configparser) ou
    un dict-like équivalent pour le cas Login/nick inexistant. 0 si aucun accès.

    Accès DIRECT par périmètre (borgHelperWWW 1.20.0) : un groupe sans aucun tier mais cité dans
    GROUPS_PATHS et/ou GROUPS_PATHS_RESTORE obtient le niveau lecture (1) — borné à ses chemins par
    _resolve_path_scope (lecture : GROUPS_PATHS ∪ GROUPS_PATHS_RESTORE ; téléchargement :
    GROUPS_PATHS_RESTORE seul, jamais de repli). Jamais au-delà de 1 : POST /restore, Bkp, Index...
    restent réservés à GROUPS_WRITE/GROUPS_ADMIN. ⚠️ Parse GROUPS_PATHS(_RESTORE) même pour un
    appelant sans tier : une valeur rendue ambiguë en cours de route lève ValueError (500) pour tout
    appelant de ce nick, jamais dégradée en silence (validée aussi au démarrage)."""
    for level in (3,2,1):
        allowed={g.strip() for g in (cfg.get(_LEVEL_KEYS[level],'') or '').split(',') if g.strip()}
        if user_groups & allowed: return level
    if user_groups & _direct_path_groups(cfg): return 1
    return 0

def _direct_path_groups(cfg):
    """Groupes cités dans GROUPS_PATHS ou GROUPS_PATHS_RESTORE de `cfg` (nick, repli [DEFAULT]
    natif) — candidats à l'accès direct par périmètre (voir _effective_level)."""
    return (set(_parse_groups_paths(cfg.get(_GROUPS_PATHS_KEY,'') or ''))
            |set(_parse_groups_paths(cfg.get(_GROUPS_PATHS_RESTORE_KEY,'') or '')))

def _parse_groups_paths(raw):
    """Parse la syntaxe GROUPS_PATHS : 'groupe:/a|/b, groupe2:/c' — ':' sépare un groupe de ses
    chemins, '|' sépare plusieurs chemins pour un même groupe, ',' sépare les groupes. Retourne
    {groupe: [chemins...]}. Chaîne vide/absente -> {}.

    Échoue BRUYAMMENT (ValueError) si un nom de groupe ou un chemin contient l'un des séparateurs
    réservés (_GP_RESERVED_CHARS), si un chemin n'est pas absolu (doit commencer par '/'), ou si un
    chemin est vide une fois ses '/' finaux retirés (ex. '///') — sauf la racine '/' elle-même, qui
    reste un chemin valide (périmètre racine) — jamais un résultat silencieusement mal découpé
    (Boundaries du spec 1.1). Appelée à la fois par _validate_groups_paths_startup() (courtoisie,
    une fois au démarrage) et par _resolve_path_scope() (à CHAQUE appel, puisque cfgread() relit
    .borghelperrc depuis le disque à chaque fois) — l'appelant ne doit jamais catcher cette
    exception pour la dégrader silencieusement en scope restreint/illimité par défaut."""
    result={}
    raw=(raw or '').strip()
    if not raw: return result
    for entry in raw.split(','):
        entry=entry.strip()
        if not entry: continue
        if ':' not in entry:
            raise ValueError(f"GROUPS_PATHS : entrée sans ':' séparant groupe et chemin(s) : {entry!r}")
        group,_,paths_raw=entry.partition(':')
        group=group.strip()
        if not group:
            raise ValueError(f"GROUPS_PATHS : nom de groupe vide dans l'entrée {entry!r}")
        for c in _GP_RESERVED_CHARS:
            if c in group:
                raise ValueError(f"GROUPS_PATHS : nom de groupe {group!r} contient le séparateur "
                    f"réservé {c!r} — renommer le groupe ou choisir une autre syntaxe")
        paths=[p.strip() for p in paths_raw.split('|') if p.strip()]
        if not paths:
            raise ValueError(f"GROUPS_PATHS : aucun chemin pour le groupe {group!r} dans l'entrée {entry!r}")
        for p in paths:
            for c in _GP_RESERVED_CHARS:
                if c in p:
                    raise ValueError(f"GROUPS_PATHS : chemin {p!r} (groupe {group!r}) contient le "
                        f"séparateur réservé {c!r}")
            if not p.startswith('/'):
                raise ValueError(f"GROUPS_PATHS : chemin {p!r} (groupe {group!r}) doit être absolu "
                    f"(commencer par '/')")
            if p!='/' and p.rstrip('/')=='':
                raise ValueError(f"GROUPS_PATHS : chemin {p!r} (groupe {group!r}) est vide une fois "
                    f"ses '/' finaux retirés")
        result.setdefault(group,[]).extend(paths)
    return result

def _canonicalize_scope(prefixes):
    """Canonicalise une liste de préfixes de chemin : dédoublonne, retire le '/' final, élimine
    tout préfixe qui est déjà un sous-chemin d'un autre préfixe gardé (le plus large couvre déjà
    le plus étroit). Cas particulier de la racine '/' : absorbe absolument tout le reste — géré en
    sortie anticipée plutôt que via `p.startswith(kept+'/')`, qui deviendrait `p.startswith('//')`
    pour kept=='/' et n'absorberait donc jamais rien (bug trouvé en revue iteration 1)."""
    cleaned=sorted({(p.rstrip('/') or '/') for p in prefixes if p and p.strip()})
    if not cleaned: return []
    if '/' in cleaned: return ['/']
    kept=[]
    for p in cleaned:
        if not any(p==k or p.startswith(k+'/') for k in kept):
            kept.append(p)
    return kept

def _resolve_path_scope(user_groups,cfg,for_restore=False):
    """cfg : SectionProxy (.borghelperrc[nick], repli [DEFAULT] natif à configparser) ou None (nick
    inexistant). Miroir de _effective_level, mais pour le périmètre de chemin (GROUPS_PATHS ou, si
    for_restore, GROUPS_PATHS_RESTORE avec repli PAR GROUPE sur GROUPS_PATHS — spec-
    groups-paths-restore) — strictement par nick, jamais une vue fusionnée/globale de la config.
    Retourne None (illimité) ou une liste de préfixes canonicalisés.

    'Groupes correspondants' = les groupes de l'appelant qui détiennent un accès (n'importe quel
    tier) sur ce nick, càd l'union GROUPS_ADMIN ∪ GROUPS_WRITE ∪ GROUPS_READ intersectée avec
    user_groups — un groupe auquel l'appelant appartient mais qui n'a aucun accès au nick ne doit
    ni restreindre ni élargir le périmètre. Si l'un de ces groupes correspondants est absent de
    GROUPS_PATHS, le périmètre est illimité (None) quels que soient les autres groupes ; sinon le
    périmètre est l'union canonicalisée des préfixes de tous les groupes correspondants scopés.

    ⚠️ Ne JAMAIS envelopper cet appel (ni celui, transitif, à _parse_groups_paths) dans un
    try/except qui avalerait un ValueError — .borghelperrc est relu à chaque cfgread(), donc une
    valeur GROUPS_PATHS rendue ambiguë PENDANT que le process tourne doit remonter telle quelle
    (500 non catché) au prochain appel qui résout le périmètre pour ce nick, jamais être dégradée
    silencieusement en scope restreint ou illimité par défaut. Depuis 1.20.0 (accès direct par
    périmètre), GROUPS_PATHS(_RESTORE) est parsé pour TOUT appelant, même sans tier — un GROUPS_PATHS
    ambigu lève donc aussi pour lui (fail-loud, plus jamais invisible).

    ⚠️ None EST AMBIGU — retourné pour deux situations distinctes : (1) l'appelant n'a aucun tier
    du tout sur ce nick (`matching` vide, la question du périmètre n'a alors aucun sens — accès
    déjà refusé ailleurs par le tier), et (2) l'appelant a un tier ET un périmètre réellement
    illimité (aucun groupe correspondant scopé). TOUT appelant futur (filtrage a posteriori des
    stories 1.3/1.4, qui réutilisent cette fonction telle quelle) DOIT vérifier le niveau/tier de
    l'appelant sur ce nick séparément avant d'interpréter un None comme « laisser tout passer » —
    ne jamais traiter un None de cette fonction, à lui seul, comme une preuve d'accès illimité.
    Actuellement sans risque dans access() (toujours appairé à `level`, qui gouverne déjà l'accès),
    mais un futur appelant qui ignorerait le tier accorderait par erreur un accès illimité à un
    appelant sans aucun droit sur le nick."""
    if cfg is None: return None
    tier_groups=set()
    for level in (3,2,1):
        tier_groups|={g.strip() for g in (cfg.get(_LEVEL_KEYS[level],'') or '').split(',') if g.strip()}
    read_paths=_parse_groups_paths(cfg.get(_GROUPS_PATHS_KEY,'') or '')
    restore_paths=_parse_groups_paths(cfg.get(_GROUPS_PATHS_RESTORE_KEY,'') or '')
    matching=user_groups & tier_groups
    # Accès direct par périmètre (1.20.0, voir _effective_level) : groupes de l'appelant SANS tier
    # sur ce nick mais cités dans GROUPS_PATHS/GROUPS_PATHS_RESTORE.
    direct=(user_groups-tier_groups) & (set(read_paths)|set(restore_paths))
    if not matching and not direct: return None
    prefixes=[]
    if matching:
        # Override PAR GROUPE : un groupe présent dans GROUPS_PATHS_RESTORE utilise ce périmètre-là ;
        # un groupe absent d'ici mais présent dans GROUPS_PATHS ci-dessus garde son entrée lecture
        # (repli rétro-compatible) — jamais un remplacement global des deux dicts l'un par l'autre.
        groups_paths={**read_paths,**restore_paths} if for_restore else read_paths
        for g in matching:
            if g not in groups_paths: return None  # groupe correspondant non scopé -> illimité
            prefixes.extend(groups_paths[g])
    for g in direct:
        # Groupe direct : téléchargement = GROUPS_PATHS_RESTORE SEUL (aucun repli sur GROUPS_PATHS —
        # être cité dans GROUPS_PATHS ne donne que la lecture) ; lecture = GROUPS_PATHS ∪
        # GROUPS_PATHS_RESTORE (on doit pouvoir parcourir ce qu'on peut télécharger).
        prefixes.extend(restore_paths.get(g,[]))
        if not for_restore: prefixes.extend(read_paths.get(g,[]))
    # Liste vide possible (groupe direct lecture seule, périmètre de téléchargement) -> [] = rien,
    # jamais None (qui signifierait illimité).
    return _canonicalize_scope(prefixes)

def _path_in_scope(path,scope):
    """Story 1.3, AD-7 : True si `path` est dans `scope` (déjà canonicalisé par
    `_canonicalize_scope`/`_resolve_path_scope`), False sinon. `scope=None` (illimité) -> toujours
    True — l'appelant doit avoir déjà tranché ce cas (voir la mise en garde 'None est ambigu' de
    `_resolve_path_scope`) avant d'arriver ici pour un nick sur lequel l'appelant n'a aucun tier.

    Comparaison par segments de chemin complets, jamais sous-chaîne : `path==prefix` ou
    `path.startswith(prefix+'/')` (le cas racine `prefix==''` absorbe tout). Normalise le décalage
    de convention documenté (Boundaries du spec 1.3) : les chemins stockés par borgHelper
    (`archive_snapshot_v`/`diff_index`) n'ont JAMAIS de '/' initial, alors que les préfixes
    `GROUPS_PATHS` s'écrivent AVEC un '/' initial (convention Story 1.1) — sans ce retrait, toute
    comparaison scopée échoue silencieusement et tout appelant scopé n'obtient jamais aucun
    résultat, pour aucun nick (fail-closed, pas une fuite, mais un bug fonctionnel réel)."""
    if scope is None: return True
    path=(path or '').lstrip('/')
    for prefix in scope:
        p=prefix.lstrip('/')
        if p=='' or path==p or path.startswith(p+'/'): return True
    return False

def _resolve_scopes_for_request(request,nicks,for_restore=False):
    """Résout le périmètre (Story 1.1, `_resolve_path_scope`) de chaque nick de `nicks` pour
    l'appelant HTTP courant -> {nick: scope|None}. `for_restore` (spec-groups-paths-restore) : périmètre
    de RESTAURATION (GROUPS_PATHS_RESTORE, repli par groupe sur GROUPS_PATHS) plutôt que de lecture —
    seul `require_path_in_scope` ci-dessous le passe à True, tous ses appelants étant des routes de
    restauration/téléchargement ; aucune route de lecture n'a besoin de ce paramètre. `GROUPS_HEADER`
    désactivé (autorisation par groupes éteinte) -> illimité pour tous, sans même lire `.borghelperrc`
    (comportement inchangé/rapide, même court-circuit que partout ailleurs dans ce fichier).

    ⚠️ Par construction, cette fonction n'est appelée que depuis le corps d'un endpoint du routeur
    (après la dépendance `_check_group_access`, qui a déjà validé le tier requis pour tous les
    nicks demandés) — un `None` renvoyé ici pour un nick de `nicks` signifie donc toujours
    'périmètre illimité', jamais 'aucun tier' (voir la mise en garde de `_resolve_path_scope`)."""
    if not GROUPS_HEADER: return {n:None for n in nicks}
    user_groups=_parse_groups(request.headers.get(GROUPS_HEADER))
    out={}
    for n in nicks:
        cfg=_bh_paths.borg.cfgread(n)
        out[n]=_resolve_path_scope(user_groups,cfg,for_restore=for_restore) if cfg is not None else None
    return out

def _any_scoped(scopes):
    """True si au moins un nick de `scopes` (dict {nick: scope|None}) porte un périmètre restreint
    -> force JSON + filtrage a posteriori (Boundaries du spec 1.3 : une requête multi-nick ne peut
    pas mélanger texte et JSON dans un seul corps HTTP, donc UN nick scopé force tout le corps)."""
    return any(s is not None for s in scopes.values())

def require_path_in_scope(request: Request, nick: str, path: Optional[str]) -> bool:
    """Story 2.1, AD-2 : garde PRÉ-appel pour Restore/Restore -L/téléchargements — jamais un
    filtrage a posteriori comme les routes de liste (Epic 1). `borg extract`/`export-tar` écrivent
    sur le disque du serveur ou streament des octets directement : un filtre APRÈS l'appel serait
    déjà une fuite, le temps qu'il s'applique l'action est faite. Retourne True si l'appel peut
    procéder (périmètre illimité, autorisation par groupes désactivée, ou `path` dans le périmètre
    résolu de l'appelant sur `nick`), False si l'appelant doit recevoir la réponse SYNTHÉTIQUE
    "introuvable" propre à sa route (jamais un 403 distinct/uniforme — voir les `_synth_*`
    ci-dessous : un 403 permettrait de distinguer "hors périmètre" de "n'existe pas" par le seul
    code de statut, cassant FR9/le Prevents d'AD-2). C'est un raffinement délibéré du pattern
    `require_destructive_allowed()`/`require_downloads_allowed()` évoqué par ARCHITECTURE-SPINE.md
    (planification) : ces deux-là lèvent toujours la même `HTTPException(403)` ; l'investigation du
    spec 2.1 (voir son Intent, quatre formes de réponse capturées en direct) a montré que les QUATRE
    routes ont besoin d'une forme différente — donc un booléen ici, jamais une exception uniforme ;
    chaque endpoint construit sa propre réponse synthétique sur un résultat `False`.

    Ne réévalue ni ne réimplémente la résolution de périmètre elle-même
    (`_resolve_scopes_for_request`/`_path_in_scope`, Epic 1, réutilisées telles quelles) — appelée
    après `_check_group_access` (dépendance de routeur, déjà passée pour atteindre le corps de
    l'endpoint), donc un scope résolu à `None` ici signifie toujours "illimité", jamais "aucun
    tier" (précondition documentée par `_resolve_path_scope`, déjà appliquée par tout appelant
    Epic 1 existant).

    `for_restore=True` toujours (spec-groups-paths-restore) : les 4 seuls appelants de cette fonction
    (`download_file`, `download_tar`, `restore_perms`, `restore`) sont tous des routes de
    restauration/téléchargement — le périmètre appliqué est donc `GROUPS_PATHS_RESTORE` (repli par
    groupe sur `GROUPS_PATHS`), jamais celui de lecture."""
    scope=_resolve_scopes_for_request(request,[nick],for_restore=True).get(nick)
    return _path_in_scope(path,scope)

def _default_section_groups():
    """[DEFAULT] brut du .borghelperrc — utilisé par Login quand le nick visé n'existe pas encore
    (rien à lire depuis une section qui n'existe pas : politique globale de qui peut en créer une)."""
    cp=configparser.ConfigParser(); cp.optionxform=str
    if os.path.isfile(CFGFILE): cp.read(CFGFILE)
    return cp.defaults()

def _nick_list(nick_param):
    if not nick_param or nick_param=='ALL':
        return [n.strip() for n in (_bh_paths.borg.cfgreadnicks() or '').split(',') if n.strip()]
    return [n.strip() for n in nick_param.split(',') if n.strip()]

def _check_group_access(request: Request):
    if not GROUPS_HEADER: return  # fonctionnalité désactivée : X-API-Key seul fait foi
    path=request.url.path
    if API_PREFIX and path.startswith(API_PREFIX): path=path[len(API_PREFIX):]

    if path=='/access': return  # consulter ses propres droits ne requiert aucun droit particulier

    user_groups=_parse_groups(request.headers.get(GROUPS_HEADER))

    if path=='/login':
        nick=request.query_params.get('nickname') or request.query_params.get('servername') or ''
        cfg=_bh_paths.borg.cfgread(nick) if nick else None
        eff=_effective_level(user_groups, cfg if cfg is not None else _default_section_groups())
        if eff<3:
            raise HTTPException(403,detail=f"Groupe insuffisant pour Login sur '{nick}' — accès admin requis "
                f"({GROUPS_HEADER}: {', '.join(sorted(user_groups)) or '(vide)'})")
        return

    required=_ROUTE_LEVELS.get(path)
    if required is None: required=3  # route non cataloguée : refus par défaut (fail-closed), jamais censé arriver
    nick_param=request.query_params.get('nick')
    if nick_param is None: return  # route sans notion de nick (ne devrait pas se produire ici)
    for n in _nick_list(nick_param):
        cfg=_bh_paths.borg.cfgread(n)
        eff=_effective_level(user_groups, cfg) if cfg is not None else 0
        if eff<required:
            raise HTTPException(403,detail=f"Groupe insuffisant pour '{n}' — accès {_LEVEL_NAMES[required]} requis "
                f"({GROUPS_HEADER}: {', '.join(sorted(user_groups)) or '(vide)'})")

# Toutes les routes API métier sont déclarées sur ce routeur (préfixe appliqué en fin de fichier via
# app.include_router) — seuls '/', '/version', '/healthz' restent déclarés directement sur `app`,
# accessibles sans préfixe quel que soit API_PREFIX (bootstrap : la page et le endpoint qui lui
# apprend ce préfixe doivent être joignables sans le connaître à l'avance).
# dependencies=[Depends(_check_group_access)] : appliqué à CHAQUE route du routeur, en plus de
# require_api_key (appelé individuellement dans chaque fonction).
router=APIRouter(dependencies=[Depends(_check_group_access)])

