# ── Watcher bkp_status (Story 1, étendu Story 2b : spec-notifications-push) ────
# Premier composant de fond de borgHelperWWW : tâche asyncio démarrée via le hook de cycle de vie
# FastAPI (lifespan), un watcher par processus worker uvicorn (--workers 2 déjà documenté) — aucune
# coordination inter-process requise, chaque worker réclame les lignes bkp_status par comparer-et-
# échanger (AD-3), donc deux workers qui tombent sur la même ligne au même moment n'en traitent
# jamais qu'un seul (l'autre voit 0 ligne affectée et passe). Story 2b : la réclamation (début ET
# fin) déclenche désormais un envoi push réel (`_send_bkp_push`, pywebpush) en plus du log serveur
# — remplace la simple journalisation de la Story 1.
def _bkp_timeout(nick):
    """Délai du nick (1.28.4, story 18) : clé rc BKP_STATUS_TIMEOUT du nick ou [DEFAULT], sinon BKP_STATUS_TIMEOUT
    (variable BORGHELPERWWW_BKP_STATUS_TIMEOUT, sinon 6 h) — le même que Status (BorgHelper.bkp_status_timeout).
    Jamais d'exception (watcher, /access)."""
    try: return _bh_paths.bkp_status_timeout(nick)
    except (Exception,SystemExit): return BKP_STATUS_TIMEOUT

def _bkp_status_watcher_pass():
    """Un passage d'interrogation : parcourt chaque nick connu, réclame les lignes bkp_status prêtes
    — à la fois le passage de FIN (terminées, ou bloquées depuis plus de BKP_STATUS_TIMEOUT secondes,
    AD-7) et le passage de DÉBUT (Story 2b : `started_at` écrit, aucun délai à attendre) — et envoie
    un push réel pour chaque réclamation que CE worker a effectivement gagnée au CAS."""
    for nick in _nick_list('ALL'):
        try:
            db_path=_bh_paths.db.get_diff_db(nick)
            _bh_paths.db.ensure_diff_db(db_path,create=False)  # AD-12 : jamais créer pour un nick sans historique ; migre une base antérieure (1.0.139)
            hist=_bh_paths.db.get_history_db(nick)              # bkp_status vit dans history.db (borgHelper 1.0.139) ; absente -> rien
            timeout_s=_bkp_timeout(nick)   # 1.28.4 : délai du nick (clé rc, sinon variable, sinon 6 h)
            for row in _bh_paths.db.list_pending_bkp_status(nick,timeout_s,hist):
                if not _bh_paths.db.claim_bkp_status(nick,row['run_id'],hist):
                    continue  # déjà réclamée par un autre worker (CAS perdu) — jamais de double traitement
                result=row['result'] if row['finished_at'] else 'error'  # AD-7 : jamais fini = échec
                # borgHelper >= 1.0.118 : statuts C/E de borg create (absents = inconnus).
                warnings={k:row.get(k) for k in ('changed_during_backup','read_errors')}
                print(f"[watcher] bkp_status (fin) réclamé : nick={nick} run_id={row['run_id']} result={result}"
                      +''.join(f" {k}={v}" for k,v in warnings.items() if v),file=sys.stderr,flush=True)
                _send_bkp_push(nick,'end',result,warnings)
                if not row['finished_at']:
                    # Bloquée au-delà de BKP_STATUS_TIMEOUT (AD-7) : seul le watcher le constate. Un échec
                    # ordinaire est déjà signalé à Sentry par borgHelper lui-même (même réglage) — pas de doublon.
                    sentry_alert('bkp_error',nick,f"Sauvegarde bloquée ou interrompue — {nick} "
                                 f"(sans fin après {timeout_s} s)",_bh_paths.borg.cfgread(nick),
                                 extra={'run_id':row['run_id'],'timeout_s':timeout_s},release=f"borgHelperWWW@{WWW_VERSION}")
            for row in _bh_paths.db.list_pending_bkp_status_start(nick,hist):
                if not _bh_paths.db.claim_bkp_status_start(nick,row['run_id'],hist):
                    continue  # déjà réclamée par un autre worker (CAS perdu) — jamais de double traitement
                print(f"[watcher] bkp_status (début) réclamé : nick={nick} run_id={row['run_id']}",
                      file=sys.stderr,flush=True)
                _send_bkp_push(nick,'start',None)
            _check_overdue(nick,db_path)
        except (Exception,SystemExit) as e:
            # Un nick en erreur (DB corrompue, etc.) ne doit jamais aveugler les autres nicks de ce
            # passage — isolation par nick, le passage suivant réessaiera. SystemExit inclus (1.27.6) :
            # les ensure_*_db de borgHelper font sys.exit(1) sur une base occupée/corrompue ; hors de ce
            # filet, il traversait le watcher et arrêtait tout le serveur (boucle asyncio).
            print(f"[watcher] nick={nick} erreur : {'sortie borgHelper (voir message ci-dessus)' if isinstance(e,SystemExit) else e}",
                  file=sys.stderr,flush=True)
            continue

def _max_age_bkp(cfg):
    """MAX_AGE_BKP du nick en heures (même clé et même défaut que Report : 25) — valeur illisible ou
    <= 0 -> 25, jamais un crash du watcher."""
    try:
        v=float((cfg.get('MAX_AGE_BKP','25') if cfg is not None else '25') or 25)
        return v if v>0 else 25.0
    except (TypeError,ValueError): return 25.0

def _archive_age_hours(archive_date):
    """Âge en heures d'une date d'archive borg (heure locale naïve, comme d2DateNSince de Report).
    None si illisible."""
    try: d=datetime.datetime.fromisoformat(str(archive_date))
    except ValueError: return None
    if d.tzinfo is not None: d=d.astimezone().replace(tzinfo=None)
    return (datetime.datetime.now()-d).total_seconds()/3600

def _overdue_claim(nick,last_archive,level):
    """Réserve l'envoi d'une alerte de retard (comparer-et-échanger en une seule instruction SQLite,
    sûr entre plusieurs workers uvicorn) : True seulement si ce nick n'a encore jamais été alerté pour
    cette dernière archive, ou à un niveau inférieur. Une nouvelle archive (sauvegarde réussie)
    remplace la ligne au prochain retard — le compteur repart de 1."""
    conn=_push_conn('write')
    try:
        cur=conn.execute(
            "INSERT INTO overdue_alerts (nick,last_archive,level,notified_at) VALUES (?,?,?,datetime('now')) "
            "ON CONFLICT(nick) DO UPDATE SET last_archive=excluded.last_archive,level=excluded.level,"
            "notified_at=excluded.notified_at "
            "WHERE overdue_alerts.last_archive!=excluded.last_archive OR overdue_alerts.level<excluded.level",
            (nick,last_archive,level))
        conn.commit()
        return cur.rowcount==1
    finally:
        conn.close()

def _check_overdue(nick,db_path):
    """(1.26.8 : alerte Sentry SENTRY_ALERTS=overdue en tête, indépendante de tout ce qui suit sur le push.)
    Sauvegarde en retard (1.24.0) : dernière archive connue plus vieille que MAX_AGE_BKP heures
    (même règle que Report, qui marque déjà ce nick en erreur) -> notification push de type ÉCHEC.
    Une alerte au franchissement du seuil, puis un rappel à chaque période MAX_AGE_BKP supplémentaire
    (2x, 3x...), jusqu'à la prochaine archive. Rien si aucune archive connue, si un Bkp est en cours
    (il peut simplement être long ; bloqué au-delà de BKP_STATUS_TIMEOUT, il est déjà traité en
    échec), si l'envoi push est indisponible, ou si personne n'est abonné aux échecs de ce host —
    dans ces trois derniers cas l'alerte n'est PAS consommée : un abonnement pris pendant le retard
    reçoit l'alerte au passage suivant, pas seulement au rappel d'après."""
    last=_bh_paths.db.last_archive_stat(nick,db_path)
    if last is None: return
    archive,archive_date=last
    age=_archive_age_hours(archive_date)
    cfg=_bh_paths.borg.cfgread(nick)
    max_age=_max_age_bkp(cfg)
    if age is None or age<=max_age: return
    if _bh_paths.db.bkp_running(nick,_bkp_status_timeout(cfg=cfg,nick=nick),_bh_paths.db.get_history_db(nick)): return  # history.db (1.0.139) ; délai du nick, cfg déjà lu (1.28.4)
    level=int(age//max_age)
    # Alerte Sentry (1.26.8, SENTRY_ALERTS=overdue) : canal indépendant du push — réservation propre
    # ('<nick>#sentry' dans overdue_alerts), mêmes rappels à chaque période MAX_AGE_BKP.
    if 'overdue' in _sentry_alert_kinds(cfg) and _overdue_claim(f"{nick}#sentry",archive,level):
        sentry_alert('overdue',nick,f"Sauvegarde en retard — {nick} : dernière il y a {age:.0f} h "
                     f"(seuil MAX_AGE_BKP {max_age:g} h{', rappel' if level>1 else ''})",cfg,
                     extra={'age_hours':round(age,1),'max_age_hours':max_age,'level':level},
                     release=f"borgHelperWWW@{WWW_VERSION}")
    if not _PYWEBPUSH_AVAILABLE or PUSH_VAPID_PRIVATE_KEY is None: return
    if _push_muted(nick): return  # pause : alerte NON consommée, envoyée à la reprise si le retard persiste
    if not _push_subscriptions_for(nick,'error'): return
    if not _overdue_claim(nick,archive,level): return
    print(f"[watcher] sauvegarde en retard : nick={nick} dernière archive il y a {age:.1f} h "
          f"(MAX_AGE_BKP={max_age:g} h, alerte n°{level})",file=sys.stderr,flush=True)
    _send_bkp_push(nick,'overdue','error',{'age_hours':round(age,1),'max_age_hours':max_age,
                                           'last_backup':str(archive_date),'reminder':level>1})

def _push_purge_expired():
    """Abonnements push expirés (`expires_at` dépassé dans le fichier de préférences, qui fait foi) :
    retirés du fichier ET de push.db (1.26.3 — auparavant jamais nettoyés, seulement ignorés à l'envoi).
    Retourne le nombre d'abonnements retirés. « À vie » (expires_at null) : jamais touché."""
    now=_utc_now_str()
    def _pop_expired(subs):
        gone=[ep for ep,raw in subs.items()
              if (lambda e: e['expires_at'] is not None and e['expires_at']<=now)(_prefs_entry(raw))]
        for ep in gone: subs.pop(ep,None)
        return gone
    gone=_push_prefs_update(_pop_expired)
    if gone:
        conn=_push_conn('write')
        try:
            conn.executemany("DELETE FROM push_subscriptions WHERE endpoint=?",[(ep,) for ep in gone]); conn.commit()
        finally:
            conn.close()
    return len(gone)

PUSH_PURGE_INTERVAL=3600  # secondes entre deux purges des abonnements expirés (par le watcher)

_PUSH_HOST_OFF={'start':False,'success':False,'error':False}

def _push_realign_entry(raw,nicks):
    """Entrée d'abonnement réalignée sur la liste `nicks` (1.27.4) : scope_nicks = nicks ; réglages par host
    conservés pour les nicks gardés, retirés pour les autres, TOUT DÉCOCHÉ pour un nick nouvellement accessible
    (jamais d'envoi non demandé). -> (entrée format 2, ajoutés, retirés)."""
    e=_prefs_entry(raw)
    old=list(e['scope_nicks'])
    hosts={n:(dict(e['hosts'][n]) if n in e['hosts'] else dict(_PUSH_HOST_OFF)) for n in nicks}
    new=dict(raw) if isinstance(raw,dict) else {}
    new.update({'scope_nicks':list(nicks),'hosts':hosts})
    new.pop('notify_start',None); new.pop('notify_end',None)  # format 1 converti par _prefs_entry
    return new,[n for n in nicks if n not in old],[n for n in old if n not in nicks]

def _push_prune_unknown_nicks():
    """Watcher (1.27.4) : retire des abonnements les nicks qui n'existent plus dans le rc. -> nb d'abonnements modifiés."""
    known=set(_nick_list('ALL'))
    def _prune(subs):
        changed=0
        for ep,raw in list(subs.items()):
            cur=_prefs_entry(raw)['scope_nicks']
            keep=[n for n in cur if n in known]
            if keep!=cur:
                subs[ep],_a,_r=_push_realign_entry(raw,keep); subs[ep]['updated_at']=_utc_now_str(); changed+=1
        return changed
    return _push_prefs_update(_prune)

