    print(f"  X-API-Key: {API_KEY}",file=sys.stderr)
    print("─"*70,file=sys.stderr)
if not BORGHELPER_BIN.is_file():
    sys.exit(f"borgHelper introuvable ({BORGHELPER_BIN}) — --borghelper-bin ou BORGHELPERWWW_BORGHELPER_BIN pour surcharger")
print(f"Actions destructrices (Prune/DelBkp) : {'AUTORISÉES' if ALLOW_DESTRUCTIVE else 'interdites (défaut)'}"
      f" — Téléchargements (restauration) : {'autorisés (défaut)' if ALLOW_DOWNLOADS else 'INTERDITS'}",file=sys.stderr)

app=FastAPI(
    title="borgHelperWWW",
    version=BORGHELPER_VERSION,
    description=(
        "API HTTP au-dessus de borgHelper (exécute le binaire borgHelper en sous-processus, "
        f"avec -C {CFGFILE}).\n\n"
        "Authentification : header `X-API-Key`.\n\n"
        "Passphrase du dépôt borg : header `X-Borg-Passphrase` (optionnel) — complète ou "
        "supplante `BORG_PASSPHRASE` du borghelperrc pour cet appel uniquement (transmise au "
        "sous-processus via variable d'environnement, jamais visible dans `ps aux`).\n\n"
        "⚠️ Toutes les commandes CLI sont exposées sauf Mount/UMount (accès FUSE local, "
        "sans objet pour un serveur HTTP). `Login` écrit en clair la passphrase fournie dans "
        f"{CFGFILE} — à réserver au provisioning, pas à un usage courant."
    ),
)

# ── Auth ─────────────────────────────────────────────────────────────────────

def require_api_key(x_api_key: Optional[str]=Header(default=None)):
    if not x_api_key or not secrets.compare_digest(x_api_key,API_KEY):
        raise HTTPException(401,detail="X-API-Key manquant ou invalide")

def require_destructive_allowed():
    if not ALLOW_DESTRUCTIVE:
        raise HTTPException(403,detail="Actions destructrices (Prune/DelBkp) désactivées sur ce "
            "serveur — démarrer borgHelperWWW avec --allow-destructive/BORGHELPERWWW_ALLOW_DESTRUCTIVE pour les autoriser")

def require_downloads_allowed():
    if not ALLOW_DOWNLOADS:
        raise HTTPException(403,detail="Téléchargements (/download/file, /download/tar) désactivés sur ce "
            "serveur — démarrer borgHelperWWW avec --no-downloads absent ou "
            "BORGHELPERWWW_ALLOW_DOWNLOADS=1 pour les autoriser")

# ── Exécution borgHelper ────────────────────────────────────────────────────

class CommandResult(BaseModel):
    exitcode: int
    stdout: str
    stderr: str

# ── Cache de réponses (commandes de lecture pure base SQLite) ──────────────────
# Certaines commandes (LstBkp, LstBkpFls, TreeHist, FileHist, Search, DuIdx, IdxTop, DiffTop,
# CacheInfo, DiffBkp, Report -o) ne lisent (ou n'écrivent, pour DiffBkp la première fois) que
# cache.db/diff.db — jamais l'état live du dépôt indépendamment de ces fichiers. Empreinte =
# mtime de tous les cache.db/diff.db concernés (tous les nicks connus si nick vide/'ALL') ;
# recalculée APRÈS l'exécution de la commande (couvre le cas DiffBkp qui peut écrire dans
# diff.db lors de son tout premier appel sur une paire non indexée) et comparée à l'entrée en
# cache : si identique, le résultat mis en cache est restitué sans relancer borgHelper.
_bh_paths=BorgHelper(cfgfile=CFGFILE)
_RESPONSE_CACHE={}

def _cache_db_paths(nick: Optional[str]):
    nicks=[n.strip() for n in nick.split(',')] if (nick and nick!='ALL') else \
        [n.strip() for n in _bh_paths.borg.cfgreadnicks().split(',')]
    paths=[]
    for n in nicks:
        if not n: continue
        paths.append(_bh_paths.db.get_diff_db(n))
        paths.append(_bh_paths.db.get_cache_db(n))
    return paths

def _cache_fingerprint(nick: Optional[str]) -> str:
    parts=[]
    for p in _cache_db_paths(nick):
        try: parts.append(f"{p}:{os.path.getmtime(p)}")
        except OSError: parts.append(f"{p}:absent")
    return '|'.join(parts)

def run_borghelper(cmd: str, nick: Optional[str]=None, extra_args=(), passphrase: Optional[str]=None,
                    cacheable: bool=False) -> JSONResponse:
    key=(cmd,nick,tuple(extra_args)) if cacheable else None
    if key is not None:
        cached=_RESPONSE_CACHE.get(key)
        if cached is not None and cached[0]==_cache_fingerprint(nick):
            result_dict=cached[1]
            return JSONResponse(status_code=200 if result_dict['exitcode']==0 else 400,content=result_dict)
    argv=[sys.executable,str(BORGHELPER_BIN),'-C',CFGFILE,'-c',cmd]
    if nick: argv+=['-n',nick]
    argv+=list(extra_args)
    env=os.environ.copy()
    if passphrase: env['BORGHELPERC_RUNTIME_PASSPHRASE']=passphrase
    try:
        proc=subprocess.run(argv,capture_output=True,text=True,timeout=TIMEOUT,env=env)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail=f"Commande {cmd} : timeout après {TIMEOUT}s")
    result=CommandResult(exitcode=proc.returncode,stdout=proc.stdout,stderr=proc.stderr)
    if key is not None:
        if len(_RESPONSE_CACHE)>500: _RESPONSE_CACHE.clear()  # garde-fou anti-croissance illimitée
        _RESPONSE_CACHE[key]=(_cache_fingerprint(nick),result.dict())
    return JSONResponse(status_code=200 if proc.returncode==0 else 400,content=result.dict())

# ── Téléchargements (accès borg direct, streaming binaire) ─────────────────────
# Seule exception au principe "tout passe par borgHelper en sous-processus" : un téléchargement
# doit streamer des octets bruts vers le navigateur, incompatible avec le pipe texte/JSON de
# run_borghelper(). Lit la conf via BorgRunner (mode librairie, cfgfile+passphrase), exécute borg
# directement (extract --stdout / export-tar) et streame son stdout comme réponse HTTP.

_BORG_ENV_KEYS=('BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO',
                 'BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE')
_FILENAME_UNSAFE=re.compile(r'[^A-Za-z0-9_.\-]+')

def _borg_cfg(nick: str, passphrase: Optional[str]):
    cfg=BorgRunner(cfgfile=CFGFILE,passphrase=passphrase).cfgread(nick)
    if cfg is None:
        raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return cfg

def _borg_env(cfg):
    env=os.environ.copy()
    for k in _BORG_ENV_KEYS:
        if k in cfg.keys(): env[k]=cfg[k]
    return env

def _latest_archive(cfg,env):
    borg_exe=cfg.get('BORG_EXE','borg')
    try:
        proc=subprocess.run([borg_exe,'list','--short','--glob-archives',cfg['GLOB_ARCH'],cfg['BORG_REPO']],
                             capture_output=True,text=True,env=env,timeout=60)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail="borg list : timeout")
    if proc.returncode!=0:
        raise HTTPException(502,detail=f"borg list a échoué : {proc.stderr[:300]}")
    lines=[l for l in proc.stdout.splitlines() if l.strip()]
    if not lines:
        raise HTTPException(404,detail="Aucune archive dans ce dépôt")
    return lines[-1]

def _safe_filename(name: str) -> str:
    name=(name or '').strip('/').split('/')[-1] or 'download'
    return _FILENAME_UNSAFE.sub('_',name) or 'download'

def _stream_proc(proc):
    try:
        while True:
            chunk=proc.stdout.read(65536)
            if not chunk: break
            yield chunk
    finally:
        try: proc.stdout.close()
        except Exception: pass
        proc.wait()

@app.get("/download/file",tags=["téléchargement"],summary="Télécharge un fichier depuis une archive (borg extract --stdout)")
def download_file(nick: str, path: str, bid: Optional[str]=None,
                   x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    proc=subprocess.Popen([borg_exe,'extract','--stdout',f"{cfg['BORG_REPO']}::{archive}",path],
                          stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    return StreamingResponse(_stream_proc(proc),media_type='application/octet-stream',
        headers={'Content-Disposition':f'attachment; filename="{_safe_filename(path)}"'})

@app.get("/download/tar",tags=["téléchargement"],summary="Télécharge un .tar d'une arborescence depuis une archive (borg export-tar)")
def download_tar(nick: str, prefix: Optional[str]=None, bid: Optional[str]=None,
                  x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    cmd=[borg_exe,'export-tar',f"{cfg['BORG_REPO']}::{archive}",'-']
    if prefix: cmd.append(prefix)
    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    filename=(_safe_filename(prefix) if prefix else nick)+'.tar'
    return StreamingResponse(_stream_proc(proc),media_type='application/x-tar',
        headers={'Content-Disposition':f'attachment; filename="{filename}"'})

# ── Interface web ────────────────────────────────────────────────────────────
# Page unique (SPA) : saisie de la clé API, liste des serveurs (rapport hors-ligne),
# puis détail par serveur avec passphrase de session + actions. Aucun secret n'est
# embarqué dans ce HTML — l'authentification se fait côté client via fetch() une fois
