_SCHEMA_WARNED=set()  # avertissements déjà émis (une fois par cause, pas à chaque passe)

def _borghelper_disk_version():
    """Version= du borgHelper sur DISQUE (le module importé par ce processus au démarrage peut être plus
    ancien, s'il a été mis à jour depuis). None si illisible."""
    try:
        path=sys.modules[BorgHelper.__module__].__file__
        with open(path,encoding='utf-8') as f: head=f.read(8192)
        m=re.search(r'^Version="([^"]+)"',head,re.M)
        return m.group(1) if m else None
    except Exception:
        return None

def _schema_watch_pass():
    """Passe du contrôle périodique (1.26.6) : (1) borgHelper mis à jour sur disque depuis le démarrage ->
    [WARN] « redémarrer » (le code en mémoire est périmé) ; (2) pour chaque nick, vue archive_snapshot_v
    comparée à la définition du code : réparée si elle diffère — SAUF si le code en mémoire est périmé ou
    plus ancien que la base (jamais réécrire une définition plus récente avec une plus ancienne). Retourne
    {nick: état avant réparation} (tests)."""
    def _warn(key,msg):
        if key in _SCHEMA_WARNED: return
        _SCHEMA_WARNED.add(key); print(f"[WARN] {msg}",file=sys.stderr,flush=True)
    disk=_borghelper_disk_version()
    stale=disk is not None and disk!=BORGHELPER_VERSION
    if stale:
        _warn(('version',disk),f"borgHelper v{disk} sur disque, mais borgHelperWWW exécute v{BORGHELPER_VERSION} "
              "chargée à son démarrage — redémarrer borgHelperWWW pour l'appliquer à ses traitements internes")
    states={}
    for n in _nick_list('ALL'):
        p=_bh_paths.db.get_diff_db(n)
        if not os.path.exists(p): continue
        st=_bh_paths.db.archive_view_check(p,repair=not stale)
        states[n]=st
        if st in ('mismatch','absent'):
            if stale: _warn(('view',n,disk),f"{n}: vue archive_snapshot_v différente du code — non réparée (code en mémoire périmé), redémarrer borgHelperWWW")
            else: print(f"[schema] {n}: vue archive_snapshot_v {'recréée' if st=='absent' else 'remise à jour'}",file=sys.stderr,flush=True)
        elif st=='newer':
            _warn(('newer',n),f"{n}: diff.db d'un schéma plus récent que borgHelper v{BORGHELPER_VERSION} en mémoire — redémarrer borgHelperWWW")
        elif st.startswith('error'):
            _warn(('error',n,st),f"{n}: contrôle de schéma impossible ({st})")
    return states

async def _bkp_status_watcher():
    print(f"[watcher] bkp_status démarré — interrogation toutes les {BKP_WATCHER_INTERVAL}s, "
          f"timeout AD-7 {BKP_STATUS_TIMEOUT}s par défaut (clé rc BKP_STATUS_TIMEOUT par nick)",file=sys.stderr,flush=True)
    next_purge=0.0; next_schema=0.0
    while True:
        # (Exception,SystemExit) sur les trois passages (1.27.6) : un sys.exit de borgHelper appelé en
        # bibliothèque ne doit jamais sortir de la tâche, sinon il arrête la boucle asyncio donc le serveur.
        try:
            await asyncio.to_thread(_bkp_status_watcher_pass)
        except (Exception,SystemExit) as e:
            print(f"[watcher] erreur pendant l'interrogation bkp_status : {e}",file=sys.stderr,flush=True)
        if time.monotonic()>=next_purge:
            next_purge=time.monotonic()+PUSH_PURGE_INTERVAL
            try:
                n=await asyncio.to_thread(_push_purge_expired)
                if n: print(f"[watcher] push: {n} abonnement(s) expiré(s) retiré(s)",file=sys.stderr,flush=True)
                n=await asyncio.to_thread(_push_prune_unknown_nicks)
                if n: print(f"[watcher] push: {n} abonnement(s) nettoyé(s) de serveurs retirés du rc",file=sys.stderr,flush=True)
            except (Exception,SystemExit) as e:
                print(f"[watcher] push: erreur de purge des abonnements expirés : {e}",file=sys.stderr,flush=True)
        if time.monotonic()>=next_schema:
            next_schema=time.monotonic()+SCHEMA_CHECK_INTERVAL
            try: await asyncio.to_thread(_schema_watch_pass)
            except (Exception,SystemExit) as e:
                print(f"[watcher] erreur du contrôle de schéma : {e}",file=sys.stderr,flush=True)
        await asyncio.sleep(BKP_WATCHER_INTERVAL)

class _ExitGuardRoute(APIRoute):
    """Route qui convertit un SystemExit en réponse 500 (1.27.6). Les fonctions de borgHelper appelées en
    bibliothèque (cfgread, ensure_*_db…) font sys.exit sur un rc invalide ou une base occupée/corrompue.
    Dans une route, ce SystemExit arrêtait le serveur : il ne répondait plus à aucune requête (vérifié sous
    uvicorn, route sync et async). Un filet posé autour de l'application viendrait trop tard, car le
    middleware http exécute la route dans une tâche asyncio séparée, où SystemExit arrête la boucle. Il faut
    donc l'attraper ici, autour du traitement de chaque route (dépendances comprises). Appliquée à `app` et
    à `router`."""
    def get_route_handler(self):
        handler=super().get_route_handler()
        async def guarded(request):
            try:
                return await handler(request)
            except SystemExit as e:
                print(f"[ERREUR] sortie de borgHelper (sys.exit {e.code}) pendant {request.method} "
                      f"{request.url.path} — message juste au-dessus ; serveur maintenu",file=sys.stderr,flush=True)
                return JSONResponse(status_code=500,content={'detail':
                    "borgHelper s'est arrêté pendant cette requête (configuration invalide, base occupée ou "
                    "corrompue) — détails dans le journal de borgHelperWWW"})
        return guarded

