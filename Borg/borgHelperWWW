    disk=_borghelper_disk_version()
    stale=disk is not None and disk!=BORGHELPER_VERSION
    if stale:
        _warn(('version',disk),f"borgHelper v{disk} sur disque, mais borgHelperWWW exécute v{BORGHELPER_VERSION} "
              "chargée à son démarrage — redémarrer borgHelperWWW pour l'appliquer à ses traitements internes")
    states={}
    for n in _nick_list('ALL'):
        try: bh,b=_bhn(n)   # 1.32.0 : rc du nick (mode dossier : rc retiré entre-temps -> sauté)
        except HTTPException: continue
