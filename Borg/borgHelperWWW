def _mdump(m):
    """1.31.4 (story 57) : dict d'un modèle — pydantic 2 (`model_dump`) et 1 (`dict`, déprécié en 2 : erreur en strict)."""
    return m.model_dump() if hasattr(m,'model_dump') else m.dict()

def _mset(m):
    """1.31.4 (story 57) : champs fournis par le client — pydantic 2 (`model_fields_set`) et 1 (`__fields_set__`)."""
    return m.model_fields_set if hasattr(m,'model_fields_set') else m.__fields_set__

