        "met en pause sans limite pendant un Bkp/Restore/Prune (borgHelper 1.0.141) : la requête synchrone restait "
        "bloquée jusqu'au délai d'expiration. `exitcode=0` = lancement réussi ; l'avancement se lit dans /access "
        "(`build`), et le résultat du dernier Index de chaque nick dans /access (`index_last`, 1.28.2).")
def index(nick: str, force: bool=False, snapshot_only: bool=False, archive: Optional[str]=None,
          x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    unknown=[n for n in ([] if nick=='ALL' else _nick_list(nick)) if _bh_paths.borg.cfgread(n) is None]
    if unknown or not nick:
        raise HTTPException(404,detail=f"Nick inconnu : {', '.join(unknown) or nick}")   # ALL et listes : comme la CLI
    extra=[]
    if force: extra.append('-F')
    if snapshot_only: extra.append('-S')
    if archive: extra+=['-A',archive]
    try:
        pid=_launch_bkp_detached(nick,extra,x_borg_passphrase,cmd='index')
    except OSError as e:
        raise HTTPException(500,detail=f"Échec du lancement d'Index pour {nick} : {e}")
    return CommandResult(exitcode=0,stdout=f"Index lancé pour {nick} (pid {pid}) — asynchrone, avancement et résultat dans "
                                           "/access (build, index_last)",
                         stderr="")

