class CommandResult(BaseModel):
    exitcode: int
    stdout: str
    stderr: str

# ── Cache de réponses (commandes de lecture pure base SQLite) ──────────────────
# Certaines commandes (LstBkp, LstBkpFls, TreeHist, FileHist, Search, DuIdx, IdxTop, DiffTop,
# CacheInfo, DiffBkp, Report -o) ne lisent (ou n'écrivent, pour DiffBkp la première fois) que
# cache.db/diff.db — jamais l'état live du dépôt indépendamment de ces fichiers. Empreinte =
# mtime de tous les cache.db/diff.db concernés (tous les nicks connus si nick vide/'ALL') ;
# recalculée APRÈS l'exécution de la commande (couvre le cas DiffBkp qui peut écrire dans
# diff.db lors de son tout premier appel sur une paire non indexée) et comparée à l'entrée en
# cache : si identique, le résultat mis en cache est restitué sans relancer borgHelper.
_bh_paths=BorgHelper(cfgfile=CFGFILE)

def _validate_groups_paths_startup():
    """Fail-fast à l'import : valide la syntaxe GROUPS_PATHS de chaque nick connu (repli [DEFAULT]
    natif inclus) avant de servir le moindre trafic — attrape la faute de config la plus commune
    (séparateur ambiguë) tôt. Simple COURTOISIE, pas le seul point d'application : cfgread() relit
    .borghelperrc à chaque appel, donc _resolve_path_scope()/_parse_groups_paths() doivent aussi
    échouer bruyamment plus tard si la config est modifiée pendant que le process tourne (voir
    leurs docstrings et Boundaries du spec 1.1) — cette fonction ne les dispense pas de ça."""
    for n in [x.strip() for x in (_bh_paths.borg.cfgreadnicks() or '').split(',') if x.strip()]:
        cfg=_bh_paths.borg.cfgread(n)
        if cfg is None: continue
        try:
            _parse_groups_paths(cfg.get(_GROUPS_PATHS_KEY,'') or '')
        except ValueError as e:
            sys.exit(f"Configuration invalide — GROUPS_PATHS sur le nick '{n}' : {e}")

_validate_groups_paths_startup()
_RESPONSE_CACHE={}
# AD-13 : la clé inclut un condensé salé (sel aléatoire par processus, jamais persisté) de la
# passphrase de la requête, jamais la passphrase en clair — deux passphrases différentes pour le
# même (cmd,nick,args) n'interfèrent jamais. Sans passphrase (route non protégée) : composante
# absente de la clé, comportement actuel inchangé (comme aujourd'hui pour une base plain).
_RESPONSE_CACHE_SALT=secrets.token_bytes(32)

def _passphrase_digest(passphrase: Optional[str]) -> Optional[str]:
    # Choix délibéré, aligné sur `_exec_borghelper` (`if passphrase:` — ci-dessous) : une passphrase
    # vide ('') est traitée EXACTEMENT comme une passphrase absente (None), pas comme une passphrase
    # distincte. Les deux produisent la même exécution sous-jacente (aucun BORGHELPERC_RUNTIME_
    # PASSPHRASE positionné, repli sur la config serveur du nick) — les distinguer dans la clé de
    # `_RESPONSE_CACHE` créerait deux entrées pour un résultat strictement identique, sans gain de
    # sécurité. Si `_exec_borghelper` change un jour ce test de vacuité, ce test doit changer avec lui.
    if not passphrase: return None
    return hmac.new(_RESPONSE_CACHE_SALT,passphrase.encode('utf-8','surrogateescape'),hashlib.sha256).hexdigest()

# Messages/erreurs reconnaissables d'une base chiffrée sans/mauvaise passphrase (Story 1 AD-5) :
# soit le nom de l'exception (traceback non attrapé, cas actuel le plus courant côté borgHelper),
# soit un message ad hoc qui le mentionne. Un résultat qui matche n'est JAMAIS mis en cache
# (AD-13) : rejoué en erreur à chaque appel, jamais servi comme un succès obsolète ou trompeur.
_DB_KEY_ERROR_MARKERS=('DbKeyError','DbModeError','DbTamperError','DbCodecError')

def _is_db_key_error(result: CommandResult) -> bool:
    # Sur-approximation délibérée par sous-chaîne : une sortie borg/borgHelper qui contiendrait par
    # coïncidence l'un de ces mots (jamais vu en pratique, mais pas impossible, ex. dans un nom
    # d'archive ou un chemin) serait aussi exclue du cache — préféré à un faux négatif (AD-13).
    if result.exitcode==0: return False
    text=f"{result.stdout or ''}\n{result.stderr or ''}"
    return any(m in text for m in _DB_KEY_ERROR_MARKERS)

def _cache_db_paths(nick: Optional[str]):
    nicks=[n.strip() for n in nick.split(',')] if (nick and nick!='ALL') else \
        [n.strip() for n in _bh_paths.borg.cfgreadnicks().split(',')]
    paths=[]
    for n in nicks:
        if not n: continue
        paths.append(_bh_paths.db.get_diff_db(n))
        paths.append(_bh_paths.db.get_cache_db(n))
    return paths

def _cache_fingerprint(nick: Optional[str]) -> str:
    parts=[]
    for p in _cache_db_paths(nick):
        try: parts.append(f"{p}:{os.path.getmtime(p)}")
        except OSError: parts.append(f"{p}:absent")
    return '|'.join(parts)

# ── Cache SQLite par périmètre (Story 1.5) ──────────────────────────────────
# Depuis Stories 1.3/1.4, tout appelant scopé (au moins un nick à périmètre restreint) rate
# systématiquement `_RESPONSE_CACHE` (réservé au cas non restreint, AD-5) : `_run_scoped()`/
# `_run_scoped_raw()` relancent borgHelper et refiltrent à chaque appel, même pour une requête
# identique récemment servie. Ce cache dédié stocke le dérivé FILTRÉ (jamais le brut), avec pour
# clé (nick, commande, paramètres, signature_périmètre) — une ligne par nick réel, jamais une
# clé combinée pour une requête multi-nick (AD-5). Fichier SQLite séparé, même convention
# db_meta/schema_version que cache.db/diff.db — réutilise _open_db()/
# _check_set_meta() plutôt que de dupliquer ce code.
SCOPE_CACHE_DB=os.environ.get('BORGHELPERWWW_SCOPE_CACHE_DB') or \
    os.path.join(_bh_paths.db.cache_dir,f"{_bh_paths.db.db_prefix}-scopecache.db")
    # Suffixe sans tiret avant "cache" — délibéré : get_cache_db()/get_diff_db() produisent
    # toujours f"{db_prefix}-{nick}-cache.db"/f"{db_prefix}-{nick}-diff.db" (tiret immédiatement
    # avant "cache"/"diff"), donc aucun nick, quel que soit son nom (y compris "scope"), ne peut
    # jamais produire ce chemin par collision.
# Version MAXIMALE comprise (refus si la base est plus récente) vs version écrite dans la base
# (inchangée : un ancien binaire continue d'ouvrir ce cache tant qu'il n'est pas chiffré — AD-10).
SCOPE_CACHE_DB_SCHEMA_VERSION=2
SCOPE_CACHE_DB_BASE_SCHEMA_VERSION=1

def ensure_scope_cache_db():
    """Créé/valide le schéma de SCOPE_CACHE_DB — même convention que ensure_cache_db()/
    ensure_diff_db() de borgHelper (table db_meta + _check_set_meta pour schema_version/
    borghelper_version, échec bruyant SchemaVersionError si le schéma stocké est plus récent que
    SCOPE_CACHE_DB_SCHEMA_VERSION, 'DB corrompue' + sys.exit si le fichier est illisible/corrompu).
    Appelée une fois au démarrage (comme _validate_groups_paths_startup()) — le fichier n'est
    ensuite plus jamais recréé/migré en cours de route par ce process."""
    db=_bh_paths.db
    try:
        try: conn=_open_db(SCOPE_CACHE_DB,nick=None,role='admin')
        except sqlite3.OperationalError as e: _db_open_fail(SCOPE_CACHE_DB,e)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.executescript("""
            CREATE TABLE IF NOT EXISTS db_meta (
                key   TEXT PRIMARY KEY,
                value TEXT
            );
            CREATE TABLE IF NOT EXISTS scope_cache (
                cache_key   TEXT PRIMARY KEY,
                fingerprint TEXT NOT NULL,
                result_json TEXT NOT NULL,
                written_at  TEXT DEFAULT (datetime('now'))
            );
        """)
        db._check_set_meta(conn,SCOPE_CACHE_DB_SCHEMA_VERSION,SCOPE_CACHE_DB,SCOPE_CACHE_DB_BASE_SCHEMA_VERSION)
        conn.commit(); conn.close()
    except sqlite3.DatabaseError as e:
        print(f"DB corrompue : {SCOPE_CACHE_DB}",file=sys.stderr)
        print(f"  -> {e}",file=sys.stderr)
        print("  Supprimez le fichier et relancez pour reconstruire le cache de périmètre.",file=sys.stderr)
        sys.exit(1)

ensure_scope_cache_db()

