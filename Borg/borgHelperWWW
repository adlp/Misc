def _rc_scrub(text,e):
    """stderr d'un borgHelper du rc `e` : chemin du rc (lien et réel, forme JSON échappée comprise — droits du rc, « pas trouvé
    dans … ») remplacé par « <rc préfixe> » : l'API n'expose jamais un chemin de rc au-delà du préfixe ; conseils de commande
    « borgHelper -c … » complétés en « borgHelper -C <rc préfixe> -c … » (revue 1, row 22 : la commande vise le bon rc)."""
    if not text: return text
    for pth in sorted({e.path,e.real},key=len,reverse=True):
        for q in (pth,json.dumps(pth)[1:-1]): text=text.replace(q,f"<rc {e.prefix}>")
    return text.replace('borgHelper -c ',f"borgHelper -C <rc {e.prefix}> -c ")

def _rc_scrub_out(text,e):
    """stdout d'un borgHelper du rc `e` : revue 1 (row 15) — jamais les données (chemins d'archives) ; seulement les deux messages
    de borgHelper qui citent le rc (« <nick> pas trouvé dans <rc> », « Fichier <rc> absent »), ligne entière."""
    if not text: return text
    for pth in sorted({e.path,e.real},key=len,reverse=True):
        q=re.escape(pth)
        text=re.sub(rf'(?m)^(.* pas trouvé dans ){q}$',lambda m: m.group(1)+f"<rc {e.prefix}>",text)
        text=re.sub(rf'(?m)^Fichier {q} absent$',f"Fichier <rc {e.prefix}> absent",text)
    return text

def _expose_nom(nom,bare,exp):
    """`nom` d'une ligne de résumé de Report (« nick », « ***nick », « *** nick ») -> même forme au nom exposé."""
    m=re.fullmatch(r'(\*\*\* ?)?'+re.escape(bare),nom)
    return (m.group(1) or '')+exp if m else nom

def _expose_row(r,k,mp):
