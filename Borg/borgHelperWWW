# ── Mode dossier : rc servis (1.32.0, story 86, D194) ─────────────────────────────────────────────
# Table « préfixe -> (rc, BorgHelper de ce rc) » construite depuis [_borgHelperWWW_rc] du maître. Nick exposé = `préfixe:nick`
# partout côté WWW (API, clés internes, abonnements, caches) ; chaque borgHelper lancé reçoit le -C du rc du nick et le nick NU
# (_rc_groups, _argv_env_for) ; toute lecture de base passe par le BorgHelper de ce rc (_bhn). Relue à chaud : signature
# (mtime, taille, inode, ctime) du maître et de chaque rc listé, comparée à chaque _rc_state().
_RC_LIST_SECTION='_borgHelperWWW_rc'

class _RcEntry:
    """Un rc servi : préfixe, chemin du lien (abspath : seul -C passé à borgHelper, nom des bases), chemin réel (identité),
    nom listé (journal), CACHE_DIR réel, BorgHelper."""
    def __init__(self,prefix,path,listed,cache_dir,bh,real=None):
        self.prefix=prefix; self.path=path; self.listed=listed; self.cache_dir=cache_dir; self.bh=bh
        self.real=real or os.path.realpath(path)

class _RcState:
    """Liste en vigueur : entries {préfixe: _RcEntry} (ordre de la liste du maître, rc disponibles seulement), unavailable
    {préfixe} (listés mais absents ou illisibles), master (_RcEntry du maître)."""
    def __init__(self,entries,unavailable,master):
        self.entries=entries; self.unavailable=unavailable; self.master=master

def _rc_parse_master(master,cfgdir):
    """Liste [_borgHelperWWW_rc] du maître -> ([(préfixe, chemin du lien, nom listé)], problèmes). Lue sans interpolation et sans
    fusion de [DEFAULT] (default_section neutre : une clé de [DEFAULT] n'est jamais prise pour un rc), clés sensibles à la casse
    (noms de fichiers). Problèmes : maître illisible, section absente, préfixe invalide (mêmes caractères qu'un nick,
    _valid_nick_name) ou en double, fichier absolu ou hors du dossier, fichier listé deux fois, maître absent de sa liste.
    Revue 1 (row 12) : chemin du lien (abspath) rendu ; chemin réel pour le confinement et les doublons seulement."""
    try:
        with open(master,encoding='utf-8') as f: txt=f.read()
        cp=configparser.ConfigParser(interpolation=None,default_section='\x00defaut-neutre'); cp.optionxform=str
        cp.read_string(txt,source=os.path.basename(master))
    except (OSError,UnicodeDecodeError,configparser.Error) as e:
        return [],[f"maître illisible ({type(e).__name__} : {e})"]
    if not cp.has_section(_RC_LIST_SECTION):
        return [],[f"section [{_RC_LIST_SECTION}] absente du maître (une ligne « fichier = préfixe » par rc servi, maître compris)"]
    creal=os.path.realpath(cfgdir)
    out=[]; probs=[]; by_prefix={}; by_path={}
    for fname,prefix in cp.items(_RC_LIST_SECTION):
        fname=fname.strip(); prefix=(prefix or '').strip()
        if not _valid_nick_name(prefix):
            probs.append(f"préfixe invalide {prefix!r} ({fname}) — lettres, chiffres, « . », « _ », « - » (début : lettre ou chiffre), "
                         "ni ALL ni DEFAULT"); continue
        if prefix in by_prefix: probs.append(f"préfixe en double : {prefix} ({by_prefix[prefix]}, {fname})"); continue
        if not fname or os.path.isabs(fname):
            probs.append(f"{fname or '(vide)'} : chemin relatif au dossier des rc attendu"); continue
        path=os.path.abspath(os.path.join(cfgdir,fname)); real=os.path.realpath(path)
        if os.path.commonpath([real,creal])!=creal: probs.append(f"{fname} : hors du dossier des rc"); continue
        if real in by_path: probs.append(f"{fname} listé deux fois ({by_path[real]})"); continue
        by_prefix[prefix]=fname; by_path[real]=fname; out.append((prefix,path,fname))
    if not probs and os.path.realpath(master) not in by_path:
        probs.append(f"le maître {os.path.basename(master)} n'est pas dans sa propre liste [{_RC_LIST_SECTION}]")
    return out,probs

def _rc_cache_dir(path):
    """CACHE_DIR réel d'un rc, lu comme BorgHelper.__init__ (ConfigParser par défaut, [DEFAULT] cache_dir, ~ développé). Lève
    OSError/UnicodeDecodeError/configparser.Error si le rc est absent, illisible ou invalide (configparser.read ignore en
    silence un fichier qu'il ne peut pas ouvrir : ouverture d'abord)."""
    with open(path,encoding='utf-8') as f: txt=f.read()
    cp=configparser.ConfigParser(); cp.read_string(txt,source=os.path.basename(path))
    return os.path.realpath(os.path.expanduser(cp.defaults().get('cache_dir','~/.cache/borghelper')))

def _rc_dir_usable(d):
    """CACHE_DIR créable/utilisable SANS rien créer (revue 2, row 28) : dossier existant accessible en écriture, ou plus proche
    ancêtre existant qui l'est."""
    p=d
    while not os.path.exists(p):
        q=os.path.dirname(p)
        if q==p: return False
        p=q
    return os.path.isdir(p) and os.access(p,os.W_OK|os.X_OK)

def _rc_build(old=None):
    """-> (_RcState | None, problèmes de liste, rc indisponibles, chemins listés). Problème de liste (dont deux rc au même
    CACHE_DIR : la passphrase d'une base y serait lue dans l'autre rc — _DB_CFG_READERS de borgHelper est indexé par CACHE_DIR —
    et BorgCleanup d'un rc y verrait les bases de l'autre comme des nicks retirés ; revue 1 (row 4) : BorgHelper impossible à
    construire, CACHE_DIR non créable) : None. BorgHelper d'un rc gardé (`old`) tant que son chemin et son CACHE_DIR ne changent
    pas (état par processus de borgHelper conservé). Revue 2 : rc indisponible compté avec son dernier CACHE_DIR connu (row 24) ;
    liste ENTIÈRE validée avant toute construction de BorgHelper, lecteurs de passphrase de borgHelper rendus si une construction
    échoue quand même (row 28 : jamais un lecteur enregistré pour une liste refusée)."""
    lst,probs=_rc_parse_master(MASTER,CFGDIR)
    files=[path for _x,path,_y in lst]
    if probs: return None,probs,[],files
    found=[]; unav=[]; caches={}
    for prefix,path,fname in lst:
        try: cache=_rc_cache_dir(path)
        except (OSError,UnicodeDecodeError,configparser.Error) as e:
            unav.append((prefix,f"{fname} (préfixe {prefix}) absent ou illisible ({type(e).__name__} : {e})"))
            k=_RC['known_cache'].get(path)   # dernier CACHE_DIR connu de ce rc (même devenu indisponible) : toujours réservé
            if k is not None: caches.setdefault(k,fname)
            continue
        if cache in caches:
            probs.append(f"{fname} et {caches[cache]} partagent CACHE_DIR {cache} — un CACHE_DIR distinct par rc (bases et passphrases "
                         "jamais mélangées)"); continue
        caches[cache]=fname; found.append((prefix,path,fname,cache))
    for prefix,path,fname,cache in found:
        if not _rc_dir_usable(cache): probs.append(f"{fname} (préfixe {prefix}) : CACHE_DIR {cache} inutilisable (non créable)")
    if probs: return None,probs,unav,files
    readers=getattr(sys.modules.get(BorgHelper.__module__),'_DB_CFG_READERS',None); saved=dict(readers) if readers is not None else None
    entries={}
    for prefix,path,fname,cache in found:
        e=(old or {}).get(prefix)
        if e is None or e.path!=path or e.real!=os.path.realpath(path) or e.cache_dir!=cache:
            try: e=_RcEntry(prefix,path,fname,cache,BorgHelper(cfgfile=path))
            except (Exception,SystemExit) as x:
                probs.append(f"{fname} (préfixe {prefix}) : CACHE_DIR {cache} inutilisable ({type(x).__name__} : {x})"); break
        else: e.listed=fname
        entries[prefix]=e
    if probs:
        if saved is not None: readers.clear(); readers.update(saved)
        return None,probs,unav,files
    mreal=os.path.realpath(MASTER)   # revue 2 (row 38) : maître lien re-ciblé : relu à chaque relecture
    master=next((e for e in entries.values() if e.real==mreal),None)
    if master is None:   # maître listé mais illisible à la relecture (lu juste avant : course) — liste refusée cette fois
        return None,[f"maître {os.path.basename(MASTER)} illisible pendant la relecture"],unav,files
    return _RcState(entries,{p for p,_m in unav},master),[],unav,files

def _rc_www_section_warn(e):
    """[WARN] : section [_borgHelperWWW] d'un rc qui n'est pas le maître — jamais lue (décision 3) ; au démarrage et à chaud (row 42)."""
    try:
        with open(e.path,encoding='utf-8') as f: txt=f.read()
        cp=configparser.ConfigParser(interpolation=None); cp.read_string(txt)
        if cp.has_section('_borgHelperWWW'):
            print(f"[WARN] mode dossier : {e.listed} (préfixe {e.prefix}) a une section [_borgHelperWWW] — ignorée : seule celle "
                  f"du maître est lue",file=sys.stderr,flush=True)
    except (OSError,UnicodeDecodeError,configparser.Error): pass

def _rc_stat(p):
    try: s=os.stat(p); return (s.st_mtime_ns,s.st_size,s.st_ino,s.st_ctime_ns)
    except OSError: return None

# failed : la dernière relecture a échoué (ancienne liste gardée — aucun nettoyage d'abonnement sur un état périmé, row 11) ;
# suspended : préfixes réattribués à un autre fichier (décision 10, _rc_files_check) ; on_build : appelé après chaque liste prise
_RC={'state':None,'sig':None,'files':[],'warned':set(),'failed':False,'suspended':set(),'on_build':None,'known_cache':{}}
_RC_LOCK=threading.Lock()
import contextvars
_RC_REQ=contextvars.ContextVar('borghelperwww_rc_req',default=None)   # revue 1 (row 7) : instantané de la requête en cours

def _rc_warn(msgs):
    """[WARN] une fois par problème tant qu'il dure (un problème disparu puis revenu est redit)."""
    cur=set(msgs)
    for m in msgs:
        if m not in _RC['warned']: print(f"[WARN] mode dossier : {m}",file=sys.stderr,flush=True)
    _RC['warned']=cur

_RC_RETRY=30.0   # s : liste refusée — nouvel essai même sans changement de fichier (état extérieur : CACHE_DIR corrigé, row 34)

def _rc_sig(files):
    """Signature : maître, rc listés, et mémoire des fichiers par préfixe (row 36 : une levée de suspension vue sans attendre)."""
    mem=globals().get('PUSH_RC_FILES')
    return (_rc_stat(MASTER),tuple(_rc_stat(f) for f in files),_rc_stat(mem) if mem else None)

def _rc_live():
    """Liste en vigueur, relue si le maître, un rc listé ou la mémoire des préfixes a changé (requête suivante : pris en compte
    sans redémarrage). Liste invalide : [WARN] une fois, ancienne liste gardée — ses fichiers restent surveillés avec ceux de la
    nouvelle liste, nouvel essai toutes les _RC_RETRY s (row 34) ; rc listé absent ou illisible : [WARN] une fois, ses nicks
    absents (dits « indisponibles » : jamais retirés des abonnements). Revue 1 (row 3) : signature prise AVANT la lecture.
    Revue 2 (row 30) : mémoire des préfixes en échec : [WARN], jamais une erreur."""
    sig=_rc_sig(_RC['files'])
    retry=_RC['failed'] and time.monotonic()>=_RC.get('retry_at',0)
    mem=_RC.get('mem_retry_at') is not None and time.monotonic()>=_RC['mem_retry_at']   # revue 3 (row 51)
    if sig==_RC['sig'] and not retry and not mem: return _RC['state']
    with _RC_LOCK:
        sig=_rc_sig(_RC['files'])
        retry=_RC['failed'] and time.monotonic()>=_RC.get('retry_at',0)
        if sig==_RC['sig'] and not retry:
            if _RC.get('mem_retry_at') is not None and time.monotonic()>=_RC['mem_retry_at']: _rc_on_build(_RC['state'])
            return _RC['state']
        old=_RC['state']
        st,probs,unav,files=_rc_build({p:e for p,e in old.entries.items()})
        if st is None:
            served=[e.path for e in old.entries.values()]
            if files or served: _RC['files']=list(dict.fromkeys(served+files))
            _RC['failed']=True; _RC['retry_at']=time.monotonic()+_RC_RETRY
            _rc_warn([f"{m} — ancienne liste des rc gardée" for m in probs]+[m for _x,m in unav])
        else:
            if files: _RC['files']=files
            _RC['state']=st; _RC['failed']=False; _rc_warn([m for _x,m in unav])
            _RC['known_cache'].update({e.path:e.cache_dir for e in st.entries.values()})
            for p,e in st.entries.items():
                if e is not st.master and old.entries.get(p) is not e: _rc_www_section_warn(e)   # rc ajouté ou changé à chaud
            _rc_on_build(st)
        _RC['sig']=sig
        return _RC['state']

def _rc_on_build(st):
    """Mémoire des préfixes après une liste prise. Revue 2 (row 30) : échec -> [WARN], jamais une erreur ; revue 3 (row 51) :
    réessayée toutes les _RC_RETRY s (mem_retry_at) même sans changement de fichier, [WARN] une fois tant qu'elle échoue."""
    if _RC['on_build'] is None: return
    try: _RC['on_build'](st)
    except Exception as x:
        if _RC.get('mem_retry_at') is None:
            print(f"[WARN] mode dossier : mémoire des fichiers par préfixe non écrite ({type(x).__name__} : {x}) — nouvel essai toutes "
                  f"les {_RC_RETRY:.0f} s",file=sys.stderr,flush=True)
        _RC['mem_retry_at']=time.monotonic()+_RC_RETRY
    else: _RC['mem_retry_at']=None

def _rc_state():
    """État des rc : celui figé pour la requête en cours (_RC_REQ : `ALL` développé une fois — contrôle d'accès et exécution sur
    la même liste), sinon la liste en vigueur (_rc_live : watcher, démarrage)."""
    r=_RC_REQ.get()
    return r['state'] if r is not None else _rc_live()

def _rc_req_new():
    """Instantané d'une requête : état des rc et nicks de chaque rc lus une fois."""
    return {'state':_rc_live(),'nicks':{}}

@contextlib.contextmanager
def _rc_snapshot():
    """Revue 2 (row 33) : un instantané pour toute une passe (watcher, contrôle de schéma, nettoyage horaire) — jamais deux états
    dans une passe. Mode -C, ou instantané déjà posé : rien."""
    if not DIR_MODE or _RC_REQ.get() is not None:
        yield; return
    tok=_RC_REQ.set(_rc_req_new())
    try: yield
    finally: _RC_REQ.reset(tok)

def _rc_startup():
    """Démarrage du mode dossier : toute anomalie de la liste, tout rc listé absent ou illisible, tout CACHE_DIR inutilisable ->
    [ERREUR], refus."""
    sig=_rc_sig([path for _x,path,_y in _rc_parse_master(MASTER,CFGDIR)[0]])
    st,probs,unav,files=_rc_build()
    errs=probs+[m for _x,m in unav]
    if errs:
        for m in errs: print(f"[ERREUR] mode dossier ({MASTER}) : {m}",file=sys.stderr,flush=True)
        sys.exit(f"[ERREUR] mode dossier : démarrage refusé ({len(errs)} problème(s) ci-dessus)")
    _RC['files']=files; _RC['state']=st; _RC['sig']=sig
    _RC['known_cache'].update({e.path:e.cache_dir for e in st.entries.values()})
    for e in st.entries.values():   # [_borgHelperWWW] d'un autre rc : jamais lu (décision 3)
        if e is not st.master: _rc_www_section_warn(e)
    print(f"Mode dossier : {len(st.entries)} rc servi(s) — préfixes {', '.join(st.entries)} (maître : {st.master.prefix})",file=sys.stderr)

if DIR_MODE: _rc_startup()

def _rc_bare_nicks(e):
    """Nicks NUS du rc (cfgreadnicks : relu à chaque appel, comme en mode -C ; une fois par requête : instantané _RC_REQ).
    Revue 1 (row 11) : rc devenu illisible (liste ancienne gardée) -> aucun nick, jamais une erreur."""
    r=_RC_REQ.get()
    if r is not None and e.prefix in r['nicks']: return r['nicks'][e.prefix]
    try: v=[n.strip() for n in (e.bh.borg.cfgreadnicks() or '').split(',') if n.strip()]
    except (OSError,UnicodeDecodeError,configparser.Error) as x:
        v=[]
        if r is not None: r.setdefault('nicks_err',{})[e.prefix]=x   # 1.33.0 (revue 87a row 49) : /storage le dit, une seule lecture
    if r is not None: r['nicks'][e.prefix]=v
    return v

def _rc_sections(path):
    """Sections que `borgHelper -c Stats` sans -n affiche (stats(None) : toutes sauf DEFAULT et `_*`, celles portant une clé ALL
    comprises — pas cfgreadnicks). Revue 3 (row 47). Rc illisible : l'erreur remonte (500, comme en -C)."""
    if not path or not os.path.isfile(path): return []
    cp=configparser.ConfigParser(); cp.optionxform=str; cp.read(path)
    return [n for n in cp.keys() if n!='DEFAULT' and not n.startswith('_')]

def _stats_sections():
    """Noms (exposés) des sections que /stats sans nick affiche — mode -C : CFGFILE ; mode dossier : chaque rc servi."""
    if not DIR_MODE: return _rc_sections(CFGFILE)
    return [f"{e.prefix}:{b}" for e in _rc_state().entries.values() for b in _rc_sections(e.path)]

def _rc_entry_of(nick):
    """(_RcEntry, nick nu) d'un nick exposé `préfixe:nick` d'un rc disponible ; sinon (None, None). `préfixe:ALL` : inconnu
    (revue 1, row 5 — jamais un 3e moyen de viser tout un rc)."""
    p,sep,b=str(nick or '').partition(':')
    e=_rc_state().entries.get(p) if sep and b and b!='ALL' else None
    return (e,b) if e is not None else (None,None)

def _bhn(nick):
    """(BorgHelper, nick nu) du nick exposé. Mode -C : (_bh_paths, nick) — appels d'avant inchangés. Mode dossier : BorgHelper du
    rc du préfixe ; nom sans préfixe, préfixe inconnu ou rc indisponible -> HTTPException 404 « Nick inconnu » (routes ; le
    watcher et les sondes l'attrapent comme toute erreur d'un nick)."""
    if not DIR_MODE: return _bh_paths,nick
    e,b=_rc_entry_of(nick)
    if e is None: raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return e.bh,b

def _cfgread(nick):
    """Section rc du nick exposé, ou None (inconnu ; mode dossier : préfixe inconnu ou rc indisponible compris). Mode -C :
    _bh_paths.borg.cfgread(nick), comme avant. Revue 2 (row 41) : rc servi devenu illisible -> l'erreur de configparser remonte,
    comme en mode -C (500 « configuration illisible » des actions)."""
    if not DIR_MODE: return _bh_paths.borg.cfgread(nick)
    e,b=_rc_entry_of(nick)
    return e.bh.borg.cfgread(b) if e is not None else None

def _rc_groups(nick,cmd=None,args=(),skipped=None):
    """Mode dossier : nicks d'une requête regroupés par rc -> [(_RcEntry, valeur de -n pour CE rc, {nu: exposé})]. `ALL` ou absent :
    revue 2 (row 26) — liste EXPLICITE des nicks de chaque rc lus dans l'instantané de la requête (ceux qu'a vus le contrôle des
    droits ; jamais `-n ALL`, relu par l'enfant), moins, comme la CLI pour `-n ALL`, les nicks dont l'opération de `cmd` n'est pas
    permise (dépôt externe : dit dans `skipped`) ; rc sans nick restant : sauté. Liste : nicks nus du rc, dans l'ordre de la
    requête ; nom non résolu, liste vide (`,`) -> 404 « Nick inconnu ». Revue 3 : `nick=` VIDE -> 404 (row 45 : seul l'absent prend
    la valeur par défaut) ; Stats sans nick -> chaque rc lancé SANS -n (stats(None) : sections affichées = _rc_sections, toutes
    contrôlées par _check_group_access, row 47) ; `-L` reconnu comme option seulement, jamais comme valeur de -f (row 48)."""
    st=_rc_state()
    if nick is not None and not nick: raise HTTPException(404,detail="Nick inconnu : (vide)")
    if nick is None and cmd=='stats':
        return [(e,None,{b:f"{e.prefix}:{b}" for b in secs}) for e in st.entries.values() for secs in [_rc_sections(e.path)] if secs]
    if nick is None or nick=='ALL':
        op='read' if cmd=='restore' and '-L' in {args[i] for i in _opt_values(list(args))[1]} else command_op(cmd or '')
        gs=[]
        for e in st.entries.values():
            keep=[]
            for b in _rc_bare_nicks(e):
                if op!='read':
                    c=e.bh.borg.cfgread(b)
                    if c is not None and not op_allowed(c,op,f"{e.prefix}:{b}"):
                        if skipped is not None: skipped.append(f"{e.prefix}:{b}: dépôt externe — {cmd} non permis, nick écarté")
                        continue
                keep.append(b)
            if keep: gs.append((e,','.join(keep),{b:f"{e.prefix}:{b}" for b in keep}))
        return gs
    groups={}
    for n in _nick_list(nick):
        e,b=_rc_entry_of(n)
        if e is None: raise HTTPException(404,detail=f"Nick inconnu : {n}")
        g=groups.setdefault(e.prefix,(e,[],{}))
        if b not in g[2]: g[1].append(b); g[2][b]=n
    if not groups: raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return [(e,','.join(bs),mp) for e,bs,mp in groups.values()]

def _rc_launch_check(e):
    """Revue 2 (row 24) : au lancement, le CACHE_DIR que l'enfant lira dans son rc = celui de l'état servi (liste refusée à chaud,
    ancienne gardée : un rc modifié pointerait un autre CACHE_DIR) ; sinon 503 + [WARN], rien lancé."""
    try: cur=_rc_cache_dir(e.path)
    except (OSError,UnicodeDecodeError,configparser.Error): cur=None
    if cur!=e.cache_dir:
        print(f"[WARN] mode dossier : {e.listed} (préfixe {e.prefix}) : CACHE_DIR changé depuis la liste servie ({cur or 'rc illisible'}) "
              "— lancement refusé jusqu'à une liste valide",file=sys.stderr,flush=True)
        raise HTTPException(503,detail=f"rc du préfixe {e.prefix} modifié depuis la liste servie (CACHE_DIR) — lancement refusé, "
                            "corriger le rc ou la liste")

def _rc_scrub_all(text):
    """Chemins de TOUS les rc servis (lien et réel) remplacés par « <rc préfixe> » — messages d'erreur rendus par l'API."""
    if not DIR_MODE or not text: return text
    for e in _rc_state().entries.values():
        for pth in sorted({e.path,e.real},key=len,reverse=True): text=text.replace(pth,f"<rc {e.prefix}>")
    return text

