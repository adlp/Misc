@router.get("/access",tags=["lecture"],summary="Niveau d'accès (lecture/écriture/admin) ET périmètre de chemin de l'appelant sur chaque nick, d'après ses groupes — 200 pour un appel authentifié, SAUF 500 (non catché, par construction) si GROUPS_PATHS a été rendu ambigu dans .borghelperrc depuis le démarrage du process — voir README.md")
def access(request: Request, x_api_key: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    nicks=_nick_list('ALL')
    if not GROUPS_HEADER:
        # Fonctionnalité désactivée : pas de restriction par nick ni de périmètre, seuls
        # allow_destructive/allow_downloads (globaux) s'appliquent — 'admin'/scope:null partout
        # reflète cette absence de restriction par groupes pour que l'UI n'ait qu'une seule forme
        # de réponse à traiter, sans cas particulier côté client.
        return {'groups_auth_enabled':False,'nicks':{n:{'level':'admin','scope':None} for n in nicks}}
    user_groups=_parse_groups(request.headers.get(GROUPS_HEADER))
    level_names={0:'none',1:'read',2:'write',3:'admin'}
    result={}
    for n in nicks:
        cfg=_bh_paths.borg.cfgread(n)
        eff=_effective_level(user_groups,cfg) if cfg is not None else 0
        # _resolve_path_scope (donc _parse_groups_paths) n'est JAMAIS catché ici — une config
        # GROUPS_PATHS ambiguë doit remonter en 500 non catché, pas être dégradée en silence.
        scope=_resolve_path_scope(user_groups,cfg) if cfg is not None else None
        result[n]={'level':level_names[eff],'scope':scope}
    return {'groups_auth_enabled':True,'nicks':result}

