        # essai à la passe suivante ; jamais 60 s par nick dans la boucle du watcher
        errs=[]; st=bh.db.archive_view_check(p,repair=not stale,timeout=2,errors=errs)
        states[n]=st
        busy=st.startswith('error') and bool(errs) and _db_busy(errs[-1])
        if busy: _SCHEMA_BUSY[n]=_SCHEMA_BUSY.get(n,0)+1
        elif not st.startswith('error'): _SCHEMA_BUSY.pop(n,None)
        if st in ('mismatch','absent'):
            if stale: _warn(('view',n,disk),f"{n}: vue archive_snapshot_v différente du code — non réparée (code en mémoire périmé), redémarrer borgHelperWWW")
            else: print(f"[schema] {n}: vue archive_snapshot_v {'recréée' if st=='absent' else 'remise à jour'}",file=sys.stderr,flush=True)
        elif st=='newer':
            _warn(('newer',n),f"{n}: diff.db d'un schéma plus récent que borgHelper v{BORGHELPER_VERSION} en mémoire — redémarrer borgHelperWWW")
        elif st.startswith('error') and (not busy or _SCHEMA_BUSY.get(n,0)>=_SCHEMA_BUSY_PASSES):   # 1.31.19 : verrou passager -> muet
            _warn(('error',n,st),f"{n}: contrôle de schéma impossible ({st})")
