# seul fait foi). GROUPS_HEADER est le nom du header HTTP à lire (ex. 'X-Groups'), jamais la valeur.
def _is_valid_http_token(value):
    """RFC 7230 'token' (nom de header HTTP valide) : lettres/chiffres/quelques symboles, jamais
    d'espace ni de caractère non-ASCII. Extrait pour être testable directement (push_selftest)."""
    return bool(re.fullmatch(r"[!#$%&'*+\-.^_`|~0-9A-Za-z]+",value))

GROUPS_HEADER=os.environ.get('BORGHELPERWWW_GROUPS_HEADER','').strip() or None
if GROUPS_HEADER is not None and not _is_valid_http_token(GROUPS_HEADER):
    # Un nom de header HTTP n'accepte que le "token" RFC 7230 (ASCII imprimable restreint) — une
    # valeur malformée planterait sur TOUTE requête protégée par le RBAC (request.headers.get(...)
    # encode le nom en latin-1) plutôt qu'ici, une fois, avec un message clair. Piège réel constaté :
    # un commentaire resté collé à la valeur sur la même ligne dans un fichier de conf (configparser
    # n'a inline_comment_prefixes réglé nulle part dans ce projet — un commentaire va TOUJOURS sur sa
    # propre ligne, jamais après une valeur, voir docs/borghelperrc.example).
    sys.exit(f"BORGHELPERWWW_GROUPS_HEADER invalide : {GROUPS_HEADER!r} — un nom de header HTTP "
              "n'accepte que lettres/chiffres/'-' (RFC 7230 token). Un commentaire est-il resté "
