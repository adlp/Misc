            'allow_destructive':'BORGHELPERWWW_ALLOW_DESTRUCTIVE','allow_downloads':'BORGHELPERWWW_ALLOW_DOWNLOADS'}
_conf_path=os.environ.get('BORGHELPERWWW_CONF')
if _conf_path:
    if not os.path.isfile(_conf_path):
        sys.exit(f"Fichier de conf borgHelperWWW introuvable : {_conf_path}")
    _cp=configparser.ConfigParser()
    _cp.read(_conf_path)
    _sect=_cp['borgHelperWWW'] if _cp.has_section('borgHelperWWW') else _cp['DEFAULT']
    for _key,_envvar in _CONF_KEYS.items():
        if _envvar not in os.environ and _key in _sect:
            os.environ[_envvar]=_sect[_key]

def _env_bool(name,default):
    v=os.environ.get(name)
    if v is None: return default
    return v.strip().lower() in ('1','true','yes','on')

BORGHELPER_BIN=Path(os.environ.get('BORGHELPERWWW_BORGHELPER_BIN',Path(__file__).resolve().parent/'borgHelper'))
CFGFILE=os.environ.get('BORGHELPERWWW_CFGFILE')
API_KEY=os.environ.get('BORGHELPERWWW_API_KEY')
TIMEOUT=int(os.environ.get('BORGHELPERWWW_TIMEOUT','3600')) or None
# Sécurité : par défaut, aucune action destructrice sur les sauvegardes (Prune/DelBkp) — doit être
# explicitement autorisée. Les téléchargements (vue d'une restauration), eux, sont autorisés par défaut.
ALLOW_DESTRUCTIVE=_env_bool('BORGHELPERWWW_ALLOW_DESTRUCTIVE',False)
ALLOW_DOWNLOADS=_env_bool('BORGHELPERWWW_ALLOW_DOWNLOADS',True)

