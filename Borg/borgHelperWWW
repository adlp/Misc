def cacheclean(nick: str="ALL", x_api_key: Optional[str]=Header(default=None)):
    """Caches de borgHelper + depuis 1.27.3 les lignes de ces nicks dans scopecache.db (pur cache : recalculées
    à la prochaine requête filtrée)."""
    require_api_key(x_api_key)
    resp=run_borghelper('cacheclean',nick=nick)
    removed=0; err=None
    try:
        conn=_open_db(SCOPE_CACHE_DB,nick=None,role='write')
        try:
            for n in _nick_list(nick):
                pfx=_scope_cache_nick_prefix(n)
                removed+=conn.execute("DELETE FROM scope_cache WHERE substr(cache_key,1,?)=?",(len(pfx),pfx)).rowcount
            conn.commit()
        finally: conn.close()
    except sqlite3.Error as e:
        err=str(e)
    text=(f"\nscopecache.db : {removed} ligne(s) supprimée(s)\n" if err is None
          else f"\nscopecache.db : purge impossible ({err})\n")
    return _with_extra_stdout(resp,text)

