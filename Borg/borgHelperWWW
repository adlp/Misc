_RESPONSE_CACHE={}
# AD-13 : la clé inclut un condensé salé (sel aléatoire par processus, jamais persisté) de la
# passphrase de la requête, jamais la passphrase en clair — deux passphrases différentes pour le
# même (cmd,nick,args) n'interfèrent jamais. Sans passphrase (route non protégée) : composante
# absente de la clé, comportement actuel inchangé (comme aujourd'hui pour une base plain).
_RESPONSE_CACHE_SALT=secrets.token_bytes(32)

def _passphrase_digest(passphrase: Optional[str]) -> Optional[str]:
    # Choix délibéré, aligné sur `_exec_borghelper` (`if passphrase:` — ci-dessous) : une passphrase
    # vide ('') est traitée EXACTEMENT comme une passphrase absente (None), pas comme une passphrase
    # distincte. Les deux produisent la même exécution sous-jacente (aucun BORGHELPERC_RUNTIME_
    # PASSPHRASE positionné, repli sur la config serveur du nick) — les distinguer dans la clé de
    # `_RESPONSE_CACHE` créerait deux entrées pour un résultat strictement identique, sans gain de
    # sécurité. Si `_exec_borghelper` change un jour ce test de vacuité, ce test doit changer avec lui.
    if not passphrase: return None
    return hmac.new(_RESPONSE_CACHE_SALT,passphrase.encode('utf-8','surrogateescape'),hashlib.sha256).hexdigest()

# Messages/erreurs reconnaissables d'une base chiffrée sans/mauvaise passphrase (Story 1 AD-5) :
# soit le nom de l'exception (traceback non attrapé, cas actuel le plus courant côté borgHelper),
# soit un message ad hoc qui le mentionne. Un résultat qui matche n'est JAMAIS mis en cache
# (AD-13) : rejoué en erreur à chaque appel, jamais servi comme un succès obsolète ou trompeur.
_DB_KEY_ERROR_MARKERS=('DbKeyError','DbModeError','DbTamperError','DbCodecError')

def _is_db_key_error(result: CommandResult) -> bool:
    # Sur-approximation délibérée par sous-chaîne : une sortie borg/borgHelper qui contiendrait par
    # coïncidence l'un de ces mots (jamais vu en pratique, mais pas impossible, ex. dans un nom
    # d'archive ou un chemin) serait aussi exclue du cache — préféré à un faux négatif (AD-13).
    # 1.28.6 (borgHelper 1.0.167) : quel que soit le code de sortie — un lecteur multi-nicks dont un seul nick a une base
    # inutilisable ({nick: {'error': 'DbKeyError : …'}}) sortait en 0 (en 1 depuis borgHelper 1.0.178) : jamais mis en cache.
    text=f"{result.stdout or ''}\n{result.stderr or ''}"
    return any(m in text for m in _DB_KEY_ERROR_MARKERS)

def _never_cache(result: CommandResult) -> bool:
    """Réponse jamais mise en cache — MÊME prédicat aux trois écritures (_RESPONSE_CACHE, _scoped_cached_mono/_multi) :
    DbKeyError (AD-13) ou, 1.29.0 (story 37, A67), arrêt d'un nick (`[ERREUR]` sur stderr : base occupée, corrompue,
    illisible, schéma, index vide — inventaire mesuré) ; un lecteur multi-nicks sortait en 0 quand un seul nick s'arrête (en 1
    depuis borgHelper 1.0.178) : une erreur passagère (« DB occupée ») restait servie. « Index vide » : [WARN] depuis borgHelper
    1.0.179, mis en cache, renouvelé par l'empreinte (mtime et -wal des bases). Revue : « SQLite error » (stdout `-j` ou stderr) exclu aussi — avant borgHelper 1.0.178 les lecteurs
    l'avalaient en code 0 sans [ERREUR] ; le cache ne retient que les codes 0/1, la règle reste utile pour le code 1.
    1.31.14 (revue story 76, borgHelper 1.0.198) : toute réponse qui contient le texte d'un borg create orphelin (« borg create
    encore actif », stdout ou stderr — Report, Report -o, voisin, Status compris) jamais en cache : un create orphelin AVANT le
    verrou du dépôt n'est pas dans le lock.roster, l'empreinte ne change pas s'il meurt sans avoir pris le verrou
    (BORG_LOCK_WAIT dépassé) — « encore actif », code 1, était resservi jusqu'à 5 min. Effet réel dans run_borghelper
    (_RESPONSE_CACHE, codes 0 et 1) ; les caches par périmètre ne gardent que le code 0 de commandes qui n'impriment jamais ce
    texte. Texte = _ORPHAN_TXT, importé de borgHelper (aux 5 sites qui l'impriment).
    1.31.16 (story 79, borgHelper 1.0.201) : « [WARN] <base>: mesures d'avant 1.0.139 pas encore migrées (<base> occupée) — … »
    (stderr) : réponse d'un lecteur rendue SANS les mesures d'une diff.db d'avant 1.0.139 qu'il n'a pas pu migrer (base occupée) ;
    en cache, elle serait resservie sans nouvel essai de migration (l'empreinte ne bouge pas tant que rien n'est écrit). Texte =
    _MIGR_PENDING_TXT, importé de borgHelper."""
    text=f"{result.stdout or ''}\n{result.stderr or ''}"
    return (_is_db_key_error(result) or '[ERREUR]' in (result.stderr or '') or 'SQLite error' in text
            or _ORPHAN_TXT in text or _MIGR_PENDING_TXT in text)

def _cache_db_paths(nick: Optional[str]):
    if DIR_MODE: nicks=_nick_list(nick)   # 1.32.0 (story 86) : nicks exposés, bases du rc de chacun
    else:
        nicks=[n.strip() for n in nick.split(',')] if (nick and nick!='ALL') else \
            [n.strip() for n in _bh_paths.borg.cfgreadnicks().split(',')]
    paths=[]
    for n in nicks:
        if not n: continue
        try: bh,b=_bhn(n)
        except HTTPException: continue   # mode dossier, nick non résolu : la requête répond 404 (_rc_groups)
        paths.append(bh.db.get_diff_db(b))
        paths.append(bh.db.get_cache_db(b))
        paths.append(bh.db.get_history_db(b))   # mesures (RepoHistory, ArchiveHistory, Report -o) : 1.0.139
    return paths

def _cache_fingerprint(nick: Optional[str]) -> str:
    parts=[]
    for p in _cache_db_paths(nick):
        try: parts.append(f"{p}:{os.path.getmtime(p)}")
        except OSError: parts.append(f"{p}:absent")
        # 1.31.1 (revue story 42) : -wal aussi — un Index écrit d'abord dans le journal WAL, le fichier principal ne bouge qu'au
        # checkpoint ; « Index vide » ([WARN], 1.0.179) est mis en cache et doit être renouvelé dès la 1re tranche (CAP-8)
        try: w=os.stat(p+'-wal'); parts.append(f"-wal:{w.st_mtime_ns}:{w.st_size}")
        except OSError: parts.append("-wal:absent")
    return '|'.join(parts)

# 1.29.0 (story 37, A66, décisions de l'utilisateur) : commandes en cache qui lisent un état extérieur aux bases — Report -o
# (présence du dépôt, heure : « depuis », MAX_AGE_BKP, place libre) et DiffBkp (présence, `borg list` en direct : dernière paire
# d'archives) ; empreinte + présence de chaque dépôt local, durée de vie 5 min (secondes ; commande absente = sans limite).
_CACHE_TTL={'report':300,'diffbkp':300}
# 1.31.3 (revue story 56) : sondes bornées partagées — une seule en vol par (sorte, nick), inscrite sous verrou AVANT son départ
# (avant : lue puis inscrite sans verrou, des requêtes concurrentes lançaient chacune la leur) ; une requête concurrente attend la
# même ; bloquée au-delà de 1 s : marquée « figée », les suivantes rendent aussitôt la valeur de repli.
_PROBE_LOCK=threading.Lock()
_PROBES={}   # (sorte, nick) -> {'t': thread, 'res': {'v': …}, 'stuck': bool}

_PROBE_WAIT=1.0   # attente d'une sonde bornée (s) ; 1.31.5 : variable (le selftest l'allonge pour ses contrôles réels sous charge)

def _bounded_probe(kind: str, n: str, fn, frozen):
    with _PROBE_LOCK:
        e=_PROBES.get((kind,n))
        if e is not None and e['t'].is_alive() and e['stuck']: return frozen()
        if e is None or not e['t'].is_alive():
            e={'res':{},'stuck':False}
            def run(e=e):
                try: e['res']['v']=fn()
                except (Exception,SystemExit): e['res']['v']='?'
            e['t']=threading.Thread(target=run,daemon=True,name=f"{kind}-{n}"); _PROBES[(kind,n)]=e; e['t'].start()
    e['t'].join(_PROBE_WAIT)
    if e['t'].is_alive(): e['stuck']=True; return frozen()
    return e['res'].get('v','?')

def _repo_presence(n: str) -> str:
    """'ok' | 'absent' | '?' (nick illisible) — repoLocalAbsent dans une sonde bornée (_bounded_probe, 1 s) : un montage réseau
    figé (os.open sans délai) ne bloque jamais un thread de requête ; sans réponse -> 'ok' (présent mais muet, comme
    repoLocalAbsent pour un dépôt inaccessible), une seule sonde en attente par nick (revue story 37, verrou : revue story 56)."""
    def probe():
        bh,b=_bhn(n)   # 1.32.0 : rc du nick (non résolu : '?' par la sonde)
        return 'absent' if bh.borg.repoLocalAbsent(b) else 'ok'
    return _bounded_probe('presence',n,probe,lambda: 'ok')

def _pid_alive(pid) -> bool:
    """1.31.3 (revue story 56) : processus vivant au sens de /proc/<pid>/stat — zombie (Z) ou mort (X), absent : non. Un
    borgHelper lancé par POST /bkp puis tué reste zombie, enfant du worker, jusqu'au Popen suivant (os.kill(pid, 0) y réussit)."""
    return _pid_alive_start(pid)[0]   # 1.31.5 (revue story 59) : lecteur de borgHelper, un seul ; 1.31.13 : règle commune au roster

def _pid_alive_start(pid) -> tuple:
    """1.31.13 (story 75, D173) : (vivant, heure de démarrage) d'un processus en UNE lecture de /proc/<pid>/stat (_pid_stat de
    borgHelper, seul parseur de _pid_state, _proc_start et _proc_live) — vivant : règle de _pid_alive ; début : champ 22 tel que
    lu (None si illisible ou PID invalide)."""
    try: st,start=_pid_stat(int(pid))
    except ValueError: return False,None
    return st not in ('Z','X',None),start   # 1.31.5 (revue story 59) : zombie et mort (X) comptent morts, illisible aussi

_BKPSTATE_LAST={}   # nick -> dernier état du Bkp lu par _bkp_state (repli d'une sonde figée)

def _bkp_state(n: str) -> dict:
    """1.31.5 (story 59, A115, décisions de l'utilisateur) : état du Bkp du nick pour /access et l'alerte de retard — celui de
    Status (borgHelper bkp_state : marqueur de Bkp vivant, en attente de l'Index, borg create orphelin, interrompu ; un PID zombie
    compte mort, borgHelper 1.0.188). {'bkp_running': True (vivant, en attente, orphelin) | False | None (inconnu, jamais une fin),
    'bkp_detail': 'en_cours'|'en_attente'|'orphelin'|None, 'bkp_interrupted': {started_at, verifie}|None}. Coût par sondage (/access
    toutes les 30 s, watcher) : base (bkp_running_state) et marqueurs (glob de CACHE_DIR) ; bkp_state (lock.roster du dépôt local
    pour un orphelin ; borgHelper 1.0.198 : sans marqueur vivant ni orphelin du roster, lignes ouvertes relues et, s'il y en a une
    non périmée, un parcours de /proc pour un borg create orphelin AVANT le verrou — ~10 ms pour 666 processus, mesuré) seulement
    s'il existe une ligne ouverte non périmée ou un marqueur, dans une sonde bornée (_bounded_probe, 1 s, une seule en vol par
    nick ; figée : dernier état lu, sinon inconnu)."""
    unknown={'bkp_running':None,'bkp_detail':None,'bkp_interrupted':None}
    try:
        bh,b=_bhn(n)   # 1.32.0 : rc du nick ; repli d'une sonde figée et clés internes sous le nick exposé
        base=bh.db.bkp_running_state(b,_bkp_timeout(n))
        if base is None: return unknown
        if not base and not bh.db.bkp_markers(b):
            _BKPSTATE_LAST.pop(n,None)   # revue : un état d'un Bkp précédent n'est jamais le repli d'une sonde figée plus tard
            return {'bkp_running':False,'bkp_detail':None,'bkp_interrupted':None}
    except (Exception,SystemExit): return unknown
    def read():
        bs=bh.bkp_state(b); r=bs['bkp_running']
        if bs.get('bkp_unknown') and not r: v=unknown
        elif base and not r and not bs['bkp_interrupted'] and not bs['bkp_stale'] and bh.db.bkp_running_state(b,_bkp_timeout(n)) is not False:
            v=unknown   # revue : ligne ouverte vue par la garde mais rien rendu (get_running_bkp_status avale une erreur SQLite)
        else: v={'bkp_running':bool(r),'bkp_interrupted':bs['bkp_interrupted'],
                 'bkp_detail':('orphelin' if r['orphelin'] else 'en_attente' if r['en_attente'] else 'en_cours') if r else None}
        _BKPSTATE_LAST[n]=v; return v
    try: v=_bounded_probe('bkpstate',n,read,lambda: _BKPSTATE_LAST.get(n,unknown))
    except (Exception,SystemExit): return unknown   # revue : sonde impossible (fil non démarré) -> inconnu, jamais un 500
    return v if isinstance(v,dict) else unknown

_ROSTER_LAST={}   # nick -> dernier état lu du lock.roster (repli d'une sonde figée : empreinte stable, réponse en cache gardée)

def _repo_roster_state(n: str) -> str:
    """1.31.3 (story 56, A113) : détenteurs exclusifs du lock.roster du dépôt local du nick (repo_lock_holders de borgHelper :
    dépôt distant, roster absent ou illisible -> rien), triés, « pid:1:<début> » pour un vivant, « pid:0 » pour un mort, un
    zombie ou /proc illisible (_pid_alive_start : zombie = mort ; début = champ 22 de /proc/<pid>/stat, lu avec l'état), lus
    par une sonde bornée (_bounded_probe, 1 s, une seule en vol par nick). Revue : sonde figée -> DERNIER état lu (ou '?' s'il
    n'y en a pas encore) : l'empreinte ne change pas, la réponse en cache est gardée (comme la présence, 'ok') ; un résultat
    tardif devient le dernier état lu. 1.31.13 (story 75, D173) : le début d'un vivant (avant : « pid:1 » seul) — un détenteur
    tué dont le PID est réattribué entre deux appels change l'empreinte (avant : réponse « borg create encore actif » resservie
    jusqu'à 5 min) ; « pid:0 » inchangé."""
    def holder(p):
        alive,start=_pid_alive_start(p)
        return f"{p}:1:{start}" if alive else f"{p}:0"
    def read():
        bh,b=_bhn(n)   # 1.32.0 : rc du nick
        v=','.join(holder(p) for p in sorted(bh.db.repo_lock_holders(b)))
        _ROSTER_LAST[n]=v; return v
    return _bounded_probe('roster',n,read,lambda: _ROSTER_LAST.get(n,'?'))

_MARKER_RE=re.compile(r'-bkp\.lock\.[0-9a-f]{32}(?:\.sans-suivi)?$')   # 1.31.12 (story 74) : trace « sans suivi » de borgHelper 1.0.196 comprise

def _bkp_markers_state() -> str:
    """1.31.3 (story 56, décision de l'utilisateur) : TOUS les marqueurs de Bkp de CACHE_DIR (un voisin du même dépôt compris :
    Report dit « Bkp de X en cours »), « nom:porteur » (_lock_holder : alive/dead/gone/me ; revue : 'zombie' si son PID est un
    zombie, _pid_alive) — lecture seule, jamais retirés ici (Report et Status s'en chargent) ; revue : run_id de 32 hex seulement
    (jamais les « .<pid>.tmp » d'écriture de _set_pid_lock). 1.31.12 (story 74) : aussi la trace « <marqueur>.sans-suivi »
    (borgHelper 1.0.196 : Bkp en cours sans ligne bkp_status) — sinon « en attente de l'Index » restait en cache jusqu'à 5 min
    après son apparition. Erreur : '?'."""
    import glob
    try:
        # 1.32.0 (story 86) : mode dossier — marqueurs de chaque rc servi (CACHE_DIR distincts), dans l'ordre des chemins
        dbs=[e.bh.db for e in _rc_state().entries.values()] if DIR_MODE else [_bh_paths.db]; out=[]
        found=sorted(((p,db) for db in dbs
                      for p in glob.glob(os.path.join(glob.escape(db.cache_dir),f"{glob.escape(db.db_prefix)}-*-bkp.lock.*"))),
                     key=lambda x: x[0])
        for p,db in found:
            if not _MARKER_RE.search(p): continue
            h=db._lock_holder(p)
            if h in ('alive','me'):
                try:
                    with open(p) as f: pid=int(f.read().strip())
                except (OSError,ValueError): pid=None
                if pid and not _pid_alive(pid): h='zombie'
            out.append(f"{os.path.basename(p)}:{h}")
        return ','.join(out)
    except (Exception,SystemExit): return '?'

def _external_fingerprint(cmd: str, nick: Optional[str]) -> str:
    """Part « état extérieur » d'une empreinte (les deux caches) : présence de chaque dépôt local des commandes de _CACHE_TTL.
    1.31.3 (story 56, A113) : Report -o y ajoute les marqueurs de Bkp et le lock.roster de chaque dépôt local — un Bkp qui démarre,
    un borgHelper tué, un borg orphelin qui finit renouvellent la réponse (avant : jusqu'à 5 min de « Bkp en cours » de trop)."""
    if cmd not in _CACHE_TTL: return ''
    fp='|repos:'+','.join(f"{n}:{_repo_presence(n)}" for n in _nick_list(nick))
    if cmd=='report':
        fp+='|bkp:'+_bkp_markers_state()+'|roster:'+','.join(f"{n}:{_repo_roster_state(n)}" for n in _nick_list(nick))
        fp+='|storage:'+_storage_state_mtimes()   # 1.34.0 (revue 87b row 25) : ⚠ stockage changé par le Bkp d'un autre nick
    return fp

def _storage_state_mtimes() -> str:
    """1.34.0 (story 87b, revue row 25) : date de modification (ns) de l'état d'alerte des stockages de chaque rc servi
    (CACHE_DIR/<préfixe>-storage-alert.json) — absent : « - » ; erreur : '?'."""
    try:
        dbs=[e.bh.db for e in _rc_state().entries.values()] if DIR_MODE else [_bh_paths.db]; out=[]
        for db in dbs:
            try: out.append(str(os.stat(_storage_alert_path(db)).st_mtime_ns))
            except FileNotFoundError: out.append('-')
        return ','.join(out)
    except (Exception,SystemExit): return '?'

def _response_fingerprint(cmd: str, nick: Optional[str]) -> str:
    """Empreinte d'une entrée de _RESPONSE_CACHE — MÊME fonction à la lecture et à l'écriture : mtimes des bases
    (_cache_fingerprint) + état extérieur (_external_fingerprint) ; disque démonté -> recalcul, « ⚠ dépôt absent » jamais
    masqué (remonté : l'entrée d'avant le démontage, même état, resservie)."""
    return _cache_fingerprint(nick)+_external_fingerprint(cmd,nick)

