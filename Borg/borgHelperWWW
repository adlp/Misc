    ),
)

# ── Auth ─────────────────────────────────────────────────────────────────────

def require_api_key(x_api_key: Optional[str]=Header(default=None)):
    if not x_api_key or not secrets.compare_digest(x_api_key,API_KEY):
        raise HTTPException(401,detail="X-API-Key manquant ou invalide")

# ── Exécution borgHelper ────────────────────────────────────────────────────

class CommandResult(BaseModel):
    exitcode: int
    stdout: str
    stderr: str

def run_borghelper(cmd: str, nick: Optional[str]=None, extra_args=(), passphrase: Optional[str]=None) -> JSONResponse:
    argv=[sys.executable,str(BORGHELPER_BIN),'-C',CFGFILE,'-c',cmd]
    if nick: argv+=['-n',nick]
    argv+=list(extra_args)
    env=os.environ.copy()
    if passphrase: env['BORGHELPERC_RUNTIME_PASSPHRASE']=passphrase
    try:
        proc=subprocess.run(argv,capture_output=True,text=True,timeout=TIMEOUT,env=env)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail=f"Commande {cmd} : timeout après {TIMEOUT}s")
    result=CommandResult(exitcode=proc.returncode,stdout=proc.stdout,stderr=proc.stderr)
    return JSONResponse(status_code=200 if proc.returncode==0 else 400,content=result.dict())

# ── Téléchargements (accès borg direct, streaming binaire) ─────────────────────
# Seule exception au principe "tout passe par borgHelper en sous-processus" : un téléchargement
# doit streamer des octets bruts vers le navigateur, incompatible avec le pipe texte/JSON de
# run_borghelper(). Lit la conf via BorgRunner (mode librairie, cfgfile+passphrase), exécute borg
# directement (extract --stdout / export-tar) et streame son stdout comme réponse HTTP.

_BORG_ENV_KEYS=('BORG_REPO','BORG_PASSPHRASE','BORG_REMOTE_PATH','BORG_RSH','BORG_SHOW_SYSINFO',
                 'BORG_RELOCATED_REPO_ACCESS_IS_OK','BORG_KEY_FILE')
_FILENAME_UNSAFE=re.compile(r'[^A-Za-z0-9_.\-]+')

def _borg_cfg(nick: str, passphrase: Optional[str]):
    cfg=BorgRunner(cfgfile=CFGFILE,passphrase=passphrase).cfgread(nick)
    if cfg is None:
        raise HTTPException(404,detail=f"Nick inconnu : {nick}")
    return cfg

def _borg_env(cfg):
    env=os.environ.copy()
    for k in _BORG_ENV_KEYS:
        if k in cfg.keys(): env[k]=cfg[k]
    return env

def _latest_archive(cfg,env):
    borg_exe=cfg.get('BORG_EXE','borg')
    try:
        proc=subprocess.run([borg_exe,'list','--short','--glob-archives',cfg['GLOB_ARCH'],cfg['BORG_REPO']],
                             capture_output=True,text=True,env=env,timeout=60)
    except subprocess.TimeoutExpired:
        raise HTTPException(504,detail="borg list : timeout")
    if proc.returncode!=0:
        raise HTTPException(502,detail=f"borg list a échoué : {proc.stderr[:300]}")
    lines=[l for l in proc.stdout.splitlines() if l.strip()]
    if not lines:
        raise HTTPException(404,detail="Aucune archive dans ce dépôt")
    return lines[-1]

def _safe_filename(name: str) -> str:
    name=(name or '').strip('/').split('/')[-1] or 'download'
    return _FILENAME_UNSAFE.sub('_',name) or 'download'

def _stream_proc(proc):
    try:
        while True:
            chunk=proc.stdout.read(65536)
            if not chunk: break
            yield chunk
    finally:
        try: proc.stdout.close()
        except Exception: pass
        proc.wait()

@app.get("/download/file",tags=["téléchargement"],summary="Télécharge un fichier depuis une archive (borg extract --stdout)")
def download_file(nick: str, path: str, bid: Optional[str]=None,
                   x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    proc=subprocess.Popen([borg_exe,'extract','--stdout',f"{cfg['BORG_REPO']}::{archive}",path],
                          stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    return StreamingResponse(_stream_proc(proc),media_type='application/octet-stream',
        headers={'Content-Disposition':f'attachment; filename="{_safe_filename(path)}"'})

@app.get("/download/tar",tags=["téléchargement"],summary="Télécharge un .tar d'une arborescence depuis une archive (borg export-tar)")
def download_tar(nick: str, prefix: Optional[str]=None, bid: Optional[str]=None,
                  x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    cmd=[borg_exe,'export-tar',f"{cfg['BORG_REPO']}::{archive}",'-']
    if prefix: cmd.append(prefix)
    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
    filename=(_safe_filename(prefix) if prefix else nick)+'.tar'
    return StreamingResponse(_stream_proc(proc),media_type='application/x-tar',
        headers={'Content-Disposition':f'attachment; filename="{filename}"'})

