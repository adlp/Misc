# Chacune des quatre fonctions ci-dessous imite, EXACTEMENT, la forme que sa route produit
# aujourd'hui pour un chemin qui n'existe dans aucune archive (voir Intent du spec 2.1) — jamais un
# 403 (voir require_path_in_scope ci-dessus). Texte/formes re-vérifiés EN DIRECT contre
# demo.borghelperrc avant implémentation (Design Notes du spec 2.1 : le texte gelé de l'Intent
# pouvait être obsolète) — deux écarts trouvés et corrigés par rapport au texte gelé, consignés dans
# le Spec Change Log du spec 2.1 :
#   1. `GET /restore/perms` : la ligne d'archive absente d'index est "Archive (dernière) : <bid>",
#      jamais "Archive : <bid>" (qui ne peut au contraire apparaître QUE quand le chemin a été
#      trouvé dans l'index — donc jamais dans le cas "introuvable" que cette story doit imiter).
#   2. `GET /download/tar` : le tar minimal vide fait 10240 octets (RECORDSIZE, `tarfile` bufferise
#      toujours un enregistrement complet en mode stream, même vide), jamais 1024 (deux blocs de
#      512 zéros) — vérifié byte-pour-byte identique à un `borg export-tar` réel sans le moindre
#      membre.
# 1.27.5 (deferred-work point 8, option D) : plus AUCUNE imitation. Les réponses « introuvable » étaient
# fabriquées en recopiant les libellés de borgHelper et de borg (avertissement --numeric-owner, « Include pattern
# … never matched. ») : elles dérivaient dès qu'une version changeait — constaté : pour un joker, la vraie réponse
# est code 0 sans « never matched » depuis borgHelper 1.0.122, l'imitation code 1 avec — et elles étaient
# instantanées alors qu'une vraie recherche parcourt l'archive. Deux oracles d'existence (texte, temps) pour un
# appelant restreint. Désormais la VRAIE commande est exécutée sur un LEURRE garanti inexistant, de même forme
# (joker ou non), et le leurre est remplacé par le chemin demandé dans le texte : réponse identique à celle d'un
# chemin réellement absent par construction, quelles que soient les versions, temps compris. Rien n'est extrait
# (le leurre n'existe pas) ; noms de fichier des téléchargements = ceux du chemin demandé.
def _oos_decoy(path):
    """Leurre hors périmètre : nom aléatoire (64 bits) sous la racine, joker conservé si `path` en contient un."""
    decoy='.bh-absent-'+secrets.token_hex(8)
    return decoy+'/*' if path and ('*' in path or '?' in path) else decoy

def _oos_swap(result_resp,decoy,path):
    """Remplace le leurre par le chemin demandé dans stdout/stderr d'une réponse CommandResult."""
    try: data=json.loads(result_resp.body)
    except ValueError: return result_resp
    for k in ('stdout','stderr'):
        if isinstance(data.get(k),str): data[k]=data[k].replace(decoy,path or '')
    return JSONResponse(status_code=result_resp.status_code,content=data)

def _download_tar_filename(nick,prefix):
    """Nom de fichier `.tar` — celui du préfixe DEMANDÉ, y compris hors périmètre (leurre invisible)."""
    if not prefix and DIR_MODE: nick=_FILENAME_UNSAFE.sub('_',nick)   # 1.32.0 : « web:db » -> « web_db.tar »
    return (_safe_filename(prefix) if prefix else nick)+'.tar'

@router.get("/download/file",tags=["téléchargement"],summary="Télécharge un fichier depuis une archive (borg extract --stdout)")
def download_file(nick: str, path: str, request: Request, bid: Optional[str]=None,
                   x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    target=path if require_path_in_scope(request,nick,path) else _oos_decoy(None)  # hors périmètre : leurre (1.27.5)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    # 1.30.2 (A83) : code de borg lu — introuvable (ou hors périmètre, leurre) 404, échec 502, échec en cours : flux coupé
    body=_borg_stream(request,[borg_exe,'extract','--stdout',f"{cfg['BORG_REPO']}::{archive}",target],env,'borg extract',
                      decoy=None if target==path else target,path=path,missing=f"{path} introuvable dans l'archive {archive}")
    return _ClosingStreamingResponse(body,media_type='application/octet-stream',
        headers={'Content-Disposition':f'attachment; filename="{_safe_filename(path)}"'})

@router.get("/download/tar",tags=["téléchargement"],summary="Télécharge un .tar d'une arborescence depuis une archive (borg export-tar)")
def download_tar(nick: str, request: Request, prefix: Optional[str]=None, bid: Optional[str]=None,
                  x_api_key: Optional[str]=Header(default=None), x_borg_passphrase: Optional[str]=Header(default=None)):
    require_api_key(x_api_key)
    require_downloads_allowed()
    # Préfixe absent = export de l'archive ENTIÈRE (racine) : jamais "dans le périmètre" pour un
    # appelant restreint quel qu'il soit (I/O Matrix du spec 2.1) — require_path_in_scope(...,'')
    # via `prefix` (None accepté tel quel, _path_in_scope normalise) tranche déjà correctement ce
    # cas : illimité -> True (accès identique à aujourd'hui), restreint -> toujours False.
    target=prefix if require_path_in_scope(request,nick,prefix) else _oos_decoy(None)  # hors périmètre : leurre (1.27.5)
    cfg=_borg_cfg(nick,x_borg_passphrase)
    env=_borg_env(cfg)
    archive=bid or _latest_archive(cfg,env)
    borg_exe=cfg.get('BORG_EXE','borg')
    cmd=[borg_exe,'export-tar',f"{cfg['BORG_REPO']}::{archive}",'-']
    if target: cmd.append(target)
    # 1.30.2 (A83) : code de borg lu — échec avant le 1er octet 502, en cours : flux coupé ; préfixe absent : tar vide (inchangé)
    body=_borg_stream(request,cmd,env,'borg export-tar',decoy=None if target==prefix else target,path=prefix)
    return _ClosingStreamingResponse(body,media_type='application/x-tar',
        headers={'Content-Disposition':f'attachment; filename="{_download_tar_filename(nick,prefix)}"'})

