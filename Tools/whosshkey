set -euo pipefail

Version="1.3"
# 1.3 clef inconnue : liste, pour chaque compte concerne, des fichiers de clefs lus (nb de clefs, absent,
#     illisible), des chemins par defaut faute de sshd -T, et de l'AuthorizedKeysCommand non interroge
# 1.2 awk sans repetitions {n} (mawk, awk par defaut de Debian/Ubuntu, ne les comprend pas : tout sortait en "-"),
#     authorized_keys vide ou commentaire avec apostrophe n'arretent plus le script, cles avec options lues par
#     ssh-keygen, AuthorizedKeysFile de sshd (authorized_keys2 compris), logs sshd tournes et compresses lus,
#     annee des logs syslog corrigee au changement d'annee, -H : sudo peut demander son mot de passe et les
#     arguments gardent leurs espaces, -w verifie, -V
# 1.1 analyse distante (-H), clef inconnue affichee avec son empreinte
# 1.0 version initiale

usage() {
    cat <<EOF
Usage: whosshkey [-H host] [-w seconds] [-V] [last options...]

  -H host   Run against a remote host over ssh (needs sudo there).
  -w sec    Matching window in seconds between sshd auth log and last (default: 10).
  -V        Version.

Needs root (or sudo) to read other users' authorized_keys and system logs.
EOF
}

WINDOW=10
REMOTE_HOST=""

while [ $# -gt 0 ]; do
    case "$1" in
        -H|--host)
            [ $# -ge 2 ] || { echo "error: $1 needs a host" >&2; exit 1; }
            REMOTE_HOST="$2"; shift 2 ;;
        -w|--window)
            [ $# -ge 2 ] || { echo "error: $1 needs a number of seconds" >&2; exit 1; }
            WINDOW="$2"; shift 2 ;;
        -V|--version)
            echo "Version $Version"; exit 0 ;;
        -h|--help)
            usage; exit 0 ;;
        --)
            shift; break ;;
        *)
            break ;;
    esac
done

case "$WINDOW" in
    ''|*[!0-9]*) echo "error: -w expects a number of seconds, got '$WINDOW'" >&2; exit 1 ;;
esac

if [ -n "$REMOTE_HOST" ]; then
    # The script travels inside the command line (base64), not on stdin: stdin stays the
    # terminal, so sudo can ask for its password. Arguments are quoted for the remote shell.
    script_b64=$(base64 -w0 < "$0")
    remote_args=$(printf ' %q' -w "$WINDOW" "$@")
    exec ssh -t "$REMOTE_HOST" "sudo bash -c \"\$(echo $script_b64 | base64 -d)\" whosshkey$remote_args"
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "warning: not root, other users' authorized_keys/logs may be unreadable" >&2
fi

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

AUTH_EVENTS="$WORKDIR/auth_events"   # epoch<TAB>user<TAB>ip<TAB>fingerprint
KEYMAP="$WORKDIR/keymap"             # fingerprint<TAB>comment
LAST_OUT="$WORKDIR/last_out"         # raw last lines, in original order
AK_FILES="$WORKDIR/ak_files"         # user<TAB>path<TAB>status (N key(s) / absent / unreadable)
UNKNOWN_USERS="$WORKDIR/unknown"     # users with at least one unknown key, one per line

# ---- 1. collect "Accepted publickey" events, from auth.log or journalctl ----
extract_accepted() {
    # reads raw sshd log lines on stdin, each optionally iso-timestamped or syslog-timestamped
    # No {n} repetitions in the regexps: mawk 1.3.4 20200120 (default awk on Debian/Ubuntu) ignores them
    awk -v now="$(date +%s)" '
        /Accepted publickey for/ {
            line=$0
            if (match(line, /Accepted publickey for [^ ]+ from [^ ]+ port [0-9]+/)) {
                seg = substr(line, RSTART, RLENGTH)
                split(seg, a, " ")
                user = a[4]; ip = a[6]
            } else { next }
            fp = ""
            if (match(line, /(SHA256:[^ ]+|MD5:[^ ]+)/)) {
                fp = substr(line, RSTART, RLENGTH)
            }
            # timestamp: either leading ISO8601 (journalctl -o short-iso, rsyslog RFC3339) or syslog "Mon DD HH:MM:SS"
            epoch = ""
            if (match($0, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/)) {
                ts = substr($0, RSTART, RLENGTH)
                cmd = "date -d \"" ts "\" +%s"
                cmd | getline epoch
                close(cmd)
            } else {
                # No year in syslog timestamps: date takes the current one, so a date
                # ahead of now (December log read in January) belongs to last year
                ts = $1" "$2" "$3
                cmd = "date -d \"" ts "\" +%s"
                cmd | getline epoch
                close(cmd)
                if (epoch != "" && epoch > now + 86400) {
                    cmd = "date -d \"" ts " 1 year ago\" +%s"
                    cmd | getline epoch
                    close(cmd)
                }
            }
            if (epoch == "") next
            print epoch "\t" user "\t" ip "\t" fp
        }
    '
}

if [ -r /var/log/auth.log ]; then
    # current log plus rotated ones (auth.log.1, auth.log.2.gz, auth.log-YYYYMMDD[.gz]) : last covers weeks
    for logfile in /var/log/auth.log*; do
        [ -r "$logfile" ] && zcat -f "$logfile" 2>/dev/null
    done | extract_accepted > "$AUTH_EVENTS" || true
elif command -v journalctl >/dev/null 2>&1; then
    journalctl -u ssh -u sshd --no-pager -o short-iso 2>/dev/null | extract_accepted > "$AUTH_EVENTS" || true
else
    : > "$AUTH_EVENTS"
fi

# ---- 2. build fingerprint -> comment map from every reachable authorized_keys ----
# Paths from sshd's AuthorizedKeysFile (%h home, %u user, %% %, relative = in home),
# default .ssh/authorized_keys .ssh/authorized_keys2 when sshd -T is not available
SSHD_CONFIG=$(sshd -T 2>/dev/null || true)
AK_PATTERNS=$(awk '$1 == "authorizedkeysfile" { $1 = ""; print }' <<<"$SSHD_CONFIG")
AK_DEFAULT=0
[ -n "$AK_PATTERNS" ] || { AK_PATTERNS=".ssh/authorized_keys .ssh/authorized_keys2"; AK_DEFAULT=1; }
# Keys given by a command (LDAP, FreeIPA...) are not in any file: only reported for unknown keys
AK_COMMAND=$(awk '$1 == "authorizedkeyscommand" && $2 != "none" { $1 = ""; sub(/^ /, ""); print }' <<<"$SSHD_CONFIG")

: > "$KEYMAP"
: > "$AK_FILES"
{
    echo "root:/root"
    getent passwd | awk -F: '$6 != "" { print $1 ":" $6 }'
} | while IFS=: read -r akuser akhome; do
    for pattern in $AK_PATTERNS; do
        akfile="${pattern//%%/%}"
        akfile="${akfile//%h/$akhome}"
        akfile="${akfile//%u/$akuser}"
        [ "${akfile:0:1}" = "/" ] || akfile="$akhome/$akfile"
        printf '%s\t%s\n' "$akuser" "$akfile"
    done
done | sort -u | while IFS=$'\t' read -r akuser akfile; do
    # What was read for whom, shown for unknown keys
    if [ ! -e "$akfile" ]; then
        # Not visible: really missing, or inside a directory we may not enter (another home as non-root)
        # (stat error kept in a variable: with pipefail, "stat | grep" would take stat's failure)
        stat_err=$(LC_ALL=C stat "$akfile" 2>&1 || true)
        case "$stat_err" in
            *"Permission denied"*) status="inaccessible (droits)" ;;
            *) status="absent" ;;
        esac
        printf '%s\t%s\t%s\n' "$akuser" "$akfile" "$status" >> "$AK_FILES"; continue
    elif [ ! -r "$akfile" ]; then
        printf '%s\t%s\t%s\n' "$akuser" "$akfile" "illisible" >> "$AK_FILES"; continue
    fi
    nkeys=0
    # One ssh-keygen per line: on a whole file, ssh-keygen gives a key without comment the previous key's comment.
    # Leading options (from=, command=...) are understood by ssh-keygen itself.
    while read -r keyline || [ -n "$keyline" ]; do
        case "$keyline" in ''|'#'*) continue ;; esac
        out=$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null) || continue
        # "<bits> <fingerprint> <comment...> (<type>)"
        fp=$(printf '%s\n' "$out" | awk '{ print $2 }')
        comment=$(printf '%s\n' "$out" | sed -E 's/^[^ ]+ [^ ]+ ?(.*) \([^)]*\)$/\1/')
        [ -n "$comment" ] || comment="no-comment"
        printf '%s\t%s\n' "$fp" "$comment" >> "$KEYMAP"
        nkeys=$((nkeys + 1))
    done < "$akfile"
    printf '%s\t%s\t%s\n' "$akuser" "$akfile" "$nkeys clef(s)" >> "$AK_FILES"
done

# ---- 3. get last output (keep original order/format) ----
last -Fiw "$@" > "$LAST_OUT"

# ---- 4. correlate and print ----
awk -v window="$WINDOW" -v keymapfile="$KEYMAP" -v authfile="$AUTH_EVENTS" -v unknownfile="$UNKNOWN_USERS" '
    BEGIN {
        FS="\t"
        while ((getline line < keymapfile) > 0) {
            split(line, kv, "\t")
            keymap[kv[1]] = kv[2]
        }
        close(keymapfile)
        n = 0
        while ((getline line < authfile) > 0) {
            split(line, ev, "\t")
            n++
            aepoch[n] = ev[1]; auser[n] = ev[2]; aip[n] = ev[3]; afp[n] = ev[4]
            used[n] = 0
        }
        close(authfile)
    }
    {
        raw = $0
        if (raw ~ /^(wtmp begins|btmp begins)/ || raw ~ /^[ \t]*$/) { print raw; next }
        if (raw ~ /^(reboot|shutdown)/) { print raw "\t-"; next }

        # parse: user, ip (numeric, from -i), then the login time as printed by -F: "Wed Sep 23 10:03:12 2026"
        n_fields = split(raw, f, /[ \t]+/)
        user = f[1]
        ip = ""
        for (i = 2; i <= n_fields; i++) {
            if (f[i] ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || f[i] ~ /:/ && f[i] ~ /^[0-9a-fA-F:]+$/) { ip = f[i]; break }
        }
        # find login timestamp: "Day Mon DD HH:MM:SS YYYY"
        tsfield = -1
        for (i = 2; i <= n_fields-4; i++) {
            if (f[i+3] ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/ && f[i+4] ~ /^[0-9][0-9][0-9][0-9]$/) { tsfield = i; break }
        }
        keystr = "-"
        if (ip != "" && tsfield > 0) {
            tsstr = f[tsfield]" "f[tsfield+1]" "f[tsfield+2]" "f[tsfield+3]" "f[tsfield+4]
            epoch = ""
            cmd = "date -d \"" tsstr "\" +%s"
            cmd | getline epoch
            close(cmd)
            best = -1; bestdiff = window + 1
            for (i = 1; epoch != "" && i <= n; i++) {
                if (used[i]) continue
                if (auser[i] != user) continue
                if (aip[i] != ip) continue
                diff = aepoch[i] - epoch
                if (diff < 0) diff = -diff
                if (diff <= window && diff < bestdiff) { bestdiff = diff; best = i }
            }
            if (best > 0) {
                used[best] = 1
                fp = afp[best]
                if (fp != "" && (fp in keymap)) keystr = keymap[fp]
                else if (fp != "") keystr = "clef inconnue (" fp ")"
                else keystr = "clef inconnue (no-fp)"
                if (!(fp in keymap) && !(user in unknown)) { unknown[user] = 1; print user > unknownfile }
            }
        }
        print raw "\t" keystr
    }
' "$LAST_OUT" | column -t -s $'\t'

# ---- 5. for unknown keys: which key files were read for these accounts ----
if [ -s "$UNKNOWN_USERS" ]; then
    echo
    echo "Clefs inconnues : aucune clef des fichiers lus n'a cette empreinte (ssh-keygen -lf <fichier> les liste)."
    while read -r user; do
        echo "  $user :"
        awk -F'\t' -v u="$user" '$1 == u { print "    " $2 " : " $3 }' "$AK_FILES"
        grep -q "^$user"$'\t' "$AK_FILES" 2>/dev/null || echo "    (compte sans répertoire personnel connu)"
    done < "$UNKNOWN_USERS"
    if [ "$AK_DEFAULT" -eq 1 ]; then
        echo "  sshd -T indisponible (pas root ?) : chemins par défaut ; un AuthorizedKeysFile ou AuthorizedKeysCommand de sshd_config n'a pas pu être lu."
    fi
    if [ -n "$AK_COMMAND" ]; then
        echo "  sshd prend aussi des clefs de AuthorizedKeysCommand ($AK_COMMAND), non interrogé."
    fi
fi
