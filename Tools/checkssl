Version="1.4"
# 1.4 version TLS negociee affichee, avertissement si inferieure a TLS 1.2 (code retour inchange)
# 1.3 serveurs en TLS 1.0 / 1.1 lus (OpenSSL 3 refusait la connexion : "unsupported protocol")
# 1.2 smtp:// (STARTTLS, port 25 par defaut, 587 pour la soumission) et smtps:// (TLS direct, port 465)
# 1.1 plus d'eval (l'URL pouvait injecter des commandes), SNI envoye aussi en imap/pop3/imaps/pop3s,
#     CN lu aussi avec OpenSSL >= 1.1 en file://, fichier illisible ou non PEM = erreur (et non "0 jour"),
#     URL sans protocole = message clair, delai de 30 s sur la connexion, -t verifie, -V,
#     SAN affiches aussi en file://, erreurs sur stderr, code en double retire
# 1.0 version initiale

# Initialisation des variables
url=""
ip=""
threshold=15
# Delai maximal pour recuperer le certificat d'un serveur
connect_timeout=30

# Fonction d'affichage d'aide
usage() {
    echo "Usage: $0 -u <url> [-i <ip>] [-h] [-d] [-t <threshold>] [-V]"
    echo "  -u: URL du serveur ou fichier (https, imap, imaps, pop3, pop3s, smtp, smtps, file)"
    echo "  -i: IP pour forcer la résolution DNS (non applicable pour file://)"
    echo "  -t: DAYS restant avant exitcode a 2 (defaut: 15)"
    echo "  -d mode debug"
    echo "  -V version"
    exit 1
}

# Message d'erreur sur stderr, puis sortie en code 1
die() {
    echo "Erreur : $*" >&2
    exit 1
}

# Fonction pour calculer les jours restants (negatif si deja expire)
days_remaining() {
    local end_date="$1"
    local end_epoch=$(date -d "$end_date" +%s)
    local now_epoch=$(date +%s)
    echo $(( ($end_epoch - $now_epoch) / 86400 ))
}

# Affiche CN, SAN, fin de validite et jours restants du certificat PEM lu sur
# stdin, puis sort : 2 si l'expiration est a threshold jours ou moins, 0 sinon,
# 1 (avec le message $1) si aucun certificat n'est lisible.
# $2 : version TLS negociee (vide pour file://), affichee avec un avertissement si < TLS 1.2
report_cert() {
    local pem cn dns end_date days_left
    pem=$(cat)
    end_date=$(openssl x509 -noout -enddate <<<"$pem" 2>/dev/null | cut -d= -f2)
    # Sans date de fin, date -d "" donnerait minuit aujourd'hui : "0 jour" trompeur
    [[ -n "$end_date" ]] || die "$1"

    # RFC2253 : "CN=x,O=y" quelle que soit la version d'OpenSSL
    cn=$(openssl x509 -noout -subject -nameopt RFC2253 <<<"$pem" | sed 's/^subject=//' | tr ',' '\n' | sed -n 's/^CN=//p' | head -1)
    dns=$(openssl x509 -noout -text <<<"$pem" | grep "DNS:" | sed 's/DNS://g' | tr -s "\t " " " | sed 's/^ //')
    days_left=$(days_remaining "$end_date")

    # Affichage des informations
    echo "CN du certificat : $cn"
    echo "X509v3 Subject Alternative Name: $dns"
    echo "Date de fin de validité : $end_date"
    echo "Jours restants : $days_left"
    if [[ -n "$2" ]]; then
        echo "Version TLS : $2"
        # Avertissement seulement : le code retour ne parle que de l'expiration du certificat
        case "$2" in
            SSLv*|TLSv1|TLSv1.1) echo "ATTENTION : $2 est obsolète (inférieur à TLS 1.2)" ;;
        esac
    fi

    # Sortie avec code 2 si threshold jours ou moins (un certificat expire est toujours en 2)
    if [[ $days_left -le $threshold ]]; then
        exit 2
    fi
    exit 0
}

# Lecture des arguments
while getopts "u:i:hdt:V" opt; do
    case $opt in
        u) url="$OPTARG" ;;
        i) ip="$OPTARG" ;;
        d) set -x;;
        t) threshold="$OPTARG" ;;
        V) echo "Version $Version"; exit 0 ;;
        h) usage ;;
        *) usage ;;
    esac
done

# Vérification des arguments
if [[ -z "$url" ]]; then
    echo "Erreur : L'URL est requise." >&2
    usage
fi
# Entier positif : sinon [[ -le ]] lit "abc" comme 0, et un seuil negatif laisserait passer un certificat expire
[[ "$threshold" =~ ^[0-9]+$ ]] || die "-t attend un nombre de jours (entier positif), pas « $threshold »."
[[ "$url" == *://* ]] || die "protocole manquant dans l'URL « $url » (https://, imap://, imaps://, pop3://, pop3s://, smtp://, smtps://, file://)."

# Extraction du protocole (jusqu'au premier ://) et du reste
protocol="${url%%://*}://"
protocol="${protocol,,}"
url_no_proto="${url#*://}"

# Gestion spécifique des fichiers locaux (file://)
if [[ "$protocol" == "file://" ]]; then
    crt_file="$url_no_proto"

    # Vérification que le fichier existe
    [[ -f "$crt_file" ]] || die "Le fichier $crt_file n'existe pas."
    [[ -r "$crt_file" ]] || die "Le fichier $crt_file n'est pas lisible."

    report_cert "Le fichier $crt_file ne contient pas de certificat PEM lisible." < "$crt_file"
fi

# Extraction de l'hôte et du port si l'URL n'est pas file://
host="${url_no_proto%%/*}"
port=""
if [[ "$host" == *:* ]]; then
    port="${host##*:}"
    host="${host%%:*}"
fi

# Définir le port par défaut selon le protocole, et STARTTLS le cas echeant
starttls=()
case $protocol in
    https://)  port=${port:-443} ;;
    imap://)   port=${port:-143}; starttls=(-starttls imap) ;;
    imaps://)  port=${port:-993} ;;
    pop3://)   port=${port:-110}; starttls=(-starttls pop3) ;;
    pop3s://)  port=${port:-995} ;;
    # smtp:// : STARTTLS, port 25 (MX) par defaut, smtp://hote:587 pour la soumission
    smtp://)   port=${port:-25}; starttls=(-starttls smtp) ;;
    smtps://)  port=${port:-465} ;;
    *) die "Protocole non supporté : $protocol" ;;
esac

# Utiliser l'IP forcée si fournie (IPv6 entre crochets pour -connect)
host_ip="${ip:-$host}"
[[ "$host_ip" == *:* ]] && host_ip="[$host_ip]"

# Récupérer le certificat : tableau d'arguments, pas d'eval (l'URL ne doit jamais etre executee).
# SNI envoye pour tous les protocoles : sinon un serveur a plusieurs certificats renvoie celui par defaut
# SECLEVEL=0 et TLSv1 minimum : on veut lire le certificat, pas juger la connexion ; sans eux OpenSSL 3 refuse
# les serveurs restes en TLS 1.0 / 1.1 ("unsupported protocol"). Un serveur recent negocie toujours TLS 1.2 / 1.3
server_out=$(echo | timeout "$connect_timeout" openssl s_client -connect "$host_ip:$port" -servername "$host" "${starttls[@]}" \
        -cipher 'DEFAULT:@SECLEVEL=0' -min_protocol TLSv1 2>/dev/null)

# Version TLS negociee : "Protocol  : TLSv1.2" jusqu'a TLS 1.2 ; en TLS 1.3 seule la ligne
# "New, TLSv1.3, Cipher is ..." la donne (en TLS 1.0 cette ligne dit "SSLv3", d'ou cet ordre)
tls_version=$(sed -n 's/^ *Protocol *: *//p' <<<"$server_out" | head -1)
[[ -n "$tls_version" ]] || tls_version=$(sed -n 's/^New, \(TLSv[0-9.]*\),.*/\1/p' <<<"$server_out" | head -1)

sed -n '/-BEGIN CERTIFICATE-/,/-END CERTIFICATE-/p' <<<"$server_out" \
    | report_cert "Impossible de récupérer le certificat." "$tls_version"
