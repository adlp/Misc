def actionServers(servers, defaults, args):
    """Liste les serveurs de la configuration, ceux par défaut marqués d'une '*'."""
    rows=[["*" if name in defaults else "",name,server.transport(),server.description] for name,server in servers.items()]
    printTable(["","Serveur","Connexion","Description"],rows)
    return(0)


def collectClients(mgmts, pattern, sort, reverse):
    """Connexions de tous les serveurs, filtrées et triées ; renvoie (connexions, {serveur: heure}, {serveur: CN connectés}, échecs).

    Les CN connectés sont relevés avant le filtre : un connecté écarté par le
    filtre ne doit pas apparaître parmi les non connectés.

    Chaque connexion porte son serveur et sa durée, calculée sur l'heure
    donnée par ce serveur (pas d'écart d'horloge avec la machine locale).
    """
    statuses,failed=gather(mgmts,lambda mgmt: mgmt.status())
    clients=[]
    times={}
    connected={}
    for name,status in statuses.items():
        now=status['time'] or time.time()
        times[name]=now
        connected[name]={c['cn'] for c in status['clients']}
        for c in status['clients']:
            c['server']=name
            c['duration']=now-c['since'] if c['since'] else None
            clients.append(c)
    return(sortClients(filterClients(clients,pattern),sort,reverse),times,connected,failed)


def gatherKnown(mgmts):
    """knownUsers de chaque serveur en parallèle ; erreurs et notes (fichier non lu...) sur stderr.

    Renvoie ({serveur: utilisateurs connus}, nombre d'échecs).
    """
    known,failed=gather(mgmts,lambda mgmt: knownUsers(mgmt.server))
    for name,data in known.items():
        for note in data['notes']:
            say(f"ovpnMgmt: [{name}] note : {note}",file=sys.stderr)
    return(known,failed)


def printOffline(offline, known, multi):
    """Section des non connectés, sous le tableau des connexions."""
    ignored=sum(data['ignored'] for data in known.values())
    print()
    if offline:
        print("Non connectés :")
        headers,rows=offlineRows(offline,multi)
        printTable(headers,rows)
        print(f"\n{len(offline)} non connecté(s)"+(f" ; {ignored} révoqué(s) ou expiré(s) non affiché(s)" if ignored else ""))
    else:
        print("Aucun utilisateur connu non connecté."+(f" ({ignored} révoqué(s) ou expiré(s) non affiché(s))" if ignored else ""))


def actionList(mgmts, args):
    """Connexions actives de tous les serveurs : tableau, --json, ou rafraîchi toutes les --watch secondes avec le débit.

    --offline ajoute les utilisateurs connus non connectés (lus une fois, au
    lancement, dans les fichiers d'OpenVPN).
    """
    multi=len(mgmts) > 1
    known,knownFailed={},0
    if args.offline:
        known,knownFailed=gatherKnown(mgmts)
    if args.watch is None:
        clients,times,connected,failed=collectClients(mgmts,args.filter,args.sort,args.reverse)
        failed+=knownFailed
        offline=offlineUsers(known,connected,args.filter)
        if args.json:
            data=[clientJson(c) for c in clients]
            if args.offline:
                for u in offline:
                    u['cert_expires_iso']=time.strftime("%Y-%m-%dT%H:%M:%S%z",time.localtime(u['cert_expires'])) if u['cert_expires'] else None
                data={'connected':data,'offline':offline}
            print(json.dumps(data,indent=2,ensure_ascii=False))
            return(1 if failed else 0)
        if not clients:
            print("Aucune connexion active." if not args.filter else f"Aucune connexion ne correspond à « {args.filter} ».")
        else:
            headers,rows=clientRows(clients,args.long,multi)
            printTable(headers,rows)
            if multi:
                counts=', '.join(f"{name} {sum(1 for c in clients if c['server'] == name)}" for name in times)
                print(f"\n{len(clients)} connexion(s) ({counts}) ; reçu / envoyé : vus de chaque serveur")
            else:
                print(f"\n{len(clients)} connexion(s) ; reçu / envoyé : vus du serveur")
        if args.offline:
            printOffline(offline,known,multi)
        return(1 if failed else 0)

    # Mode --watch : connexions gardées ouvertes, débit calculé entre deux status de chaque serveur
    previous={}
    previousTimes={}
    while True:
        clients,times,connected,failed=collectClients(mgmts,args.filter,args.sort,args.reverse)
        rates={}
        for c in clients:
            before=previous.get(serverClientKey(c))
            elapsed=times[c['server']]-previousTimes.get(c['server'],times[c['server']])
            if before and elapsed > 0:
                rates[serverClientKey(c)]=(max(0,c['rx']-before[0])/elapsed,max(0,c['tx']-before[1])/elapsed)
        with printLock:
            sys.stdout.write("\033[H\033[2J")
            print(f"{', '.join(mgmts)} — {humanDate(time.time())} — {len(clients)} connexion(s) — "
                  f"rafraîchi toutes les {args.watch:g} s (Ctrl-C pour quitter)\n")
            if clients:
                headers,rows=clientRows(clients,args.long,multi,rates)
                printTable(headers,rows)
            else:
                print("Aucune connexion active.")
            if args.offline:
                printOffline(offlineUsers(known,connected,args.filter),known,multi)
            sys.stdout.flush()
        previous={serverClientKey(c):(c['rx'],c['tx']) for c in clients}
        previousTimes=times
        time.sleep(args.watch)


def infoOf(mgmt):
    """Version, management, PID, verb, mute, hold, clients, octets cumulés et état d'un serveur."""
    info={}
    version=mgmt.check("version")
    info['version']=next((l.split(':',1)[1].strip() for l in version if l.startswith("OpenVPN Version")),' '.join(version))
    info['management']=next((l.split(':',1)[1].strip() for l in version if l.startswith("Management Version")),'')
    for cmd in ("pid","verb","mute","hold"):
        ok,lines=mgmt.command(cmd)
        info[cmd]=lines[0].split('=',1)[-1] if ok and lines else ''
    ok,lines=mgmt.command("load-stats")
    if ok and lines:
        stats=dict(item.split('=',1) for item in lines[0].split(',') if '=' in item)
        info['clients']=stats.get('nclients','')
        info['octets reçus']=stats.get('bytesin','')
        info['octets envoyés']=stats.get('bytesout','')
    ok,lines=mgmt.command("state")
    if ok and lines:
        # "epoch,ETAT,detail,ip locale,ip distante,..." : dernier état connu
        fields=lines[-1].split(',')
        info['état']=f"{fields[1]} depuis {humanDate(toInt(fields[0]))}" if len(fields) > 1 else lines[-1]
    return(info)


def actionInfo(mgmts, args):
    """Informations de chaque serveur : liste clef : valeur pour un serveur, une colonne par serveur sinon."""
    infos,failed=gather(mgmts,infoOf)
    if args.json:
        if len(mgmts) == 1:
            for name,info in infos.items():
                print(json.dumps({'serveur':name,**info},indent=2,ensure_ascii=False))
        else:
            print(json.dumps(infos,indent=2,ensure_ascii=False))
        return(1 if failed else 0)
    for info in infos.values():
        for key in ('octets reçus','octets envoyés'):
            if toInt(info.get(key)) is not None:
                info[key]=f"{humanBytes(int(info[key]))} ({info[key]})"
    if len(mgmts) == 1:
        for name,info in infos.items():
            info={'serveur':name,**info}
            width=max(len(k) for k in info)
            for key,value in info.items():
                print(f"{key.ljust(width)} : {value}")
    elif infos:
        keys=list(dict.fromkeys(k for info in infos.values() for k in info))
        printTable(["",*infos],[[key,*(info.get(key,'') for info in infos.values())] for key in keys])
    return(1 if failed else 0)


# Délai maximal d'attente de la fermeture effective d'une connexion coupée, en secondes
KILL_WAIT=15

def actionKill(mgmts, args):
    """Coupe des connexions désignées par nom, adresse réelle (IP ou IP:port), IP VPN ou --cid, sur tous les serveurs.

    Chaque connexion trouvée reçoit "client-kill CID RESTART|HALT" :
    RESTART (défaut, comme "kill" d'OpenVPN) laisse le client se reconnecter,
    HALT (--halt) lui demande de s'arrêter. Plus d'une connexion visée :
    confirmation, sauf --yes. Les serveurs sont traités en parallèle.
    """
    if not args.targets and not args.cid:
        raise ManagementError("kill : indiquer un nom, une adresse, une IP VPN ou --cid")
    multi=len(mgmts) > 1
    statuses,failed=gather(mgmts,lambda mgmt: mgmt.status()['clients'])
    everyone=[]
    for name,clients in statuses.items():
        for c in clients:
            c['server']=name
            everyone.append(c)
    selected=[]
    for target in args.targets:
        found=[c for c in everyone if target in (c['cn'],c['real'],realIp(c['real']),c['virtual'],c['virtual6'])]
        if not found:
            print(f"Aucune connexion ne correspond à « {target} ».",file=sys.stderr)
        selected+=found
    for cid in args.cid or []:
        # Avec plusieurs serveurs, un CID peut exister sur chacun : tous sont visés (et la confirmation les montre)
        found=[c for c in everyone if c['cid'] == cid]
        if not found:
            print(f"Aucune connexion de CID {cid}.",file=sys.stderr)
        selected+=found
    # Une connexion visée deux fois (nom et adresse) n'est coupée qu'une fois
    selected=list({serverClientKey(c):c for c in selected}.values())
    if not selected:
        return(1)
    message="HALT" if args.halt else "RESTART"
    describe=lambda c: (f"{c['server']} : " if multi else "")+f"{c['cn']} ({c['real']}, IP VPN {c['virtual'] or '-'}, CID {c['cid']})"
    if len(selected) > 1 and not args.yes:
        print(f"{len(selected)} connexions vont être coupées ({message}) :")
        for c in selected:
            print(f"  {describe(c)}")
        if not confirm("Confirmer ?"):
            print("Abandon, rien n'a été coupé.")
            return(1)

    def killOn(mgmt):
        """Coupe les connexions choisies sur un serveur ; renvoie (fermées, échecs)."""
        pending=[]
        errors=0
        for c in [c for c in selected if c['server'] == mgmt.server.name]:
            if c['cid'] is not None:
                ok,lines=mgmt.command(f"client-kill {c['cid']} {message}")
            else:
                # OpenVPN trop ancien pour donner le CID : "kill IP:port" (toujours RESTART)
                ok,lines=mgmt.command(f"kill {c['real']}")
            if ok:
                pending.append(c)
            else:
                errors+=1
                say(f"Échec pour {describe(c)} : {' '.join(lines)}",file=sys.stderr)
        # OpenVPN ferme l'instance quelques secondes après la commande (sortie différée) :
        # "Coupée" n'est annoncé qu'une fois la connexion sortie de la liste
        deadline=time.monotonic()+KILL_WAIT
        closed=0
        while pending:
            present={clientKey(c) for c in mgmt.status()['clients']}
            for c in [c for c in pending if clientKey(c) not in present]:
                say(f"Coupée ({message}) : {describe(c)}")
                pending.remove(c)
                closed+=1
            if not pending or time.monotonic() > deadline:
                break
            time.sleep(0.5)
        for c in pending:
            errors+=1
            say(f"Commande acceptée, mais toujours listée après {KILL_WAIT} s : {describe(c)}",file=sys.stderr)
        return(closed,errors)

    targets={name:mgmt for name,mgmt in mgmts.items() if any(c['server'] == name for c in selected)}
    results,serverErrors=gather(targets,killOn)
    closed=sum(r[0] for r in results.values())
    errors=sum(r[1] for r in results.values())+serverErrors
    if message == "RESTART" and closed:
        print("RESTART : le client va se reconnecter (sous un nouveau CID) ; --halt pour l'arrêter.")
    return(1 if errors or failed else 0)


LOG_FLAGS={'I':'info','F':'FATAL','N':'erreur','W':'avert.','D':'debug'}

def formatLogLine(line):
    """Ligne de log "epoch,drapeaux,message" → "date [niveau] message"."""
    if line.startswith(">LOG:"):
        line=line[len(">LOG:"):]
    parts=line.split(',',2)
    if len(parts) < 3 or toInt(parts[0]) is None:
        return(line)
    level=' '.join(LOG_FLAGS.get(flag,flag) for flag in parts[1]) or '-'
    return(f"{humanDate(int(parts[0]))} [{level}] {parts[2]}")


def logEpoch(line):
    """Epoch en tête d'une ligne de log, 0 s'il manque (pour fusionner les logs par date)."""
    return(toInt(line[len(">LOG:"):].split(',',1)[0] if line.startswith(">LOG:") else line.split(',',1)[0]) or 0)


def actionLog(mgmts, args):
    """Dernières lignes du log de chaque serveur, fusionnées par date ; --follow les suit en temps réel (Ctrl-C pour quitter)."""
    multi=len(mgmts) > 1
    # "log 0" : pas d'historique (OpenVPN refuse 0, on ne l'envoie pas), utile avec --follow
    if args.lines == '0':
        logs,failed={name:[] for name in mgmts},0
    else:
        logs,failed=gather(mgmts,lambda mgmt: mgmt.check(f"log {args.lines}"))
    merged=sorted(((logEpoch(line),name,line) for name,lines in logs.items() for line in lines),key=lambda item: item[0])
    for _,name,line in merged:
        print(prefixFor(name,multi)+formatLogLine(line))
    if not args.follow:
        return(1 if failed else 0)
    sys.stdout.flush()
    followed={name:mgmt for name,mgmt in mgmts.items() if name in logs}

    def follow(name):
        """Suit le log d'un serveur jusqu'à la fin du programme (thread démon)."""
        mgmt=followed[name]
        try:
            mgmt.check("log on")
            while True:
                line=mgmt.readNotification(3600)
                if line is not None and line.startswith(">LOG:"):
                    say(prefixFor(name,multi)+formatLogLine(line))
        except ManagementError as err:
            # Ce serveur décroche : signalé tout de suite, les autres continuent
            say(f"ovpnMgmt: {err}",file=sys.stderr)

    try:
        runParallel(list(followed),follow)
    finally:
        for mgmt in followed.values():
            try:
                mgmt._send("log off")
            except ManagementError:
                pass
    # On n'arrive ici que si toutes les connexions suivies sont tombées
    return(1)


def actionSimple(mgmts, cmd):
    """Commande à réponse d'une ligne sur chaque serveur ; affiche "[serveur] réponse" s'il y en a plusieurs."""
    results,failed=gather(mgmts,lambda mgmt: mgmt.check(cmd))
    for name,lines in results.items():
        print(prefixFor(name,len(mgmts) > 1)+(lines[0] if lines else "ok"))
    return(1 if failed else 0)


def actionLevel(mgmts, args):
    """verb ou mute : affiche le niveau, ou le change si un niveau est donné."""
    return(actionSimple(mgmts,args.action if args.level is None else f"{args.action} {args.level}"))


def actionHold(mgmts, args):
    """hold : affiche l'état ; hold on|off|release le change (release démarre un serveur en attente)."""
    return(actionSimple(mgmts,"hold" if args.state is None else f"hold {args.state}"))


def actionSignal(mgmts, args):
    """Envoie un signal au démon de chaque serveur (SIGHUP recharge, SIGTERM arrête, SIGUSR1 redémarre, SIGUSR2 écrit son état dans le log).

    Touche toutes les connexions : confirmation, sauf --yes.
    """
    effects={'SIGHUP':"redémarre le serveur et relit sa configuration : toutes les connexions sont coupées",
             'SIGTERM':"ARRÊTE le serveur : toutes les connexions sont coupées et il ne redémarre pas seul",
             'SIGUSR1':"redémarre le serveur sans relire sa configuration : les connexions se rétablissent",
             'SIGUSR2':"écrit les statistiques dans le log du serveur, sans effet sur les connexions"}
    print(f"{args.signal} sur {', '.join(mgmts)} : {effects[args.signal]}.")
    if args.signal != 'SIGUSR2' and not args.yes and not confirm("Confirmer ?"):
        print("Abandon, aucun signal envoyé.")
        return(1)
    return(actionSimple(mgmts,f"signal {args.signal}"))


def actionRaw(mgmts, args):
    """Envoie des commandes brutes à chaque serveur et affiche les réponses (ERROR → code retour 1).

    Plusieurs serveurs : une section "=== serveur ===" par serveur, dans l'ordre demandé.
    """
    def rawOn(mgmt):
        """Toutes les commandes sur un serveur ; renvoie (lignes à afficher, au moins une ERROR)."""
        out=[]
        error=False
        for cmd in args.commands:
            ok,lines=mgmt.command(cmd)
            out+=mgmt.notifications
            mgmt.notifications.clear()
            if len(args.commands) > 1:
                out.append(f"== {cmd}")
            out+=lines if ok else [f"ERROR: {' '.join(lines)}"]
            error=error or not ok
        return(out,error)

    results,failed=gather(mgmts,rawOn)
    for name,(lines,_) in results.items():
        if len(mgmts) > 1:
            print(f"=== {name} ===")
        print('\n'.join(lines))
    return(1 if failed or any(error for _,error in results.values()) else 0)


def actionShell(mgmts, args):
    """Session interactive avec un seul serveur : chaque ligne tapée est envoyée telle quelle."""
    try:
        import readline  # noqa: F401  (historique et édition de ligne)
    except ImportError:
        pass
    mgmt=next(iter(mgmts.values()))
    print(f"Connecté à {mgmt.server.name} ({mgmt.server.transport()}). « help » : commandes du serveur ; « quit » ou Ctrl-D : sortie.")
    mgmt.onNotification=lambda line: print(line)
    while True:
        try:
            cmd=input(f"{mgmt.server.name}> ").strip()
        except EOFError:
            print()
            return(0)
        if not cmd:
            # Ligne vide : affiche les notifications arrivées entre-temps
            while (line := mgmt.readNotification(0.2)) is not None:
                print(line)
            continue
        if cmd in ("quit","exit"):
            return(0)
        ok,lines=mgmt.command(cmd)
        print('\n'.join(lines) if ok else f"ERROR: {' '.join(lines)}")


def confirm(question):
    """Question oui/non sur le terminal ; sans terminal, refus (utiliser --yes)."""
    sys.stdout.flush()
    if not sys.stdin.isatty():
        print("Pas de terminal pour confirmer : relancer avec --yes.",file=sys.stderr)
        return(False)
    try:
        answer=input(f"{question} [o/N] ").strip().lower()
    except EOFError:
        return(False)
    return(answer in ("o","oui","y","yes"))


