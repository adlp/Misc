def humanBytes(count):
    """Octets lisibles : 1023 o, 1,5 Kio, 12,3 Mio..."""
    value=float(count)
    for unit in ("o","Kio","Mio","Gio","Tio"):
        if value < 1024 or unit == "Tio":
            if unit == "o":
                return(f"{int(value)} o")
            return(f"{value:.1f} {unit}".replace('.',','))
        value/=1024


def humanDuration(seconds):
    """Durée lisible : "04:05:06", ou "3j 04:05:06" au-delà d'un jour."""
    if seconds is None:
        return("?")
    seconds=max(0,int(seconds))
    days,rest=divmod(seconds,86400)
    hours,rest=divmod(rest,3600)
    minutes,secs=divmod(rest,60)
    clock=f"{hours:02d}:{minutes:02d}:{secs:02d}"
    return(f"{days}j {clock}" if days else clock)


def humanDate(epoch):
    """Date locale d'un epoch, "?" s'il est inconnu."""
    if epoch is None:
        return("?")
    return(time.strftime("%Y-%m-%d %H:%M:%S",time.localtime(epoch)))


def printTable(headers, rows):
    """Tableau aligné ; les colonnes de nombres (titres finissant par ' ') sont alignées à droite."""
    widths=[len(h.strip()) for h in headers]
    for row in rows:
        widths=[max(w,len(str(cell))) for w,cell in zip(widths,row)]
    def fmt(cells):
        out=[]
        for header,width,cell in zip(headers,widths,cells):
            out.append(str(cell).rjust(width) if header.endswith(' ') else str(cell).ljust(width))
        return("  ".join(out).rstrip())
    print(fmt([h.strip() for h in headers]))
    for row in rows:
        print(fmt(row))


def sortClients(clients, key, reverse):
    """Tri des connexions : cn, real, virtual, since (plus ancienne d'abord), rx, tx.

    À clef égale, l'ordre des serveurs est gardé (tri stable sur une liste
    déjà rangée par serveur).
    """
    keys={
        'cn':lambda c: c['cn'].lower(),
        'real':lambda c: c['real'],
        'virtual':lambda c: tuple(int(p) for p in c['virtual'].split('.')) if re.fullmatch(r'[\d.]+',c['virtual']) else (999,c['virtual']),
        'since':lambda c: c['since'] or 0,
        'rx':lambda c: c['rx'],
        'tx':lambda c: c['tx'],
    }
    return(sorted(clients,key=keys[key],reverse=reverse))


def filterClients(clients, pattern):
    """Connexions dont le nom, l'adresse réelle, l'IP VPN ou l'utilisateur contient pattern (sans casse)."""
    if not pattern:
        return(clients)
    pattern=pattern.lower()
    return([c for c in clients if any(pattern in c[k].lower() for k in ('cn','real','virtual','virtual6','username'))])


def clientRows(clients, long, multi, rates=None):
    """Lignes du tableau des connexions (et en-têtes).

    multi : colonne Serveur en tête ; rates : colonnes de débit du mode --watch ;
    long : colonnes en plus. La durée vient de c['duration'], calculée sur
    l'heure du serveur concerné.
    """
    headers=["Serveur"] if multi else []
    headers+=["Nom","Adresse réelle","IP VPN","Connecté depuis","Durée ","Reçu ","Envoyé "]
    if rates is not None:
        headers+=["Reçu/s ","Envoyé/s "]
    headers+=["CID "]
    if long:
        headers+=["Utilisateur","IPv6 VPN","Chiffrement","Peer ID "]
    rows=[]
    for c in clients:
        row=[c['server']] if multi else []
        row+=[c['cn'],c['real'],c['virtual'],humanDate(c['since']),humanDuration(c['duration']),
              humanBytes(c['rx']),humanBytes(c['tx'])]
        if rates is not None:
            rate=rates.get(serverClientKey(c))
            row+=[humanBytes(rate[0]) if rate else "-",humanBytes(rate[1]) if rate else "-"]
        row+=["" if c['cid'] is None else c['cid']]
        if long:
            row+=[c['username'],c['virtual6'],c['cipher'],"" if c['peer_id'] is None else c['peer_id']]
        rows.append(row)
    return(headers,rows)


def clientKey(client):
    """Identifiant stable d'une connexion entre deux status (CID, sinon nom + adresse)."""
    return(client['cid'] if client['cid'] is not None else (client['cn'],client['real']))


def serverClientKey(client):
    """clientKey précédé du serveur : deux serveurs peuvent avoir le même CID."""
    return((client['server'],clientKey(client)))


def clientJson(client):
    """Connexion pour --json : champs bruts, serveur, durée en secondes et date ISO."""
    data=dict(client)
    data['since_iso']=time.strftime("%Y-%m-%dT%H:%M:%S%z",time.localtime(client['since'])) if client['since'] else None
    return(data)


################################################################################
# Plusieurs serveurs en parallèle
################################################################################

# Les threads de travail écrivent aussi (kill, log -f) : une ligne à la fois
printLock=threading.Lock()

def say(*args, **kwargs):
    """print protégé par printLock : les lignes de deux serveurs ne se mélangent pas."""
    with printLock:
        print(*args,**kwargs,flush=True)


def runParallel(names, func):
    """func(nom) pour chaque nom, un thread par nom ; renvoie {nom: (résultat, exception)} dans l'ordre des noms.

    Threads démons attendus par des join courts : Ctrl-C interrompt toujours le
    thread principal, même si un serveur ne répond pas.
    """
    results={}
    def worker(name):
        try:
            results[name]=(func(name),None)
        except Exception as err:   # rendue à l'appelant, qui décide
            results[name]=(None,err)
    threads=[threading.Thread(target=worker,args=(name,),daemon=True) for name in names]
    for thread in threads:
        thread.start()
    for thread in threads:
        while thread.is_alive():
            thread.join(0.2)
    return({name:results[name] for name in names})


def openAll(serverList, debug):
    """Ouvre en parallèle une connexion par serveur ; renvoie ({nom: Management}, nombre d'échecs).

    Un serveur injoignable est signalé sur stderr ; les autres sont traités.
    """
    mgmts={server.name:Management(server,debug=debug) for server in serverList}
    opened={}
    failed=0
    for name,(_,err) in runParallel(list(mgmts),lambda name: mgmts[name].open()).items():
        if err is None:
            opened[name]=mgmts[name]
            continue
        if not isinstance(err,ManagementError):
            raise err
        say(f"ovpnMgmt: {err}",file=sys.stderr)
        failed+=1
        mgmts[name].close()
    return(opened,failed)


def closeAll(mgmts):
    """Ferme toutes les connexions, en parallèle (chacune peut attendre ssh)."""
    runParallel(list(mgmts),lambda name: mgmts[name].close())


def gather(mgmts, func):
    """func(mgmt) sur chaque serveur en parallèle ; renvoie ({nom: résultat}, nombre d'échecs).

    Les ManagementError sont affichées sur stderr (elles citent le serveur) ;
    les résultats des autres serveurs sont rendus.
    """
    results={}
    failed=0
    for name,(value,err) in runParallel(list(mgmts),lambda name: func(mgmts[name])).items():
        if err is None:
            results[name]=value
            continue
        if not isinstance(err,ManagementError):
            raise err
        say(f"ovpnMgmt: {err}",file=sys.stderr)
        failed+=1
    return(results,failed)


def prefixFor(name, multi):
    """Préfixe des lignes d'un serveur quand plusieurs sont traités : "[nom] "."""
    return(f"[{name}] " if multi else "")


