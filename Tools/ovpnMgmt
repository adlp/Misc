"""ovpnMgmt : pilote un serveur OpenVPN par son interface de management.

La connexion se fait en direct (TCP ou socket unix) ou au travers de ssh :
  * "ssh -W hote:port" relie notre stdin/stdout au port de management vu
    depuis la machine ssh (rien à installer sur le serveur) ;
  * ou une commande lancée sur la machine ssh (ex. "sudo socat -
    UNIX-CONNECT:/run/openvpn/server.sock") pour un socket unix.

Les serveurs sont décrits dans un fichier INI (voir ovpnMgmt.conf.example),
avec un serveur par défaut ; -s en choisit un autre.

Actions : list (connexions, durée, octets, débit en --watch), kill (par
nom, adresse, IP VPN ou CID, RESTART ou HALT), info, log (--follow),
verb, mute, signal, hold, raw (commande brute) et shell (interactif).
"""

import argparse
import configparser
import json
import os
import re
import select
import shlex
import socket
import stat
import subprocess
import sys
import tempfile
import time

Version="1.0"
# 1.0 version initiale : list (--watch, --json, --long), kill (CN / adresse / IP VPN / CID, --halt), info, log
#     (--follow), verb, mute, signal, hold, raw, shell ; connexion directe (TCP, unix), ssh -W ou commande via ssh

DEFAULT_CONFIG="~/.config/ovpnMgmt/ovpnMgmt.conf"
DEFAULT_MANAGEMENT="127.0.0.1:7505"
DEFAULT_TIMEOUT=15


class ManagementError(Exception):
    """Erreur de connexion ou de dialogue avec l'interface de management."""


class ManagementTimeout(ManagementError):
    """Le management n'a rien envoyé dans le délai imparti."""


################################################################################
# Configuration
################################################################################

class Server:
    """Un serveur OpenVPN décrit par une section du fichier de configuration.

    Clefs reconnues :
      description   : texte libre, affiché par "servers"
      ssh           : destination ssh (user@hote, ou un Host de ~/.ssh/config) ;
                      absente = connexion directe depuis cette machine
      ssh_options   : options ssh supplémentaires (ex. "-p 2222 -J bastion")
      management    : "hote:port" ou "/chemin/socket" du management, vu depuis
                      la machine ssh (défaut 127.0.0.1:7505)
      command       : commande reliant stdin/stdout au management, lancée sur
                      la machine ssh (ou en local sans ssh) ; remplace management
      password_file : fichier contenant le mot de passe du management
      password      : mot de passe en clair (préférer password_file)
      timeout       : délai de réponse en secondes (défaut 15)
    """

    def __init__(self, name, section, configPath):
        self.name=name
        self.description=section.get('description','')
        self.ssh=section.get('ssh','').strip() or None
        self.sshOptions=shlex.split(section.get('ssh_options',''))
        self.command=section.get('command','').strip() or None
        self.timeout=self._number(section.get('timeout',str(DEFAULT_TIMEOUT)),'timeout')
        self.password=self._readPassword(section,configPath)
        management=section.get('management',DEFAULT_MANAGEMENT).strip()
        self.socketPath=None
        self.host=None
        self.port=None
        if management.startswith('/'):
            self.socketPath=management
            if self.ssh and not self.command:
                raise ManagementError(f"[{name}] management en socket unix via ssh : ssh -W ne sait pas l'atteindre, "
                                      f"ajouter par exemple : command = sudo socat - UNIX-CONNECT:{management}")
        else:
            # "hote:port", IPv6 entre crochets : [::1]:7505
            match=re.fullmatch(r'\[?([^\[\]]+?)\]?:(\d+)',management)
            if not match:
                raise ManagementError(f"[{name}] management invalide : « {management} » (attendu hote:port ou /chemin/socket)")
            self.host,self.port=match.group(1),int(match.group(2))

    def _number(self, value, key):
        """Valeur numérique positive d'une clef, sinon erreur explicite."""
        try:
            number=float(value)
        except ValueError:
            number=-1
        if number <= 0:
            raise ManagementError(f"[{self.name}] {key} invalide : « {value} » (nombre de secondes attendu)")
        return(number)

    def _readPassword(self, section, configPath):
        """Mot de passe du management : password_file d'abord, sinon password.

        Un mot de passe en clair dans un fichier lisible par d'autres comptes
        est signalé sur stderr (il donne la main sur le serveur VPN).
        """
        passwordFile=section.get('password_file','').strip()
        if passwordFile:
            passwordFile=os.path.expanduser(passwordFile)
            try:
                with open(passwordFile,encoding='utf-8') as handle:
                    password=handle.readline().rstrip('\r\n')
            except OSError as err:
                raise ManagementError(f"[{self.name}] password_file illisible : {err}")
            warnIfReadableByOthers(passwordFile)
            return(password)
        password=section.get('password')
        if password is not None:
            warnIfReadableByOthers(configPath)
        return(password)

    def transport(self):
        """Description courte de la connexion, pour "servers" et les erreurs."""
        target=self.socketPath or f"{self.host}:{self.port}"
        if self.command:
            target=f"commande « {self.command} »"
        if self.ssh:
            return(f"ssh {self.ssh} → {target}")
        return(f"direct → {target}")


def warnIfReadableByOthers(path):
    """Avertit sur stderr si un fichier contenant un secret est lisible par le groupe ou les autres."""
    try:
        mode=os.stat(path).st_mode
    except OSError:
        return
    if mode & (stat.S_IRGRP | stat.S_IROTH):
        print(f"ovpnMgmt: attention, {path} contient un mot de passe et est lisible par d'autres comptes (chmod 600)",file=sys.stderr)


def loadConfig(path):
    """Lit le fichier de configuration et renvoie (serveurs, nom du serveur par défaut).

    La section [ovpnMgmt] porte les réglages généraux (default = nom) ; chaque
    autre section est un serveur. Sans "default", un serveur unique est pris
    par défaut. Pas d'interpolation ni de commentaire en fin de ligne : un
    mot de passe peut contenir '%', ';' ou '#'.
    """
    path=os.path.expanduser(path)
    parser=configparser.ConfigParser(interpolation=None,inline_comment_prefixes=None)
    try:
        with open(path,encoding='utf-8') as handle:
            parser.read_file(handle)
    except FileNotFoundError:
        raise ManagementError(f"fichier de configuration absent : {path} (voir ovpnMgmt.conf.example, ou -c)")
    except (OSError,configparser.Error) as err:
        raise ManagementError(f"fichier de configuration illisible : {path} : {err}")
    servers={}
    for name in parser.sections():
        if name != 'ovpnMgmt':
            servers[name]=Server(name,parser[name],path)
    if not servers:
        raise ManagementError(f"aucun serveur dans {path}")
    default=parser.get('ovpnMgmt','default',fallback='').strip() or None
    if default is None and len(servers) == 1:
        default=next(iter(servers))
    if default is not None and default not in servers:
        raise ManagementError(f"serveur par défaut « {default} » absent de {path} (serveurs : {', '.join(servers)})")
    return(servers,default)


def pickServer(servers, default, name):
    """Serveur demandé par -s, sinon le serveur par défaut."""
    if name is None:
        if default is None:
            raise ManagementError(f"pas de serveur par défaut : choisir avec -s ({', '.join(servers)}) "
                                  f"ou ajouter default = ... dans [ovpnMgmt]")
        name=default
    if name not in servers:
        raise ManagementError(f"serveur inconnu : « {name} » (serveurs : {', '.join(servers)})")
    return(servers[name])


################################################################################
# Connexion à l'interface de management
################################################################################

class Management:
    """Dialogue avec l'interface de management d'un serveur OpenVPN.

    Le protocole est textuel, ligne par ligne :
      * une commande reçoit soit une ligne "SUCCESS: ..." ou "ERROR: ...",
        soit plusieurs lignes terminées par "END" (status, log N, version...) ;
      * les lignes commençant par '>' sont des notifications temps réel
        (>INFO, >LOG, >HOLD...) qui peuvent s'intercaler à tout moment ; elles
        sont mises de côté (self.notifications) ou passées à onNotification.
    Lecture et écriture passent par des descripteurs bruts (socket ou tubes de
    ssh), avec select pour borner chaque attente.
    """

    def __init__(self, server, debug=False):
        self.server=server
        self.debug=debug
        self.sock=None
        self.process=None
        self.sshStderr=None
        self.readFd=None
        self.writeFd=None
        self.buffer=b""
        self.notifications=[]
        self.onNotification=None

    # -- ouverture / fermeture ------------------------------------------------

    def open(self):
        """Ouvre la connexion, répond au mot de passe si demandé."""
        server=self.server
        if server.ssh or server.command:
            self._openProcess()
        elif server.socketPath:
            self._openSocket(socket.AF_UNIX,server.socketPath)
        else:
            self._openSocket(None,(server.host,server.port))
        # Premier échange : ">INFO:..." directement, ou "ENTER PASSWORD:" (sans fin de ligne).
        # Via ssh, délai large : ssh peut demander un mot de passe ou une passphrase sur le terminal.
        wait=max(server.timeout,60) if server.ssh else server.timeout
        deadline=time.monotonic()+wait
        try:
            while b"\n" not in self.buffer and b"ENTER PASSWORD:" not in self.buffer:
                self._fill(deadline)
        except ManagementTimeout:
            # OpenVPN ne sert qu'une session de management à la fois : les suivantes attendent, muettes
            raise ManagementTimeout(f"[{server.name}] le management n'a rien envoyé en {wait:g} s : une autre session "
                                    f"l'occupe sans doute (ovpnMgmt list --watch, log -f, shell, supervision...), "
                                    f"OpenVPN n'en sert qu'une à la fois")
        if b"ENTER PASSWORD:" in self.buffer:
            self.buffer=self.buffer.split(b"ENTER PASSWORD:",1)[1]
            if server.password is None:
                raise ManagementError(f"[{server.name}] le management demande un mot de passe : "
                                      f"ajouter password_file dans la configuration")
            self._send(server.password,secret=True)
            # Mot de passe faux : pas de ERROR, OpenVPN repose la question "ENTER PASSWORD:"
            deadline=time.monotonic()+server.timeout
            while b"\n" not in self.buffer and b"ENTER PASSWORD:" not in self.buffer:
                self._fill(deadline)
            if b"ENTER PASSWORD:" in self.buffer.split(b"\n",1)[0]:
                raise ManagementError(f"[{server.name}] mot de passe refusé par le management (password_file / password)")
            answer=self._readLine(deadline)
            if not answer.startswith("SUCCESS"):
                raise ManagementError(f"[{server.name}] mot de passe refusé par le management ({answer})")

    def _openSocket(self, family, address):
        """Connexion directe : TCP (family None) ou socket unix."""
        try:
            if family == socket.AF_UNIX:
                self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
                self.sock.settimeout(self.server.timeout)
                self.sock.connect(address)
            else:
                self.sock=socket.create_connection(address,timeout=self.server.timeout)
        except OSError as err:
            raise ManagementError(f"[{self.server.name}] connexion impossible ({self.server.transport()}) : {err}")
        # Bloquant : chaque attente est bornée par select, os.read/os.write ne doivent pas lever EAGAIN
        self.sock.settimeout(None)
        self.readFd=self.writeFd=self.sock.fileno()

    def _openProcess(self):
        """Connexion par un processus dont stdin/stdout sont reliés au management.

        ssh -W hote:port (aucun outil requis sur le serveur), ou la commande
        "command", lancée par ssh sur la machine distante ou en local. stderr
        de ce processus est gardé dans un fichier temporaire et cité si la
        connexion échoue (clef refusée, port fermé...).
        """
        server=self.server
        if server.ssh:
            argv=['ssh',*server.sshOptions]
            if server.command:
                argv+=['-T',server.ssh,server.command]
            else:
                argv+=['-W',f'{server.host}:{server.port}',server.ssh]
        else:
            argv=['/bin/sh','-c',server.command]
        if self.debug:
            print(f"[debug] lance : {shlex.join(argv)}",file=sys.stderr)
        self.sshStderr=tempfile.TemporaryFile()
        try:
            self.process=subprocess.Popen(argv,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=self.sshStderr,bufsize=0)
        except OSError as err:
            raise ManagementError(f"[{server.name}] impossible de lancer {argv[0]} : {err}")
        self.readFd=self.process.stdout.fileno()
        self.writeFd=self.process.stdin.fileno()

    def close(self):
        """Ferme proprement : "quit", puis socket ou processus."""
        try:
            if self.writeFd is not None:
                self._send("quit")
        except ManagementError:
            pass
        if self.sock is not None:
            self.sock.close()
        if self.process is not None:
            try:
                self.process.stdin.close()
            except OSError:
                pass
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
        if self.sshStderr is not None:
            self.sshStderr.close()
        self.readFd=self.writeFd=None

    def __enter__(self):
        self.open()
        return(self)

    def __exit__(self, *exc):
        self.close()

    # -- lecture / écriture brutes ---------------------------------------------

    def _processError(self):
        """Fin de ligne explicative d'une coupure : stderr de ssh / de la commande."""
        if self.sshStderr is None:
            return("")
        self.sshStderr.seek(0)
        text=self.sshStderr.read().decode('utf-8','replace').strip()
        return(f" : {text}" if text else "")

    def _fill(self, deadline):
        """Lit ce qui est disponible, en attendant au plus jusqu'à deadline."""
        remaining=deadline-time.monotonic()
        if remaining <= 0:
            raise ManagementTimeout(f"[{self.server.name}] pas de réponse du management en {self.server.timeout:g} s")
        ready,_,_=select.select([self.readFd],[],[],remaining)
        if not ready:
            raise ManagementTimeout(f"[{self.server.name}] pas de réponse du management en {self.server.timeout:g} s")
        try:
            data=os.read(self.readFd,65536)
        except OSError as err:
            raise ManagementError(f"[{self.server.name}] lecture impossible : {err}")
        if not data:
            if self.process is not None:
                # Laisse le temps à ssh d'écrire sa raison avant de la citer
                try:
                    self.process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    pass
            raise ManagementError(f"[{self.server.name}] connexion fermée ({self.server.transport()}){self._processError()}")
        self.buffer+=data

    def _readLine(self, deadline):
        """Une ligne complète, sans \\r\\n."""
        while b"\n" not in self.buffer:
            self._fill(deadline)
        line,self.buffer=self.buffer.split(b"\n",1)
        line=line.rstrip(b"\r").decode('utf-8','replace')
        if self.debug:
            print(f"[debug] < {line}",file=sys.stderr)
        return(line)

    def _send(self, line, secret=False):
        """Envoie une ligne (écriture complète, même par morceaux)."""
        if self.debug:
            print(f"[debug] > {'********' if secret else line}",file=sys.stderr)
        data=(line+"\n").encode('utf-8')
        try:
            while data:
                written=os.write(self.writeFd,data)
                data=data[written:]
        except OSError as err:
            raise ManagementError(f"[{self.server.name}] envoi impossible : {err}{self._processError()}")

    # -- protocole -------------------------------------------------------------

    def _notify(self, line):
        """Range ou transmet une notification temps réel (ligne '>...').

        La bannière ">INFO:OpenVPN Management Interface..." de l'ouverture est écartée.
        """
        if line.startswith(">INFO:"):
            return
        if self.onNotification is not None:
            self.onNotification(line)
        else:
            self.notifications.append(line)

    def readNotification(self, timeout):
        """Attend une ligne pendant timeout secondes ; None si rien n'est arrivé.

        Sert aux modes suivis (log --follow, shell) : les notifications sont
        renvoyées telles quelles, les autres lignes aussi.
        """
        deadline=time.monotonic()+timeout
        try:
            return(self._readLine(deadline))
        except ManagementTimeout:
            return(None)

    def command(self, cmd):
        """Envoie une commande et renvoie (succès, lignes de la réponse).

        Réponse sur une ligne : SUCCESS/ERROR, texte après "SUCCESS: " ou
        "ERROR: " ; réponse multiligne : lignes jusqu'à END (exclu), succès.
        """
        self._send(cmd)
        deadline=time.monotonic()+self.server.timeout
        lines=[]
        while True:
            line=self._readLine(deadline)
            if line.startswith('>'):
                self._notify(line)
                continue
            if not lines and line.startswith("SUCCESS:"):
                return(True,[line[len("SUCCESS:"):].strip()])
            if not lines and line.startswith("ERROR:"):
                return(False,[line[len("ERROR:"):].strip()])
            if line == "END":
                return(True,lines)
            lines.append(line)

    def check(self, cmd):
        """Comme command, mais une réponse ERROR devient une ManagementError."""
        ok,lines=self.command(cmd)
        if not ok:
            raise ManagementError(f"[{self.server.name}] « {cmd} » refusé : {' '.join(lines)}")
        return(lines)

    def status(self):
        """État du serveur (status 3, à tabulations ; status 2 pour les versions sans le 3)."""
        ok,lines=self.command("status 3")
        if not ok:
            lines=self.check("status 2")
        return(parseStatus(lines))


################################################################################
# Analyse des réponses
################################################################################

def parseDate(text):
    """Date du status en epoch : "2026-10-07 22:58:16" (2.5+) ou "Wed Oct  7 22:58:16 2026" (anciennes)."""
    for fmt in ("%Y-%m-%d %H:%M:%S","%a %b %d %H:%M:%S %Y"):
        try:
            return(int(time.mktime(time.strptime(text.strip(),fmt))))
        except ValueError:
            pass
    return(None)


def toInt(text):
    """Entier, ou None pour une valeur vide ou illisible."""
    try:
        return(int(text))
    except (TypeError,ValueError):
        return(None)


def parseStatus(lines):
    """Découpe la réponse de "status 2|3" en {title, time, clients, routes, globals}.

    Les colonnes sont lues dans les lignes HEADER : le même code suit les
    versions d'OpenVPN qui ajoutent des colonnes (Peer ID, Data Channel
    Cipher...). "Bytes Received" / "Bytes Sent" sont vus du serveur : reçu
    du client / envoyé au client.
    """
    separator='\t' if any('\t' in line for line in lines) else ','
    headers={}
    result={'title':'','time':None,'clients':[],'routes':[],'globals':{}}
    for line in lines:
        fields=line.split(separator)
        kind=fields[0]
        if kind == 'HEADER' and len(fields) > 1:
            headers[fields[1]]=fields[2:]
        elif kind == 'TITLE':
            result['title']=separator.join(fields[1:])
        elif kind == 'TIME':
            result['time']=toInt(fields[2]) if len(fields) > 2 else None
            if result['time'] is None and len(fields) > 1:
                result['time']=parseDate(fields[1])
        elif kind == 'GLOBAL_STATS' and len(fields) > 2:
            result['globals'][fields[1]]=fields[2]
        elif kind in headers:
            row=dict(zip(headers[kind],fields[1:]))
            if kind == 'CLIENT_LIST':
                result['clients'].append(clientFromRow(row))
            elif kind == 'ROUTING_TABLE':
                result['routes'].append({
                    'virtual':row.get('Virtual Address',''),
                    'cn':row.get('Common Name',''),
                    'real':row.get('Real Address',''),
                    'last_ref':toInt(row.get('Last Ref (time_t)')) or parseDate(row.get('Last Ref','')),
                })
    return(result)


def clientFromRow(row):
    """Une ligne CLIENT_LIST, avec des noms de clefs courts et des nombres."""
    since=toInt(row.get('Connected Since (time_t)'))
    if since is None:
        since=parseDate(row.get('Connected Since',''))
    username=row.get('Username','')
    return({
        'cn':row.get('Common Name',''),
        'real':row.get('Real Address',''),
        'virtual':row.get('Virtual Address',''),
        'virtual6':row.get('Virtual IPv6 Address',''),
        'rx':toInt(row.get('Bytes Received')) or 0,
        'tx':toInt(row.get('Bytes Sent')) or 0,
        'since':since,
        'username':'' if username == 'UNDEF' else username,
        'cid':toInt(row.get('Client ID')),
        'peer_id':toInt(row.get('Peer ID')),
        'cipher':row.get('Data Channel Cipher',''),
    })


def realIp(real):
    """IP seule d'une adresse réelle : "udp4:1.2.3.4:5000" ou "[2001:db8::1]:5000" → IP."""
    match=re.fullmatch(r'(?:(?:udp|tcp)[46]?(?:-server|-client)?:)?\[?(.+?)\]?:(\d+)',real)
    return(match.group(1) if match else real)


