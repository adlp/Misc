def buildParser():
    """Options générales et sous-commandes."""
    parser=argparse.ArgumentParser(
        prog='ovpnMgmt',
        description="Pilote un serveur OpenVPN par son interface de management, en direct ou au travers de ssh.",
        epilog=f"Configuration : {DEFAULT_CONFIG} (ou $OVPNMGMT_CONF, ou -c). Sans commande : list.")
    parser.add_argument('-c','--config',default=os.environ.get('OVPNMGMT_CONF',DEFAULT_CONFIG),help="fichier de configuration")
    parser.add_argument('-s','--server',help="serveur à utiliser (défaut : celui de la configuration)")
    parser.add_argument('-D','--debug',action='store_true',help="affiche les échanges avec le management sur stderr")
    parser.add_argument('-V','--version',action='version',version=f"%(prog)s {Version}")
    sub=parser.add_subparsers(dest='action',metavar='COMMANDE')

    p=sub.add_parser('list',aliases=['ls'],help="connexions actives (durée, octets reçus/envoyés)")
    p.add_argument('filter',nargs='?',help="ne garder que les connexions dont le nom, l'adresse ou l'IP VPN contient ce texte")
    p.add_argument('--sort',choices=['cn','real','virtual','since','rx','tx'],default='cn',help="tri (défaut : cn)")
    p.add_argument('-r','--reverse',action='store_true',help="tri inversé")
    p.add_argument('-l','--long',action='store_true',help="colonnes en plus : utilisateur, IPv6, chiffrement, peer ID")
    p.add_argument('--json',action='store_true',help="sortie JSON")
    p.add_argument('-w','--watch',type=positiveFloat,metavar='SEC',help="rafraîchit toutes les SEC secondes, avec le débit")

    sub.add_parser('servers',help="serveurs de la configuration (* = défaut)")

    p=sub.add_parser('info',help="version, PID, état, charge, verbosité")
    p.add_argument('--json',action='store_true',help="sortie JSON")

    p=sub.add_parser('kill',help="coupe des connexions (nom, IP[:port] réelle, IP VPN, ou --cid)")
    p.add_argument('targets',nargs='*',metavar='CIBLE',help="nom (CN), adresse réelle IP ou IP:port, ou IP VPN")
    p.add_argument('--cid',type=int,action='append',help="identifiant de connexion (colonne CID), répétable")
    p.add_argument('--halt',action='store_true',help="demande au client de s'arrêter (défaut : RESTART, il se reconnecte)")
    p.add_argument('-y','--yes',action='store_true',help="pas de confirmation quand plusieurs connexions sont visées")

    p=sub.add_parser('log',help="dernières lignes du log du serveur")
    p.add_argument('lines',nargs='?',default='20',help="nombre de lignes, ou all (défaut : 20)")
    p.add_argument('-f','--follow',action='store_true',help="puis suit le log en temps réel")

    for name,what in (('verb',"verbosité du log"),('mute',"limite de répétition des messages")):
        p=sub.add_parser(name,help=f"affiche ou change la {what}")
        p.add_argument('level',nargs='?',type=int,help="nouveau niveau")

    p=sub.add_parser('signal',help="signal au démon (SIGHUP, SIGTERM, SIGUSR1, SIGUSR2)")
    p.add_argument('signal',choices=['SIGHUP','SIGTERM','SIGUSR1','SIGUSR2'])
    p.add_argument('-y','--yes',action='store_true',help="pas de confirmation")

    p=sub.add_parser('hold',help="état d'attente au démarrage (management-hold)")
    p.add_argument('state',nargs='?',choices=['on','off','release'])

    p=sub.add_parser('raw',help="envoie des commandes brutes du management")
    p.add_argument('commands',nargs='+',metavar='COMMANDE',help="ex. \"status 3\" \"load-stats\"")

    sub.add_parser('shell',help="session interactive avec le management")
    return(parser)


def positiveFloat(value):
    """Type argparse : nombre de secondes strictement positif."""
    try:
        number=float(value)
    except ValueError:
        number=0
    if number <= 0:
        raise argparse.ArgumentTypeError(f"nombre de secondes positif attendu, pas « {value} »")
    return(number)


def main():
    """Lit la configuration, ouvre la connexion au serveur choisi et lance l'action."""
    parser=buildParser()
    args=parser.parse_args()
    if args.action is None:
        args=parser.parse_args(sys.argv[1:]+['list'])
    if args.action == 'ls':
        args.action='list'
    actions={'list':actionList,'info':actionInfo,'kill':actionKill,'log':actionLog,'verb':actionLevel,
             'mute':actionLevel,'signal':actionSignal,'hold':actionHold,'raw':actionRaw,'shell':actionShell}
    try:
        servers,default=loadConfig(args.config)
        if args.action == 'servers':
            return(actionServers(servers,default,args))
        server=pickServer(servers,default,args.server)
        with Management(server,debug=args.debug) as mgmt:
            return(actions[args.action](mgmt,args))
    except ManagementError as err:
        print(f"ovpnMgmt: {err}",file=sys.stderr)
        return(1)
    except KeyboardInterrupt:
        print()
        return(130)
    except BrokenPipeError:
        # Sortie coupée (ovpnMgmt list | head) : pas de trace Python
        sys.stderr.close()
        return(0)


if __name__ == '__main__':
    sys.exit(main())
