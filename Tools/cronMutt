def readStream(stream, capturedLines, streamName):
    for line in stream:
        capturedLines[streamName].append(line.rstrip())
        if teeMode:
            if streamName == 'stderr':
                print("[STDERR]:",end='',flush=True)
            print(line,end="",flush=True)
    stream.close()

try:
    options, _ = getopt.getopt(sys.argv[1:], "hVDEi:s:d:o:r:f:m:e:ct:XTp:n:N:", ["help"])
except getopt.GetoptError as err:
    print(err)  # will print something like "option -a not recognized"
    printUsage()

debug=False
sendEvenIfEmpty=False
mailSubject=f"//cron//{os.path.basename(__file__)}"
inReplyTo=None
recipients=os.getenv('LOGNAME','nobody')
recipientsIfOk=None
messageId=None
command=None
mailContentType=None
replyTo=os.getenv("LOGNAME",'nobody')
replyToGiven=False
markSubjectOnError=True
if sys.stdin.isatty():
    teeMode=True
else:
    teeMode=False
mailFrom=None
#-e "set content_type=text/html" 
hideCommandHeader=False
outputEncoding="utf-8"
nextcloudUrl=None
nextcloudCredentials=None

for option,value in options:
    if   option in ('-h','--help'):
        printUsage()
    elif option in '-V':
        printVersion()
    elif option in '-D':
        debug=True
    elif option in '-E':
        sendEvenIfEmpty=True
    elif option in '-i':
        inReplyTo=value
    elif option in '-s':
        mailSubject=value
    elif option in "-d":
        recipients=value
    elif option in '-o':
        recipientsIfOk=value
    elif option in '-f':
        mailFrom=value
    elif option in "-r":
        replyTo=value
        replyToGiven=True
    elif option in "-m":
        messageId=value
    elif option in "-e":
        command=value
    elif option in '-t':
        mailContentType=value
    elif option in '-X':
        markSubjectOnError=False
    elif option in '-T':
        teeMode=True
    elif option in '-c':
        hideCommandHeader=True
    elif option in '-p':
        outputEncoding=value
    elif option in '-n':
        nextcloudUrl=value
    elif option in "-N":
        nextcloudCredentials=value
    

hostname=os.uname()[1]
# Message-ID : unique par defaut (un id fixe fait dedoublonner les mails), toujours au format <id@host>
if messageId is None:
    messageId=f'<{datetime.now().strftime("%Y%m%d%H%M%S")}.{os.getpid()}.{uuid.uuid4().hex[:12]}.cronMutt@{hostname}>'
elif "<" not in messageId:
    messageId=f'<{messageId}>' if "@" in messageId else f'<{messageId}@{hostname}>'
nextcloudEnabled=nextcloudUrl is not None and nextcloudCredentials is not None
nextcloudIncomplete=(nextcloudUrl is None) != (nextcloudCredentials is None)
if nextcloudIncomplete:
    print("cronMutt: -n et -N vont ensemble, pas de depot nextcloud, envoi par mail",file=sys.stderr)

if inReplyTo is None:
    inReplyTo=hashlib.md5(mailSubject.encode('utf-8')).hexdigest()
# In-Reply-To : format <id@droite> sinon les clients l'ignorent pour les fils
if "<" not in inReplyTo:
    inReplyTo=f'<{inReplyTo}>' if "@" in inReplyTo else f'<{inReplyTo}@cronMutt>'
if mailFrom is None:
    mailFrom=replyTo
if "<" not in mailFrom:
    fromAddress=mailFrom
    mailFrom=f'{fromAddress.split("@")[0]} <{fromAddress}>'
    if debug:
        print(f"{fromAddress} ET {mailFrom}")
        print(f'{fromAddress.split("@")}')

# Preparation Ouverture du mail 1/2
muttCommand=['mutt','-e',f'my_hdr X-cronMutt: cronMutt-{Version}','-e',f'my_hdr X-cronMuttStart: {str(datetime.now())}','-e',f'my_hdr X-cronMuttHost: {hostname}','-e',f'my_hdr From:{escapeMuttValue(mailFrom)}','-e',f'my_hdr In-Reply-To: {escapeMuttValue(inReplyTo)}','-e',f'my_hdr References: {escapeMuttValue(inReplyTo)}','-e',f'my_hdr Message-ID: {escapeMuttValue(messageId)}']
if replyToGiven:
    muttCommand.append('-e')
    muttCommand.append(f'my_hdr Reply-To: {escapeMuttValue(replyTo)}')


# Ouverture du process a suivre
commandExitCode=0
capturedOutput={}
capturedOutput['stdout']=[]
capturedOutput['stderr']=[]

if command is not None:
    if not hideCommandHeader:
        muttCommand.append('-e')
        muttCommand.append(f'my_hdr X-cronMuttCmd: {escapeMuttValue(command)}')

    commandProcess=subprocess.Popen(['/bin/sh','-c',command],encoding =outputEncoding,errors='replace',
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE)

    # Creation puis demarrage des threads de lecture du stdout et stderr
    stdoutReader = threading.Thread(target=readStream, args=(commandProcess.stdout, capturedOutput, "stdout"))
    stderrReader = threading.Thread(target=readStream, args=(commandProcess.stderr, capturedOutput, "stderr"))
    stdoutReader.start()
    stderrReader.start()

    #Attente de la fin d'exec des thread et process (les thread affichent en tps reel)
    stdoutReader.join()
    stderrReader.join()
    commandProcess.wait()

    commandExitCode=commandProcess.returncode

    muttCommand.append('-e')
    muttCommand.append(f'my_hdr X-cronMuttExitCode: {str(commandProcess.returncode)}')

    if markSubjectOnError and commandExitCode != 0:
        mailSubject="*** "+mailSubject
        if debug:
            print(f"exit={commandProcess.returncode}")
else:
    # Mode pipe : les donnees arrivent sur notre stdin
    readStream(io.TextIOWrapper(sys.stdin.buffer,encoding=outputEncoding,errors='replace'), capturedOutput, "stdout")

# Traitement des donnees
output=""
for line in capturedOutput['stdout']:
    output+=line+"\n"
if len(capturedOutput['stderr']):
    output+="\n=============================================================================\n"
    for line in capturedOutput['stderr']:
        output+=line+"\n"

# Depot de la donnee sur le nextcloud
nextcloudFailure=None
if nextcloudIncomplete:
    nextcloudFailure="-n et -N vont ensemble, aucun depot tente"
elif nextcloudEnabled:
    if debug:
        print(f'Depose sur nc {nextcloudUrl}')
    nextcloudFailure=nextcloudUpload(nextcloudUrl,nextcloudCredentials,output.encode('utf-8'))

# Nextcloud en echec : l'output n'est sauve nulle part, tout le monde est prevenu et l'a en piece jointe
nextcloudFailed=nextcloudFailure is not None
mailBody=output
attachmentDir=None
if nextcloudFailed:
    mailSubject="**Output non sauvé** "+mailSubject
    mailBody=f"Output non sauvé, dépôt Nextcloud en échec : {nextcloudFailure}\nIl est en pièce jointe.\n"
    mailBody+="\n=============================================================================\n"+output
    attachmentDir=tempfile.mkdtemp(prefix="cronMutt.")
    attachmentFile=os.path.join(attachmentDir,nextcloudFileName(nextcloudUrl))
    with open(attachmentFile,'w',encoding='utf-8') as attachment:
        attachment.write(output)

# Preparation Ouverture du mail 2/2
muttCommand.append('-s')
muttCommand.append(mailSubject)

if mailContentType is not None:
    muttCommand.append('-e')
    muttCommand.append(f'set content_type=text/{mailContentType}')
if commandExitCode != 0 or nextcloudFailed:
    muttCommand.append('-e')
    muttCommand.append('my_hdr X-Priority:1')
if nextcloudFailed:
    muttCommand.append('-a')
    muttCommand.append(attachmentFile)
muttCommand.append('--')

# Destinataires : -o seul quand tout va bien, sinon -d et -o
if recipientsIfOk is not None and recipientsIfOk != "no" and commandExitCode == 0 and not nextcloudFailed:
    muttCommand.append(recipientsIfOk)
else:
    if recipientsIfOk is not None and recipientsIfOk != "no":
        recipients+=","+recipientsIfOk
    muttCommand.append(recipients)

if debug:
    print(f"{' '.join(muttCommand)}")

# Je veux envoyer le mail si
#   * Le nextcloud n'a pas marché (ou -n/-N incomplet)
#   * il y a une errere
#   * sauf -o no, quand tout va bien
#   * avec nextcloud : il y a un -E ou un -o (l'output est deja sur le nc)
#   * sans nextcloud : il y a un -E ou de l'output

mustSendMail=False
if nextcloudFailed:
    mustSendMail=True
    if debug:
        print('Not Sended')
elif commandExitCode != 0:
    mustSendMail=True
    if debug:
        print(f'ExitCode-{commandExitCode}')
elif recipientsIfOk == "no":
    mustSendMail=False
    if debug:
        print('destok no')
elif nextcloudEnabled:
    mustSendMail=sendEvenIfEmpty or recipientsIfOk is not None
    if debug:
        print(f'nc ok, send={mustSendMail}')
elif sendEvenIfEmpty or len(output):
    mustSendMail=True
    if debug:
        print('Send empty if empty en full if len')
else:
    if debug:
        print('Fall back')
    mustSendMail=False

if mustSendMail:
    sendMail(muttCommand,mailBody)
    if debug:
        print(f"Sended-{len(mailBody)}")
if attachmentDir is not None:
    shutil.rmtree(attachmentDir,ignore_errors=True)

if debug:
    print(len(output))

# Tue par un signal : returncode negatif, on rend 128+signal comme le shell
sys.exit(128-commandExitCode if commandExitCode < 0 else commandExitCode)
