def nextcloudUpload(webdavUrl,credentials,output):
    # Prepare auth (le mot de passe peut contenir des ':')
    loginPassword=credentials.split(':',1)
    auth = HTTPBasicAuth(loginPassword[0],loginPassword[1] if len(loginPassword) > 1 else '')
    # Envoyer le fichier au partage Nextcloud
    # Renvoie None si le depot a reussi, sinon la raison de l'echec
    try:
        # 15 s pour se connecter, 120 s sans reponse
        response = requests.put(webdavUrl, data=output, auth=auth, timeout=(15,120))
    except requests.Timeout as err:
        failureReason=f"pas de reponse (timeout) : {err}"
    except requests.RequestException as err:
        failureReason=f"injoignable : {err}"
    else:
        # Vérifier le succès de l'opération
        if response.status_code in [200, 201, 204]:
            return(None)
        failureReason=f"HTTP {response.status_code} {response.reason}"
    print(f"cronMutt: depot nextcloud en echec, {failureReason}",file=sys.stderr)
    return(failureReason)

def nextcloudFileName(webdavUrl):
    # Nom du fichier tel qu'il aurait du etre depose sur le nextcloud
    name=None
    if webdavUrl is not None:
        name=os.path.basename(unquote(urlsplit(webdavUrl).path).rstrip('/'))
    return(name if name else "cronMutt-output.txt")

def sendMail(muttCommand,body):
    muttProcess=subprocess.Popen(muttCommand,encoding ='utf-8',
                         stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE)
    _,muttStderr=muttProcess.communicate(input=body)
    if muttProcess.returncode != 0:
        print(f"cronMutt: mutt a echoue (exit={muttProcess.returncode}) : {muttStderr.strip()}",file=sys.stderr)
    return(muttProcess.returncode)

def escapeMuttValue(value):
    # mutt interprete la valeur d'un my_hdr : ; et # la coupent, ` execute, $ expanse
    value=value.replace('\r',' ').replace('\n',' ')
    return(re.sub(r'([\\;#`$])',r'\\\1',value))


