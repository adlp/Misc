# Configuration de ovpnMgmt : copier dans ~/.config/ovpnMgmt/ovpnMgmt.conf (chmod 600)
# ou indiquer un autre fichier par -c / $OVPNMGMT_CONF.
#
# Commentaires sur leur propre ligne seulement : un ';' ou un '#' en fin de ligne
# ferait partie de la valeur (un mot de passe peut en contenir).

[ovpnMgmt]
# Serveur(s) traité(s) sans -s ; plusieurs : séparés par des virgules (default = paris, lyon),
# la même commande est alors envoyée à chacun en parallèle
default = paris

# Côté OpenVPN, dans la configuration du serveur :
#   management 127.0.0.1 7505 /etc/openvpn/server/management.pass
# (fichier : le mot de passe sur la première ligne ; sans fichier, pas de mot de passe)

[paris]
description = VPN Paris (production)
# Destination ssh : user@hote, ou un Host de ~/.ssh/config (ProxyJump, clef... y sont pris en compte)
ssh = admin@vpn-paris.example.com
# Options ssh en plus, au besoin
ssh_options = -p 2222
# Port de management, vu depuis la machine ssh (ssh -W, rien à installer sur le serveur)
management = 127.0.0.1:7505
# Mot de passe du management (première ligne du fichier)
password_file = ~/.config/ovpnMgmt/paris.pass
# Configuration du serveur OpenVPN, lue sur la machine ssh (list --offline) : les utilisateurs connus en sont
# déduits (index.txt de la PKI à côté de "ca", client-config-dir, ifconfig-pool-persist)
openvpn_config = /etc/openvpn/server/server.conf
# Ces fichiers sont souvent réservés à root : lecture par "sudo -n" (sudo sans mot de passe requis)
sudo = yes

[lyon]
description = VPN Lyon, management en socket unix
ssh = root@vpn-lyon.example.com
# ssh -W ne sait pas joindre un socket unix : une commande sur le serveur relie stdin/stdout au socket
command = socat - UNIX-CONNECT:/run/openvpn-server/server.sock

[labo]
description = VPN du labo, joint par un bastion
ssh = vpn-labo
ssh_options = -J bastion.example.com
management = 127.0.0.1:7505
# Copie locale de la configuration (préfixe local:) ; les chemins qu'elle donne sont lus ici aussi
openvpn_config = local:~/vpn/labo/server.conf
# index.txt ailleurs qu'à côté du "ca" (ca.crt copié hors de la PKI)
pki_index = ~/vpn/labo/pki/index.txt
# Réponses lentes (liaison satellite...) : délai en secondes, 15 par défaut
timeout = 30

[local]
description = Serveur OpenVPN de cette machine
# Sans ssh : connexion directe, TCP (hote:port) ou socket unix (/chemin)
management = /run/openvpn-server/server.sock
