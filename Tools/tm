#!/bin/bash

nl=$(tmux ls | wc -l)

if [ -z "$1" ]; then
    case $nl in
        0)
            tmux new -s first
            ;;
        1)
            name=$(tmux ls | cut -d: -f1)
            tmux attach -t $name
            ;;
        *)
            tmux ls
            ;;
        esac
elif [ "$1" = "ls" ]; then
    tmux ls
elif [ "$1" = "kill" ]; then
    if [ -z "$2" ]; then
        tmux ls
        echo Merci de preciser le nom de la session
        exit 1
        fi
    tmux kill-session -t $2
elif tmux ls | grep -q "^$1:"; then
    tmux attach -t $1
else
    tmux new -s $1
fi
