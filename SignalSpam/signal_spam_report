#!/usr/bin/env python3
"""Signale en masse des mails .eml à signal-spam.fr via son API.

Chaque fichier .eml signalé avec succès (HTTP 200 ou 202) est renommé en
.eml.done pour permettre de relancer le script sans re-signaler les mêmes
mails.
"""

import argparse
import base64
import configparser
import getpass
import re
import stat
import sys
import time
import warnings
from pathlib import Path

# Debian empaquette des versions d'urllib3/chardet plus récentes que celles
# supportées par python3-requests, ce qui déclenche un avertissement
# inoffensif à l'import.
warnings.filterwarnings("ignore", message=r"urllib3 \(.*\) or chardet \(.*\) doesn't match a supported version")

import requests  # noqa: E402

API_URL = "https://www.signal-spam.fr/api/signaler"
__version__ = "1.3.0"

CONFIG_PATH = Path.home() / ".signal-spam.fr.rc"

HEADER_BODY_SPLIT_RE = re.compile(rb"\r\n\r\n|\n\n")


def split_headers_body(raw: bytes) -> tuple[bytes, bytes, bytes]:
    """Sépare un .eml en (bloc d'en-têtes, séparateur, corps)."""
    match = HEADER_BODY_SPLIT_RE.search(raw)
    if not match:
        return raw, b"", b""
    return raw[: match.start()], match.group(0), raw[match.end():]


def parse_header_entries(header_block: bytes) -> list[bytes]:
    """Découpe un bloc d'en-têtes en entrées, en recollant les lignes de continuation (repliement RFC 5322)."""
    entries: list[bytes] = []
    for line in header_block.splitlines(keepends=True):
        if line[:1] in (b" ", b"\t") and entries:
            entries[-1] += line
        else:
            entries.append(line)
    return entries


def _is_received(text: str) -> bool:
    return text.split(":", 1)[0].strip().lower() == "received"


def strip_relay_headers(raw: bytes, hide_ips: list[str]) -> tuple[bytes, list[tuple[str, str | None]]]:
    """Retire les en-têtes Received correspondant aux IP de relais à cacher.

    Retourne (nouveau .eml, liste de (en-tête supprimé, en-tête Received suivant révélé)),
    cette dernière servant à l'affichage --dump-headers : l'en-tête "révélé" est celui du
    hop précédent dans la chaîne (physiquement juste en dessous), c'est-à-dire l'IP qui
    apparaissait juste derrière le relais caché.
    """
    header_block, sep, body = split_headers_body(raw)
    if not sep:
        return raw, []

    ip_pattern = re.compile(
        r"(?<![0-9.])(?:" + "|".join(re.escape(ip) for ip in hide_ips) + r")(?![0-9.])"
    )

    entries = parse_header_entries(header_block)
    texts = [entry.decode("latin-1") for entry in entries]

    kept_entries: list[bytes] = []
    removals: list[tuple[str, str | None]] = []
    for idx, (entry, text) in enumerate(zip(entries, texts)):
        if _is_received(text) and ip_pattern.search(text):
            revealed = next(
                (t.rstrip("\r\n") for t in texts[idx + 1:] if _is_received(t)), None
            )
            removals.append((text.rstrip("\r\n"), revealed))
        else:
            kept_entries.append(entry)

    new_raw = b"".join(kept_entries) + sep + body
    return new_raw, removals


def report_mail(
    session: requests.Session, login: str, password: str, eml_path: Path, hide_ips: list[str]
) -> tuple[bool, str]:
    """Signale un fichier .eml à signal-spam.fr. Retourne (succès, message)."""
    raw = eml_path.read_bytes()
    if hide_ips:
        raw, _ = strip_relay_headers(raw, hide_ips)
    encoded = base64.b64encode(raw).decode("ascii")
    try:
        resp = session.post(
            API_URL,
            auth=(login, password),
            data={"message": encoded},
            timeout=30,
        )
    except requests.RequestException as exc:
        return False, f"erreur réseau: {exc}"

    if resp.status_code in (200, 202):
        return True, f"HTTP {resp.status_code}"
    return False, f"HTTP {resp.status_code}: {resp.text[:200]}"


def dump_header_transformation(eml_path: Path, hide_ips: list[str]) -> None:
    raw = eml_path.read_bytes()
    _, removals = strip_relay_headers(raw, hide_ips)
    if not removals:
        print("    aucun en-tête Received ne correspond aux IP indiquées, rien à transformer")
        return
    for removed, revealed in removals:
        print("    en-tête Received supprimé (relais caché) :")
        print(f"      - {removed}")
        if revealed:
            print("    en-tête Received révélé juste derrière (origine réelle probable) :")
            print(f"      + {revealed}")
        else:
            print("      (aucun en-tête Received derrière ce relais)")


def load_config(profile: str | None, config_path: Path = CONFIG_PATH) -> dict[str, str]:
    """Charge la configuration effective depuis config_path.

    Sans --profile, renvoie la section [default] (fallback pour toutes les
    autres sections, via configparser). Avec --profile NOM, renvoie la
    section NOM, dont les clés absentes sont complétées par [default].
    Fichier absent : renvoie {} (config totalement optionnelle), sauf si un
    profil précis est demandé, auquel cas c'est une erreur.
    """
    if not config_path.exists():
        if profile:
            print(f"Erreur: fichier de configuration {config_path} introuvable (profil {profile!r} demandé).", file=sys.stderr)
            sys.exit(1)
        return {}

    mode = config_path.stat().st_mode
    if mode & (stat.S_IRWXG | stat.S_IRWXO):
        print(
            f"Attention: {config_path} est accessible à d'autres utilisateurs "
            f"(peut contenir un mot de passe en clair) — chmod 600 {config_path} recommandé.",
            file=sys.stderr,
        )

    parser = configparser.ConfigParser(default_section="default")
    parser.read(config_path)

    if profile:
        if not parser.has_section(profile):
            print(f"Erreur: profil {profile!r} absent de {config_path}.", file=sys.stderr)
            sys.exit(1)
        return dict(parser[profile])
    return dict(parser.defaults())


def main() -> int:
    parser = argparse.ArgumentParser(description="Signale des mails .eml à signal-spam.fr")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument(
        "directory", type=Path, nargs="?", default=None,
        help="Répertoire contenant les fichiers .eml (surcharge 'directory' de la config)",
    )
    parser.add_argument(
        "-u", "--login", default=None,
        help="Identifiant (email) signal-spam.fr (surcharge 'login' de la config)",
    )
    parser.add_argument(
        "-p", "--password", default=None,
        help="Mot de passe signal-spam.fr (surcharge 'password' de la config; "
             "demandé de façon interactive si toujours absent)",
    )
    parser.add_argument(
        "--delay", type=float, default=1.0,
        help="Délai en secondes entre deux signalements (défaut: 1.0)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Liste les fichiers qui seraient signalés sans envoyer de requête",
    )
    parser.add_argument(
        "--hide-ip", action="append", default=None, metavar="IP",
        help="IP de relais à retirer des en-têtes Received avant envoi (répétable), "
             "pour laisser apparaître l'IP d'origine réelle du spam "
             "(surcharge 'hide_ip' de la config)",
    )
    parser.add_argument(
        "--dump-headers", action="store_true",
        help="Avec --dry-run et --hide-ip: affiche la transformation des en-têtes Received sans envoyer",
    )
    parser.add_argument(
        "--profile", metavar="NOM", default=None,
        help=f"Section de {CONFIG_PATH} à utiliser (défaut: section [default] si le fichier existe)",
    )
    args = parser.parse_args()

    config = load_config(args.profile)

    login = args.login or config.get("login")
    if not login:
        parser.error("--login requis (ou clé 'login' dans la configuration)")

    directory = args.directory or (Path(config["directory"]) if config.get("directory") else None)
    if directory is None:
        parser.error("répertoire requis (argument positionnel, ou clé 'directory' dans la configuration)")

    if not directory.is_dir():
        print(f"Erreur: {directory} n'est pas un répertoire.", file=sys.stderr)
        return 1

    if args.dump_headers and not args.dry_run:
        print("Erreur: --dump-headers nécessite --dry-run.", file=sys.stderr)
        return 1

    hide_ips = args.hide_ip or (
        [ip.strip() for ip in config["hide_ip"].split(",") if ip.strip()] if config.get("hide_ip") else None
    )

    password = args.password or config.get("password") or getpass.getpass("Mot de passe signal-spam.fr: ")

    eml_files = sorted(directory.glob("*.eml"))
    if not eml_files:
        print(f"Aucun fichier .eml trouvé dans {directory}.")
        return 0

    print(f"{len(eml_files)} mail(s) à signaler.")

    if args.dry_run:
        for path in eml_files:
            print(f"[dry-run] {path.name}")
            if args.dump_headers and hide_ips:
                dump_header_transformation(path, hide_ips)
        return 0

    ok_count = 0
    fail_count = 0
    session = requests.Session()

    total = len(eml_files)
    for i, eml_path in enumerate(eml_files):
        progress = f"[{i + 1}/{total}]"
        success, message = report_mail(session, login, password, eml_path, hide_ips)
        if success:
            done_path = eml_path.with_suffix(eml_path.suffix + ".done")
            eml_path.rename(done_path)
            ok_count += 1
            print(f"{progress} OK   {eml_path.name} -> {done_path.name}")
        else:
            fail_count += 1
            print(f"{progress} FAIL {eml_path.name}: {message}", file=sys.stderr)

        if i < len(eml_files) - 1 and args.delay > 0:
            time.sleep(args.delay)

    print(f"\nTerminé: {ok_count} signalé(s), {fail_count} échec(s).")
    return 0 if fail_count == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
